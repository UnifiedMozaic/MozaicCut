{
  "$schema-note": "MozaicCut の UI のトークン。値はこのファイルが正本。モックアップ（docs/design/mockups/*.html）の CSS の変数と、UM の theme.um の定数はここから作る。寸法は論理 px（UI の倍率を掛ける前）。色は sRGB の 16 進。#RRGGBBAA は不透明度つき。UM では 0xAARRGGBB に並べ替えて写す。",
  "version": 2,
  "theme": {
    "default": "dark",
    "note": "暗いテーマだけを作る。色の作業をする道具として、UI は R=G=B の無彩色の暗いグレーに絞る。明るさは brightnessSteps で bg・line・text.2・text.3 をまとめて上下させる。明るいテーマは M3 以降に検討する。"
  },
  "color": {
    "dark": {
      "bg": {
        "0": "#141414",
        "1": "#1B1B1B",
        "2": "#222222",
        "3": "#2C2C2C",
        "4": "#383838",
        "viewer": "#0D0D0D",
        "popover": "#1F1F1F"
      },
      "viewerChoices": { "black": "#000000", "midGray": "#767676", "ui": "#1B1B1B", "default": "#0D0D0D", "note": "midGray は反射率 18% の中間のグレー（sRGB で 118）。色を判断するための背景。" },
      "line": {
        "default": "#2C2C2C",
        "strong": "#3C3C3C",
        "control": "#767676",
        "note": "default と strong は区切りの線（面の段差の代わり）。control は部品の輪郭（チェック・ラジオ・オフのトグル・スライダーの溝・値の欄と検索の欄とキーの札の枠）で、bg.0〜bg.3 に対して 3:1 以上（WCAG 1.4.11）。"
      },
      "text": {
        "1": "#E6E6E6",
        "2": "#A3A3A3",
        "3": "#8C8C8C",
        "disabled": "#666666",
        "onLight": "#141414",
        "onDark": "#F2F2F2",
        "onAccent": "#141414",
        "onAi": "#141414",
        "onError": "#141414",
        "onWarn": "#141414",
        "onRipple": "#141414",
        "onOverwrite": "#141414",
        "onOk": "#141414",
        "note": "text.3 は bg.0〜bg.2 の上だけで使う（bg.3 より明るい面の上は text.2）。on* は塗りの色の上の文字（主のボタン・札・件数）。どれも 5.7:1 以上。"
      },
      "accent": {
        "default": "#4C8DFF",
        "hover": "#6FA3FF",
        "tint": "#4C8DFF29",
        "tintSolid": "#1E2A3D",
        "note": "強調の色は青に固定する。選択・フォーカスの色は意味の色（semantic）のどれとも CIEDE2000 で 20 以上離す必要があり、試した色相（青緑・緑・橙・紫・藍）はどれかとぶつかったため。明るいテーマと一緒に M3 で見直す。"
      },
      "selection": {
        "clipInner": "#FFFFFF",
        "clipOuter": "#000000",
        "list": "#4C8DFF",
        "note": "タイムラインのクリップの選択は白 2px（内）＋黒 1px（外）。映像の色の判断を邪魔しないため。素材の格子・リスト・カード・メニューなど、ほかの選択は accent。"
      },
      "semantic": {
        "playhead": "#FF4D4D",
        "playheadEdge": "#000000",
        "ripple": "#F2C94C",
        "rippleTint": "#F2C94C24",
        "overwrite": "#F860B2",
        "overwriteTint": "#F860B214",
        "ok": "#4CC38A",
        "okTint": "#4CC38A24",
        "warn": "#F08A3C",
        "warnTint": "#F08A3C24",
        "error": "#FF706C",
        "errorTint": "#FF706C1A",
        "ai": "#BD97F7",
        "aiTint": "#BD97F724",
        "textSource": "#D8D2C4",
        "textSourceTint": "#D8D2C424",
        "reference": "#62D2E8",
        "referenceTint": "#62D2E81F",
        "volumeLine": "#FFFFFFB3",
        "hatchNeutral": "#FFFFFF40",
        "inOut": "#FFFFFF12",
        "inOutLane": "#FFFFFF08",
        "pastEnd": "#00000038",
        "focusOuter": "#000000",
        "note": "意味の色は 1 色に 1 つの意味。playhead・ripple・overwrite・ok・warn・error・ai・textSource・reference と accent のどの 2 つも CIEDE2000 で 20 以上離す。例外は playhead と error の 1 組だけ（ΔE 6.5）。再生ヘッドは両側に黒 1px の縁を持つ 1px の線、エラーは必ず丸に × のアイコンと文を添えるので、形で分かれる。名前: ripple は黄、overwrite は桃（マゼンタ）、warn は橙、reference は水色、textSource は生成り色、ai は紫。"
      },
      "clip": {
        "video": { "mark": "#56B4E9", "face": "#234A63", "faceSelected": "#2E6088", "text": "#F2F2F2" },
        "audio": { "mark": "#2FBF8F", "face": "#1E4A3C", "faceSelected": "#286452", "text": "#F2F2F2", "wave": "#7FE0BC" },
        "text":  { "mark": "#CC79A7", "face": "#52304A", "faceSelected": "#6A3F60", "text": "#F2F2F2" },
        "image": { "mark": "#E69F00", "face": "#54401C", "faceSelected": "#6E5527", "text": "#F2F2F2" },
        "color": { "mark": "#BDBDBD", "face": "#3D3D3D", "faceSelected": "#525252", "text": "#F2F2F2" },
        "subText": "#DADADA",
        "tagBg": "#00000059",
        "note": "面は白い文字で 7:1 以上、選んだときの面でも 5.9:1 以上。subText（ID・札の文字）は面の上で 7.7 以上、選んだ面でも 4.7 以上。上の辺に 2px の mark を引いて種類を示す（上の辺は種類の印だけに使う。ラベルは左の辺の 3px）。種類は色だけでなくアイコン・縮小画像・波形でも示す。波形は audio.wave で、面と選んだ面の両方に 3:1 以上。色のクリップは黄をやめて灰にした（警告の橙・詰めるの黄と離すため）。"
      },
      "label": {
        "orange":  { "value": "#C48A14", "name": "橙", "nameEn": "Orange" },
        "sky":     { "value": "#4A9AC6", "name": "空色", "nameEn": "Sky" },
        "green":   { "value": "#13A077", "name": "緑", "nameEn": "Green" },
        "yellow":  { "value": "#CFC43C", "name": "黄", "nameEn": "Yellow" },
        "blue":    { "value": "#2A86C8", "name": "青", "nameEn": "Blue" },
        "vermilion": { "value": "#D0662A", "name": "朱", "nameEn": "Vermilion" },
        "purple":  { "value": "#B06B92", "name": "赤紫", "nameEn": "Purple" },
        "gray":    { "value": "#848484", "name": "灰", "nameEn": "Gray" },
        "note": "Okabe と Ito の色を暗い UI 向けに調整したもの。どれも bg.1 と bg.2 に対して 3:1 以上（マーカーとして描くため）。上に載せる文字は輝度から黒か白を自動で選ぶ（4.5:1 以上になる方）。クリップでは左の辺の 3px に出し、上の辺の種類の印とは位置で分ける。利用者は名前を付け替えられる（例: 「インタビュー」）。"
      },
      "meter": { "low": "#4CC38A", "mid": "#F0B429", "high": "#FF706C", "ticksDb": [-60, -18, -6, 0], "floorDb": -60, "note": "メーターの黄（mid）はメーターの中だけで使う業界の慣習の色で、警告の意味は持たない。色の境目は ticksDb の −18 と −6 の位置に置く（縦の位置は dB に比例）。" }
    },
    "brightnessSteps": { "min": -2, "max": 2, "stepRgb": 4, "note": "bg.*・line.*・text.2・text.3 の R=G=B をまとめて 1 段 4 ずつ上下させる（text.1・disabled・on* と意味の色は変えない）。コントラストのテストは −2〜+2 の全段で回す。" }
  },
  "font": {
    "family": {
      "sans": { "name": "IBM Plex Sans JP", "files": ["IBMPlexSansJP-Regular.ttf", "IBMPlexSansJP-SemiBold.ttf"], "license": "OFL-1.1", "outline": "glyf（同梱の前に確かめる。CFF なら BIZ UDPGothic に替える）" },
      "mono": { "name": "IBM Plex Mono", "files": ["IBMPlexMono-Regular.ttf", "IBMPlexMono-Medium.ttf"], "license": "OFL-1.1" },
      "fallback": { "name": "Noto Sans JP", "license": "OFL-1.1", "use": "sans にない字（素材名・字幕）" },
      "legible": { "name": "BIZ UDPGothic", "license": "OFL-1.1", "use": "設定「読みやすさ優先の文字」" },
      "icons": { "name": "MozaicCut Icons", "range": "U+E000-U+E0FF", "use": "アイコンを glyf のフォントにして ttf.um で描く" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "note": "sans は 400 と 600 の 2 つ。mono は 400 と 500。" },
    "size": {
      "xs":   { "size": 11, "lineHeight": 14, "weight": 400, "use": "ルーラーの数字・キーの刻印・クリップの札・メーターの数字。英数字だけ（和文は不可）" },
      "sm":   { "size": 12, "lineHeight": 16, "weight": 400, "use": "クリップ名・表の行・ツールチップ・状態の帯・タブ・補足の和文（和文の最小）" },
      "md":   { "size": 13, "lineHeight": 18, "weight": 400, "use": "本文・メニュー・ボタン（基準）" },
      "lg":   { "size": 15, "lineHeight": 20, "weight": 600, "use": "パネルの見出し・ダイアログの見出し" },
      "xl":   { "size": 20, "lineHeight": 26, "weight": 600, "use": "スタート画面・空の状態の見出し" },
      "tcL":  { "size": 18, "lineHeight": 24, "weight": 500, "family": "mono", "use": "タイムラインの現在の時刻" },
      "tcM":  { "size": 15, "lineHeight": 20, "weight": 500, "family": "mono", "use": "モニターの時刻" },
      "tcXL": { "size": 22, "lineHeight": 28, "weight": 500, "family": "mono", "use": "トリムの変化の量" },
      "code": { "size": 12, "lineHeight": 18, "weight": 400, "family": "mono", "use": ".mzc の行・op の文・ID" },
      "codeSm": { "size": 11, "lineHeight": 16, "weight": 400, "family": "mono", "use": "履歴の op の文・補足（英数字だけ）" }
    },
    "rules": {
      "minJapanese": 12,
      "minJapaneseException": "レールの 2 文字までのラベルだけ 11px",
      "tabularDigits": "0-9 と : ; . + - の送り幅を一番広い字にそろえる（ttf.um の数字等幅モード）",
      "ellipsis": { "default": "end", "mediaName": "middle", "code": "トークンの境目で折り返す" }
    }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "grid": 4 },
  "size": {
    "topBar": 40,
    "rail": 56,
    "panelHeader": 32,
    "tabBar": 32,
    "statusBar": 24,
    "timelineToolbar": 36,
    "ruler": 26,
    "trackHeader": 176,
    "meter": 40,
    "scrollbar": 12,
    "propertyRow": 28,
    "propertyLabel": 86,
    "field": 24,
    "fieldDialog": 32,
    "button": { "sm": 24, "md": 28, "lg": 36 },
    "iconButton": { "sm": 24, "md": 28 },
    "hitTargetMin": 24,
    "icon": { "sm": 16, "md": 20 },
    "logo": 16,
    "trackHeight": { "presets": [28, 40, 52, 64, 96], "presetNames": ["小", "やや小", "中", "大", "特大"], "defaultVideoMain": 52, "defaultAudio": 52, "defaultVideoOther": 40, "defaultText": 40, "volumeLineMin": 40, "waveformMin": 36, "thumbnailMin": 40 },
    "panelDefault": { "left": 260, "right": 320, "timelineRatio": 0.44 },
    "panelMin": { "left": 220, "right": 280, "monitorW": 400, "monitorH": 260, "timelineH": 200 },
    "panelMax": { "left": 420, "right": 440, "timelineRatio": 0.75 },
    "window": { "min": [1024, 640], "design": [1440, 900] },
    "twoMonitorsMinWidth": 1600,
    "export": { "left": 280, "right": 320 },
    "start": { "left": 420, "drop": 160, "cardThumb": 150 }
  },
  "radius": { "none": 0, "sm": 3, "md": 5, "lg": 8, "pill": 999, "use": { "sm": "クリップ・入力・札", "md": "ボタン・メニュー", "lg": "カード・ダイアログ・通知" } },
  "border": { "hairline": 1, "focus": 2, "selection": 2, "trimRoller": 4, "focusOffset": 1, "labelEdge": 3, "playheadEdge": 1 },
  "shadow": {
    "none": "none",
    "popover": { "css": "0 4px 12px rgba(0,0,0,.5)", "use": "浮かぶものだけ: メニュー・ツールチップ・コマンドパレット・ドラッグ中の物・通知・ダイアログ", "impl": "倍率ごとに作った 9 分割の画像で描く" }
  },
  "opacity": { "dragGhost": 0.65, "disabledClip": 0.4, "lockedClip": 0.75, "hatch": 0.25, "note": "無効（押せない）ものと、出力しないクリップにだけ使う。人が外した AI の op のように、まだ押せるものには使わない（文字の色と取り消し線で示す）。" },
  "pattern": {
    "hatch": { "angle": 45, "period": 6, "use": "オフライン（error の 25%・右上がり）・仮の位置と削られるコマ（hatchNeutral・右下がり）・提案で消える範囲（ai）" },
    "dash": { "on": 3, "off": 2, "use": "点線は「まだ確かめていないもの」だけ: 提案・参照・影" }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "hover": 60,
      "press": 0,
      "tooltipDelay": 600,
      "menuIn": 120,
      "menuOut": 100,
      "panel": 160,
      "dialog": 160,
      "rippleClose": 140,
      "rejectReturn": 160,
      "snapIndicator": 300,
      "changeHighlight": 600,
      "toastIn": 200,
      "toastHold": 4000,
      "toastHoldWithUndo": 8000,
      "spinnerDelay": 300,
      "progressDelay": 2000,
      "aiPulse": 1200
    },
    "easing": {
      "out": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "in": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "linear": "linear"
    },
    "rules": "直接の操作（ドラッグ・スクラブ・トリム・再生ヘッド・ズーム）には動きを付けない。「動きを減らす」がオンならすべて 0ms（通知はフェードだけ）。"
  },
  "z": {
    "base": 0,
    "panel": 10,
    "timelineOverlay": 20,
    "playhead": 30,
    "popover": 100,
    "menu": 200,
    "tooltip": 300,
    "toast": 400,
    "dialog": 500,
    "dragGhost": 600
  },
  "scale": { "min": 0.8, "max": 2.0, "step": 0.1, "note": "OS の倍率 × 利用者の倍率。線は掛けたあとで整数の画素に吸着させる。" },
  "budget": { "uiFrameMs": 4, "inputLatencyFrames": 1, "startWindowMs": 500, "startInteractiveMs": 1500, "playbackFps": 30 }
}
