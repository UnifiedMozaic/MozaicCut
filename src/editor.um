// MozaicCut の編集画面。ウィンドウ（SDL3）にプレビューとタイムラインを出し、マウスとキーで編集する。
// 編集はすべて ops.um の操作（move / trim / split / delete）で .mzc の行を書き換えて保存する。テキストのまま
// 別のエディタで書き換えても、すぐに読み直す。素材の展開（ffmpeg）は mozcut.mjs edit が裏で行う。
// 文字は TrueType（ttf.um の uiFont）で描く。プレビューの文字のクリップはプロジェクトのフォント（font= / fontindex=）。
//
//   mozcut-edit                              スタート画面（最近開いたプロジェクト・デモ・使い方）
//   mozcut-edit <project.mzc>                プロジェクトを開く（キャッシュは <名前>.cache。素材は展開しない）
//   mozcut-edit <project.mzc> <cache>        キャッシュを指定して開く（mozcut.mjs edit の呼び方。展開は mozcut.mjs が行う）
//   オプション: --managed（素材の展開を mozcut.mjs が受け持つ）、--home <dir>（mozcut-recent.txt と ../demo の基準。
//   ふつうは実行ファイルのフォルダ）。試し用の引数は main の注釈を見る。
import { splitLines, fmtTime, parseTime, parseNum, isNan, textStartsWith } from "./text.um";
import {
  Project, Clip, Probe, Diag, parseProject, readProbes, emptyProject, findClip,
  KIND_VIDEO, KIND_IMAGE, KIND_TEXT, KIND_COLOR, KIND_AUDIO, MAX_TRACKS,
} from "./project.um";
import { Media, loadMedia, renderFrameFrom, RenderCache, newRenderCache } from "./render.um";
import {
  Playback, FrameCache, PB_PLAYING, newPlayback, newFrameCacheFor, emptyFrameCache, pbCacheFitsFor, newPrefetchWorker,
  pbPrefetchRun, pbWorkerBudget, pbReload, pbTick, pbShown, pbPlan, pbFrameTime, pbToggle, pbKeyJ, pbKeyK, pbKeyL,
  pbSeek, pbStep, pbPlay, pbStatusText, pbStatsJson,
} from "./playback.um";
import {
  uiRect, uiBlend, uiFrame, UiTextCache, uiTextCache, uiTextFrame, uiTextF, uiTextWidthF, uiTextHeightF, uiFitEnd, uiFitMiddle,
} from "./ui.um";
import { Font, uiFont, projectFont, loadFont } from "./ttf.um";
import { secText } from "./lineedit.um";
import { runOps, splitArgs } from "./ops.um";

// 文字の大きさ（画素）
const FS_UI: f32 = 15.0;
const FS_SMALL: f32 = 13.0;

const RULER_H: i32 = 22;
const ROW_H: i32 = 30;
// 状態の帯は 2 行（1 行目: 再生・時刻・ファイル・ヘルプ、2 行目: 操作の結果か診断）
const BAR_LINE_H: i32 = 24;
const BAR_H: i32 = 52;
const HEAD_W: i32 = 60;
const EDGE_PX: i32 = 7;
const SNAP_PX: f64 = 8.0;

const DRAG_NONE: i32 = 0;
const DRAG_SCRUB: i32 = 1;
const DRAG_MOVE: i32 = 2;
const DRAG_TRIM_START: i32 = 3;
const DRAG_TRIM_END: i32 = 4;

const C_BG: u32 = 0xff121218;
const C_PANEL: u32 = 0xff1c1c24;
const C_BAR: u32 = 0xff26262f;
const C_HEAD: u32 = 0xff22222b;
const C_GRID: u32 = 0xff2c2c36;
const C_TEXT: u32 = 0xffd8d8e0;
const C_DIM: u32 = 0xff80808c;
const C_PLAYHEAD: u32 = 0xffff4d4d;
const C_ERR: u32 = 0xffff7070;
const C_OK: u32 = 0xff80e090;
const C_INSP: u32 = 0xd0181820;
const C_ACCENT: u32 = 0xff3b6fd1;
const C_SELROW: u32 = 0xff2a3350;
const C_HOVROW: u32 = 0xff24242e;

// 取り消しの履歴の 1 つ。text は操作の前（取り消しなら戻す先）のファイルの中身、desc はその操作の説明。
struct EdUndo {
  text: string;
  desc: string;
}

struct Editor {
  path: string;
  cache: string;
  text: string;
  crlf: bool;
  lines: string[];
  probeText: string;
  probes: Probe[];
  project: Project;
  // プレビューの文字のクリップに使うフォント。project の fontPath / fontIndex が変わったときだけ読み直す。
  pfont: Font;
  pfontLoaded: bool;
  pfontPath: string;
  pfontIndex: i32;
  media: Media[];
  errors: Diag[];
  rowTrack: i32[];
  rowAudio: bool[];
  // 再生位置（秒）。再生のエンジン（pb）の位置を毎フレーム写したもの（再生ヘッド・分割の位置に使う）
  t: f64;
  // 再生の状態（runEditor が持つ再生のエンジン pb から毎フレーム写したもの。表示用）
  playing: bool;
  playText: string;
  // 再生のエンジンへの頼み（入力の処理が積み、runEditor が pb に順に渡す）。PBQ_* と、その値（秒・コマ数）
  pbq: i32[];
  pbqArg: f64[];
  // プロジェクトや素材が変わったので、pb を合わせ直す（pbReload）必要がある。runEditor がコマの置き場と一緒に行う
  pbStale: bool;
  zoom: f64;
  scroll: f64;
  // 手で拡大縮小するまでは、長さや窓の幅が変わるたびに全体が見えるように合わせ直す
  userZoomed: bool;
  fitDur: f64;
  fitW: i32;
  sel: i32;
  drag: i32;
  dragT0: f64;
  origAt: f64;
  origIn: f64;
  origDur: f64;
  moved: bool;
  mouseX: i32;
  mouseY: i32;
  undo: EdUndo[];
  redo: EdUndo[];
  status: string;
  // 操作の失敗のときの案内（赤で status の後ろに出す）
  statusHint: string;
  statusErr: bool;
  lastPoll: f64;
  previewDirty: bool;
  // 素材の展開を mozcut.mjs が受け持っているか（--managed か、キャッシュを指定して起動されたとき）。
  // 受け持っていなければ、展開されていない素材を「展開しています」ではなく「展開されていません」と出す。
  managed: bool;
}

struct Layout {
  w: i32;
  h: i32;
  pvH: i32;
  imgX: i32;
  imgY: i32;
  imgW: i32;
  imgH: i32;
  barY: i32;
  tlY: i32;
  rows: i32;
}

// ---- プレビューの拡大縮小（kernel） ----

kernel function chan(v: f32): u32 {
  return (Math.min(Math.max(v * 255.0 + 0.5, 0.0), 255.0) as i32) as u32;
}

// プレビューの領域 [0, areaH) を塗る。画像の中は canvas を双一次で拡大縮小し、外は背景色。
kernel function blitPreview(
  i: u32, px: mut Buffer<u32>, canvas: Buffer<vec4<f32>>, winW: u32, areaH: u32,
  ix: i32, iy: i32, iw: i32, ih: i32, cw: i32, ch: i32, bg: u32,
): void {
  const y = i / winW;
  if (y >= areaH) {
    return;
  }
  const x = (i % winW) as i32;
  const dx = x - ix;
  const dy = (y as i32) - iy;
  if (dx < 0 || dy < 0 || dx >= iw || dy >= ih) {
    px[i] = bg;
    return;
  }
  const fx = Math.max(((dx as f32) + 0.5) * (cw as f32) / (iw as f32) - 0.5, 0.0);
  const fy = Math.max(((dy as f32) + 0.5) * (ch as f32) / (ih as f32) - 0.5, 0.0);
  const x0 = Math.min(fx as i32, cw - 1);
  const y0 = Math.min(fy as i32, ch - 1);
  const x1 = Math.min(x0 + 1, cw - 1);
  const y1 = Math.min(y0 + 1, ch - 1);
  const ax = fx - (x0 as f32);
  const ay = fy - (y0 as f32);
  const a = canvas[(y0 * cw + x0) as u32];
  const b = canvas[(y0 * cw + x1) as u32];
  const c = canvas[(y1 * cw + x0) as u32];
  const d = canvas[(y1 * cw + x1) as u32];
  const top = a + (b - a) * ax;
  const bot = c + (d - c) * ax;
  const v = top + (bot - top) * ay;
  px[i] = 0xff000000 | (chan(v.x) << 16) | (chan(v.y) << 8) | chan(v.z);
}

// ---- 読み込み ----

function bytesOf(s: string): u8[] {
  let out: u8[] = [];
  for (const b of s) {
    out.push(b);
  }
  return out;
}

function readText(path: string): string {
  const b = readFile(path);
  if (b == null) {
    return "";
  }
  return stringFromBytes(b);
}

function hasCr(s: string): bool {
  for (const b of s) {
    if (b == 13) {
      return true;
    }
  }
  return false;
}

// 使われているトラックから、タイムラインの行を決める（映像は大きい番号が上、音はその下）。
function computeRows(ed: mut Editor): void {
  ed.rowTrack.clear();
  ed.rowAudio.clear();
  for (let t = MAX_TRACKS - 1; t >= 0; t--) {
    for (const c of ed.project.clips) {
      if (c.kind != KIND_AUDIO && c.track == t) {
        ed.rowTrack.push(t);
        ed.rowAudio.push(false);
        break;
      }
    }
  }
  for (let t = 0; t < MAX_TRACKS; t++) {
    for (const c of ed.project.clips) {
      if (c.kind == KIND_AUDIO && c.track == t) {
        ed.rowTrack.push(t);
        ed.rowAudio.push(true);
        break;
      }
    }
  }
}

// ed.text を読み直す。誤りがあれば前のプロジェクトを使い続けて、誤りを表示する。
function reparse(ed: mut Editor): void {
  let err: Diag[] = [];
  ed.probes = readProbes(`${ed.cache}/probe.txt`);
  const p = parseProject(bytesOf(ed.text), ed.probes, mut err);
  ed.crlf = hasCr(ed.text);
  ed.lines = splitLines(bytesOf(ed.text));
  if (err.length == 0 || ed.project.clips.length == 0) {
    ed.project = p;
    // フォントは読み込みに数 ms かかるので、指定が変わったときだけ読み直す
    if (!ed.pfontLoaded || ed.project.fontPath != ed.pfontPath || ed.project.fontIndex != ed.pfontIndex) {
      ed.pfont = projectFont(ed.project.fontPath, ed.project.fontIndex);
      ed.pfontPath = ed.project.fontPath.clone();
      ed.pfontIndex = ed.project.fontIndex;
      ed.pfontLoaded = true;
    }
    ed.media = loadMedia(ed.project, ed.cache);
    computeRows(mut ed);
    if (ed.sel >= (ed.project.clips.length as i32)) {
      ed.sel = -1;
    }
  }
  ed.errors = err;
  if (ed.t > ed.project.duration) {
    ed.t = ed.project.duration;
  }
  ed.pbStale = true;
  ed.previewDirty = true;
}

// 素材の展開の結果（大きさ・コマ数・展開した範囲・中身の印の .key）が変わったか。変わったら先読みの枠を捨てる。
// .key は mozcut.mjs が展開の始めに消し、置き換えたあと最後に書くので、大きさが同じまま中身が替わっても気づける。
function mediaChanged(a: Media[], b: Media[]): bool {
  if (a.length != b.length) {
    return true;
  }
  for (let i: usize = 0; i < a.length; i++) {
    if (a[i].ok != b[i].ok || a[i].w != b[i].w || a[i].h != b[i].h || a[i].hdr != b[i].hdr || a[i].frames != b[i].frames ||
      a[i].inPt != b[i].inPt || a[i].key != b[i].key) {
      return true;
    }
  }
  return false;
}

function newEditor(path: string, cache: string, managed: bool): Editor {
  let ed: Editor = {
    path: path.clone(),
    cache: cache.clone(),
    text: readText(path),
    crlf: false,
    lines: [],
    probeText: readText(`${cache}/probe.txt`),
    probes: [],
    project: emptyProject(),
    // 空のフォント（最初の reparse で読む）
    pfont: loadFont("", 0),
    pfontLoaded: false,
    pfontPath: "",
    pfontIndex: 0,
    media: [],
    errors: [],
    rowTrack: [],
    rowAudio: [],
    t: 0,
    playing: false,
    playText: "停止",
    pbq: [],
    pbqArg: [],
    pbStale: true,
    zoom: 80,
    scroll: 0,
    userZoomed: false,
    fitDur: -1,
    fitW: 0,
    sel: -1,
    drag: DRAG_NONE,
    dragT0: 0,
    origAt: 0,
    origIn: 0,
    origDur: 0,
    moved: false,
    mouseX: 0,
    mouseY: 0,
    undo: [],
    redo: [],
    status: "",
    statusHint: "",
    statusErr: false,
    lastPoll: 0,
    previewDirty: true,
    managed,
  };
  reparse(mut ed);
  return ed;
}

function setStatus(ed: mut Editor, s: string, isErr: bool): void {
  ed.status = s.clone();
  ed.statusHint = "";
  ed.statusErr = isErr;
}

function setStatusErr(ed: mut Editor, s: string, hint: string): void {
  ed.status = s.clone();
  ed.statusHint = hint.clone();
  ed.statusErr = true;
}

// ファイルと素材の変化を見る（ほかのエディタでの書き換え、mozcut.mjs の展開）。
function poll(ed: mut Editor): void {
  const now = clock();
  if (now - ed.lastPoll < 0.4) {
    return;
  }
  ed.lastPoll = now;
  const text = readText(ed.path);
  const probe = readText(`${ed.cache}/probe.txt`);
  if (text != ed.text && text.length > 0) {
    ed.text = text;
    ed.probeText = probe;
    reparse(mut ed);
    setStatus(mut ed, "ファイルが書き換わったので読み直しました", false);
    return;
  }
  if (probe != ed.probeText) {
    ed.probeText = probe;
    reparse(mut ed);
    return;
  }
  const media = loadMedia(ed.project, ed.cache);
  if (mediaChanged(ed.media, media)) {
    ed.pbStale = true;
  }
  ed.media = media;
  if (ed.drag == DRAG_NONE) {
    ed.previewDirty = true;
  }
}

// ---- 保存と取り消し ----

function joinLines(ed: Editor): string {
  let out: u8[] = [];
  for (const l of ed.lines) {
    for (const b of l) {
      out.push(b);
    }
    if (ed.crlf) {
      out.push(13);
    }
    out.push(10);
  }
  return stringFromBytes(out);
}

function writeText(ed: mut Editor, text: string): bool {
  if (!writeFile(ed.path, bytesOf(text))) {
    setStatusErr(mut ed, `${ed.path} に書き込めません`, "ファイルが読み取り専用でないか、ほかのプログラムが開いていないかを確かめます");
    return false;
  }
  ed.text = text.clone();
  reparse(mut ed);
  return true;
}

// ed.lines を書き換えたあとに呼ぶ。保存して読み直し、取り消しの履歴に desc ごと積む。
function commit(ed: mut Editor, desc: string): void {
  const old = ed.text.clone();
  const text = joinLines(ed);
  if (!writeText(mut ed, text)) {
    return;
  }
  ed.undo.push({ text: old, desc: desc.clone() });
  ed.redo.clear();
  setStatus(mut ed, `${desc}（保存しました）`, false);
}

function undoEdit(ed: mut Editor): void {
  if (ed.undo.length == 0) {
    setStatus(mut ed, "取り消す操作はありません", false);
    return;
  }
  const prev = ed.undo.pop();
  const cur = ed.text.clone();
  if (!writeText(mut ed, prev.text)) {
    ed.undo.push(prev);
    return;
  }
  setStatus(mut ed, `取り消し: ${prev.desc}（保存しました）`, false);
  ed.redo.push({ text: cur, desc: prev.desc.clone() });
}

function redoEdit(ed: mut Editor): void {
  if (ed.redo.length == 0) {
    setStatus(mut ed, "やり直す操作はありません", false);
    return;
  }
  const next = ed.redo.pop();
  const cur = ed.text.clone();
  if (!writeText(mut ed, next.text)) {
    ed.redo.push(next);
    return;
  }
  setStatus(mut ed, `やり直し: ${next.desc}（保存しました）`, false);
  ed.undo.push({ text: cur, desc: next.desc.clone() });
}

function isMedia(kind: i32): bool {
  return kind == KIND_VIDEO || kind == KIND_AUDIO;
}

// 操作でクリップを指す文字列。ID があれば ID、なければ "@行番号"。
function clipRef(ed: Editor, i: i32): string {
  const c = i as usize;
  if (ed.project.clips[c].id != "") {
    return ed.project.clips[c].id.clone();
  }
  return `@${ed.project.clips[c].line}`;
}

// 1 つの操作を ops.um で適用する。成功して行が変われば保存し、説明を状態の帯と取り消しの履歴に出す。
// 失敗したら error と hint を赤で出し、ドラッグで動かした見た目を元に戻す。成功したら true。
function applyOp(ed: mut Editor, op: string[]): bool {
  let ops: string[][] = [];
  ops.push(copyLines(op));
  const res = runOps(ed.lines, ed.probes, ops);
  if (!res.ok || res.results.length == 0) {
    let err = "操作を適用できませんでした";
    let hint = "";
    if (res.results.length > 0) {
      const last = res.results.length - 1;
      err = res.results[last].error.clone();
      if (res.results[last].code != "") {
        err = `[${res.results[last].code}] ${err}`;
      }
      hint = res.results[last].hint.clone();
    }
    // 行は元のまま。ドラッグで書き換えた project を読み直して戻す
    reparse(mut ed);
    setStatusErr(mut ed, err, hint);
    return false;
  }
  const desc = res.results[0].desc.clone();
  if (res.results[0].changes.length == 0) {
    // 変わらなかった（同じ位置に戻した など）。保存も履歴もしない
    reparse(mut ed);
    setStatus(mut ed, desc, false);
    return true;
  }
  ed.lines = copyLines(res.lines);
  commit(mut ed, desc);
  return true;
}

// 動かした・端を詰めたクリップを、操作（move / trim）で行に書き戻す。
function commitClip(ed: mut Editor, i: i32, mode: i32): void {
  const c = i as usize;
  const ref = clipRef(ed, i);
  const at = ed.project.clips[c].at;
  const dur = ed.project.clips[c].dur;
  if (mode == DRAG_MOVE) {
    applyOp(mut ed, ["move", ref, secText(at)]);
  } else if (mode == DRAG_TRIM_START) {
    applyOp(mut ed, ["trim", ref, "start", secText(at)]);
  } else if (mode == DRAG_TRIM_END) {
    applyOp(mut ed, ["trim", ref, "end", secText(at + dur)]);
  }
}

// 選んだクリップを消す（行を注釈にする）。
function deleteClip(ed: mut Editor): void {
  if (ed.sel < 0) {
    setStatusErr(mut ed, "消すクリップが選ばれていません", "タイムラインのクリップをクリックして選んでから Del を押します");
    return;
  }
  const ref = clipRef(ed, ed.sel);
  if (applyOp(mut ed, ["delete", ref])) {
    ed.sel = -1;
  }
}

function frameDur(ed: Editor): f64 {
  return (ed.project.fpsDen as f64) / (ed.project.fpsNum as f64);
}

// 選んだクリップを再生位置で 2 つに分ける。後ろ半分は次の行に足す。
function splitClip(ed: mut Editor): void {
  if (ed.sel < 0) {
    setStatusErr(mut ed, "分けるクリップが選ばれていません", "クリップをクリックして選び、再生位置をその中に置いてから S を押します");
    return;
  }
  const ref = clipRef(ed, ed.sel);
  applyOp(mut ed, ["split", ref, secText(ed.t)]);
}

// ---- 配置の計算 ----

function computeLayout(ed: Editor, w: i32, h: i32): Layout {
  const rows = Math.max(ed.rowTrack.length as i32, 1);
  const tlH = Math.min(RULER_H + rows * ROW_H + 8, h * 45 / 100);
  const tlY = h - tlH;
  const barY = tlY - BAR_H;
  const pvH = Math.max(barY, 1);
  const pw = ed.project.width as f64;
  const ph = ed.project.height as f64;
  const s = Math.min(((w - 24) as f64) / pw, ((pvH - 24) as f64) / ph);
  const iw = Math.max(Math.floor(pw * s) as i32, 1);
  const ih = Math.max(Math.floor(ph * s) as i32, 1);
  return { w, h, pvH, imgX: (w - iw) / 2, imgY: (pvH - ih) / 2, imgW: iw, imgH: ih, barY, tlY, rows };
}

function timeToX(ed: Editor, t: f64): i32 {
  return HEAD_W + (Math.floor((t - ed.scroll) * ed.zoom) as i32);
}

function xToTime(ed: Editor, x: i32): f64 {
  return ed.scroll + ((x - HEAD_W) as f64) / ed.zoom;
}

function rowOf(ed: Editor, c: usize): i32 {
  const audio = ed.project.clips[c].kind == KIND_AUDIO;
  for (let r: usize = 0; r < ed.rowTrack.length; r++) {
    if (ed.rowTrack[r] == ed.project.clips[c].track && ed.rowAudio[r] == audio) {
      return r as i32;
    }
  }
  return 0;
}

function rowY(lay: Layout, r: i32): i32 {
  return lay.tlY + RULER_H + r * ROW_H;
}

// 時間軸を幅に合わせる。
function fitZoom(ed: mut Editor, lay: Layout): void {
  const span = Math.max(ed.project.duration, 1.0) * 1.04;
  ed.zoom = ((lay.w - HEAD_W - 8) as f64) / span;
  ed.scroll = 0;
}

// クリップの当たり判定。後ろの行（上に描かれるもの）から調べる。-1 は外れ。
function hitClip(ed: Editor, lay: Layout, x: i32, y: i32): i32 {
  if (y < lay.tlY + RULER_H) {
    return -1;
  }
  let i = ed.project.clips.length as i32 - 1;
  while (i >= 0) {
    const c = i as usize;
    const ry = rowY(lay, rowOf(ed, c));
    const x0 = timeToX(ed, ed.project.clips[c].at);
    const x1 = timeToX(ed, ed.project.clips[c].at + ed.project.clips[c].dur);
    if (y >= ry + 2 && y < ry + ROW_H - 2 && x >= x0 - 2 && x < Math.max(x1, x0 + 4) + 2) {
      return i;
    }
    i--;
  }
  return -1;
}

// ほかのクリップの端・再生位置・0 に、近ければ吸い付ける。最後にコマの境目に丸める。
function snapTime(ed: Editor, t: f64, exclude: i32): f64 {
  let best = t;
  let bestD = SNAP_PX / ed.zoom;
  let cands: f64[] = [0.0, ed.t];
  for (let i: usize = 0; i < ed.project.clips.length; i++) {
    if ((i as i32) != exclude) {
      cands.push(ed.project.clips[i].at);
      cands.push(ed.project.clips[i].at + ed.project.clips[i].dur);
    }
  }
  for (const c of cands) {
    const d = Math.abs(c - t);
    if (d < bestD) {
      bestD = d;
      best = c;
    }
  }
  const fps = (ed.project.fpsNum as f64) / (ed.project.fpsDen as f64);
  return Math.floor(best * fps + 0.5) / fps;
}

// ---- 入力 ----

// 再生のエンジンへの頼みの種類
const PBQ_SEEK: i32 = 0;
const PBQ_STEP: i32 = 1;
const PBQ_TOGGLE: i32 = 2;
const PBQ_J: i32 = 3;
const PBQ_K: i32 = 4;
const PBQ_L: i32 = 5;
const PBQ_PLAY: i32 = 6;

function pbRequest(ed: mut Editor, kind: i32, arg: f64): void {
  ed.pbq.push(kind);
  ed.pbqArg.push(arg);
}

// 再生位置を t 秒にする（再生中なら、そこから続ける）。表示の位置はすぐに変え、エンジンには頼みを積む。
function seek(ed: mut Editor, t: f64): void {
  ed.t = Math.min(Math.max(t, 0.0), ed.project.duration);
  pbRequest(mut ed, PBQ_SEEK, ed.t);
}

// n コマ進める・戻る（止めてから）。
function stepFrames(ed: mut Editor, n: i64): void {
  pbRequest(mut ed, PBQ_STEP, n as f64);
}

function isPlaying(ed: Editor): bool {
  return ed.playing;
}

// 積んだ頼みを再生のエンジンに渡す（runEditor から、毎フレーム pbTick の前に呼ぶ）。
function applyPbRequests(ed: mut Editor, pb: mut Playback): void {
  const now = clock();
  for (let i: usize = 0; i < ed.pbq.length; i++) {
    const k = ed.pbq[i];
    const a = ed.pbqArg[i];
    if (k == PBQ_SEEK) {
      pbSeek(mut pb, a, now);
    } else if (k == PBQ_STEP) {
      pbStep(mut pb, a as i64, now);
    } else if (k == PBQ_TOGGLE) {
      pbToggle(mut pb, now);
    } else if (k == PBQ_J) {
      pbKeyJ(mut pb, now);
    } else if (k == PBQ_K) {
      pbKeyK(mut pb, now);
    } else if (k == PBQ_L) {
      pbKeyL(mut pb, now);
    } else if (k == PBQ_PLAY) {
      pbPlay(mut pb, a, now);
    }
  }
  ed.pbq.clear();
  ed.pbqArg.clear();
}

function mouseDown(ed: mut Editor, lay: Layout, x: i32, y: i32): void {
  if (y < lay.tlY) {
    return;
  }
  const hit = hitClip(ed, lay, x, y);
  if (hit < 0) {
    ed.sel = -1;
    ed.drag = DRAG_SCRUB;
    seek(mut ed, xToTime(ed, x));
    return;
  }
  ed.sel = hit;
  const c = hit as usize;
  const x0 = timeToX(ed, ed.project.clips[c].at);
  const x1 = timeToX(ed, ed.project.clips[c].at + ed.project.clips[c].dur);
  ed.drag = DRAG_MOVE;
  if (x1 - x0 > 3 * EDGE_PX) {
    if (x < x0 + EDGE_PX) {
      ed.drag = DRAG_TRIM_START;
    } else if (x >= x1 - EDGE_PX) {
      ed.drag = DRAG_TRIM_END;
    }
  }
  ed.dragT0 = xToTime(ed, x);
  ed.origAt = ed.project.clips[c].at;
  ed.origIn = ed.project.clips[c].inPt;
  ed.origDur = ed.project.clips[c].dur;
  ed.moved = false;
}

function mouseMove(ed: mut Editor, x: i32, y: i32): void {
  ed.mouseX = x;
  ed.mouseY = y;
  if (ed.drag == DRAG_NONE) {
    return;
  }
  if (ed.drag == DRAG_SCRUB) {
    seek(mut ed, xToTime(ed, x));
    return;
  }
  const c = ed.sel as usize;
  const dt = xToTime(ed, x) - ed.dragT0;
  if (Math.abs(dt) * ed.zoom >= 2) {
    ed.moved = true;
  }
  if (!ed.moved) {
    return;
  }
  const fr = frameDur(ed);
  const media = isMedia(ed.project.clips[c].kind);
  if (ed.drag == DRAG_MOVE) {
    let at = snapTime(ed, ed.origAt + dt, ed.sel);
    // 終わりの側でも吸い付ける
    const end = snapTime(ed, ed.origAt + ed.origDur + dt, ed.sel);
    if (Math.abs(end - (ed.origAt + ed.origDur + dt)) < Math.abs(at - (ed.origAt + dt))) {
      at = end - ed.origDur;
    }
    ed.project.clips[c].at = Math.max(at, 0.0);
  } else if (ed.drag == DRAG_TRIM_START) {
    let at = snapTime(ed, ed.origAt + dt, ed.sel);
    at = Math.min(at, ed.origAt + ed.origDur - fr);
    at = Math.max(at, 0.0);
    if (media) {
      at = Math.max(at, ed.origAt - ed.origIn);
    }
    ed.project.clips[c].at = at;
    ed.project.clips[c].inPt = ed.origIn + (at - ed.origAt);
    ed.project.clips[c].dur = ed.origDur - (at - ed.origAt);
  } else if (ed.drag == DRAG_TRIM_END) {
    const end = snapTime(ed, ed.origAt + ed.origDur + dt, ed.sel);
    ed.project.clips[c].dur = Math.max(end - ed.origAt, fr);
  }
  ed.previewDirty = true;
}

function mouseUp(ed: mut Editor): void {
  const mode = ed.drag;
  ed.drag = DRAG_NONE;
  if ((mode == DRAG_MOVE || mode == DRAG_TRIM_START || mode == DRAG_TRIM_END) && ed.moved && ed.sel >= 0) {
    commitClip(mut ed, ed.sel, mode);
  }
}

function wheel(ed: mut Editor, lay: Layout, dx: i32, dy: i32, shift: bool): void {
  if (ed.mouseY < lay.tlY) {
    return;
  }
  ed.userZoomed = true;
  if (shift || dx != 0) {
    const d = dx - dy;
    ed.scroll = Math.max(ed.scroll - (d as f64) * 60 / ed.zoom, 0.0);
    return;
  }
  // マウスの下の時刻を保ったまま拡大縮小
  const anchor = xToTime(ed, ed.mouseX);
  let z = ed.zoom;
  if (dy > 0) {
    z = z * 1.25;
  } else if (dy < 0) {
    z = z / 1.25;
  }
  ed.zoom = Math.min(Math.max(z, 2.0), 2000.0);
  ed.scroll = Math.max(anchor - ((ed.mouseX - HEAD_W) as f64) / ed.zoom, 0.0);
}

function keyDown(ed: mut Editor, lay: Layout, key: Key, mods: Mods): bool {
  match (key) {
    Key.Escape => {
      if (ed.drag != DRAG_NONE) {
        ed.drag = DRAG_NONE;
        reparse(mut ed);
      } else {
        ed.sel = -1;
      }
    }
    Key.Space => { pbRequest(mut ed, PBQ_TOGGLE, 0); }
    Key.Left => {
      if (mods.shift) {
        seek(mut ed, ed.t - 1);
      } else {
        stepFrames(mut ed, -1);
      }
    }
    Key.Right => {
      if (mods.shift) {
        seek(mut ed, ed.t + 1);
      } else {
        stepFrames(mut ed, 1);
      }
    }
    Key.Home => { seek(mut ed, 0); }
    Key.End => { seek(mut ed, ed.project.duration); }
    Key.Delete => { deleteClip(mut ed); }
    Key.Backspace => { deleteClip(mut ed); }
    Key.Char(cp) => {
      if (mods.ctrl || mods.meta) {
        if (cp == 122 && mods.shift) {
          redoEdit(mut ed);
        } else if (cp == 122) {
          undoEdit(mut ed);
        } else if (cp == 121) {
          redoEdit(mut ed);
        } else if (cp == 113 || cp == 119) {
          return false;
        }
      } else if (cp == 115) {
        splitClip(mut ed);
      } else if (cp == 102) {
        fitZoom(mut ed, lay);
        ed.userZoomed = false;
      } else if (cp == 106) {
        // J: 逆再生（押すたびに 1 → 2 → 4 倍）
        pbRequest(mut ed, PBQ_J, 0);
      } else if (cp == 108) {
        // L: 順再生（押すたびに 1 → 2 → 4 倍）
        pbRequest(mut ed, PBQ_L, 0);
      } else if (cp == 107) {
        // K: 止める
        pbRequest(mut ed, PBQ_K, 0);
      }
    }
    _ => {}
  }
  return true;
}

// ---- 描画 ----
// 文字はすべて uiTextF（TrueType）。font は起動時に 1 回読んだ uiFont()、tc はフレームをまたいで使う文字の画像の置き場。

// 高さ h の帯の中で、大きさ size の 1 行の文字を縦の真ん中に置くときの y。
function textTop(top: i32, h: i32, size: f32, font: Font): i32 {
  return top + (h - uiTextHeightF(size, font)) / 2;
}

function kindColor(kind: i32, sel: bool): u32 {
  let c: u32 = 0xff3b6fd1;
  if (kind == KIND_IMAGE) {
    c = 0xff3f9a5c;
  } else if (kind == KIND_TEXT) {
    c = 0xffc9822e;
  } else if (kind == KIND_COLOR) {
    c = 0xff8a55c4;
  } else if (kind == KIND_AUDIO) {
    c = 0xff2c958f;
  }
  if (sel) {
    const r = Math.min(((c >> 16) & 255) + 50, 255 as u32);
    const g = Math.min(((c >> 8) & 255) + 50, 255 as u32);
    const b = Math.min((c & 255) + 50, 255 as u32);
    c = 0xff000000 | (r << 16) | (g << 8) | b;
  }
  return c;
}

// 種類の日本語の名前（インスペクタ用）。行の頭の語も括弧で添える。
function kindLabel(kind: i32): string {
  if (kind == KIND_VIDEO) {
    return "映像（video）";
  }
  if (kind == KIND_IMAGE) {
    return "画像（image）";
  }
  if (kind == KIND_TEXT) {
    return "文字（text）";
  }
  if (kind == KIND_COLOR) {
    return "色（color）";
  }
  if (kind == KIND_AUDIO) {
    return "音（audio）";
  }
  return "不明";
}

function baseName(s: string): string {
  let start: usize = 0;
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 47 || s[i] == 92) {
      start = i + 1;
    }
  }
  let out: u8[] = [];
  for (let i = start; i < s.length; i++) {
    out.push(s[i]);
  }
  return stringFromBytes(out);
}

function firstLine(s: string): string {
  let out: u8[] = [];
  for (const b of s) {
    if (b == 10) {
      break;
    }
    out.push(b);
  }
  return stringFromBytes(out);
}

function clipLabel(c: Clip): string {
  let s = "";
  if (c.kind == KIND_TEXT) {
    s = `「${firstLine(c.text)}」`;
  } else if (c.kind == KIND_COLOR) {
    s = "色";
  } else {
    s = baseName(c.src);
  }
  if (c.id != "") {
    return `${c.id}: ${s}`;
  }
  return s;
}

// 診断を 1 行で: "demo.mzc:7:12 エラー[unknown-key] msg ／ ヒント: hint"（report.um の diagText と同じ内容）。
function diagLine(path: string, d: Diag): string {
  let sev = "警告";
  if (d.severity == "error") {
    sev = "エラー";
  }
  let pos = path.clone();
  if (d.line > 0) {
    pos = pos + `:${d.line}`;
    if (d.col > 0) {
      pos = pos + `:${d.col}`;
    }
  }
  let s = `${pos} ${sev}[${d.code}] ${d.msg}`;
  if (d.hint != "") {
    s = s + ` ／ ヒント: ${d.hint}`;
  }
  return s;
}

function shortTime(t: f64, step: f64): string {
  const m = Math.floor(t / 60) as i64;
  const s = t - (m as f64) * 60;
  if (step < 1) {
    const ds = Math.floor(s * 10 + 0.5) as i64;
    const whole = ds / 10;
    let ws = `${whole}`;
    if (whole < 10) {
      ws = `0${whole}`;
    }
    return `${m}:${ws}.${ds % 10}`;
  }
  const si = Math.floor(s + 0.5) as i64;
  let ss = `${si}`;
  if (si < 10) {
    ss = `0${si}`;
  }
  return `${m}:${ss}`;
}

function drawRuler(px: mut Buffer<u32>, ed: Editor, lay: Layout, font: Font, tc: mut UiTextCache): void {
  const W = lay.w;
  const H = lay.h;
  uiRect(mut px, W, H, 0, lay.tlY, W, RULER_H, C_BAR);
  const steps: f64[] = [0.1, 0.2, 0.5, 1, 2, 5, 10, 15, 30, 60, 120, 300, 600];
  let step: f64 = 600;
  for (const s of steps) {
    if (s * ed.zoom >= 80) {
      step = s;
      break;
    }
  }
  const ty = textTop(lay.tlY, RULER_H - 4, FS_SMALL, font);
  let t = Math.floor(ed.scroll / step) * step;
  const tEnd = xToTime(ed, W);
  while (t <= tEnd) {
    const x = timeToX(ed, t);
    if (x >= HEAD_W) {
      uiRect(mut px, W, H, x, lay.tlY + RULER_H - 6, 1, 6, C_DIM);
      uiRect(mut px, W, H, x, lay.tlY + RULER_H, 1, lay.h - lay.tlY - RULER_H, C_GRID);
      uiTextF(mut px, W, H, x + 4, ty, shortTime(t, step), C_DIM, FS_SMALL, HEAD_W, W, font, mut tc);
    }
    t += step;
  }
  // プロジェクトの終わり
  const xe = timeToX(ed, ed.project.duration);
  if (xe >= HEAD_W) {
    uiBlend(mut px, W, H, xe, lay.tlY + RULER_H, W - xe, lay.h - lay.tlY - RULER_H, 0x60000000);
  }
}

function drawTimeline(px: mut Buffer<u32>, ed: Editor, lay: Layout, font: Font, tc: mut UiTextCache): void {
  const W = lay.w;
  const H = lay.h;
  uiRect(mut px, W, H, 0, lay.tlY, W, H - lay.tlY, C_PANEL);
  drawRuler(mut px, ed, lay, font, mut tc);
  // 行の見出し
  for (let r: usize = 0; r < ed.rowTrack.length; r++) {
    const y = rowY(lay, r as i32);
    uiRect(mut px, W, H, 0, y, HEAD_W, ROW_H, C_HEAD);
    uiRect(mut px, W, H, 0, y + ROW_H - 1, W, 1, C_GRID);
    let name = `映像${ed.rowTrack[r]}`;
    if (ed.rowAudio[r]) {
      name = `音声${ed.rowTrack[r]}`;
    }
    uiTextF(mut px, W, H, 8, textTop(y, ROW_H, FS_SMALL, font), name, C_DIM, FS_SMALL, 0, HEAD_W, font, mut tc);
  }
  // クリップ
  for (let i: usize = 0; i < ed.project.clips.length; i++) {
    const c = i as i32;
    const y = rowY(lay, rowOf(ed, i)) + 2;
    const x0 = Math.max(timeToX(ed, ed.project.clips[i].at), HEAD_W);
    const x1 = Math.min(timeToX(ed, ed.project.clips[i].at + ed.project.clips[i].dur), W);
    if (x1 <= x0) {
      continue;
    }
    const sel = c == ed.sel;
    uiRect(mut px, W, H, x0, y, x1 - x0, ROW_H - 4, kindColor(ed.project.clips[i].kind, sel));
    // フェードは暗い帯で見せる
    const fin = ed.project.clips[i].fadeIn;
    const fout = ed.project.clips[i].fadeOut;
    if (fin > 0) {
      const xa = timeToX(ed, ed.project.clips[i].at);
      const xb = timeToX(ed, ed.project.clips[i].at + fin);
      uiBlend(mut px, W, H, Math.max(xa, x0), y + ROW_H - 9, Math.min(xb, x1) - Math.max(xa, x0), 5, 0x90000000);
    }
    if (fout > 0) {
      const xb = timeToX(ed, ed.project.clips[i].at + ed.project.clips[i].dur);
      const xa = timeToX(ed, ed.project.clips[i].at + ed.project.clips[i].dur - fout);
      uiBlend(mut px, W, H, Math.max(xa, x0), y + ROW_H - 9, Math.min(xb, x1) - Math.max(xa, x0), 5, 0x90000000);
    }
    // 名前は帯の上寄り（下のフェードの帯に重ならないように）
    const ty = textTop(y, ROW_H - 9, FS_SMALL, font);
    uiTextF(mut px, W, H, x0 + 6, ty, clipLabel(ed.project.clips[i]), 0xffffffff, FS_SMALL, x0 + 3, x1 - 3, font, mut tc);
    if (sel) {
      uiFrame(mut px, W, H, x0, y, x1 - x0, ROW_H - 4, 2, 0xffffffff);
    }
  }
  // 再生位置
  const xp = timeToX(ed, ed.t);
  if (xp >= HEAD_W && xp < W) {
    uiRect(mut px, W, H, xp - 5, lay.tlY, 11, 6, C_PLAYHEAD);
    uiRect(mut px, W, H, xp, lay.tlY, 1, H - lay.tlY, C_PLAYHEAD);
  }
}

function drawBar(px: mut Buffer<u32>, ed: Editor, lay: Layout, font: Font, tc: mut UiTextCache): void {
  const W = lay.w;
  const H = lay.h;
  const y = lay.barY;
  uiRect(mut px, W, H, 0, y, W, BAR_H, C_BAR);
  uiRect(mut px, W, H, 0, y, W, 1, C_GRID);
  // 1 行目: 再生の状態・時刻・ファイル・ヘルプ
  const y1 = textTop(y + 2, BAR_LINE_H, FS_UI, font);
  const state = ed.playText.clone();
  let x = 10;
  x += uiTextF(mut px, W, H, x, y1, state, C_TEXT, FS_UI, 0, W, font, mut tc) + 12;
  x += uiTextF(mut px, W, H, x, y1, `${fmtTime(ed.t)} / ${fmtTime(ed.project.duration)}`, C_TEXT, FS_UI, 0, W, font, mut tc) + 24;
  const help = "Space 再生  J/K/L 速さ  ←→ コマ送り  S 分割  Del 削除  Ctrl+Z 取り消し  F 全体";
  const hw = uiTextWidthF(help, FS_UI, font);
  const helpX = W - hw - 10;
  let nameEnd = W - 10;
  if (helpX > x + 120) {
    uiTextF(mut px, W, H, helpX, y1, help, C_DIM, FS_UI, 0, W, font, mut tc);
    nameEnd = helpX - 16;
  }
  x += uiTextF(mut px, W, H, x, y1, baseName(ed.path), C_DIM, FS_UI, x, nameEnd, font, mut tc) + 24;
  // 2 行目を診断が使うときは、成功した操作の説明は 1 行目に出す
  if (!ed.statusErr && ed.errors.length > 0 && ed.status != "") {
    uiTextF(mut px, W, H, x, y1, ed.status, C_OK, FS_UI, x, nameEnd, font, mut tc);
  }
  // 2 行目: 操作の結果（失敗なら error と hint を赤で）か、ファイルの診断
  const y2 = textTop(y + 2 + BAR_LINE_H, BAR_LINE_H, FS_UI, font);
  let msg = ed.status.clone();
  let col = C_OK;
  if (ed.statusErr) {
    col = C_ERR;
    if (ed.statusHint != "") {
      msg = msg + ` ／ ヒント: ${ed.statusHint}`;
    }
  } else if (ed.errors.length > 0) {
    msg = diagLine(baseName(ed.path), ed.errors[0]);
    if (ed.errors.length > 1) {
      msg = msg + `（ほかに ${ed.errors.length - 1} 件）`;
    }
    col = C_ERR;
  }
  uiTextF(mut px, W, H, 10, y2, msg, col, FS_UI, 0, W - 10, font, mut tc);
}

// 選んだクリップの情報（インスペクタの第一歩）。プレビューの右下に、ID・種類・開始〜終わり・行の文字列を出す。
function drawInspector(px: mut Buffer<u32>, ed: Editor, lay: Layout, font: Font, tc: mut UiTextCache): void {
  if (ed.sel < 0 || (ed.sel as usize) >= ed.project.clips.length) {
    return;
  }
  const W = lay.w;
  const H = lay.h;
  const c = ed.sel as usize;
  const lh = uiTextHeightF(FS_SMALL, font) + 6;
  const bw = Math.min(W - 24, Math.max(360, W * 45 / 100));
  const bh = 2 * lh + 12;
  const bx = W - bw - 12;
  const by = lay.pvH - bh - 8;
  if (bw < 80 || by < 0) {
    return;
  }
  uiBlend(mut px, W, H, bx, by, bw, bh, C_INSP);
  uiFrame(mut px, W, H, bx, by, bw, bh, 1, C_GRID);
  let id = ed.project.clips[c].id.clone();
  if (id == "") {
    id = "（なし）";
  }
  const at = ed.project.clips[c].at;
  const end = at + ed.project.clips[c].dur;
  const ln = ed.project.clips[c].line;
  const info = `ID ${id}   ${kindLabel(ed.project.clips[c].kind)}   ${fmtTime(at)}〜${fmtTime(end)}   ${ln} 行目`;
  let tx = bx + 8;
  const ty = by + 6 + (lh - uiTextHeightF(FS_SMALL, font)) / 2;
  uiTextF(mut px, W, H, tx, ty, info, C_TEXT, FS_SMALL, bx + 4, bx + bw - 4, font, mut tc);
  let text = "";
  const k = (ln - 1) as usize;
  if (ln >= 1 && k < ed.lines.length) {
    text = ed.lines[k].clone();
  }
  uiTextF(mut px, W, H, tx, ty + lh, text, 0xffb8c4ff, FS_SMALL, bx + 4, bx + bw - 4, font, mut tc);
}

// 展開中の素材があれば、プレビューに表示する。
function pendingCount(ed: Editor): i32 {
  let n = 0;
  for (let i: usize = 0; i < ed.project.clips.length; i++) {
    const k = ed.project.clips[i].kind;
    const used = ed.project.clips[i].at <= ed.t && ed.project.clips[i].at + ed.project.clips[i].dur > ed.t;
    if (used && (k == KIND_VIDEO || k == KIND_IMAGE) && !ed.media[i].ok) {
      n++;
    }
  }
  return n;
}

// ---- パス ----
// UM には今いるフォルダや実行ファイルの場所を知る組み込みがないので、パスは文字のまま扱う（相対パスは今いるフォルダから）。

function isSep(b: u8): bool {
  return b == 47 || b == 92;
}

function isAbsPath(s: string): bool {
  if (s.length > 0 && isSep(s[0])) {
    return true;
  }
  // C:\ や C:/
  return s.length > 2 && s[1] == 58 && isSep(s[2]);
}

// 区切りの文字（\ を含むなら \、それ以外は /）。
function sepOf(s: string): u8 {
  for (const b of s) {
    if (b == 92) {
      return 92;
    }
  }
  return 47;
}

// "." と ".." を文字の上で畳む（"build/../demo/demo.mzc" → "demo/demo.mzc"）。区切りは元のパスに合わせる。
function normPath(s: string): string {
  const sep = sepOf(s);
  let segs: string[] = [];
  let cur: u8[] = [];
  for (let i: usize = 0; i <= s.length; i++) {
    if (i == s.length || isSep(s[i])) {
      segs.push(stringFromBytes(cur));
      cur = [];
    } else {
      cur.push(s[i]);
    }
  }
  const rootSlash = s.length > 0 && isSep(s[0]);
  let out: string[] = [];
  // 根（"C:"）は .. で消さない
  let fixed: usize = 0;
  for (let k: usize = 0; k < segs.length; k++) {
    const g = segs[k].clone();
    if (k == 0 && g.length == 2 && g[1] == 58) {
      out.push(g);
      fixed = 1;
      continue;
    }
    if (g == "" || g == ".") {
      continue;
    }
    if (g == "..") {
      if (out.length > fixed && out[out.length - 1] != "..") {
        out.pop();
        continue;
      }
      if (rootSlash || fixed > 0) {
        // 根より上はない
        continue;
      }
    }
    out.push(g);
  }
  let r: u8[] = [];
  if (rootSlash) {
    r.push(sep);
  }
  for (let k: usize = 0; k < out.length; k++) {
    if (k > 0) {
      r.push(sep);
    }
    for (const b of out[k]) {
      r.push(b);
    }
  }
  if (fixed > 0 && out.length == 1) {
    r.push(sep);
  }
  if (r.length == 0) {
    return ".";
  }
  return stringFromBytes(r);
}

function joinPath(dir: string, rel: string): string {
  if (dir == "" || dir == "." || isAbsPath(rel)) {
    return normPath(rel);
  }
  let r: u8[] = [];
  for (const b of dir) {
    r.push(b);
  }
  if (!isSep(dir[dir.length - 1])) {
    r.push(sepOf(dir));
  }
  for (const b of rel) {
    r.push(b);
  }
  return normPath(stringFromBytes(r));
}

// プロジェクトのキャッシュのフォルダ（mozcut.mjs の cacheDir と同じ: 同じフォルダの <拡張子を除いた名前>.cache）。
function cacheFor(project: string): string {
  let nameStart: usize = 0;
  for (let i: usize = 0; i < project.length; i++) {
    if (isSep(project[i])) {
      nameStart = i + 1;
    }
  }
  let end = project.length;
  for (let i = nameStart; i < project.length; i++) {
    if (project[i] == 46 && i > nameStart) {
      end = i;
    }
  }
  let r: u8[] = [];
  for (let i: usize = 0; i < end; i++) {
    r.push(project[i]);
  }
  for (const b of ".cache") {
    r.push(b);
  }
  return stringFromBytes(r);
}

function fileExists(path: string): bool {
  const n = fileSize(path);
  if (n != null) {
    return true;
  }
  return false;
}

// 同じファイルか（区切りと . / .. を揃えて比べる。Windows のパスなら英字の大小を無視する）。
function samePath(a: string, b: string): bool {
  const x = normPath(a);
  const y = normPath(b);
  if (x.length != y.length) {
    return false;
  }
  const fold = x.length > 1 && x[1] == 58;
  for (let i: usize = 0; i < x.length; i++) {
    let p = x[i];
    let q = y[i];
    if (isSep(p) && isSep(q)) {
      continue;
    }
    if (fold) {
      if (p >= 65 && p <= 90) {
        p = p + 32;
      }
      if (q >= 65 && q <= 90) {
        q = q + 32;
      }
    }
    if (p != q) {
      return false;
    }
  }
  return true;
}

// 大小を無視して（Windows のパスのとき）、s が suffix で終わり、その前が区切りか。区切りの \ と / は同じに見る。
function endsWithPath(s: string, suffix: string): bool {
  if (suffix.length == 0 || suffix.length > s.length) {
    return false;
  }
  const off = s.length - suffix.length;
  if (off > 0 && !isSep(s[off - 1])) {
    return false;
  }
  for (let i: usize = 0; i < suffix.length; i++) {
    let p = s[off + i];
    let q = suffix[i];
    if (isSep(p) && isSep(q)) {
      continue;
    }
    if (p >= 65 && p <= 90) {
      p = p + 32;
    }
    if (q >= 65 && q <= 90) {
      q = q + 32;
    }
    if (p != q) {
      return false;
    }
  }
  return true;
}

// 同じファイルを指していそうか。samePath に加えて、片方が相対パス（今いるフォルダから）・片方が絶対パスのときは、
// 絶対パスが相対パスで終わり、どちらも読めて中身が同じなら同じと見る（UM には今いるフォルダを知る組み込みがないため）。
function sameFile(a: string, b: string): bool {
  if (samePath(a, b)) {
    return true;
  }
  const aa = isAbsPath(a);
  const ba = isAbsPath(b);
  if (aa == ba) {
    return false;
  }
  let abs = normPath(a);
  let rel = normPath(b);
  if (ba) {
    abs = normPath(b);
    rel = normPath(a);
  }
  if (textStartsWith(rel, "..") || !endsWithPath(abs, rel)) {
    return false;
  }
  const ta = readFile(abs);
  if (ta == null) {
    return false;
  }
  const tb = readFile(rel);
  if (tb == null) {
    return false;
  }
  return stringFromBytes(ta) == stringFromBytes(tb);
}

// ---- 最近開いたプロジェクト（<home>/mozcut-recent.txt） ----
// home が "" のとき（実行ファイルの場所が分からないとき）は、一覧を読みも書きもしない（今いるフォルダを散らかさないため）。
// 一覧には絶対パスだけを書く（相対パスは、別のフォルダから起動したスタート画面では開けないため）。
// 1 行に 1 つのパス、新しい順、最大 RECENT_MAX 件。# で始まる行と空の行は読み飛ばす。

const RECENT_MAX: usize = 10;

function recentFile(home: string): string {
  return joinPath(home, "mozcut-recent.txt");
}

function trimLine(s: string): string {
  let a: usize = 0;
  let b = s.length;
  while (a < b && (s[a] == 32 || s[a] == 9)) {
    a++;
  }
  while (b > a && (s[b - 1] == 32 || s[b - 1] == 9 || s[b - 1] == 13)) {
    b--;
  }
  let r: u8[] = [];
  for (let i = a; i < b; i++) {
    r.push(s[i]);
  }
  return stringFromBytes(r);
}

function readRecent(home: string): string[] {
  let out: string[] = [];
  if (home == "") {
    return out;
  }
  for (const l of splitLines(bytesOf(readText(recentFile(home))))) {
    const t = trimLine(l);
    if (t == "" || t[0] == 35) {
      continue;
    }
    let dup = false;
    for (const o of out) {
      if (samePath(o, t)) {
        dup = true;
      }
    }
    if (!dup && out.length < RECENT_MAX) {
      out.push(t);
    }
  }
  return out;
}

function writeRecent(home: string, list: string[]): bool {
  if (home == "") {
    return false;
  }
  let text = "# MozaicCut の最近開いたプロジェクト（新しい順、最大 10 件。編集画面が書き換えます）\n";
  for (const p of list) {
    text = text + p + "\n";
  }
  return writeFile(recentFile(home), bytesOf(text));
}

// 開いたプロジェクトを先頭に足す（同じものは前の位置から外す）。相対パスは足さない（UM には今いるフォルダを知る
// 組み込みがなく、絶対パスにできないため。node tools/mozcut.mjs edit は絶対パスで渡す）。
function addRecent(home: string, path: string): void {
  if (home == "") {
    return;
  }
  if (!isAbsPath(path)) {
    eprint(`note: '${path}' is a relative path, so it is not added to the recent list (open it with an absolute path or via 'node tools/mozcut.mjs edit')`);
    return;
  }
  let list: string[] = [normPath(path)];
  for (const p of readRecent(home)) {
    if (!samePath(p, path) && list.length < RECENT_MAX) {
      list.push(p.clone());
    }
  }
  if (!writeRecent(home, list)) {
    eprint(`warning: cannot write '${recentFile(home)}'`);
  }
}

function removeRecent(home: string, path: string): bool {
  let list: string[] = [];
  for (const p of readRecent(home)) {
    if (!samePath(p, path)) {
      list.push(p.clone());
    }
  }
  return writeRecent(home, list);
}

// 実行ファイルのフォルダの推定（--home がないとき）。今いるフォルダに build/mozcut-edit があれば build、
// 今いるフォルダに mozcut-edit があれば今いるフォルダ（エクスプローラーなどから実行ファイルを開くと、今いるフォルダは
// そのフォルダになる）。どちらでもなければ ""（分からない。デモと最近の一覧は使わず、スタート画面で --home を案内する）。
// UM に実行ファイルの場所を知る組み込みが入ったら、それに置き換える。
function guessHome(): string {
  if (fileExists("build/mozcut-edit.exe") || fileExists("build/mozcut-edit")) {
    return "build";
  }
  if (fileExists("mozcut-edit.exe") || fileExists("mozcut-edit")) {
    return ".";
  }
  return "";
}

// ---- スタート画面 ----

const START_ROW_H: i32 = 44;
const START_COL_W: i32 = 760;
const FS_TITLE: f32 = 34.0;
const START_BAR_H: i32 = 34;

struct StartItem {
  // 表に出す名前と、その横に薄く出す説明（パス）
  name: string;
  path: string;
  demo: bool;
  exists: bool;
}

struct Start {
  home: string;
  items: StartItem[];
  // デモの項目があるか（あれば items[0]）
  hasDemo: bool;
  demoPath: string;
  sel: i32;
  hover: i32;
  status: string;
  statusErr: bool;
  mouseX: i32;
  mouseY: i32;
}

struct StartLay {
  x: i32;
  w: i32;
  titleY: i32;
  demoLabelY: i32;
  demoY: i32;
  recentLabelY: i32;
  recentY: i32;
  guideY: i32;
  barY: i32;
}

function loadStartItems(st: mut Start): void {
  st.items.clear();
  st.demoPath = "";
  st.hasDemo = false;
  if (st.home != "") {
    st.demoPath = joinPath(st.home, "../demo/demo.mzc");
    st.hasDemo = fileExists(st.demoPath);
  }
  if (st.hasDemo) {
    st.items.push({ name: "デモを開く", path: st.demoPath.clone(), demo: true, exists: true });
  }
  for (const p of readRecent(st.home)) {
    // デモは「はじめる」に出しているので、最近の一覧には重ねて出さない
    if (st.hasDemo && sameFile(p, st.demoPath)) {
      continue;
    }
    st.items.push({ name: baseName(p), path: p.clone(), demo: false, exists: fileExists(p) });
  }
  if (st.sel >= (st.items.length as i32)) {
    st.sel = (st.items.length as i32) - 1;
  }
  if (st.sel < 0 && st.items.length > 0) {
    st.sel = 0;
  }
}

function newStart(home: string): Start {
  let st: Start = {
    home: home.clone(), items: [], hasDemo: false, demoPath: "", sel: 0, hover: -1,
    status: "", statusErr: false, mouseX: -1, mouseY: -1,
  };
  loadStartItems(mut st);
  return st;
}

function recentCount(st: Start): i32 {
  if (st.hasDemo) {
    return (st.items.length as i32) - 1;
  }
  return st.items.length as i32;
}

function startLayout(st: Start, W: i32, H: i32): StartLay {
  const w = Math.min(START_COL_W, W - 32);
  const x = (W - w) / 2;
  const recents = Math.max(recentCount(st), 1);
  // 中身の高さ（タイトル 76、はじめる 26 + 行、最近 26 + 行 × n、使い方 26 + 3 行）
  const content = 76 + 16 + 26 + START_ROW_H + 20 + 26 + recents * START_ROW_H + 20 + 26 + 96;
  const avail = H - START_BAR_H;
  const top = Math.max((avail - content) / 2, 16);
  const titleY = top;
  const demoLabelY = titleY + 76 + 16;
  const demoY = demoLabelY + 26;
  const recentLabelY = demoY + START_ROW_H + 20;
  const recentY = recentLabelY + 26;
  const guideY = recentY + recents * START_ROW_H + 20;
  return { x, w, titleY, demoLabelY, demoY, recentLabelY, recentY, guideY, barY: H - START_BAR_H };
}

// 項目 i の行の上端。
function startRowY(st: Start, lay: StartLay, i: i32): i32 {
  if (st.hasDemo) {
    if (i == 0) {
      return lay.demoY;
    }
    return lay.recentY + (i - 1) * START_ROW_H;
  }
  return lay.recentY + i * START_ROW_H;
}

function startHit(st: Start, lay: StartLay, x: i32, y: i32): i32 {
  if (x < lay.x || x >= lay.x + lay.w) {
    return -1;
  }
  for (let i: usize = 0; i < st.items.length; i++) {
    const ry = startRowY(st, lay, i as i32);
    if (y >= ry && y < ry + START_ROW_H - 4) {
      return i as i32;
    }
  }
  return -1;
}

function drawStartRow(
  px: mut Buffer<u32>, W: i32, H: i32, st: Start, lay: StartLay, i: i32, font: Font, tc: mut UiTextCache,
): void {
  const it = i as usize;
  const y = startRowY(st, lay, i);
  const h = START_ROW_H - 4;
  const sel = i == st.sel;
  let bg = C_PANEL;
  if (sel) {
    bg = C_SELROW;
  } else if (i == st.hover) {
    bg = C_HOVROW;
  }
  uiRect(mut px, W, H, lay.x, y, lay.w, h, bg);
  if (sel) {
    uiRect(mut px, W, H, lay.x, y, 3, h, C_ACCENT);
  }
  let nameCol = C_TEXT;
  if (!st.items[it].exists) {
    nameCol = C_DIM;
  }
  const ty = textTop(y, h, FS_UI, font);
  const right = lay.x + lay.w - 12;
  // 右端の添え書き: 見つからない / 選んでいれば「Enter で開く」
  let note = "";
  let noteCol = C_DIM;
  if (!st.items[it].exists) {
    note = "見つかりません";
    noteCol = C_ERR;
  } else if (sel) {
    note = "Enter で開く";
  }
  let noteX = right;
  if (note != "") {
    noteX = right - uiTextWidthF(note, FS_SMALL, font);
    uiTextF(mut px, W, H, noteX, textTop(y, h, FS_SMALL, font), note, noteCol, FS_SMALL, 0, W, font, mut tc);
  }
  const x0 = lay.x + 16;
  const nw = uiTextF(mut px, W, H, x0, ty, uiFitEnd(st.items[it].name, noteX - 16 - x0, FS_UI, font), nameCol, FS_UI, x0, noteX - 16, font, mut tc);
  const px0 = x0 + nw + 14;
  if (px0 < noteX - 40) {
    // 長いパスは途中を「…」で省き、区別に要る後ろ（フォルダ名とファイル名）を残す
    const shown = uiFitMiddle(st.items[it].path, noteX - 16 - px0, FS_SMALL, font);
    uiTextF(mut px, W, H, px0, textTop(y, h, FS_SMALL, font), shown, C_DIM, FS_SMALL, px0, noteX - 16, font, mut tc);
  }
}

function drawStart(px: mut Buffer<u32>, W: i32, H: i32, st: Start, font: Font, tc: mut UiTextCache): void {
  const lay = startLayout(st, W, H);
  uiRect(mut px, W, H, 0, 0, W, H, C_BG);
  // タイトル
  const tx = lay.x;
  uiTextF(mut px, W, H, tx, lay.titleY, "MozaicCut", C_TEXT, FS_TITLE, 0, W, font, mut tc);
  const subY = lay.titleY + uiTextHeightF(FS_TITLE, font) + 6;
  uiTextF(mut px, W, H, tx + 2, subY, "プロジェクト（.mzc）を開いて、カット編集・プレビュー・書き出しをします", C_DIM, FS_UI, 0, lay.x + lay.w, font, mut tc);
  uiRect(mut px, W, H, lay.x, lay.titleY + 76, lay.w, 1, C_GRID);
  // はじめる
  uiTextF(mut px, W, H, tx, lay.demoLabelY, "はじめる", C_DIM, FS_SMALL, 0, W, font, mut tc);
  if (st.hasDemo) {
    drawStartRow(mut px, W, H, st, lay, 0, font, mut tc);
  } else {
    const h = START_ROW_H - 4;
    // 探した場所（途中を省く）と、--home で場所を指定できること
    const tail = "。--home で場所を指定できます";
    const room = lay.w - 24 - uiTextWidthF(`デモが見つかりません（）${tail}`, FS_UI, font);
    let why = `デモが見つかりません（${uiFitMiddle(st.demoPath, room, FS_UI, font)}）${tail}`;
    if (st.home == "") {
      // 今いるフォルダが MozaicCut のフォルダでも build でもないので、どこを探せばよいか分からない
      why = "デモが見つかりません。--home <MozaicCut の build フォルダ> を付けて起動します";
    }
    uiTextF(mut px, W, H, tx + 16, textTop(lay.demoY, h, FS_UI, font), uiFitEnd(why, lay.w - 24, FS_UI, font), C_DIM, FS_UI, 0, lay.x + lay.w, font, mut tc);
  }
  // 最近開いたプロジェクト
  uiTextF(mut px, W, H, tx, lay.recentLabelY, "最近開いたプロジェクト", C_DIM, FS_SMALL, 0, W, font, mut tc);
  if (recentCount(st) == 0) {
    const h = START_ROW_H - 4;
    uiRect(mut px, W, H, lay.x, lay.recentY, lay.w, h, C_PANEL);
    let empty = "まだありません。開いたプロジェクトがここに並びます";
    if (st.home == "") {
      empty = "実行ファイルの場所が分からないので、最近の一覧は使いません（--home で指定できます）";
    }
    uiTextF(mut px, W, H, tx + 16, textTop(lay.recentY, h, FS_UI, font), uiFitEnd(empty, lay.w - 24, FS_UI, font), C_DIM, FS_UI, 0, lay.x + lay.w, font, mut tc);
  }
  let first = 0;
  if (st.hasDemo) {
    first = 1;
  }
  for (let i = first; i < (st.items.length as i32); i++) {
    drawStartRow(mut px, W, H, st, lay, i, font, mut tc);
  }
  // 使い方
  uiTextF(mut px, W, H, tx, lay.guideY, "使い方", C_DIM, FS_SMALL, 0, W, font, mut tc);
  const gy = lay.guideY + 26;
  uiRect(mut px, W, H, lay.x, gy, lay.w, 88, C_PANEL);
  const glh = 26;
  const gl: string[] = [
    "・端末から開く: MozaicCut のフォルダで node tools/mozcut.mjs edit <project.mzc>（素材を展開してから開きます）",
    "・ここから開いたときは素材を展開しません。展開済みのキャッシュ（<名前>.cache）を使います",
  ];
  for (let k: usize = 0; k < gl.length; k++) {
    uiTextF(mut px, W, H, tx + 16, gy + 8 + (k as i32) * glh + (glh - uiTextHeightF(FS_UI, font)) / 2 - 2, gl[k], C_TEXT, FS_UI, lay.x, lay.x + lay.w - 8, font, mut tc);
  }
  // 下の帯: キーの案内と、開けなかったときの説明
  uiRect(mut px, W, H, 0, lay.barY, W, START_BAR_H, C_BAR);
  uiRect(mut px, W, H, 0, lay.barY, W, 1, C_GRID);
  const by = textTop(lay.barY, START_BAR_H, FS_UI, font);
  // Del の案内は、最近の一覧の項目を選んでいるときだけ
  let help = "↑↓ 選ぶ   Enter 開く   Esc 終わる";
  if (st.sel >= 0 && (st.sel as usize) < st.items.length && !st.items[st.sel as usize].demo) {
    help = "↑↓ 選ぶ   Enter 開く   Del 一覧から外す   Esc 終わる";
  }
  const hw = uiTextWidthF(help, FS_UI, font);
  let statusEnd = W - 10;
  if (W - hw - 10 > 240) {
    uiTextF(mut px, W, H, W - hw - 10, by, help, C_DIM, FS_UI, 0, W, font, mut tc);
    statusEnd = W - hw - 26;
  }
  if (st.status != "") {
    let col = C_OK;
    if (st.statusErr) {
      col = C_ERR;
    }
    uiTextF(mut px, W, H, 10, by, st.status, col, FS_UI, 0, statusEnd, font, mut tc);
  }
}

// 選んだ項目を開けるか確かめる。開けるならそのパス、開けなければ "" を返して理由を帯に出す。
function startPick(st: mut Start, i: i32): string {
  if (i < 0 || i >= (st.items.length as i32)) {
    return "";
  }
  const it = i as usize;
  const p = st.items[it].path.clone();
  if (!fileExists(p)) {
    st.items[it].exists = false;
    st.status = `開けません: ${p} がありません（Del で一覧から外せます）`;
    st.statusErr = true;
    return "";
  }
  if (readText(p) == "") {
    st.status = `開けません: ${p} が空か、読めません`;
    st.statusErr = true;
    return "";
  }
  return p;
}

function startRemove(st: mut Start): void {
  if (st.sel < 0 || st.sel >= (st.items.length as i32)) {
    return;
  }
  const it = st.sel as usize;
  if (st.items[it].demo) {
    st.status = "デモは一覧から外せません";
    st.statusErr = false;
    return;
  }
  const p = st.items[it].path.clone();
  if (removeRecent(st.home, p)) {
    st.status = `一覧から外しました: ${p}（ファイルはそのままです）`;
    st.statusErr = false;
  } else {
    st.status = `${recentFile(st.home)} に書き込めません`;
    st.statusErr = true;
  }
  loadStartItems(mut st);
}

// 画面の共有の状態（ウィンドウ、大きさ、試し用のフレーム数と画面の書き出し先）。
struct Screen {
  win: i32;
  W: i32;
  H: i32;
  frames: i64;
  maxFrames: i64;
  shot: string;
  // 終わるときに再生の統計（pbStatsJson）を標準エラーに出す（試し用の --stats）
  stats: bool;
}

function screenDone(sc: Screen): bool {
  return sc.maxFrames >= 0 && sc.frames >= sc.maxFrames;
}

function saveShot(sc: Screen, px: Buffer<u32>): void {
  if (sc.shot != "") {
    if (!writeScreenBmp(sc.shot, px, sc.W, sc.H)) {
      eprint(`error: cannot write '${sc.shot}'`);
    }
  }
}

// スタート画面を回す。開くプロジェクトのパスを返す（終わるなら ""）。
// openAt >= 0 なら、そのフレーム数を描いたところで項目 st.sel を開く（試し用）。
function runStart(sc: mut Screen, st: mut Start, font: Font, tc: mut UiTextCache, openAt: i64): string {
  let px = new Buffer<u32>((sc.W * sc.H) as u32);
  while (true) {
    let W = sc.W;
    let H = sc.H;
    let lay = startLayout(st, W, H);
    let first = true;
    while (true) {
      let to: i32 = 0;
      if (first) {
        to = 30;
      }
      first = false;
      const e = pollWindowEvent(to);
      if (e == null) {
        break;
      }
      match (e) {
        WindowEvent.Close(w) => {
          saveShot(sc, px);
          return "";
        }
        WindowEvent.Quit => {
          saveShot(sc, px);
          return "";
        }
        WindowEvent.Resize(w, nw, nh) => {
          if (nw > 0 && nh > 0 && (nw != W || nh != H)) {
            W = nw;
            H = nh;
            sc.W = W;
            sc.H = H;
            px = new Buffer<u32>((W * H) as u32);
            lay = startLayout(st, W, H);
          }
        }
        WindowEvent.MouseMove(w, x, y) => {
          st.mouseX = x;
          st.mouseY = y;
          st.hover = startHit(st, lay, x, y);
        }
        WindowEvent.MouseDown(w, x, y, button) => {
          if (button == 1) {
            const hit = startHit(st, lay, x, y);
            if (hit >= 0) {
              st.sel = hit;
              const p = startPick(mut st, hit);
              if (p != "") {
                return p;
              }
            }
          }
        }
        WindowEvent.KeyDown(w, key, mods, repeat) => {
          const n = st.items.length as i32;
          match (key) {
            Key.Up => {
              if (n > 0) {
                st.sel = Math.max(st.sel - 1, 0);
              }
            }
            Key.Down => {
              if (n > 0) {
                st.sel = Math.min(st.sel + 1, n - 1);
              }
            }
            Key.Home => {
              if (n > 0) {
                st.sel = 0;
              }
            }
            Key.End => {
              if (n > 0) {
                st.sel = n - 1;
              }
            }
            Key.Enter => {
              const p = startPick(mut st, st.sel);
              if (p != "") {
                return p;
              }
            }
            Key.Delete => { startRemove(mut st); }
            Key.Backspace => { startRemove(mut st); }
            Key.Escape => {
              saveShot(sc, px);
              return "";
            }
            Key.Char(cp) => {
              if ((mods.ctrl || mods.meta) && (cp == 113 || cp == 119)) {
                saveShot(sc, px);
                return "";
              }
            }
            _ => {}
          }
        }
        _ => {}
      }
    }
    uiTextFrame(mut tc);
    drawStart(mut px, W, H, st, font, mut tc);
    windowPresent(sc.win, px, W, H);
    sc.frames++;
    if (openAt >= 0 && sc.frames == openAt) {
      const p = startPick(mut st, st.sel);
      if (p != "") {
        return p;
      }
    }
    if (screenDone(sc)) {
      saveShot(sc, px);
      return "";
    }
  }
  return "";
}

// ---- 編集画面のループ ----

// 展開した映像の素材の 1 コマ（YUV 4:2:0）の最大のバイト数。先読みの枠の大きさに使う。
function srcFrameBytes(ed: Editor): i64 {
  let m: i64 = 0;
  for (let i: usize = 0; i < ed.media.length && i < ed.project.clips.length; i++) {
    if (ed.project.clips[i].kind == KIND_VIDEO && ed.media[i].ok) {
      m = Math.max(m, (ed.media[i].w as i64) * (ed.media[i].h as i64) * 3 / 2);
    }
  }
  return m;
}

function runEditor(sc: mut Screen, ed: mut Editor, font: Font, tc: mut UiTextCache): void {
  let W = sc.W;
  let H = sc.H;
  let rc = newRenderCache();
  let px = new Buffer<u32>((W * H) as u32);
  let cw = ed.project.width;
  let ch = ed.project.height;
  let canvas = new Buffer<vec4<f32>>((cw * ch) as u32);
  // 先読みのコマの置き場（スレッドで共有）と、先読みのスレッドが持つ素材（spawn に own で渡し、join で返してもらう）
  let fc = newFrameCacheFor(ed.project, srcFrameBytes(ed));
  let wk = newPrefetchWorker(ed.cache);
  // 再生のエンジン（状態・速さ・時計・統計）。入力の処理は ed.pbq に頼みを積み、ここで pb に渡す
  let pb = newPlayback(ed.project, ed.cache, fc);
  ed.pbStale = false;
  let running = true;
  let shiftHeld = false;
  while (running) {
    let lay = computeLayout(ed, W, H);
    if (!ed.userZoomed && (ed.fitDur != ed.project.duration || ed.fitW != W)) {
      fitZoom(mut ed, lay);
      ed.fitDur = ed.project.duration;
      ed.fitW = W;
    }
    // 再生中とドラッグ中は待たずに回し、止まっているときは入力を待って CPU を休ませる
    let wait: i32 = 30;
    if (isPlaying(ed) || ed.drag != DRAG_NONE) {
      wait = 0;
    }
    let first = true;
    while (true) {
      let to: i32 = 0;
      if (first) {
        to = wait;
      }
      first = false;
      const e = pollWindowEvent(to);
      if (e == null) {
        break;
      }
      match (e) {
        WindowEvent.Close(w) => { running = false; }
        WindowEvent.Quit => { running = false; }
        WindowEvent.Resize(w, nw, nh) => {
          if (nw > 0 && nh > 0 && (nw != W || nh != H)) {
            W = nw;
            H = nh;
            sc.W = W;
            sc.H = H;
            px = new Buffer<u32>((W * H) as u32);
            lay = computeLayout(ed, W, H);
            ed.previewDirty = true;
          }
        }
        WindowEvent.MouseDown(w, x, y, button) => {
          if (button == 1) {
            mouseDown(mut ed, lay, x, y);
          }
        }
        WindowEvent.MouseUp(w, x, y, button) => {
          if (button == 1) {
            mouseUp(mut ed);
          }
        }
        WindowEvent.MouseMove(w, x, y) => { mouseMove(mut ed, x, y); }
        // Wheel は修飾キーを持たないので、Shift の状態は KeyDown / KeyUp の mods から覚えておく
        WindowEvent.Wheel(w, dx, dy) => { wheel(mut ed, lay, dx, dy, shiftHeld); }
        WindowEvent.KeyDown(w, key, mods, repeat) => {
          shiftHeld = mods.shift;
          if (!keyDown(mut ed, lay, key, mods)) {
            running = false;
          }
        }
        WindowEvent.KeyUp(w, key, mods) => { shiftHeld = mods.shift; }
        _ => {}
      }
    }
    poll(mut ed);
    lay = computeLayout(ed, W, H);
    if (ed.project.width != cw || ed.project.height != ch) {
      cw = ed.project.width;
      ch = ed.project.height;
      canvas = new Buffer<vec4<f32>>((cw * ch) as u32);
      ed.previewDirty = true;
    }
    if (ed.pbStale) {
      // 大きさが変わってコマが枠に入らなければ、置き場を作り直す（先読みのスレッドが動いていないここでだけ）
      if (!pbCacheFitsFor(fc, ed.project, srcFrameBytes(ed))) {
        fc = newFrameCacheFor(ed.project, srcFrameBytes(ed));
      }
      pbReload(mut pb, fc, ed.project, ed.cache);
      ed.pbStale = false;
      ed.previewDirty = true;
    }
    applyPbRequests(mut ed, mut pb);
    // 時計を進めて見せるコマを決め、これから見せるコマの先読みを頼む
    const changed = pbTick(mut pb, clock());
    ed.t = pb.t;
    ed.playing = pb.state == PB_PLAYING;
    ed.playText = pbStatusText(pb);
    if (isPlaying(ed)) {
      // 再生位置が見えなくなったら追いかける
      const xp = timeToX(ed, ed.t);
      if (xp > W - 40 || xp < HEAD_W) {
        ed.scroll = Math.max(ed.t - ((W - HEAD_W) as f64) * 0.1 / ed.zoom, 0.0);
      }
    }
    pbPlan(mut pb, fc, ed.project);
    // 先読みのスレッドは、描いて画面に出すあいだ（vsync を待つあいだも）走らせ、最後に合流する。
    // spawn から join までは wk が移っているので触らない。fc は借用で共有する（大きさを変えるのは上の pbStale のときだけ）。
    const h = thread.spawn(pbPrefetchRun, own wk, fc, clock() + pbWorkerBudget(pb));
    const drawn = changed || ed.previewDirty;
    if (drawn) {
      renderFrameFrom(ed.project, ed.media, ed.cache, pbFrameTime(pb), mut canvas, ed.pfont, mut rc, fc);
      ed.previewDirty = false;
    }
    uiTextFrame(mut tc);
    dispatch(blitPreview, (W * lay.pvH) as u32, mut px, canvas, W as u32, lay.pvH as u32,
      lay.imgX, lay.imgY, lay.imgW, lay.imgH, cw, ch, C_BG);
    const pending = pendingCount(ed);
    if (pending > 0) {
      uiTextF(mut px, W, H, lay.imgX + 12, lay.imgY + 12, `素材を展開しています（${pending} 個）…`, 0xffffff80, FS_UI, 0, W, font, mut tc);
    }
    drawInspector(mut px, ed, lay, font, mut tc);
    drawBar(mut px, ed, lay, font, mut tc);
    drawTimeline(mut px, ed, lay, font, mut tc);
    windowPresent(sc.win, px, W, H);
    if (drawn) {
      // 画面に出た時刻で、飛ばしたコマ・遅れ・自動の先回り（描いてから出るまでの時間）を測る
      pbShown(mut pb, clock());
    }
    wk = thread.join(h);
    sc.frames++;
    if (screenDone(sc)) {
      running = false;
    }
  }
  saveShot(sc, px);
  if (sc.stats) {
    eprint(`playback: ${pbStatsJson(pb, fc)}`);
  }
}

// ---- 起動 ----

// 起動の引数。
struct Launch {
  project: string;
  cache: string;
  home: string;
  managed: bool;
  ops: string[];
  select: string;
  seek: string;
  maxFrames: i64;
  shot: string;
  play: f64;
  stats: bool;
  startSel: i32;
  startOpen: i64;
  bad: string;
}

function parseLaunch(a: string[]): Launch {
  let L: Launch = {
    project: "", cache: "", home: "", managed: false, ops: [], select: "", seek: "", maxFrames: -1, shot: "",
    play: 0, stats: false, startSel: -1, startOpen: -1, bad: "",
  };
  let pos: string[] = [];
  let i: usize = 0;
  while (i < a.length) {
    const opt = a[i].clone();
    if (!textStartsWith(opt, "--")) {
      pos.push(opt);
      i++;
      continue;
    }
    if (opt == "--managed") {
      L.managed = true;
      i++;
      continue;
    }
    if (opt == "--stats") {
      L.stats = true;
      i++;
      continue;
    }
    if (i + 1 >= a.length) {
      L.bad = `${opt} には値が要ります`;
      return L;
    }
    const val = a[i + 1].clone();
    if (opt == "--op") {
      L.ops.push(val);
    } else if (opt == "--select") {
      L.select = val;
    } else if (opt == "--seek") {
      L.seek = val;
    } else if (opt == "--home") {
      L.home = val;
    } else if (opt == "--frames") {
      const n = parseNum(val);
      if (!isNan(n)) {
        L.maxFrames = n as i64;
      }
    } else if (opt == "--shot") {
      L.shot = val;
    } else if (opt == "--play") {
      const n = parseNum(val);
      if (!isNan(n)) {
        L.play = n;
      }
    } else if (opt == "--start-select") {
      const n = parseNum(val);
      if (!isNan(n)) {
        L.startSel = n as i32;
      }
    } else if (opt == "--start-open") {
      const n = parseNum(val);
      if (!isNan(n)) {
        L.startOpen = n as i64;
      }
    } else {
      eprint(`warning: unknown option '${opt}'`);
    }
    i += 2;
  }
  if (pos.length > 2) {
    L.bad = `引数が多すぎます（'${pos[2]}'）`;
    return L;
  }
  if (pos.length >= 1) {
    L.project = pos[0].clone();
  }
  if (pos.length >= 2) {
    L.cache = pos[1].clone();
    // キャッシュを指定する呼び方は mozcut.mjs edit のもの。展開は mozcut.mjs が受け持つ
    L.managed = true;
  } else if (L.project != "") {
    L.cache = cacheFor(L.project);
  }
  if (L.home == "") {
    L.home = guessHome();
  }
  return L;
}

export function main(): i32 {
  // 試しのための引数（ふだんは使わない）:
  //   --op "<操作>"        起動時に操作を 1 つ適用する（ファイルを書き換える。何度でも書ける）
  //   --select <ref>       クリップを選ぶ（ID / @行番号 / #番号）
  //   --seek <時刻>        再生位置
  //   --frames <n>         n フレーム描いたら終わる（スタート画面と編集画面の合計）
  //   --shot <x.bmp>       終わるときに最後の画面を BMP で書く
  //   --play <速さ>        開いたらすぐ再生する（-4〜4。負なら逆再生）
  //   --stats              終わるときに再生の統計（JSON）を標準エラーに出す
  //   --start-select <i>   スタート画面で i 番目（0 から）の項目を選んでおく
  //   --start-open <n>     スタート画面で n フレーム描いたら、選んでいる項目を開く
  const L = parseLaunch(args());
  if (L.bad != "") {
    eprint(`error: ${L.bad}`);
    eprint("usage: mozcut-edit [<project.mzc> [<cache>]] [--managed] [--home <dir>]   (normally started by: node tools/mozcut.mjs edit <project.mzc>)");
    return 2;
  }
  let path = L.project.clone();
  if (path != "" && readText(path) == "") {
    eprint(`error: cannot read '${path}'`);
    return 1;
  }
  const font = uiFont();
  let tc = uiTextCache();
  let title = "MozaicCut";
  if (path != "") {
    title = `MozaicCut - ${baseName(path)}`;
  }
  const opened = windowOpen(title, 1280, 800);
  if (opened == null) {
    eprint("error: could not open a window");
    return 1;
  }
  let sc: Screen = {
    win: opened, W: 1280, H: 800, frames: 0, maxFrames: L.maxFrames, shot: L.shot.clone(), stats: L.stats,
  };
  let cache = L.cache.clone();
  let managed = L.managed;
  if (path == "") {
    let st = newStart(L.home);
    if (L.startSel >= 0 && L.startSel < (st.items.length as i32)) {
      st.sel = L.startSel;
    }
    path = runStart(mut sc, mut st, font, mut tc, L.startOpen);
    if (path == "") {
      windowClose(sc.win);
      return 0;
    }
    cache = cacheFor(path);
    // スタート画面から開いたときは、素材を展開する仕組みがない
    managed = false;
  }
  addRecent(L.home, path);
  let ed = newEditor(path, cache, managed);
  for (const op of L.ops) {
    applyOp(mut ed, splitArgs(op));
    eprint(`op: ${ed.status} ${ed.statusHint}`);
  }
  if (L.select != "") {
    ed.sel = findClip(ed.project, L.select);
  }
  if (L.seek != "") {
    const t = parseTime(L.seek);
    if (!isNan(t)) {
      seek(mut ed, t);
    }
  }
  if (L.play != 0) {
    pbRequest(mut ed, PBQ_PLAY, L.play);
  }
  if (!screenDone(sc)) {
    runEditor(mut sc, mut ed, font, mut tc);
  }
  windowClose(sc.win);
  return 0;
}

// 画面（0xAARRGGBB）を 32 ビットの BMP（上から下）で書く。試し用。
function writeScreenBmp(path: string, px: Buffer<u32>, W: i32, H: i32): bool {
  let out: u8[] = [];
  const size = 54 + W * H * 4;
  const hdr: i32[] = [0x4d42, size, 0, 54, 40, W, -H, 1 + 32 * 65536, 0, W * H * 4, 2835, 2835, 0, 0];
  // "BM" は 2 バイト、あとは 4 バイト（planes と bpp は 2 バイトずつを 1 つにまとめた）
  out.push(66);
  out.push(77);
  for (let i: usize = 1; i < hdr.length; i++) {
    const v = hdr[i] as u32;
    out.push((v & 255) as u8);
    out.push(((v >> 8) & 255) as u8);
    out.push(((v >> 16) & 255) as u8);
    out.push(((v >> 24) & 255) as u8);
  }
  for (let i: u32 = 0; i < ((W * H) as u32); i++) {
    const p = px[i];
    out.push((p & 255) as u8);
    out.push(((p >> 8) & 255) as u8);
    out.push(((p >> 16) & 255) as u8);
    out.push(255);
  }
  return writeFile(path, out);
}

function copyLines(src: string[]): string[] {
  let out: string[] = [];
  for (const l of src) {
    out.push(l.clone());
  }
  return out;
}
