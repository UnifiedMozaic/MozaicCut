// アイコンとアイコンのボタンに使う値（IcnSkin）と、tokens.json（docs/design/tokens.json）を UkTheme に写す仮の読み替え。
//
// uikit の ukThemeFromTokens は「キーの道筋の最後の 2 つ」で読むので、tokens.json の入れ子の形
// （color.dark.semantic.warn・color.dark.text.2・color.dark.bg.3 など）は読めない（ok/warn/error・text.N・bg.N の対応がない）。
// uikit が読めるようになるまで、ここで道筋をそのまま引いて写す。uikit が直ったら icnThemeFromTokens は消してよい。
//
//   let theme = ukThemeDefault(scale);
//   let skin = icnSkinDefault();
//   const n = icnThemeFromTokens(mut theme, mut skin, json);   // 写した値の数（読めない JSON なら -1）
import { UkTheme, ukThemeSet, ukThemeScale, ukParseHex } from "./uikit/theme.um";

// アイコンまわりの値（論理の px。倍率は描くときに掛ける）。
export struct IcnSkin {
  // フォーカスの輪の外側の色（semantic.focusOuter、黒）。内側は theme.focus（accent）
  focusOuter: u32;
  // ツールチップの枠（line.strong）
  tipBorder: u32;
  // ツールバーのオンの下の 2px の線（text.2）
  onLine: u32;
  // アイコンの大きさ。sm / md は tokens.json の size.icon。tag / xs / empty は tokens.json に無く、
  // モックアップの CSS（.clip .tag .ic 10px、.ic.sm・.clip .nm .ic・.kfnav .ic 12px、空の状態 28px）から
  iconTag: i32;
  iconXs: i32;
  iconSm: i32;
  iconMd: i32;
  iconEmpty: i32;
  // アイコンのボタン（size.iconButton.sm / md）と、押せる範囲の最小（size.hitTargetMin）
  btnSm: i32;
  btnMd: i32;
  hitMin: i32;
  // フォーカスの輪: 内（accent）の太さ border.focus、離す幅 border.focusOffset、外（黒）の幅（モックアップの .ring の 4px）
  focusW: i32;
  focusOff: i32;
  focusOuterW: i32;
  // ツールチップの角の丸み（radius.md）と余白（モックアップの .tooltip の 6px 8px）
  tipRadius: i32;
  tipPadX: i32;
  tipPadY: i32;
}

// tokens.json が無いときの値（tokens.json の今の値と同じ）。
export function icnSkinDefault(): IcnSkin {
  return {
    focusOuter: 0xff000000, tipBorder: 0xff3c3c3c, onLine: 0xffa3a3a3,
    iconTag: 10, iconXs: 12, iconSm: 16, iconMd: 20, iconEmpty: 28,
    btnSm: 24, btnMd: 28, hitMin: 24, focusW: 2, focusOff: 1, focusOuterW: 4,
    tipRadius: 5, tipPadX: 8, tipPadY: 6,
  };
}

// ---- 小さな JSON の読み取り（葉の値を「道筋 → 文字列」にする）----

struct IcnJson {
  pos: usize;
  ok: bool;
  keys: string[];
  vals: string[];
}

function icnJsWs(s: string, st: mut IcnJson): void {
  while (st.pos < s.length) {
    const c = s[st.pos];
    if (c == 32 || c == 9 || c == 10 || c == 13) {
      st.pos += 1;
    } else {
      return;
    }
  }
}

function icnJsStr(s: string, st: mut IcnJson): string {
  // s[st.pos] は '"'
  st.pos += 1;
  let b: u8[] = [];
  while (st.pos < s.length) {
    const c = s[st.pos];
    if (c == 34) {
      st.pos += 1;
      return stringFromBytes(b);
    }
    if (c == 92 && st.pos + 1 < s.length) {
      // エスケープ（値に使うのは色と数だけなので、\" \\ \/ だけ戻し、ほかはそのまま写す）
      const n = s[st.pos + 1];
      if (n == 34 || n == 92 || n == 47) {
        b.push(n);
      } else {
        b.push(c);
        b.push(n);
      }
      st.pos += 2;
      continue;
    }
    b.push(c);
    st.pos += 1;
  }
  st.ok = false;
  return stringFromBytes(b);
}

function icnJsJoin(path: string, k: string): string {
  if (path.length == 0) {
    return k.clone();
  }
  return `${path}.${k}`;
}

function icnJsVal(s: string, st: mut IcnJson, path: string, depth: i32): void {
  icnJsWs(s, mut st);
  if (st.pos >= s.length || depth > 32) {
    st.ok = false;
    return;
  }
  const c = s[st.pos];
  if (c == 123) {
    st.pos += 1;
    while (st.ok) {
      icnJsWs(s, mut st);
      if (st.pos >= s.length) {
        st.ok = false;
        return;
      }
      if (s[st.pos] == 125) {
        st.pos += 1;
        return;
      }
      if (s[st.pos] == 44) {
        st.pos += 1;
        continue;
      }
      if (s[st.pos] != 34) {
        st.ok = false;
        return;
      }
      const k = icnJsStr(s, mut st);
      icnJsWs(s, mut st);
      if (st.pos >= s.length || s[st.pos] != 58) {
        st.ok = false;
        return;
      }
      st.pos += 1;
      icnJsVal(s, mut st, icnJsJoin(path, k), depth + 1);
    }
    return;
  }
  if (c == 91) {
    st.pos += 1;
    let idx: i32 = 0;
    while (st.ok) {
      icnJsWs(s, mut st);
      if (st.pos >= s.length) {
        st.ok = false;
        return;
      }
      if (s[st.pos] == 93) {
        st.pos += 1;
        return;
      }
      if (s[st.pos] == 44) {
        st.pos += 1;
        continue;
      }
      icnJsVal(s, mut st, icnJsJoin(path, `${idx}`), depth + 1);
      idx += 1;
    }
    return;
  }
  if (c == 34) {
    const v = icnJsStr(s, mut st);
    st.keys.push(path.clone());
    st.vals.push(v);
    return;
  }
  // 数・true・false・null
  let b: u8[] = [];
  while (st.pos < s.length) {
    const d = s[st.pos];
    if (d == 44 || d == 125 || d == 93 || d == 32 || d == 9 || d == 10 || d == 13) {
      break;
    }
    b.push(d);
    st.pos += 1;
  }
  if (b.length == 0) {
    st.ok = false;
    return;
  }
  st.keys.push(path.clone());
  st.vals.push(stringFromBytes(b));
}

function icnJsGet(st: IcnJson, key: string): string {
  for (let i: usize = 0; i < st.keys.length; i++) {
    if (st.keys[i] == key) {
      return st.vals[i].clone();
    }
  }
  return "";
}

// 色の値（"#rrggbb" か "#rrggbbaa"）。無いか読めなければ -1。
function icnJsColor(st: IcnJson, key: string): i64 {
  const v = icnJsGet(st, key);
  if (v.length == 0) {
    return -1;
  }
  return ukParseHex(v);
}

// 整数の値。無ければ -1。
function icnJsInt(st: IcnJson, key: string): i32 {
  const v = icnJsGet(st, key);
  if (v.length == 0) {
    return -1;
  }
  let n: i32 = 0;
  for (let i: usize = 0; i < v.length; i++) {
    const c = v[i];
    if (c >= 48 && c <= 57) {
      n = n * 10 + ((c - 48) as i32);
    } else {
      return -1;
    }
  }
  return n;
}

// 色を 1 つ写す（読めたら 1）。
function icnTokColor(t: mut UkTheme, st: IcnJson, key: string, name: string): i32 {
  const c = icnJsColor(st, key);
  if (c < 0) {
    return 0;
  }
  if (ukThemeSet(mut t, name, c as u32, 0.0, true)) {
    return 1;
  }
  return 0;
}

// 大きさを 1 つ写す（倍率 1.0 の px。読めたら 1）。
function icnTokSize(t: mut UkTheme, st: IcnJson, key: string, name: string): i32 {
  const n = icnJsInt(st, key);
  if (n < 0) {
    return 0;
  }
  if (ukThemeSet(mut t, name, 0, n as f32, false)) {
    return 1;
  }
  return 0;
}

// tokens.json（暗いテーマ）を UkTheme と IcnSkin に写す。写した値の数を返す（読めない JSON なら -1）。
// 対応（tokens.json → UkTheme）:
//   bg.0 → bg、bg.1 → panel、bg.2 → panelAlt / inputBg、bg.3 → raised（ボタンの地・アイコンのボタンのホバー）、
//   bg.4 → raisedHover / raisedActive / track（ボタンのホバー・押下・オン）、line.default → border、line.strong → borderStrong、
//   text.1 → text、text.2 → textDim、text.disabled → textOff、accent.default → accent / focus、accent.hover → accentHover、
//   text.onAccent → onAccent、semantic.error → danger、semantic.ok → success、semantic.warn → warning、
//   accent.tintSolid → selection、bg.popover → tipBg、text.1 → tipText、
//   font.size.md / sm / lg → fontSize / fontSmall / fontLarge、radius.md / sm → radius / radiusSm、size.icon.sm → icon
export function icnThemeFromTokens(t: mut UkTheme, skin: mut IcnSkin, json: string): i32 {
  let st: IcnJson = { pos: 0, ok: true, keys: [], vals: [] };
  icnJsVal(json, mut st, "", 0);
  if (!st.ok) {
    return -1;
  }
  const P = "color.dark.";
  let n: i32 = 0;
  n += icnTokColor(mut t, st, `${P}bg.0`, "color.bg");
  n += icnTokColor(mut t, st, `${P}bg.1`, "color.panel");
  n += icnTokColor(mut t, st, `${P}bg.2`, "color.panelAlt");
  n += icnTokColor(mut t, st, `${P}bg.2`, "color.inputBg");
  n += icnTokColor(mut t, st, `${P}bg.3`, "color.raised");
  n += icnTokColor(mut t, st, `${P}bg.4`, "color.raisedHover");
  n += icnTokColor(mut t, st, `${P}bg.4`, "color.raisedActive");
  n += icnTokColor(mut t, st, `${P}bg.4`, "color.track");
  n += icnTokColor(mut t, st, `${P}line.default`, "color.border");
  n += icnTokColor(mut t, st, `${P}line.strong`, "color.borderStrong");
  n += icnTokColor(mut t, st, `${P}text.1`, "color.text");
  n += icnTokColor(mut t, st, `${P}text.2`, "color.textDim");
  n += icnTokColor(mut t, st, `${P}text.disabled`, "color.textOff");
  n += icnTokColor(mut t, st, `${P}accent.default`, "color.accent");
  n += icnTokColor(mut t, st, `${P}accent.default`, "color.focus");
  n += icnTokColor(mut t, st, `${P}accent.hover`, "color.accentHover");
  n += icnTokColor(mut t, st, `${P}text.onAccent`, "color.onAccent");
  n += icnTokColor(mut t, st, `${P}semantic.error`, "color.danger");
  n += icnTokColor(mut t, st, `${P}semantic.ok`, "color.success");
  n += icnTokColor(mut t, st, `${P}semantic.warn`, "color.warning");
  n += icnTokColor(mut t, st, `${P}accent.tintSolid`, "color.selection");
  n += icnTokColor(mut t, st, `${P}bg.popover`, "color.tipBg");
  n += icnTokColor(mut t, st, `${P}text.1`, "color.tipText");
  n += icnTokSize(mut t, st, "font.size.md.size", "size.font");
  n += icnTokSize(mut t, st, "font.size.sm.size", "size.fontSmall");
  n += icnTokSize(mut t, st, "font.size.lg.size", "size.fontLarge");
  n += icnTokSize(mut t, st, "radius.md", "size.radius");
  n += icnTokSize(mut t, st, "radius.sm", "size.radiusSm");
  n += icnTokSize(mut t, st, "size.icon.sm", "size.icon");
  ukThemeScale(mut t, t.scale);
  // IcnSkin
  const fo = icnJsColor(st, `${P}semantic.focusOuter`);
  if (fo >= 0) {
    skin.focusOuter = fo as u32;
    n += 1;
  }
  const ls = icnJsColor(st, `${P}line.strong`);
  if (ls >= 0) {
    skin.tipBorder = ls as u32;
    n += 1;
  }
  const t2 = icnJsColor(st, `${P}text.2`);
  if (t2 >= 0) {
    skin.onLine = t2 as u32;
    n += 1;
  }
  const ism = icnJsInt(st, "size.icon.sm");
  if (ism > 0) {
    skin.iconSm = ism;
    n += 1;
  }
  const imd = icnJsInt(st, "size.icon.md");
  if (imd > 0) {
    skin.iconMd = imd;
    n += 1;
  }
  const bsm = icnJsInt(st, "size.iconButton.sm");
  if (bsm > 0) {
    skin.btnSm = bsm;
    n += 1;
  }
  const bmd = icnJsInt(st, "size.iconButton.md");
  if (bmd > 0) {
    skin.btnMd = bmd;
    n += 1;
  }
  const hm = icnJsInt(st, "size.hitTargetMin");
  if (hm > 0) {
    skin.hitMin = hm;
    n += 1;
  }
  const fw = icnJsInt(st, "border.focus");
  if (fw > 0) {
    skin.focusW = fw;
    n += 1;
  }
  const fof = icnJsInt(st, "border.focusOffset");
  if (fof >= 0) {
    skin.focusOff = fof;
    n += 1;
  }
  const rm = icnJsInt(st, "radius.md");
  if (rm >= 0) {
    skin.tipRadius = rm;
    n += 1;
  }
  return n;
}
