// 自動生成されるプラグインの登録表（tools/gen-plugins.mjs が plugins/*.um から作る）。手で書き換えない。
// ./fx/*.um は plugins/*.um の写し（行番号も同じ）。コンパイルの誤りが写しを指したら、plugins/ の方を直す。
// 効果: bright, contrast, gray, sat
import { fx_bright } from "./fx/bright.um";
import { fx_contrast } from "./fx/contrast.um";
import { fx_gray } from "./fx/gray.um";
import { fx_sat } from "./fx/sat.um";

export const FX_PARAMS: i32 = 8;

// 効果と引数の番号。見つからなければ effect = -1, param = -1。
export struct FxKey {
  effect: i32;
  param: i32;
}

export function fxCount(): i32 {
  return 4;
}

export function fxName(e: i32): string {
  switch (e) {
    case 0: {
      return "bright";
    }
    case 1: {
      return "contrast";
    }
    case 2: {
      return "gray";
    }
    case 3: {
      return "sat";
    }
  }
  return "";
}

export function fxDoc(e: i32): string {
  switch (e) {
    case 0: {
      return "明るさを変える（rgb に同じ量を足す）";
    }
    case 1: {
      return "コントラストを変える（0.5 を中心に掛ける）";
    }
    case 2: {
      return "白黒にする（彩度を 1 - amount にする）";
    }
    case 3: {
      return "彩度を変える（BT.709 の輝度を中心に掛ける）";
    }
  }
  return "";
}

export function fxParamCount(e: i32): i32 {
  switch (e) {
    case 0: {
      return 1;
    }
    case 1: {
      return 1;
    }
    case 2: {
      return 1;
    }
    case 3: {
      return 1;
    }
  }
  return 0;
}

export function fxParamName(e: i32, k: i32): string {
  switch (e) {
    case 0: {
      if (k == 0) {
        return "amount";
      }
      return "";
    }
    case 1: {
      if (k == 0) {
        return "amount";
      }
      return "";
    }
    case 2: {
      if (k == 0) {
        return "amount";
      }
      return "";
    }
    case 3: {
      if (k == 0) {
        return "amount";
      }
      return "";
    }
  }
  return "";
}

export function fxParamDoc(e: i32, k: i32): string {
  switch (e) {
    case 0: {
      if (k == 0) {
        return "足す量（-1 で黒、1 で白に近づく）";
      }
      return "";
    }
    case 1: {
      if (k == 0) {
        return "倍率（1 でそのまま、0 で一面の灰色）";
      }
      return "";
    }
    case 2: {
      if (k == 0) {
        return "強さ（1 で完全な白黒、0 でそのまま）";
      }
      return "";
    }
    case 3: {
      if (k == 0) {
        return "倍率（1 でそのまま、0 で白黒）";
      }
      return "";
    }
  }
  return "";
}

export function fxParamDefault(e: i32, k: i32): f32 {
  switch (e) {
    case 0: {
      if (k == 0) {
        return 0;
      }
      return 0;
    }
    case 1: {
      if (k == 0) {
        return 1;
      }
      return 0;
    }
    case 2: {
      if (k == 0) {
        return 1;
      }
      return 0;
    }
    case 3: {
      if (k == 0) {
        return 1;
      }
      return 0;
    }
  }
  return 0;
}

export function fxParamMin(e: i32, k: i32): f32 {
  switch (e) {
    case 0: {
      if (k == 0) {
        return -1;
      }
      return 0;
    }
    case 1: {
      if (k == 0) {
        return 0;
      }
      return 0;
    }
    case 2: {
      if (k == 0) {
        return 0;
      }
      return 0;
    }
    case 3: {
      if (k == 0) {
        return 0;
      }
      return 0;
    }
  }
  return 0;
}

export function fxParamMax(e: i32, k: i32): f32 {
  switch (e) {
    case 0: {
      if (k == 0) {
        return 1;
      }
      return 0;
    }
    case 1: {
      if (k == 0) {
        return 4;
      }
      return 0;
    }
    case 2: {
      if (k == 0) {
        return 1;
      }
      return 0;
    }
    case 3: {
      if (k == 0) {
        return 4;
      }
      return 0;
    }
  }
  return 0;
}

// 効果 e の別名（@alias）の数と、i 番目の別名。別名は主の引数を決め、"<別名>.<引数>" とも書ける。
export function fxAliasCount(e: i32): i32 {
  switch (e) {
    case 0: {
      return 0;
    }
    case 1: {
      return 0;
    }
    case 2: {
      return 1;
    }
    case 3: {
      return 1;
    }
  }
  return 0;
}

export function fxAlias(e: i32, i: i32): string {
  switch (e) {
    case 0: {
      return "";
    }
    case 1: {
      return "";
    }
    case 2: {
      if (i == 0) {
        return "grey";
      }
      return "";
    }
    case 3: {
      if (i == 0) {
        return "saturation";
      }
      return "";
    }
  }
  return "";
}

// 効果 e が周りへ広がる画素数（@reach）。宣言がなければ 0。
export function fxReach(e: i32, params: f32[8]): i32 {
  switch (e) {
    case 0: {
      return 0;
    }
    case 1: {
      return 0;
    }
    case 2: {
      return 0;
    }
    case 3: {
      return 0;
    }
  }
  return 0;
}

// "blur" → (blur, 0)、"vignette.radius" → (vignette, 1)、別名（"saturation" → (sat, 0)）も。
// 見つからなければ effect = -1, param = -1。
export function fxFindKey(key: string): FxKey {
  switch (key) {
    case "bright":
      return { effect: 0, param: 0 };
    case "bright.amount":
      return { effect: 0, param: 0 };
    case "contrast":
      return { effect: 1, param: 0 };
    case "contrast.amount":
      return { effect: 1, param: 0 };
    case "gray":
      return { effect: 2, param: 0 };
    case "gray.amount":
      return { effect: 2, param: 0 };
    case "grey":
      return { effect: 2, param: 0 };
    case "grey.amount":
      return { effect: 2, param: 0 };
    case "sat":
      return { effect: 3, param: 0 };
    case "sat.amount":
      return { effect: 3, param: 0 };
    case "saturation":
      return { effect: 3, param: 0 };
    case "saturation.amount":
      return { effect: 3, param: 0 };
  }
  return { effect: -1, param: -1 };
}

// 効果 e を層に掛ける。結果は layer に残す。tmp は同じ大きさの作業用。知らない e では何もしない。
export function fxApply(e: i32, layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, params: f32[8]): void {
  switch (e) {
    case 0:
      fx_bright(mut layer, mut tmp, w, h, params);
      break;
    case 1:
      fx_contrast(mut layer, mut tmp, w, h, params);
      break;
    case 2:
      fx_gray(mut layer, mut tmp, w, h, params);
      break;
    case 3:
      fx_sat(mut layer, mut tmp, w, h, params);
      break;
  }
}
