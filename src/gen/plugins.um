    case 3: {
      if (k == 0) {
        return "強さ（1 で完全な白黒、0 でそのまま）";
      }
      return "";
    }
    case 4: {
      if (k == 0) {
        return "強さ（1 で 1 - 色、0.5 で一面の灰色、0 でそのまま）";
      }
      return "";
    }
    case 5: {
      if (k == 0) {
        return "ブロックの一辺（画素。小数は四捨五入。1 で何もしない）";
      }
