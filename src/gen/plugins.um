export function fxParamDoc(e: i32, k: i32): string {
  switch (e) {
    case 0: {
      if (k == 0) {
        return "半径（画素。小数は四捨五入。0 で何もしない）";
      }
      return "";
    }
    case 1: {
      if (k == 0) {
        return "足す量（-1 で黒、1 で白に近づく）";
      }
      return "";
    }
    case 2: {
      if (k == 0) {
        return "許容（キーの色からの色の差がこれ以下なら透明。差はキーの色の鮮やかさを 1 とする。暗い背景も抜くなら上げる）";
      }
      if (k == 1) {
        return "柔らかさ（許容からこの幅で透明から不透明へ直線で変わる。0 なら 0 か 1 で、縁の推定もしない）";
      }
      if (k == 2) {
        return "色のこぼれの除去（0 で取らない。1 でキーの色の成分をほかの 2 つの大きいほうまで、2 で 2 つの平均まで下げる）";
      }
      if (k == 3) {
        return "エッジの収縮（画素。正で透明でない所を縮め、負で広げる。小数は四捨五入）";
      }
      if (k == 4) {
        return "エッジのぼかし（キーの境目をぼかす。広がりはおよそ 2×feather 画素。小数は四捨五入）";
      }
      if (k == 5) {
        return "キーの色の赤（0〜1。既定はクロマキー用の緑の布の色 0.1 0.7 0.3。青の布は 0.1 0.2 0.9）";
      }
      if (k == 6) {
        return "キーの色の緑";
      }
      if (k == 7) {
        return "キーの色の青";
      }
      return "";
    }
    case 3: {
      if (k == 0) {
        return "ずらす量（画素。0 で何もしない）";
      }
      if (k == 1) {
        return "ずらす方向の角度（度。0 で横、90 で縦）";
      }
      return "";
    }
    case 4: {
      if (k == 0) {
        return "倍率（1 でそのまま、0 で一面の灰色）";
      }
      return "";
    }
    case 5: {
      if (k == 0) {
        return "混ぜる強さ（0 で元の色、1 で完全に 2 色）";
      }
      if (k == 1) {
        return "暗い所の赤";
      }
      if (k == 2) {
        return "暗い所の緑";
      }
      if (k == 3) {
        return "暗い所の青";
      }
      if (k == 4) {
        return "明るい所の赤";
      }
      if (k == 5) {
        return "明るい所の緑";
      }
      if (k == 6) {
        return "明るい所の青";
      }
      return "";
    }
    case 6: {
      if (k == 0) {
        return "輪郭の強さ（0 で元の絵のまま）";
      }
      if (k == 1) {
        return "元の絵との混ぜ具合（1 で黒地に輪郭だけ、0 で元の絵に輪郭を加算）";
      }
      return "";
    }
    case 7: {
      if (k == 0) {
        return "凹凸の深さ（0 で何もしない）";
      }
      if (k == 1) {
        return "灰色の浮き彫りにする割合（0 で元の色に陰影を足し、1 で石膏のような灰色の浮き彫り）";
      }
      return "";
    }
    case 8: {
      if (k == 0) {
        return "ずれの強さ（画素。0 で何もしない）";
      }
      if (k == 1) {
        return "乱数の種（キーフレームで動かすとフレームごとにグリッチが暴れる）";
      }
      return "";
    }
    case 9: {
      if (k == 0) {
        return "発光の強さ（0 で何もしない）";
      }
      if (k == 1) {
        return "光の広がりの半径（画素。小数は四捨五入）";
      }
      if (k == 2) {
        return "発光が始まる明るさの境目";
      }
      return "";
    }
    case 10: {
      if (k == 0) {
        return "粒子の強さ（0 で何もしない）";
      }
      if (k == 1) {
        return "乱数の種（変えると粒子の配置が変わる）";
      }
      return "";
    }
    case 11: {
      if (k == 0) {
        return "強さ（1 で完全な白黒、0 でそのまま）";
      }
      return "";
    }
    case 12: {
      if (k == 0) {
        return "網点の間隔（画素）";
      }
      if (k == 1) {
        return "網点のはっきりさ（0 で元の絵、1 で白黒の網点）";
      }
      return "";
    }
    case 13: {
      if (k == 0) {
        return "色相の角度（度。0 で何もしない、180 で反対の色）";
      }
      return "";
    }
    case 14: {
      if (k == 0) {
        return "強さ（1 で 1 - 色、0.5 で一面の灰色、0 でそのまま）";
      }
      return "";
    }
    case 15: {
      if (k == 0) {
        return "しきい値（明るさ 0〜1。これより暗い所を透明にする。invert なら明るい所。0 なら何も抜かない）";
      }
      if (k == 1) {
        return "柔らかさ（しきい値から明るい側へこの幅で、透明から不透明へなめらかに変わる。invert なら暗い側へ。0 なら境目がくっきり）";
      }
      if (k == 2) {
        return "向き（0 か 1。1 で、しきい値より明るい所を透明にする。0.5 以上は 1 とみなす）";
      }
      if (k == 3) {
        return "エッジの収縮（画素。正で透明でない所を縮め、負で広げる。小数は四捨五入）";
      }
      if (k == 4) {
        return "エッジのぼかし（キーの境目をぼかす。広がりはおよそ 2×feather 画素。小数は四捨五入）";
      }
      return "";
    }
    case 16: {
      if (k == 0) {
        return "見せ方（1: アルファを白黒で。白が不透明、黒が透明。2: 市松模様の上に重ねる。0: 何もしない。小数は四捨五入）";
      }
      if (k == 1) {
        return "市松模様のます目の一辺（画素。mode 2 のとき）";
      }
      return "";
    }
    case 17: {
      if (k == 0) {
        return "折り返し方（1: 左を右へ、2: 右を左へ、3: 上を下へ、4: 下を上へ）";
      }
      return "";
    }
    case 18: {
      if (k == 0) {
        return "ぶれの半径（画素。小数は四捨五入。0 で何もしない）";
      }
      if (k == 1) {
        return "ぶれの方向の角度（度。0 で横、90 で縦）";
      }
      return "";
    }
    case 19: {
      if (k == 0) {
        return "ブロックの一辺（画素。小数は四捨五入。1 で何もしない）";
      }
      return "";
    }
    case 20: {
      if (k == 0) {
        return "階調の段数（小さいほど段階がはっきりする。小数は四捨五入）";
      }
      return "";
    }
    case 21: {
      if (k == 0) {
        return "倍率（1 でそのまま、0 で白黒）";
      }
      return "";
    }
    case 22: {
      if (k == 0) {
        return "縞の暗さ（0 で何もしない、1 で暗い線が黒くなる）";
      }
      if (k == 1) {
        return "縞の周期（画素。小数は四捨五入）";
      }
      return "";
    }
    case 23: {
      if (k == 0) {
        return "強さ（1 で完全なセピア、0 でそのまま）";
      }
      return "";
    }
    case 24: {
      if (k == 0) {
        return "強さ（元の色とぼかした色の差を、この倍だけ足す）";
      }
      if (k == 1) {
        return "ぼかしの半径（画素。小数は四捨五入。大きいほど太い輪郭が強まる）";
      }
      return "";
    }
    case 25: {
      if (k == 0) {
        return "強さ（0 で何もしない、1 で完全に折り返す）";
      }
      if (k == 1) {
        return "反転が始まる明るさの境目";
      }
      return "";
    }
    case 26: {
      if (k == 0) {
        return "白と黒に分ける明るさの境目";
      }
      if (k == 1) {
        return "境目の柔らかさ（0 でくっきり 2 値）";
      }
      return "";
    }
    case 27: {
      if (k == 0) {
        return "色を乗せる強さ（0 で何もしない）";
      }
      if (k == 1) {
        return "乗せる色の赤";
      }
      if (k == 2) {
        return "乗せる色の緑";
      }
      if (k == 3) {
        return "乗せる色の青";
      }
      return "";
    }
    case 28: {
      if (k == 0) {
        return "暗くする強さ（1 で、半径 + 幅より外が黒くなる。既定の半径と幅では四隅が黒くなる）";
      }
      if (k == 1) {
        return "暗くし始める半径（掛ける層の対角の半分を 1 とする）";
      }
      if (k == 2) {
        return "暗くなっていく幅（半径からこの幅で強さいっぱいまで暗くなる）";
      }
      return "";
    }
    case 29: {
      if (k == 0) {
        return "揺れの幅（画素。0 で何もしない）";
      }
      if (k == 1) {
        return "波の周期（画素）";
      }
      if (k == 2) {
        return "波の位相（度。キーフレームで動かすと波が流れる）";
      }
      return "";
    }
  }
  return "";
}

