import { fx_sharpen } from "./fx/sharpen.um";
import { fx_vignette } from "./fx/vignette.um";
import { WasmFxSet, WasmFxParam, wasmFxEmpty, wasmFxLoad, wasmFxApply, wasmFxReach } from "../wasmfx.um";

export const FX_PARAMS: i32 = 8;

// 効果と引数の番号。見つからなければ effect = -1, param = -1。
export struct FxKey {
  effect: i32;
  param: i32;
}

export function fxCount(): i32 {
  return 10;
}

export function fxName(e: i32): string {
  switch (e) {
    case 0: {
      return "blur";
    }
    case 1: {
      return "bright";
    }
    case 2: {
      return "contrast";
    }
    case 3: {
      return "gray";
    }
    case 4: {
      return "invert";
    }
    case 5: {
      return "pixelate";
    }
    case 6: {
      return "sat";
    }
    case 7: {
      return "sepia";
    }
    case 8: {
      return "sharpen";
    }
    case 9: {
      return "vignette";
    }
  }
  return "";
}

