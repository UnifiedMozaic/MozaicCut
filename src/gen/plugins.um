export function fxDoc(e: i32): string {
  switch (e) {
    case 0: {
      return "ぼかす（箱ぼかしを 2 回。ガウスぼかしに近い）";
    }
    case 1: {
      return "明るさを変える（rgb に同じ量を足す）";
    }
    case 2: {
      return "クロマキー（緑や青の背景の色を透明にし、縁の色を戻し、色のこぼれを取る）";
    }
    case 3: {
      return "色収差（赤と青を反対方向にずらしてレンズのにじみを出す）";
    }
    case 4: {
      return "コントラストを変える（0.5 を中心に掛ける）";
    }
    case 5: {
      return "デュオトーン（暗い所と明るい所を 2 つの色で塗り分ける）";
    }
    case 6: {
      return "輪郭を抽出する（ソーベルフィルタでエッジを光らせる）";
    }
    case 7: {
      return "浮き彫りにする（斜めの光で凹凸を付ける）";
    }
    case 8: {
      return "デジタルグリッチ（横帯のずれと色ずれを起こす）";
    }
    case 9: {
      return "明るい部分をふんわり発光させる（ブルーム）";
    }
    case 10: {
      return "フィルムの粒子ノイズを加える";
    }
    case 11: {
      return "白黒にする（彩度を 1 - amount にする）";
    }
    case 12: {
      return "網点（ハーフトーン・漫画のスクリーントーン風）にする";
    }
    case 13: {
      return "色相を回す（RGB を YCbCr の色平面で回転する）";
    }
    case 14: {
      return "色を反転する";
    }
    case 15: {
      return "ルミナンスキー（暗い所か明るい所を透明にする）";
    }
    case 16: {
      return "アルファ（キーやマスクの結果）を見る（確かめる用）";
    }
    case 17: {
      return "画面を左右または上下で鏡のように折り返す";
    }
    case 18: {
      return "指定した角度の方向にぶらす（方向ブラー）";
    }
    case 19: {
      return "モザイクにする（各ブロックを平均の色で塗る）";
    }
    case 20: {
      return "階調を減らす（イラスト・アニメ風の段階的な色にする）";
    }
    case 21: {
      return "彩度を変える（BT.709 の輝度を中心に掛ける）";
    }
    case 22: {
      return "走査線を入れる（ブラウン管・レトロモニター風の横縞）";
    }
    case 23: {
      return "セピア調にする";
    }
    case 24: {
      return "くっきりさせる（アンシャープマスク）";
    }
    case 25: {
      return "ソラリゼーション（明るい部分を反転して幻想的な階調にする）";
    }
    case 26: {
      return "2 値化する（明るさの境目で白と黒に分ける）";
    }
    case 27: {
      return "特定の色を乗せる（カラーフィルター）";
    }
    case 28: {
      return "周辺を暗くする";
    }
    case 29: {
      return "波のように揺らす（水面・陽炎のような歪み）";
    }
  }
  return "";
}

