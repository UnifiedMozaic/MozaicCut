// 自動生成されるプラグインの登録表（tools/gen-plugins.mjs が plugins/*.um から作る）。手で書き換えない。
// ./fx/*.um は plugins/*.um の写し（行番号も同じ）。コンパイルの誤りが写しを指したら、plugins/ の方を直す。
// 効果: なし
import { WasmFxSet, WasmFxParam, wasmFxEmpty, wasmFxLoad, wasmFxDiscover, wasmFxApplyTmp, wasmFxReach, wasmFxSetTimeout, wasmTransSetTimeout, WASMFX_PREVIEW_TIMEOUT_MS } from "../effects/wasmfx.um";

export const FX_PARAMS: i32 = 8;

// 効果と引数の番号。見つからなければ effect = -1, param = -1。
export struct FxKey {
  effect: i32;
  param: i32;
}

export function fxCount(): i32 {
  return 0;
}

export function fxName(e: i32): string {
  return "";
}

export function fxDoc(e: i32): string {
  return "";
}

export function fxParamCount(e: i32): i32 {
  return 0;
}

export function fxParamName(e: i32, k: i32): string {
  return "";
}

export function fxParamDoc(e: i32, k: i32): string {
  return "";
}

export function fxParamDefault(e: i32, k: i32): f32 {
  return 0;
}

export function fxParamMin(e: i32, k: i32): f32 {
  return 0;
}

export function fxParamMax(e: i32, k: i32): f32 {
  return 0;
}

// 効果 e の別名（@alias）の数と、i 番目の別名。別名は主の引数を決め、"<別名>.<引数>" とも書ける。
export function fxAliasCount(e: i32): i32 {
  return 0;
}

export function fxAlias(e: i32, i: i32): string {
  return "";
}

// 効果 e が周りへ広がる画素数（@reach）。宣言がなければ 0。
export function fxReach(e: i32, params: f32[8]): i32 {
  return 0;
}

// "blur" → (blur, 0)、"vignette.radius" → (vignette, 1)、別名（"saturation" → (sat, 0)）も。
// 見つからなければ effect = -1, param = -1。
export function fxFindKey(key: string): FxKey {
  return { effect: -1, param: -1 };
}

// 効果 e を層に掛ける。結果は layer に残す。tmp は同じ大きさの作業用。知らない e では何もしない。
export function fxApply(e: i32, layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, params: f32[8]): void {
}

// ---- 登録表（組み込みの効果と .mzplug の効果） ----

// 組み込みの効果の数。番号がこれ以上の効果は .mzplug（wasm）。
export const FX_BUILTIN_COUNT: i32 = 0;

// .mzplug の効果の名前・別名に使えない名前（組み込みの効果の名前と別名、コアのキー）。
export function fxReservedNames(): string[] {
  return ["afadein", "afadeout", "align", "anchor", "at", "bars", "beat.offset", "bg", "blend", "blend.space", "blend.tf", "bpm", "burst", "camera.aa", "camera.aperture", "camera.focus", "camera.fov", "camera.roll", "camera.samples", "camera.tx", "camera.ty", "camera.tz", "camera.x", "camera.y", "camera.z", "camera.zoom", "cap", "color", "color.end", "color2", "crf", "d", "dash", "dashoffset", "dir", "dir.mode", "drag", "draw", "drawoff", "drawon", "dur", "duration", "emit", "emit.dur", "emit.edge", "emit.h", "emit.w", "enabled", "fade", "fadein", "fadeout", "fill", "fillfrom", "fillrule", "fillto", "fit", "font", "fontindex", "fps", "full", "gain", "grad.angle", "gravity", "h", "height", "id", "in", "inner", "italic", "join", "layer", "life", "life.var", "light.ambient", "light.intensity", "light.type", "light.x", "light.y", "light.z", "link", "matte", "matte.invert", "matte.type", "max", "mblur", "mblur.angle", "mblur.phase", "mblur.samples", "miter", "mute", "opacity", "opacity.end", "opacity.in", "opacity.out", "out", "outline", "outlinew", "output", "ox", "oy", "pad", "parent", "points", "pos", "preset", "prewarm", "r", "radius", "rate", "repeat", "repeatopend", "repeatopstart", "repeatorder", "repeatrot", "repeatscale", "repeatx", "repeaty", "rot.var", "rotation", "rx", "ry", "scale", "seed", "shadow", "shadow.blur", "shadow.x", "shadow.y", "shape", "sides", "size", "size.end", "size.var", "skew", "speed", "speed.var", "spin", "spin.var", "spread", "sprite", "src", "steps", "stroke", "strokefrom", "stroketo", "strokew", "text", "timeremap", "track", "tracking", "trans", "trans.angle", "trans.param", "trans.soft", "trimend", "trimmode", "trimoffset", "trimstart", "turb", "turb.scale", "turb.speed", "vertical", "vol", "volume", "w", "width", "wind", "x", "x2", "xfade", "y", "y2", "z"];
}

// 効果の登録表。fxRegBuiltin()（組み込みだけ）か fxRegLoad(paths)（.mzplug も読み込む）で 1 度だけ作り、呼ぶ側が渡す。
// 番号 e は 0 .. count()-1。組み込みの効果が先で、.mzplug の効果は読み込んだ順に後ろへ続く（番号は決め打ちせず findKey で引く）。
export class FxReg {
  wasm: WasmFxSet;
  bands: i32 = 0;   // .mzplug の効果を分ける帯の数（0 は自動、1 は分けない）

  constructor(wasm: own WasmFxSet) {
    this.wasm = wasm;
  }

  count(): i32 {
    return FX_BUILTIN_COUNT + (this.wasm.fx.length as i32);
  }

  // 効果 e が .mzplug（wasm）か。
  isWasm(e: i32): bool {
    return e >= FX_BUILTIN_COUNT && e < this.count();
  }

  // 効果 e の出どころ: 組み込みなら "builtin"、.mzplug ならそのファイルの場所。知らない e は ""。
  source(e: i32): string {
    if (e >= 0 && e < FX_BUILTIN_COUNT) {
      return "builtin";
    }
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].path.clone();
    }
    return "";
  }

  name(e: i32): string {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].name.clone();
    }
    return fxName(e);
  }

  doc(e: i32): string {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].doc.clone();
    }
    return fxDoc(e);
  }

  label(e: i32): string {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].label.clone();
    }
    return "";
  }

  category(e: i32): string {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].category.clone();
    }
    return "";
  }

  hasInit(e: i32): bool {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].hasInit;
    }
    return false;
  }

  initVal(e: i32): f32 {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].initVal;
    }
    return 0.0;
  }

  thumbMask(e: i32): u32 {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].thumbMask;
    }
    return 0;
  }

  thumbVal(e: i32, k: i32): f32 {
    if (this.isWasm(e) && k >= 0 && k < FX_PARAMS) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].thumbVals[k as usize];
    }
    return 0.0;
  }

  paramCount(e: i32): i32 {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].params.length as i32;
    }
    return fxParamCount(e);
  }

  paramName(e: i32, k: i32): string {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (k >= 0 && (k as usize) < this.wasm.fx[w].params.length) {
        return this.wasm.fx[w].params[k as usize].name.clone();
      }
      return "";
    }
    return fxParamName(e, k);
  }

  paramDoc(e: i32, k: i32): string {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (k >= 0 && (k as usize) < this.wasm.fx[w].params.length) {
        return this.wasm.fx[w].params[k as usize].doc.clone();
      }
      return "";
    }
    return fxParamDoc(e, k);
  }

  paramDefault(e: i32, k: i32): f32 {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (k >= 0 && (k as usize) < this.wasm.fx[w].params.length) {
        return this.wasm.fx[w].params[k as usize].def;
      }
      return 0;
    }
    return fxParamDefault(e, k);
  }

  paramMin(e: i32, k: i32): f32 {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (k >= 0 && (k as usize) < this.wasm.fx[w].params.length) {
        return this.wasm.fx[w].params[k as usize].min;
      }
      return 0;
    }
    return fxParamMin(e, k);
  }

  paramMax(e: i32, k: i32): f32 {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (k >= 0 && (k as usize) < this.wasm.fx[w].params.length) {
        return this.wasm.fx[w].params[k as usize].max;
      }
      return 0;
    }
    return fxParamMax(e, k);
  }

  aliasCount(e: i32): i32 {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].aliases.length as i32;
    }
    return fxAliasCount(e);
  }

  alias(e: i32, i: i32): string {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (i >= 0 && (i as usize) < this.wasm.fx[w].aliases.length) {
        return this.wasm.fx[w].aliases[i as usize].clone();
      }
      return "";
    }
    return fxAlias(e, i);
  }

  // 効果 e が周りへ広がる画素数（@reach）。
  reach(e: i32, params: f32[8]): i32 {
    if (this.isWasm(e)) {
      return wasmFxReach(this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize], params);
    }
    return fxReach(e, params);
  }

  // "blur" → (blur, 0)、"vignette.radius" → (vignette, 1)、別名も。.mzplug の効果も引く。見つからなければ (-1, -1)。
  findKey(key: string): FxKey {
    const b = fxFindKey(key);
    if (b.effect >= 0) {
      return b;
    }
    for (let w: usize = 0; w < this.wasm.fx.length; w++) {
      const e = FX_BUILTIN_COUNT + (w as i32);
      if (fxRegKeyHead(key, this.wasm.fx[w].name)) {
        return fxRegKeyParam(key, this.wasm.fx[w].name, this.wasm.fx[w].params, e);
      }
      for (const a of this.wasm.fx[w].aliases) {
        if (fxRegKeyHead(key, a)) {
          return fxRegKeyParam(key, a, this.wasm.fx[w].params, e);
        }
      }
    }
    return { effect: -1, param: -1 };
  }

  // 効果 e を層に掛ける。結果は layer に残す。tmp は同じ大きさの作業用（GPU 常駐バッファを使い回す）。
  // 成功（と知らない e）なら ""。.mzplug の効果が失敗したら（トラップ・時間切れなど）理由の文を返し、layer は変えない。
  apply(e: i32, layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, params: f32[8]): string {
    if (this.isWasm(e)) {
      let emptyOrig = new Buffer<vec4<f32>>(0);
      return wasmFxApplyTmp(this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize], mut layer, mut tmp, mut emptyOrig, w, h, params, this.bands);
    }
    fxApply(e, mut layer, mut tmp, w, h, params);
    return "";
  }

  // 多パス GPU 効果（glow / blur / sharpen 等）でも 33 MB の確保を避けるため orig も使い回す高速版。
  applyCached(e: i32, layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, orig: mut Buffer<vec4<f32>>, w: u32, h: u32, params: f32[8]): string {
    if (this.isWasm(e)) {
      return wasmFxApplyTmp(this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize], mut layer, mut tmp, mut orig, w, h, params, this.bands);
    }
    fxApply(e, mut layer, mut tmp, w, h, params);
    return "";
  }
}

// key が head そのものか、head + "." で始まるか。
function fxRegKeyHead(key: string, head: string): bool {
  if (key.length < head.length) {
    return false;
  }
  for (let i: usize = 0; i < head.length; i++) {
    if (key[i] != head[i]) {
      return false;
    }
  }
  return key.length == head.length || key[head.length] == 46;
}

// fxRegKeyHead(key, head) が真のとき: "head" → (e, 0)、"head.param" → (e, その番号)。引数がなければ (-1, -1)。
function fxRegKeyParam(key: string, head: string, params: WasmFxParam[], e: i32): FxKey {
  if (key.length == head.length) {
    return { effect: e, param: 0 };
  }
  for (let k: usize = 0; k < params.length; k++) {
    if (key.length == head.length + 1 + params[k].name.length) {
      let same = true;
      for (let i: usize = 0; i < params[k].name.length; i++) {
        if (key[head.length + 1 + i] != params[k].name[i]) {
          same = false;
        }
      }
      if (same) {
        return { effect: e, param: k as i32 };
      }
    }
  }
  return { effect: -1, param: -1 };
}

// 組み込みの効果だけの登録表。
export function fxRegBuiltin(): FxReg {
  let set = wasmFxEmpty();
  return new FxReg(own set);
}

// 組み込みの効果に、.mzplug の効果（paths の順）を足した登録表。読めない包み・名前のぶつかる包みは飛ばし、
// 理由を reg.wasm.diags（code "bad-plugin"）に入れる。止まらない。
export function fxRegLoad(paths: string[]): FxReg {
  let set = wasmFxEmpty();
  const reserved = fxReservedNames();
  for (const p of paths) {
    wasmFxLoad(mut set, p, reserved);
  }
  return new FxReg(own set);
}

// 既定のフォルダ（exe 隣の plugins/・macOS の Resources/plugins/・plugins-installed/・カレントの plugins/ と extra）から
// .mzplug を自動で探して読み込む。組み込みは 0 個で、すべての効果・トランジションを独立した .mzplug から読み込む。
export function fxRegDiscover(extra: string[]): FxReg {
  let sources: string[] = [];
  const ed = exeDir();
  if (ed.length > 0) {
    sources.push(`${ed}/plugins`);
    sources.push(`${ed}/../Resources/plugins`);
  }
  sources.push("plugins-installed");
  sources.push("plugins");
  for (const s of extra) {
    if (s.length > 0) {
      sources.push(s.clone());
    }
  }
  return fxRegLoad(wasmFxDiscover(sources));
}

// 編集画面のプレビュー用に、.mzplug の 1 回の実行時間の上限を短くする。
export function fxRegSetPreviewTimeout(reg: FxReg): void {
  for (const f of reg.wasm.fx) {
    wasmFxSetTimeout(f, WASMFX_PREVIEW_TIMEOUT_MS);
  }
  for (const tr of reg.wasm.trans) {
    wasmTransSetTimeout(tr, WASMFX_PREVIEW_TIMEOUT_MS);
  }
}
