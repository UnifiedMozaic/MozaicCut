  switch (e) {
    case 0: {
      return 0;
    }
    case 1: {
      return 0;
    }
    case 2: {
      return 0;
    }
    case 3: {
      return 1;
    }
    case 4: {
      return 0;
    }
    case 5: {
      return 1;
    }
    case 6: {
      return 1;
    }
    case 7: {
      return 0;
    }
    case 8: {
      return 0;
    }
  }
  return 0;
}

