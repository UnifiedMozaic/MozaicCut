import { fx_vignette } from "./fx/vignette.um";

export const FX_PARAMS: i32 = 8;

// 効果と引数の番号。見つからなければ effect = -1, param = -1。
export struct FxKey {
  effect: i32;
  param: i32;
}

export function fxCount(): i32 {
  return 9;
}

export function fxName(e: i32): string {
  switch (e) {
    case 0: {
      return "blur";
    }
    case 1: {
      return "bright";
    }
    case 2: {
      return "contrast";
    }
    case 3: {
      return "gray";
    }
    case 4: {
      return "invert";
    }
    case 5: {
      return "pixelate";
    }
    case 6: {
      return "sat";
    }
    case 7: {
      return "sepia";
    }
    case 8: {
      return "vignette";
    }
  }
  return "";
}

export function fxDoc(e: i32): string {
  switch (e) {
    case 0: {
      return "ぼかす（箱ぼかしを 2 回。ガウスぼかしに近い）";
    }
    case 1: {
      return "明るさを変える（rgb に同じ量を足す）";
    }
    case 2: {
      return "コントラストを変える（0.5 を中心に掛ける）";
    }
    case 3: {
      return "白黒にする（彩度を 1 - amount にする）";
    }
    case 4: {
      return "色を反転する";
    }
    case 5: {
      return "モザイクにする（各ブロックを平均の色で塗る）";
    }
    case 6: {
      return "彩度を変える（BT.709 の輝度を中心に掛ける）";
    }
    case 7: {
      return "セピア調にする";
    }
    case 8: {
      return "周辺を暗くする";
    }
  }
  return "";
}

