// 効果 e が周りへ広がる画素数（@reach）。宣言がなければ 0。
export function fxReach(e: i32, params: f32[8]): i32 {
  switch (e) {
    case 0: {
      return Math.ceil(Math.floor(Math.max(params[0], 0.0) + 0.5) * 2.0) as i32;
    }
    case 1: {
      return 0;
    }
    case 2: {
      return 0;
    }
    case 3: {
      return 0;
    }
    case 4: {
      return 0;
    }
    case 5: {
      return 0;
    }
    case 6: {
      return Math.ceil(Math.max(params[0], 0.0) * 1.0) as i32;
    }
    case 7: {
      return Math.ceil(Math.max(params[0], 0.0) * 1.0) as i32;
    }
    case 8: {
      return 0;
    }
    case 9: {
      return Math.ceil(Math.floor(Math.max(params[1], 0.0) + 0.5) * 1.0) as i32;
    }
    case 10: {
      return 0;
    }
    case 11: {
      return 0;
    }
    case 12: {
      return 0;
    }
    case 13: {
      return 0;
    }
    case 14: {
      return 0;
    }
    case 15: {
      return 0;
    }
    case 16: {
      return 0;
    }
    case 17: {
      return 0;
    }
    case 18: {
      return Math.ceil(Math.floor(Math.max(params[0], 0.0) + 0.5) * 1.0) as i32;
    }
    case 19: {
      return 0;
    }
    case 20: {
      return 0;
    }
    case 21: {
      return 0;
    }
    case 22: {
      return 0;
    }
    case 23: {
      return 0;
    }
    case 24: {
      return Math.ceil(Math.max(params[1], 0.0) * 1.0) as i32;
    }
    case 25: {
      return 0;
    }
    case 26: {
      return 0;
    }
    case 27: {
      return 0;
    }
    case 28: {
      return 0;
    }
    case 29: {
      return 0;
    }
  }
  return 0;
}

// "blur" → (blur, 0)、"vignette.radius" → (vignette, 1)、別名（"saturation" → (sat, 0)）も。
// 見つからなければ effect = -1, param = -1。
export function fxFindKey(key: string): FxKey {
  switch (key) {
    case "blur":
      return { effect: 0, param: 0 };
    case "blur.radius":
      return { effect: 0, param: 0 };
    case "bright":
      return { effect: 1, param: 0 };
    case "bright.amount":
      return { effect: 1, param: 0 };
    case "chromakey":
      return { effect: 2, param: 0 };
    case "chromakey.tolerance":
      return { effect: 2, param: 0 };
    case "chromakey.softness":
      return { effect: 2, param: 1 };
    case "chromakey.spill":
      return { effect: 2, param: 2 };
    case "chromakey.shrink":
      return { effect: 2, param: 3 };
    case "chromakey.feather":
      return { effect: 2, param: 4 };
    case "chromakey.r":
      return { effect: 2, param: 5 };
    case "chromakey.g":
      return { effect: 2, param: 6 };
    case "chromakey.b":
      return { effect: 2, param: 7 };
    case "chromatic":
      return { effect: 3, param: 0 };
    case "chromatic.shift":
      return { effect: 3, param: 0 };
    case "chromatic.angle":
      return { effect: 3, param: 1 };
    case "aberration":
      return { effect: 3, param: 0 };
    case "aberration.shift":
      return { effect: 3, param: 0 };
    case "aberration.angle":
      return { effect: 3, param: 1 };
    case "contrast":
      return { effect: 4, param: 0 };
    case "contrast.amount":
      return { effect: 4, param: 0 };
    case "duotone":
      return { effect: 5, param: 0 };
    case "duotone.amount":
      return { effect: 5, param: 0 };
    case "duotone.shadow_r":
      return { effect: 5, param: 1 };
    case "duotone.shadow_g":
      return { effect: 5, param: 2 };
    case "duotone.shadow_b":
      return { effect: 5, param: 3 };
    case "duotone.high_r":
      return { effect: 5, param: 4 };
    case "duotone.high_g":
      return { effect: 5, param: 5 };
    case "duotone.high_b":
      return { effect: 5, param: 6 };
    case "edge":
      return { effect: 6, param: 0 };
    case "edge.amount":
      return { effect: 6, param: 0 };
    case "edge.mix":
      return { effect: 6, param: 1 };
    case "emboss":
      return { effect: 7, param: 0 };
    case "emboss.strength":
      return { effect: 7, param: 0 };
    case "emboss.mix":
      return { effect: 7, param: 1 };
    case "glitch":
      return { effect: 8, param: 0 };
    case "glitch.amount":
      return { effect: 8, param: 0 };
    case "glitch.seed":
      return { effect: 8, param: 1 };
    case "glow":
      return { effect: 9, param: 0 };
    case "glow.amount":
      return { effect: 9, param: 0 };
    case "glow.radius":
      return { effect: 9, param: 1 };
    case "glow.cutoff":
      return { effect: 9, param: 2 };
    case "bloom":
      return { effect: 9, param: 0 };
    case "bloom.amount":
      return { effect: 9, param: 0 };
    case "bloom.radius":
      return { effect: 9, param: 1 };
    case "bloom.cutoff":
      return { effect: 9, param: 2 };
    case "grain":
      return { effect: 10, param: 0 };
    case "grain.amount":
      return { effect: 10, param: 0 };
    case "grain.seed":
      return { effect: 10, param: 1 };
    case "noise":
      return { effect: 10, param: 0 };
    case "noise.amount":
      return { effect: 10, param: 0 };
    case "noise.seed":
      return { effect: 10, param: 1 };
    case "gray":
      return { effect: 11, param: 0 };
    case "gray.amount":
      return { effect: 11, param: 0 };
    case "grey":
      return { effect: 11, param: 0 };
    case "grey.amount":
      return { effect: 11, param: 0 };
    case "halftone":
      return { effect: 12, param: 0 };
    case "halftone.size":
      return { effect: 12, param: 0 };
    case "halftone.contrast":
      return { effect: 12, param: 1 };
    case "hue":
      return { effect: 13, param: 0 };
    case "hue.angle":
      return { effect: 13, param: 0 };
    case "invert":
      return { effect: 14, param: 0 };
    case "invert.amount":
      return { effect: 14, param: 0 };
    case "lumakey":
      return { effect: 15, param: 0 };
    case "lumakey.threshold":
      return { effect: 15, param: 0 };
    case "lumakey.softness":
      return { effect: 15, param: 1 };
    case "lumakey.invert":
      return { effect: 15, param: 2 };
    case "lumakey.shrink":
      return { effect: 15, param: 3 };
    case "lumakey.feather":
      return { effect: 15, param: 4 };
    case "matteview":
      return { effect: 16, param: 0 };
    case "matteview.mode":
      return { effect: 16, param: 0 };
    case "matteview.size":
      return { effect: 16, param: 1 };
    case "mirror":
      return { effect: 17, param: 0 };
    case "mirror.mode":
      return { effect: 17, param: 0 };
    case "motionblur":
      return { effect: 18, param: 0 };
    case "motionblur.length":
      return { effect: 18, param: 0 };
    case "motionblur.angle":
      return { effect: 18, param: 1 };
    case "pixelate":
      return { effect: 19, param: 0 };
    case "pixelate.size":
      return { effect: 19, param: 0 };
    case "mosaic":
      return { effect: 19, param: 0 };
    case "mosaic.size":
      return { effect: 19, param: 0 };
    case "posterize":
      return { effect: 20, param: 0 };
    case "posterize.levels":
      return { effect: 20, param: 0 };
    case "sat":
      return { effect: 21, param: 0 };
    case "sat.amount":
      return { effect: 21, param: 0 };
    case "saturation":
      return { effect: 21, param: 0 };
    case "saturation.amount":
      return { effect: 21, param: 0 };
    case "scanline":
      return { effect: 22, param: 0 };
    case "scanline.strength":
      return { effect: 22, param: 0 };
    case "scanline.pitch":
      return { effect: 22, param: 1 };
    case "sepia":
      return { effect: 23, param: 0 };
    case "sepia.amount":
      return { effect: 23, param: 0 };
    case "sharpen":
      return { effect: 24, param: 0 };
    case "sharpen.amount":
      return { effect: 24, param: 0 };
    case "sharpen.radius":
      return { effect: 24, param: 1 };
    case "solarize":
      return { effect: 25, param: 0 };
    case "solarize.amount":
      return { effect: 25, param: 0 };
    case "solarize.cutoff":
      return { effect: 25, param: 1 };
    case "threshold":
      return { effect: 26, param: 0 };
    case "threshold.cutoff":
      return { effect: 26, param: 0 };
    case "threshold.softness":
      return { effect: 26, param: 1 };
    case "tint":
      return { effect: 27, param: 0 };
    case "tint.amount":
      return { effect: 27, param: 0 };
    case "tint.r":
      return { effect: 27, param: 1 };
    case "tint.g":
      return { effect: 27, param: 2 };
    case "tint.b":
      return { effect: 27, param: 3 };
    case "vignette":
      return { effect: 28, param: 0 };
    case "vignette.strength":
      return { effect: 28, param: 0 };
    case "vignette.radius":
      return { effect: 28, param: 1 };
    case "vignette.softness":
      return { effect: 28, param: 2 };
    case "wave":
      return { effect: 29, param: 0 };
    case "wave.amplitude":
      return { effect: 29, param: 0 };
    case "wave.wavelength":
      return { effect: 29, param: 1 };
    case "wave.phase":
      return { effect: 29, param: 2 };
  }
  return { effect: -1, param: -1 };
}

// 効果 e を層に掛ける。結果は layer に残す。tmp は同じ大きさの作業用。知らない e では何もしない。
export function fxApply(e: i32, layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, params: f32[8]): void {
  switch (e) {
    case 0:
      fx_blur(mut layer, mut tmp, w, h, params);
      break;
    case 1:
      fx_bright(mut layer, mut tmp, w, h, params);
      break;
    case 2:
      fx_chromakey(mut layer, mut tmp, w, h, params);
      break;
    case 3:
      fx_chromatic(mut layer, mut tmp, w, h, params);
      break;
    case 4:
      fx_contrast(mut layer, mut tmp, w, h, params);
      break;
    case 5:
      fx_duotone(mut layer, mut tmp, w, h, params);
      break;
    case 6:
      fx_edge(mut layer, mut tmp, w, h, params);
      break;
    case 7:
      fx_emboss(mut layer, mut tmp, w, h, params);
      break;
    case 8:
      fx_glitch(mut layer, mut tmp, w, h, params);
      break;
    case 9:
      fx_glow(mut layer, mut tmp, w, h, params);
      break;
    case 10:
      fx_grain(mut layer, mut tmp, w, h, params);
      break;
    case 11:
      fx_gray(mut layer, mut tmp, w, h, params);
      break;
    case 12:
      fx_halftone(mut layer, mut tmp, w, h, params);
      break;
    case 13:
      fx_hue(mut layer, mut tmp, w, h, params);
      break;
    case 14:
      fx_invert(mut layer, mut tmp, w, h, params);
      break;
    case 15:
      fx_lumakey(mut layer, mut tmp, w, h, params);
      break;
    case 16:
      fx_matteview(mut layer, mut tmp, w, h, params);
      break;
    case 17:
      fx_mirror(mut layer, mut tmp, w, h, params);
      break;
    case 18:
      fx_motionblur(mut layer, mut tmp, w, h, params);
      break;
    case 19:
      fx_pixelate(mut layer, mut tmp, w, h, params);
      break;
    case 20:
      fx_posterize(mut layer, mut tmp, w, h, params);
      break;
    case 21:
      fx_sat(mut layer, mut tmp, w, h, params);
      break;
    case 22:
      fx_scanline(mut layer, mut tmp, w, h, params);
      break;
    case 23:
      fx_sepia(mut layer, mut tmp, w, h, params);
      break;
    case 24:
      fx_sharpen(mut layer, mut tmp, w, h, params);
      break;
    case 25:
      fx_solarize(mut layer, mut tmp, w, h, params);
      break;
    case 26:
      fx_threshold(mut layer, mut tmp, w, h, params);
      break;
    case 27:
      fx_tint(mut layer, mut tmp, w, h, params);
      break;
    case 28:
      fx_vignette(mut layer, mut tmp, w, h, params);
      break;
    case 29:
      fx_wave(mut layer, mut tmp, w, h, params);
      break;
  }
}

// ---- 登録表（組み込みの効果と .mzplug の効果） ----

// 組み込みの効果の数。番号がこれ以上の効果は .mzplug（wasm）。
export const FX_BUILTIN_COUNT: i32 = 30;

// .mzplug の効果の名前・別名に使えない名前（組み込みの効果の名前と別名、コアのキー）。
export function fxReservedNames(): string[] {
  return ["blur", "bright", "chromakey", "chromatic", "aberration", "contrast", "duotone", "edge", "emboss", "glitch", "glow", "bloom", "grain", "noise", "gray", "grey", "halftone", "hue", "invert", "lumakey", "matteview", "mirror", "motionblur", "pixelate", "mosaic", "posterize", "sat", "saturation", "scanline", "sepia", "sharpen", "solarize", "threshold", "tint", "vignette", "wave", "afadein", "afadeout", "align", "anchor", "at", "bg", "blend", "blend.space", "blend.tf", "burst", "camera.aa", "camera.aperture", "camera.focus", "camera.fov", "camera.roll", "camera.samples", "camera.tx", "camera.ty", "camera.tz", "camera.x", "camera.y", "camera.z", "camera.zoom", "cap", "color", "color.end", "crf", "d", "dash", "dashoffset", "dir", "dir.mode", "drag", "draw", "drawoff", "drawon", "dur", "duration", "emit", "emit.dur", "emit.edge", "emit.h", "emit.w", "enabled", "fade", "fadein", "fadeout", "fill", "fillfrom", "fillrule", "fillto", "fit", "font", "fontindex", "fps", "full", "gravity", "h", "height", "id", "in", "inner", "join", "layer", "life", "life.var", "light.ambient", "light.intensity", "light.type", "light.x", "light.y", "light.z", "link", "matte", "matte.invert", "matte.type", "max", "mblur", "mblur.angle", "mblur.phase", "mblur.samples", "miter", "mute", "opacity", "opacity.end", "opacity.in", "opacity.out", "out", "outline", "outlinew", "output", "ox", "oy", "pad", "parent", "points", "pos", "preset", "prewarm", "r", "radius", "rate", "repeat", "repeatopend", "repeatopstart", "repeatorder", "repeatrot", "repeatscale", "repeatx", "repeaty", "rot.var", "rotation", "rx", "ry", "scale", "seed", "shadow", "shape", "sides", "size", "size.end", "size.var", "speed", "speed.var", "spin", "spin.var", "spread", "sprite", "src", "steps", "stroke", "strokefrom", "stroketo", "strokew", "timeremap", "track", "trans", "trans.angle", "trans.param", "trans.soft", "trimend", "trimmode", "trimoffset", "trimstart", "turb", "turb.scale", "turb.speed", "vol", "volume", "w", "width", "wind", "x", "x2", "xfade", "y", "y2", "z"];
}

// 効果の登録表。fxRegBuiltin()（組み込みだけ）か fxRegLoad(paths)（.mzplug も読み込む）で 1 度だけ作り、呼ぶ側が渡す。
// 番号 e は 0 .. count()-1。組み込みの効果が先で、.mzplug の効果は読み込んだ順に後ろへ続く（番号は決め打ちせず findKey で引く）。
export class FxReg {
  wasm: WasmFxSet;
  bands: i32 = 0;   // .mzplug の効果を分ける帯の数（0 は自動、1 は分けない）

  constructor(wasm: own WasmFxSet) {
    this.wasm = wasm;
  }

  count(): i32 {
    return FX_BUILTIN_COUNT + (this.wasm.fx.length as i32);
  }

  // 効果 e が .mzplug（wasm）か。
  isWasm(e: i32): bool {
    return e >= FX_BUILTIN_COUNT && e < this.count();
  }

  // 効果 e の出どころ: 組み込みなら "builtin"、.mzplug ならそのファイルの場所。知らない e は ""。
  source(e: i32): string {
    if (e >= 0 && e < FX_BUILTIN_COUNT) {
      return "builtin";
    }
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].path.clone();
    }
    return "";
  }

  name(e: i32): string {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].name.clone();
    }
    return fxName(e);
  }

  doc(e: i32): string {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].doc.clone();
    }
    return fxDoc(e);
  }

  paramCount(e: i32): i32 {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].params.length as i32;
    }
    return fxParamCount(e);
  }

  paramName(e: i32, k: i32): string {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (k >= 0 && (k as usize) < this.wasm.fx[w].params.length) {
        return this.wasm.fx[w].params[k as usize].name.clone();
      }
      return "";
    }
    return fxParamName(e, k);
  }

  paramDoc(e: i32, k: i32): string {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (k >= 0 && (k as usize) < this.wasm.fx[w].params.length) {
        return this.wasm.fx[w].params[k as usize].doc.clone();
      }
      return "";
    }
    return fxParamDoc(e, k);
  }

  paramDefault(e: i32, k: i32): f32 {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (k >= 0 && (k as usize) < this.wasm.fx[w].params.length) {
        return this.wasm.fx[w].params[k as usize].def;
      }
      return 0;
    }
    return fxParamDefault(e, k);
  }

  paramMin(e: i32, k: i32): f32 {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (k >= 0 && (k as usize) < this.wasm.fx[w].params.length) {
        return this.wasm.fx[w].params[k as usize].min;
      }
      return 0;
    }
    return fxParamMin(e, k);
  }

  paramMax(e: i32, k: i32): f32 {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (k >= 0 && (k as usize) < this.wasm.fx[w].params.length) {
        return this.wasm.fx[w].params[k as usize].max;
      }
      return 0;
    }
    return fxParamMax(e, k);
  }

  aliasCount(e: i32): i32 {
    if (this.isWasm(e)) {
      return this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize].aliases.length as i32;
    }
    return fxAliasCount(e);
  }

  alias(e: i32, i: i32): string {
    if (this.isWasm(e)) {
      const w = (e - FX_BUILTIN_COUNT) as usize;
      if (i >= 0 && (i as usize) < this.wasm.fx[w].aliases.length) {
        return this.wasm.fx[w].aliases[i as usize].clone();
      }
      return "";
    }
    return fxAlias(e, i);
  }

  // 効果 e が周りへ広がる画素数（@reach）。
  reach(e: i32, params: f32[8]): i32 {
    if (this.isWasm(e)) {
      return wasmFxReach(this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize], params);
    }
    return fxReach(e, params);
  }

  // "blur" → (blur, 0)、"vignette.radius" → (vignette, 1)、別名も。.mzplug の効果も引く。見つからなければ (-1, -1)。
  findKey(key: string): FxKey {
    const b = fxFindKey(key);
    if (b.effect >= 0) {
      return b;
    }
    for (let w: usize = 0; w < this.wasm.fx.length; w++) {
      const e = FX_BUILTIN_COUNT + (w as i32);
      if (fxRegKeyHead(key, this.wasm.fx[w].name)) {
        return fxRegKeyParam(key, this.wasm.fx[w].name, this.wasm.fx[w].params, e);
      }
      for (const a of this.wasm.fx[w].aliases) {
        if (fxRegKeyHead(key, a)) {
          return fxRegKeyParam(key, a, this.wasm.fx[w].params, e);
        }
      }
    }
    return { effect: -1, param: -1 };
  }

  // 効果 e を層に掛ける。結果は layer に残す。tmp は同じ大きさの作業用（組み込みの効果だけが使う）。
  // 成功（と知らない e）なら ""。.mzplug の効果が失敗したら（トラップ・時間切れなど）理由の文を返し、layer は変えない。
  apply(e: i32, layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, params: f32[8]): string {
    if (this.isWasm(e)) {
      return wasmFxApply(this.wasm.fx[(e - FX_BUILTIN_COUNT) as usize], mut layer, w, h, params, this.bands);
    }
    fxApply(e, mut layer, mut tmp, w, h, params);
    return "";
  }
}

// key が head そのものか、head + "." で始まるか。
function fxRegKeyHead(key: string, head: string): bool {
  if (key.length < head.length) {
    return false;
  }
  for (let i: usize = 0; i < head.length; i++) {
    if (key[i] != head[i]) {
      return false;
    }
  }
  return key.length == head.length || key[head.length] == 46;
}

// fxRegKeyHead(key, head) が真のとき: "head" → (e, 0)、"head.param" → (e, その番号)。引数がなければ (-1, -1)。
function fxRegKeyParam(key: string, head: string, params: WasmFxParam[], e: i32): FxKey {
  if (key.length == head.length) {
    return { effect: e, param: 0 };
  }
  for (let k: usize = 0; k < params.length; k++) {
    if (key.length == head.length + 1 + params[k].name.length) {
      let same = true;
      for (let i: usize = 0; i < params[k].name.length; i++) {
        if (key[head.length + 1 + i] != params[k].name[i]) {
          same = false;
        }
      }
      if (same) {
        return { effect: e, param: k as i32 };
      }
    }
  }
  return { effect: -1, param: -1 };
}

// 組み込みの効果だけの登録表。
export function fxRegBuiltin(): FxReg {
  let set = wasmFxEmpty();
  return new FxReg(own set);
}

// 組み込みの効果に、.mzplug の効果（paths の順）を足した登録表。読めない包み・名前のぶつかる包みは飛ばし、
// 理由を reg.wasm.diags（code "bad-plugin"）に入れる。止まらない。
export function fxRegLoad(paths: string[]): FxReg {
  let set = wasmFxEmpty();
  const reserved = fxReservedNames();
  for (const p of paths) {
    wasmFxLoad(mut set, p, reserved);
  }
  return new FxReg(own set);
}

// 既定のフォルダ（plugins-installed/ と extra で渡されたフォルダ・index.txt・.mzplug）から .mzplug を自動で探して読み込む。
export function fxRegDiscover(extra: string[]): FxReg {
  let sources: string[] = ["plugins-installed", "plugins"];
  for (const s of extra) {
    if (s.length > 0) {
      sources.push(s.clone());
    }
  }
  return fxRegLoad(wasmFxDiscover(sources));
}

// 編集画面のプレビュー用に、.mzplug の 1 回の実行時間の上限を短くする。
export function fxRegSetPreviewTimeout(reg: FxReg): void {
  for (const f of reg.wasm.fx) {
    wasmFxSetTimeout(f, WASMFX_PREVIEW_TIMEOUT_MS);
  }
  for (const tr of reg.wasm.trans) {
    wasmTransSetTimeout(tr, WASMFX_PREVIEW_TIMEOUT_MS);
  }
}
