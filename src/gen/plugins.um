    case 7: {
      if (k == 0) {
        return "強さ（1 で完全なセピア、0 でそのまま）";
      }
      return "";
    }
    case 8: {
      if (k == 0) {
        return "暗くする強さ（1 で、半径 + 幅より外が黒くなる。既定の半径と幅では四隅が黒くなる）";
      }
      if (k == 1) {
        return "暗くし始める半径（掛ける層の対角の半分を 1 とする）";
      }
      if (k == 2) {
        return "暗くなっていく幅（半径からこの幅で強さいっぱいまで暗くなる）";
      }
      return "";
    }
  }
  return "";
}

