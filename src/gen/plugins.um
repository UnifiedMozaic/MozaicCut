      }
      return "";
    }
    case 5: {
      if (k == 0) {
        return "ブロックの一辺（画素。小数は四捨五入。1 で何もしない）";
      }
      return "";
    }
    case 6: {
      if (k == 0) {
        return "倍率（1 でそのまま、0 で白黒）";
      }
      return "";
    }
    case 7: {
      if (k == 0) {
        return "強さ（1 で完全なセピア、0 でそのまま）";
      }
      return "";
    }
    case 8: {
      if (k == 0) {
        return "強さ（元の色とぼかした色の差を、この倍だけ足す）";
      }
      if (k == 1) {
        return "ぼかしの半径（画素。小数は四捨五入。大きいほど太い輪郭が強まる）";
      }
      return "";
    }
    case 9: {
      if (k == 0) {
        return "暗くする強さ（1 で、半径 + 幅より外が黒くなる。既定の半径と幅では四隅が黒くなる）";
      }
