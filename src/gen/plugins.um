// 自動生成されるプラグインの登録表（tools/gen-plugins.mjs が plugins/*.um から作る）。手で書き換えない。
// ./fx/*.um は plugins/*.um の写し（行番号も同じ）。コンパイルの誤りが写しを指したら、plugins/ の方を直す。
// 効果: bright
import { fx_bright } from "./fx/bright.um";

export const FX_PARAMS: i32 = 8;

// 効果と引数の番号。見つからなければ effect = -1, param = -1。
export struct FxKey {
  effect: i32;
  param: i32;
}

export function fxCount(): i32 {
  return 1;
}

export function fxName(e: i32): string {
  switch (e) {
    case 0: {
      return "bright";
    }
  }
  return "";
}

export function fxDoc(e: i32): string {
  switch (e) {
    case 0: {
      return "明るさを変える（rgb に同じ量を足す）";
    }
  }
  return "";
}

export function fxParamCount(e: i32): i32 {
  switch (e) {
    case 0: {
      return 1;
    }
  }
  return 0;
}

export function fxParamName(e: i32, k: i32): string {
  switch (e) {
    case 0: {
      if (k == 0) {
        return "amount";
      }
      return "";
    }
  }
  return "";
}

export function fxParamDoc(e: i32, k: i32): string {
  switch (e) {
    case 0: {
      if (k == 0) {
        return "足す量（-1 で黒、1 で白に近づく）";
      }
      return "";
    }
  }
  return "";
}

export function fxParamDefault(e: i32, k: i32): f32 {
  switch (e) {
    case 0: {
      if (k == 0) {
        return 0;
      }
      return 0;
    }
  }
  return 0;
}

export function fxParamMin(e: i32, k: i32): f32 {
  switch (e) {
    case 0: {
      if (k == 0) {
        return -1;
      }
      return 0;
    }
  }
  return 0;
}

export function fxParamMax(e: i32, k: i32): f32 {
  switch (e) {
    case 0: {
      if (k == 0) {
        return 1;
      }
      return 0;
    }
  }
  return 0;
}

// 効果 e の別名（@alias）の数と、i 番目の別名。別名は主の引数を決め、"<別名>.<引数>" とも書ける。
export function fxAliasCount(e: i32): i32 {
  switch (e) {
    case 0: {
      return 0;
    }
  }
  return 0;
}

export function fxAlias(e: i32, i: i32): string {
  switch (e) {
    case 0: {
      return "";
    }
  }
  return "";
}

// 効果 e が周りへ広がる画素数（@reach）。宣言がなければ 0。
export function fxReach(e: i32, params: f32[8]): i32 {
  switch (e) {
    case 0: {
      return 0;
    }
  }
  return 0;
}

// "blur" → (blur, 0)、"vignette.radius" → (vignette, 1)、別名（"saturation" → (sat, 0)）も。
// 見つからなければ effect = -1, param = -1。
export function fxFindKey(key: string): FxKey {
  switch (key) {
    case "bright":
      return { effect: 0, param: 0 };
    case "bright.amount":
      return { effect: 0, param: 0 };
  }
  return { effect: -1, param: -1 };
}

// 効果 e を層に掛ける。結果は layer に残す。tmp は同じ大きさの作業用。知らない e では何もしない。
export function fxApply(e: i32, layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, params: f32[8]): void {
  switch (e) {
    case 0:
      fx_bright(mut layer, mut tmp, w, h, params);
      break;
  }
}
