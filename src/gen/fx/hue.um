// @effect hue "色相を回す（RGB を YCbCr の色平面で回転する）"
// @param angle 30 -180..180 "色相の角度（度。0 で何もしない、180 で反対の色）"

const HUE_DEG: f32 = 0.0174532925;

// 小さい範囲に畳んだ角度の sin / cos（テイラー展開）。
kernel function hueSin(x0: f32): f32 {
  const PI: f32 = 3.14159265;
  let x = x0;
  while (x > PI) {
    x = x - 2.0 * PI;
  }
  while (x < -PI) {
    x = x + 2.0 * PI;
  }
  if (x > 0.5 * PI) {
    x = PI - x;
  } else if (x < -0.5 * PI) {
    x = -PI - x;
  }
  const x2 = x * x;
  return x * (1.0 - x2 * (1.0 / 6.0 - x2 * (1.0 / 120.0 - x2 * (1.0 / 5040.0))));
}

kernel function hueCos(x: f32): f32 {
  const PI: f32 = 3.14159265;
  return hueSin(x + 0.5 * PI);
}

kernel function hueKernel(i: u32, layer: mut Buffer<vec4<f32>>, sn: f32, cs: f32): void {
  const c = layer[i];
  const y = 0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z;
  const cb = (c.z - y) / 1.8556;
  const cr = (c.x - y) / 1.5748;
  const cb2 = cb * cs - cr * sn;
  const cr2 = cb * sn + cr * cs;
  const r = y + 1.5748 * cr2;
  const g = y - 0.187324 * cb2 - 0.468124 * cr2;
  const b = y + 1.8556 * cb2;
  layer[i] = vec4(
    Math.min(Math.max(r, 0.0), 1.0),
    Math.min(Math.max(g, 0.0), 1.0),
    Math.min(Math.max(b, 0.0), 1.0),
    c.w,
  );
}

export function fx_hue(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  if (p[0] == 0.0) {
    return;
  }
  const rad = p[0] * HUE_DEG;
  dispatch(hueKernel, w * h, mut layer, hueSin(rad), hueCos(rad));
}
// ---- この写しは tools/gen-plugins.mjs が plugins/hue.um から作る。ここを直しても次の生成で消える。直すのは plugins/hue.um。
