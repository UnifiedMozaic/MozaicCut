// @effect pixelate "モザイクにする（各ブロックを平均の色で塗る）"
// @param size 12 1..256 "ブロックの一辺（画素。小数は四捨五入。1 で何もしない）"
// @alias mosaic
//
// ブロックは層の左上から並べる（右端・下端のブロックは小さくなることがある）。
// アルファもブロックで平均する。rgb はアルファで重み付けして平均する（rgb*a の平均を a の平均で割る。
// a の平均が 0 なら (0,0,0,0)）。透明な画素の見えない色は混ざらない。不透明な層ではただの平均と同じ。
//
// 3 段で計算し、1 画素あたりの読み取りを大きさによらずほぼ一定にする:
//   1. ブロックの列 bx と行 y ごとに、その行の中の和（プリマルチプライ）を tmp の先頭 bw × h に書く
//   2. ブロックごとに、1 の和をブロックの行にわたって足し、平均の色（ストレートアルファ）を小さな Buffer に書く
//   3. 画素ごとに、属するブロックの色で塗る

// 1. tmp[y * bw + bx] = 行 y の中の、ブロックの列 bx の和（rgb*a, a）。
kernel function pixelateRowSum(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, w: u32, bw: u32, s: u32): void {
  const bx = i % bw;
  const y = i / bw;
  const x0 = bx * s;
  const x1 = Math.min(x0 + s, w);
  let acc = vec4(0.0, 0.0, 0.0, 0.0);
  for (let x = x0; x < x1; x++) {
    const c = src[y * w + x];
    acc = acc + vec4(c.x * c.w, c.y * c.w, c.z * c.w, c.w);
  }
  dst[i] = acc;
}

// 2. blocks[by * bw + bx] = ブロックの平均の色。
kernel function pixelateBlock(i: u32, blocks: mut Buffer<vec4<f32>>, sums: Buffer<vec4<f32>>, w: u32, h: u32, bw: u32, s: u32): void {
  const bx = i % bw;
  const by = i / bw;
  const y0 = by * s;
  const y1 = Math.min(y0 + s, h);
  let acc = vec4(0.0, 0.0, 0.0, 0.0);
  for (let y = y0; y < y1; y++) {
    acc = acc + sums[y * bw + bx];
  }
  const x0 = bx * s;
  const n = ((Math.min(x0 + s, w) - x0) * (y1 - y0)) as f32;
  const a = Math.min(Math.max(acc.w / n, 0.0), 1.0);
  if (acc.w <= 0.0) {
    blocks[i] = vec4(0.0, 0.0, 0.0, 0.0);
    return;
  }
  blocks[i] = vec4(
    Math.min(Math.max(acc.x / acc.w, 0.0), 1.0),
    Math.min(Math.max(acc.y / acc.w, 0.0), 1.0),
    Math.min(Math.max(acc.z / acc.w, 0.0), 1.0),
    a,
  );
}

// 3. 画素を属するブロックの色で塗る。
kernel function pixelateFill(i: u32, layer: mut Buffer<vec4<f32>>, blocks: Buffer<vec4<f32>>, w: u32, bw: u32, s: u32): void {
  const x = i % w;
  const y = i / w;
  layer[i] = blocks[(y / s) * bw + x / s];
}

export function fx_pixelate(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  const si = Math.floor(p[0] + 0.5) as i32;
  if (si <= 1 || w == 0 || h == 0) {
    return;
  }
  const s = si as u32;
  const bw = (w + s - 1) / s;
  const bh = (h + s - 1) / s;
  dispatch(pixelateRowSum, bw * h, mut tmp, layer, w, bw, s);
  let blocks = new Buffer<vec4<f32>>(bw * bh);
  dispatch(pixelateBlock, bw * bh, mut blocks, tmp, w, h, bw, s);
  dispatch(pixelateFill, w * h, mut layer, blocks, w, bw, s);
}
// ---- この写しは tools/gen-plugins.mjs が plugins/pixelate.um から作る。ここを直しても次の生成で消える。直すのは plugins/pixelate.um。
