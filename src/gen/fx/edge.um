// @effect edge "輪郭を抽出する（ソーベルフィルタでエッジを光らせる）"
// @param amount 1 0..4 "輪郭の強さ（0 で元の絵のまま）"
// @param mix 1 0..1 "元の絵との混ぜ具合（1 で黒地に輪郭だけ、0 で元の絵に輪郭を加算）"
// @reach amount 1

kernel function edgeLuma(src: Buffer<vec4<f32>>, w: u32, x: i32, y: i32, maxX: i32, maxY: i32): f32 {
  const xx = Math.min(Math.max(x, 0), maxX) as u32;
  const yy = Math.min(Math.max(y, 0), maxY) as u32;
  const c = src[yy * w + xx];
  return (0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z) * c.w;
}

kernel function edgeCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  dst[i] = src[i];
}

kernel function edgeKernel(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, w: u32, h: u32, amt: f32, mix: f32): void {
  const x = (i % w) as i32;
  const y = (i / w) as i32;
  const maxX = (w as i32) - 1;
  const maxY = (h as i32) - 1;
  const tl = edgeLuma(src, w, x - 1, y - 1, maxX, maxY);
  const tc = edgeLuma(src, w, x, y - 1, maxX, maxY);
  const tr = edgeLuma(src, w, x + 1, y - 1, maxX, maxY);
  const ml = edgeLuma(src, w, x - 1, y, maxX, maxY);
  const mr = edgeLuma(src, w, x + 1, y, maxX, maxY);
  const bl = edgeLuma(src, w, x - 1, y + 1, maxX, maxY);
  const bc = edgeLuma(src, w, x, y + 1, maxX, maxY);
  const br = edgeLuma(src, w, x + 1, y + 1, maxX, maxY);
  const gx = (tr + 2.0 * mr + br) - (tl + 2.0 * ml + bl);
  const gy = (bl + 2.0 * bc + br) - (tl + 2.0 * tc + tr);
  const e = Math.min(Math.sqrt(gx * gx + gy * gy) * amt, 1.0);
  const c = src[i];
  const keep = 1.0 - mix;
  dst[i] = vec4(
    Math.min(Math.max(c.x * keep + e, 0.0), 1.0),
    Math.min(Math.max(c.y * keep + e, 0.0), 1.0),
    Math.min(Math.max(c.z * keep + e, 0.0), 1.0),
    c.w,
  );
}

export function fx_edge(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  if (p[0] <= 0.0) {
    return;
  }
  dispatch(edgeCopy, w * h, mut tmp, layer);
  dispatch(edgeKernel, w * h, mut layer, tmp, w, h, p[0], p[1]);
}
// ---- この写しは tools/gen-plugins.mjs が plugins/edge.um から作る。ここを直しても次の生成で消える。直すのは plugins/edge.um。
