// @effect contrast "コントラストを変える（0.5 を中心に掛ける）"
// @param amount 1 0..4 "倍率（1 でそのまま、0 で一面の灰色）"
//
// 色の効果なので、アルファは変えない。結果は 0..1 に収める。

kernel function contrastKernel(i: u32, layer: mut Buffer<vec4<f32>>, p: f32[8]): void {
  const c = layer[i];
  const a = p[0];
  layer[i] = vec4(
    Math.min(Math.max((c.x - 0.5) * a + 0.5, 0.0), 1.0),
    Math.min(Math.max((c.y - 0.5) * a + 0.5, 0.0), 1.0),
    Math.min(Math.max((c.z - 0.5) * a + 0.5, 0.0), 1.0),
    c.w,
  );
}

export function fx_contrast(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  dispatch(contrastKernel, w * h, mut layer, p);
}
// ---- この写しは tools/gen-plugins.mjs が plugins/contrast.um から作る。ここを直しても次の生成で消える。直すのは plugins/contrast.um。
