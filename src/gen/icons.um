// 番号から名前（"i-" なし）。範囲の外なら ""。
export function icnName(id: i32): string {
  switch (id) {
    case 0: return "play";
    case 1: return "pause";
    case 2: return "stepb";
    case 3: return "stepf";
    case 4: return "prevedit";
    case 5: return "nextedit";
    case 6: return "in";
    case 7: return "out";
    case 8: return "loop";
    case 9: return "select";
    case 10: return "trim";
    case 11: return "blade";
    case 12: return "hand";
    case 13: return "snap";
    case 14: return "link";
    case 15: return "eye";
    case 16: return "lock";
    case 17: return "unlock";
