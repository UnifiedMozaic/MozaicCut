// 自動生成されるアイコンの形（tools/gen-icons.mjs が docs/design/mockups/*.html の <symbol id="i-…"> から作る）。手で書き換えない。
// 描くのは src/ui/icons/draw.um（icnDraw / icnDrawBuf）。名前は SVG の id から "i-" を除いたもの（icnId("play")）。
// 番号は tools/icons-order.json の並び（作り直しても変わらない。新しいアイコンは末尾に足される）。
// 描く場所では ICN_* の定数を使う（icnId は文字列を比べるので、起動時や設定の読み込みのときだけ使う）。
// 元: docs/design/mockups/*.html
// アイコン（74 個）: play pause stepb stepf prevedit nextedit in out loop select trim blade hand snap link eye lock unlock plus minus search gear undo redo export media fx text audio history ai warn error check close chev-d chev-r kf kf-on reset folder file target focus sidebar cmd marker speed copy code dots drop new grid list twoup mute offline person image color keyboard subtitle sync meter bin bolt chev-l chev-u sound clock gpu synclock ref
//
// icnGeom(id) の並び（座標は 16×16 の格子。曲線と円弧は細かい直線にしてある）:
//   [要素の数, 要素…]  要素 = [塗りの濃さ(0 = 塗らない), 線の太さ(0 = 線なし), 線の濃さ, 塗りの規則(0 nonzero / 1 evenodd), 部分の数, 部分…]
//   部分 = [閉じているか(0/1), 点の数, x0, y0, x1, y1, …]   線の端と角はすべて丸（round）

export const ICN_COUNT: i32 = 74;
export const ICN_NONE: i32 = -1;
export const ICN_PLAY: i32 = 0;
export const ICN_PAUSE: i32 = 1;
