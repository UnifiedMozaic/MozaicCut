    case 39: return "reset";
    case 40: return "folder";
    case 41: return "file";
    case 42: return "target";
    case 43: return "focus";
    case 44: return "sidebar";
    case 45: return "cmd";
    case 46: return "marker";
    case 47: return "speed";
    case 48: return "copy";
    case 49: return "code";
    case 50: return "dots";
    case 51: return "drop";
    case 52: return "new";
    case 53: return "grid";
    case 54: return "list";
    case 55: return "twoup";
    case 56: return "mute";
    case 57: return "offline";
    case 58: return "person";
    case 59: return "image";
    case 60: return "color";
    case 61: return "keyboard";
    case 62: return "subtitle";
    case 63: return "sync";
    case 64: return "meter";
    case 65: return "bin";
    case 66: return "bolt";
    case 67: return "chev-l";
    case 68: return "chev-u";
    case 69: return "sound";
    case 70: return "clock";
    case 71: return "gpu";
    case 72: return "synclock";
    case 73: return "ref";
  }
  return "";
}

// 名前から番号（"play" でも "i-play" でもよい）。見つからなければ ICN_NONE。
export function icnId(name: string): i32 {
  let n = name.clone();
  if (name.length > 2 && name[0] == 105 && name[1] == 45) {
    let b = new Array<u8>(name.length - 2);
    for (let i: usize = 2; i < name.length; i++) {
      b[i - 2] = name[i];
    }
    n = stringFromBytes(b);
  }
  switch (n) {
    case "play": return 0;
    case "pause": return 1;
    case "stepb": return 2;
    case "stepf": return 3;
    case "prevedit": return 4;
    case "nextedit": return 5;
    case "in": return 6;
    case "out": return 7;
    case "loop": return 8;
    case "select": return 9;
    case "trim": return 10;
    case "blade": return 11;
    case "hand": return 12;
    case "snap": return 13;
    case "link": return 14;
    case "eye": return 15;
    case "lock": return 16;
    case "unlock": return 17;
    case "plus": return 18;
    case "minus": return 19;
    case "search": return 20;
    case "gear": return 21;
    case "undo": return 22;
    case "redo": return 23;
    case "export": return 24;
    case "media": return 25;
    case "fx": return 26;
    case "text": return 27;
    case "audio": return 28;
    case "history": return 29;
    case "ai": return 30;
    case "warn": return 31;
    case "error": return 32;
    case "check": return 33;
    case "close": return 34;
    case "chev-d": return 35;
    case "chev-r": return 36;
    case "kf": return 37;
    case "kf-on": return 38;
    case "reset": return 39;
    case "folder": return 40;
    case "file": return 41;
    case "target": return 42;
    case "focus": return 43;
    case "sidebar": return 44;
    case "cmd": return 45;
    case "marker": return 46;
    case "speed": return 47;
    case "copy": return 48;
    case "code": return 49;
    case "dots": return 50;
    case "drop": return 51;
    case "new": return 52;
    case "grid": return 53;
    case "list": return 54;
    case "twoup": return 55;
    case "mute": return 56;
    case "offline": return 57;
    case "person": return 58;
    case "image": return 59;
    case "color": return 60;
    case "keyboard": return 61;
    case "subtitle": return 62;
    case "sync": return 63;
    case "meter": return 64;
    case "bin": return 65;
    case "bolt": return 66;
    case "chev-l": return 67;
    case "chev-u": return 68;
    case "sound": return 69;
    case "clock": return 70;
    case "gpu": return 71;
    case "synclock": return 72;
    case "ref": return 73;
  }
  return ICN_NONE;
}

// 形の並び（上の説明の形）。範囲の外なら空。
