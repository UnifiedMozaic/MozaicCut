// 生成したファイル。手で直さない。元は docs/design/tokens.json（node tools/gen-monitor-theme.mjs で作り直す）。
// tokens.json の version 2。
import { MonTheme, monClampScale, monTokensFlatten } from "../ui_monitor/theme.um";

// tokens.json の既定の値（倍率 1.0）でテーマを作る。scale は UI の倍率。
export function monThemeTokens(scale: f32): MonTheme {
  let t: MonTheme = {
    scale: 1.0,
    bg1: 0xFF1B1B1B, // color.dark.bg.1
    bg2: 0xFF222222, // color.dark.bg.2
    bg3: 0xFF2C2C2C, // color.dark.bg.3
    bg4: 0xFF383838, // color.dark.bg.4
    bgViewer: 0xFF0D0D0D, // color.dark.bg.viewer
    bgPopover: 0xFF1F1F1F, // color.dark.bg.popover
    viewerBlack: 0xFF000000, // color.dark.viewerChoices.black
    viewerMidGray: 0xFF767676, // color.dark.viewerChoices.midGray
    viewerUi: 0xFF1B1B1B, // color.dark.viewerChoices.ui
    line: 0xFF2C2C2C, // color.dark.line.default
    lineStrong: 0xFF3C3C3C, // color.dark.line.strong
    lineControl: 0xFF767676, // color.dark.line.control
    text1: 0xFFE6E6E6, // color.dark.text.1
    text2: 0xFFA3A3A3, // color.dark.text.2
    text3: 0xFF8C8C8C, // color.dark.text.3
    textDis: 0xFF666666, // color.dark.text.disabled
    textOnDark: 0xFFF2F2F2, // color.dark.text.onDark
    textOnRipple: 0xFF141414, // color.dark.text.onRipple
    textOnOverwrite: 0xFF141414, // color.dark.text.onOverwrite
    accent: 0xFF4C8DFF, // color.dark.accent.default
    accentHover: 0xFF6FA3FF, // color.dark.accent.hover
    playhead: 0xFFFF4D4D, // color.dark.semantic.playhead
    playheadEdge: 0xFF000000, // color.dark.semantic.playheadEdge
    ripple: 0xFFF2C94C, // color.dark.semantic.ripple
    rippleTint: 0x24F2C94C, // color.dark.semantic.rippleTint
    overwrite: 0xFFF860B2, // color.dark.semantic.overwrite
    overwriteTint: 0x14F860B2, // color.dark.semantic.overwriteTint
    ok: 0xFF4CC38A, // color.dark.semantic.ok
    warn: 0xFFF08A3C, // color.dark.semantic.warn
    error: 0xFFFF706C, // color.dark.semantic.error
    inOut: 0x12FFFFFF, // color.dark.semantic.inOut
    focusOuter: 0xFF000000, // color.dark.semantic.focusOuter
    kVideo: 0xFF56B4E9, // color.dark.clip.video.mark
    kAudio: 0xFF2FBF8F, // color.dark.clip.audio.mark
    kText: 0xFFCC79A7, // color.dark.clip.text.mark
    kImage: 0xFFE69F00, // color.dark.clip.image.mark
    kColor: 0xFFBDBDBD, // color.dark.clip.color.mark
    ovlBg: 0x8C000000, // tokens にない: 重ねる表示の地（edit.html の .ovl の rgba(0,0,0,.55)）
    guide: 0x59FFFFFF, // tokens にない: 安全領域・グリッドの線（ui.md 9 章「無彩色」。白 35%）
    kbdEdgeBtn: 0x40000000, // tokens にない: ボタンの中のキーの札の縁（edit.html の .btn .kbd の rgba(0,0,0,.25)）
    // 大きさ（倍率を掛ける前の論理 px）
    panelHeader: 32.0, // size.panelHeader
    btnSm: 24.0, // size.button.sm
    iconBtnSm: 24.0, // size.iconButton.sm
    iconBtnMd: 28.0, // size.iconButton.md
    iconSm: 16.0, // size.icon.sm
    hitMin: 24.0, // size.hitTargetMin
    sp1: 4.0, // space.1
    sp2: 8.0, // space.2
    sp3: 12.0, // space.3
    sp4: 16.0, // space.4
    radiusSm: 3.0, // radius.sm
    radiusMd: 5.0, // radius.md
    hairline: 1.0, // border.hairline
    focusW: 2.0, // border.focus
    fsXs: 11.0, // font.size.xs.size
    fsSm: 12.0, // font.size.sm.size
    fsMd: 13.0, // font.size.md.size
    fsTcM: 15.0, // font.size.tcM.size
    transportH: 40.0, // tokens にない: 再生の帯の高さ（ui.md 9 章）
    scrubH: 4.0, // tokens にない: スクラブの帯の高さ（edit.html の .scrub。ui.md 9 章は 6）
    iconXs: 12.0, // tokens にない: 山形などの小さなアイコン（edit.html の .ic.sm）
    chipH: 20.0, // tokens にない: 札の高さ（edit.html の .chip）
    kbdH: 18.0, // tokens にない: キーの札の高さ（edit.html の .kbd）
    tcW: 130.0, // tokens にない: 再生の帯の時刻の欄の幅（edit.html の .transport .tc）
    sepH: 20.0, // tokens にない: 縦の区切りの線の高さ（edit.html の .sep-v）
    ovlPadX: 6.0, // tokens にない: 重ねる表示の札の左右の余白（edit.html の .ovl）
    ovlPadY: 2.0, // tokens にない: 重ねる表示の札の上下の余白（edit.html の .ovl）
    tabMaxW: 280.0, // tokens にない: 見出しのタブの文字の最大の幅（「ソース: 素材名」を省く幅）
    menuW: 220.0, // tokens にない: 重ねる表示のメニューの幅
    chipPadX: 7.0, // tokens にない: 札の左右の余白（edit.html の .chip）
    kbdPadX: 5.0, // tokens にない: キーの札の左右の余白（edit.html の .kbd の padding 0 5px。縁の線は別）
    kbdGap: 6.0, // tokens にない: ボタンの文字とキーの札の間（edit.html の .btn の gap）
    kbdOpacity: 0.8, // tokens にない: ボタンの中のキーの札の不透明度（edit.html の .btn .kbd の opacity）
    headerPadR: 6.0, // tokens にない: 見出しの帯の右の余白（edit.html の .vhead の padding-right）
    popupGap: 2.0, // tokens にない: 札・ボタンとその下に開くメニューの間
  };
  t.scale = monClampScale(scale);
  return t;
}

// tokens.json の道筋（"color.dark.bg.viewer" など）で 1 つの値を入れる。モニターが使わない道筋なら false。
export function monThemeSetPath(t: mut MonTheme, path: string, color: u32, num: f32, isColor: bool): bool {
  if (isColor) {
    switch (path) {
      case "color.dark.bg.1": t.bg1 = color; return true;
      case "color.dark.bg.2": t.bg2 = color; return true;
      case "color.dark.bg.3": t.bg3 = color; return true;
      case "color.dark.bg.4": t.bg4 = color; return true;
      case "color.dark.bg.viewer": t.bgViewer = color; return true;
      case "color.dark.bg.popover": t.bgPopover = color; return true;
      case "color.dark.viewerChoices.black": t.viewerBlack = color; return true;
      case "color.dark.viewerChoices.midGray": t.viewerMidGray = color; return true;
      case "color.dark.viewerChoices.ui": t.viewerUi = color; return true;
      case "color.dark.line.default": t.line = color; return true;
      case "color.dark.line.strong": t.lineStrong = color; return true;
      case "color.dark.line.control": t.lineControl = color; return true;
      case "color.dark.text.1": t.text1 = color; return true;
      case "color.dark.text.2": t.text2 = color; return true;
      case "color.dark.text.3": t.text3 = color; return true;
      case "color.dark.text.disabled": t.textDis = color; return true;
      case "color.dark.text.onDark": t.textOnDark = color; return true;
      case "color.dark.text.onRipple": t.textOnRipple = color; return true;
      case "color.dark.text.onOverwrite": t.textOnOverwrite = color; return true;
      case "color.dark.accent.default": t.accent = color; return true;
      case "color.dark.accent.hover": t.accentHover = color; return true;
      case "color.dark.semantic.playhead": t.playhead = color; return true;
      case "color.dark.semantic.playheadEdge": t.playheadEdge = color; return true;
      case "color.dark.semantic.ripple": t.ripple = color; return true;
      case "color.dark.semantic.rippleTint": t.rippleTint = color; return true;
      case "color.dark.semantic.overwrite": t.overwrite = color; return true;
      case "color.dark.semantic.overwriteTint": t.overwriteTint = color; return true;
      case "color.dark.semantic.ok": t.ok = color; return true;
      case "color.dark.semantic.warn": t.warn = color; return true;
      case "color.dark.semantic.error": t.error = color; return true;
      case "color.dark.semantic.inOut": t.inOut = color; return true;
      case "color.dark.semantic.focusOuter": t.focusOuter = color; return true;
      case "color.dark.clip.video.mark": t.kVideo = color; return true;
      case "color.dark.clip.audio.mark": t.kAudio = color; return true;
      case "color.dark.clip.text.mark": t.kText = color; return true;
      case "color.dark.clip.image.mark": t.kImage = color; return true;
      case "color.dark.clip.color.mark": t.kColor = color; return true;
    }
    return false;
  }
  switch (path) {
    case "size.panelHeader": t.panelHeader = num; return true;
    case "size.button.sm": t.btnSm = num; return true;
    case "size.iconButton.sm": t.iconBtnSm = num; return true;
    case "size.iconButton.md": t.iconBtnMd = num; return true;
    case "size.icon.sm": t.iconSm = num; return true;
    case "size.hitTargetMin": t.hitMin = num; return true;
    case "space.1": t.sp1 = num; return true;
    case "space.2": t.sp2 = num; return true;
    case "space.3": t.sp3 = num; return true;
    case "space.4": t.sp4 = num; return true;
    case "radius.sm": t.radiusSm = num; return true;
    case "radius.md": t.radiusMd = num; return true;
    case "border.hairline": t.hairline = num; return true;
    case "border.focus": t.focusW = num; return true;
    case "font.size.xs.size": t.fsXs = num; return true;
    case "font.size.sm.size": t.fsSm = num; return true;
    case "font.size.md.size": t.fsMd = num; return true;
    case "font.size.tcM.size": t.fsTcM = num; return true;
  }
  return false;
}

// tokens.json（の中身）を読み直して t に入れる。入れた値の数を返す。
export function monThemeFromTokens(t: mut MonTheme, json: string): i32 {
  let n = 0;
  for (const v of monTokensFlatten(json)) {
    if (monThemeSetPath(mut t, v.path, v.color, v.num, v.isColor)) {
      n++;
    }
  }
  return n;
}
