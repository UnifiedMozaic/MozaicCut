// tokens.json の道筋（color.dark.semantic.playhead など）で 1 つの値を設定する。分からない道筋なら false。
export function tlTokSet(t: mut TlTok, path: string, color: u32, num: f32, isColor: bool): bool {
  if (isColor) {
    switch (path) {
      case "color.dark.bg.0": t.bg0 = color; return true;
      case "color.dark.bg.1": t.bg1 = color; return true;
      case "color.dark.bg.2": t.bg2 = color; return true;
      case "color.dark.bg.3": t.bg3 = color; return true;
      case "color.dark.bg.4": t.bg4 = color; return true;
      case "color.dark.bg.viewer": t.bgViewer = color; return true;
      case "color.dark.bg.popover": t.bgPopover = color; return true;
      case "color.dark.viewerChoices.black": t.viewerChoicesBlack = color; return true;
      case "color.dark.viewerChoices.midGray": t.viewerChoicesMidGray = color; return true;
      case "color.dark.viewerChoices.ui": t.viewerChoicesUi = color; return true;
      case "color.dark.viewerChoices.default": t.viewerChoicesDefault = color; return true;
      case "color.dark.line.default": t.lineDefault = color; return true;
      case "color.dark.line.strong": t.lineStrong = color; return true;
      case "color.dark.line.control": t.lineControl = color; return true;
      case "color.dark.text.1": t.text1 = color; return true;
      case "color.dark.text.2": t.text2 = color; return true;
      case "color.dark.text.3": t.text3 = color; return true;
      case "color.dark.text.disabled": t.textDisabled = color; return true;
      case "color.dark.text.onLight": t.textOnLight = color; return true;
      case "color.dark.text.onDark": t.textOnDark = color; return true;
      case "color.dark.text.onAccent": t.textOnAccent = color; return true;
      case "color.dark.text.onAi": t.textOnAi = color; return true;
      case "color.dark.text.onError": t.textOnError = color; return true;
      case "color.dark.text.onWarn": t.textOnWarn = color; return true;
      case "color.dark.text.onRipple": t.textOnRipple = color; return true;
      case "color.dark.text.onOverwrite": t.textOnOverwrite = color; return true;
      case "color.dark.text.onOk": t.textOnOk = color; return true;
      case "color.dark.accent.default": t.accentDefault = color; return true;
      case "color.dark.accent.hover": t.accentHover = color; return true;
      case "color.dark.accent.tint": t.accentTint = color; return true;
      case "color.dark.accent.tintSolid": t.accentTintSolid = color; return true;
      case "color.dark.selection.clipInner": t.selectionClipInner = color; return true;
      case "color.dark.selection.clipOuter": t.selectionClipOuter = color; return true;
      case "color.dark.selection.list": t.selectionList = color; return true;
      case "color.dark.semantic.playhead": t.semanticPlayhead = color; return true;
      case "color.dark.semantic.playheadEdge": t.semanticPlayheadEdge = color; return true;
      case "color.dark.semantic.ripple": t.semanticRipple = color; return true;
      case "color.dark.semantic.rippleTint": t.semanticRippleTint = color; return true;
      case "color.dark.semantic.overwrite": t.semanticOverwrite = color; return true;
      case "color.dark.semantic.overwriteTint": t.semanticOverwriteTint = color; return true;
      case "color.dark.semantic.ok": t.semanticOk = color; return true;
      case "color.dark.semantic.okTint": t.semanticOkTint = color; return true;
      case "color.dark.semantic.warn": t.semanticWarn = color; return true;
      case "color.dark.semantic.warnTint": t.semanticWarnTint = color; return true;
      case "color.dark.semantic.error": t.semanticError = color; return true;
      case "color.dark.semantic.errorTint": t.semanticErrorTint = color; return true;
      case "color.dark.semantic.ai": t.semanticAi = color; return true;
      case "color.dark.semantic.aiTint": t.semanticAiTint = color; return true;
      case "color.dark.semantic.textSource": t.semanticTextSource = color; return true;
      case "color.dark.semantic.textSourceTint": t.semanticTextSourceTint = color; return true;
      case "color.dark.semantic.reference": t.semanticReference = color; return true;
      case "color.dark.semantic.referenceTint": t.semanticReferenceTint = color; return true;
      case "color.dark.semantic.volumeLine": t.semanticVolumeLine = color; return true;
      case "color.dark.semantic.hatchNeutral": t.semanticHatchNeutral = color; return true;
      case "color.dark.semantic.inOut": t.semanticInOut = color; return true;
      case "color.dark.semantic.inOutLane": t.semanticInOutLane = color; return true;
      case "color.dark.semantic.pastEnd": t.semanticPastEnd = color; return true;
      case "color.dark.semantic.focusOuter": t.semanticFocusOuter = color; return true;
      case "color.dark.clip.video.mark": t.clipVideoMark = color; return true;
      case "color.dark.clip.video.face": t.clipVideoFace = color; return true;
      case "color.dark.clip.video.faceSelected": t.clipVideoFaceSelected = color; return true;
      case "color.dark.clip.video.text": t.clipVideoText = color; return true;
      case "color.dark.clip.audio.mark": t.clipAudioMark = color; return true;
      case "color.dark.clip.audio.face": t.clipAudioFace = color; return true;
      case "color.dark.clip.audio.faceSelected": t.clipAudioFaceSelected = color; return true;
      case "color.dark.clip.audio.text": t.clipAudioText = color; return true;
      case "color.dark.clip.audio.wave": t.clipAudioWave = color; return true;
      case "color.dark.clip.text.mark": t.clipTextMark = color; return true;
      case "color.dark.clip.text.face": t.clipTextFace = color; return true;
      case "color.dark.clip.text.faceSelected": t.clipTextFaceSelected = color; return true;
      case "color.dark.clip.text.text": t.clipTextText = color; return true;
      case "color.dark.clip.image.mark": t.clipImageMark = color; return true;
      case "color.dark.clip.image.face": t.clipImageFace = color; return true;
      case "color.dark.clip.image.faceSelected": t.clipImageFaceSelected = color; return true;
      case "color.dark.clip.image.text": t.clipImageText = color; return true;
      case "color.dark.clip.color.mark": t.clipColorMark = color; return true;
      case "color.dark.clip.color.face": t.clipColorFace = color; return true;
      case "color.dark.clip.color.faceSelected": t.clipColorFaceSelected = color; return true;
      case "color.dark.clip.color.text": t.clipColorText = color; return true;
      case "color.dark.clip.subText": t.clipSubText = color; return true;
      case "color.dark.clip.tagBg": t.clipTagBg = color; return true;
      case "color.dark.label.orange.value": t.labelOrangeValue = color; return true;
      case "color.dark.label.sky.value": t.labelSkyValue = color; return true;
      case "color.dark.label.green.value": t.labelGreenValue = color; return true;
      case "color.dark.label.yellow.value": t.labelYellowValue = color; return true;
      case "color.dark.label.blue.value": t.labelBlueValue = color; return true;
      case "color.dark.label.vermilion.value": t.labelVermilionValue = color; return true;
      case "color.dark.label.purple.value": t.labelPurpleValue = color; return true;
      case "color.dark.label.gray.value": t.labelGrayValue = color; return true;
      case "color.dark.meter.low": t.meterLow = color; return true;
      case "color.dark.meter.mid": t.meterMid = color; return true;
      case "color.dark.meter.high": t.meterHigh = color; return true;
      case "shadow.popover.css": t.shadowPopover = color; return true;
      case "color.dark.timeline.lockStripe": t.timelineLockStripe = color; return true;
      case "color.dark.timeline.fadeShade": t.timelineFadeShade = color; return true;
