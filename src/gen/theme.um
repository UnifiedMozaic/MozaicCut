    case 68: return c.clipTextFace;
    case 69: return c.clipTextFaceSelected;
    case 70: return c.clipTextText;
    case 71: return c.clipImageMark;
    case 72: return c.clipImageFace;
    case 73: return c.clipImageFaceSelected;
    case 74: return c.clipImageText;
    case 75: return c.clipColorMark;
    case 76: return c.clipColorFace;
    case 77: return c.clipColorFaceSelected;
    case 78: return c.clipColorText;
    case 79: return c.clipSubText;
    case 80: return c.clipTagBg;
    case 81: return c.labelOrange;
    case 82: return c.labelSky;
    case 83: return c.labelGreen;
    case 84: return c.labelYellow;
    case 85: return c.labelBlue;
    case 86: return c.labelVermilion;
    case 87: return c.labelPurple;
    case 88: return c.labelGray;
    case 89: return c.meterLow;
    case 90: return c.meterMid;
    case 91: return c.meterHigh;
  }
  return 0;
}

// ---- ラベルの色（名前つき。利用者が名前を付け替えられる）----
export const TH_LABEL_ORANGE: i32 = 0;
export const TH_LABEL_SKY: i32 = 1;
export const TH_LABEL_GREEN: i32 = 2;
export const TH_LABEL_YELLOW: i32 = 3;
export const TH_LABEL_BLUE: i32 = 4;
export const TH_LABEL_VERMILION: i32 = 5;
export const TH_LABEL_PURPLE: i32 = 6;
export const TH_LABEL_GRAY: i32 = 7;
export const TH_LABEL_COUNT: i32 = 8;
export function thLabelKey(i: i32): string {
  switch (i) {
    case 0: return "orange";
    case 1: return "sky";
    case 2: return "green";
    case 3: return "yellow";
    case 4: return "blue";
    case 5: return "vermilion";
    case 6: return "purple";
    case 7: return "gray";
  }
  return "";
}

export function thLabelName(i: i32): string {
  switch (i) {
    case 0: return "橙";
    case 1: return "空色";
    case 2: return "緑";
    case 3: return "黄";
    case 4: return "青";
    case 5: return "朱";
    case 6: return "赤紫";
    case 7: return "灰";
  }
  return "";
}

export function thLabelNameEn(i: i32): string {
  switch (i) {
    case 0: return "Orange";
    case 1: return "Sky";
    case 2: return "Green";
    case 3: return "Yellow";
    case 4: return "Blue";
    case 5: return "Vermilion";
    case 6: return "Purple";
    case 7: return "Gray";
  }
  return "";
}

export function thLabelColor(c: ThColors, i: i32): u32 {
  switch (i) {
    case 0: return c.labelOrange;
    case 1: return c.labelSky;
    case 2: return c.labelGreen;
    case 3: return c.labelYellow;
    case 4: return c.labelBlue;
    case 5: return c.labelVermilion;
    case 6: return c.labelPurple;
    case 7: return c.labelGray;
  }
  return c.text3;
}

// ラベルの色の上に載せる文字の色
export function thLabelInk(c: ThColors, i: i32): u32 {
  switch (i) {
    case 0: return c.labelOrangeInk;
    case 1: return c.labelSkyInk;
    case 2: return c.labelGreenInk;
    case 3: return c.labelYellowInk;
    case 4: return c.labelBlueInk;
    case 5: return c.labelVermilionInk;
    case 6: return c.labelPurpleInk;
    case 7: return c.labelGrayInk;
  }
  return c.text1;
}

// ---- クリップの種類の色（上の辺の mark・面・選んだ面・文字）----
export const TH_CLIP_VIDEO: i32 = 0;
export const TH_CLIP_AUDIO: i32 = 1;
export const TH_CLIP_TEXT: i32 = 2;
export const TH_CLIP_IMAGE: i32 = 3;
export const TH_CLIP_COLOR: i32 = 4;
export const TH_CLIP_COUNT: i32 = 5;
export function thClipKey(i: i32): string {
  switch (i) {
    case 0: return "video";
    case 1: return "audio";
    case 2: return "text";
    case 3: return "image";
    case 4: return "color";
  }
  return "";
}

export function thClipMark(c: ThColors, kind: i32): u32 {
  switch (kind) {
    case 0: return c.clipVideoMark;
    case 1: return c.clipAudioMark;
    case 2: return c.clipTextMark;
    case 3: return c.clipImageMark;
    case 4: return c.clipColorMark;
  }
  return c.clipVideoMark;
}

export function thClipFace(c: ThColors, kind: i32): u32 {
  switch (kind) {
    case 0: return c.clipVideoFace;
    case 1: return c.clipAudioFace;
    case 2: return c.clipTextFace;
    case 3: return c.clipImageFace;
    case 4: return c.clipColorFace;
  }
  return c.clipVideoFace;
}

export function thClipFaceSelected(c: ThColors, kind: i32): u32 {
  switch (kind) {
    case 0: return c.clipVideoFaceSelected;
    case 1: return c.clipAudioFaceSelected;
    case 2: return c.clipTextFaceSelected;
    case 3: return c.clipImageFaceSelected;
    case 4: return c.clipColorFaceSelected;
  }
  return c.clipVideoFaceSelected;
}

export function thClipText(c: ThColors, kind: i32): u32 {
  switch (kind) {
    case 0: return c.clipVideoText;
    case 1: return c.clipAudioText;
    case 2: return c.clipTextText;
    case 3: return c.clipImageText;
    case 4: return c.clipColorText;
  }
  return c.clipVideoText;
}

// ---- テーマ（倍率を掛けた画素の値と、明るさ・強調の色を当てた色）----
export struct ThTheme {
  mode: i32;
  scale: f32;
  brightness: i32;     // TH_BRIGHT_MIN〜TH_BRIGHT_MAX
  accentChoice: i32;   // TH_ACCENT_*
  reduceMotion: bool;
  c: ThColors;
  space: i32[7];   // TH_SPACE_0〜（倍率を掛けた画素）
  topBar: i32;
  rail: i32;
  panelHeader: i32;
  tabBar: i32;
  statusBar: i32;
  timelineToolbar: i32;
  ruler: i32;
  trackHeader: i32;
  meter: i32;
  scrollbar: i32;
  propertyRow: i32;
  propertyLabel: i32;
  field: i32;
  fieldDialog: i32;
  buttonSm: i32;
  buttonMd: i32;
  buttonLg: i32;
  iconButtonSm: i32;
  iconButtonMd: i32;
  hitTargetMin: i32;
  iconSm: i32;
  iconMd: i32;
  logo: i32;
  trackHeightDefaultVideoMain: i32;
  trackHeightDefaultAudio: i32;
  trackHeightDefaultVideoOther: i32;
  trackHeightDefaultText: i32;
  trackHeightVolumeLineMin: i32;
  trackHeightWaveformMin: i32;
  trackHeightThumbnailMin: i32;
  panelDefaultLeft: i32;
  panelDefaultRight: i32;
  panelMinLeft: i32;
  panelMinRight: i32;
  panelMinMonitorW: i32;
  panelMinMonitorH: i32;
  panelMinTimelineH: i32;
  panelMaxLeft: i32;
  panelMaxRight: i32;
  twoMonitorsMinWidth: i32;
  exportLeft: i32;
  exportRight: i32;
  startLeft: i32;
  startDrop: i32;
  startCardThumb: i32;
  radiusNone: i32;
  radiusSm: i32;
  radiusMd: i32;
  radiusLg: i32;
  radiusPill: i32;
  borderHairline: i32;   // 線（整数の画素に吸着）
  borderFocus: i32;   // 線（整数の画素に吸着）
  borderSelection: i32;   // 線（整数の画素に吸着）
  borderTrimRoller: i32;   // 線（整数の画素に吸着）
  borderFocusOffset: i32;   // 線（整数の画素に吸着）
  borderLabelEdge: i32;   // 線（整数の画素に吸着）
  borderPlayheadEdge: i32;   // 線（整数の画素に吸着）
  shadowPopoverX: i32;
  shadowPopoverY: i32;
  shadowPopoverBlur: i32;
  shadowPopoverSpread: i32;
  shadowPopoverColor: u32;
  hatchPeriod: i32;
  dashOn: i32;
  dashOff: i32;
  ts: f32[10];       // 文字の大きさ（em の画素。TH_TS_* の番号）
  tsLineH: i32[10];  // 行の高さ（画素）
  durInstant: i32;   // ms
  durHover: i32;   // ms
  durPress: i32;   // ms
  durTooltipDelay: i32;   // ms
  durMenuIn: i32;   // ms
  durMenuOut: i32;   // ms
  durPanel: i32;   // ms
  durDialog: i32;   // ms
  durRippleClose: i32;   // ms
  durRejectReturn: i32;   // ms
  durSnapIndicator: i32;   // ms
  durChangeHighlight: i32;   // ms
  durToastIn: i32;   // ms
  durToastHold: i32;   // ms
  durToastHoldWithUndo: i32;   // ms
  durSpinnerDelay: i32;   // ms
  durProgressDelay: i32;   // ms
  durAiPulse: i32;   // ms
}

// 寸法を倍率で画素に（四捨五入）。
export function thPxAt(v: i32, scale: f32): i32 {
  return Math.floor((v as f32) * scale + 0.5) as i32;
}

// 線の太さを倍率で画素に（四捨五入して 1 以上。1px の線は 125% で 1px、150% で 2px）。
export function thLineAt(v: i32, scale: f32): i32 {
  if (v <= 0) {
    return 0;
  }
  return Math.max(Math.floor((v as f32) * scale + 0.5) as i32, 1);
}

export function thPx(t: ThTheme, v: i32): i32 {
  return thPxAt(v, t.scale);
}

export function thLine(t: ThTheme, v: i32): i32 {
  return thLineAt(v, t.scale);
}

// 倍率を tokens.json の範囲に収め、刻みにそろえる。
export function thClampScale(s: f32): f32 {
  const c = Math.min(Math.max(s, TH_SCALE_MIN), TH_SCALE_MAX);
  return (Math.floor(c / TH_SCALE_STEP + 0.5) as f32) * TH_SCALE_STEP;
}

// R=G=B の灰色を d だけ明るく（負なら暗く）。不透明度は保つ。
export function thShiftGray(c: u32, d: i32): u32 {
  const a = (c >> 24) & 255;
  const r = Math.min(Math.max((((c >> 16) & 255) as i32) + d, 0), 255) as u32;
  const g = Math.min(Math.max((((c >> 8) & 255) as i32) + d, 0), 255) as u32;
  const b = Math.min(Math.max(((c & 255) as i32) + d, 0), 255) as u32;
  return (a << 24) | (r << 16) | (g << 8) | b;
}

// テーマを作る。mode: TH_MODE_*、scale: UI の倍率（TH_SCALE_MIN〜MAX に収める）、brightness: 明るさの段、
// accent: 強調の色（TH_ACCENT_*）、reduceMotion: 動きを減らす。倍率や設定が変わったら作り直す。
export function thMake(mode: i32, scale: f32, brightness: i32, accent: i32, reduceMotion: bool): ThTheme {
  const s = Math.min(Math.max(scale, TH_SCALE_MIN), TH_SCALE_MAX);
  const br = Math.min(Math.max(brightness, TH_BRIGHT_MIN), TH_BRIGHT_MAX);
  let ac = accent;
  if (ac < 0 || ac >= TH_ACCENT_COUNT) {
    ac = TH_ACCENT_DEFAULT;
  }
  let c = thColors(mode);
  const d = br * TH_BRIGHT_STEP_RGB;
  if (d != 0) {
    c.bg0 = thShiftGray(c.bg0, d);
    c.bg1 = thShiftGray(c.bg1, d);
    c.bg2 = thShiftGray(c.bg2, d);
    c.bg3 = thShiftGray(c.bg3, d);
    c.bg4 = thShiftGray(c.bg4, d);
    c.bgViewer = thShiftGray(c.bgViewer, d);
    c.bgPopover = thShiftGray(c.bgPopover, d);
    c.line = thShiftGray(c.line, d);
    c.lineStrong = thShiftGray(c.lineStrong, d);
    c.lineControl = thShiftGray(c.lineControl, d);
    c.text2 = thShiftGray(c.text2, d);
    c.text3 = thShiftGray(c.text3, d);
  }
  c.accent = TH_ACCENT_VALUE[ac as usize];
  c.accentHover = TH_ACCENT_HOVER[ac as usize];
  c.accentTint = TH_ACCENT_TINT[ac as usize];
  c.accentTintSolid = TH_ACCENT_TINT_SOLID[ac as usize];
  let t: ThTheme = {
    mode, scale: s, brightness: br, accentChoice: ac, reduceMotion, c,
    space: [thPxAt(TH_SPACE_0, s), thPxAt(TH_SPACE_1, s), thPxAt(TH_SPACE_2, s), thPxAt(TH_SPACE_3, s), thPxAt(TH_SPACE_4, s), thPxAt(TH_SPACE_5, s), thPxAt(TH_SPACE_6, s)],
    topBar: thPxAt(TH_SIZE_TOP_BAR, s),
    rail: thPxAt(TH_SIZE_RAIL, s),
    panelHeader: thPxAt(TH_SIZE_PANEL_HEADER, s),
    tabBar: thPxAt(TH_SIZE_TAB_BAR, s),
    statusBar: thPxAt(TH_SIZE_STATUS_BAR, s),
    timelineToolbar: thPxAt(TH_SIZE_TIMELINE_TOOLBAR, s),
    ruler: thPxAt(TH_SIZE_RULER, s),
    trackHeader: thPxAt(TH_SIZE_TRACK_HEADER, s),
    meter: thPxAt(TH_SIZE_METER, s),
    scrollbar: thPxAt(TH_SIZE_SCROLLBAR, s),
    propertyRow: thPxAt(TH_SIZE_PROPERTY_ROW, s),
    propertyLabel: thPxAt(TH_SIZE_PROPERTY_LABEL, s),
    field: thPxAt(TH_SIZE_FIELD, s),
    fieldDialog: thPxAt(TH_SIZE_FIELD_DIALOG, s),
    buttonSm: thPxAt(TH_SIZE_BUTTON_SM, s),
    buttonMd: thPxAt(TH_SIZE_BUTTON_MD, s),
    buttonLg: thPxAt(TH_SIZE_BUTTON_LG, s),
    iconButtonSm: thPxAt(TH_SIZE_ICON_BUTTON_SM, s),
    iconButtonMd: thPxAt(TH_SIZE_ICON_BUTTON_MD, s),
    hitTargetMin: thPxAt(TH_SIZE_HIT_TARGET_MIN, s),
    iconSm: thPxAt(TH_SIZE_ICON_SM, s),
    iconMd: thPxAt(TH_SIZE_ICON_MD, s),
    logo: thPxAt(TH_SIZE_LOGO, s),
    trackHeightDefaultVideoMain: thPxAt(TH_SIZE_TRACK_HEIGHT_DEFAULT_VIDEO_MAIN, s),
    trackHeightDefaultAudio: thPxAt(TH_SIZE_TRACK_HEIGHT_DEFAULT_AUDIO, s),
    trackHeightDefaultVideoOther: thPxAt(TH_SIZE_TRACK_HEIGHT_DEFAULT_VIDEO_OTHER, s),
    trackHeightDefaultText: thPxAt(TH_SIZE_TRACK_HEIGHT_DEFAULT_TEXT, s),
    trackHeightVolumeLineMin: thPxAt(TH_SIZE_TRACK_HEIGHT_VOLUME_LINE_MIN, s),
    trackHeightWaveformMin: thPxAt(TH_SIZE_TRACK_HEIGHT_WAVEFORM_MIN, s),
    trackHeightThumbnailMin: thPxAt(TH_SIZE_TRACK_HEIGHT_THUMBNAIL_MIN, s),
    panelDefaultLeft: thPxAt(TH_SIZE_PANEL_DEFAULT_LEFT, s),
    panelDefaultRight: thPxAt(TH_SIZE_PANEL_DEFAULT_RIGHT, s),
    panelMinLeft: thPxAt(TH_SIZE_PANEL_MIN_LEFT, s),
    panelMinRight: thPxAt(TH_SIZE_PANEL_MIN_RIGHT, s),
    panelMinMonitorW: thPxAt(TH_SIZE_PANEL_MIN_MONITOR_W, s),
    panelMinMonitorH: thPxAt(TH_SIZE_PANEL_MIN_MONITOR_H, s),
    panelMinTimelineH: thPxAt(TH_SIZE_PANEL_MIN_TIMELINE_H, s),
    panelMaxLeft: thPxAt(TH_SIZE_PANEL_MAX_LEFT, s),
    panelMaxRight: thPxAt(TH_SIZE_PANEL_MAX_RIGHT, s),
    twoMonitorsMinWidth: thPxAt(TH_SIZE_TWO_MONITORS_MIN_WIDTH, s),
    exportLeft: thPxAt(TH_SIZE_EXPORT_LEFT, s),
    exportRight: thPxAt(TH_SIZE_EXPORT_RIGHT, s),
    startLeft: thPxAt(TH_SIZE_START_LEFT, s),
    startDrop: thPxAt(TH_SIZE_START_DROP, s),
    startCardThumb: thPxAt(TH_SIZE_START_CARD_THUMB, s),
    radiusNone: thPxAt(TH_RADIUS_NONE, s),
    radiusSm: thPxAt(TH_RADIUS_SM, s),
    radiusMd: thPxAt(TH_RADIUS_MD, s),
    radiusLg: thPxAt(TH_RADIUS_LG, s),
    radiusPill: thPxAt(TH_RADIUS_PILL, s),
    borderHairline: thLineAt(TH_BORDER_HAIRLINE, s),
    borderFocus: thLineAt(TH_BORDER_FOCUS, s),
    borderSelection: thLineAt(TH_BORDER_SELECTION, s),
    borderTrimRoller: thLineAt(TH_BORDER_TRIM_ROLLER, s),
    borderFocusOffset: thLineAt(TH_BORDER_FOCUS_OFFSET, s),
    borderLabelEdge: thLineAt(TH_BORDER_LABEL_EDGE, s),
    borderPlayheadEdge: thLineAt(TH_BORDER_PLAYHEAD_EDGE, s),
    shadowPopoverX: thPxAt(TH_SHADOW_POPOVER_X, s),
    shadowPopoverY: thPxAt(TH_SHADOW_POPOVER_Y, s),
    shadowPopoverBlur: thPxAt(TH_SHADOW_POPOVER_BLUR, s),
    shadowPopoverSpread: thPxAt(TH_SHADOW_POPOVER_SPREAD, s),
    shadowPopoverColor: TH_SHADOW_POPOVER_COLOR,
    hatchPeriod: thPxAt(TH_HATCH_PERIOD, s),
    dashOn: thLineAt(TH_DASH_ON, s),
    dashOff: thLineAt(TH_DASH_OFF, s),
    ts: [TH_TS_SIZE[0] * s, TH_TS_SIZE[1] * s, TH_TS_SIZE[2] * s, TH_TS_SIZE[3] * s, TH_TS_SIZE[4] * s, TH_TS_SIZE[5] * s, TH_TS_SIZE[6] * s, TH_TS_SIZE[7] * s, TH_TS_SIZE[8] * s, TH_TS_SIZE[9] * s],
    tsLineH: [thPxAt(TH_TS_LINE_H[0], s), thPxAt(TH_TS_LINE_H[1], s), thPxAt(TH_TS_LINE_H[2], s), thPxAt(TH_TS_LINE_H[3], s), thPxAt(TH_TS_LINE_H[4], s), thPxAt(TH_TS_LINE_H[5], s), thPxAt(TH_TS_LINE_H[6], s), thPxAt(TH_TS_LINE_H[7], s), thPxAt(TH_TS_LINE_H[8], s), thPxAt(TH_TS_LINE_H[9], s)],
    durInstant: thDurAt(TH_DUR_INSTANT, reduceMotion),
    durHover: thDurAt(TH_DUR_HOVER, reduceMotion),
    durPress: thDurAt(TH_DUR_PRESS, reduceMotion),
    durTooltipDelay: TH_DUR_TOOLTIP_DELAY,
    durMenuIn: thDurAt(TH_DUR_MENU_IN, reduceMotion),
    durMenuOut: thDurAt(TH_DUR_MENU_OUT, reduceMotion),
    durPanel: thDurAt(TH_DUR_PANEL, reduceMotion),
    durDialog: thDurAt(TH_DUR_DIALOG, reduceMotion),
    durRippleClose: thDurAt(TH_DUR_RIPPLE_CLOSE, reduceMotion),
    durRejectReturn: thDurAt(TH_DUR_REJECT_RETURN, reduceMotion),
    durSnapIndicator: thDurAt(TH_DUR_SNAP_INDICATOR, reduceMotion),
    durChangeHighlight: thDurAt(TH_DUR_CHANGE_HIGHLIGHT, reduceMotion),
    durToastIn: TH_DUR_TOAST_IN,
    durToastHold: TH_DUR_TOAST_HOLD,
    durToastHoldWithUndo: TH_DUR_TOAST_HOLD_WITH_UNDO,
    durSpinnerDelay: TH_DUR_SPINNER_DELAY,
    durProgressDelay: TH_DUR_PROGRESS_DELAY,
    durAiPulse: thDurAt(TH_DUR_AI_PULSE, reduceMotion),
  };
  return t;
}

// 既定の設定（暗い、明るさ 0、既定の強調の色、動きはふつう）で、倍率だけを決めて作る。
export function thMakeDefault(scale: f32): ThTheme {
  return thMake(TH_MODE_DEFAULT, scale, 0, TH_ACCENT_DEFAULT, false);
}

function thDurAt(ms: i32, reduce: bool): i32 {
  if (reduce) {
    return 0;
  }
  return ms;
}

// 曲線 kind（TH_EASE_*）で、時間の割合 x（0〜1）を進み具合（0〜1）にする。
export function thEase(kind: i32, x0: f32): f32 {
  const x = Math.min(Math.max(x0, 0.0), 1.0);
  if (kind < 0 || kind >= 3) {
    return x;
  }
  const k = (kind * 4) as usize;
  const x1 = TH_EASE_BEZIER[k];
  const y1 = TH_EASE_BEZIER[k + 1];
  const x2 = TH_EASE_BEZIER[k + 2];
  const y2 = TH_EASE_BEZIER[k + 3];
  // x(u) = x を u について二分法で解き、y(u) を返す
  let lo: f32 = 0.0;
  let hi: f32 = 1.0;
  let u: f32 = x;
  for (let i = 0; i < 24; i++) {
    u = (lo + hi) * 0.5;
    const v = 1.0 - u;
    const bx = 3.0 * v * v * u * x1 + 3.0 * v * u * u * x2 + u * u * u;
    if (bx < x) {
      lo = u;
    } else {
      hi = u;
    }
  }
  const v = 1.0 - u;
  return 3.0 * v * v * u * y1 + 3.0 * v * u * u * y2 + u * u * u;
}

// 動きの途中の割合（0〜1）。t0 から dur ms の動き（dur が 0 なら 1）。now と t0 は秒。
export function thProgress(now: f64, t0: f64, durMs: i32, kind: i32): f32 {
  if (durMs <= 0) {
    return 1.0;
  }
  const x = ((now - t0) * 1000.0 / (durMs as f64)) as f32;
  return thEase(kind, x);
}
