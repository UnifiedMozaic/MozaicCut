// モードの色の表（明るさ・強調の色を当てる前）。
export function thColors(mode: i32): ThColors {
  return thColorsDark();
}

// ---- 色の一覧（見本・コントラストの試し用）。key は tokens.json の color.<mode> の下の道筋 ----
export const TH_COLOR_COUNT: i32 = 92;
export function thColorKey(i: i32): string {
  switch (i) {
    case 0: return "bg.0";
    case 1: return "bg.1";
    case 2: return "bg.2";
    case 3: return "bg.3";
    case 4: return "bg.4";
    case 5: return "bg.viewer";
    case 6: return "bg.popover";
    case 7: return "viewerChoices.black";
    case 8: return "viewerChoices.midGray";
    case 9: return "viewerChoices.ui";
    case 10: return "viewerChoices.default";
    case 11: return "line.default";
    case 12: return "line.strong";
    case 13: return "line.control";
    case 14: return "text.1";
    case 15: return "text.2";
    case 16: return "text.3";
    case 17: return "text.disabled";
    case 18: return "text.onLight";
    case 19: return "text.onDark";
    case 20: return "text.onAccent";
    case 21: return "text.onAi";
    case 22: return "text.onError";
    case 23: return "text.onWarn";
    case 24: return "text.onRipple";
    case 25: return "text.onOverwrite";
    case 26: return "text.onOk";
    case 27: return "accent.default";
    case 28: return "accent.hover";
    case 29: return "accent.tint";
    case 30: return "accent.tintSolid";
    case 31: return "selection.clipInner";
    case 32: return "selection.clipOuter";
    case 33: return "selection.list";
    case 34: return "semantic.playhead";
    case 35: return "semantic.playheadEdge";
    case 36: return "semantic.ripple";
    case 37: return "semantic.rippleTint";
    case 38: return "semantic.overwrite";
    case 39: return "semantic.overwriteTint";
    case 40: return "semantic.ok";
    case 41: return "semantic.okTint";
    case 42: return "semantic.warn";
    case 43: return "semantic.warnTint";
    case 44: return "semantic.error";
    case 45: return "semantic.errorTint";
    case 46: return "semantic.ai";
    case 47: return "semantic.aiTint";
    case 48: return "semantic.textSource";
    case 49: return "semantic.textSourceTint";
    case 50: return "semantic.reference";
    case 51: return "semantic.referenceTint";
    case 52: return "semantic.volumeLine";
    case 53: return "semantic.hatchNeutral";
    case 54: return "semantic.inOut";
    case 55: return "semantic.inOutLane";
    case 56: return "semantic.pastEnd";
    case 57: return "semantic.focusOuter";
    case 58: return "clip.video.mark";
    case 59: return "clip.video.face";
    case 60: return "clip.video.faceSelected";
    case 61: return "clip.video.text";
    case 62: return "clip.audio.mark";
    case 63: return "clip.audio.face";
    case 64: return "clip.audio.faceSelected";
    case 65: return "clip.audio.text";
    case 66: return "clip.audio.wave";
    case 67: return "clip.text.mark";
    case 68: return "clip.text.face";
    case 69: return "clip.text.faceSelected";
    case 70: return "clip.text.text";
    case 71: return "clip.image.mark";
    case 72: return "clip.image.face";
    case 73: return "clip.image.faceSelected";
    case 74: return "clip.image.text";
    case 75: return "clip.color.mark";
    case 76: return "clip.color.face";
    case 77: return "clip.color.faceSelected";
    case 78: return "clip.color.text";
    case 79: return "clip.subText";
    case 80: return "clip.tagBg";
    case 81: return "label.orange";
    case 82: return "label.sky";
    case 83: return "label.green";
    case 84: return "label.yellow";
    case 85: return "label.blue";
    case 86: return "label.vermilion";
    case 87: return "label.purple";
    case 88: return "label.gray";
    case 89: return "meter.low";
    case 90: return "meter.mid";
    case 91: return "meter.high";
  }
  return "";
}

export function thColorAt(c: ThColors, i: i32): u32 {
  switch (i) {
