  bgPopover: u32;   // bg.popover
  viewerChoicesBlack: u32;   // viewerChoices.black
  viewerChoicesMidGray: u32;   // viewerChoices.midGray
  viewerChoicesUi: u32;   // viewerChoices.ui
  viewerChoices: u32;   // viewerChoices.default
  line: u32;   // line.default
  lineStrong: u32;   // line.strong
  lineControl: u32;   // line.control
  text1: u32;   // text.1
  text2: u32;   // text.2
  text3: u32;   // text.3
  textDisabled: u32;   // text.disabled
  textOnLight: u32;   // text.onLight
  textOnDark: u32;   // text.onDark
  textOnAccent: u32;   // text.onAccent
  textOnAi: u32;   // text.onAi
  textOnError: u32;   // text.onError
  textOnWarn: u32;   // text.onWarn
  textOnRipple: u32;   // text.onRipple
  textOnOverwrite: u32;   // text.onOverwrite
  textOnOk: u32;   // text.onOk
  accent: u32;   // accent.default
  accentHover: u32;   // accent.hover
  accentTint: u32;   // accent.tint
  accentTintSolid: u32;   // accent.tintSolid
  selectionClipInner: u32;   // selection.clipInner
  selectionClipOuter: u32;   // selection.clipOuter
  selectionList: u32;   // selection.list
  playhead: u32;   // semantic.playhead
  playheadEdge: u32;   // semantic.playheadEdge
  ripple: u32;   // semantic.ripple
  rippleTint: u32;   // semantic.rippleTint
  overwrite: u32;   // semantic.overwrite
  overwriteTint: u32;   // semantic.overwriteTint
  ok: u32;   // semantic.ok
  okTint: u32;   // semantic.okTint
  warn: u32;   // semantic.warn
  warnTint: u32;   // semantic.warnTint
  error: u32;   // semantic.error
  errorTint: u32;   // semantic.errorTint
  ai: u32;   // semantic.ai
  aiTint: u32;   // semantic.aiTint
  textSource: u32;   // semantic.textSource
  textSourceTint: u32;   // semantic.textSourceTint
  reference: u32;   // semantic.reference
  referenceTint: u32;   // semantic.referenceTint
  volumeLine: u32;   // semantic.volumeLine
  hatchNeutral: u32;   // semantic.hatchNeutral
  inOut: u32;   // semantic.inOut
  inOutLane: u32;   // semantic.inOutLane
  pastEnd: u32;   // semantic.pastEnd
  focusOuter: u32;   // semantic.focusOuter
  clipVideoMark: u32;   // clip.video.mark
  clipVideoFace: u32;   // clip.video.face
  clipVideoFaceSelected: u32;   // clip.video.faceSelected
  clipVideoText: u32;   // clip.video.text
  clipAudioMark: u32;   // clip.audio.mark
  clipAudioFace: u32;   // clip.audio.face
  clipAudioFaceSelected: u32;   // clip.audio.faceSelected
  clipAudioText: u32;   // clip.audio.text
  clipAudioWave: u32;   // clip.audio.wave
  clipTextMark: u32;   // clip.text.mark
  clipTextFace: u32;   // clip.text.face
  clipTextFaceSelected: u32;   // clip.text.faceSelected
  clipTextText: u32;   // clip.text.text
  clipImageMark: u32;   // clip.image.mark
  clipImageFace: u32;   // clip.image.face
  clipImageFaceSelected: u32;   // clip.image.faceSelected
  clipImageText: u32;   // clip.image.text
  clipColorMark: u32;   // clip.color.mark
  clipColorFace: u32;   // clip.color.face
  clipColorFaceSelected: u32;   // clip.color.faceSelected
  clipColorText: u32;   // clip.color.text
  clipSubText: u32;   // clip.subText
  clipTagBg: u32;   // clip.tagBg
  labelOrange: u32;   // label.orange
  labelSky: u32;   // label.sky
  labelGreen: u32;   // label.green
  labelYellow: u32;   // label.yellow
  labelBlue: u32;   // label.blue
  labelVermilion: u32;   // label.vermilion
  labelPurple: u32;   // label.purple
  labelGray: u32;   // label.gray
  meterLow: u32;   // meter.low
  meterMid: u32;   // meter.mid
  meterHigh: u32;   // meter.high
  labelOrangeInk: u32;   // label.orange の上の文字（輝度で黒か白）
  labelSkyInk: u32;   // label.sky の上の文字（輝度で黒か白）
  labelGreenInk: u32;   // label.green の上の文字（輝度で黒か白）
  labelYellowInk: u32;   // label.yellow の上の文字（輝度で黒か白）
  labelBlueInk: u32;   // label.blue の上の文字（輝度で黒か白）
  labelVermilionInk: u32;   // label.vermilion の上の文字（輝度で黒か白）
  labelPurpleInk: u32;   // label.purple の上の文字（輝度で黒か白）
  labelGrayInk: u32;   // label.gray の上の文字（輝度で黒か白）
}

