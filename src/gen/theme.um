// 生成物: tools/gen-theme.mjs が docs/design/tokens.json から作る。手で書き換えない（tokens.json を直して作り直す）。
// 値の意味は docs/design/ui.md の 17〜20 章。大きさの定数は倍率 1.0 の論理 px、ThTheme の値は倍率を掛けた画素。
// 色は 0xAARRGGBB。

export const TH_TOKENS_VERSION: i32 = 2;

// ---- モード（暗い ／ 明るい）----
export const TH_MODE_DARK: i32 = 0;
export const TH_MODE_LIGHT: i32 = 1;
// tokens.json に color.light があるか。ないときは thColors(TH_MODE_LIGHT) も暗いテーマを返す。
export const TH_HAS_LIGHT: bool = false;
export const TH_MODE_DEFAULT: i32 = TH_MODE_DARK;

// ---- UI の倍率（OS の倍率 × 利用者の倍率）----
export const TH_SCALE_MIN: f32 = 0.8;
export const TH_SCALE_MAX: f32 = 2.0;
export const TH_SCALE_STEP: f32 = 0.1;

// ---- 明るさ（bg.*・line.*・text.2・text.3 の R=G=B をまとめて上下させる段）----
export const TH_BRIGHT_MIN: i32 = -2;
export const TH_BRIGHT_MAX: i32 = 2;
export const TH_BRIGHT_STEP_RGB: i32 = 4;

