export function thTsKey(i: i32): string {
  switch (i) {
    case 0: return "xs";
    case 1: return "sm";
    case 2: return "md";
    case 3: return "lg";
    case 4: return "xl";
    case 5: return "tcL";
    case 6: return "tcM";
    case 7: return "tcXL";
    case 8: return "code";
    case 9: return "codeSm";
  }
  return "";
}

// 段階の使いどころ（tokens.json の use）
export function thTsUse(i: i32): string {
  switch (i) {
    case 0: return "ルーラーの数字・キーの刻印・クリップの札・メーターの数字。英数字だけ（和文は不可）";
    case 1: return "クリップ名・表の行・ツールチップ・状態の帯・タブ・補足の和文（和文の最小）";
    case 2: return "本文・メニュー・ボタン（基準）";
    case 3: return "パネルの見出し・ダイアログの見出し";
    case 4: return "スタート画面・空の状態の見出し";
    case 5: return "タイムラインの現在の時刻";
    case 6: return "モニターの時刻";
    case 7: return "トリムの変化の量";
    case 8: return ".mzc の行・op の文・ID";
    case 9: return "履歴の op の文・補足（英数字だけ）";
  }
  return "";
}

// ---- 色の表 ----
export struct ThColors {
  bg0: u32;   // bg.0
  bg1: u32;   // bg.1
  bg2: u32;   // bg.2
  bg3: u32;   // bg.3
  bg4: u32;   // bg.4
