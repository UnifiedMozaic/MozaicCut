// @effect hostmz "ホストの試験（.mzplug への書き出し）"
// @param gain 1 0..4 "赤の倍率"
// @param soft 0.05 0..1 "使わない"
// @alias hostmz_alias
// @reach gain 2

kernel function hostmz(i: u32, out: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  const c = out[i];
  const a = src[i + 1];
  out[i] = vec4(c.x * p[0], a.y, Math.sin(0.0), (i % w) as f32);
}
