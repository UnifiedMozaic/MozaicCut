// @effect posterize "色の階調を減らす（ポスタリゼーション）"
// @param levels 5 2..32 "1 色あたりの段の数（小数は四捨五入）"
// @param gamma 1.6 0.25..4 "段の分け方（1 で等間隔。大きいほど暗い所の段が細かくなる）"
// @param dither 0 0..1 "格子状のディザの強さ（段の境目を点の混ぜ方でなめらかに見せる）"
// @param mix 1 0..1 "元の色との混ぜ具合（1 で段だけ、0 で元のまま）"
// @alias poster
// @whole
//
// 各色（r, g, b）を、ガンマで曲げてから levels 段に丸め、曲げ戻す。dither を上げると、4×4 の Bayer の格子で
// 丸める境目をずらすので、段の数が少なくても階調があるように見える（格子は層の左上を基準にするので @whole）。
// アルファは変えない。

const POSTERIZE_BAYER: f32[16] = [
  0.0, 8.0, 2.0, 10.0,
  12.0, 4.0, 14.0, 6.0,
  3.0, 11.0, 1.0, 9.0,
  15.0, 7.0, 13.0, 5.0,
];

// 1 つの色を n 段に丸める。d はディザのずらし（-0.5〜0.5 の段の割合）。
kernel function posterizeChannel(v: f32, n: f32, g: f32, d: f32): f32 {
  const t = Math.pow(Math.clamp(v, 0.0, 1.0), 1.0 / g);
  const q = Math.clamp(Math.floor(t * (n - 1.0) + 0.5 + d), 0.0, n - 1.0) / (n - 1.0);
  return Math.pow(q, g);
}

kernel function posterize(i: u32, out: mut Buffer<vec4<f32>>, w: u32, p: f32[8]): void {
  const c = out[i];
  const n = Math.max(Math.floor(p[0] + 0.5), 2.0);
  const g = Math.max(p[1], 0.01);
  const bx = (i % w) & 3;
  const by = (i / w) & 3;
  const d = ((POSTERIZE_BAYER[by * 4 + bx] + 0.5) / 16.0 - 0.5) * p[2];
  const r = posterizeChannel(c.x, n, g, d);
  const gg = posterizeChannel(c.y, n, g, d);
  const b = posterizeChannel(c.z, n, g, d);
  const k = p[3];
  out[i] = vec4(Math.mix(c.x, r, k), Math.mix(c.y, gg, k), Math.mix(c.z, b, k), c.w);
}
