// 例のエフェクト（src/effects/fxs/effects/*.um）の試験。作業ツリーの根で実行する:
//
//   node <UM>/src/cli.ts build src/effects/fxs/test_effects.um --target host -o fxs_effects && ./fxs_effects
//   ./fxs_effects um-out <フォルダ>    UM 本体でコンパイルできる形（fxsUmSource）にして書き出す
//
// どれも fxsCompile で誤りも警告もなく通り、@effect の名前がファイル名と同じで、@param が 1〜8 個あることを確かめる。
// 画像に掛けて見た目を確かめるには fxs_shots.um を使う（docs/effect-script.md の「例のエフェクトを試す」）。

import { fxsDiagText } from "./ir.um";
import { fxsCompile } from "./check.um";
import { fxsUmSource } from "./umsrc.um";

export function fxsEffectNames(): string[] {
  return ["chroma", "crt", "edges", "glitch", "glow", "grain", "halftone", "kaleido", "posterize", "ripple"];
}

export function main(): i32 {
  const av = args();
  const names = fxsEffectNames();
  let fails = 0;
  for (let k: usize = 0; k < names.length; k++) {
    const path = "src/effects/fxs/effects/" + names[k] + ".um";
    const b = readFile(path);
    if (b == null) {
      print("NG: 読めません: " + path);
      fails++;
      continue;
    }
    const src = stringFromBytes(b);
    const ck = fxsCompile(src);
    for (let j: usize = 0; j < ck.diags.length; j++) {
      print(fxsDiagText(path, ck.diags[j]));
    }
    if (!ck.ok || ck.diags.length > 0) {
      print("NG: " + path + " に診断があります");
      fails++;
    }
    if (ck.decl.name != names[k]) {
      print("NG: " + path + " の @effect の名前がファイル名と違います: " + ck.decl.name);
      fails++;
    }
    if (ck.decl.params.length < 1 || ck.decl.params.length > 8) {
      print(`NG: ${path} の @param が ${ck.decl.params.length} 個です`);
      fails++;
    }
    let uses = "";
    if (ck.ir.usesSrc) {
      uses = uses + " src";
    }
    if (ck.ir.usesSrc2) {
      uses = uses + " src2";
    }
    if (ck.ir.usesTime) {
      uses = uses + " time";
    }
    print(`${names[k]}: 引数 ${ck.decl.params.length} 個、関数 ${ck.ir.fns.length} 個、式 ${ck.ir.exprs.length} 個、使う入力:${uses}`);
    if (av.length >= 2 && av[0] == "um-out") {
      const um = fxsUmSource(src);
      let bytes: u8[] = [];
      for (let j: usize = 0; j < um.length; j++) {
        bytes.push(um[j]);
      }
      makeDir(av[1]);
      const out = av[1] + "/" + names[k] + ".um";
      if (!writeFile(out, bytes)) {
        print("NG: 書けません: " + out);
        fails++;
      }
    }
  }
  if (fails > 0) {
    print(`合わなかったもの: ${fails}`);
    return 1;
  }
  print("ok");
  return 0;
}
