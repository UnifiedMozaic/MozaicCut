// バイクアッド（2 次の IIR フィルタ）。係数は RBJ の Audio EQ Cookbook の式。
// 音は f32 のステレオ（L, R, L, R, ...）の配列。内部の状態と計算は f64。
// 処理は 1 標本ずつの決まった順（転置直接形 II）なので、何標本ずつに分けて渡しても結果は同じ。
import { DSP_TWO_PI, dspSin, dspCos, dspExp, dspLn, dspGainToDb } from "./math.um";

export const DSP_BQ_LOWPASS: i32 = 0;
export const DSP_BQ_HIGHPASS: i32 = 1;
export const DSP_BQ_BANDPASS: i32 = 2;
export const DSP_BQ_NOTCH: i32 = 3;
export const DSP_BQ_PEAK: i32 = 4;
export const DSP_BQ_LOWSHELF: i32 = 5;
export const DSP_BQ_HIGHSHELF: i32 = 6;
export const DSP_BQ_ALLPASS: i32 = 7;

// 非正規数を避けるため、状態の絶対値がこれ未満なら 0 にする（1 標本ごと。分け方によらない）。
const DSPBQ_TINY: f64 = 1.0e-200;

export struct DspBiquad {
  kind: i32;
  b0: f64;
  b1: f64;
  b2: f64;
  a1: f64;
  a2: f64;
  // 状態（チャンネルごとに 2 つ）
  zl1: f64;
  zl2: f64;
  zr1: f64;
  zr2: f64;
  // NaN や無限大で状態を 0 に戻した回数（異常の知らせ。JSON と文で出す）
  resets: i64;
}

// 種類の名前（JSON と人向けの文で使う）。
export function dspBiquadKindName(kind: i32): string {
  switch (kind) {
    case DSP_BQ_LOWPASS:
      return "lowpass";
    case DSP_BQ_HIGHPASS:
      return "highpass";
    case DSP_BQ_BANDPASS:
      return "bandpass";
    case DSP_BQ_NOTCH:
      return "notch";
    case DSP_BQ_PEAK:
      return "peak";
    case DSP_BQ_LOWSHELF:
      return "lowshelf";
    case DSP_BQ_HIGHSHELF:
      return "highshelf";
    case DSP_BQ_ALLPASS:
      return "allpass";
  }
  return "unknown";
}

export function dspBiquadKindJa(kind: i32): string {
  switch (kind) {
    case DSP_BQ_LOWPASS:
      return "低域通過";
    case DSP_BQ_HIGHPASS:
      return "高域通過";
    case DSP_BQ_BANDPASS:
      return "帯域通過";
    case DSP_BQ_NOTCH:
      return "ノッチ";
    case DSP_BQ_PEAK:
      return "ピーク";
    case DSP_BQ_LOWSHELF:
      return "低域シェルフ";
    case DSP_BQ_HIGHSHELF:
      return "高域シェルフ";
    case DSP_BQ_ALLPASS:
      return "全域通過";
  }
  return "不明";
}

// 名前から種類を引く。知らない名前は -1。
export function dspBiquadKindFromName(name: string): i32 {
  for (let k: i32 = 0; k <= DSP_BQ_ALLPASS; k++) {
    if (dspBiquadKindName(k) == name) {
      return k;
    }
  }
  return -1;
}

// 素通し（y = x）のフィルタ。
export function dspBiquadIdentity(): DspBiquad {
  return { kind: DSP_BQ_PEAK, b0: 1.0, b1: 0.0, b2: 0.0, a1: 0.0, a2: 0.0, zl1: 0.0, zl2: 0.0, zr1: 0.0, zr2: 0.0, resets: 0 };
}

// 係数を設計する（状態はそのまま。動かしながら変えても音が途切れない）。
// freq は Hz（1 Hz 〜 rate の 0.499 倍に収める）、q は Q 値（0.025 以上）、gainDb はピークとシェルフだけが使う。
// シェルフの q は RBJ の Q（0.7071 で最も急で段のない形）。
export function dspBiquadDesign(bq: mut DspBiquad, kind: i32, freq: f64, q: f64, gainDb: f64, rate: f64): void {
  const f = Math.min(Math.max(freq, 1.0), rate * 0.499);
  const qq = Math.max(q, 0.025);
  const w0 = DSP_TWO_PI * f / rate;
  const cw = dspCos(w0);
  const sw = dspSin(w0);
  const alpha = sw / (2.0 * qq);
  const A = dspExp(gainDb * (dspLn(10.0) / 40.0));
  let b0: f64 = 1.0;
  let b1: f64 = 0.0;
  let b2: f64 = 0.0;
  let a0: f64 = 1.0;
  let a1: f64 = 0.0;
  let a2: f64 = 0.0;
  if (kind == DSP_BQ_LOWPASS) {
    b0 = (1.0 - cw) * 0.5;
    b1 = 1.0 - cw;
    b2 = (1.0 - cw) * 0.5;
    a0 = 1.0 + alpha;
    a1 = -2.0 * cw;
    a2 = 1.0 - alpha;
  } else if (kind == DSP_BQ_HIGHPASS) {
    b0 = (1.0 + cw) * 0.5;
    b1 = -(1.0 + cw);
    b2 = (1.0 + cw) * 0.5;
    a0 = 1.0 + alpha;
    a1 = -2.0 * cw;
    a2 = 1.0 - alpha;
  } else if (kind == DSP_BQ_BANDPASS) {
    // ピークの利得が 0 dB の形
    b0 = alpha;
    b1 = 0.0;
    b2 = -alpha;
    a0 = 1.0 + alpha;
    a1 = -2.0 * cw;
    a2 = 1.0 - alpha;
  } else if (kind == DSP_BQ_NOTCH) {
    b0 = 1.0;
    b1 = -2.0 * cw;
    b2 = 1.0;
    a0 = 1.0 + alpha;
    a1 = -2.0 * cw;
    a2 = 1.0 - alpha;
  } else if (kind == DSP_BQ_PEAK) {
    b0 = 1.0 + alpha * A;
    b1 = -2.0 * cw;
    b2 = 1.0 - alpha * A;
    a0 = 1.0 + alpha / A;
    a1 = -2.0 * cw;
    a2 = 1.0 - alpha / A;
  } else if (kind == DSP_BQ_LOWSHELF) {
    const sa = 2.0 * Math.sqrt(A) * alpha;
    b0 = A * ((A + 1.0) - (A - 1.0) * cw + sa);
    b1 = 2.0 * A * ((A - 1.0) - (A + 1.0) * cw);
    b2 = A * ((A + 1.0) - (A - 1.0) * cw - sa);
    a0 = (A + 1.0) + (A - 1.0) * cw + sa;
    a1 = -2.0 * ((A - 1.0) + (A + 1.0) * cw);
    a2 = (A + 1.0) + (A - 1.0) * cw - sa;
  } else if (kind == DSP_BQ_HIGHSHELF) {
    const sa = 2.0 * Math.sqrt(A) * alpha;
    b0 = A * ((A + 1.0) + (A - 1.0) * cw + sa);
    b1 = -2.0 * A * ((A - 1.0) + (A + 1.0) * cw);
    b2 = A * ((A + 1.0) + (A - 1.0) * cw - sa);
    a0 = (A + 1.0) - (A - 1.0) * cw + sa;
    a1 = 2.0 * ((A - 1.0) - (A + 1.0) * cw);
    a2 = (A + 1.0) - (A - 1.0) * cw - sa;
  } else if (kind == DSP_BQ_ALLPASS) {
    b0 = 1.0 - alpha;
    b1 = -2.0 * cw;
    b2 = 1.0 + alpha;
    a0 = 1.0 + alpha;
    a1 = -2.0 * cw;
    a2 = 1.0 - alpha;
  }
  bq.kind = kind;
  bq.b0 = b0 / a0;
  bq.b1 = b1 / a0;
  bq.b2 = b2 / a0;
  bq.a1 = a1 / a0;
  bq.a2 = a2 / a0;
}

// 係数を直接決める（a0 = 1 に正規化済みのもの）。
export function dspBiquadSetCoefs(bq: mut DspBiquad, b0: f64, b1: f64, b2: f64, a1: f64, a2: f64): void {
  bq.b0 = b0;
  bq.b1 = b1;
  bq.b2 = b2;
  bq.a1 = a1;
  bq.a2 = a2;
}

export function dspBiquadNew(kind: i32, freq: f64, q: f64, gainDb: f64, rate: f64): DspBiquad {
  let bq = dspBiquadIdentity();
  dspBiquadDesign(mut bq, kind, freq, q, gainDb, rate);
  return bq;
}

export function dspBiquadReset(bq: mut DspBiquad): void {
  bq.zl1 = 0.0;
  bq.zl2 = 0.0;
  bq.zr1 = 0.0;
  bq.zr2 = 0.0;
}

// ステレオ（L, R 交互）の buf の frame0 から frames フレームをその場で処理する。
export function dspBiquadProcess(bq: mut DspBiquad, buf: mut f32[], frame0: usize, frames: usize): void {
  const b0 = bq.b0;
  const b1 = bq.b1;
  const b2 = bq.b2;
  const a1 = bq.a1;
  const a2 = bq.a2;
  let zl1 = bq.zl1;
  let zl2 = bq.zl2;
  let zr1 = bq.zr1;
  let zr2 = bq.zr2;
  let k = frame0 * 2;
  const end = (frame0 + frames) * 2;
  while (k < end) {
    const xl = buf[k] as f64;
    const yl = b0 * xl + zl1;
    zl1 = b1 * xl - a1 * yl + zl2;
    zl2 = b2 * xl - a2 * yl;
    zl1 = Math.abs(zl1) < DSPBQ_TINY ? 0.0 : zl1;
    zl2 = Math.abs(zl2) < DSPBQ_TINY ? 0.0 : zl2;
    buf[k] = yl as f32;
    const xr = buf[k + 1] as f64;
    const yr = b0 * xr + zr1;
    zr1 = b1 * xr - a1 * yr + zr2;
    zr2 = b2 * xr - a2 * yr;
    zr1 = Math.abs(zr1) < DSPBQ_TINY ? 0.0 : zr1;
    zr2 = Math.abs(zr2) < DSPBQ_TINY ? 0.0 : zr2;
    buf[k + 1] = yr as f32;
    k += 2;
  }
  // NaN や無限大が入って状態が有限でなくなったら、0 に戻す（以後ずっと NaN を出し続けないように）。
  // そのかたまりの出力は NaN を含むが、次のかたまりからは元に戻る。
  if (!dspbqFinite(zl1 + zl2 + zr1 + zr2)) {
    zl1 = 0.0;
    zl2 = 0.0;
    zr1 = 0.0;
    zr2 = 0.0;
    bq.resets += 1;
  }
  bq.zl1 = zl1;
  bq.zl2 = zl2;
  bq.zr1 = zr1;
  bq.zr2 = zr2;
}

// 有限か（NaN と無限大は false）
export function dspbqFinite(v: f64): bool {
  return Math.abs(v) <= 1.0e300;
}

// 1 チャンネル（f64 の配列）を処理する。解析（ラウドネス、話し声の検出）で使う。状態は L の側を使う。
export function dspBiquadProcessMono64(bq: mut DspBiquad, buf: mut f64[], start: usize, count: usize): void {
  const b0 = bq.b0;
  const b1 = bq.b1;
  const b2 = bq.b2;
  const a1 = bq.a1;
  const a2 = bq.a2;
  let z1 = bq.zl1;
  let z2 = bq.zl2;
  for (let k = start; k < start + count; k++) {
    const x = buf[k];
    const y = b0 * x + z1;
    z1 = b1 * x - a1 * y + z2;
    z2 = b2 * x - a2 * y;
    z1 = Math.abs(z1) < DSPBQ_TINY ? 0.0 : z1;
    z2 = Math.abs(z2) < DSPBQ_TINY ? 0.0 : z2;
    buf[k] = y;
  }
  if (!dspbqFinite(z1 + z2)) {
    z1 = 0.0;
    z2 = 0.0;
    bq.resets += 1;
  }
  bq.zl1 = z1;
  bq.zl2 = z2;
}

// 周波数 freq での振幅の応答（dB）。EQ の曲線を画面に描くのに使う。
export function dspBiquadMagDb(bq: DspBiquad, freq: f64, rate: f64): f64 {
  const w = DSP_TWO_PI * freq / rate;
  const c1 = dspCos(w);
  const s1 = dspSin(w);
  const c2 = dspCos(2.0 * w);
  const s2 = dspSin(2.0 * w);
  // H = (b0 + b1 e^-jw + b2 e^-2jw) / (1 + a1 e^-jw + a2 e^-2jw)
  const nr = bq.b0 + bq.b1 * c1 + bq.b2 * c2;
  const ni = -(bq.b1 * s1 + bq.b2 * s2);
  const dr = 1.0 + bq.a1 * c1 + bq.a2 * c2;
  const di = -(bq.a1 * s1 + bq.a2 * s2);
  const num = nr * nr + ni * ni;
  const den = dr * dr + di * di;
  if (den <= 0.0) {
    return 0.0;
  }
  return dspGainToDb(Math.sqrt(num / den));
}
