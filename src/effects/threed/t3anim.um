// 3D の値の時間変化（キーフレーム）の「仮の実装」。
//
// キーフレームの書き方の正本は m6-anim（src/effects/anim/anim.um）で、ここはその書き方の一部だけを読む。
// m6-anim を組み込んだら、T3Track を AnimTrack に、t3ParseTrack を animParse + animResolve に、
// t3TrackEval / t3TrackEvalC を animEvalNum / animEval に置き換える（3D の部品がトラックに触るのは、
// このファイルの t3TrackEval・t3TrackEvalC・t3TrackSet・t3TrackMoves・t3TrackAnyAbove の 5 つだけ）。
//
// 書き方（m6-anim と同じ。空白で区切るので .mzc では "..." で囲む）:
//   ry=30                      値だけ
//   ry="0@0 90@2 90@3"         値@時刻 を空白で並べる（時刻はクリップの始まりからの秒。1:02.5 も可）
//   ry="0@0:hold 90@1"         キーの後ろに :印。いまは linear（既定）と hold だけ
//   anchor="0,0@0 40,-20@1"    2 次元の値は x,y
// m6-anim にあってここにないもの（ease などの補間の印、45f のようなコマ、end からの時刻）は、
// m6-anim と同じ診断の code（anim-bad-interp / anim-bad-time）で「組み込むまで使えない」と返す。

// 値の形
export const T3V_NUM: i32 = 1;     // 数
export const T3V_VEC2: i32 = 2;    // x,y
export const T3V_SCALE: i32 = 3;   // 数か x,y（数は縦横同じ）

export struct T3Track {
  // 成分の数（1 か 2）。キーがなければ 0
  dims: i32;
  // キーの時刻（昇順）と値（キー k の成分 c は vs[k * dims + c]）
  ts: f64[];
  vs: f64[];
  // キーの出側をホールドするか（次のキーまで値を保つ）
  hold: bool[];
  // 値だけ（@ のない書き方）
  stat: bool;
}

// 読み取りの誤り。code が "" なら正しい。warn は誤りではなく注意（読んだトラックは使える）。
export struct T3TrackErr {
  code: string;
  msg: string;
  hint: string;
  warn: bool;
}

export function t3TrackEmpty(): T3Track {
  return { dims: 0, ts: [], vs: [], hold: [], stat: false };
}

export function t3TrackConst(v: f64): T3Track {
  return { dims: 1, ts: [0.0], vs: [v], hold: [false], stat: true };
}

export function t3TrackClone(t: T3Track): T3Track {
  return { dims: t.dims, ts: t.ts.clone(), vs: t.vs.clone(), hold: t.hold.clone(), stat: t.stat };
}

// 書いてあるか（書いていなければ既定値を使う）
export function t3TrackSet(t: T3Track): bool {
  return t.ts.length > 0;
}

// 時刻で値が変わるか（モーションブラーの判断に使う）。
export function t3TrackMoves(t: T3Track): bool {
  if (t.dims <= 0) {
    return false;
  }
  const d = t.dims as usize;
  for (let i: usize = d; i < t.vs.length; i++) {
    if (t.vs[i] != t.vs[i % d]) {
      return true;
    }
  }
  return false;
}

// 成分 c のどれかのキーの値が x より大きいか。
export function t3TrackAnyAbove(t: T3Track, c: i32, x: f64): bool {
  for (let k: usize = 0; k < t.ts.length; k++) {
    if (t3TrackVal(t, k, c) > x) {
      return true;
    }
  }
  return false;
}

function t3TrackVal(t: T3Track, k: usize, c: i32): f64 {
  const d = t.dims as usize;
  if (c > 0 && d >= 2) {
    return t.vs[k * d + (c as usize)];
  }
  return t.vs[k * d];
}

// 時刻 time の成分 c の値（成分が 1 つのトラックは、どの成分も同じ値）。書いていなければ def。
export function t3TrackEvalC(t: T3Track, time: f64, c: i32, def: f64): f64 {
  const n = t.ts.length;
  if (n == 0) {
    return def;
  }
  if (time <= t.ts[0]) {
    return t3TrackVal(t, 0, c);
  }
  if (time >= t.ts[n - 1]) {
    return t3TrackVal(t, n - 1, c);
  }
  // 二分探索で time を挟むキー
  let lo: usize = 0;
  let hi: usize = n - 1;
  while (hi - lo > 1) {
    const mid = (lo + hi) / 2;
    if (t.ts[mid] <= time) {
      lo = mid;
    } else {
      hi = mid;
    }
  }
  const a = t3TrackVal(t, lo, c);
  if (t.hold[lo]) {
    return a;
  }
  const t0 = t.ts[lo];
  const t1 = t.ts[hi];
  const b = t3TrackVal(t, hi, c);
  if (t1 <= t0) {
    return b;
  }
  const f = (time - t0) / (t1 - t0);
  return a + (b - a) * f;
}

export function t3TrackEval(t: T3Track, time: f64, def: f64): f64 {
  return t3TrackEvalC(t, time, 0, def);
}

// ---- 数と時刻の読み取り（このモジュールだけで閉じるように自前で持つ。組み込むときは text.um の parseNum / parseTime に替える） ----

function t3Nan(): f64 {
  const z: f64 = 0.0;
  return z / z;
}

export function t3IsNan(v: f64): bool {
  return v != v;
}

function t3SubStr(s: string, a: usize, b: usize): string {
  let out: u8[] = [];
  for (let i = a; i < b && i < s.length; i++) {
    out.push(s[i]);
  }
  return stringFromBytes(out);
}

// 10 の k 乗（k <= 22 はちょうど）
function t3Pow10(k: i32): f64 {
  let v: f64 = 1;
  for (let i = 0; i < k; i++) {
    v = v * 10;
  }
  return v;
}

// 10 進の数（符号、小数点、指数）。読めなければ NaN。
// 仮数を整数で作ってから 10 の累乗で 1 回だけ掛けるか割るので、15 桁までの数は正しく丸められる（"0.3" は 0.3）。
export function t3ParseNum(s: string): f64 {
  const n = s.length;
  if (n == 0) {
    return t3Nan();
  }
  let i: usize = 0;
  let neg = false;
  if (s[0] == 45) {
    neg = true;
    i = 1;
  } else if (s[0] == 43) {
    i = 1;
  }
  let m: f64 = 0;
  let digits = 0;
  let exp10 = 0;
  while (i < n && s[i] >= 48 && s[i] <= 57) {
    m = m * 10 + ((s[i] - 48) as f64);
    i++;
    digits++;
  }
  if (i < n && s[i] == 46) {
    i++;
    while (i < n && s[i] >= 48 && s[i] <= 57) {
      m = m * 10 + ((s[i] - 48) as f64);
      exp10 = exp10 - 1;
      i++;
      digits++;
    }
  }
  if (digits == 0) {
    return t3Nan();
  }
  if (i < n && (s[i] == 101 || s[i] == 69)) {
    i++;
    let eneg = false;
    if (i < n && (s[i] == 45 || s[i] == 43)) {
      eneg = s[i] == 45;
      i++;
    }
    let e = 0;
    let ed = 0;
    while (i < n && s[i] >= 48 && s[i] <= 57) {
      if (e < 100000) {
        e = e * 10 + ((s[i] - 48) as i32);
      }
      i++;
      ed++;
    }
    if (ed == 0) {
      return t3Nan();
    }
    exp10 = eneg ? exp10 - e : exp10 + e;
  }
  if (i != n) {
    return t3Nan();
  }
  let v: f64 = 0;
  if (m == 0) {
    v = 0;
  } else if (exp10 >= 0 && exp10 <= 22) {
    v = m * t3Pow10(exp10);
  } else if (exp10 < 0 && exp10 >= -22) {
    v = m / t3Pow10(-exp10);
  } else if (exp10 > 308) {
    return t3Nan();
  } else if (exp10 > 0) {
    v = m * t3Pow10(exp10);
  } else {
    // とても小さい数（正しい丸めは保証しない）
    v = m;
    let k = -exp10;
    while (k > 22) {
      v = v / 1e22;
      k = k - 22;
    }
    v = v / t3Pow10(k);
  }
  return neg ? -v : v;
}

// 時刻: 秒（1.5）、分:秒（1:02.5）、時:分:秒。分と秒の欄は 60 未満。読めなければ NaN。負は NaN。
export function t3ParseTime(s: string): f64 {
  let parts: string[] = [];
  let start: usize = 0;
  for (let i: usize = 0; i <= s.length; i++) {
    if (i == s.length || s[i] == 58) {
      parts.push(t3SubStr(s, start, i));
      start = i + 1;
    }
  }
  if (parts.length > 3) {
    return t3Nan();
  }
  let total: f64 = 0;
  for (let k: usize = 0; k < parts.length; k++) {
    if (parts[k].length > 0 && (parts[k][0] == 45 || parts[k][0] == 43)) {
      return t3Nan();
    }
    const v = t3ParseNum(parts[k]);
    if (t3IsNan(v) || v < 0) {
      return t3Nan();
    }
    if (k > 0 && v >= 60) {
      return t3Nan();
    }
    total = total * 60 + v;
  }
  return total;
}

// ---- 読み取り ----

function t3Ok(): T3TrackErr {
  return { code: "", msg: "", hint: "", warn: false };
}

function t3Err(code: string, msg: string, hint: string): T3TrackErr {
  return { code: code.clone(), msg: msg.clone(), hint: hint.clone(), warn: false };
}

function t3IsLetter(c: u8): bool {
  return (c >= 97 && c <= 122) || (c >= 65 && c <= 90);
}

function t3IsSpace(c: u8): bool {
  return c == 32 || c == 9;
}

function t3HasByte(s: string, c: u8): bool {
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == c) {
      return true;
    }
  }
  return false;
}

export function t3ValueHint(kind: i32): string {
  if (kind == T3V_VEC2) {
    return "x,y の 2 つの数で書きます（例: 40,-20）";
  }
  if (kind == T3V_SCALE) {
    return "数か、横,縦 の 2 つの数で書きます（例: 1.5 か 1.5,0.8）";
  }
  return "数で書きます（例: 30）";
}

// 値（数か x,y）を out に足す。成分の数を返す（読めなければ 0）。
function t3ParseValue(kind: i32, s: string, out: mut f64[]): i32 {
  if (t3HasByte(s, 44)) {
    if (kind == T3V_NUM) {
      return 0;
    }
    let comma: usize = 0;
    let count = 0;
    for (let i: usize = 0; i < s.length; i++) {
      if (s[i] == 44) {
        comma = i;
        count++;
      }
    }
    if (count != 1) {
      return 0;
    }
    const a = t3ParseNum(t3SubStr(s, 0, comma));
    const b = t3ParseNum(t3SubStr(s, comma + 1, s.length));
    if (t3IsNan(a) || t3IsNan(b)) {
      return 0;
    }
    out.push(a);
    out.push(b);
    return 2;
  }
  if (kind == T3V_VEC2) {
    return 0;
  }
  const v = t3ParseNum(s);
  if (t3IsNan(v)) {
    return 0;
  }
  out.push(v);
  return 1;
}

// 補間の印（: で区切った並び。先頭の : を含む）。hold なら 1、linear だけなら 0、誤りなら -1（e に理由）。
function t3ParseTags(tags: string, e: mut T3TrackErr): i32 {
  let hold = 0;
  let start: usize = 1;
  for (let i: usize = 1; i <= tags.length; i++) {
    if (i == tags.length || tags[i] == 58) {
      const tag = t3SubStr(tags, start, i);
      start = i + 1;
      // 名前（= の前）
      let name = tag.clone();
      for (let k: usize = 0; k < tag.length; k++) {
        if (tag[k] == 61) {
          name = t3SubStr(tag, 0, k);
          break;
        }
      }
      if (tag == "linear") {
        continue;
      }
      if (tag == "hold") {
        hold = 1;
        continue;
      }
      if (name == "ease" || name == "easein" || name == "easeout" || name == "smooth" || name == "in" || name == "out"
        || name == "cubic" || name == "curve" || name == "tin" || name == "tout") {
        e.code = "anim-bad-interp";
        e.msg = `補間の印 '${tag}' は、キーフレームの部品（m6-anim）を組み込むまで 3D のキーでは使えません`;
        e.hint = "いまは linear（既定）と hold だけを書けます";
        return -1;
      }
      e.code = "anim-bad-interp";
      e.msg = `'${tag}' は補間の印ではありません`;
      e.hint = "linear か hold を書きます（例: 0@0:hold）";
      return -1;
    }
  }
  return hold;
}

// 「値」か「値@時刻[:印] 値@時刻 ...」を読む（kind は T3V_*）。
// 誤りなら code（m6-anim と同じ anim-syntax / anim-bad-value / anim-bad-time / anim-bad-interp / anim-key-overlap）と理由を返す。
// キーが時刻の順でなければ並べ替え、warn の anim-key-order を返す（m6-anim と同じ）。
export function t3ParseTrack(s: string, kind: i32, out: mut T3Track): T3TrackErr {
  out.dims = 0;
  out.ts.clear();
  out.vs.clear();
  out.hold.clear();
  out.stat = false;
  if (s.length == 0) {
    return t3Err("anim-bad-value", "値がありません", t3ValueHint(kind));
  }
  if (!t3HasByte(s, 64)) {
    let vs: f64[] = [];
    const d = t3ParseValue(kind, s, mut vs);
    if (d == 0) {
      return t3Err("anim-bad-value", `'${s}' は値として読めません`, t3ValueHint(kind));
    }
    out.dims = d;
    out.ts.push(0.0);
    out.vs = vs;
    out.hold.push(false);
    out.stat = true;
    return t3Ok();
  }
  // キーを空白で分ける
  let toks: string[] = [];
  let i: usize = 0;
  while (i < s.length) {
    while (i < s.length && t3IsSpace(s[i])) {
      i++;
    }
    const a = i;
    while (i < s.length && !t3IsSpace(s[i])) {
      i++;
    }
    if (i > a) {
      toks.push(t3SubStr(s, a, i));
    }
  }
  let keyT: f64[] = [];
  let keyV: f64[] = [];
  let keyD: i32[] = [];
  let keyH: bool[] = [];
  let dims = 1;
  for (const tok of toks) {
    let at: usize = tok.length;
    for (let k: usize = 0; k < tok.length; k++) {
      if (tok[k] == 64) {
        at = k;
        break;
      }
    }
    if (at == tok.length) {
      return t3Err("anim-syntax", `キー '${tok}' に @ がありません`,
        "キーは 値@時刻 を空白で並べて書きます（例: \"0@0 90@2\"）。コンマはキーの区切りではなく、x,y の区切りです");
    }
    const valText = t3SubStr(tok, 0, at);
    // 時刻は、次の「: の後ろが英字」の所まで（1:02.5 の : と、印の : を分ける）
    let te = at + 1;
    while (te < tok.length && !(tok[te] == 58 && te + 1 < tok.length && t3IsLetter(tok[te + 1]))) {
      te++;
    }
    const timeText = t3SubStr(tok, at + 1, te);
    const tagText = t3SubStr(tok, te, tok.length);
    let vs: f64[] = [];
    const d = t3ParseValue(kind, valText, mut vs);
    if (d == 0) {
      return t3Err("anim-bad-value", `キー '${tok}' の値 '${valText}' は読めません`, t3ValueHint(kind));
    }
    if (t3HasByte(timeText, 64) || t3HasByte(timeText, 44)) {
      return t3Err("anim-syntax", `'${tok}' はキーの区切りが読めません`,
        "キーは 値@時刻 を空白で並べて書きます（例: \"0@0 90@2\"）。コンマはキーの区切りではなく、x,y の区切りです");
    }
    if (timeText.length == 0) {
      return t3Err("anim-bad-time", `キー '${tok}' に時刻がありません`, "時刻はクリップの始まりからの秒（1.5）か 分:秒（1:02.5）で書きます");
    }
    const last = timeText[timeText.length - 1];
    if (last == 102 || (timeText.length >= 3 && timeText[0] == 101 && timeText[1] == 110 && timeText[2] == 100)) {
      return t3Err("anim-bad-time", `キー '${tok}' の時刻 '${timeText}'（コマ・end からの時刻）は、キーフレームの部品（m6-anim）を組み込むまで 3D のキーでは使えません`,
        "いまはクリップの始まりからの秒（1.5）か 分:秒（1:02.5）で書きます");
    }
    const t = t3ParseTime(timeText);
    if (t3IsNan(t)) {
      return t3Err("anim-bad-time", `キー '${tok}' の時刻 '${timeText}' は読めません`, "時刻はクリップの始まりからの秒（1.5）か 分:秒（1:02.5）で書きます");
    }
    let hold = false;
    if (tagText.length > 0) {
      let e = t3Ok();
      const h = t3ParseTags(tagText, mut e);
      if (h < 0) {
        return e;
      }
      hold = h == 1;
    }
    if (d == 2) {
      dims = 2;
    }
    keyT.push(t);
    keyD.push(d);
    keyH.push(hold);
    for (const v of vs) {
      keyV.push(v);
    }
  }
  // 成分をそろえる（scale の数だけのキーは縦横同じ）
  let flat: f64[] = [];
  let vi: usize = 0;
  for (let k: usize = 0; k < keyT.length; k++) {
    const d = keyD[k];
    if (dims == 2 && d == 1) {
      flat.push(keyV[vi]);
      flat.push(keyV[vi]);
    } else {
      for (let c = 0; c < d; c++) {
        flat.push(keyV[vi + (c as usize)]);
      }
    }
    vi = vi + (d as usize);
  }
  // 時刻の順に並べる（安定な挿入ソート）
  let order: usize[] = [];
  let sorted = true;
  for (let k: usize = 0; k < keyT.length; k++) {
    order.push(k);
    if (k > 0 && keyT[k] < keyT[k - 1]) {
      sorted = false;
    }
  }
  for (let a: usize = 1; a < order.length; a++) {
    const cur = order[a];
    let b = a;
    while (b > 0 && keyT[order[b - 1]] > keyT[cur]) {
      order[b] = order[b - 1];
      b = b - 1;
    }
    order[b] = cur;
  }
  const du = dims as usize;
  for (let a: usize = 0; a < order.length; a++) {
    const k = order[a];
    if (a > 0 && keyT[k] - out.ts[a - 1] < 1.0e-6) {
      out.ts.clear();
      out.vs.clear();
      out.hold.clear();
      return t3Err("anim-key-overlap", `時刻 ${t3NumText(keyT[k])} 秒のキーが 2 つあります`,
        "同じ時刻のキーは 1 つにします（値を急に変えたいなら、前のキーに :hold を付けます）");
    }
    out.ts.push(keyT[k]);
    out.hold.push(keyH[k]);
    for (let c: usize = 0; c < du; c++) {
      out.vs.push(flat[k * du + c]);
    }
  }
  out.dims = dims;
  if (!sorted) {
    return { code: "anim-key-order", msg: "キーが時刻の順に並んでいません（時刻の順に並べ替えて使います）",
      hint: "時刻の小さい順に書くと読みやすく、差分も小さくなります", warn: true };
  }
  return t3Ok();
}

// ---- 書き戻し ----

// 数を短く書く（10^-6 の位で丸め、余分な 0 は書かない。String は読み直すと同じ値になる最短の形）。
export function t3NumText(v: f64): string {
  const r = Math.floor(v * 1000000.0 + 0.5) / 1000000.0;
  if (r == 0) {
    return "0";
  }
  return String(r);
}

function t3KeyValText(t: T3Track, k: usize): string {
  if (t.dims == 2) {
    return t3NumText(t.vs[k * 2]) + "," + t3NumText(t.vs[k * 2 + 1]);
  }
  return t3NumText(t.vs[k]);
}

// トラックを .mzc の値に書き戻す（m6-anim と同じ書き方。空白を含むので、書く側が "..." で囲む）。
// 値だけのトラックと、時刻 0 のキー 1 つだけのトラックは値だけを書く。
export function t3TrackText(t: T3Track): string {
  if (t.ts.length == 0) {
    return "";
  }
  if (t.stat || (t.ts.length == 1 && t.ts[0] == 0 && !t.hold[0])) {
    return t3KeyValText(t, 0);
  }
  let s = "";
  let prev = "";
  for (let k: usize = 0; k < t.ts.length; k++) {
    const tt = t3NumText(t.ts[k]);
    if (k > 0 && tt == prev) {
      continue;   // 10^-6 秒より近いキーは 1 つにする（読み直すと重なりの誤りになるため）
    }
    if (k > 0) {
      s = s + " ";
    }
    s = s + t3KeyValText(t, k) + "@" + tt;
    if (t.hold[k]) {
      s = s + ":hold";
    }
    prev = tt;
  }
  return s;
}

// ---- 時刻をずらす（split の後半・trim start） ----

// キーの時刻から delta 秒を引いたトラック。0 秒より前に出たキーは消し、代わりに元の時刻 delta の値（補間した値）を
// 0 秒のキーとして先頭に置く（見た目の動きは変わらない）。値だけのトラックはそのまま。
export function t3TrackShift(t: T3Track, delta: f64): T3Track {
  if (t.stat || t.ts.length == 0) {
    return t3TrackClone(t);
  }
  let out: T3Track = { dims: t.dims, ts: [], vs: [], hold: [], stat: false };
  const du = t.dims as usize;
  let cut = false;
  let cutHold = false;
  let exactZero = false;
  for (let k: usize = 0; k < t.ts.length; k++) {
    const nt = t.ts[k] - delta;
    if (nt < -1.0e-9) {
      cut = true;
      cutHold = t.hold[k];
    } else if (Math.abs(nt) <= 1.0e-9) {
      exactZero = true;
    }
  }
  if (cut && !exactZero) {
    out.ts.push(0.0);
    for (let c = 0; c < t.dims; c++) {
      out.vs.push(t3TrackEvalC(t, delta, c, 0.0));
    }
    out.hold.push(cutHold);
  }
  for (let k: usize = 0; k < t.ts.length; k++) {
    let nt = t.ts[k] - delta;
    if (nt < -1.0e-9) {
      continue;
    }
    if (nt < 0) {
      nt = 0;
    }
    out.ts.push(nt);
    for (let c: usize = 0; c < du; c++) {
      out.vs.push(t.vs[k * du + c]);
    }
    out.hold.push(t.hold[k]);
  }
  return out;
}

// .mzc の値の文字列をずらす（読めない値・値だけの値はそのまま返す）。
export function t3ShiftText(val: string, kind: i32, delta: f64): string {
  let tr = t3TrackEmpty();
  const e = t3ParseTrack(val, kind, mut tr);
  if ((e.code != "" && !e.warn) || tr.stat) {
    return val.clone();
  }
  return t3TrackText(t3TrackShift(tr, delta));
}
