// エクスプレッション（式）: After Effects の JavaScript の代わりの、安全で小さな式の言語。
//
// - 式は 1 回だけ解析して中間の形（スタックの命令の列。ExprProg）にし、コマごとに exprEval で評価する。
// - 値の型は 3 つ: 数（EXPR_NUM）・2 次元（EXPR_VEC2）・色（EXPR_COLOR。r g b a、0〜1）。型は解析のときに決まる。
// - ループ・再帰・関数の定義はない。命令は前にしか進まないので、評価は必ず命令の数だけで終わる。
// - 誤りは Diag（project.um）の形で返す。code は expr- で始まる（docs/design/m6-expr.md の表）。
//
// 実行時の値は 4 つの f64（ExprVal）。数は 4 つとも同じ値（splat）、2 次元は x y と 0 0、色は r g b a。
// こうしておくと、足し算・掛け算などは型によらず成分ごとに計算すればよい。
import { Diag, diag } from "../../engine/project.um";
import { sub, parseNum, textCharCol, textNearest } from "../../engine/text.um";
import { exprHash, exprHashF } from "./expr_math.um";

// ---- 型・形 ----

export const EXPR_ANY: i32 = 0;
export const EXPR_NUM: i32 = 1;
export const EXPR_VEC2: i32 = 2;
export const EXPR_COLOR: i32 = 4;

// 式の使いどころ。PARAM はキーの値（x=expr("...")）、PIXEL は画素ごとの式（pixel=expr("...")。kernel で評価）。
export const EXPR_MODE_PARAM: i32 = 0;
export const EXPR_MODE_PIXEL: i32 = 1;

// 上限（越えると expr-too-complex）。画素の式の上限は kernel の固定の配列の大きさ（expr_pixel.um）と同じ。
export const EXPR_MAX_SRC: i32 = 4000;
export const EXPR_MAX_CODE: i32 = 1024;
export const EXPR_MAX_STACK: i32 = 32;
export const EXPR_MAX_LOCALS: i32 = 16;
export const EXPR_PIXEL_STACK: i32 = 16;
export const EXPR_PIXEL_LOCALS: i32 = 8;
export const EXPR_MAX_DEPTH: i32 = 48;

export struct ExprVal {
  x: f64;
  y: f64;
  z: f64;
  w: f64;
}

// キーフレーム（loopOut / loopIn / valueAtTime / key(n) が使う）。interp はこのキーから次のキーまでの補間。
export const EXPR_KEY_LINEAR: i32 = 0;
export const EXPR_KEY_HOLD: i32 = 1;
export const EXPR_KEY_EASE: i32 = 2;
export const EXPR_KEY_EASEIN: i32 = 3;
export const EXPR_KEY_EASEOUT: i32 = 4;

export struct ExprKey {
  t: f64;
  v: ExprVal;
  interp: i32;
}

// レイヤー（クリップ）の値の名前の表。names[i] は slots[i] 番の値（別名は同じ番号）、types[i] はその型。
// parts は「合成した値」の関係を 3 つずつ（合成の slot、部品の slot、合成の中の成分の番号）持つ。
// 既定では position = [x, y]（position の 0 番の成分が x、1 番が y）。評価の順（exprOrder）は、合成と部品を
// 同じ値として数え、値を書くとき（exprLayerPut）は両方を揃える。
export struct ExprEnv {
  names: string[];
  slots: i32[];
  types: i32[];
  nslots: i32;
  parts: i32[];
}

// 1 つのクリップの、いまのコマの値。vals は slot ごとに 4 つ（ExprVal の x y z w）。
export struct ExprLayer {
  id: string;
  vals: f64[];
}

// 式から見える場面: 値の名前の表、クリップの値、画面（thisComp）。
export struct ExprScene {
  env: ExprEnv;
  layers: ExprLayer[];
  compW: f64;
  compH: f64;
  compDur: f64;
  fps: f64;
}

// 1 回の評価の入力。time はタイムライン上の秒（AE と同じ。クリップの中の秒は time - inPoint）、
// value は式がないときの値（キーフレームがあればその値。位置は解いた後の画素。下の「座標」）、
// index は .mzc の行の順の番号（1 から。式の変数 index）、self は scene.layers の中の自分（thisLayer。なければ -1）。
// keys はこの値の、利用者が置いたキーフレーム（なければ空）。t はタイムラインの秒（クリップの始まり + キーの時刻）。
// numKeys / key(n) はこの keys を数える。
// curve は valueAtTime / loopOut / loopIn が値を引く表（4 つずつ。時刻 curveT0 + k * curveDt の値）。
// キーフレームの担当（m6-anim の animEval）がベジェなどを含めて求めた値を入れる（exprCtxSetCurve）。空なら keys の interp で補う。
// ExprCtx は式ごとに 1 つ作って使い回し、コマごとには time と value だけを書き換える（keys と curve を毎コマ写さない）。
export struct ExprCtx {
  time: f64;
  value: ExprVal;
  index: i32;
  self: i32;
  keys: ExprKey[];
  curve: f64[];
  curveT0: f64;
  curveDt: f64;
}

// 解析した式。code は命令（op, a, b の 3 つずつ）、consts は定数（4 つずつ）。
// refClip / refSlot は参照するクリップの値（clip('title').x。refClip が "" なら thisLayer）、refLayer は exprLink が入れる。
export struct ExprProg {
  ok: bool;
  src: string;
  type: i32;
  valueType: i32;
  mode: i32;
  code: i32[];
  consts: f64[];
  nLocals: i32;
  maxStack: i32;
  refClip: string[];
  refSlot: i32[];
  refType: i32[];
  refCol: i32[];
  refLayer: i32[];
  seed: i32;
  // 乱数と wiggle の種の、値の名前（x、y、opacity …）とクリップの ID の hash（exprSetIdentity）。
  // hasId が false（ID のないクリップ）なら、ID の代わりに ExprCtx.index を使う（行を足すと値が変わる）。
  keySeed: i32;
  idSeed: i32;
  hasId: bool;
  timeless: bool;
  usesTime: bool;
  usesKeys: bool;
  usesRefs: bool;
  usesValue: bool;
  usesRandom: bool;
  line: i32;
  col: i32;
}

// 評価の結果。bad は値が数でなくなった（0 で割った、負の数の平方根など）ので value に戻したとき。
export struct ExprResult {
  v: ExprVal;
  bad: bool;
}

// ---- 命令 ----

export const EX_PUSH: i32 = 1;
export const EX_IN: i32 = 2;
export const EX_REF: i32 = 3;
export const EX_LGET: i32 = 4;
export const EX_LSET: i32 = 5;
export const EX_NEG: i32 = 6;
export const EX_NOT: i32 = 7;
export const EX_ADD: i32 = 8;
export const EX_SUB: i32 = 9;
export const EX_MUL: i32 = 10;
export const EX_DIV: i32 = 11;
export const EX_MOD: i32 = 12;
export const EX_LT: i32 = 13;
export const EX_LE: i32 = 14;
export const EX_GT: i32 = 15;
export const EX_GE: i32 = 16;
export const EX_EQ: i32 = 17;
export const EX_NE: i32 = 18;
export const EX_AND: i32 = 19;
export const EX_OR: i32 = 20;
export const EX_SEL: i32 = 21;
export const EX_SWZ: i32 = 22;
export const EX_VEC2: i32 = 23;
export const EX_COL3: i32 = 24;
export const EX_COL4: i32 = 25;
export const EX_F1: i32 = 26;
export const EX_F2: i32 = 27;
export const EX_F3: i32 = 28;
export const EX_LEN: i32 = 29;
export const EX_DOT: i32 = 30;
export const EX_NORM: i32 = 31;
export const EX_DIST: i32 = 32;
export const EX_INTERP: i32 = 33;
export const EX_WIGGLE: i32 = 34;
export const EX_NOISE: i32 = 35;
export const EX_RAND: i32 = 36;
export const EX_LOOP: i32 = 37;
export const EX_VALAT: i32 = 38;
export const EX_KEYV: i32 = 39;
export const EX_KEYT: i32 = 40;
export const EX_NKEYS: i32 = 41;
export const EX_HSL2RGB: i32 = 42;
export const EX_RGB2HSL: i32 = 43;

// EX_IN の番号。画素の式では uni（expr_pixel.um）の同じ番号を読む（UV / PX / SRC は画素から求める）。
export const EXIN_TIME: i32 = 0;
export const EXIN_VALUE: i32 = 1;
export const EXIN_INDEX: i32 = 2;
export const EXIN_UV: i32 = 3;
export const EXIN_PX: i32 = 4;
export const EXIN_SRC: i32 = 5;
export const EXIN_COMPW: i32 = 6;
export const EXIN_COMPH: i32 = 7;
export const EXIN_COMPDUR: i32 = 8;
export const EXIN_FPS: i32 = 9;
export const EXIN_FRAMEDUR: i32 = 10;
export const EXIN_COUNT: i32 = 16;

// EX_F1 / EX_F2 / EX_F3 の関数の番号。
export const EXF1_SIN: i32 = 0;
export const EXF1_COS: i32 = 1;
export const EXF1_TAN: i32 = 2;
export const EXF1_ASIN: i32 = 3;
export const EXF1_ACOS: i32 = 4;
export const EXF1_ATAN: i32 = 5;
export const EXF1_SQRT: i32 = 6;
export const EXF1_ABS: i32 = 7;
export const EXF1_FLOOR: i32 = 8;
export const EXF1_CEIL: i32 = 9;
export const EXF1_ROUND: i32 = 10;
export const EXF1_FRACT: i32 = 11;
export const EXF1_EXP: i32 = 12;
export const EXF1_LOG: i32 = 13;
export const EXF1_SIGN: i32 = 14;
export const EXF1_D2R: i32 = 15;
export const EXF1_R2D: i32 = 16;
export const EXF2_ATAN2: i32 = 0;
export const EXF2_POW: i32 = 1;
export const EXF2_MIN: i32 = 2;
export const EXF2_MAX: i32 = 3;
export const EXF2_STEP: i32 = 4;
export const EXF3_CLAMP: i32 = 0;
export const EXF3_MIX: i32 = 1;
export const EXF3_SMOOTH: i32 = 2;

// ---- 小さな道具 ----

const EX_PI: f64 = 3.141592653589793;

function evS(v: f64): ExprVal {
  return { x: v, y: v, z: v, w: v };
}

function ev4(a: f64, b: f64, c: f64, d: f64): ExprVal {
  return { x: a, y: b, z: c, w: d };
}

export function exprNum(v: f64): ExprVal {
  return evS(v);
}

export function exprVec2(x: f64, y: f64): ExprVal {
  return ev4(x, y, 0.0, 0.0);
}

export function exprColor(r: f64, g: f64, b: f64, a: f64): ExprVal {
  return ev4(r, g, b, a);
}

function evLane(v: ExprVal, d: i32): f64 {
  if (d == 0) {
    return v.x;
  }
  if (d == 1) {
    return v.y;
  }
  if (d == 2) {
    return v.z;
  }
  return v.w;
}

function evSetLane(v: mut ExprVal, d: i32, x: f64): void {
  if (d == 0) {
    v.x = x;
  } else if (d == 1) {
    v.y = x;
  } else if (d == 2) {
    v.z = x;
  } else {
    v.w = x;
  }
}

// 型の名前（日本語）。
export function exprTypeName(t: i32): string {
  if (t == EXPR_NUM) {
    return "数";
  }
  if (t == EXPR_VEC2) {
    return "2 次元の値";
  }
  if (t == EXPR_COLOR) {
    return "色";
  }
  return "値";
}

// 型の名前（JSON 用）。
export function exprTypeKey(t: i32): string {
  if (t == EXPR_NUM) {
    return "number";
  }
  if (t == EXPR_VEC2) {
    return "vec2";
  }
  if (t == EXPR_COLOR) {
    return "color";
  }
  return "any";
}

function exFinite(v: f64): bool {
  return v == v && v < 1.0e300 && v > -1.0e300;
}

// ---- 数学（f64。CPU の値の式で使う）。どの OS でも同じ結果になるよう、自前の多項式で求める ----


function exSinPoly(r: f64): f64 {
  const r2 = r * r;
  const p = -1.0 / 6.0 + r2 * (1.0 / 120.0 + r2 * (-1.0 / 5040.0 + r2 * (1.0 / 362880.0 + r2 * (-1.0 / 39916800.0 +
    r2 * (1.0 / 6227020800.0 + r2 * (-1.0 / 1307674368000.0 + r2 * (1.0 / 355687428096000.0)))))));
  return r + r * r2 * p;
}

function exCosPoly(r: f64): f64 {
  const r2 = r * r;
  return 1.0 + r2 * (-0.5 + r2 * (1.0 / 24.0 + r2 * (-1.0 / 720.0 + r2 * (1.0 / 40320.0 + r2 * (-1.0 / 3628800.0 +
    r2 * (1.0 / 479001600.0 + r2 * (-1.0 / 87178291200.0 + r2 * (1.0 / 20922789888000.0))))))));
}

// π/2 を 23 ビットずつに分けたもの（k < 2^30 なら k * EX_PIO2_Cn は f64 で正確。引き算もほぼ正確）。
const EX_PIO2_C1: f64 = 1.57079625129699707031;
const EX_PIO2_C2: f64 = 7.54978941586159635335e-8;
const EX_PIO2_C3: f64 = 5.39030252995776476554e-15;
const EX_PIO2_C4: f64 = 3.2820035428735005e-22;
// sin / cos が正しく求まる |x| の上限。越えたら数でない値（式の結果なら value に戻して bad）。
export const EXPR_TRIG_MAX: f64 = 1.0e9;

// sin（cosq = 0）と cos（cosq = 1）。|x| ≤ 1e9 は 2π の倍数を正確に引いてから多項式で求める。
// |x| が 1e9 を越えたら数でない値にする（黙って 0 にはしない。式の評価は bad を立てて value に戻す）。
function exSinCos(x: f64, cosq: i32): f64 {
  if (!exFinite(x)) {
    return x - x;
  }
  if (x > EXPR_TRIG_MAX || x < -EXPR_TRIG_MAX) {
    const z = 0.0;
    return z / z;
  }
  const k = Math.floor(x * (2.0 / EX_PI) + 0.5);
  const r = (((x - k * EX_PIO2_C1) - k * EX_PIO2_C2) - k * EX_PIO2_C3) - k * EX_PIO2_C4;
  const q = (((k as i64) + (cosq as i64)) & 3) as i32;
  if (q == 0) {
    return exSinPoly(r);
  }
  if (q == 1) {
    return exCosPoly(r);
  }
  if (q == 2) {
    return -exSinPoly(r);
  }
  return -exCosPoly(r);
}

export function exprSin(x: f64): f64 {
  return exSinCos(x, 0);
}

export function exprCos(x: f64): f64 {
  return exSinCos(x, 1);
}

const EX_SQRT3: f64 = 1.7320508075688772;
const EX_TAN15: f64 = 0.2679491924311227;

export function exprAtan(x0: f64): f64 {
  if (x0 != x0) {
    return x0;
  }
  let x = x0;
  let neg = false;
  if (x < 0) {
    neg = true;
    x = -x;
  }
  let inv = false;
  if (x > 1.0) {
    inv = true;
    x = 1.0 / x;
  }
  let off = 0.0;
  if (x > EX_TAN15) {
    off = EX_PI / 6.0;
    x = (x * EX_SQRT3 - 1.0) / (x + EX_SQRT3);
  }
  const x2 = x * x;
  // atan(x) = x - x^3/3 + x^5/5 - ...（|x| <= tan 15°）
  let s = 0.0;
  let k = 25;
  while (k >= 3) {
    const sign = ((k - 1) / 2) % 2 == 0 ? 1.0 : -1.0;
    s = (s + sign / (k as f64)) * x2;
    k -= 2;
  }
  let r = off + x + x * s;
  if (inv) {
    r = EX_PI / 2.0 - r;
  }
  if (neg) {
    r = -r;
  }
  return r;
}

export function exprAtan2(y: f64, x: f64): f64 {
  if (x != x || y != y) {
    return x + y;
  }
  if (x > 0) {
    return exprAtan(y / x);
  }
  if (x < 0) {
    if (y >= 0) {
      return exprAtan(y / x) + EX_PI;
    }
    return exprAtan(y / x) - EX_PI;
  }
  if (y > 0) {
    return EX_PI / 2.0;
  }
  if (y < 0) {
    return -EX_PI / 2.0;
  }
  return 0.0;
}

const EX_LN2_HI: f64 = 6.93147180369123816490e-01;
const EX_LN2_LO: f64 = 1.90821492927058770002e-10;
const EX_LOG2E: f64 = 1.4426950408889634;

function exPow2i(k0: i32): f64 {
  // 2^k（k は -1074〜1023）。2 の累乗の掛け算は正確。
  let k = k0;
  let b = 2.0;
  if (k < 0) {
    k = -k;
    b = 0.5;
  }
  let p = 1.0;
  while (k > 0) {
    if ((k & 1) != 0) {
      p = p * b;
    }
    b = b * b;
    k = k >> 1;
  }
  return p;
}

export function exprExp(x: f64): f64 {
  if (x != x) {
    return x;
  }
  if (x > 709.0) {
    return 1.0e308 * 10.0;
  }
  if (x < -745.0) {
    return 0.0;
  }
  const k = Math.floor(x * EX_LOG2E + 0.5);
  const r = x - k * EX_LN2_HI - k * EX_LN2_LO;
  // e^r（|r| <= ln2/2）の Taylor 展開（14 次まで）
  let s = 1.0;
  let i = 14;
  while (i >= 1) {
    s = 1.0 + s * r / (i as f64);
    i--;
  }
  return s * exPow2i(k as i32);
}

export function exprLog(x0: f64): f64 {
  if (x0 != x0 || x0 < 0) {
    const z = 0.0;
    return z / z;
  }
  if (x0 == 0) {
    return -1.0e308 * 10.0;
  }
  if (x0 > 1.0e308) {
    return x0;
  }
  let m = x0;
  let e = 0;
  while (m >= 4294967296.0) {
    m = m * (1.0 / 4294967296.0);
    e += 32;
  }
  while (m < 1.0 / 4294967296.0) {
    m = m * 4294967296.0;
    e -= 32;
  }
  while (m >= 1.4142135623730951) {
    m = m * 0.5;
    e += 1;
  }
  while (m < 0.7071067811865476) {
    m = m * 2.0;
    e -= 1;
  }
  const s = (m - 1.0) / (m + 1.0);
  const s2 = s * s;
  // log(m) = 2 (s + s^3/3 + s^5/5 + ...)
  let t = 0.0;
  let k = 23;
  while (k >= 3) {
    t = (t + 1.0 / (k as f64)) * s2;
    k -= 2;
  }
  const lm = 2.0 * (s + s * t);
  const fe = e as f64;
  return fe * EX_LN2_HI + (lm + fe * EX_LN2_LO);
}

export function exprPow(a: f64, b: f64): f64 {
  if (b == 0) {
    return 1.0;
  }
  if (b == Math.floor(b) && b <= 64.0 && b >= -64.0) {
    let n = b as i32;
    let inv = false;
    if (n < 0) {
      inv = true;
      n = -n;
    }
    let p = 1.0;
    let base = a;
    while (n > 0) {
      if ((n & 1) != 0) {
        p = p * base;
      }
      base = base * base;
      n = n >> 1;
    }
    if (inv) {
      return 1.0 / p;
    }
    return p;
  }
  if (a < 0) {
    const z = 0.0;
    return z / z;
  }
  if (a == 0) {
    if (b > 0) {
      return 0.0;
    }
    return 1.0e308 * 10.0;
  }
  return exprExp(b * exprLog(a));
}

function exAsin(x: f64): f64 {
  if (x > 1.0 || x < -1.0) {
    const z = 0.0;
    return z / z;
  }
  return exprAtan2(x, Math.sqrt(1.0 - x * x));
}

function exF1(f: i32, x: f64): f64 {
  switch (f) {
    case EXF1_SIN:
      return exprSin(x);
    case EXF1_COS:
      return exprCos(x);
    case EXF1_TAN:
      return exprSin(x) / exprCos(x);
    case EXF1_ASIN:
      return exAsin(x);
    case EXF1_ACOS:
      return EX_PI / 2.0 - exAsin(x);
    case EXF1_ATAN:
      return exprAtan(x);
    case EXF1_SQRT:
      return Math.sqrt(x);
    case EXF1_ABS:
      return Math.abs(x);
    case EXF1_FLOOR:
      return Math.floor(x);
    case EXF1_CEIL:
      return Math.ceil(x);
    case EXF1_ROUND:
      return Math.floor(x + 0.5);
    case EXF1_FRACT:
      return x - Math.floor(x);
    case EXF1_EXP:
      return exprExp(x);
    case EXF1_LOG:
      return exprLog(x);
    case EXF1_SIGN:
      if (x > 0) {
        return 1.0;
      }
      if (x < 0) {
        return -1.0;
      }
      return 0.0;
    case EXF1_D2R:
      return x * (EX_PI / 180.0);
    case EXF1_R2D:
      return x * (180.0 / EX_PI);
    default:
      return x;
  }
}

function exF2(f: i32, a: f64, b: f64): f64 {
  switch (f) {
    case EXF2_ATAN2:
      return exprAtan2(a, b);
    case EXF2_POW:
      return exprPow(a, b);
    case EXF2_MIN:
      return Math.min(a, b);
    case EXF2_MAX:
      return Math.max(a, b);
    case EXF2_STEP:
      return b < a ? 0.0 : 1.0;
    default:
      return a;
  }
}

function exF3(f: i32, a: f64, b: f64, c: f64): f64 {
  switch (f) {
    case EXF3_CLAMP:
      return Math.min(Math.max(a, b), c);
    case EXF3_MIX:
      return a + (b - a) * c;
    case EXF3_SMOOTH: {
      if (b == a) {
        return c < a ? 0.0 : 1.0;
      }
      const u = Math.min(Math.max((c - a) / (b - a), 0.0), 1.0);
      return u * u * (3.0 - 2.0 * u);
    }
    default:
      return a;
  }
}

// 補間の曲線（u は 0〜1）。kind: 0 linear、1 ease、2 easeIn、3 easeOut。
function exCurve(kind: i32, u: f64): f64 {
  if (kind == 1) {
    return u * u * (3.0 - 2.0 * u);
  }
  if (kind == 2) {
    return u * u * (2.0 - u);
  }
  if (kind == 3) {
    return u * (1.0 + u - u * u);
  }
  return u;
}

// wiggle の揺れ（-1〜1 くらい）。格子点の乱数を Catmull-Rom の曲線でつなぐ（格子点で止まらず、なめらかに動く）。
function exWiggleNoise(x: f64, seed: u32): f64 {
  const fl = Math.floor(x);
  const i = ((fl as i64) & 0xffffffff) as u32;
  const f = x - fl;
  const p0 = (exprHashF((i - 1) ^ seed) * 2.0 - 1.0) as f64;
  const p1 = (exprHashF(i ^ seed) * 2.0 - 1.0) as f64;
  const p2 = (exprHashF((i + 1) ^ seed) * 2.0 - 1.0) as f64;
  const p3 = (exprHashF((i + 2) ^ seed) * 2.0 - 1.0) as f64;
  const f2 = f * f;
  const f3 = f2 * f;
  const v = 0.5 * ((2.0 * p1) + (p2 - p0) * f + (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * f2 + (3.0 * p1 - p0 - 3.0 * p2 + p3) * f3);
  return Math.min(Math.max(v, -1.0), 1.0);
}

// 値の雑音（-1〜1、なめらか）。格子点の値は種と格子の番号の hash。
function exNoise1(x: f64, seed: u32): f64 {
  const fl = Math.floor(x);
  const i = ((fl as i64) & 0xffffffff) as u32;
  const f = x - fl;
  const a = exprHashF(i ^ seed) * 2.0 - 1.0;
  const b = exprHashF((i + 1) ^ seed) * 2.0 - 1.0;
  const u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
  return (a as f64) + ((b - a) as f64) * u;
}

function exNoise2(x: f64, y: f64, seed: u32): f64 {
  const fx = Math.floor(x);
  const fy = Math.floor(y);
  const ix = ((fx as i64) & 0xffffffff) as u32;
  const iy = ((fy as i64) & 0xffffffff) as u32;
  const tx = x - fx;
  const ty = y - fy;
  const sy0 = exprHash(iy ^ seed);
  const sy1 = exprHash((iy + 1) ^ seed);
  const a = (exprHashF(ix ^ sy0) * 2.0 - 1.0) as f64;
  const b = (exprHashF((ix + 1) ^ sy0) * 2.0 - 1.0) as f64;
  const c = (exprHashF(ix ^ sy1) * 2.0 - 1.0) as f64;
  const d = (exprHashF((ix + 1) ^ sy1) * 2.0 - 1.0) as f64;
  const ux = tx * tx * tx * (tx * (tx * 6.0 - 15.0) + 10.0);
  const uy = ty * ty * ty * (ty * (ty * 6.0 - 15.0) + 10.0);
  const top = a + (b - a) * ux;
  const bot = c + (d - c) * ux;
  return top + (bot - top) * uy;
}

// 文字列の hash（FNV-1a を exprHash で混ぜる）。クリップの ID と値の名前を種にするのに使う。
export function exprStrHash(s: string): u32 {
  let h: u32 = 0x811c9dc5;
  for (let i: usize = 0; i < s.length; i++) {
    h = (h ^ (s[i] as u32)) * 0x01000193;
  }
  return exprHash(h);
}

// 式がどのクリップのどの値のものかを覚える（乱数と wiggle の種になる）。clipId が "" なら行の順（index）で代える。
// AE と同じく、同じクリップの x と y に同じ wiggle を書いても違う揺れになり、前に行を足しても ID のあるクリップの値は変わらない。
export function exprSetIdentity(p: mut ExprProg, clipId: string, key: string): void {
  p.keySeed = exprStrHash(key) as i32;
  p.idSeed = exprStrHash(clipId) as i32;
  p.hasId = clipId != "";
}

// 種の共通の部分（式の種 seedRandom・値の名前・クリップの ID）。salt で random と wiggle を分ける。
function exIdSeed(p: ExprProg, cx: ExprCtx, salt: u32): u32 {
  let h = exprHash((p.seed as u32) ^ salt);
  h = exprHash(h ^ (p.keySeed as u32));
  if (p.hasId) {
    h = exprHash(h ^ (p.idSeed as u32));
  } else {
    h = exprHash(h ^ (cx.index as u32) ^ 0x3c6ef372);
  }
  return h;
}

// 乱数の、呼び出しの場所の前までの種（式の種・値の名前・クリップの ID・コマの番号）。画素の式（expr_pixel.um）も使う。
export function exprRandBase(p: ExprProg, cx: ExprCtx, fps: f64): u32 {
  let h = exIdSeed(p, cx, 0x9e3779b9);
  if (!p.timeless) {
    const fr = Math.floor(cx.time * fps + 0.0001);
    h = exprHash(h ^ (((fr as i64) & 0xffffffff) as u32));
  }
  return h;
}

function exRandSeed(p: ExprProg, cx: ExprCtx, fps: f64, callsite: i32): u32 {
  return exprHash(exprRandBase(p, cx, fps) ^ ((callsite as u32) * 0x85ebca6b));
}

// ---- 値の名前の表 ----

export function exprEnvAdd(env: mut ExprEnv, name: string, type: i32): i32 {
  const slot = env.nslots;
  env.names.push(name.clone());
  env.slots.push(slot);
  env.types.push(type);
  env.nslots = slot + 1;
  return slot;
}

// 別名を足す（同じ slot を指す）。name がなければ false。
export function exprEnvAlias(env: mut ExprEnv, alias: string, name: string): bool {
  const i = exprEnvFind(env, name);
  if (i < 0) {
    return false;
  }
  const slot = env.slots[i as usize];
  const ty = env.types[i as usize];
  env.names.push(alias.clone());
  env.slots.push(slot);
  env.types.push(ty);
  return true;
}

// 名前の番号（names の中）。なければ -1。
export function exprEnvFind(env: ExprEnv, name: string): i32 {
  for (let i: usize = 0; i < env.names.length; i++) {
    if (env.names[i] == name) {
      return i as i32;
    }
  }
  return -1;
}

export function exprEnvSlot(env: ExprEnv, name: string): i32 {
  const i = exprEnvFind(env, name);
  if (i < 0) {
    return -1;
  }
  return env.slots[i as usize];
}

// 合成した値を足す: comp（2 次元・色）の成分 lane は part（数）と同じ値。どちらかの名前がなければ false。
export function exprEnvCompose(env: mut ExprEnv, comp: string, part: string, lane: i32): bool {
  const c = exprEnvSlot(env, comp);
  const q = exprEnvSlot(env, part);
  if (c < 0 || q < 0) {
    return false;
  }
  env.parts.push(c);
  env.parts.push(q);
  env.parts.push(lane);
  return true;
}

// slot と同じ値を表す slot の並び（自分・合成の部品・自分を含む合成。position なら x と y、x なら position）。
export function exprRelatedSlots(env: ExprEnv, slot: i32): i32[] {
  let out: i32[] = [slot];
  for (let i: usize = 0; i + 2 < env.parts.length; i += 3) {
    const c = env.parts[i];
    const q = env.parts[i + 1];
    if (c == slot) {
      out.push(q);
    } else if (q == slot) {
      out.push(c);
    }
  }
  return out;
}

// コアの値の名前。描画の担当が rotation / scale / 効果の引数（"blur"、"vignette.radius"）などを exprEnvAdd で足す。
// 座標の約束（docs/design/m6-expr.md の「座標と目盛り」）: x / y / position はクリップの左上の画素（キャンバスの左上から。
// center や負の値（右端・下端から）は exprResolvePos で解いた後の値）。w / h は描く大きさ（画素）。opacity は 0〜1。
export function exprEnvDefault(): ExprEnv {
  let env: ExprEnv = { names: [], slots: [], types: [], nslots: 0, parts: [] };
  exprEnvAdd(mut env, "x", EXPR_NUM);
  exprEnvAdd(mut env, "y", EXPR_NUM);
  exprEnvAdd(mut env, "position", EXPR_VEC2);
  exprEnvAdd(mut env, "w", EXPR_NUM);
  exprEnvAdd(mut env, "h", EXPR_NUM);
  exprEnvAdd(mut env, "opacity", EXPR_NUM);
  exprEnvAdd(mut env, "volume", EXPR_NUM);
  exprEnvAdd(mut env, "inPoint", EXPR_NUM);
  exprEnvAdd(mut env, "outPoint", EXPR_NUM);
  exprEnvAdd(mut env, "duration", EXPR_NUM);
  exprEnvAdd(mut env, "index", EXPR_NUM);
  exprEnvAdd(mut env, "color", EXPR_COLOR);
  exprEnvAlias(mut env, "width", "w");
  exprEnvAlias(mut env, "height", "h");
  exprEnvAlias(mut env, "start", "inPoint");
  exprEnvAlias(mut env, "end", "outPoint");
  exprEnvCompose(mut env, "position", "x", 0);
  exprEnvCompose(mut env, "position", "y", 1);
  return env;
}

export function exprLayerNew(id: string, env: ExprEnv): ExprLayer {
  let vals: f64[] = [];
  for (let i: i32 = 0; i < env.nslots * 4; i++) {
    vals.push(0.0);
  }
  return { id: id.clone(), vals };
}

// クリップの値を決める（exprLayerPut と同じく、position と x / y を揃える）。名前がなければ false。
export function exprLayerSet(l: mut ExprLayer, env: ExprEnv, name: string, v: ExprVal): bool {
  const slot = exprEnvSlot(env, name);
  if (slot < 0) {
    return false;
  }
  exprLayerPut(mut l, env, slot, v);
  return true;
}

// slot の値だけを書く（合成の関係は見ない）。
export function exprLayerSetSlot(l: mut ExprLayer, slot: i32, v: ExprVal): void {
  const k = (slot * 4) as usize;
  while (l.vals.length < k + 4) {
    l.vals.push(0.0);
  }
  l.vals[k] = v.x;
  l.vals[k + 1] = v.y;
  l.vals[k + 2] = v.z;
  l.vals[k + 3] = v.w;
}

// slot の値を書き、合成の関係（position = [x, y]）にある値も揃える。描画の担当は式の結果をこれで書く
// （x の式の結果を書けば position.x も変わり、position の式の結果を書けば x と y も変わる）。
export function exprLayerPut(l: mut ExprLayer, env: ExprEnv, slot: i32, v: ExprVal): void {
  exprLayerSetSlot(mut l, slot, v);
  for (let i: usize = 0; i + 2 < env.parts.length; i += 3) {
    const c = env.parts[i];
    const q = env.parts[i + 1];
    const lane = env.parts[i + 2];
    if (q == slot) {
      let cv = exprLayerGet(l, c);
      evSetLane(mut cv, lane, v.x);
      exprLayerSetSlot(mut l, c, cv);
    } else if (c == slot) {
      exprLayerSetSlot(mut l, q, evS(evLane(v, lane)));
    }
  }
}

// 場面の中の層に exprLayerPut する（描画の担当がコマごとに式の結果を書く。sc.env と sc.layers を 1 つの呼び出しに渡せないので）。
export function exprScenePut(sc: mut ExprScene, layer: i32, slot: i32, v: ExprVal): void {
  if (layer < 0 || (layer as usize) >= sc.layers.length || slot < 0) {
    return;
  }
  const li = layer as usize;
  const need = ((sc.env.nslots * 4) as usize);
  while (sc.layers[li].vals.length < need || sc.layers[li].vals.length < ((slot * 4 + 4) as usize)) {
    sc.layers[li].vals.push(0.0);
  }
  exScenePutRaw(mut sc, li, slot, v);
  for (let i: usize = 0; i + 2 < sc.env.parts.length; i += 3) {
    const c = sc.env.parts[i];
    const q = sc.env.parts[i + 1];
    const lane = sc.env.parts[i + 2];
    if (q == slot) {
      let cv = exprLayerGet(sc.layers[li], c);
      evSetLane(mut cv, lane, v.x);
      exScenePutRaw(mut sc, li, c, cv);
    } else if (c == slot) {
      exScenePutRaw(mut sc, li, q, evS(evLane(v, lane)));
    }
  }
}

function exScenePutRaw(sc: mut ExprScene, li: usize, slot: i32, v: ExprVal): void {
  const k = (slot * 4) as usize;
  while (sc.layers[li].vals.length < k + 4) {
    sc.layers[li].vals.push(0.0);
  }
  sc.layers[li].vals[k] = v.x;
  sc.layers[li].vals[k + 1] = v.y;
  sc.layers[li].vals[k + 2] = v.z;
  sc.layers[li].vals[k + 3] = v.w;
}

export function exprLayerGet(l: ExprLayer, slot: i32): ExprVal {
  const k = (slot * 4) as usize;
  if (slot < 0 || k + 4 > l.vals.length) {
    return evS(0.0);
  }
  return ev4(l.vals[k], l.vals[k + 1], l.vals[k + 2], l.vals[k + 3]);
}

// ---- 座標（project.um の POS_CENTER / UNSET と render.um の resolvePos と同じ約束） ----

export const EXPR_POS_CENTER: f64 = 1.0e30;
export const EXPR_UNSET: f64 = -1.0e30;

// .mzc に書いた x / y（center は POS_CENTER、負は右端・下端から）を、左上の画素に解く。render.um の resolvePos と同じ計算。
// 式の value とクリップの値（ExprLayer）には、必ずこの解いた値を入れる。式の結果も同じ座標として描画に使い、
// 記号の意味（負は右端から）には戻さない（m6-anim の ANIM_POS と同じ約束。-100 は左の画面外）。
export function exprResolvePos(v: f64, size: i32, canvas: i32): f64 {
  if (v == EXPR_POS_CENTER) {
    return ((canvas - size) / 2) as f64;
  }
  if (v < 0) {
    return (canvas - size + (Math.floor(v) as i32)) as f64;
  }
  return Math.floor(v);
}

// .mzc に書いた w / h（0 以下か UNSET は「元の大きさ」）を、描く大きさ（画素）に解く。
export function exprResolveSize(v: f64, natural: i32): f64 {
  if (v == EXPR_UNSET || v <= 0) {
    return natural as f64;
  }
  return Math.floor(v);
}

// クリップの位置と大きさ（解いた後の画素）を層に入れる（x、y、position、w、h）。
export function exprLayerSetGeom(l: mut ExprLayer, env: ExprEnv, x: f64, y: f64, w: f64, h: f64): void {
  exprLayerSet(mut l, env, "x", exprNum(x));
  exprLayerSet(mut l, env, "y", exprNum(y));
  exprLayerSet(mut l, env, "w", exprNum(w));
  exprLayerSet(mut l, env, "h", exprNum(h));
}

export function exprSceneNew(env: own ExprEnv, compW: f64, compH: f64, compDur: f64, fps: f64): ExprScene {
  return { env, layers: [], compW, compH, compDur, fps };
}

export function exprCtxNew(time: f64, value: ExprVal, index: i32, self: i32): ExprCtx {
  return { time, value, index, self, keys: [], curve: [], curveT0: 0.0, curveDt: 0.0 };
}

// valueAtTime / loopOut / loopIn が引く値の表を入れる（キーフレームの担当が animEval で求めた値）。
// vals は 4 つずつ、時刻 t0 + k * dt（タイムラインの秒）の値。t0 は最初のキーの時刻、dt はコマの長さを割ったもの（1 / (fps * 4) など）。
// 表のあいだは直線で補う。コマの時刻とキーの時刻が dt の格子に乗っていれば、そこでは animEval の値そのもの。
export function exprCtxSetCurve(cx: mut ExprCtx, t0: f64, dt: f64, vals: own f64[]): void {
  cx.curveT0 = t0;
  cx.curveDt = dt;
  cx.curve = vals;
}

// ---- 字句 ----

const TK_NUM: i32 = 1;
const TK_ID: i32 = 2;
const TK_STR: i32 = 3;
const TK_P: i32 = 4;
const TK_END: i32 = 5;

struct ExTok {
  kind: i32;
  text: string;
  num: f64;
  pos: i32;
}

struct ExErr {
  has: bool;
  code: string;
  pos: i32;
  msg: string;
  hint: string;
}

function exIsDigit(c: u8): bool {
  return c >= 48 && c <= 57;
}

function exIsIdStart(c: u8): bool {
  return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c == 36;
}

function exIsIdChar(c: u8): bool {
  return exIsIdStart(c) || exIsDigit(c);
}

function exSetErr(e: mut ExErr, code: string, pos: i32, msg: string, hint: string): void {
  if (e.has) {
    return;
  }
  e.has = true;
  e.code = code.clone();
  e.pos = pos;
  e.msg = msg.clone();
  e.hint = hint.clone();
}

const EX_CHARS_HINT: string = "式に書けるのは、数・名前・演算子（+ - * / % < > <= >= == != && || ! ? :）・かっこ ( )・[ ]・, ; と、'title' のような文字列です";

function exLex(src: string, toks: mut ExTok[], e: mut ExErr): void {
  let i: usize = 0;
  const n = src.length;
  while (i < n) {
    const c = src[i];
    if (c == 32 || c == 9 || c == 10 || c == 13) {
      i++;
      continue;
    }
    // 注釈 // ... （行の終わりまで）
    if (c == 47 && i + 1 < n && src[i + 1] == 47) {
      while (i < n && src[i] != 10) {
        i++;
      }
      continue;
    }
    const pos = i as i32;
    if (exIsDigit(c) || (c == 46 && i + 1 < n && exIsDigit(src[i + 1]))) {
      const start = i;
      while (i < n && exIsDigit(src[i])) {
        i++;
      }
      if (i < n && src[i] == 46) {
        i++;
        while (i < n && exIsDigit(src[i])) {
          i++;
        }
      }
      if (i < n && (src[i] == 101 || src[i] == 69)) {
        let j = i + 1;
        if (j < n && (src[j] == 43 || src[j] == 45)) {
          j++;
        }
        if (j < n && exIsDigit(src[j])) {
          i = j;
          while (i < n && exIsDigit(src[i])) {
            i++;
          }
        }
      }
      if (i < n && exIsIdStart(src[i])) {
        exSetErr(mut e, "expr-syntax", pos, `数の形が違います（'${sub(src, start, Math.min(i + 1, n))}'）`,
          "数は 12、0.5、1e3 のように書きます。数と名前の間には演算子（2 * time など）を書きます");
        return;
      }
      const text = sub(src, start, i);
      toks.push({ kind: TK_NUM, text: text.clone(), num: parseNum(text), pos });
      continue;
    }
    if (exIsIdStart(c)) {
      const start = i;
      while (i < n && exIsIdChar(src[i])) {
        i++;
      }
      toks.push({ kind: TK_ID, text: sub(src, start, i), num: 0.0, pos });
      continue;
    }
    if (c == 39 || c == 34) {
      let bytes: u8[] = [];
      i++;
      let closed = false;
      while (i < n) {
        const d = src[i];
        if (d == c) {
          closed = true;
          i++;
          break;
        }
        if (d == 92 && i + 1 < n) {
          bytes.push(src[i + 1]);
          i += 2;
          continue;
        }
        bytes.push(d);
        i++;
      }
      if (!closed) {
        exSetErr(mut e, "expr-syntax", pos, "文字列の引用符が閉じていません", "clip('title') のように、文字列は ' で囲んで閉じます");
        return;
      }
      toks.push({ kind: TK_STR, text: stringFromBytes(bytes), num: 0.0, pos });
      continue;
    }
    // 演算子・区切り
    let len: usize = 0;
    if (i + 2 < n && (src[i] == 61 || src[i] == 33) && src[i + 1] == 61 && src[i + 2] == 61) {
      len = 3;
    } else if (i + 1 < n) {
      const d = src[i + 1];
      if ((c == 60 || c == 62 || c == 61 || c == 33) && d == 61) {
        len = 2;
      } else if ((c == 38 && d == 38) || (c == 124 && d == 124)) {
        len = 2;
      }
    }
    if (len == 0) {
      // 1 文字: ( ) [ ] , . ; ? : + - * / % < > ! = { }（{ } は構文の誤りとして知らせるため）
      if (c == 40 || c == 41 || c == 91 || c == 93 || c == 44 || c == 46 || c == 59 || c == 63 || c == 58 || c == 43 ||
        c == 45 || c == 42 || c == 47 || c == 37 || c == 60 || c == 62 || c == 33 || c == 61 || c == 123 || c == 125) {
        len = 1;
      }
    }
    if (len == 0) {
      // UTF-8 の 1 文字分を見せる
      let j = i + 1;
      while (j < n && (src[j] & 0xc0) == 0x80) {
        j++;
      }
      let hint = EX_CHARS_HINT;
      if (c == 38 || c == 124) {
        hint = "「かつ」は &&、「または」は || と 2 つ重ねて書きます";
      }
      exSetErr(mut e, "expr-syntax", pos, `'${sub(src, i, j)}' は式に書けない文字です`, hint);
      return;
    }
    let text = sub(src, i, i + len);
    if (text == "===") {
      text = "==";
    } else if (text == "!==") {
      text = "!=";
    }
    toks.push({ kind: TK_P, text, num: 0.0, pos });
    i += len;
  }
  toks.push({ kind: TK_END, text: "", num: 0.0, pos: n as i32 });
}

// ---- 構文と型（1 回で命令にする） ----

struct ExP {
  toks: ExTok[];
  k: usize;
  code: i32[];
  consts: f64[];
  sp: i32;
  maxSp: i32;
  depth: i32;
  err: ExErr;
  locNames: string[];
  locTypes: i32[];
  refClip: string[];
  refSlot: i32[];
  refType: i32[];
  refCol: i32[];
  env: ExprEnv;
  mode: i32;
  valueType: i32;
  calls: i32;
  seed: i32;
  timeless: bool;
  usesTime: bool;
  usesKeys: bool;
  usesRefs: bool;
  usesValue: bool;
  usesRandom: bool;
}

function exTokIs(p: ExP, text: string): bool {
  const t = p.toks[p.k].kind;
  return (t == TK_P || t == TK_ID) && p.toks[p.k].text == text;
}

function exPos(p: ExP): i32 {
  return p.toks[p.k].pos;
}

function exFail(p: mut ExP, code: string, pos: i32, msg: string, hint: string): i32 {
  exSetErr(mut p.err, code, pos, msg, hint);
  return 0;
}

function exTokDesc(p: ExP): string {
  const t = p.toks[p.k].kind;
  if (t == TK_END) {
    return "式の終わり";
  }
  if (t == TK_STR) {
    return `文字列 '${p.toks[p.k].text}'`;
  }
  return `'${p.toks[p.k].text}'`;
}

function exUnexpected(p: mut ExP): i32 {
  const pos = exPos(p);
  if (p.toks[p.k].kind == TK_END) {
    return exFail(mut p, "expr-syntax", pos, "式が途中で終わっています", "かっこ・引数・演算子の右側が足りないかもしれません");
  }
  const d = exTokDesc(p);
  return exFail(mut p, "expr-syntax", pos, `${d} はここには書けません`, "値（数・名前・関数の呼び出し・( )・[ ]）を書く所です");
}

function exExpect(p: mut ExP, text: string, ctx: string): bool {
  if (exTokIs(p, text)) {
    p.k++;
    return true;
  }
  const pos = exPos(p);
  const d = exTokDesc(p);
  exFail(mut p, "expr-syntax", pos, `'${text}' が必要です（${d} があります）`, ctx);
  return false;
}

// 定数だけから求まる命令か（time や乱数、キーフレーム、変数を読まない）。
function exFoldable(op: i32): bool {
  if (op == EX_PUSH || op == EX_IN || op == EX_REF || op == EX_LGET || op == EX_LSET) {
    return false;
  }
  if (op == EX_WIGGLE || op == EX_RAND || op == EX_LOOP || op == EX_VALAT || op == EX_KEYV || op == EX_KEYT || op == EX_NKEYS) {
    return false;
  }
  return true;
}

// 直前の n 個の命令がどれも定数か。
function exTailConsts(p: ExP, n: i32): bool {
  const len = p.code.length as i32;
  if (len < n * 3) {
    return false;
  }
  for (let j = 0; j < n; j++) {
    if (p.code[(len - (j + 1) * 3) as usize] != EX_PUSH) {
      return false;
    }
  }
  return true;
}

function exEmit(p: mut ExP, op: i32, a: i32, b: i32, pops: i32, pushes: i32): void {
  // 定数の畳み込み: [0.5, 0.5]、2 * PI のような部分は、解析のときに 1 つの定数にする（コマごと・画素ごとの命令が減る）。
  if (pushes == 1 && pops > 0 && exFoldable(op) && exTailConsts(p, pops)) {
    let prog = exEmptyProg("", EXPR_NUM, EXPR_MODE_PARAM, 0, 0);
    prog.ok = true;
    prog.type = EXPR_COLOR;
    prog.valueType = p.valueType;
    const len = p.code.length;
    for (let j = 0; j < pops; j++) {
      const k = (p.code[len - ((pops - j) as usize) * 3 + 1] * 4) as usize;
      prog.consts.push(p.consts[k]);
      prog.consts.push(p.consts[k + 1]);
      prog.consts.push(p.consts[k + 2]);
      prog.consts.push(p.consts[k + 3]);
      prog.code.push(EX_PUSH);
      prog.code.push(j);
      prog.code.push(0);
    }
    prog.code.push(op);
    prog.code.push(a);
    prog.code.push(b);
    let env: ExprEnv = { names: [], slots: [], types: [], nslots: 0, parts: [] };
    const sc = exprSceneNew(own env, 0.0, 0.0, 0.0, 0.0);
    const cx = exprCtxNew(0.0, evS(0.0), 0, -1);
    const r = exprEvalFull(prog, cx, sc);
    if (!r.bad) {
      for (let j = 0; j < pops * 3; j++) {
        p.code.pop();
      }
      p.sp = p.sp - pops;
      exPushConst(mut p, r.v);
      return;
    }
  }
  p.code.push(op);
  p.code.push(a);
  p.code.push(b);
  p.sp = p.sp - pops + pushes;
  if (p.sp > p.maxSp) {
    p.maxSp = p.sp;
  }
}

function exPushConst(p: mut ExP, v: ExprVal): void {
  const idx = (p.consts.length / 4) as i32;
  p.consts.push(v.x);
  p.consts.push(v.y);
  p.consts.push(v.z);
  p.consts.push(v.w);
  exEmit(mut p, EX_PUSH, idx, 0, 0, 1);
}

function exPushNum(p: mut ExP, v: f64): void {
  exPushConst(mut p, evS(v));
}

function exIn(p: mut ExP, slot: i32): void {
  if (slot == EXIN_TIME) {
    p.usesTime = true;
  }
  if (slot == EXIN_VALUE) {
    p.usesValue = true;
  }
  exEmit(mut p, EX_IN, slot, 0, 0, 1);
}

// 直前の命令が定数なら、その定数の番号。なければ -1（-5 のような負の数を定数のまま畳むのに使う）。
function exLastConst(p: ExP): i32 {
  const n = p.code.length;
  if (n >= 3 && p.code[n - 3] == EX_PUSH) {
    return p.code[n - 2];
  }
  return -1;
}

function exFindLocal(p: ExP, name: string): i32 {
  for (let i: usize = 0; i < p.locNames.length; i++) {
    if (p.locNames[i] == name) {
      return i as i32;
    }
  }
  return -1;
}

// 名前の候補（打ち間違いの提示に使う）。
function exBuiltinNames(): string[] {
  let out: string[] = [];
  out.push("sin");
  out.push("cos");
  out.push("tan");
  out.push("asin");
  out.push("acos");
  out.push("atan");
  out.push("atan2");
  out.push("sqrt");
  out.push("abs");
  out.push("floor");
  out.push("ceil");
  out.push("round");
  out.push("fract");
  out.push("exp");
  out.push("log");
  out.push("sign");
  out.push("pow");
  out.push("min");
  out.push("max");
  out.push("clamp");
  out.push("mix");
  out.push("lerp");
  out.push("step");
  out.push("smoothstep");
  out.push("length");
  out.push("distance");
  out.push("dot");
  out.push("normalize");
  out.push("linear");
  out.push("ease");
  out.push("easeIn");
  out.push("easeOut");
  out.push("wiggle");
  out.push("noise");
  out.push("random");
  out.push("seedRandom");
  out.push("loopOut");
  out.push("loopIn");
  out.push("valueAtTime");
  out.push("key");
  out.push("rgb");
  out.push("hsl");
  out.push("hslToRgb");
  out.push("rgbToHsl");
  out.push("vec2");
  out.push("clip");
  out.push("degreesToRadians");
  out.push("radiansToDegrees");
  out.push("timeToFrames");
  out.push("framesToTime");
  out.push("time");
  out.push("value");
  out.push("index");
  out.push("thisLayer");
  out.push("thisComp");
  out.push("inPoint");
  out.push("outPoint");
  out.push("numKeys");
  out.push("uv");
  out.push("px");
  out.push("src");
  return out;
}

function exNameCandidates(p: ExP): string[] {
  let out = exBuiltinNames();
  for (const n of p.locNames) {
    out.push(n.clone());
  }
  return out;
}

function exDidYouMean(near: string, other: string): string {
  if (near != "") {
    return `'${near}' のことですか？`;
  }
  return other.clone();
}

// 二項演算の型。誤りなら 0（p.err に入れる）。
function exBinType(p: mut ExP, op: string, a: i32, b: i32, pos: i32): i32 {
  if (op == "+" || op == "-") {
    if (a == b) {
      return a;
    }
    const an = exprTypeName(a);
    const bn = exprTypeName(b);
    return exFail(mut p, "expr-type", pos, `'${op}' の左は${an}、右は${bn}です。同じ型どうしでしか足し引きできません`,
      "数と 2 次元の値・色を混ぜるときは、掛け算・割り算を使うか、[value[0] + 10, value[1]] のように成分ごとに書きます");
  }
  if (op == "*") {
    if (a == b || a == EXPR_NUM || b == EXPR_NUM) {
      return a == EXPR_NUM ? b : a;
    }
    return exFail(mut p, "expr-type", pos, `'*' の左は${exprTypeName(a)}、右は${exprTypeName(b)}です`,
      "掛けられるのは、同じ型どうし（成分ごと）か、数との掛け算です");
  }
  if (op == "/" || op == "%") {
    if (a == b || b == EXPR_NUM) {
      return a;
    }
    return exFail(mut p, "expr-type", pos, `'${op}' の左は${exprTypeName(a)}、右は${exprTypeName(b)}です`,
      "割れるのは、同じ型どうし（成分ごと）か、数で割るときです");
  }
  return 0;
}

function exOpCode(op: string): i32 {
  if (op == "+") {
    return EX_ADD;
  }
  if (op == "-") {
    return EX_SUB;
  }
  if (op == "*") {
    return EX_MUL;
  }
  if (op == "/") {
    return EX_DIV;
  }
  if (op == "%") {
    return EX_MOD;
  }
  if (op == "<") {
    return EX_LT;
  }
  if (op == "<=") {
    return EX_LE;
  }
  if (op == ">") {
    return EX_GT;
  }
  if (op == ">=") {
    return EX_GE;
  }
  if (op == "==") {
    return EX_EQ;
  }
  return EX_NE;
}

function exDeeper(p: mut ExP): bool {
  p.depth++;
  if (p.depth > EXPR_MAX_DEPTH) {
    const pos = exPos(p);
    exFail(mut p, "expr-too-complex", pos, `かっこや演算の入れ子が深すぎます（${EXPR_MAX_DEPTH} 段まで）`,
      "let で途中の値に名前を付けて、式を分けます");
    return false;
  }
  return true;
}

function exParseCond(p: mut ExP): i32 {
  if (!exDeeper(mut p)) {
    return 0;
  }
  const pos = exPos(p);
  const t = exParseOr(mut p);
  if (t == 0) {
    return 0;
  }
  if (!exTokIs(p, "?")) {
    p.depth--;
    return t;
  }
  if (t != EXPR_NUM) {
    return exFail(mut p, "expr-type", pos, `'?' の前（条件）は数でなければなりません（${exprTypeName(t)}です）`,
      "条件は time > 2 のような比較で書きます（0 なら偽、それ以外は真）");
  }
  p.k++;
  const posA = exPos(p);
  const ta = exParseCond(mut p);
  if (ta == 0 || !exExpect(mut p, ":", "条件 ? 真のときの値 : 偽のときの値 のように書きます")) {
    return 0;
  }
  const tb = exParseCond(mut p);
  if (tb == 0) {
    return 0;
  }
  if (ta != tb) {
    return exFail(mut p, "expr-type", posA, `'?' の後の 2 つの値の型が違います（${exprTypeName(ta)}と${exprTypeName(tb)}）`,
      "真のときと偽のときで、同じ型の値を返します");
  }
  exEmit(mut p, EX_SEL, 0, 0, 3, 1);
  p.depth--;
  return ta;
}

function exParseOr(p: mut ExP): i32 {
  let t = exParseAnd(mut p);
  while (t != 0 && exTokIs(p, "||")) {
    const pos = exPos(p);
    p.k++;
    const t2 = exParseAnd(mut p);
    if (t2 == 0) {
      return 0;
    }
    if (t != EXPR_NUM || t2 != EXPR_NUM) {
      return exFail(mut p, "expr-type", pos, "'||' の両側は数（条件）でなければなりません", "time < 1 || time > 3 のように書きます");
    }
    exEmit(mut p, EX_OR, 0, 0, 2, 1);
  }
  return t;
}

function exParseAnd(p: mut ExP): i32 {
  let t = exParseCmp(mut p);
  while (t != 0 && exTokIs(p, "&&")) {
    const pos = exPos(p);
    p.k++;
    const t2 = exParseCmp(mut p);
    if (t2 == 0) {
      return 0;
    }
    if (t != EXPR_NUM || t2 != EXPR_NUM) {
      return exFail(mut p, "expr-type", pos, "'&&' の両側は数（条件）でなければなりません", "time > 1 && time < 3 のように書きます");
    }
    exEmit(mut p, EX_AND, 0, 0, 2, 1);
  }
  return t;
}

function exIsCmp(p: ExP): bool {
  return exTokIs(p, "<") || exTokIs(p, "<=") || exTokIs(p, ">") || exTokIs(p, ">=") || exTokIs(p, "==") || exTokIs(p, "!=");
}

function exParseCmp(p: mut ExP): i32 {
  const t = exParseAdd(mut p);
  if (t == 0 || !exIsCmp(p)) {
    return t;
  }
  const pos = exPos(p);
  const op = p.toks[p.k].text.clone();
  p.k++;
  const t2 = exParseAdd(mut p);
  if (t2 == 0) {
    return 0;
  }
  if (op == "==" || op == "!=") {
    if (t != t2) {
      return exFail(mut p, "expr-type", pos, `'${op}' の左は${exprTypeName(t)}、右は${exprTypeName(t2)}です`, "同じ型どうしを比べます");
    }
    exEmit(mut p, exOpCode(op), t, 0, 2, 1);
  } else {
    if (t != EXPR_NUM || t2 != EXPR_NUM) {
      return exFail(mut p, "expr-type", pos, `'${op}' で比べられるのは数だけです`,
        "2 次元の値や色は value[0] や length(v) のように数にしてから比べます");
    }
    exEmit(mut p, exOpCode(op), 0, 0, 2, 1);
  }
  if (exIsCmp(p)) {
    const pos2 = exPos(p);
    return exFail(mut p, "expr-syntax", pos2, "比較を続けて書くことはできません（a < b < c）", "a < b && b < c のように && でつなぎます");
  }
  return EXPR_NUM;
}

function exParseAdd(p: mut ExP): i32 {
  let t = exParseMul(mut p);
  while (t != 0 && (exTokIs(p, "+") || exTokIs(p, "-"))) {
    const pos = exPos(p);
    const op = p.toks[p.k].text.clone();
    p.k++;
    const t2 = exParseMul(mut p);
    if (t2 == 0) {
      return 0;
    }
    t = exBinType(mut p, op, t, t2, pos);
    if (t == 0) {
      return 0;
    }
    exEmit(mut p, exOpCode(op), 0, 0, 2, 1);
  }
  return t;
}

function exParseMul(p: mut ExP): i32 {
  let t = exParseUnary(mut p);
  while (t != 0 && (exTokIs(p, "*") || exTokIs(p, "/") || exTokIs(p, "%"))) {
    const pos = exPos(p);
    const op = p.toks[p.k].text.clone();
    p.k++;
    const t2 = exParseUnary(mut p);
    if (t2 == 0) {
      return 0;
    }
    t = exBinType(mut p, op, t, t2, pos);
    if (t == 0) {
      return 0;
    }
    exEmit(mut p, exOpCode(op), 0, 0, 2, 1);
  }
  return t;
}

function exParseUnary(p: mut ExP): i32 {
  if (!exDeeper(mut p)) {
    return 0;
  }
  let t = 0;
  if (exTokIs(p, "-")) {
    p.k++;
    t = exParseUnary(mut p);
    if (t != 0) {
      const lc = exLastConst(p);
      if (lc >= 0 && (lc as usize) * 4 + 4 == p.consts.length) {
        // 定数の符号を変えるだけ（-5 を 1 つの定数に）
        const k = (lc * 4) as usize;
        p.consts[k] = -p.consts[k];
        p.consts[k + 1] = -p.consts[k + 1];
        p.consts[k + 2] = -p.consts[k + 2];
        p.consts[k + 3] = -p.consts[k + 3];
      } else {
        exEmit(mut p, EX_NEG, 0, 0, 1, 1);
      }
    }
  } else if (exTokIs(p, "+")) {
    p.k++;
    t = exParseUnary(mut p);
  } else if (exTokIs(p, "!")) {
    const pos = exPos(p);
    p.k++;
    t = exParseUnary(mut p);
    if (t != 0 && t != EXPR_NUM) {
      return exFail(mut p, "expr-type", pos, "'!' の後は数（条件）でなければなりません", "!(time > 2) のように書きます");
    }
    if (t != 0) {
      exEmit(mut p, EX_NOT, 0, 0, 1, 1);
    }
  } else {
    t = exParsePostfix(mut p);
  }
  if (t != 0) {
    p.depth--;
  }
  return t;
}

// 成分の名前 → 番号。なければ -1。
function exSwizzle(t: i32, name: string): i32 {
  if (t == EXPR_VEC2) {
    if (name == "x" || name == "0") {
      return 0;
    }
    if (name == "y" || name == "1") {
      return 1;
    }
    return -1;
  }
  if (t == EXPR_COLOR) {
    if (name == "r" || name == "x" || name == "0") {
      return 0;
    }
    if (name == "g" || name == "y" || name == "1") {
      return 1;
    }
    if (name == "b" || name == "z" || name == "2") {
      return 2;
    }
    if (name == "a" || name == "w" || name == "3") {
      return 3;
    }
  }
  return -1;
}

function exSwizzleHint(t: i32): string {
  if (t == EXPR_VEC2) {
    return "2 次元の値の成分は .x .y か [0] [1] です";
  }
  if (t == EXPR_COLOR) {
    return "色の成分は .r .g .b .a か [0]〜[3] です";
  }
  return "数には成分がありません";
}

function exParsePostfix(p: mut ExP): i32 {
  let t = exParsePrimary(mut p);
  while (t != 0) {
    if (exTokIs(p, ".")) {
      p.k++;
      const pos = exPos(p);
      if (p.toks[p.k].kind != TK_ID) {
        return exUnexpected(mut p);
      }
      const name = p.toks[p.k].text.clone();
      const c = exSwizzle(t, name);
      if (c < 0) {
        return exFail(mut p, "expr-type", pos, `${exprTypeName(t)}に '.${name}' はありません`, exSwizzleHint(t));
      }
      p.k++;
      exEmit(mut p, EX_SWZ, c, 0, 1, 1);
      t = EXPR_NUM;
    } else if (exTokIs(p, "[")) {
      p.k++;
      const pos = exPos(p);
      if (p.toks[p.k].kind != TK_NUM) {
        return exFail(mut p, "expr-type", pos, "[ ] の中は 0、1 のような数（定数）だけ書けます", exSwizzleHint(t));
      }
      const name = p.toks[p.k].text.clone();
      const c = exSwizzle(t, name);
      if (c < 0) {
        return exFail(mut p, "expr-type", pos, `${exprTypeName(t)}に [${name}] はありません`, exSwizzleHint(t));
      }
      p.k++;
      if (!exExpect(mut p, "]", "value[0] のように閉じます")) {
        return 0;
      }
      exEmit(mut p, EX_SWZ, c, 0, 1, 1);
      t = EXPR_NUM;
    } else {
      break;
    }
  }
  return t;
}

// クリップの値の名前（thisLayer.x、clip('title').position、clip('a').vignette.radius）を読む。
// 名前の表で一番長く合うものを選ぶ。p.k は '.' の次の名前を指している。
function exParseProp(p: mut ExP, clipId: string, idPos: i32): i32 {
  const pos = exPos(p);
  if (p.toks[p.k].kind != TK_ID) {
    return exUnexpected(mut p);
  }
  let name = p.toks[p.k].text.clone();
  p.k++;
  while (exTokIs(p, ".") && p.toks[p.k + 1].kind == TK_ID) {
    const longer = name + "." + p.toks[p.k + 1].text;
    let prefix = false;
    for (const n of p.env.names) {
      if (n.length >= longer.length && sub(n, 0, longer.length) == longer) {
        prefix = true;
      }
    }
    if (!prefix) {
      break;
    }
    name = longer;
    p.k += 2;
  }
  const i = exprEnvFind(p.env, name);
  if (i < 0) {
    let cands: string[] = [];
    for (const n of p.env.names) {
      cands.push(n.clone());
    }
    const near = textNearest(name, cands);
    let list = "";
    for (let j: usize = 0; j < p.env.names.length && j < 14; j++) {
      if (j > 0) {
        list = list + ", ";
      }
      list = list + p.env.names[j];
    }
    return exFail(mut p, "expr-unknown-prop", pos, `クリップの値に '${name}' はありません`,
      exDidYouMean(near, `使える名前: ${list} など（schema の expressions.props）`));
  }
  const slot = p.env.slots[i as usize];
  const ty = p.env.types[i as usize];
  // 同じ参照は 1 つにまとめる
  let r = -1;
  for (let j: usize = 0; j < p.refClip.length; j++) {
    if (p.refClip[j] == clipId && p.refSlot[j] == slot) {
      r = j as i32;
    }
  }
  if (r < 0) {
    r = p.refClip.length as i32;
    p.refClip.push(clipId.clone());
    p.refSlot.push(slot);
    p.refType.push(ty);
    p.refCol.push(idPos);
  }
  p.usesRefs = true;
  exEmit(mut p, EX_REF, r, 0, 0, 1);
  return ty;
}

function exParsePrimary(p: mut ExP): i32 {
  const tk = p.toks[p.k].kind;
  const pos = exPos(p);
  if (tk == TK_NUM) {
    const v = p.toks[p.k].num;
    p.k++;
    exPushNum(mut p, v);
    return EXPR_NUM;
  }
  if (tk == TK_STR) {
    return exFail(mut p, "expr-type", pos, "文字列はここには書けません",
      "文字列を書けるのは clip('title') の ID と loopOut('cycle') の種類だけです");
  }
  if (exTokIs(p, "(")) {
    p.k++;
    const t = exParseCond(mut p);
    if (t == 0 || !exExpect(mut p, ")", "( に対応する ) を書きます")) {
      return 0;
    }
    return t;
  }
  if (exTokIs(p, "[")) {
    p.k++;
    let n = 0;
    while (true) {
      const epos = exPos(p);
      const t = exParseCond(mut p);
      if (t == 0) {
        return 0;
      }
      if (t != EXPR_NUM) {
        return exFail(mut p, "expr-type", epos, `[ ] の要素は数でなければなりません（${exprTypeName(t)}です）`,
          "[value[0], value[1] + 10] のように、成分を数で書きます");
      }
      n++;
      if (exTokIs(p, ",")) {
        p.k++;
        continue;
      }
      break;
    }
    if (!exExpect(mut p, "]", "[x, y] のように ] で閉じます")) {
      return 0;
    }
    if (n == 2) {
      exEmit(mut p, EX_VEC2, 0, 0, 2, 1);
      return EXPR_VEC2;
    }
    if (n == 3) {
      exEmit(mut p, EX_COL3, 0, 0, 3, 1);
      return EXPR_COLOR;
    }
    if (n == 4) {
      exEmit(mut p, EX_COL4, 0, 0, 4, 1);
      return EXPR_COLOR;
    }
    return exFail(mut p, "expr-type", pos, `[ ] の要素は 2 個（2 次元）か 3〜4 個（色）です（${n} 個あります）`,
      "[x, y] は 2 次元の値、[r, g, b] と [r, g, b, a] は色（0〜1）です");
  }
  if (tk != TK_ID) {
    return exUnexpected(mut p);
  }
  let name = p.toks[p.k].text.clone();
  p.k++;
  // Math.sin、Math.PI は sin、PI と同じ
  if (name == "Math" && exTokIs(p, ".") && p.toks[p.k + 1].kind == TK_ID) {
    name = p.toks[p.k + 1].text.clone();
    p.k += 2;
  }
  if (name == "if" || name == "for" || name == "while" || name == "do" || name == "function" || name == "return" ||
    name == "switch" || name == "new") {
    return exFail(mut p, "expr-syntax", pos, `'${name}' は使えません（式の言語に文の制御・関数の定義はありません）`,
      "条件で値を選ぶときは 条件 ? a : b と書きます。最後の式の値がそのまま結果になります（return は要りません）");
  }
  if (exTokIs(p, "(")) {
    return exParseCall(mut p, name, pos);
  }
  const loc = exFindLocal(p, name);
  if (loc >= 0) {
    exEmit(mut p, EX_LGET, loc, 0, 0, 1);
    return p.locTypes[loc as usize];
  }
  const pixel = p.mode == EXPR_MODE_PIXEL;
  if (name == "time") {
    exIn(mut p, EXIN_TIME);
    return EXPR_NUM;
  }
  if (name == "value") {
    if (pixel) {
      exIn(mut p, EXIN_SRC);
      return EXPR_COLOR;
    }
    exIn(mut p, EXIN_VALUE);
    return p.valueType;
  }
  if (name == "index") {
    exIn(mut p, EXIN_INDEX);
    return EXPR_NUM;
  }
  if (name == "PI") {
    exPushNum(mut p, EX_PI);
    return EXPR_NUM;
  }
  if (name == "E") {
    exPushNum(mut p, 2.718281828459045);
    return EXPR_NUM;
  }
  if (name == "true") {
    exPushNum(mut p, 1.0);
    return EXPR_NUM;
  }
  if (name == "false") {
    exPushNum(mut p, 0.0);
    return EXPR_NUM;
  }
  if (name == "uv" || name == "px" || name == "src") {
    if (!pixel) {
      return exFail(mut p, "expr-not-allowed", pos, `'${name}' は画素の式（pixel=expr(...)）の中だけで使えます`,
        "キーの値の式では time、value、index、thisLayer、clip('id') などを使います");
    }
    if (name == "uv") {
      exIn(mut p, EXIN_UV);
      return EXPR_VEC2;
    }
    if (name == "px") {
      exIn(mut p, EXIN_PX);
      return EXPR_VEC2;
    }
    exIn(mut p, EXIN_SRC);
    return EXPR_COLOR;
  }
  if (name == "inPoint" || name == "outPoint") {
    return exThisProp(mut p, name, pos);
  }
  if (name == "numKeys") {
    if (pixel) {
      return exFail(mut p, "expr-not-allowed", pos, "numKeys は画素の式では使えません", "キーフレームはキーの値の式（x=expr(...)）で使います");
    }
    p.usesKeys = true;
    exEmit(mut p, EX_NKEYS, 0, 0, 0, 1);
    return EXPR_NUM;
  }
  if (name == "thisLayer") {
    if (!exExpect(mut p, ".", "thisLayer.x のように、値の名前を続けます")) {
      return 0;
    }
    return exParseProp(mut p, "", pos);
  }
  if (name == "thisComp") {
    if (!exExpect(mut p, ".", "thisComp.width のように書きます")) {
      return 0;
    }
    const ppos = exPos(p);
    if (p.toks[p.k].kind != TK_ID) {
      return exUnexpected(mut p);
    }
    const prop = p.toks[p.k].text.clone();
    p.k++;
    if (prop == "width") {
      exIn(mut p, EXIN_COMPW);
      return EXPR_NUM;
    }
    if (prop == "height") {
      exIn(mut p, EXIN_COMPH);
      return EXPR_NUM;
    }
    if (prop == "duration") {
      exIn(mut p, EXIN_COMPDUR);
      return EXPR_NUM;
    }
    if (prop == "frameDuration") {
      exIn(mut p, EXIN_FRAMEDUR);
      return EXPR_NUM;
    }
    if (prop == "fps" || prop == "frameRate") {
      exIn(mut p, EXIN_FPS);
      return EXPR_NUM;
    }
    if (prop == "layer") {
      return exFail(mut p, "expr-unknown-prop", ppos, "thisComp.layer(...) の代わりに clip('ID') と書きます",
        "clip('title').x のように、クリップの ID（id=title）で指します");
    }
    let cands: string[] = ["width", "height", "duration", "frameDuration", "fps"];
    const near = textNearest(prop, cands);
    return exFail(mut p, "expr-unknown-prop", ppos, `thisComp に '${prop}' はありません`,
      exDidYouMean(near, "thisComp の値は width、height、duration、frameDuration、fps です"));
  }
  if (name == "clip") {
    return exFail(mut p, "expr-syntax", pos, "clip の後に ('ID') が必要です", "clip('title').x のように書きます");
  }
  const cands = exNameCandidates(p);
  const near = textNearest(name, cands);
  if (name == "var" || name == "let" || name == "const") {
    return exFail(mut p, "expr-syntax", pos, `'${name}' は文の始めにだけ書けます`, "let a = 1; a * 2 のように、; で区切った文の始めに書きます");
  }
  return exFail(mut p, "expr-unknown-name", pos, `'${name}' という名前はありません`,
    exDidYouMean(near, "使える名前は time、value、index、thisLayer、thisComp、clip('ID') と関数です（schema の expressions）"));
}

function exThisProp(p: mut ExP, name: string, pos: i32): i32 {
  // thisLayer の値を、名前だけで（inPoint、outPoint）
  const i = exprEnvFind(p.env, name);
  if (i < 0) {
    return exFail(mut p, "expr-unknown-prop", pos, `クリップの値に '${name}' はありません`, "");
  }
  const slot = p.env.slots[i as usize];
  let r = -1;
  for (let j: usize = 0; j < p.refClip.length; j++) {
    if (p.refClip[j] == "" && p.refSlot[j] == slot) {
      r = j as i32;
    }
  }
  if (r < 0) {
    r = p.refClip.length as i32;
    p.refClip.push("");
    p.refSlot.push(slot);
    p.refType.push(p.env.types[i as usize]);
    p.refCol.push(pos);
  }
  p.usesRefs = true;
  exEmit(mut p, EX_REF, r, 0, 0, 1);
  return p.env.types[i as usize];
}

// 引数を読む（( は読んだ後）。型を tys に入れる。文字列の引数は strs に入れ、型は 0。
function exParseArgs(p: mut ExP, tys: mut i32[], strs: mut string[], poss: mut i32[]): bool {
  if (exTokIs(p, ")")) {
    p.k++;
    return true;
  }
  while (true) {
    poss.push(exPos(p));
    if (p.toks[p.k].kind == TK_STR && (p.toks[p.k + 1].kind == TK_P &&
      (p.toks[p.k + 1].text == "," || p.toks[p.k + 1].text == ")"))) {
      strs.push(p.toks[p.k].text.clone());
      tys.push(0);
      p.k++;
    } else {
      const t = exParseCond(mut p);
      if (t == 0) {
        return false;
      }
      tys.push(t);
      strs.push("");
    }
    if (exTokIs(p, ",")) {
      p.k++;
      continue;
    }
    return exExpect(mut p, ")", "引数は ( ) の中に , で区切って書きます");
  }
  return false;
}

function exArgCount(p: mut ExP, name: string, n: usize, lo: usize, hi: usize, pos: i32, usage: string): bool {
  if (n >= lo && n <= hi) {
    return true;
  }
  let want = `${lo} 個`;
  if (hi > lo) {
    want = `${lo}〜${hi} 個`;
  }
  exFail(mut p, "expr-args", pos, `${name} の引数は ${want}です（${n} 個あります）`, `${usage} のように書きます`);
  return false;
}

function exArgNoStr(p: mut ExP, name: string, tys: i32[], poss: i32[], usage: string): bool {
  for (let i: usize = 0; i < tys.length; i++) {
    if (tys[i] == 0) {
      exFail(mut p, "expr-args", poss[i], `${name} の ${i + 1} 番目の引数に文字列は書けません`, `${usage} のように書きます`);
      return false;
    }
  }
  return true;
}

function exArgNum(p: mut ExP, name: string, tys: i32[], poss: i32[], i: usize, what: string, usage: string): bool {
  if (tys[i] == EXPR_NUM) {
    return true;
  }
  exFail(mut p, "expr-args", poss[i], `${name} の ${i + 1} 番目の引数（${what}）は数です（${exprTypeName(tys[i])}があります）`,
    `${usage} のように書きます`);
  return false;
}

// 「同じ型か数」の引数をまとめて確かめ、結果の型を返す（数は他の型に合わせる）。
function exArgSame(p: mut ExP, name: string, tys: i32[], poss: i32[], from: usize, to: usize, usage: string): i32 {
  let t = EXPR_NUM;
  for (let i = from; i < to; i++) {
    if (tys[i] != EXPR_NUM) {
      if (t != EXPR_NUM && t != tys[i]) {
        return exFail(mut p, "expr-args", poss[i], `${name} の引数の型が揃っていません（${exprTypeName(t)}と${exprTypeName(tys[i])}）`,
          `${usage} のように、同じ型（か数）で書きます`);
      }
      t = tys[i];
    }
  }
  return t;
}

function exNoPixel(p: mut ExP, name: string, pos: i32): bool {
  if (p.mode == EXPR_MODE_PIXEL) {
    exFail(mut p, "expr-not-allowed", pos, `${name} は画素の式（pixel=expr(...)）では使えません`,
      "画素の式では noise(uv * 8)、random() のように画素ごとの値を使います。キーフレームや wiggle はキーの値の式（x=expr(...)）で使います");
    return false;
  }
  return true;
}

function exF1Code(name: string): i32 {
  switch (name) {
    case "sin":
      return EXF1_SIN;
    case "cos":
      return EXF1_COS;
    case "tan":
      return EXF1_TAN;
    case "asin":
      return EXF1_ASIN;
    case "acos":
      return EXF1_ACOS;
    case "atan":
      return EXF1_ATAN;
    case "sqrt":
      return EXF1_SQRT;
    case "abs":
      return EXF1_ABS;
    case "floor":
      return EXF1_FLOOR;
    case "ceil":
      return EXF1_CEIL;
    case "round":
      return EXF1_ROUND;
    case "fract":
      return EXF1_FRACT;
    case "exp":
      return EXF1_EXP;
    case "log":
      return EXF1_LOG;
    case "sign":
      return EXF1_SIGN;
    case "degreesToRadians":
      return EXF1_D2R;
    case "radiansToDegrees":
      return EXF1_R2D;
    default:
      return -1;
  }
}

function exParseCall(p: mut ExP, name: string, pos: i32): i32 {
  p.k++;
  // clip('id').値の名前
  if (name == "clip") {
    const ipos = exPos(p);
    if (p.toks[p.k].kind != TK_STR) {
      return exFail(mut p, "expr-args", ipos, "clip の引数は、クリップの ID の文字列です", "clip('title').x のように ' で囲んで書きます");
    }
    const id = p.toks[p.k].text.clone();
    p.k++;
    if (!exExpect(mut p, ")", "clip('title') のように閉じます")) {
      return 0;
    }
    if (!exExpect(mut p, ".", "clip('title').x のように、値の名前を続けます")) {
      return 0;
    }
    return exParseProp(mut p, id, ipos);
  }
  let tys: i32[] = [];
  let strs: string[] = [];
  let poss: i32[] = [];
  if (name == "seedRandom") {
    return exFail(mut p, "expr-syntax", pos, "seedRandom は文の始めにだけ書けます", "seedRandom(5, true); random(100) のように、; の前に書きます");
  }
  if (!exParseArgs(mut p, mut tys, mut strs, mut poss)) {
    return 0;
  }
  const n = tys.length;
  const f1 = exF1Code(name);
  if (f1 >= 0) {
    const usage = `${name}(x)`;
    if (!exArgCount(mut p, name, n, 1, 1, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
      return 0;
    }
    exEmit(mut p, EX_F1, f1, tys[0], 1, 1);
    return tys[0];
  }
  switch (name) {
    case "atan2": {
      const usage = "atan2(y, x)";
      if (!exArgCount(mut p, name, n, 2, 2, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage) ||
        !exArgNum(mut p, name, tys, poss, 0, "y", usage) || !exArgNum(mut p, name, tys, poss, 1, "x", usage)) {
        return 0;
      }
      exEmit(mut p, EX_F2, EXF2_ATAN2, EXPR_NUM, 2, 1);
      return EXPR_NUM;
    }
    case "pow":
    case "min":
    case "max":
    case "step": {
      const usage = `${name}(a, b)`;
      if (!exArgCount(mut p, name, n, 2, 2, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      const t = exArgSame(mut p, name, tys, poss, 0, 2, usage);
      if (t == 0) {
        return 0;
      }
      let f = EXF2_POW;
      if (name == "min") {
        f = EXF2_MIN;
      } else if (name == "max") {
        f = EXF2_MAX;
      } else if (name == "step") {
        f = EXF2_STEP;
      }
      exEmit(mut p, EX_F2, f, t, 2, 1);
      return t;
    }
    case "clamp": {
      const usage = "clamp(値, 下限, 上限)";
      if (!exArgCount(mut p, name, n, 3, 3, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      const t = exArgSame(mut p, name, tys, poss, 0, 3, usage);
      if (t == 0) {
        return 0;
      }
      exEmit(mut p, EX_F3, EXF3_CLAMP, t, 3, 1);
      return t;
    }
    case "mix":
    case "lerp": {
      const usage = `${name}(a, b, t)`;
      if (!exArgCount(mut p, name, n, 3, 3, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage) ||
        !exArgNum(mut p, name, tys, poss, 2, "割合 t", usage)) {
        return 0;
      }
      const t = exArgSame(mut p, name, tys, poss, 0, 2, usage);
      if (t == 0) {
        return 0;
      }
      exEmit(mut p, EX_F3, EXF3_MIX, t, 3, 1);
      return t;
    }
    case "smoothstep": {
      const usage = "smoothstep(下端, 上端, x)";
      if (!exArgCount(mut p, name, n, 3, 3, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      const t = exArgSame(mut p, name, tys, poss, 0, 3, usage);
      if (t == 0) {
        return 0;
      }
      exEmit(mut p, EX_F3, EXF3_SMOOTH, t, 3, 1);
      return t;
    }
    case "length":
    case "normalize": {
      const usage = `${name}(v)`;
      if (!exArgCount(mut p, name, n, 1, 1, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      if (name == "length") {
        exEmit(mut p, EX_LEN, tys[0], 0, 1, 1);
        return EXPR_NUM;
      }
      exEmit(mut p, EX_NORM, tys[0], 0, 1, 1);
      return tys[0];
    }
    case "distance":
    case "dot": {
      const usage = `${name}(a, b)`;
      if (!exArgCount(mut p, name, n, 2, 2, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      if (tys[0] != tys[1]) {
        return exFail(mut p, "expr-args", poss[1], `${name} の 2 つの引数の型が違います（${exprTypeName(tys[0])}と${exprTypeName(tys[1])}）`,
          `${usage} は同じ型どうしで使います`);
      }
      exEmit(mut p, name == "dot" ? EX_DOT : EX_DIST, tys[0], 0, 2, 1);
      return EXPR_NUM;
    }
    case "linear":
    case "ease":
    case "easeIn":
    case "easeOut": {
      const usage = `${name}(t, tMin, tMax, 値1, 値2) か ${name}(t, 値1, 値2)`;
      if (!exArgCount(mut p, name, n, 3, 5, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      if (n == 4) {
        return exFail(mut p, "expr-args", pos, `${name} の引数は 3 個か 5 個です（4 個あります）`, `${usage} のように書きます`);
      }
      if (!exArgNum(mut p, name, tys, poss, 0, "t", usage)) {
        return 0;
      }
      if (n == 5 && (!exArgNum(mut p, name, tys, poss, 1, "tMin", usage) || !exArgNum(mut p, name, tys, poss, 2, "tMax", usage))) {
        return 0;
      }
      const a = tys[n - 2];
      const b = tys[n - 1];
      if (a != b) {
        return exFail(mut p, "expr-args", poss[n - 1], `${name} の 値1 と 値2 の型が違います（${exprTypeName(a)}と${exprTypeName(b)}）`,
          `${usage} の 値1 と 値2 は同じ型で書きます`);
      }
      let kind = 0;
      if (name == "ease") {
        kind = 1;
      } else if (name == "easeIn") {
        kind = 2;
      } else if (name == "easeOut") {
        kind = 3;
      }
      exEmit(mut p, EX_INTERP, kind, n as i32, n as i32, 1);
      return a;
    }
    case "wiggle": {
      const usage = "wiggle(速さ, 振れ幅) か wiggle(速さ, 振れ幅, 重ねる数, 振れ幅の倍率, 時刻)";
      if (!exNoPixel(mut p, name, pos)) {
        return 0;
      }
      if (!exArgCount(mut p, name, n, 2, 5, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      let what: string[] = ["速さ（1 秒あたりの回数）", "振れ幅", "重ねる数", "振れ幅の倍率", "時刻"];
      for (let i: usize = 0; i < n; i++) {
        if (!exArgNum(mut p, name, tys, poss, i, what[i], usage)) {
          return 0;
        }
      }
      if (n < 3) {
        exPushNum(mut p, 1.0);
      }
      if (n < 4) {
        exPushNum(mut p, 0.5);
      }
      if (n < 5) {
        exIn(mut p, EXIN_TIME);
      }
      p.usesValue = true;
      const cs = p.calls;
      p.calls++;
      // 時刻を渡したら（5 引数）、基準の値はその時刻のキーフレームの値（AE と同じ）。a の 8 はその印
      if (n == 5) {
        p.usesKeys = true;
      }
      exEmit(mut p, EX_WIGGLE, p.valueType + (n == 5 ? 8 : 0), cs, 5, 1);
      return p.valueType;
    }
    case "noise": {
      const usage = "noise(x) か noise([x, y])";
      if (!exArgCount(mut p, name, n, 1, 1, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      if (tys[0] == EXPR_COLOR) {
        return exFail(mut p, "expr-args", poss[0], "noise の引数は数か 2 次元の値です", `${usage} のように書きます`);
      }
      exEmit(mut p, EX_NOISE, tys[0], 0, 1, 1);
      return EXPR_NUM;
    }
    case "random": {
      const usage = "random()、random(最大)、random(最小, 最大)";
      if (!exArgCount(mut p, name, n, 0, 2, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      let t = EXPR_NUM;
      if (n > 0) {
        t = exArgSame(mut p, name, tys, poss, 0, n, usage);
        if (t == 0) {
          return 0;
        }
      }
      p.usesRandom = true;
      if (!p.timeless) {
        p.usesTime = true;
      }
      const cs = p.calls;
      p.calls++;
      exEmit(mut p, EX_RAND, (n as i32) * 8 + t, cs, n as i32, 1);
      return t;
    }
    case "loopOut":
    case "loopIn": {
      const usage = `${name}('cycle')、${name}('pingpong', 2)`;
      if (!exNoPixel(mut p, name, pos)) {
        return 0;
      }
      if (!exArgCount(mut p, name, n, 0, 2, pos, usage)) {
        return 0;
      }
      let kind = 0;
      if (n >= 1) {
        if (tys[0] != 0) {
          return exFail(mut p, "expr-args", poss[0], `${name} の 1 番目の引数は種類の文字列です`, `${usage} のように書きます`);
        }
        const s = strs[0].clone();
        if (s == "cycle") {
          kind = 0;
        } else if (s == "pingpong") {
          kind = 1;
        } else if (s == "offset") {
          kind = 2;
        } else if (s == "continue") {
          kind = 3;
        } else {
          let cands: string[] = ["cycle", "pingpong", "offset", "continue"];
          const near = textNearest(s, cands);
          return exFail(mut p, "expr-args", poss[0], `${name} の種類に '${s}' はありません`,
            exDidYouMean(near, "種類は 'cycle'（繰り返す）、'pingpong'（往復）、'offset'（ずらして繰り返す）、'continue'（伸ばす）です"));
        }
      }
      if (n == 2 && !exArgNum(mut p, name, tys, poss, 1, "キーの数", usage)) {
        return 0;
      }
      if (n < 2) {
        exPushNum(mut p, 0.0);
      }
      p.usesKeys = true;
      p.usesTime = true;
      p.usesValue = true;
      exEmit(mut p, EX_LOOP, kind, name == "loopIn" ? 1 : 0, 1, 1);
      return p.valueType;
    }
    case "valueAtTime": {
      const usage = "valueAtTime(時刻)";
      if (!exNoPixel(mut p, name, pos)) {
        return 0;
      }
      if (!exArgCount(mut p, name, n, 1, 1, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage) ||
        !exArgNum(mut p, name, tys, poss, 0, "時刻", usage)) {
        return 0;
      }
      p.usesKeys = true;
      p.usesValue = true;
      exEmit(mut p, EX_VALAT, 0, 0, 1, 1);
      return p.valueType;
    }
    case "key": {
      const usage = "key(1).value か key(1).time";
      if (!exNoPixel(mut p, name, pos)) {
        return 0;
      }
      if (!exArgCount(mut p, name, n, 1, 1, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage) ||
        !exArgNum(mut p, name, tys, poss, 0, "番号（1 から）", usage)) {
        return 0;
      }
      if (!exExpect(mut p, ".", `${usage} のように .value か .time を続けます`)) {
        return 0;
      }
      const ppos = exPos(p);
      if (exTokIs(p, "value")) {
        p.k++;
        p.usesKeys = true;
        exEmit(mut p, EX_KEYV, 0, 0, 1, 1);
        return p.valueType;
      }
      if (exTokIs(p, "time")) {
        p.k++;
        p.usesKeys = true;
        exEmit(mut p, EX_KEYT, 0, 0, 1, 1);
        return EXPR_NUM;
      }
      return exFail(mut p, "expr-unknown-prop", ppos, "key(n) の後は .value か .time です", `${usage} のように書きます`);
    }
    case "rgb":
    case "hsl": {
      let comps = "h, s, l";
      if (name == "rgb") {
        comps = "r, g, b";
      }
      const usage = `${name}(${comps}) か ${name}(${comps}, a)（どれも 0〜1）`;
      if (!exArgCount(mut p, name, n, 3, 4, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      for (let i: usize = 0; i < n; i++) {
        if (!exArgNum(mut p, name, tys, poss, i, "成分", usage)) {
          return 0;
        }
      }
      exEmit(mut p, n == 3 ? EX_COL3 : EX_COL4, 0, 0, n as i32, 1);
      if (name == "hsl") {
        exEmit(mut p, EX_HSL2RGB, 0, 0, 1, 1);
      }
      return EXPR_COLOR;
    }
    case "hslToRgb":
    case "rgbToHsl": {
      const usage = `${name}([a, b, c, 1])`;
      if (!exArgCount(mut p, name, n, 1, 1, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      if (tys[0] != EXPR_COLOR) {
        return exFail(mut p, "expr-args", poss[0], `${name} の引数は色（4 つの成分）です（${exprTypeName(tys[0])}があります）`, `${usage} のように書きます`);
      }
      exEmit(mut p, name == "hslToRgb" ? EX_HSL2RGB : EX_RGB2HSL, 0, 0, 1, 1);
      return EXPR_COLOR;
    }
    case "vec2": {
      const usage = "vec2(x, y)";
      if (!exArgCount(mut p, name, n, 2, 2, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage) ||
        !exArgNum(mut p, name, tys, poss, 0, "x", usage) || !exArgNum(mut p, name, tys, poss, 1, "y", usage)) {
        return 0;
      }
      exEmit(mut p, EX_VEC2, 0, 0, 2, 1);
      return EXPR_VEC2;
    }
    case "timeToFrames":
    case "framesToTime": {
      let argName = "コマ数";
      if (name == "timeToFrames") {
        argName = "時刻";
      }
      const usage = `${name}(${argName})`;
      if (!exArgCount(mut p, name, n, 0, 1, pos, usage) || !exArgNoStr(mut p, name, tys, poss, usage)) {
        return 0;
      }
      if (n == 0) {
        if (name == "framesToTime") {
          return exFail(mut p, "expr-args", pos, "framesToTime の引数は 1 個です（0 個あります）", `${usage} のように書きます`);
        }
        exIn(mut p, EXIN_TIME);
      } else if (!exArgNum(mut p, name, tys, poss, 0, argName, usage)) {
        return 0;
      }
      exIn(mut p, EXIN_FPS);
      if (name == "timeToFrames") {
        exEmit(mut p, EX_MUL, 0, 0, 2, 1);
        exPushNum(mut p, 0.0001);
        exEmit(mut p, EX_ADD, 0, 0, 2, 1);
        exEmit(mut p, EX_F1, EXF1_FLOOR, EXPR_NUM, 1, 1);
      } else {
        exEmit(mut p, EX_DIV, 0, 0, 2, 1);
      }
      return EXPR_NUM;
    }
    default:
      break;
  }
  const cands = exNameCandidates(p);
  const near = textNearest(name, cands);
  return exFail(mut p, "expr-unknown-name", pos, `'${name}' という関数はありません`,
    exDidYouMean(near, "使える関数は wiggle、linear、ease、loopOut、random、sin、clamp などです（schema の expressions.functions）"));
}

// seedRandom(種, timeless) の文。引数は数の定数だけ。
function exParseSeed(p: mut ExP): bool {
  const pos = exPos(p);
  p.k++;
  if (!exExpect(mut p, "(", "seedRandom(5) か seedRandom(5, true) のように書きます")) {
    return false;
  }
  let vals: f64[] = [];
  while (!exTokIs(p, ")")) {
    const vpos = exPos(p);
    let neg = false;
    if (exTokIs(p, "-")) {
      neg = true;
      p.k++;
    }
    if (p.toks[p.k].kind == TK_NUM) {
      vals.push(neg ? -p.toks[p.k].num : p.toks[p.k].num);
    } else if (exTokIs(p, "true")) {
      vals.push(1.0);
    } else if (exTokIs(p, "false")) {
      vals.push(0.0);
    } else {
      exFail(mut p, "expr-args", vpos, "seedRandom の引数は数の定数だけです", "seedRandom(5) か seedRandom(5, true)（true ならコマが進んでも同じ乱数）と書きます");
      return false;
    }
    p.k++;
    if (exTokIs(p, ",")) {
      p.k++;
    } else if (!exTokIs(p, ")")) {
      exExpect(mut p, ")", "seedRandom(5, true) のように閉じます");
      return false;
    }
  }
  p.k++;
  if (vals.length < 1 || vals.length > 2) {
    exFail(mut p, "expr-args", pos, `seedRandom の引数は 1〜2 個です（${vals.length} 個あります）`, "seedRandom(5) か seedRandom(5, true) と書きます");
    return false;
  }
  p.seed = ((Math.floor(vals[0]) as i64) & 0x7fffffff) as i32;
  p.timeless = vals.length == 2 && vals[1] != 0;
  return true;
}

// 文の並び: (let a = 式;)* (seedRandom(...);)* 式 [;]
function exParseProgram(p: mut ExP): i32 {
  let result = 0;
  while (true) {
    if (p.toks[p.k].kind == TK_END) {
      break;
    }
    if (result != 0) {
      const pos = exPos(p);
      return exFail(mut p, "expr-syntax", pos, "結果の式の後に、まだ文があります",
        "途中の値は let a = ...; で名前を付けます。最後の式の値が結果になります");
    }
    if (exTokIs(p, ";")) {
      p.k++;
      continue;
    }
    if (exTokIs(p, "seedRandom")) {
      if (!exParseSeed(mut p)) {
        return 0;
      }
      continue;
    }
    // let a = ... / var a = ... / const a = ... / a = ...（AE の書き方）
    let isDecl = exTokIs(p, "let") || exTokIs(p, "var") || exTokIs(p, "const");
    let bare = false;
    if (!isDecl && p.toks[p.k].kind == TK_ID && p.toks[p.k + 1].kind == TK_P && p.toks[p.k + 1].text == "=") {
      isDecl = true;
      bare = true;
    }
    if (isDecl) {
      if (!bare) {
        p.k++;
      }
      const npos = exPos(p);
      if (p.toks[p.k].kind != TK_ID) {
        exFail(mut p, "expr-syntax", npos, "let の後には名前が必要です", "let a = wiggle(2, 30); のように書きます");
        return 0;
      }
      const name = p.toks[p.k].text.clone();
      if (name == "time" || name == "value" || name == "index" || name == "thisLayer" || name == "thisComp" || name == "uv" ||
        name == "px" || name == "src" || exF1Code(name) >= 0 || name == "wiggle" || name == "clip") {
        return exFail(mut p, "expr-syntax", npos, `'${name}' は決まった名前なので、変数の名前にできません`, "別の名前（a、w、pos など）にします");
      }
      p.k++;
      if (!exExpect(mut p, "=", `let ${name} = 1; のように = で値を決めます`)) {
        return 0;
      }
      const t = exParseCond(mut p);
      if (t == 0) {
        return 0;
      }
      let slot = exFindLocal(p, name);
      if (slot >= 0) {
        if (p.locTypes[slot as usize] != t) {
          return exFail(mut p, "expr-type", npos, `'${name}' は${exprTypeName(p.locTypes[slot as usize])}ですが、${exprTypeName(t)}を入れようとしています`,
            "別の名前の変数にします");
        }
      } else {
        slot = p.locNames.length as i32;
        const lim = p.mode == EXPR_MODE_PIXEL ? EXPR_PIXEL_LOCALS : EXPR_MAX_LOCALS;
        if (slot >= lim) {
          return exFail(mut p, "expr-too-complex", npos, `変数が多すぎます（${lim} 個まで）`, "同じ変数を使い回すか、式をまとめます");
        }
        p.locNames.push(name.clone());
        p.locTypes.push(t);
      }
      exEmit(mut p, EX_LSET, slot, 0, 1, 0);
      if (!exTokIs(p, ";")) {
        if (p.toks[p.k].kind == TK_END) {
          const epos = exPos(p);
          return exFail(mut p, "expr-syntax", epos, "変数を決めただけで、結果の式がありません", `最後に ${name} * 2 のような結果の式を書きます`);
        }
        exExpect(mut p, ";", "文と文の間は ; で区切ります");
        return 0;
      }
      p.k++;
      continue;
    }
    result = exParseCond(mut p);
    if (result == 0) {
      return 0;
    }
    if (exTokIs(p, ";")) {
      p.k++;
    } else if (p.toks[p.k].kind != TK_END) {
      const pos = exPos(p);
      const d = exTokDesc(p);
      return exFail(mut p, "expr-syntax", pos, `${d} はここには書けません（式はここで終わっています）`,
        "演算子（+ - * /）が抜けていないか、かっこの数が合っているかを確かめます");
    }
  }
  if (result == 0) {
    const pos = exPos(p);
    return exFail(mut p, "expr-syntax", pos, "式が空です", "expr(\"wiggle(2, 30)\") のように、値を求める式を書きます");
  }
  return result;
}

function exEmptyProg(src: string, valueType: i32, mode: i32, line: i32, col: i32): ExprProg {
  return {
    ok: false, src: src.clone(), type: 0, valueType, mode, code: [], consts: [], nLocals: 0, maxStack: 0,
    refClip: [], refSlot: [], refType: [], refCol: [], refLayer: [], seed: 0, keySeed: 0, idSeed: 0, hasId: false, timeless: false,
    usesTime: false, usesKeys: false, usesRefs: false, usesValue: false, usesRandom: false, line, col,
  };
}

// 式を解析して中間の形にする。
// - src: 式の文字列（expr("...") の中身）。
// - valueType: その値の型（x なら EXPR_NUM、position なら EXPR_VEC2、色なら EXPR_COLOR）。結果の型と value の型になる。
//   画素の式（mode = EXPR_MODE_PIXEL）では EXPR_COLOR か EXPR_NUM（明るさ）を渡す（EXPR_ANY ならどちらでも）。
// - line / col: 診断の行と、式の最初の文字の列（.mzc の行の中の位置。1 から）。
// 誤りは diags に 1 つ足し、ok が false の ExprProg を返す。
export function exprCompile(src: string, valueType: i32, mode: i32, env: ExprEnv, line: i32, col: i32, diags: mut Diag[]): ExprProg {
  let prog = exEmptyProg(src, valueType, mode, line, col);
  if ((src.length as i32) > EXPR_MAX_SRC) {
    diags.push(diag("expr-too-complex", line, col, `式が長すぎます（${EXPR_MAX_SRC} バイトまで）`, "let で分けるか、式を短くします"));
    return prog;
  }
  let toks: ExTok[] = [];
  let err: ExErr = { has: false, code: "", pos: 0, msg: "", hint: "" };
  exLex(src, mut toks, mut err);
  if (err.has) {
    diags.push(diag(err.code, line, col + textCharCol(src, err.pos as usize) - 1, err.msg, err.hint));
    return prog;
  }
  let envc: ExprEnv = { names: [], slots: env.slots.clone(), types: env.types.clone(), nslots: env.nslots, parts: env.parts.clone() };
  for (const n of env.names) {
    envc.names.push(n.clone());
  }
  let vt = valueType;
  if (mode == EXPR_MODE_PIXEL) {
    vt = EXPR_COLOR;
  }
  let p: ExP = {
    toks, k: 0, code: [], consts: [], sp: 0, maxSp: 0, depth: 0, err,
    locNames: [], locTypes: [], refClip: [], refSlot: [], refType: [], refCol: [], env: envc, mode,
    valueType: vt == EXPR_ANY ? EXPR_NUM : vt, calls: 0, seed: 0, timeless: false,
    usesTime: false, usesKeys: false, usesRefs: false, usesValue: false, usesRandom: false,
  };
  const t = exParseProgram(mut p);
  if (t != 0) {
    // 結果の型
    if (mode == EXPR_MODE_PIXEL) {
      if (t == EXPR_VEC2 || (valueType != EXPR_ANY && t != valueType && !(valueType == EXPR_COLOR && t == EXPR_NUM))) {
        exFail(mut p, "expr-type", 0, `画素の式の結果は色（[r, g, b, a]）か数（明るさ）です。この式は${exprTypeName(t)}を返します`,
          "rgb(uv.x, uv.y, 0.5) や src * 0.5 のように、色を返します");
      }
    } else if (valueType != EXPR_ANY && t != valueType) {
      let hint = "";
      if (valueType == EXPR_VEC2) {
        hint = "[x, y] の形で返します（例: [value[0] + 10, value[1]]）";
      } else if (valueType == EXPR_COLOR) {
        hint = "[r, g, b, a]（0〜1）か rgb(r, g, b) の形で返します";
      } else if (t == EXPR_VEC2) {
        hint = "数の値には、2 次元の値の .x や .y（value[0]）を使います";
      } else {
        hint = "数の値には、色の .r などの成分を使います";
      }
      exFail(mut p, "expr-type", 0, `この式の値は${exprTypeName(t)}ですが、ここには${exprTypeName(valueType)}が要ります`, hint);
    }
  }
  if (!p.err.has) {
    const lim = mode == EXPR_MODE_PIXEL ? EXPR_PIXEL_STACK : EXPR_MAX_STACK;
    if (p.maxSp > lim) {
      exFail(mut p, "expr-too-complex", 0, `式が込み入りすぎています（途中の値が ${p.maxSp} 個。${lim} 個まで）`,
        "let で途中の値に名前を付けて、式を分けます");
    } else if ((p.code.length as i32) / 3 > EXPR_MAX_CODE) {
      exFail(mut p, "expr-too-complex", 0, `式が長すぎます（命令が ${(p.code.length as i32) / 3} 個。${EXPR_MAX_CODE} 個まで）`,
        "式を短くします");
    }
  }
  if (p.err.has) {
    diags.push(diag(p.err.code, line, col + textCharCol(src, p.err.pos as usize) - 1, p.err.msg, p.err.hint));
    return prog;
  }
  prog.ok = true;
  prog.type = t;
  prog.valueType = p.valueType;
  prog.code = p.code.clone();
  prog.consts = p.consts.clone();
  prog.nLocals = p.locNames.length as i32;
  prog.maxStack = p.maxSp;
  for (const c of p.refClip) {
    prog.refClip.push(c.clone());
    prog.refLayer.push(-1);
  }
  prog.refSlot = p.refSlot.clone();
  prog.refType = p.refType.clone();
  for (const c of p.refCol) {
    prog.refCol.push(col + textCharCol(src, c as usize) - 1);
  }
  prog.seed = p.seed;
  prog.timeless = p.timeless;
  prog.usesTime = p.usesTime;
  prog.usesKeys = p.usesKeys;
  prog.usesRefs = p.usesRefs;
  prog.usesValue = p.usesValue;
  prog.usesRandom = p.usesRandom;
  return prog;
}

// 参照（clip('id')）をクリップの番号に結ぶ。見つからない ID は expr-unknown-clip。全部見つかれば true。
// layers の順と id が変わったら（行を足した・消した）呼び直す。thisLayer の参照（""）は ExprCtx.self を使うので結ばない。
export function exprLink(p: mut ExprProg, sc: ExprScene, diags: mut Diag[]): bool {
  let ok = true;
  for (let i: usize = 0; i < p.refClip.length; i++) {
    p.refLayer[i] = -1;
    if (p.refClip[i] == "") {
      continue;
    }
    for (let j: usize = 0; j < sc.layers.length; j++) {
      if (sc.layers[j].id == p.refClip[i]) {
        p.refLayer[i] = j as i32;
      }
    }
    if (p.refLayer[i] < 0) {
      let cands: string[] = [];
      for (const l of sc.layers) {
        if (l.id != "") {
          cands.push(l.id.clone());
        }
      }
      const near = textNearest(p.refClip[i], cands);
      diags.push(diag("expr-unknown-clip", p.line, p.refCol[i], `'${p.refClip[i]}' という ID のクリップはありません`,
        exDidYouMean(near, `id=${p.refClip[i]} を付けたクリップを指します`)));
      ok = false;
    }
  }
  return ok;
}

// ---- 評価（CPU、f64） ----

// 値の表（ExprCtx.curve）の時刻 t の値。表のあいだは直線で補い、表の外は端の値。
function exCurveValue(cx: ExprCtx, t: f64): ExprVal {
  const m = (cx.curve.length / 4) as i64;
  let u = (t - cx.curveT0) / cx.curveDt;
  if (!(u > 0)) {
    u = 0.0;
  }
  if (u > ((m - 1) as f64)) {
    u = (m - 1) as f64;
  }
  let i = Math.floor(u) as i64;
  if (i >= m - 1) {
    i = m - 1;
  }
  const f = u - (i as f64);
  const k = (i * 4) as usize;
  if (f <= 0 || i + 1 >= m) {
    return ev4(cx.curve[k], cx.curve[k + 1], cx.curve[k + 2], cx.curve[k + 3]);
  }
  let r = ev4(0.0, 0.0, 0.0, 0.0);
  for (let d = 0; d < 4; d++) {
    const a = cx.curve[k + (d as usize)];
    const b = cx.curve[k + 4 + (d as usize)];
    evSetLane(mut r, d, a + (b - a) * f);
  }
  return r;
}

// キーフレームの値（valueAtTime）。t はタイムラインの秒。値の表（curve）があればそれを、なければキーの interp で補う。
// キーがなければ value。
function exKeyValue(cx: ExprCtx, t: f64): ExprVal {
  if (cx.curve.length >= 4 && cx.curveDt > 0) {
    return exCurveValue(cx, t);
  }
  const n = cx.keys.length;
  if (n == 0) {
    return cx.value;
  }
  if (t <= cx.keys[0].t) {
    return cx.keys[0].v;
  }
  if (t >= cx.keys[n - 1].t) {
    return cx.keys[n - 1].v;
  }
  let i: usize = 0;
  while (i + 1 < n && cx.keys[i + 1].t <= t) {
    i++;
  }
  const a = cx.keys[i].v;
  const b = cx.keys[i + 1].v;
  const t0 = cx.keys[i].t;
  const t1 = cx.keys[i + 1].t;
  const ip = cx.keys[i].interp;
  if (ip == EXPR_KEY_HOLD || t1 <= t0) {
    return a;
  }
  let u = (t - t0) / (t1 - t0);
  if (ip == EXPR_KEY_EASE) {
    u = exCurve(1, u);
  } else if (ip == EXPR_KEY_EASEIN) {
    u = exCurve(2, u);
  } else if (ip == EXPR_KEY_EASEOUT) {
    u = exCurve(3, u);
  }
  return ev4(a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u, a.z + (b.z - a.z) * u, a.w + (b.w - a.w) * u);
}

// % の余り（JavaScript と同じ。符号は左の数と同じ。-1 % 3 = -1。x % 0 は数でない値で、式の結果なら value に戻す）。
function exTMod(a: f64, b: f64): f64 {
  if (b == 0 || !exFinite(a)) {
    const z = 0.0;
    return z / z;
  }
  const q = a / b;
  let tq = Math.floor(q);
  if (q < 0) {
    tq = Math.ceil(q);
  }
  return a - b * tq;
}

// 床の余り（ループの時刻に使う。結果は 0 以上 b 未満）。
function exMod(a: f64, b: f64): f64 {
  if (b == 0) {
    return 0.0;
  }
  return a - b * Math.floor(a / b);
}

// loopOut / loopIn。kind: 0 cycle、1 pingpong、2 offset、3 continue。
function exLoop(cx: ExprCtx, kind: i32, isIn: bool, nk0: f64): ExprVal {
  const n = cx.keys.length;
  if (n < 2) {
    return cx.value;
  }
  let nk = Math.floor(nk0) as i64;
  if (nk <= 0 || nk > (n as i64) - 1) {
    nk = (n as i64) - 1;
  }
  const t = cx.time;
  let i0: usize = 0;
  let i1: usize = 0;
  if (isIn) {
    i0 = 0;
    i1 = nk as usize;
  } else {
    i0 = n - 1 - (nk as usize);
    i1 = n - 1;
  }
  const ts = cx.keys[i0].t;
  const te = cx.keys[i1].t;
  const d = te - ts;
  if (d <= 0) {
    return cx.value;
  }
  if (!isIn && t <= te) {
    return cx.value;
  }
  if (isIn && t >= ts) {
    return cx.value;
  }
  if (kind == 3) {
    // continue: 端の速さで伸ばす
    if (isIn) {
      const a = cx.keys[0].v;
      const b = exKeyValue(cx, ts + Math.min(0.001, d));
      const h = Math.min(0.001, d);
      const dt = t - ts;
      return ev4(a.x + (b.x - a.x) / h * dt, a.y + (b.y - a.y) / h * dt, a.z + (b.z - a.z) / h * dt, a.w + (b.w - a.w) / h * dt);
    }
    const b = cx.keys[n - 1].v;
    const h = Math.min(0.001, d);
    const a = exKeyValue(cx, te - h);
    const dt = t - te;
    return ev4(b.x + (b.x - a.x) / h * dt, b.y + (b.y - a.y) / h * dt, b.z + (b.z - a.z) / h * dt, b.w + (b.w - a.w) / h * dt);
  }
  let tt = 0.0;
  let cycles = 0.0;
  if (kind == 1) {
    // pingpong
    if (isIn) {
      const m = exMod(ts - t, 2.0 * d);
      tt = m < d ? ts + m : te - (m - d);
    } else {
      const m = exMod(t - te, 2.0 * d);
      tt = m < d ? te - m : ts + (m - d);
    }
    return exKeyValue(cx, tt);
  }
  // cycle / offset: [ts, te] の動きを d ごとにくり返す。loopIn も loopOut も同じ式で、t = ts - k * d（周期の境目）は
  // その周期の始まり（ts の値。offset なら k 周期ぶん引いた値）になる。
  tt = ts + exMod(t - ts, d);
  cycles = Math.floor((t - ts) / d);
  const v = exKeyValue(cx, tt);
  if (kind == 2) {
    const a = cx.keys[i0].v;
    const b = cx.keys[i1].v;
    return ev4(v.x + (b.x - a.x) * cycles, v.y + (b.y - a.y) * cycles, v.z + (b.z - a.z) * cycles, v.w + (b.w - a.w) * cycles);
  }
  return v;
}

function exHslToRgb(c: ExprVal): ExprVal {
  const h = c.x - Math.floor(c.x);
  const s = Math.min(Math.max(c.y, 0.0), 1.0);
  const l = Math.min(Math.max(c.z, 0.0), 1.0);
  const q = l < 0.5 ? l * (1.0 + s) : l + s - l * s;
  const pp = 2.0 * l - q;
  let out = ev4(0.0, 0.0, 0.0, c.w);
  for (let k = 0; k < 3; k++) {
    let tc = h + (1.0 - (k as f64)) / 3.0;
    tc = tc - Math.floor(tc);
    let v = pp;
    if (tc < 1.0 / 6.0) {
      v = pp + (q - pp) * 6.0 * tc;
    } else if (tc < 0.5) {
      v = q;
    } else if (tc < 2.0 / 3.0) {
      v = pp + (q - pp) * (2.0 / 3.0 - tc) * 6.0;
    }
    evSetLane(mut out, k, v);
  }
  return out;
}

function exRgbToHsl(c: ExprVal): ExprVal {
  const mx = Math.max(c.x, Math.max(c.y, c.z));
  const mn = Math.min(c.x, Math.min(c.y, c.z));
  const sum = mx + mn;
  const l = sum * 0.5;
  if (mx == mn) {
    return ev4(0.0, 0.0, l, c.w);
  }
  const d = mx - mn;
  const s = l > 0.5 ? d / (2.0 - sum) : d / sum;
  let h = 0.0;
  if (mx == c.x) {
    h = (c.y - c.z) / d + (c.y < c.z ? 6.0 : 0.0);
  } else if (mx == c.y) {
    h = (c.z - c.x) / d + 2.0;
  } else {
    h = (c.x - c.y) / d + 4.0;
  }
  return ev4(h / 6.0, s, l, c.w);
}

function exSplatIf(v: ExprVal, dims: i32): ExprVal {
  if (dims == EXPR_NUM) {
    return evS(v.x);
  }
  return v;
}

function exInput(cx: ExprCtx, sc: ExprScene, slot: i32): ExprVal {
  switch (slot) {
    case EXIN_TIME:
      return evS(cx.time);
    case EXIN_VALUE:
      return cx.value;
    case EXIN_INDEX:
      return evS(cx.index as f64);
    case EXIN_COMPW:
      return evS(sc.compW);
    case EXIN_COMPH:
      return evS(sc.compH);
    case EXIN_COMPDUR:
      return evS(sc.compDur);
    case EXIN_FPS:
      return evS(sc.fps);
    case EXIN_FRAMEDUR:
      return evS(sc.fps > 0 ? 1.0 / sc.fps : 0.0);
    default:
      return evS(0.0);
  }
}

// 式を評価する。値が数でなくなった成分があれば value に戻して bad を立てる。
export function exprEvalFull(p: ExprProg, cx: ExprCtx, sc: ExprScene): ExprResult {
  if (!p.ok) {
    return { v: cx.value, bad: false };
  }
  let st: ExprVal[32];
  let loc: ExprVal[16];
  let sp = 0;
  let pc: usize = 0;
  const n = p.code.length;
  while (pc < n) {
    const op = p.code[pc];
    const a = p.code[pc + 1];
    const b = p.code[pc + 2];
    pc += 3;
    switch (op) {
      case EX_PUSH: {
        const k = (a * 4) as usize;
        st[sp] = ev4(p.consts[k], p.consts[k + 1], p.consts[k + 2], p.consts[k + 3]);
        sp++;
        break;
      }
      case EX_IN:
        st[sp] = exInput(cx, sc, a);
        sp++;
        break;
      case EX_REF: {
        const ra = a as usize;
        let li = p.refLayer[ra];
        if (p.refClip[ra] == "") {
          li = cx.self;
        }
        if (li >= 0 && (li as usize) < sc.layers.length) {
          st[sp] = exprLayerGet(sc.layers[li as usize], p.refSlot[ra]);
        } else {
          st[sp] = evS(0.0);
        }
        sp++;
        break;
      }
      case EX_LGET:
        st[sp] = loc[a];
        sp++;
        break;
      case EX_LSET:
        sp--;
        loc[a] = st[sp];
        break;
      case EX_NEG: {
        const v = st[sp - 1];
        st[sp - 1] = ev4(-v.x, -v.y, -v.z, -v.w);
        break;
      }
      case EX_NOT:
        st[sp - 1] = evS(st[sp - 1].x == 0 ? 1.0 : 0.0);
        break;
      case EX_ADD: {
        sp--;
        const l = st[sp - 1];
        const r = st[sp];
        st[sp - 1] = ev4(l.x + r.x, l.y + r.y, l.z + r.z, l.w + r.w);
        break;
      }
      case EX_SUB: {
        sp--;
        const l = st[sp - 1];
        const r = st[sp];
        st[sp - 1] = ev4(l.x - r.x, l.y - r.y, l.z - r.z, l.w - r.w);
        break;
      }
      case EX_MUL: {
        sp--;
        const l = st[sp - 1];
        const r = st[sp];
        st[sp - 1] = ev4(l.x * r.x, l.y * r.y, l.z * r.z, l.w * r.w);
        break;
      }
      case EX_DIV: {
        sp--;
        const l = st[sp - 1];
        const r = st[sp];
        st[sp - 1] = ev4(l.x / r.x, l.y / r.y, l.z / r.z, l.w / r.w);
        break;
      }
      case EX_MOD: {
        sp--;
        const l = st[sp - 1];
        const r = st[sp];
        st[sp - 1] = ev4(exTMod(l.x, r.x), exTMod(l.y, r.y), exTMod(l.z, r.z), exTMod(l.w, r.w));
        break;
      }
      case EX_LT: {
        sp--;
        st[sp - 1] = evS(st[sp - 1].x < st[sp].x ? 1.0 : 0.0);
        break;
      }
      case EX_LE: {
        sp--;
        st[sp - 1] = evS(st[sp - 1].x <= st[sp].x ? 1.0 : 0.0);
        break;
      }
      case EX_GT: {
        sp--;
        st[sp - 1] = evS(st[sp - 1].x > st[sp].x ? 1.0 : 0.0);
        break;
      }
      case EX_GE: {
        sp--;
        st[sp - 1] = evS(st[sp - 1].x >= st[sp].x ? 1.0 : 0.0);
        break;
      }
      case EX_EQ:
      case EX_NE: {
        sp--;
        const l = st[sp - 1];
        const r = st[sp];
        let eq = l.x == r.x;
        if (a >= 2) {
          eq = eq && l.y == r.y;
        }
        if (a == 4) {
          eq = eq && l.z == r.z && l.w == r.w;
        }
        if (op == EX_NE) {
          eq = !eq;
        }
        st[sp - 1] = evS(eq ? 1.0 : 0.0);
        break;
      }
      case EX_AND: {
        sp--;
        st[sp - 1] = evS(st[sp - 1].x != 0 && st[sp].x != 0 ? 1.0 : 0.0);
        break;
      }
      case EX_OR: {
        sp--;
        st[sp - 1] = evS(st[sp - 1].x != 0 || st[sp].x != 0 ? 1.0 : 0.0);
        break;
      }
      case EX_SEL: {
        sp -= 2;
        const c = st[sp - 1].x;
        st[sp - 1] = c != 0 ? st[sp] : st[sp + 1];
        break;
      }
      case EX_SWZ:
        st[sp - 1] = evS(evLane(st[sp - 1], a));
        break;
      case EX_VEC2: {
        sp--;
        st[sp - 1] = ev4(st[sp - 1].x, st[sp].x, 0.0, 0.0);
        break;
      }
      case EX_COL3: {
        sp -= 2;
        st[sp - 1] = ev4(st[sp - 1].x, st[sp].x, st[sp + 1].x, 1.0);
        break;
      }
      case EX_COL4: {
        sp -= 3;
        st[sp - 1] = ev4(st[sp - 1].x, st[sp].x, st[sp + 1].x, st[sp + 2].x);
        break;
      }
      case EX_F1: {
        const v = st[sp - 1];
        if (b == EXPR_NUM) {
          st[sp - 1] = evS(exF1(a, v.x));
        } else if (b == EXPR_VEC2) {
          st[sp - 1] = ev4(exF1(a, v.x), exF1(a, v.y), 0.0, 0.0);
        } else {
          st[sp - 1] = ev4(exF1(a, v.x), exF1(a, v.y), exF1(a, v.z), exF1(a, v.w));
        }
        break;
      }
      case EX_F2: {
        sp--;
        const l = st[sp - 1];
        const r = st[sp];
        if (b == EXPR_NUM) {
          st[sp - 1] = evS(exF2(a, l.x, r.x));
        } else {
          st[sp - 1] = ev4(exF2(a, l.x, r.x), exF2(a, l.y, r.y), exF2(a, l.z, r.z), exF2(a, l.w, r.w));
        }
        break;
      }
      case EX_F3: {
        sp -= 2;
        const x = st[sp - 1];
        const y = st[sp];
        const z = st[sp + 1];
        if (b == EXPR_NUM) {
          st[sp - 1] = evS(exF3(a, x.x, y.x, z.x));
        } else {
          st[sp - 1] = ev4(exF3(a, x.x, y.x, z.x), exF3(a, x.y, y.y, z.y), exF3(a, x.z, y.z, z.z), exF3(a, x.w, y.w, z.w));
        }
        break;
      }
      case EX_LEN:
      case EX_NORM: {
        const v = st[sp - 1];
        let s = v.x * v.x;
        if (a >= 2) {
          s = s + v.y * v.y;
        }
        if (a == 4) {
          s = s + v.z * v.z;
        }
        const len = a == EXPR_NUM ? Math.abs(v.x) : Math.sqrt(s);
        if (op == EX_LEN) {
          st[sp - 1] = evS(len);
        } else if (len > 0) {
          st[sp - 1] = ev4(v.x / len, v.y / len, v.z / len, a == 4 ? v.w : v.w / len);
        } else {
          st[sp - 1] = evS(0.0);
        }
        break;
      }
      case EX_DOT:
      case EX_DIST: {
        sp--;
        const l = st[sp - 1];
        const r = st[sp];
        if (op == EX_DOT) {
          let s = l.x * r.x;
          if (a >= 2) {
            s = s + l.y * r.y;
          }
          if (a == 4) {
            s = s + l.z * r.z;
          }
          st[sp - 1] = evS(s);
        } else {
          const dx = l.x - r.x;
          const dy = a >= 2 ? l.y - r.y : 0.0;
          const dz = a == 4 ? l.z - r.z : 0.0;
          st[sp - 1] = evS(a == EXPR_NUM ? Math.abs(dx) : Math.sqrt(dx * dx + dy * dy + dz * dz));
        }
        break;
      }
      case EX_INTERP: {
        sp -= b - 1;
        const base = sp - 1;
        const tv = st[base].x;
        let u = 0.0;
        let v1 = st[base + 1];
        let v2 = st[base + 2];
        if (b == 5) {
          let t0 = st[base + 1].x;
          let t1 = st[base + 2].x;
          v1 = st[base + 3];
          v2 = st[base + 4];
          if (t0 > t1) {
            const tmp = t0;
            t0 = t1;
            t1 = tmp;
            const tv1 = v1;
            v1 = v2;
            v2 = tv1;
          }
          if (t1 > t0) {
            u = (tv - t0) / (t1 - t0);
          } else {
            u = tv < t0 ? 0.0 : 1.0;
          }
        } else {
          u = tv;
        }
        u = Math.min(Math.max(u, 0.0), 1.0);
        u = exCurve(a, u);
        st[base] = ev4(v1.x + (v2.x - v1.x) * u, v1.y + (v2.y - v1.y) * u, v1.z + (v2.z - v1.z) * u, v1.w + (v2.w - v1.w) * u);
        break;
      }
      case EX_WIGGLE: {
        sp -= 4;
        const base = sp - 1;
        const freq = st[base].x;
        const amp = st[base + 1].x;
        let oct = Math.floor(st[base + 2].x) as i32;
        const mult = st[base + 3].x;
        const tt = st[base + 4].x;
        if (oct < 1) {
          oct = 1;
        }
        if (oct > 10) {
          oct = 10;
        }
        // 種: 式の種・値の名前・クリップの ID・呼び出しの場所（x と y で違う揺れ。行を足しても変わらない）
        let h = exIdSeed(p, cx, 0x68e31da4);
        h = exprHash(h ^ ((b as u32) * 0x85ebca6b));
        const ty = a % 8;
        // 時刻を渡したら、その時刻の値（valueAtTime(t)）に揺れを足す
        const baseV = a >= 8 ? exKeyValue(cx, tt) : cx.value;
        let out = baseV;
        const dims = ty == EXPR_COLOR ? 4 : ty;
        for (let d = 0; d < dims; d++) {
          let s = 0.0;
          let f = freq;
          let am = amp;
          for (let o = 0; o < oct; o++) {
            const sd = exprHash(h ^ (((d * 16 + o) as u32) * 0x27d4eb2f));
            s = s + am * exWiggleNoise(tt * f + (o as f64) * 0.37, sd);
            f = f * 2.0;
            am = am * mult;
          }
          evSetLane(mut out, d, evLane(baseV, d) + s);
        }
        st[base] = exSplatIf(out, ty);
        break;
      }
      case EX_NOISE: {
        const v = st[sp - 1];
        const sd = exprHash((p.seed as u32) ^ 0x1b873593);
        if (a == EXPR_VEC2) {
          st[sp - 1] = evS(exNoise2(v.x, v.y, sd));
        } else {
          st[sp - 1] = evS(exNoise1(v.x, sd));
        }
        break;
      }
      case EX_RAND: {
        const nargs = a / 8;
        const ty = a % 8;
        const h = exRandSeed(p, cx, sc.fps, b);
        let r = ev4(0.0, 0.0, 0.0, 0.0);
        for (let d = 0; d < 4; d++) {
          evSetLane(mut r, d, exprHashF(h + (d as u32)) as f64);
        }
        if (ty == EXPR_NUM) {
          r = evS(r.x);
        }
        if (nargs == 0) {
          st[sp] = r;
          sp++;
        } else if (nargs == 1) {
          const m = st[sp - 1];
          st[sp - 1] = ev4(r.x * m.x, r.y * m.y, r.z * m.z, r.w * m.w);
        } else {
          sp--;
          const lo = st[sp - 1];
          const hi = st[sp];
          st[sp - 1] = ev4(lo.x + (hi.x - lo.x) * r.x, lo.y + (hi.y - lo.y) * r.y, lo.z + (hi.z - lo.z) * r.z, lo.w + (hi.w - lo.w) * r.w);
        }
        break;
      }
      case EX_LOOP:
        st[sp - 1] = exSplatIf(exLoop(cx, a, b == 1, st[sp - 1].x), p.valueType);
        break;
      case EX_VALAT:
        st[sp - 1] = exSplatIf(exKeyValue(cx, st[sp - 1].x), p.valueType);
        break;
      case EX_KEYV:
      case EX_KEYT: {
        const nk = cx.keys.length as i64;
        let ki = (Math.floor(st[sp - 1].x + 0.5) as i64) - 1;
        if (nk == 0) {
          st[sp - 1] = op == EX_KEYV ? cx.value : evS(0.0);
        } else {
          if (ki < 0) {
            ki = 0;
          }
          if (ki >= nk) {
            ki = nk - 1;
          }
          st[sp - 1] = op == EX_KEYV ? exSplatIf(cx.keys[ki as usize].v, p.valueType) : evS(cx.keys[ki as usize].t);
        }
        break;
      }
      case EX_NKEYS:
        st[sp] = evS(cx.keys.length as f64);
        sp++;
        break;
      case EX_HSL2RGB:
        st[sp - 1] = exHslToRgb(st[sp - 1]);
        break;
      case EX_RGB2HSL:
        st[sp - 1] = exRgbToHsl(st[sp - 1]);
        break;
      default:
        break;
    }
  }
  if (sp < 1) {
    return { v: cx.value, bad: true };
  }
  let r = st[sp - 1];
  const dims = p.type == EXPR_COLOR ? 4 : p.type;
  let bad = false;
  for (let d = 0; d < dims; d++) {
    if (!exFinite(evLane(r, d))) {
      bad = true;
      evSetLane(mut r, d, evLane(cx.value, d));
    }
  }
  if (p.type == EXPR_NUM) {
    r = evS(r.x);
  } else if (p.type == EXPR_VEC2) {
    r.z = 0.0;
    r.w = 0.0;
  }
  return { v: r, bad };
}

export function exprEval(p: ExprProg, cx: ExprCtx, sc: ExprScene): ExprVal {
  return exprEvalFull(p, cx, sc).v;
}

// 数の値の式を評価する（x、opacity など）。
export function exprEvalNum(p: ExprProg, cx: ExprCtx, sc: ExprScene): f64 {
  return exprEvalFull(p, cx, sc).v.x;
}
