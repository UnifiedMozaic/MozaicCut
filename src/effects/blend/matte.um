// M6 合成: トラックマット。別のクリップ（マットの元）の アルファ か 輝度 を、キャンバスの大きさの f32 の Buffer にする。
// 重ねる側は mblComposite に MBL_USE_MATTE を立てて渡す（層のアルファに掛かる）。
//
// 手順（render.um に組み込むとき）:
//   1. マットの元のクリップを、透明（0,0,0,0）に消したキャンバスの大きさの作業用の Buffer に、mblCompositeLayer（通常）で描く。
//      作業用の Buffer のアルファが 1 より小さいので、mblMix が source-over でアルファも合成する（render.um の composite は
//      アルファを 1 にしてしまうので使わない）。flags に MBL_DST_OPAQUE は立てない。
//      マットの元のマスク・効果・不透明度・フェードも掛ける（After Effects と同じく、マットの元の層の不透明度はマットに効く）。
//      マットの元自身の blend= / matte= は使わない（マットの連鎖は spec.um の mblCheckMattes が matte-chain で止める）。
//   2. mblMatteFrom でマットにする。
//   3. マットの元のクリップ自身はキャンバスに描かない（After Effects と同じく、マットに使った層は隠れる）。
//
// - アルファ（alpha）: マットの元のアルファ。
// - 輝度（luma）: マットの元の輝度（BT.709 の係数、表示の値。映像の Y' と同じ）× アルファ。透明な所は黒と同じ（0）。
// - 反転: 1 - 値。

import { mblLum, mblNormName } from "./blend.um";

export const MBL_MATTE_ALPHA: u32 = 0;
export const MBL_MATTE_LUMA: u32 = 1;

export function mblMatteName(k: u32): string {
  if (k == MBL_MATTE_LUMA) {
    return "luma";
  }
  return "alpha";
}

// 大文字・小文字は区別しない（mblNormName）。
export function mblMatteFind(s0: string): i32 {
  const s = mblNormName(s0);
  if (s == "alpha" || s == "a") {
    return MBL_MATTE_ALPHA as i32;
  }
  if (s == "luma" || s == "luminance" || s == "l") {
    return MBL_MATTE_LUMA as i32;
  }
  return -1;
}

export kernel function mblMatteKernel(i: u32, matte: mut Buffer<f32>, src: Buffer<vec4<f32>>, kind: u32, invert: u32): void {
  const s = src[i];
  let v = s.w;
  if (kind == MBL_MATTE_LUMA) {
    v = Math.min(Math.max(mblLum(vec3(s.x, s.y, s.z)), 0.0), 1.0) * s.w;
  }
  if (invert != 0) {
    v = 1.0 - v;
  }
  matte[i] = v;
}

kernel function mblClearV4(i: u32, b: mut Buffer<vec4<f32>>): void {
  b[i] = vec4(0.0, 0.0, 0.0, 0.0);
}

// 作業用の Buffer を透明にする（マットの元を描く前に）。
export function mblClearTransparent(b: mut Buffer<vec4<f32>>): void {
  dispatch(mblClearV4, b.length, mut b);
}

// src（キャンバスの大きさ、マットの元を描いたもの）から matte を作る。
export function mblMatteFrom(matte: mut Buffer<f32>, src: Buffer<vec4<f32>>, kind: u32, invert: bool): void {
  let inv: u32 = 0;
  if (invert) {
    inv = 1;
  }
  dispatch(mblMatteKernel, src.length, mut matte, src, kind, inv);
}
