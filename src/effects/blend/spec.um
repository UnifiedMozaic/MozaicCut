// M6 合成: .mzc に書く描画モード・トラックマット・マスクの読み取りと確かめ（診断は project.um の Diag の形）。
//
// クリップの行（video / image / text / color）のキー:
//   blend=<描画モード>          normal（既定）/ add / multiply / screen / overlay / softlight / hardlight / lighten /
//                               darken / difference / exclusion / hue / saturation / color / luminosity
//   blend.space=display|linear  計算する値（既定は project の blend.space、それもなければ display）
//   matte=<クリップの ID>       トラックマットの元（そのクリップは画面に描かず、マットにだけ使う）
//   matte.type=alpha|luma       マットの種類（既定 alpha）
//   matte.invert[=1|0]          マットを反転する
// project の行のキー:
//   blend.space=display|linear  クリップの blend.space の既定
//   blend.tf=bt1886|srgb|bt709  線形の光に戻す伝達関数（既定 bt1886。映像の表示の EOTF（γ2.4）。Resolve のタイムラインの既定と同じ）
// マスクの行（新しい行の種類 mask。時間を持たず、クリップの層に掛かる）:
//   mask rect|ellipse|path to=<クリップの ID> [ref=WxH | units=norm] [x= y= w= h=] [round=] [d="M ..."] [mode=] [invert]
//        [feather=] [expand=] [opacity=]
//   to= は必ず書く（ops はいつも書く）。読むときは省略を許し、すぐ上の（mask でない）映像の行に掛ける（mblImplicitTarget）。
//   上から順に重ねる。
//
// 列挙の値（blend / blend.space / blend.tf / matte.type / mask の形・mode・units、真偽の値）は、どれも大文字・小文字と
// ハイフン・下線を区別しない（mblNormName で比べる）。
import { Diag, diag, warnDiag } from "../../engine/project.um";
import { KeyInfo } from "../../engine/keys.um";
import { parseNum, isNan, textNearest, sub } from "../../engine/text.um";
import {
  MBL_NORMAL, MBL_SPACE_DISPLAY, MBL_SPACE_LINEAR, MBL_TF_SRGB, MBL_TF_BT709, MBL_TF_BT1886,
  mblModeFind, mblModeSuggest, mblModeNames, mblModeName, mblModeLabel, mblModeDoc, MBL_MODE_COUNT, mblNormName,
} from "./blend.um";
import {
  MblMask, MBL_SHAPE_PATH, MBL_SHAPE_RECT, MBL_UNITS_PX, MBL_UNITS_NORM, mblDefaultMask, mblShapeFind, mblMaskModeFind,
  mblMaskModeNames, mblParsePath, mblMaskModeName, mblMaskModeLabel, MBL_MASK_MODE_COUNT,
} from "./mask.um";
import { MBL_MATTE_ALPHA, mblMatteFind } from "./matte.um";

export struct MblClipSpec {
  mode: u32;
  space: u32;
  matte: string;      // "" ならマットなし
  matteKind: u32;
  matteInvert: bool;
  // blend / matte のキーを 1 つでも書いたか（書いていなければ、render.um は今までどおりの道を通る）
  used: bool;
}

export struct MblProjectSpec {
  space: u32;
  tf: u32;
}

export struct MblMaskLine {
  ok: bool;
  to: string;         // 書いた to=（"" なら、すぐ上の映像の行。mblImplicitTarget で決める）
  mask: MblMask;
}

// 既定の伝達関数（project の blend.tf を書かないとき）
export const MBL_TF_DEFAULT: u32 = MBL_TF_BT1886;

// クリップの行で、このモジュールが受け持つキーか（project.um の unknown-key の判断に使う）。
export function mblIsClipKey(key: string): bool {
  return key == "blend" || key == "blend.space" || key == "matte" || key == "matte.type" || key == "matte.invert";
}

export function mblIsProjectKey(key: string): bool {
  return key == "blend.space" || key == "blend.tf";
}

// 値のない語として書ける、このモジュールのクリップのキー（project.um の字句では key のない語になるので、
// 組み込み側で (key, "") にして kv に足す。mute と同じ扱い）。
export function mblIsBareClipFlag(word: string): bool {
  return word == "matte.invert";
}

export function mblMaskKeys(): string[] {
  return ["to", "ref", "units", "x", "y", "w", "h", "round", "d", "mode", "invert", "feather", "expand", "opacity"];
}

function mblColAt(cols: i32[], k: usize): i32 {
  if (k < cols.length) {
    return cols[k];
  }
  return 0;
}

function mblList(xs: string[]): string {
  let s = "";
  for (const x of xs) {
    if (s != "") {
      s = s + " / ";
    }
    s = s + x;
  }
  return s;
}

function mblEnumErr(diags: mut Diag[], key: string, val: string, opts: string[], line: i32, col: i32): void {
  const near = textNearest(mblNormName(val), opts);
  let hint = `${mblList(opts)} のどれかです`;
  if (near != "") {
    hint = `'${near}' のことですか？（${mblList(opts)} のどれか）`;
  }
  diags.push(diag("bad-enum", line, col, `'${key}' の値 '${val}' は使えません`, hint));
}

// 0 / 1 の語。読めなければ -1。
function mblFlag(val0: string): i32 {
  const val = mblNormName(val0);
  if (val == "" || val == "1" || val == "true" || val == "on" || val == "yes") {
    return 1;
  }
  if (val == "0" || val == "false" || val == "off" || val == "no") {
    return 0;
  }
  return -1;
}

function mblSpaceFind(val0: string): i32 {
  const val = mblNormName(val0);
  if (val == "display" || val == "signal" || val == "gamma") {
    return MBL_SPACE_DISPLAY as i32;
  }
  if (val == "linear" || val == "light") {
    return MBL_SPACE_LINEAR as i32;
  }
  return -1;
}

function mblTfFind(val0: string): i32 {
  const val = mblNormName(val0);
  if (val == "srgb") {
    return MBL_TF_SRGB as i32;
  }
  if (val == "bt709" || val == "rec709") {
    return MBL_TF_BT709 as i32;
  }
  if (val == "bt1886" || val == "gamma2.4" || val == "gamma24") {
    return MBL_TF_BT1886 as i32;
  }
  return -1;
}

function mblUnitsFind(val0: string): i32 {
  const val = mblNormName(val0);
  if (val == "px" || val == "pixel" || val == "pixels") {
    return MBL_UNITS_PX as i32;
  }
  if (val == "norm" || val == "normalized" || val == "fraction") {
    return MBL_UNITS_NORM as i32;
  }
  return -1;
}

function mblEndsWithPercent(s: string): bool {
  return s.length > 1 && s[s.length - 1] == 37;
}

// 数を読んで範囲を確かめる。読めなければ NaN を返し、診断を足す。
function mblNum(diags: mut Diag[], key: string, val: string, lo: f64, hi: f64, line: i32, col: i32): f64 {
  const v = parseNum(val);
  if (isNan(v)) {
    let hint = `${key}=12.5 のように書きます`;
    if (mblEndsWithPercent(val)) {
      const pv = parseNum(sub(val, 0, val.length - 1));
      if (!isNan(pv) && hi <= 1) {
        hint = `'${pv / 100}' のことですか？（${key} は ${lo}〜${hi} の割合で書きます。50% は 0.5）`;
      } else {
        hint = `${key} は % を付けずに数で書きます`;
      }
    }
    diags.push(diag("bad-number", line, col, `'${key}' の値 '${val}' は数として読めません`, hint));
    return v;
  }
  if (v < lo || v > hi) {
    let hint = `${lo}〜${hi} で書きます`;
    if (hi <= 1 && v >= 5 && v <= 100) {
      hint = `'${v / 100}' のことですか？（${key} は ${lo}〜${hi} の割合で書きます。${v}% なら ${v / 100}）`;
    }
    diags.push(diag("out-of-range", line, col, `'${key}' の値 ${val} は範囲の外です`, hint));
    return parseNum("nan");
  }
  return v;
}

export function mblProjectSpec(kv: string[], cols: i32[], line: i32, diags: mut Diag[]): MblProjectSpec {
  let r: MblProjectSpec = { space: MBL_SPACE_DISPLAY, tf: MBL_TF_DEFAULT };
  let k: usize = 0;
  while (k + 1 < kv.length) {
    const key = kv[k].clone();
    const val = kv[k + 1].clone();
    const col = mblColAt(cols, k / 2);
    if (key == "blend.space") {
      const s = mblSpaceFind(val);
      if (s < 0) {
        mblEnumErr(mut diags, key, val, ["display", "linear"], line, col);
      } else {
        r.space = s as u32;
      }
    } else if (key == "blend.tf") {
      const t = mblTfFind(val);
      if (t < 0) {
        mblEnumErr(mut diags, key, val, ["bt1886", "srgb", "bt709"], line, col);
      } else {
        r.tf = t as u32;
      }
    }
    k += 2;
  }
  return r;
}

// クリップの行の kv（key, value, ... の順。project.um の Clip.kv）から描画モードとトラックマットを読む。
// cols は値の列（kv の組ごと。なければ空でよく、列は 0 になる）。値のない matte.invert は (matte.invert, "") で渡す。
export function mblClipSpec(kv: string[], cols: i32[], line: i32, defSpace: u32, diags: mut Diag[]): MblClipSpec {
  let r: MblClipSpec = { mode: MBL_NORMAL, space: defSpace, matte: "", matteKind: MBL_MATTE_ALPHA, matteInvert: false, used: false };
  let k: usize = 0;
  while (k + 1 < kv.length) {
    const key = kv[k].clone();
    const val = kv[k + 1].clone();
    const col = mblColAt(cols, k / 2);
    if (key == "blend") {
      r.used = true;
      const m = mblModeFind(val);
      if (m < 0) {
        const sg = mblModeSuggest(val);
        if (sg != "") {
          diags.push(diag("bad-enum", line, col,
            `'${key}' の値 '${val}' は使えません（カラー比較（明）/（暗）は画素の色を丸ごと選ぶモードで、まだありません）`,
            `'${sg}' のことですか？（チャンネルごとの比較。結果は少し違います）`));
        } else {
          mblEnumErr(mut diags, key, val, mblModeNames(), line, col);
        }
      } else {
        r.mode = m as u32;
      }
    } else if (key == "blend.space") {
      r.used = true;
      const s = mblSpaceFind(val);
      if (s < 0) {
        mblEnumErr(mut diags, key, val, ["display", "linear"], line, col);
      } else {
        r.space = s as u32;
      }
    } else if (key == "matte") {
      r.used = true;
      if (val == "") {
        diags.push(diag("bad-enum", line, col, "matte= にマットの元のクリップの ID がありません", "matte=title のように、マットに使うクリップの ID を書きます"));
      } else {
        r.matte = val.clone();
      }
    } else if (key == "matte.type") {
      r.used = true;
      const t = mblMatteFind(val);
      if (t < 0) {
        mblEnumErr(mut diags, key, val, ["alpha", "luma"], line, col);
      } else {
        r.matteKind = t as u32;
      }
    } else if (key == "matte.invert") {
      r.used = true;
      const f = mblFlag(val);
      if (f < 0) {
        diags.push(diag("bad-enum", line, col, `'${key}' の値 '${val}' は使えません`, `${key}=1 か ${key}=0 で書きます（${key} とだけ書いてもよい）`));
      } else {
        r.matteInvert = f == 1;
      }
    }
    k += 2;
  }
  if (r.matte == "" && (r.matteKind != MBL_MATTE_ALPHA || r.matteInvert)) {
    diags.push(diag("matte-missing", line, 0, "matte.type / matte.invert を書きましたが、matte=（マットの元）がありません",
      "matte=<マットに使うクリップの ID> も書きます"));
  }
  return r;
}

// 行の中の d= の値が引用符で始まるか（bad-path の列を合わせるため）。
function mblDQuoted(lineText: string): bool {
  let i: usize = 0;
  let inQ = false;
  while (i + 2 < lineText.length) {
    const c = lineText[i];
    if (c == 34) {
      inQ = !inQ;
    } else if (!inQ && c == 100 && lineText[i + 1] == 61 && (i == 0 || lineText[i - 1] == 32 || lineText[i - 1] == 9)) {
      return lineText[i + 2] == 34;
    }
    i++;
  }
  return false;
}

// "1920x1080" を読む。読めなければ w = -1。
struct MblWH {
  w: f64;
  h: f64;
}

function mblParseWH(s: string): MblWH {
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 120 || s[i] == 88) {
      const w = parseNum(sub(s, 0, i));
      const h = parseNum(sub(s, i + 1, s.length));
      if (isNan(w) || isNan(h) || w < 1 || h < 1 || w > 100000 || h > 100000) {
        return { w: -1, h: -1 };
      }
      return { w, h };
    }
  }
  return { w: -1, h: -1 };
}

// マスクの行を読む。shape は行の 2 番目の語（rect / ellipse / path）、kv はそのあとの key=value（値のない invert は
// (invert, "")）、cols は値の列（kv の組ごと。project.um の vcol と同じく、引用符で始まる値は引用符の列）、
// lineText は行そのもの（d の誤りの列を合わせるのに使う。"" なら d の値は引用符で囲まれているものとして数える）。
export function mblParseMaskLine(
  shape: string, shapeCol: i32, kv: string[], cols: i32[], line: i32, lineText: string, diags: mut Diag[],
): MblMaskLine {
  const before = diags.length;
  let sh = mblShapeFind(shape);
  if (sh < 0) {
    let hint = "mask rect / mask ellipse / mask path d=\"M ...\" のどれかで書きます";
    const near = textNearest(mblNormName(shape), ["rect", "ellipse", "path"]);
    if (near != "") {
      hint = `'${near}' のことですか？（rect / ellipse / path のどれか）`;
    }
    diags.push(diag("bad-mask-shape", line, shapeCol, `'${shape}' というマスクの形はありません`, hint));
    sh = MBL_SHAPE_RECT as i32;
  }
  let m = mblDefaultMask(sh as u32);
  let to = "";
  let hasD = false;
  let refCol = 0;
  let k: usize = 0;
  while (k + 1 < kv.length) {
    const key = kv[k].clone();
    const val = kv[k + 1].clone();
    const col = mblColAt(cols, k / 2);
    if (key == "to") {
      to = val.clone();
    } else if (key == "x" || key == "y") {
      const v = mblNum(mut diags, key, val, -100000, 100000, line, col);
      if (!isNan(v)) {
        if (key == "x") {
          m.x = v as f32;
        } else {
          m.y = v as f32;
        }
      }
    } else if (key == "w" || key == "h") {
      const v = mblNum(mut diags, key, val, 0, 100000, line, col);
      if (!isNan(v)) {
        if (key == "w") {
          m.w = v as f32;
        } else {
          m.h = v as f32;
        }
      }
    } else if (key == "round") {
      const v = mblNum(mut diags, key, val, 0, 100000, line, col);
      if (!isNan(v)) {
        m.round = v as f32;
      }
    } else if (key == "feather") {
      const v = mblNum(mut diags, key, val, 0, 1000, line, col);
      if (!isNan(v)) {
        m.feather = v as f32;
      }
    } else if (key == "expand") {
      const v = mblNum(mut diags, key, val, -1000, 1000, line, col);
      if (!isNan(v)) {
        m.expand = v as f32;
      }
    } else if (key == "opacity") {
      const v = mblNum(mut diags, key, val, 0, 1, line, col);
      if (!isNan(v)) {
        m.opacity = v as f32;
      }
    } else if (key == "mode") {
      const md = mblMaskModeFind(val);
      if (md < 0) {
        mblEnumErr(mut diags, key, val, mblMaskModeNames(), line, col);
      } else {
        m.mode = md as u32;
      }
    } else if (key == "units") {
      const u = mblUnitsFind(val);
      if (u < 0) {
        mblEnumErr(mut diags, key, val, ["px", "norm"], line, col);
      } else {
        m.units = u as u32;
      }
    } else if (key == "ref") {
      refCol = col;
      const wh = mblParseWH(val);
      if (wh.w < 0) {
        diags.push(diag("bad-number", line, col, `'ref' の値 '${val}' は大きさとして読めません`,
          "ref=1920x1080 のように、座標を書いたときの層の幅x高さ（1〜100000）で書きます"));
      } else {
        m.refW = wh.w as f32;
        m.refH = wh.h as f32;
      }
    } else if (key == "invert") {
      const f = mblFlag(val);
      if (f < 0) {
        diags.push(diag("bad-enum", line, col, `'invert' の値 '${val}' は使えません`, "invert=1 か invert=0 で書きます（invert とだけ書いてもよい）"));
      } else {
        m.invert = f == 1;
      }
    } else if (key == "d") {
      hasD = true;
      m.d = val.clone();
      const p = mblParsePath(val);
      if (!p.ok) {
        let q = 1;
        if (lineText != "" && !mblDQuoted(lineText)) {
          q = 0;
        }
        diags.push(diag("bad-path", line, col + p.errPos + q, `パスを読めません: ${p.err}`,
          "SVG の d と同じ書き方です（例: d=\"M 0 0 C 50 -20 150 -20 200 0 L 200 100 Z\"。M L H V C S Q T Z、小文字は相対）"));
      }
    } else {
      let hint = `マスクの行のキーは ${mblList(mblMaskKeys())} です`;
      const near = textNearest(key, mblMaskKeys());
      if (near != "") {
        hint = `'${near}' のことですか？`;
      }
      diags.push(diag("unknown-key", line, col, `'${key}' というマスクのキーはありません`, hint));
    }
    k += 2;
  }
  if (m.shape == MBL_SHAPE_PATH && !hasD) {
    diags.push(diag("bad-path", line, shapeCol, "mask path にパス（d=）がありません", "mask path d=\"M 10 10 L 200 10 L 100 150 Z\" のように書きます"));
  }
  if (m.shape != MBL_SHAPE_PATH && hasD) {
    diags.push(diag("key-not-allowed", line, 0, "d= はパスのマスク（mask path）だけで使えます", "mask path d=\"...\" と書きます"));
  }
  if (m.units == MBL_UNITS_NORM && m.refW > 0) {
    diags.push(diag("key-not-allowed", line, refCol, "ref= は units=px のときだけ使えます（units=norm の座標は層の大きさに対する割合）",
      "ref= か units=norm のどちらかを消します"));
  }
  return { ok: diags.length == before, to, mask: m };
}

// units=px で ref= のないマスクへの警告（組み込み側で、マスクの行を読んだ後に呼ぶ）。座標は今の層の画素として描くので、
// project の size・クリップの w / h / fit・プレビューの縮小で層の大きさが変わると、マスクが絵からずれる。
export function mblMaskRefWarn(m: MblMask, line: i32, diags: mut Diag[]): void {
  if (m.units == MBL_UNITS_PX && !(m.refW > 0)) {
    diags.push(warnDiag("mask-no-ref", line, 0, "座標を書いた層の大きさ（ref=）がないので、今の層の画素として描きます",
      "project の size やクリップの w / h を変えてもずれないように、ref=<幅>x<高さ> か units=norm を書きます"));
  }
}

// ---- 行の見分け（.mzc の行の文字列から。ops と project.um の組み込みで使う） ----

// 行の 1 番目の語（# の注釈の行や空の行は ""）。
export function mblHeadWord(line: string): string {
  let i: usize = 0;
  while (i < line.length && (line[i] == 32 || line[i] == 9)) {
    i++;
  }
  const s = i;
  while (i < line.length && line[i] != 32 && line[i] != 9 && line[i] != 13) {
    i++;
  }
  const w = sub(line, s, i);
  if (w.length > 0 && w[0] == 35) {
    return "";
  }
  return w;
}

export function mblIsMaskLine(line: string): bool {
  return mblHeadWord(line) == "mask";
}

// 映像の行の種類か（マスクとマットを掛けられる行）。
export function mblIsVisualKind(word: string): bool {
  return word == "video" || word == "image" || word == "text" || word == "color";
}

// 注釈にした映像の行か（"# video ..."。ops の delete が残す形）。
export function mblIsCommentedClip(line: string): bool {
  let i: usize = 0;
  while (i < line.length && (line[i] == 32 || line[i] == 9)) {
    i++;
  }
  if (i >= line.length || line[i] != 35) {
    return false;
  }
  i++;
  while (i < line.length && (line[i] == 32 || line[i] == 9)) {
    i++;
  }
  const s = i;
  while (i < line.length && line[i] != 32 && line[i] != 9) {
    i++;
  }
  return mblIsVisualKind(sub(line, s, i));
}

// 行が空か、注釈だけか（映像の行を注釈にしたものは除く）。
function mblIsBlankOrNote(line: string): bool {
  for (let i: usize = 0; i < line.length; i++) {
    const c = line[i];
    if (c == 32 || c == 9 || c == 13) {
      continue;
    }
    return c == 35 && !mblIsCommentedClip(line);
  }
  return true;
}

// 行の key= の値（引用を外したもの。なければ ""）。# の後ろは見ない。同じキーが何度もあれば最後のもの。
export function mblKeyValue(line: string, key: string): string {
  let i: usize = 0;
  let found = "";
  while (i < line.length) {
    const c = line[i];
    if (c == 32 || c == 9 || c == 13) {
      i++;
      continue;
    }
    if (c == 35) {
      break;
    }
    if (c == 34) {
      i++;
      while (i < line.length && line[i] != 34) {
        if (line[i] == 92) {
          i++;
        }
        i++;
      }
      i++;
      continue;
    }
    const s = i;
    while (i < line.length && line[i] != 32 && line[i] != 9 && line[i] != 61) {
      i++;
    }
    const word = sub(line, s, i);
    if (i < line.length && line[i] == 61) {
      i++;
      let v: u8[] = [];
      if (i < line.length && line[i] == 34) {
        i++;
        while (i < line.length && line[i] != 34) {
          if (line[i] == 92 && i + 1 < line.length) {
            i++;
          }
          v.push(line[i]);
          i++;
        }
        i++;
      } else {
        while (i < line.length && line[i] != 32 && line[i] != 9 && line[i] != 13) {
          v.push(line[i]);
          i++;
        }
      }
      if (word == key) {
        found = stringFromBytes(v);
      }
    }
  }
  return found;
}

// マスクの行の to= の値（なければ ""）。
export function mblMaskLineTo(line: string): string {
  return mblKeyValue(line, "to");
}

// to= を省いたマスクの行（k 行目、0 から）の掛かる先: 上へ、マスクの行・空の行・注釈だけの行を飛ばして、最初の行が
// 映像の行ならそれ。途中に注釈にした映像の行（"# video ..."。消したクリップ）があれば、そこで止める（黙って別の
// クリップに掛けない）。返り値: 掛かる行（0 から）、映像の行でない行に当たれば -1、消したクリップに当たれば -2。
export function mblImplicitTarget(lines: string[], k: usize): i64 {
  let j = k;
  while (j > 0) {
    j--;
    if (mblIsMaskLine(lines[j])) {
      continue;
    }
    if (mblIsCommentedClip(lines[j])) {
      return -2;
    }
    if (mblIsBlankOrNote(lines[j])) {
      continue;
    }
    if (mblIsVisualKind(mblHeadWord(lines[j]))) {
      return j as i64;
    }
    return -1;
  }
  return -1;
}

// to= を省いたマスクの行を確かめる（project.um の読み取りの最後に、行の文字列を渡して呼ぶ）。
// - 上が消したクリップ（注釈にした映像の行）: mask-orphan（誤り。そのままでは別のクリップに掛かってしまう）
// - 上に映像の行がない: mask-no-target（誤り）
// - 掛かる先はあるが to= がない: mask-implicit-target（警告。行を足したり並べ替えたりすると掛かる先が変わるため）
// to= を書いた行の参照先は project.um 側で unknown-ref を確かめる（クリップの ID の一覧を持っているため）。
export function mblCheckMaskTargets(lines: string[], diags: mut Diag[]): void {
  for (let k: usize = 0; k < lines.length; k++) {
    if (!mblIsMaskLine(lines[k])) {
      continue;
    }
    if (mblMaskLineTo(lines[k]) != "") {
      continue;
    }
    const t = mblImplicitTarget(lines, k);
    const ln = (k as i32) + 1;
    if (t == -2) {
      diags.push(diag("mask-orphan", ln, 0, "このマスクが掛かっていたクリップは消されています（上の行が注釈になっています）",
        "マスクの行も消すか、to=<クリップの ID> で掛ける先を書きます"));
    } else if (t < 0) {
      diags.push(diag("mask-no-target", ln, 0, "このマスクを掛ける映像の行がありません",
        "to=<クリップの ID> を書くか、映像の行（video / image / text / color）のすぐ下に置きます"));
    } else {
      diags.push(warnDiag("mask-implicit-target", ln, 0, `to= がないので、${t + 1} 行目のクリップに掛けています`,
        "行を足したり並べ替えたりしても掛かる先が変わらないように、to=<クリップの ID> を書きます"));
    }
  }
}

// ---- トラックマットの参照 ----

// トラックマットの参照を確かめる。ids[i] はクリップの ID（なければ ""）、mattes[i] はその行の matte=（なければ ""）、
// visual[i] はその行が映像の行（video / image / text / color）か、lines[i] は行番号。
// - マットの元が見つからない: unknown-ref
// - 自分自身: matte-self
// - マットの元が音の行（映像のない行）: matte-not-visual
// - 輪になっている: ref-cycle
// - マットの元がさらに matte= を持つ（連鎖）: matte-chain。連鎖は評価しない（After Effects と違う）ので止める。
//   マットの元の blend= は無視される（マットの元は画面に描かないため）。
export function mblCheckMattes(ids: string[], mattes: string[], visual: bool[], lines: i32[], diags: mut Diag[]): void {
  for (let i: usize = 0; i < mattes.length; i++) {
    if (mattes[i] == "") {
      continue;
    }
    if (ids[i] != "" && mattes[i] == ids[i]) {
      diags.push(diag("matte-self", lines[i], 0, `クリップ '${ids[i]}' が自分自身をマットにしています`, "matte= には別のクリップの ID を書きます"));
      continue;
    }
    let found: i64 = -1;
    for (let j: usize = 0; j < ids.length; j++) {
      if (ids[j] == mattes[i]) {
        found = j as i64;
      }
    }
    if (found < 0) {
      const near = textNearest(mattes[i], ids);
      let hint = "マットに使うクリップに id= を付けて、その ID を書きます";
      if (near != "") {
        hint = `'${near}' のことですか？`;
      }
      diags.push(diag("unknown-ref", lines[i], 0, `マットの元 '${mattes[i]}' という ID のクリップはありません`, hint));
      continue;
    }
    const fi = found as usize;
    if (fi < visual.length && !visual[fi]) {
      diags.push(diag("matte-not-visual", lines[i], 0, `マットの元 '${mattes[i]}' は映像のない行です（音の行はマットになりません）`,
        "映像の行（video / image / text / color）の ID を書きます"));
      continue;
    }
    if (mattes[fi] == "") {
      continue;
    }
    // 輪: i → matte → matte ... と辿って i に戻るか（長さはクリップの数まで）
    let cyc = false;
    let cur = fi;
    for (let step: usize = 0; step < mattes.length; step++) {
      if (mattes[cur] == "") {
        break;
      }
      if (ids[i] != "" && mattes[cur] == ids[i]) {
        cyc = true;
        break;
      }
      let nx: i64 = -1;
      for (let j: usize = 0; j < ids.length; j++) {
        if (ids[j] == mattes[cur]) {
          nx = j as i64;
        }
      }
      if (nx < 0) {
        break;
      }
      cur = nx as usize;
    }
    if (cyc) {
      diags.push(diag("ref-cycle", lines[i], 0, `トラックマットが輪になっています（'${ids[i]}' のマットを辿ると自分に戻ります）`,
        "どれか 1 つのクリップの matte= を外します"));
    } else {
      diags.push(diag("matte-chain", lines[i], 0, `マットの元 '${mattes[i]}' にもトラックマット（matte=${mattes[fi]}）があります。マットの連鎖は使えません`,
        "マットの元の matte= を外すか、マスク（mask の行）で形を作ります"));
    }
  }
}

// ---- keys.um に足すキー ----
// blend などの type は "string" にする（project.um の pjValue は完全一致で列挙を確かめるので、別名・大文字・suggest の
// 付いた診断は mblClipSpec / mblProjectSpec に任せ、二重の bad-enum を出さない）。列挙の値と説明は doc と mblSchemaJson にある。

function mblKey(name: string, kinds: string, type: string, def: string, min: string, max: string, doc: string): KeyInfo {
  return { name: name.clone(), kinds: kinds.clone(), type: type.clone(), def: def.clone(), min: min.clone(), max: max.clone(), doc: doc.clone() };
}

export function mblCoreKeys(): KeyInfo[] {
  const VIS = "video,image,text,color";
  return [
    mblKey("blend", VIS, "string", "normal", "", "",
      "描画モード（normal / add / multiply / screen / overlay / softlight / hardlight / lighten / darken / difference / exclusion / hue / saturation / color / luminosity）"),
    mblKey("blend.space", "project," + VIS, "string", "display", "", "",
      "描画モードを計算する値（display: 表示の値のまま。linear: blend.tf で線形の光に戻して混ぜる）。クリップの既定は project の値"),
    mblKey("blend.tf", "project", "string", "bt1886", "", "",
      "線形の光に戻す伝達関数（bt1886: γ2.4、映像の既定 / srgb: 画像・Web の素材が中心のとき / bt709: カメラの OETF の逆）"),
    mblKey("matte", VIS, "string", "", "", "", "トラックマットの元のクリップの ID（そのクリップは画面に描かず、マットにだけ使う）"),
    mblKey("matte.type", VIS, "string", "alpha", "", "", "トラックマットの種類（alpha: 元のアルファ / luma: 元の輝度 × アルファ）"),
    mblKey("matte.invert", VIS, "string", "0", "", "", "トラックマットを反転する（matte.invert とだけ書いてもよい。=1 / =0 も可）"),
  ];
}

// マスクの行のキー（keys.um の KeyInfo と同じ形。kinds は "mask"）。
export function mblMaskKeyInfos(): KeyInfo[] {
  return [
    mblKey("to", "mask", "string", "", "", "", "掛けるクリップの ID。必ず書く（省くと、すぐ上の映像の行に掛かり、警告 mask-implicit-target が出る）"),
    mblKey("ref", "mask", "string", "", "", "", "座標を書いたときの層の大きさ（幅x高さ、例 1920x1080）。描くときに層の実際の大きさとの比で、x・w は幅の比、y・h・round・feather・expand は高さの比で変える。省くと今の層の画素（project の size や w / h を変えるとずれる）"),
    mblKey("units", "mask", "enum:px|norm", "px", "", "", "座標の単位（px: 画素（ref= の大きさの）/ norm: 層の幅・高さに対する割合 0〜1。長さは高さに対する割合）"),
    mblKey("x", "mask", "number", "0", "-100000", "100000", "形の外接の四角の左（層の左上が 0）"),
    mblKey("y", "mask", "number", "0", "-100000", "100000", "形の外接の四角の上"),
    mblKey("w", "mask", "number", "層の幅", "0", "100000", "形の外接の四角の幅（省くと層の幅）"),
    mblKey("h", "mask", "number", "層の高さ", "0", "100000", "形の外接の四角の高さ（省くと層の高さ）"),
    mblKey("round", "mask", "number", "0", "0", "100000", "四角の角の丸みの半径（rect だけ）"),
    mblKey("d", "mask", "string", "", "", "", "パス（path だけ。SVG の d と同じ。M L H V C S Q T Z、小文字は相対、A は使えない。数は ±100000 まで）"),
    mblKey("mode", "mask", "enum:add|subtract|intersect|lighten|darken|difference|none", "add", "", "", "それまでのマスクとの重ね方。最初の形の重ね方が add / lighten / difference なら何もない所から、それ以外は全部から始める（After Effects と同じ）"),
    mblKey("invert", "mask", "flag", "0", "", "", "形を反転する（invert とだけ書いてもよい）"),
    mblKey("feather", "mask", "number", "0", "0", "1000", "ぼかしの幅（画素。縁の内と外に半分ずつ。縁の上の値は 0.5）"),
    mblKey("expand", "mask", "number", "0", "-1000", "1000", "広げる（正）・縮める（負）画素数。広げると角は丸くなる"),
    mblKey("opacity", "mask", "number", "1", "0", "1", "形の不透明度（0〜1 の割合。50% は 0.5）"),
  ];
}

// ---- schema（report.um の schemaJson に "blend" として足す形） ----

function mblJs(s: string): string {
  let b: u8[] = [34];
  for (let i: usize = 0; i < s.length; i++) {
    const c = s[i];
    if (c == 34 || c == 92) {
      b.push(92);
      b.push(c);
    } else if (c == 10) {
      b.push(92);
      b.push(110);
    } else {
      b.push(c);
    }
  }
  b.push(34);
  return stringFromBytes(b);
}

function mblKeyJson(k: KeyInfo): string {
  let s = `{"name":${mblJs(k.name)},"kinds":${mblJs(k.kinds)},"type":${mblJs(k.type)},"default":${mblJs(k.def)}`;
  if (k.min != "") {
    s = s + `,"min":${k.min}`;
  }
  if (k.max != "") {
    s = s + `,"max":${k.max}`;
  }
  return s + `,"doc":${mblJs(k.doc)}}`;
}

function mblKeysJson(ks: KeyInfo[]): string {
  let s = "[";
  for (let i: usize = 0; i < ks.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + mblKeyJson(ks[i]);
  }
  return s + "]";
}

// {"modes":[{name,label,doc}],"spaces":[..],"tfs":[..],"clipKeys":[KeyInfo],"projectKeys":[KeyInfo],
//  "mask":{shapes,modes,keys:[KeyInfo],path,coords,example},"matte":{types,notes}}
export function mblSchemaJson(): string {
  let s = "{\"modes\":[";
  for (let m: u32 = 0; m < MBL_MODE_COUNT; m++) {
    if (m > 0) {
      s = s + ",";
    }
    s = s + `{"name":${mblJs(mblModeName(m))},"label":${mblJs(mblModeLabel(m))},"doc":${mblJs(mblModeDoc(m))}}`;
  }
  const core = mblCoreKeys();
  let clipKeys: KeyInfo[] = [];
  let projKeys: KeyInfo[] = [];
  for (const k of core) {
    if (k.kinds != "project") {
      clipKeys.push(mblKey(k.name, "video,image,text,color", k.type, k.def, k.min, k.max, k.doc));
    }
    if (k.kinds == "project" || k.name == "blend.space") {
      projKeys.push(mblKey(k.name, "project", k.type, k.def, k.min, k.max, k.doc));
    }
  }
  s = s + "],\"spaces\":[{\"name\":\"display\",\"doc\":\"表示の値（ガンマの掛かった信号）のまま混ぜる。既定。Photoshop・After Effects の既定と同じ見え方\"},"
    + "{\"name\":\"linear\",\"doc\":\"伝達関数（blend.tf）で線形の光に戻して混ぜ、表示の値に戻す。光の足し算として正しい\"}],"
    + "\"tfs\":[{\"name\":\"bt1886\",\"doc\":\"γ2.4。映像の表示の EOTF。既定（Resolve のタイムラインの既定と同じ）\"},"
    + "{\"name\":\"srgb\",\"doc\":\"sRGB の区分の式。画像・Web の素材が中心のとき\"},"
    + "{\"name\":\"bt709\",\"doc\":\"BT.709 の OETF の逆（カメラの信号を光に戻す）\"}],"
    + `"clipKeys":${mblKeysJson(clipKeys)},"projectKeys":${mblKeysJson(projKeys)},`
    + "\"mask\":{\"shapes\":[\"rect\",\"ellipse\",\"path\"],\"modes\":[";
  for (let m: u32 = 0; m < MBL_MASK_MODE_COUNT; m++) {
    if (m > 0) {
      s = s + ",";
    }
    s = s + `{"name":${mblJs(mblMaskModeName(m))},"label":${mblJs(mblMaskModeLabel(m))}}`;
  }
  s = s + `],"keys":${mblKeysJson(mblMaskKeyInfos())},`;
  return s + "\"path\":\"SVG の d（M L H V C S Q T Z、小文字は相対。A は使えない）\","
    + "\"coords\":\"座標は層（効果の前の素材の絵）の左上が 0,0。ref=WxH を書けば、その大きさで書いた画素として層の実際の大きさに合わせて変換する。"
    + "書かなければ今の層の画素（project の size やクリップの w / h / fit を変えるとずれる）。文字のクリップの層は文字の中身・size・縁取り・pad で"
    + "大きさと原点が変わるので、文字を直すとマスクがずれる\","
    + "\"example\":\"mask ellipse to=clip_b ref=1920x1080 x=660 y=240 w=600 h=600 feather=40\"},"
    + "\"matte\":{\"types\":[\"alpha\",\"luma\"],\"notes\":\"マットの元は画面に描かない。マットの元の不透明度・フェード・マスク・効果はマットに効く。"
    + "マットの元の matte=（連鎖）は使えない（matte-chain）。音の行はマットの元にならない（matte-not-visual）\"}}";
}
