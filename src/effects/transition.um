// トランジション（場面転換）: 前の映像 a と次の映像 b を進行度 p（0..1）で切り替える。
// すべてのトランジションは独立した .mzplug（kind: "transition"、WasmFxSet.trans）として読み込んで実行する。
// プラグインが 1 つもない場合や失敗時でも落ちないよう、最小のクロスディゾルブフォールバックだけを持つ。
import { WasmFxSet, wasmTransApplyTmp } from "./wasmfx.um";

export const TRANS_BUILTIN_COUNT: i32 = 0;

export function transBuiltinName(i: i32): string {
  return "";
}

// よく使うトランジション名の日本語表示ラベル（独立 .mzplug に対しても UI 上の見やすい名前を出す）。
export function transBuiltinLabel(name: string): string {
  if (name == "dissolve") {
    return "クロスディゾルブ";
  } else if (name == "dipblack") {
    return "黒フェード（ディップ）";
  } else if (name == "dipwhite") {
    return "白フェード（ディップ）";
  } else if (name == "wipe") {
    return "リニアワイプ";
  } else if (name == "slide") {
    return "スライドイン";
  } else if (name == "push") {
    return "プッシュ（押し出し）";
  } else if (name == "zoom") {
    return "ズーム転換";
  } else if (name == "iris") {
    return "アイリス（円形拡大）";
  } else if (name == "blinds") {
    return "ブラインド";
  } else if (name == "clock") {
    return "クロックワイプ";
  } else if (name == "glitch") {
    return "グリッチ転換";
  } else if (name == "diamond") {
    return "ダイヤモンド（ひし形拡大）";
  } else if (name == "split") {
    return "スプリット（中央から開く）";
  } else if (name == "checker") {
    return "チェッカー（マス目）";
  } else if (name == "pixelize") {
    return "モザイク転換";
  } else if (name == "lumawipe") {
    return "ルミナンスワイプ";
  }
  return name.clone();
}

export function transBuiltinDoc(i: i32): string {
  return "";
}

// トランジション総数（すべて独立 .mzplug）
export function transCount(wasm: WasmFxSet): i32 {
  return wasm.trans.length as i32;
}

export function transNameAt(i: i32, wasm: WasmFxSet): string {
  if (i >= 0 && (i as usize) < wasm.trans.length) {
    return wasm.trans[i as usize].name.clone();
  }
  return "";
}

export function transDocAt(i: i32, wasm: WasmFxSet): string {
  if (i >= 0 && (i as usize) < wasm.trans.length) {
    return wasm.trans[i as usize].doc.clone();
  }
  return "";
}

// トランジションの表示名（.mzplug の @label があればそれを優先、なければ組み込み既定表）
export function transLabelAt(i: i32, wasm: WasmFxSet): string {
  if (i >= 0 && (i as usize) < wasm.trans.length) {
    if (wasm.trans[i as usize].label.length > 0) {
      return wasm.trans[i as usize].label.clone();
    }
    return transBuiltinLabel(wasm.trans[i as usize].name);
  }
  return "";
}

export function transIsWasm(i: i32, wasm: WasmFxSet): bool {
  return i >= 0 && (i as usize) < wasm.trans.length;
}

// 名前から番号を引く（見つからなければ -1）。
export function transFind(name: string, wasm: WasmFxSet): i32 {
  if (name == "") {
    return -1;
  }
  for (let w: usize = 0; w < wasm.trans.length; w++) {
    if (wasm.trans[w].name == name) {
      return w as i32;
    }
  }
  return -1;
}

// プラグイン未配置・失敗時の最小フォールバック（単純な線形クロスディゾルブ）
kernel function trDissolveFallback(i: u32, a: mut Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, p: f32): void {
  const ca = a[i];
  const cb = b[i];
  const q = 1.0 - p;
  a[i] = vec4(ca.x * q + cb.x * p, ca.y * q + cb.y * p, ca.z * q + cb.z * p, ca.w * q + cb.w * p);
}

// トランジションを適用する（a = 前の映像、b = 次の映像、tmp = 作業用、結果は a に残る）。
export function transApply(
  name: string, wasm: WasmFxSet, a: mut Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>,
  w: u32, h: u32, progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const n = w * h;
  if (n == 0) {
    return;
  }
  const p = Math.min(Math.max(progress, 0.0), 1.0);
  const idx = transFind(name, wasm);
  if (idx < 0) {
    dispatch(trDissolveFallback, n, mut a, b, p);
    return;
  }
  const err = wasmTransApplyTmp(wasm.trans[idx as usize], mut a, b, mut tmp, w, h, p, angle, soft, param);
  if (err.length > 0) {
    dispatch(trDissolveFallback, n, mut a, b, p);
  }
}
