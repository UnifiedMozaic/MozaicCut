// 時刻の再マップの土台（timeremap）。
//
//   video "a.mp4" timeremap="0@0 2@1:ease 2@3 0@4"
//
// 値は「その時刻に見せる素材の時刻（秒）」。キーの時刻はクリップの始まりからの秒。上の例は、1 秒かけて素材の 0〜2 秒を
// ゆっくり止まるように見せ、1〜3 秒は 2 秒のコマで止め（静止）、3〜4 秒で 0 秒まで逆に戻す。
// 速度のグラフ（animSpeed）がそのまま再生の速さ（1 が等速、0 が静止、負が逆再生）。
// 素材の時刻がコマとコマのあいだに来たら、近いほうのコマか、2 つのコマを混ぜる（フレームブレンド。animBlendKernel）。
import { textNum } from "../../engine/text.um";
import { Diag, diag } from "../../engine/project.um";
import { AnimTrack, animEvalNum, animSpeed, ANIM_NUM } from "./anim.um";

export const ANIM_REMAP_NEAREST: i32 = 0;
export const ANIM_REMAP_BLEND: i32 = 1;

// 見せるコマ: f0 と f1 を (1 - w) : w で混ぜる（w = 0 なら f0 だけ）。
export struct AnimFramePair {
  f0: i64;
  f1: i64;
  w: f32;
}

// クリップの時刻 t（秒）の素材の時刻（秒。負にはしない）。
export function animRemapTime(tr: AnimTrack, t: f64): f64 {
  return Math.max(animEvalNum(tr, t), 0);
}

// 再生の速さ（素材の秒 / クリップの秒）。
export function animRemapRate(tr: AnimTrack, t: f64): f64 {
  return animSpeed(tr, t);
}

// 素材の時刻 src（秒）を、素材のコマ（fps）の組にする。
// 浮動小数点の誤差でコマの境目の手前に落ちないよう、1/1000 コマ以内はそのコマとみなす。
export function animFramePair(src: f64, fps: f64, mode: i32): AnimFramePair {
  const f = Math.max(src, 0) * fps;
  let f0 = Math.floor(f + 0.001) as i64;
  let w = f - (f0 as f64);
  if (w < 0) {
    w = 0;
  }
  if (mode == ANIM_REMAP_NEAREST) {
    const n = Math.floor(f + 0.5) as i64;
    return { f0: n, f1: n, w: 0.0 };
  }
  if (w < 0.001) {
    return { f0, f1: f0, w: 0.0 };
  }
  return { f0, f1: f0 + 1, w: w as f32 };
}

// 一定の速さ（speed 倍、in から）を timeremap の文字にする（dur はクリップの長さ）。速さの操作を再マップに直すときに使う。
export function animSpeedToRemap(speed: f64, inPt: f64, dur: f64): string {
  return `${textNum(inPt)}@0 ${textNum(inPt + speed * dur)}@end`;
}

// クリップの 0..dur で使う素材の時刻の範囲（[最小, 最大]）。コマごとに調べる。
export function animRemapRange(tr: AnimTrack, dur: f64, fps: f64): f64[2] {
  let lo: f64 = 1.0e30;
  let hi: f64 = -1.0e30;
  let n = Math.floor(dur * fps + 0.5) as i64;
  if (n < 1) {
    n = 1;
  }
  for (let i: i64 = 0; i <= n; i++) {
    const t = Math.min((i as f64) / fps, dur);
    const v = animEvalNum(tr, t);
    lo = Math.min(lo, v);
    hi = Math.max(hi, v);
  }
  return [lo, hi];
}

// 再マップの診断: 素材の外の時刻を見せようとしたら anim-remap-range（srcDur < 0 なら素材の長さは調べない）。
export function animRemapCheck(tr: AnimTrack, dur: f64, fps: f64, srcDur: f64, line: i32, col: i32, err: mut Diag[]): void {
  if (tr.type != ANIM_NUM) {
    err.push(diag("anim-bad-value", line, col, "timeremap の値は素材の時刻（秒の数）です", "例: timeremap=\"0@0 2@1:ease 2@3\""));
    return;
  }
  const r = animRemapRange(tr, dur, fps);
  if (r[0] < -1.0e-9) {
    err.push(diag("anim-remap-range", line, col, `素材の時刻が負（${textNum(r[0])} 秒）になります`, "timeremap の値は 0 以上にします"));
  }
  if (srcDur >= 0 && r[1] > srcDur + 0.5 / fps) {
    err.push(diag("anim-remap-range", line, col, `素材の長さ（${textNum(srcDur)} 秒）を超える時刻（${textNum(r[1])} 秒）を見せようとしています`,
      `timeremap の値は素材の長さ ${textNum(srcDur)} 秒以下にします`));
  }
}

// フレームブレンド: out = a * (1 - w) + b * w（RGBA の f32、ストレートアルファのまま成分ごと）。
export kernel function animBlendKernel(i: u32, out: mut Buffer<vec4<f32>>, a: Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, w: f32): void {
  const x = a[i];
  const y = b[i];
  out[i] = x + (y - x) * w;
}

export function animBlendFrames(out: mut Buffer<vec4<f32>>, a: Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, n: u32, w: f32): void {
  dispatch(animBlendKernel, n, mut out, a, b, w);
}
