// キーフレームの操作（ops.um の `key add / remove / move / set / ease / shift / clear` の中身）。
//
// どれも「今の値の文字（key=value の value。アニメーションでなくてもよい）」を受け取り、新しい値の文字を返す。
// ops.um はクリップの行の key=value を読み、ここを呼び、返った text を setKey(line, key, e.text) で同じ場所に書き戻す
// （setKey が空白を含む値を "..." で囲む。text は囲まずに渡す。ほかの key=value と注釈はそのまま）。
// 変えていないキーの文字は書いたまま残すので、差分はそのキーだけになる。
//
// キーの指し方（<key> の所）: 時刻（1.5、1:02.5、45f、end-0.5。半コマ以内のキー）か、#番号（時刻の順に 0 から）。
// ease だけは * で全部のキーを指せる。
import { textNum } from "../../engine/text.um";
import { Diag } from "../../engine/project.um";
import {
  AnimTrack, AnimKey, animParse, animResolve, animIsAnimated, animParseValue, animParseTimeText, animApplyTag,
  animCopyKey, animNewTrack, animFormat, animRefreshText, animFmtValue, animKeyText, animEval, animTypeJa, animTimeHint,
  animFreezeSide, animDropSide, animPrepare,
  ANIM_LINEAR, ANIM_PATH_STRAIGHT, ANIM_TIME_SEC, ANIM_TIME_FRAME, ANIM_EASE_INFL, ANIM_VEC2, ANIM_POS, ANIM_NUM,
} from "./anim.um";

export struct AnimEdit {
  ok: bool;
  text: string;    // 新しい値の文字（"..." で囲まない。ops.um は setKey(line, key, text) に渡し、囲むのは setKey に任せる）
  animated: bool;  // 新しい値がアニメーションか（false ならふつうの値に戻った）
  code: string;
  error: string;
  hint: string;
  desc: string;    // 何をしたか（日本語）
}

function animEditFail(code: string, error: string, hint: string): AnimEdit {
  return { ok: false, text: "", animated: false, code: code.clone(), error: error.clone(), hint: hint.clone(), desc: "" };
}

function animEditOk(tr: AnimTrack, desc: string): AnimEdit {
  const text = animFormat(tr);
  return { ok: true, text, animated: true, code: "", error: "", hint: "", desc: desc.clone() };
}

// アニメーションをやめて、ふつうの値に戻す。ただし位置（x / y）の負の値は、ふつうの値では「右端（下端）から」の意味に
// なってしまうので、キー 1 つのアニメーション（-400@0。左上からの画素のまま）として残す。
function animEditStatic(type: i32, v: f64[4], desc: string): AnimEdit {
  const text = animFmtValue(type, v);
  if (type == ANIM_POS && v[0] < 0) {
    return { ok: true, text: text + "@0", animated: true, code: "", error: "", hint: "",
      desc: desc + `（負の位置はふつうの値では右端からの意味になるので、キー 1 つ ${text}@0 のまま残しました）` };
  }
  return { ok: true, text, animated: false, code: "", error: "", hint: "", desc: desc.clone() };
}

function animTol(fps: f64): f64 {
  if (fps > 0) {
    return 0.5 / fps;
  }
  return 1.0e-6;
}

// 今の値を読む。アニメーションでなければキーのない列（static に値を入れる）。
struct AnimCur {
  ok: bool;
  tr: AnimTrack;
  isStatic: bool;
  sv: f64[4];
  hasStatic: bool;
  code: string;
  error: string;
  hint: string;
}

function animReadCur(cur: string, type: i32, dur: f64, fps: f64): AnimCur {
  let err: Diag[] = [];
  if (!animIsAnimated(cur)) {
    let hasStatic = false;
    let sv: f64[4] = [0, 0, 0, 0];
    if (cur.length > 0) {
      const vp = animParseValue(type, cur);
      if (vp.ok) {
        hasStatic = true;
        sv = vp.v;
      }
    }
    return { ok: true, tr: animNewTrack(type), isStatic: true, sv, hasStatic, code: "", error: "", hint: "" };
  }
  let tr = animParse(cur, type, 0, 1, mut err);
  if (tr.ok) {
    animResolve(mut tr, dur, fps, 0, 1, mut err);
  }
  for (const d of err) {
    if (d.severity == "error") {
      return { ok: false, tr, isStatic: false, sv: [0, 0, 0, 0], hasStatic: false, code: d.code.clone(),
        error: "今のキーの列に誤りがあります: " + d.msg, hint: d.hint.clone() };
    }
  }
  return { ok: true, tr, isStatic: false, sv: [0, 0, 0, 0], hasStatic: false, code: "", error: "", hint: "" };
}

// 時刻の文字から秒（resolve と同じ規則）。読めなければ NaN を返し、msg に理由。
struct AnimTimeAt {
  ok: bool;
  t: f64;
  num: f64;
  fromEnd: bool;
  unit: i32;
  msg: string;
}

function animTimeAt(s: string, dur: f64, fps: f64): AnimTimeAt {
  const tp = animParseTimeText(s);
  if (!tp.ok) {
    return { ok: false, t: 0, num: 0, fromEnd: false, unit: 0, msg: tp.msg.clone() };
  }
  let t = tp.num;
  if (tp.unit == ANIM_TIME_FRAME) {
    if (!(fps > 0)) {
      return { ok: false, t: 0, num: 0, fromEnd: false, unit: 0, msg: `'${s}' はコマで書いていますが、1 秒のコマ数が分かりません` };
    }
    t = t / fps;
  }
  if (tp.fromEnd) {
    if (!(dur >= 0)) {
      return { ok: false, t: 0, num: 0, fromEnd: false, unit: 0, msg: `'${s}' は終わりからの時刻ですが、クリップの長さが分かりません` };
    }
    t = dur - t;
  }
  return { ok: true, t, num: tp.num, fromEnd: tp.fromEnd, unit: tp.unit, msg: "" };
}

// キーを指す（時刻か #番号）。見つからなければ -1、指し方の誤りは -2。
function animFindKeyRef(tr: AnimTrack, ref: string, dur: f64, fps: f64): i32 {
  if (ref.length > 1 && ref[0] == 35) {
    let n: i32 = 0;
    for (let i: usize = 1; i < ref.length; i++) {
      const c = ref[i];
      if (c < 48 || c > 57) {
        return -2;
      }
      n = n * 10 + ((c - 48) as i32);
    }
    if (n < (tr.keys.length as i32)) {
      return n;
    }
    return -1;
  }
  const at = animTimeAt(ref, dur, fps);
  if (!at.ok) {
    return -2;
  }
  const tol = animTol(fps);
  let best: i32 = -1;
  let bestD = tol;
  for (let i: usize = 0; i < tr.keys.length; i++) {
    const d = Math.abs(tr.keys[i].t - at.t);
    if (d <= bestD) {
      best = i as i32;
      bestD = d;
    }
  }
  return best;
}

function animKeyList(tr: AnimTrack): string {
  let s = "";
  for (let i: usize = 0; i < tr.keys.length; i++) {
    if (i > 0) {
      s = s + "、";
    }
    s = s + `#${i}=${textNum(tr.keys[i].t)} 秒`;
  }
  return s;
}

function animNoKey(tr: AnimTrack, label: string, ref: string, idx: i32): AnimEdit {
  if (idx == -2) {
    return animEditFail("bad-args", `'${ref}' はキーの指し方として読めません`, "キーは時刻（1.5、45f、end-0.5）か #番号（#0 から）で指します");
  }
  return animEditFail("anim-no-key", `${label} に ${ref} のキーがありません`, `今のキー: ${animKeyList(tr)}`);
}

// キーを時刻の順の正しい場所に入れ直す（i のキーの時刻を変えたあと）。新しい添字を返す。
function animReinsert(tr: mut AnimTrack, i: usize): usize {
  let j = i;
  while (j > 0 && tr.keys[j].t < tr.keys[j - 1].t) {
    const a = animCopyKey(tr.keys[j - 1]);
    const b = animCopyKey(tr.keys[j]);
    tr.keys[j - 1] = b;
    tr.keys[j] = a;
    j--;
  }
  while (j + 1 < tr.keys.length && tr.keys[j].t > tr.keys[j + 1].t) {
    const a = animCopyKey(tr.keys[j + 1]);
    const b = animCopyKey(tr.keys[j]);
    tr.keys[j + 1] = b;
    tr.keys[j] = a;
    j++;
  }
  return j;
}

function animOverlapAt(tr: AnimTrack, t: f64, skip: i32, fps: f64): i32 {
  const tol = animTol(fps);
  for (let i: usize = 0; i < tr.keys.length; i++) {
    if ((i as i32) != skip && Math.abs(tr.keys[i].t - t) < tol) {
      return i as i32;
    }
  }
  return -1;
}

function animIsSpatialTag(tag: string): bool {
  return tag == "curve" || animStarts(tag, "tin=") || animStarts(tag, "tout=");
}

function animStarts(s: string, p: string): bool {
  if (s.length < p.length) {
    return false;
  }
  for (let i: usize = 0; i < p.length; i++) {
    if (s[i] != p[i]) {
      return false;
    }
  }
  return true;
}

// 印が触る側: 1 入り側、2 出側、3 両側（時間の補間）、8 経路
function animTagSide(tag: string): i32 {
  if (animIsSpatialTag(tag)) {
    return 8;
  }
  if (tag == "hold" || animStarts(tag, "easeout") || animStarts(tag, "out=") || animStarts(tag, "cubic")) {
    return 2;
  }
  if (animStarts(tag, "easein") || animStarts(tag, "in=")) {
    return 1;
  }
  return 3;
}

// 印をキーに当てる。印が触る側だけを、まず既定に戻してから当てる（hold / easeout / out= / cubic は出側だけ、
// easein / in= は入り側だけ、ease / linear / smooth は両側、curve / tin / tout は経路）。触らない側の設定は残る
// （After Effects のホールドの切り替えと同じく、hold を付けても入り側のイーズは消えない）。
function animApplyTags(k: mut AnimKey, type: i32, tags: string[]): AnimEdit {
  let sides = 0;
  for (const t of tags) {
    sides = sides | animTagSide(t);
  }
  if ((sides & 1) != 0) {
    k.inMode = ANIM_LINEAR;
    k.inSpeed = 0;
    k.inInfl = ANIM_EASE_INFL;
  }
  if ((sides & 2) != 0) {
    k.outMode = ANIM_LINEAR;
    k.outSpeed = 0;
    k.outInfl = ANIM_EASE_INFL;
    k.cubic = false;
  }
  if ((sides & 8) != 0) {
    k.path = ANIM_PATH_STRAIGHT;
    k.tin = [0, 0];
    k.tout = [0, 0];
  }
  for (const t of tags) {
    const r = animApplyTag(mut k, type, t);
    if (!r.ok) {
      return animEditFail(r.code, r.msg, r.hint);
    }
  }
  return { ok: true, text: "", animated: true, code: "", error: "", hint: "", desc: "" };
}

function animTagsJa(tags: string[]): string {
  let s = "";
  for (const t of tags) {
    s = s + ":" + t;
  }
  return s;
}

// key add <clip> <キー> <時刻> <値> [<印>...]
// 同じ時刻（半コマ以内）にキーがあれば、その値（と、印を書いたなら補間）を変える。
// 今の値がふつうの値（x=100）なら、それを 0 秒のキーにしてから足す（0 秒に足すなら置き換える）。
// 今の値を読めない（x=center）か、位置（x / y）のふつうの値が負（右端から）なら、0 秒のキーの値を決められないので断る
// （画面とクリップの大きさが分かる所からは animOpAddPos を呼ぶ。そちらは左上からの画素に直してから足す）。
export function animOpAdd(cur: string, type: i32, label: string, timeStr: string, valStr: string, tags: string[], dur: f64, fps: f64): AnimEdit {
  let c = animReadCur(cur, type, dur, fps);
  if (!c.ok) {
    return animEditFail(c.code, c.error, c.hint);
  }
  const atZero = animTimeAt(timeStr, dur, fps);
  const addsAtZero = atZero.ok && Math.abs(atZero.t) < animTol(fps);
  if (c.isStatic && !addsAtZero) {
    if (cur.length > 0 && !c.hasStatic) {
      return animEditFail("anim-bad-value", `${label} の今の値 '${cur}' を 0 秒のキーにできません`,
        "先に 0 秒のキーを画素の値で足します（例: key add <clip> <キー> 0 640）。アニメーションの位置は左上からの画素です");
    }
    if (type == ANIM_POS && c.hasStatic && c.sv[0] < 0) {
      return animEditFail("anim-bad-value", `${label} の今の値 ${cur} は右端（下端）からの距離なので、そのまま 0 秒のキーにできません`,
        "先に 0 秒のキーを左上からの画素で足します（例: key add <clip> <キー> 0 <画素>）");
    }
  }

  const vp = animParseValue(type, valStr);
  if (!vp.ok) {
    return animEditFail("anim-bad-value", vp.msg, vp.hint);
  }
  const at = animTimeAt(timeStr, dur, fps);
  if (!at.ok) {
    return animEditFail("anim-bad-time", at.msg, animTimeHint());
  }
  let tr = animCopyTrack2(c.tr);
  let desc = "";
  if (c.isStatic && c.hasStatic && Math.abs(at.t) >= animTol(fps)) {
    let k0 = animBlankKey();
    k0.v = c.sv;
    k0.t = 0;
    k0.tNum = 0;
    animRefreshText(mut k0, type, 7);
    tr.keys.push(k0);
    desc = `${label} の今の値 ${animFmtValue(type, c.sv)} を 0 秒のキーにし、`;
  }
  const hit = animOverlapAt(tr, at.t, -1, fps);
  if (hit >= 0) {
    const hi = hit as usize;
    let k = animCopyKey(tr.keys[hi]);
    const before = animFmtValue(type, k.v);
    k.v = vp.v;
    animRefreshText(mut k, type, 1);
    if (tags.length > 0) {
      const r = animApplyTags(mut k, type, tags);
      if (!r.ok) {
        return r;
      }
      animRefreshText(mut k, type, 4);
    }
    tr.keys[hi] = k;
    desc = desc + `${label} の ${textNum(tr.keys[hi].t)} 秒のキーの値を ${before} から ${animFmtValue(type, vp.v)} に変えました`;
    return animEditOk(tr, desc);
  }
  let k = animBlankKey();
  k.v = vp.v;
  k.t = at.t;
  k.tNum = at.num;
  k.fromEnd = at.fromEnd;
  k.unit = at.unit;
  if (tags.length > 0) {
    const r = animApplyTags(mut k, type, tags);
    if (!r.ok) {
      return r;
    }
  }
  animRefreshText(mut k, type, 7);
  k.timeText = timeStr.clone();
  tr.keys.push(k);
  const last = tr.keys.length - 1;
  animReinsert(mut tr, last);
  desc = desc + `${label} に ${textNum(at.t)} 秒のキー（${animFmtValue(type, vp.v)}${animTagsJa(tags)}）を足しました`;
  return animEditOk(tr, desc);
}

// 位置（x / y）の key add。今のふつうの値（center、負は右端から）を、render.um の resolvePos と同じ規則で
// 左上からの画素に直してから足す。size はクリップの幅（x）か高さ（y）、canvas は画面の幅か高さ（画素）。
export function animOpAddPos(cur: string, label: string, timeStr: string, valStr: string, tags: string[], dur: f64, fps: f64, size: i32, canvas: i32): AnimEdit {
  let base = cur.clone();
  if (!animIsAnimated(cur)) {
    base = animStaticPosText(cur, size, canvas);
  }
  return animOpAdd(base, ANIM_POS, label, timeStr, valStr, tags, dur, fps);
}

// ふつうの値の x / y（"" と center は中央、数。負は右端から）を、左上からの画素の文字に直す（読めなければそのまま）。
// render.um の resolvePos と同じ規則（整数の画素に切り下げる）。
export function animStaticPosText(cur: string, size: i32, canvas: i32): string {
  if (cur == "" || cur == "center") {
    return textNum(((canvas - size) / 2) as f64);
  }
  const vp = animParseValue(ANIM_NUM, cur);
  if (!vp.ok) {
    return cur.clone();
  }
  const v = vp.v[0];
  if (v < 0) {
    return textNum(((canvas - size) as f64) + Math.floor(v));
  }
  return textNum(Math.floor(v));
}

// key remove <clip> <キー> <key>。最後の 1 つを消すと、その値のふつうの値に戻る。
export function animOpRemove(cur: string, type: i32, label: string, ref: string, dur: f64, fps: f64): AnimEdit {
  let c = animReadCur(cur, type, dur, fps);
  if (!c.ok) {
    return animEditFail(c.code, c.error, c.hint);
  }
  if (c.isStatic) {
    return animNotAnimated(label);
  }
  const idx = animFindKeyRef(c.tr, ref, dur, fps);
  if (idx < 0) {
    return animNoKey(c.tr, label, ref, idx);
  }
  let tr = animNewTrack(type);
  const gone = animKeyText(c.tr.keys[idx as usize]);
  const goneT = c.tr.keys[idx as usize].t;
  const goneV = c.tr.keys[idx as usize].v;
  for (let i: usize = 0; i < c.tr.keys.length; i++) {
    if ((i as i32) != idx) {
      tr.keys.push(animCopyKey(c.tr.keys[i]));
    }
  }
  if (tr.keys.length == 0) {
    return animEditStatic(type, goneV, `${label} の最後のキー（${gone}）を消し、ふつうの値 ${animFmtValue(type, goneV)} にしました`);
  }
  return animEditOk(tr, `${label} の ${textNum(goneT)} 秒のキー（${gone}）を消しました`);
}

// key move <clip> <キー> <key> <新しい時刻>。動かした先にキーがあれば anim-key-overlap で断る。
export function animOpMove(cur: string, type: i32, label: string, ref: string, toStr: string, dur: f64, fps: f64): AnimEdit {
  let c = animReadCur(cur, type, dur, fps);
  if (!c.ok) {
    return animEditFail(c.code, c.error, c.hint);
  }
  if (c.isStatic) {
    return animNotAnimated(label);
  }
  const idx = animFindKeyRef(c.tr, ref, dur, fps);
  if (idx < 0) {
    return animNoKey(c.tr, label, ref, idx);
  }
  const at = animTimeAt(toStr, dur, fps);
  if (!at.ok) {
    return animEditFail("anim-bad-time", at.msg, animTimeHint());
  }
  let tr = animCopyTrack2(c.tr);
  const hit = animOverlapAt(tr, at.t, idx, fps);
  if (hit >= 0) {
    return animEditFail("anim-key-overlap", `${textNum(at.t)} 秒にはもうキー（${animKeyText(tr.keys[hit as usize])}）があります`,
      "先にそのキーを消すか（key remove）、別の時刻に動かします");
  }
  const i = idx as usize;
  let k = animCopyKey(tr.keys[i]);
  const from = k.t;
  k.t = at.t;
  k.tNum = at.num;
  k.fromEnd = at.fromEnd;
  k.unit = at.unit;
  k.timeText = toStr.clone();
  tr.keys[i] = k;
  animReinsert(mut tr, i);
  return animEditOk(tr, `${label} のキーを ${textNum(from)} 秒から ${textNum(at.t)} 秒に動かしました`);
}

// key set <clip> <キー> <key> <値>
export function animOpSet(cur: string, type: i32, label: string, ref: string, valStr: string, dur: f64, fps: f64): AnimEdit {
  let c = animReadCur(cur, type, dur, fps);
  if (!c.ok) {
    return animEditFail(c.code, c.error, c.hint);
  }
  if (c.isStatic) {
    return animNotAnimated(label);
  }
  const idx = animFindKeyRef(c.tr, ref, dur, fps);
  if (idx < 0) {
    return animNoKey(c.tr, label, ref, idx);
  }
  const vp = animParseValue(type, valStr);
  if (!vp.ok) {
    return animEditFail("anim-bad-value", vp.msg, vp.hint);
  }
  let tr = animCopyTrack2(c.tr);
  const i = idx as usize;
  let k = animCopyKey(tr.keys[i]);
  const before = animFmtValue(type, k.v);
  k.v = vp.v;
  animRefreshText(mut k, type, 1);
  tr.keys[i] = k;
  return animEditOk(tr, `${label} の ${textNum(tr.keys[i].t)} 秒のキーの値を ${before} から ${animFmtValue(type, vp.v)} に変えました`);
}

// key ease <clip> <キー> <key|*> <印>...（例: ease、easein=80、hold、linear、in=0/75 out=200/33、cubic=0.42,0,0.58,1、curve）
export function animOpEase(cur: string, type: i32, label: string, ref: string, tags: string[], dur: f64, fps: f64): AnimEdit {
  let c = animReadCur(cur, type, dur, fps);
  if (!c.ok) {
    return animEditFail(c.code, c.error, c.hint);
  }
  if (c.isStatic) {
    return animNotAnimated(label);
  }
  if (tags.length == 0) {
    return animEditFail("bad-args", "補間の印がありません", "例: key ease intro x 1.5 ease（ease / easein / easeout / linear / hold / smooth / in=0/75 / cubic=... / curve）");
  }
  let tr = animCopyTrack2(c.tr);
  let first: usize = 0;
  let last: usize = tr.keys.length;
  if (ref != "*") {
    const idx = animFindKeyRef(c.tr, ref, dur, fps);
    if (idx < 0) {
      return animNoKey(c.tr, label, ref, idx);
    }
    first = idx as usize;
    last = first + 1;
  }
  for (let i = first; i < last; i++) {
    let k = animCopyKey(tr.keys[i]);
    const r = animApplyTags(mut k, type, tags);
    if (!r.ok) {
      return r;
    }
    animRefreshText(mut k, type, 4);
    tr.keys[i] = k;
  }
  if (ref == "*") {
    return animEditOk(tr, `${label} の全部のキー（${tr.keys.length} 個）の補間を ${animTagsJa(tags)} にしました`);
  }
  return animEditOk(tr, `${label} の ${textNum(tr.keys[first].t)} 秒のキーの補間を ${animTagsJa(tags)} にしました`);
}

// key shift <clip> <キー> <秒>。全部のキーを同じだけずらす（end からのキーは終わりからの量を減らす）。
// 利用者の操作（クリップの長さは変わらない）。split / trim でクリップの長さが変わるときの直しには使わない
// （end からのキーが二重にずれる。animOpRebase を使う）。
export function animOpShift(cur: string, type: i32, label: string, dtStr: string, dur: f64, fps: f64): AnimEdit {
  let c = animReadCur(cur, type, dur, fps);
  if (!c.ok) {
    return animEditFail(c.code, c.error, c.hint);
  }
  if (c.isStatic) {
    return animNotAnimated(label);
  }
  const tp = animParseTimeText(dtStr);
  if (!tp.ok || tp.fromEnd) {
    return animEditFail("anim-bad-time", `'${dtStr}' はずらす量として読めません`, "秒（0.5、-0.25）かコマ（12f、-6f）で書きます");
  }
  let dt = tp.num;
  if (tp.unit == ANIM_TIME_FRAME) {
    if (!(fps > 0)) {
      return animEditFail("anim-bad-time", "コマで書いていますが、1 秒のコマ数が分かりません", "秒で書きます");
    }
    dt = dt / fps;
  }
  let tr = animCopyTrack2(c.tr);
  for (let i: usize = 0; i < tr.keys.length; i++) {
    let k = animCopyKey(tr.keys[i]);
    k.t = k.t + dt;
    let d = dt;
    if (k.unit == ANIM_TIME_FRAME) {
      d = dt * fps;
    }
    if (k.fromEnd) {
      k.tNum = k.tNum - d;
      if (k.tNum < 0) {
        // 終わりを越えたら、始まりからの秒に書き直す
        k.fromEnd = false;
        k.unit = ANIM_TIME_SEC;
        k.tNum = k.t;
      }
    } else {
      k.tNum = k.tNum + d;
    }
    animRefreshText(mut k, type, 2);
    tr.keys[i] = k;
  }
  return animEditOk(tr, `${label} の全部のキー（${tr.keys.length} 個）を ${textNum(dt)} 秒ずらしました`);
}

// 分けた（split / cut）か、端を詰めた（trim）クリップのキーを、新しいクリップの時刻に直す（ops.um の組み込み用）。
// cutSec: 始まりを後ろへ動かした秒（split の後ろ半分は分けた所の秒、trim start は詰めた秒。前半と trim end は 0）。
// oldDur / newDur: 前後の長さ。side:
//   ANIM_REBASE_TAIL（split の後ろ半分、trim start）: 始まりからのキーだけを -cutSec ずらす。終わりはタイムラインの上で
//     動かないので、end からのキーはそのまま（フェードアウトはそのまま残る）。
//   ANIM_REBASE_HEAD（split の前半、trim end）: 終わりが動くので、end からのキーを始まりからの時刻（oldDur − 量）に
//     書き直し、見え方を保つ（分けた所で前半がフェードアウトしない）。trim end で end からのキーを新しい終わりに
//     付いていかせたいときは、この関数を呼ばない（値の文字はそのままでよい）。
// どちらも、新しいクリップの外に出たキーは、補間に要る 1 つ（外側で一番近いキー）だけを残し、残りを消す。残したキーの
// 自動の補間（smooth の速度、curve の接線）は、消す前の前後のキーから求めた値に固定するので、タイムラインの同じ時刻の値は
// 分ける前と同じになる。
export const ANIM_REBASE_TAIL: i32 = 0;
export const ANIM_REBASE_HEAD: i32 = 1;

export function animOpRebase(cur: string, type: i32, label: string, cutSec: f64, oldDur: f64, newDur: f64, side: i32, fps: f64): AnimEdit {
  if (!animIsAnimated(cur)) {
    return { ok: true, text: cur.clone(), animated: false, code: "", error: "", hint: "", desc: `${label} はアニメーションしていないので、そのままです` };
  }
  let c = animReadCur(cur, type, oldDur, fps);
  if (!c.ok) {
    return animEditFail(c.code, c.error, c.hint);
  }
  let tr = animCopyTrack2(c.tr);
  tr.resolved = true;
  animPrepare(mut tr);
  // 新しいクリップの範囲（古いクリップの時刻で）
  const lo = cutSec;
  const hi = cutSec + newDur;
  const tol = animTol(fps);
  const n = tr.keys.length;
  let first: usize = 0;
  let last: usize = n - 1;
  for (let i: usize = 0; i < n; i++) {
    if (tr.keys[i].t <= lo + tol) {
      first = i;
    }
  }
  for (let ii: usize = n; ii > 0; ii--) {
    if (tr.keys[ii - 1].t >= hi - tol) {
      last = ii - 1;
    }
  }
  if (last < first) {
    last = first;
  }
  if (first > 0) {
    animFreezeSide(mut tr, first, 1);
  }
  if (last + 1 < n) {
    animFreezeSide(mut tr, last, 0);
  }
  let out = animNewTrack(type);
  for (let i = first; i <= last; i++) {
    out.keys.push(animCopyKey(tr.keys[i]));
  }
  if (first > 0) {
    animDropSide(mut out, 0, 0);
  }
  if (last + 1 < n) {
    const lastOut = out.keys.length - 1;
    animDropSide(mut out, lastOut, 1);
  }
  for (let i: usize = 0; i < out.keys.length; i++) {
    let k = animCopyKey(out.keys[i]);
    const tOld = k.t;
    if (k.fromEnd) {
      if (side == ANIM_REBASE_HEAD) {
        // 終わりが動く: 始まりからの時刻に書き直す（コマで書いたキーはコマのまま）
        k.fromEnd = false;
        if (k.unit == ANIM_TIME_FRAME && fps > 0) {
          k.tNum = tOld * fps;
        } else {
          k.unit = ANIM_TIME_SEC;
          k.tNum = tOld;
        }
        animRefreshText(mut k, type, 2);
      }
    } else if (cutSec != 0) {
      let d = cutSec;
      if (k.unit == ANIM_TIME_FRAME) {
        d = cutSec * fps;
      }
      k.tNum = k.tNum - d;
      animRefreshText(mut k, type, 2);
    }
    k.t = tOld - cutSec;
    out.keys[i] = k;
  }
  const dropped = n - out.keys.length;
  let desc = `${label} のキーを新しいクリップ（${textNum(newDur)} 秒）の時刻に直しました`;
  if (dropped > 0) {
    desc = desc + `（クリップの外の ${dropped} 個のキーを消しました）`;
  }
  return animEditOk(out, desc);
}

// key clear <clip> <キー> [<時刻>]。アニメーションをやめ、その時刻（省けば最初のキー）の値のふつうの値にする。
// 時刻 t（秒）・値 v の、直線で補うキー（書いたままの文字は作り直す）。like は型の写しの元（どのキーでもよい）。
// 秒を 4 桁で書くと丸まる時刻（1 コマ前など）は、コマの数がちょうどならコマ（29f）で書く。
function animLinearKey(like: AnimKey, type: i32, t: f64, v: f64[4], fps: f64): AnimKey {
  let k = animCopyKey(like);
  k.t = t;
  k.tNum = t;
  k.unit = ANIM_TIME_SEC;
  const fr = t * fps;
  if (fps > 0 && Math.abs(Math.floor(t * 10000 + 0.5) / 10000 - t) > 1.0e-9 && Math.abs(fr - Math.floor(fr + 0.5)) < 1.0e-6) {
    k.unit = ANIM_TIME_FRAME;
    k.tNum = Math.floor(fr + 0.5);
  }
  k.fromEnd = false;
  k.v = v;
  k.inMode = ANIM_LINEAR;
  k.outMode = ANIM_LINEAR;
  k.inSpeed = 0;
  k.outSpeed = 0;
  k.inInfl = ANIM_EASE_INFL;
  k.outInfl = ANIM_EASE_INFL;
  k.cubic = false;
  k.path = ANIM_PATH_STRAIGHT;
  k.tin = [0, 0];
  k.tout = [0, 0];
  k.valText = "";
  k.timeText = "";
  k.tagText = "";
  animRefreshText(mut k, type, 7);
  return k;
}

// キーを dt 秒ずらした写し（end からのキーは、終わりも同じだけ動くので書いたままにする）。
function animShiftKey(k0: AnimKey, type: i32, dt: f64, fps: f64): AnimKey {
  let k = animCopyKey(k0);
  k.t = k.t + dt;
  if (!k.fromEnd) {
    let d = dt;
    if (k.unit == ANIM_TIME_FRAME) {
      d = dt * fps;
    }
    k.tNum = k.tNum + d;
    animRefreshText(mut k, type, 2);
  }
  return k;
}

// タイムラインの範囲 [ta, tb] を切り取って後ろを詰めた（cut）ときの、project の行のキーの列（時刻はタイムラインの秒、
// total は切る前の全体の長さ）。ta より前のキーはそのまま、tb より後ろのキーは tb − ta だけ前へずらし、範囲の中のキーは消す。
// 範囲をまたぐ所には、切る前の ta − 1 コマの値と tb の値のキー（直線）を置く。コマの上の値は切る前と同じになる
// （境目の 2 つの区間が直線でないときは、そのあいだだけ直線で補う。境目のキーの値は 4 桁に丸めて書くので、ta より前の
// 境目の区間はごくわずかに違うことがある）。全部のキーが ta より前なら変えない。
export function animOpCutRange(cur: string, type: i32, label: string, ta: f64, tb: f64, total: f64, fps: f64): AnimEdit {
  if (!animIsAnimated(cur)) {
    return { ok: true, text: cur.clone(), animated: false, code: "", error: "", hint: "", desc: `${label} はアニメーションしていないので、そのままです` };
  }
  let c = animReadCur(cur, type, total, fps);
  if (!c.ok) {
    return animEditFail(c.code, c.error, c.hint);
  }
  let tr = animCopyTrack2(c.tr);
  tr.resolved = true;
  animPrepare(mut tr);
  const tol = animTol(fps);
  const d = tb - ta;
  const n = tr.keys.length;
  let f: f64 = 0;
  if (fps > 0) {
    f = 1.0 / fps;
  }
  if (tr.keys[n - 1].t <= ta + tol) {
    return { ok: true, text: cur.clone(), animated: true, code: "", error: "", hint: "", desc: `${label} のキーは切る範囲より前なので、そのままです` };
  }
  let out = animNewTrack(type);
  if (tr.keys[0].t >= tb - tol) {
    for (const k of tr.keys) {
      out.keys.push(animShiftKey(k, type, -d, fps));
    }
    return animEditOk(out, `${label} のキーを ${textNum(d)} 秒前へずらしました`);
  }
  let hasHead = false;
  for (const k of tr.keys) {
    if (k.t < ta - f - tol) {
      let kk = animCopyKey(k);
      if (kk.fromEnd) {
        // 終わりが動くので、始まりからの秒に書き直す
        kk.fromEnd = false;
        kk.unit = ANIM_TIME_SEC;
        kk.tNum = kk.t;
        animRefreshText(mut kk, type, 2);
      }
      out.keys.push(kk);
    } else if (Math.abs(k.t - (ta - f)) <= tol) {
      out.keys.push(animCopyKey(k));
      hasHead = true;
    }
  }
  if (!hasHead && ta - f > tol) {
    out.keys.push(animLinearKey(tr.keys[0], type, ta - f, animEval(tr, ta - f), fps));
  }
  let hasTail = false;
  for (const k of tr.keys) {
    if (Math.abs(k.t - tb) <= tol) {
      out.keys.push(animShiftKey(k, type, -d, fps));
      hasTail = true;
    }
  }
  if (!hasTail) {
    out.keys.push(animLinearKey(tr.keys[0], type, ta, animEval(tr, tb), fps));
  }
  let dropped = 0;
  for (const k of tr.keys) {
    if (k.t > tb + tol) {
      out.keys.push(animShiftKey(k, type, -d, fps));
    } else if (k.t >= ta - f - tol && Math.abs(k.t - (ta - f)) > tol && Math.abs(k.t - tb) > tol) {
      dropped++;
    }
  }
  let desc = `${label} のキーを、切った範囲（${textNum(ta)}〜${textNum(tb)} 秒）を詰めた時刻に直しました`;
  if (dropped > 0) {
    desc = desc + `（範囲の中の ${dropped} 個のキーを消しました）`;
  }
  return animEditOk(out, desc);
}

export function animOpClear(cur: string, type: i32, label: string, atStr: string, dur: f64, fps: f64): AnimEdit {
  let c = animReadCur(cur, type, dur, fps);
  if (!c.ok) {
    return animEditFail(c.code, c.error, c.hint);
  }
  if (c.isStatic) {
    return animNotAnimated(label);
  }
  let t = c.tr.keys[0].t;
  if (atStr != "") {
    const at = animTimeAt(atStr, dur, fps);
    if (!at.ok) {
      return animEditFail("anim-bad-time", at.msg, animTimeHint());
    }
    t = at.t;
  }
  const v = animEval(c.tr, t);
  return animEditStatic(type, v, `${label} のアニメーションをやめ、${textNum(t)} 秒の値 ${animFmtValue(type, v)} にしました`);
}

function animNotAnimated(label: string): AnimEdit {
  return animEditFail("anim-not-animated", `${label} はアニメーションしていません（キーがありません）`, "先に key add でキーを足します");
}

function animBlankKey(): AnimKey {
  return {
    t: 0, tNum: 0, fromEnd: false, unit: ANIM_TIME_SEC, v: [0, 0, 0, 0],
    inMode: ANIM_LINEAR, outMode: ANIM_LINEAR, inSpeed: 0, inInfl: ANIM_EASE_INFL, outSpeed: 0, outInfl: ANIM_EASE_INFL,
    cubic: false, cub: [0, 0, 0, 0], path: ANIM_PATH_STRAIGHT, tin: [0, 0], tout: [0, 0],
    valText: "", timeText: "", tagText: "", col: 0,
  };
}

function animCopyTrack2(tr: AnimTrack): AnimTrack {
  let out = animNewTrack(tr.type);
  for (const k of tr.keys) {
    out.keys.push(animCopyKey(k));
  }
  return out;
}
