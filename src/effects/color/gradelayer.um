// クリップの色の調整（.mzc の grade.*。src/effects/color/grade.um と lut.um）を層に掛ける。描画（render.um）が使う。
//
// 層は信号の値（Rec.709 の表示の信号、0..1）なので、BT.1886（γ 2.4）で線形の光にしてから、
// 調整（colGradeApply。調整の空間は grade.space、既定は BT.1886）→ LUT（colApplyLutIn。BT.1886 の空間で）の順に掛け、
// 信号に戻す。アルファは変えない。
// 調整を焼いた表（ColGradePlan。33³ の LUT）と読んだ .cube は GradeCache に置き、同じ内容なら作り直さない
// （ドラッグの間はコマごとに値が変わるので、使わなくなったものは数フレームで捨てる）。
import { Project, Clip, KIND_VIDEO, KIND_IMAGE } from "../../engine/project.um";
import { ColGradePlan, colGradeBake, colGradeApply, colGradeJson } from "./grade.um";
import { ColLut, ColDiag, colLoadCube, colApplyLutIn, COL_LUT_TETRAHEDRAL, COL_LUT_TRILINEAR } from "./lut.um";
import { COL_TF_BT1886, ColTfTab, colTfTabNew, colDecodeWith, colEncodeWith } from "./transfer.um";

struct GradeEntry {
  key: string;
  plan: ColGradePlan;
  used: i64;
}

struct GradeLutEntry {
  path: string;
  lut: ColLut;
  ok: bool;
  msg: string;
  used: i64;
}

export struct GradeCache {
  frame: i64;
  grades: GradeEntry[];
  luts: GradeLutEntry[];
  tab: ColTfTab;
}

// 焼いた調整を残すフレームの数（それより長く使わなければ捨てる）。
const GRADE_KEEP_FRAMES: i64 = 8;
const GRADE_LUT_KEEP_FRAMES: i64 = 600;

export function newGradeCache(): GradeCache {
  return { frame: 0, grades: [], luts: [], tab: colTfTabNew(COL_TF_BT1886, 203.0) };
}

// フレームの始めに呼ぶ（古いものを捨てる）。
export function gradeCacheFrame(gc: mut GradeCache): void {
  gc.frame++;
  let k: usize = 0;
  while (k < gc.grades.length) {
    if (gc.frame - gc.grades[k].used > GRADE_KEEP_FRAMES) {
      // 最後のものを k に移して詰める（並びは問わない）
      const e = gc.grades.pop();
      if (k < gc.grades.length) {
        gc.grades[k] = e;
      }
    } else {
      k++;
    }
  }
  k = 0;
  while (k < gc.luts.length) {
    if (gc.frame - gc.luts[k].used > GRADE_LUT_KEEP_FRAMES) {
      // 最後のものを k に移して詰める（並びは問わない）
      const e = gc.luts.pop();
      if (k < gc.luts.length) {
        gc.luts[k] = e;
      }
    } else {
      k++;
    }
  }
}

// クリップに色の調整があるか（なければ層に広げずに描ける）。
export function clipGraded(c: Clip): bool {
  return c.hasGrade || (c.lut.length > 0 && c.lutAmount > 0);
}

// .cube の場所: 絶対のパスはそのまま、相対ならプロジェクトのフォルダ（cache の親）から。
export function gradeLutPath(cache: string, lut: string): string {
  if (lut.length == 0) {
    return "";
  }
  if (lut[0] == 47 || lut[0] == 92 || (lut.length > 1 && lut[1] == 58)) {
    return lut.clone();
  }
  let cut: i32 = -1;
  for (let i: usize = 0; i < cache.length; i++) {
    if (cache[i] == 47 || cache[i] == 92) {
      cut = i as i32;
    }
  }
  if (cut < 0) {
    return lut.clone();
  }
  let b: u8[] = [];
  for (let i: usize = 0; i <= (cut as usize); i++) {
    b.push(cache[i]);
  }
  for (let i: usize = 0; i < lut.length; i++) {
    b.push(lut[i]);
  }
  return stringFromBytes(b);
}

function gradeFindPlan(gc: mut GradeCache, c: Clip): usize {
  const key = colGradeJson(c.grade);
  for (let k: usize = 0; k < gc.grades.length; k++) {
    if (gc.grades[k].key == key) {
      gc.grades[k].used = gc.frame;
      return k;
    }
  }
  gc.grades.push({ key, plan: colGradeBake(c.grade), used: gc.frame });
  return gc.grades.length - 1;
}

function gradeFindLut(gc: mut GradeCache, path: string): usize {
  for (let k: usize = 0; k < gc.luts.length; k++) {
    if (gc.luts[k].path == path) {
      gc.luts[k].used = gc.frame;
      return k;
    }
  }
  let diags: ColDiag[] = [];
  const l = colLoadCube(path, mut diags);
  let msg = "";
  for (const d of diags) {
    if (d.severity == "error") {
      msg = d.msg.clone();
      break;
    }
  }
  const ok = l.ok;
  gc.luts.push({ path: path.clone(), lut: l, ok, msg, used: gc.frame });
  return gc.luts.length - 1;
}

// 読めなかった LUT の理由（読めた・使っていないなら ""）。画面の診断に出す。
export function gradeLutError(gc: mut GradeCache, cache: string, c: Clip): string {
  if (c.lut.length == 0) {
    return "";
  }
  const k = gradeFindLut(mut gc, gradeLutPath(cache, c.lut));
  return gc.luts[k].msg.clone();
}

// 時刻 from..to に使うクリップの grade.lut のうち、読めないもの（ファイルがない・壊れている）の説明。
// 描画はその LUT を掛けずに続けるので、書き出しとプレビューは警告として出す（黙って色が変わらないように）。
export function gradeLutWarnings(p: Project, cache: string, from: f64, to: f64): string[] {
  let out: string[] = [];
  let gc = newGradeCache();
  for (const c of p.clips) {
    const used = c.at <= to && c.at + c.dur > from;
    if (!used || (c.kind != KIND_VIDEO && c.kind != KIND_IMAGE) || c.lut.length == 0 || c.lutAmount <= 0) {
      continue;
    }
    const k = gradeFindLut(mut gc, gradeLutPath(cache, c.lut));
    if (!gc.luts[k].ok) {
      let why = gc.luts[k].msg.clone();
      if (why.length == 0) {
        why = "LUT として読めません";
      }
      out.push(`${c.line} 行目: grade.lut='${c.lut}' を掛けません（${why}）`);
    }
  }
  return out;
}

// 層（n 個の画素。信号の値）にクリップの色の調整を掛ける。
export function gradeLayer(layer: mut Buffer<vec4<f32>>, n: u32, c: Clip, cache: string, gc: mut GradeCache): void {
  if (!clipGraded(c) || n == 0) {
    return;
  }
  colDecodeWith(mut layer, n, gc.tab);
  if (c.hasGrade) {
    const k = gradeFindPlan(mut gc, c);
    colGradeApply(mut layer, n, gc.grades[k].plan);
  }
  if (c.lut.length > 0 && c.lutAmount > 0) {
    const k = gradeFindLut(mut gc, gradeLutPath(cache, c.lut));
    if (gc.luts[k].ok) {
      const mode = c.lutTetra ? COL_LUT_TETRAHEDRAL : COL_LUT_TRILINEAR;
      colApplyLutIn(mut layer, n, gc.luts[k].lut, COL_TF_BT1886, 203.0, mode, c.lutAmount);
    }
  }
  colEncodeWith(mut layer, n, gc.tab);
}
