// 文字のクリップの描画（TrueType の文字、縁取り・影・背景の箱・揃え）。
// render.um の renderFrame から呼ぶ。
//
// 手順:
// 1. ttf.um の renderTextImage で文字の被覆率の画像を作り、Buffer<f32> に写す。
// 2. 縁取りがあれば、被覆率を距離変換で太らせた画像を kernel で作る（太さによらず画素あたり一定の時間）。
//    1 と 2 の結果は時間で変わらないので TextLayerCache に入れ、フレームをまたいで使い回す（下の「置き場」）。
// 3. キャンバスの添字で kernel を dispatch し（描く範囲の下の端の行まで）、範囲外はすぐ戻る。範囲内は
//    背景の箱 → 影 → 縁取り → 文字 の順に重ねる。
//    効果のある文字のクリップは、代わりに透明な層に描き（textClipRect で大きさを知り、render.um が置き場から
//    借りた層に textClipDrawLayer で描く）、render.um が効果を掛けて重ねる。
import { Font, TextImage, renderTextImage, renderTextImageEx, ttEmptyFont, TEXT_SIZE_MAX, TEXT_VERTICAL } from "./ttf.um";
import { Project, Clip, clipPos } from "../../engine/project.um";
import { t3SinDeg, t3CosDeg } from "../threed/t3math.um";
import { mblOver } from "../blend/blend.um";

struct TextClipParams {
  // 描く範囲（キャンバスの画素。x1 / y1 は含まない）
  rx0: i32;
  ry0: i32;
  rx1: i32;
  ry1: i32;
  // 背景の箱
  bx0: i32;
  by0: i32;
  bx1: i32;
  by1: i32;
  // 文字の画像の左上（キャンバス上）と大きさ
  ox: i32;
  oy: i32;
  iw: i32;
  ih: i32;
  // 影のずれ（横・縦。hasShadow != 0 のとき描く）
  sox: i32;
  soy: i32;
  hasShadow: i32;
  // 縁取りがあれば 1
  hasOutline: i32;
  // グラデーション塗り（color -> color2）
  hasGrad: i32;
  gradDx: f32;
  gradDy: f32;
  margin: i32;
  boxW: i32;
  boxH: i32;
  color: vec4<f32>;
  color2: vec4<f32>;
  bg: vec4<f32>;
  shadow: vec4<f32>;
  outline: vec4<f32>;
  alpha: f32;
}

kernel function tlSample(a: Buffer<f32>, iw: i32, ih: i32, x: i32, y: i32): f32 {
  if (x < 0 || y < 0 || x >= iw || y >= ih) {
    return 0.0;
  }
  return a[(y * iw + x) as u32];
}

// 下が透けていれば透明を保つ（mblOver。プリコンポーズの子のキャンバス）。
kernel function tlBlend(d: vec4<f32>, s: vec4<f32>, a: f32): vec4<f32> {
  return mblOver(d, s, Math.min(Math.max(a, 0.0), 1.0));
}

// ---- 縁取り（距離変換で太らせる） ----
// 被覆率が TL_SEED_MIN より大きい画素を「種」として、各画素から一番近い種を求め（Felzenszwalb の 2 パスの距離変換。
// 縦の列ごと → 横の行ごと）、その近くの種の被覆率で縁の位置を画素より細かく補って、太さ r の縁の被覆率を出す。
// 時間は太さによらず、画素あたり一定（以前の円盤の総当たりは太さの 2 乗に比例していた）。

// 種とみなす被覆率の下限（塗りの累積の丸めで残るごく小さい値を種にしないため）。
const TL_SEED_MIN: f32 = 0.004;

// 列 i ごと: 各画素から同じ列で一番近い種の行を ny に入れる（なければ -1）。
kernel function tlColNear(i: u32, ny: mut RacyBuffer<i32>, src: Buffer<f32>, iw: i32, ih: i32): void {
  const x = i as i32;
  let last = -1;
  for (let y = 0; y < ih; y++) {
    const k = y * iw + x;
    if (src[k as u32] > TL_SEED_MIN) {
      last = y;
    }
    ny[k as u32] = last;
  }
  let next = -1;
  for (let y = ih - 1; y >= 0; y--) {
    const k = y * iw + x;
    if (src[k as u32] > TL_SEED_MIN) {
      next = y;
    }
    const cur = ny[k as u32];
    if (next >= 0 && (cur < 0 || next - y < y - cur)) {
      ny[k as u32] = next;
    }
  }
}

// 行 i ごと: 列ごとの結果から、各画素に一番近い種の列を nx に入れる（なければ -1）。
// vb / zb は下側の包絡線の作業場所（行ごとに別の範囲を使う）。
kernel function tlRowNear(
  i: u32, nx: mut RacyBuffer<i32>, vb: mut RacyBuffer<i32>, zb: mut RacyBuffer<f32>, ny: RacyBuffer<i32>, iw: i32,
): void {
  const y = i as i32;
  const base = y * iw;
  const zbase = y * (iw + 1);
  let k = -1;
  for (let q = 0; q < iw; q++) {
    const nyq = ny[(base + q) as u32];
    if (nyq < 0) {
      continue;
    }
    const gq = (y - nyq) as i64;
    const fq = gq * gq + (q as i64) * (q as i64);
    let s: f32 = -1.0e30;
    while (k >= 0) {
      const p = vb[(base + k) as u32];
      const gp = (y - ny[(base + p) as u32]) as i64;
      const fp = gp * gp + (p as i64) * (p as i64);
      s = ((fq - fp) as f32) / ((2 * (q - p)) as f32);
      if (s <= zb[(zbase + k) as u32]) {
        k--;
        s = -1.0e30;
      } else {
        break;
      }
    }
    k++;
    vb[(base + k) as u32] = q;
    zb[(zbase + k) as u32] = s;
    zb[(zbase + k + 1) as u32] = 1.0e30;
  }
  if (k < 0) {
    for (let x = 0; x < iw; x++) {
      nx[(base + x) as u32] = -1;
    }
    return;
  }
  let j = 0;
  for (let x = 0; x < iw; x++) {
    while (zb[(zbase + j + 1) as u32] < (x as f32)) {
      j++;
    }
    nx[(base + x) as u32] = vb[(base + j) as u32];
  }
}

// 画素ごと: 一番近い種とそのまわり 3x3 の種から、縁（被覆率 0.5 の線）までの距離を見積もり、
// 太さ r の縁の被覆率（端は 1 画素の幅でなめらか）を出す。
kernel function tlOuter(
  i: u32, dst: mut Buffer<f32>, src: Buffer<f32>, nx: RacyBuffer<i32>, ny: RacyBuffer<i32>, iw: i32, ih: i32, r: f32,
): void {
  const x = (i % (iw as u32)) as i32;
  const y = (i / (iw as u32)) as i32;
  const a = src[i];
  const qx = nx[i];
  if (qx < 0) {
    dst[i] = a;
    return;
  }
  const qy = ny[(y * iw + qx) as u32];
  let best: f32 = 1.0e30;
  for (let oy = -1; oy <= 1; oy++) {
    const sy = qy + oy;
    if (sy < 0 || sy >= ih) {
      continue;
    }
    for (let ox = -1; ox <= 1; ox++) {
      const sx = qx + ox;
      if (sx < 0 || sx >= iw) {
        continue;
      }
      const sa = Math.min(src[(sy * iw + sx) as u32], 1.0);
      if (sa > TL_SEED_MIN) {
        const dx = (x - sx) as f32;
        const dy = (y - sy) as f32;
        best = Math.min(best, Math.sqrt(dx * dx + dy * dy) - (sa - 0.5));
      }
    }
  }
  const o = Math.min(Math.max(r + 0.5 - best, 0.0), 1.0);
  dst[i] = Math.max(a, o);
}

// 被覆率 src を太さ r で太らせた画像を作る。
function tlDilate(src: Buffer<f32>, iw: i32, ih: i32, r: f32): Buffer<f32> {
  const n = (iw * ih) as u32;
  let ny = new RacyBuffer<i32>(n);
  let nx = new RacyBuffer<i32>(n);
  let vb = new RacyBuffer<i32>(n);
  let zb = new RacyBuffer<f32>(n + (ih as u32));
  dispatch(tlColNear, iw as u32, mut ny, src, iw, ih);
  dispatch(tlRowNear, ih as u32, mut nx, mut vb, mut zb, ny, iw);
  let outer = new Buffer<f32>(n);
  dispatch(tlOuter, n, mut outer, src, nx, ny, iw, ih, r);
  return outer;
}

// 影のソフトブラー（1 次元水平／垂直の分離ガウス近似ブラー）
kernel function tlBlurH(i: u32, dst: mut Buffer<f32>, src: Buffer<f32>, iw: i32, ih: i32, rad: i32): void {
  const x = (i % (iw as u32)) as i32;
  const y = (i / (iw as u32)) as i32;
  let acc: f32 = 0.0;
  let wsum: f32 = 0.0;
  const rf = (rad as f32) + 1.0;
  for (let dx = -rad; dx <= rad; dx++) {
    const sx = x + dx;
    const w = rf - Math.abs(dx as f32);
    wsum = wsum + w;
    if (sx >= 0 && sx < iw) {
      acc = acc + src[(y * iw + sx) as u32] * w;
    }
  }
  dst[i] = acc / Math.max(wsum, 1.0);
}

kernel function tlBlurV(i: u32, dst: mut Buffer<f32>, src: Buffer<f32>, iw: i32, ih: i32, rad: i32): void {
  const x = (i % (iw as u32)) as i32;
  const y = (i / (iw as u32)) as i32;
  let acc: f32 = 0.0;
  let wsum: f32 = 0.0;
  const rf = (rad as f32) + 1.0;
  for (let dy = -rad; dy <= rad; dy++) {
    const sy = y + dy;
    const w = rf - Math.abs(dy as f32);
    wsum = wsum + w;
    if (sy >= 0 && sy < ih) {
      acc = acc + src[(sy * iw + x) as u32] * w;
    }
  }
  dst[i] = acc / Math.max(wsum, 1.0);
}

function tlBlurAlpha(src: Buffer<f32>, iw: i32, ih: i32, blurPx: f32): Buffer<f32> {
  const n = (iw * ih) as u32;
  const rad = Math.min(Math.max(Math.ceil(blurPx) as i32, 1), 64);
  let tmp = new Buffer<f32>(n);
  let out = new Buffer<f32>(n);
  dispatch(tlBlurH, n, mut tmp, src, iw, ih, rad);
  dispatch(tlBlurV, n, mut out, tmp, iw, ih, rad);
  // 2 パス目で滑らかなガウスぼかしにする
  dispatch(tlBlurH, n, mut tmp, out, iw, ih, rad);
  dispatch(tlBlurV, n, mut out, tmp, iw, ih, rad);
  return out;
}

kernel function tlFillColor(lx: i32, ly: i32, p: TextClipParams): vec4<f32> {
  if (p.hasGrad == 0) {
    return p.color;
  }
  const u = ((lx - p.margin) as f32) / (Math.max(p.boxW, 1) as f32) - 0.5;
  const v = ((ly - p.margin) as f32) / (Math.max(p.boxH, 1) as f32) - 0.5;
  const t = Math.min(Math.max(u * p.gradDx + v * p.gradDy + 0.5, 0.0), 1.0);
  return vec4(
    p.color.x + (p.color2.x - p.color.x) * t,
    p.color.y + (p.color2.y - p.color.y) * t,
    p.color.z + (p.color2.z - p.color.z) * t,
    p.color.w + (p.color2.w - p.color.w) * t,
  );
}

kernel function tlDraw(
  i: u32, canvas: mut Buffer<vec4<f32>>, fill: Buffer<f32>, outer: Buffer<f32>, shad: Buffer<f32>, cw: u32, p: TextClipParams,
): void {
  const x = (i % cw) as i32;
  const y = (i / cw) as i32;
  if (x < p.rx0 || y < p.ry0 || x >= p.rx1 || y >= p.ry1) {
    return;
  }
  // 背景の箱 → 影 → 縁取り → 文字を、まず透明な色に重ね（tlDrawLayer と同じ）、
  // 不透明度（fade・opacity）は最後に 1 回だけ掛けてキャンバスに重ねる。
  // こうしないと、フェードの途中で文字の中に縁取りや影が透けて見える。
  let o = vec4(0.0, 0.0, 0.0, 0.0);
  if (p.bg.w > 0.0 && x >= p.bx0 && y >= p.by0 && x < p.bx1 && y < p.by1) {
    o = tlTextOver(o, p.bg, p.bg.w);
  }
  const lx = x - p.ox;
  const ly = y - p.oy;
  if (p.hasShadow != 0 && p.shadow.w > 0.0) {
    const s = tlSample(shad, p.iw, p.ih, lx - p.sox, ly - p.soy);
    if (s > 0.0) {
      o = tlTextOver(o, p.shadow, s * p.shadow.w);
    }
  }
  if (p.hasOutline != 0) {
    const ov = tlSample(outer, p.iw, p.ih, lx, ly);
    if (ov > 0.0) {
      o = tlTextOver(o, p.outline, ov * p.outline.w);
    }
  }
  const f = tlSample(fill, p.iw, p.ih, lx, ly);
  if (f > 0.0) {
    const fc = tlFillColor(lx, ly, p);
    o = tlTextOver(o, fc, f * fc.w);
  }
  if (o.w > 0.0) {
    canvas[i] = tlBlend(canvas[i], o, o.w * p.alpha);
  }
}

// 0xRRGGBBAA → 0〜1 の RGBA。
function tlColor(c: u32): vec4<f32> {
  const r = ((c >> 24) & 255) as f32;
  const g = ((c >> 16) & 255) as f32;
  const b = ((c >> 8) & 255) as f32;
  const a = (c & 255) as f32;
  return vec4(r / 255.0, g / 255.0, b / 255.0, a / 255.0);
}

// 縁取りの太さの上限（画素）。
const TEXT_OUTLINE_MAX: f32 = 512.0;

// 縁取りの太さ（画素）。outlineW が 0 以下なら size/14。
export function textOutlineWidth(c: Clip): f32 {
  if (c.outlineW > 0.0) {
    return c.outlineW;
  }
  return Math.max((c.size as f32) / 14.0, 1.0);
}

// ---- 文字の画像の置き場（フレームをまたいで使い回す） ----
// 文字の画像（被覆率）と縁取りで太らせた画像は、文字・大きさ・揃え・縁取りの太さ・フォントだけで決まり、時間では変わらない。
// そこで TextLayerCache に入れておき、同じ鍵のクリップは作り直さずに使う。色・位置・背景の箱・影・不透明度は描くときに掛ける。
//
// 使い方（render.um の renderFrame が行う）:
//   let tc = newTextLayerCache();             // 1 度だけ作り、フレームをまたいで持つ
//   // 毎フレーム:
//   textCacheFrame(mut tc);                   // フレームの始めに 1 回（長く使わない画像を捨てる）
//   renderTextClipCached(mut canvas, c, p, font, alpha, mut tc);
//
// 捨てる決まり: TL_CACHE_KEEP_FRAMES フレーム使わなかった画像は捨てる。数が TL_CACHE_MAX を、画素の合計が
// TL_CACHE_MAX_PIXELS を超えるときは、一番長く使っていないものから捨てる（いま描くものは捨てない）。

struct TlEntry {
  // 鍵
  text: string;
  size: i32;
  align: i32;
  ow: f32;
  sblur: f32;
  vertical: bool;
  fontKey: u32;
  hash: u32;
  // 最後に使ったフレーム
  used: i64;
  // 画像
  w: i32;
  h: i32;
  margin: i32;
  boxW: i32;
  boxH: i32;
  // 実際に描いた大きさ（画像が大きすぎて縮めたときは size より小さい）
  sizePx: f32;
  hasOuter: bool;
  hasShad: bool;
  fill: Buffer<f32>;
  // 縁取りで太らせた被覆率（縁取りがなければ長さ 1 のダミー）
  outer: Buffer<f32>;
  // ぼかし影の被覆率（shadow.blur が 0 なら長さ 1 のダミー）
  shad: Buffer<f32>;
}

export struct TextLayerCache {
  entries: TlEntry[];
  frame: i64;
  // 試験・計測用の数
  hits: i64;
  misses: i64;
}

// 持つ画像の数と画素の合計の上限、使わなければ捨てるまでのフレーム数。
export const TL_CACHE_MAX: i32 = 64;
export const TL_CACHE_MAX_PIXELS: i64 = 24000000;
export const TL_CACHE_KEEP_FRAMES: i64 = 90;

export function newTextLayerCache(): TextLayerCache {
  return { entries: [], frame: 0, hits: 0, misses: 0 };
}

function tlRemoveAt(cache: mut TextLayerCache, i: usize): void {
  const last = cache.entries.pop();
  if (i < cache.entries.length) {
    cache.entries[i] = last;
  }
}

// フレームの始めに呼ぶ。フレームの番号を進め、TL_CACHE_KEEP_FRAMES フレーム使わなかった画像を捨てる。
export function textCacheFrame(cache: mut TextLayerCache): void {
  cache.frame = cache.frame + 1;
  let i: usize = 0;
  while (i < cache.entries.length) {
    if (cache.frame - cache.entries[i].used > TL_CACHE_KEEP_FRAMES) {
      tlRemoveAt(mut cache, i);
    } else {
      i++;
    }
  }
}

// 置き場の画像を全部捨てる（フォントを読み直したときなど。鍵にフォントを含むので、呼ばなくても誤りはない）。
export function textCacheClear(cache: mut TextLayerCache): void {
  cache.entries.clear();
}

export function textCacheCount(cache: TextLayerCache): i32 {
  return cache.entries.length as i32;
}

// フォントを見分ける値（同じファイル・同じ番号なら同じ値。ok でなければ 0）。
function tlFontKey(f: Font): u32 {
  if (!f.ok) {
    return 0;
  }
  let h: u32 = 2166136261;
  h = (h ^ (f.data.length as u32)) * 16777619;
  h = (h ^ (f.unitsPerEm as u32)) * 16777619;
  h = (h ^ (f.glyfOff as u32)) * 16777619;
  h = (h ^ (f.cmapSub as u32)) * 16777619;
  h = (h ^ (f.numGlyphs as u32)) * 16777619;
  h = (h ^ (f.hmtxOff as u32)) * 16777619;
  return h | 1;
}

function tlHash(s: string, size: i32, align: i32, ow: f32, sblur: f32, vertical: bool, fk: u32): u32 {
  let h: u32 = 2166136261;
  for (const b of s) {
    h = (h ^ (b as u32)) * 16777619;
  }
  h = (h ^ (size as u32)) * 16777619;
  h = (h ^ (align as u32)) * 16777619;
  h = (h ^ ((Math.floor(ow * 256.0) as i32) as u32)) * 16777619;
  h = (h ^ ((Math.floor(sblur * 16.0) as i32) as u32)) * 16777619;
  if (vertical) {
    h = (h ^ 0x55aa55aa) * 16777619;
  }
  return h ^ (fk * 31);
}

function tlClipShadowBlur(c: Clip): f32 {
  if (c.shadow != 0 && (c.shadow & 255) != 0 && c.shadowBlur > 0.0) {
    return Math.min(c.shadowBlur, 64.0);
  }
  return 0.0;
}

// クリップの大きさ（ttf.um と同じ上限に寄せる）。
function tlClipSize(c: Clip): i32 {
  return Math.min(Math.max(c.size, 1), TEXT_SIZE_MAX as i32);
}

// クリップの縁取りの太さ（縁取りがなければ 0）。
function tlClipOutline(c: Clip): f32 {
  if (c.outline != 0 && (c.outline & 255) != 0) {
    return Math.min(textOutlineWidth(c), TEXT_OUTLINE_MAX);
  }
  return 0.0;
}

// 文字の画像と、縁取り・ぼかし影があればそれぞれの被覆率画像を作る。
function tlBuild(font: Font, text: string, size: i32, align: i32, ow: f32, sblur: f32, vertical: bool, fk: u32, h: u32, frame: i64): TlEntry {
  // 余白: 縁取りの太さ + 影のぼかし半径×2 + はみ出す字形のぶん
  const margin = (Math.ceil(ow) as i32) + (Math.ceil(sblur) as i32) * 2 + 2 + size / 8;
  const flags = vertical ? TEXT_VERTICAL : 0;
  const im = renderTextImageEx(font, ttEmptyFont(), text, size as f32, align, margin, flags);
  let owd = ow;
  let sbd = sblur;
  if (im.sizePx < (size as f32)) {
    const ratio = im.sizePx / (size as f32);
    owd = ow * ratio;
    sbd = sblur * ratio;
  }
  const n = (im.w * im.h) as u32;
  let fill = new Buffer<f32>(n);
  for (let k: usize = 0; k < im.alpha.length; k++) {
    fill[k as u32] = im.alpha[k];
  }
  if (ow > 0.0) {
    const outer = tlDilate(fill, im.w, im.h, owd);
    if (sbd > 0.0) {
      const shad = tlBlurAlpha(outer, im.w, im.h, sbd);
      return {
        text: text.clone(), size, align, ow, sblur, vertical, fontKey: fk, hash: h, used: frame,
        w: im.w, h: im.h, margin: im.margin, boxW: im.boxW, boxH: im.boxH, sizePx: im.sizePx,
        hasOuter: true, hasShad: true, fill, outer, shad,
      };
    }
    return {
      text: text.clone(), size, align, ow, sblur, vertical, fontKey: fk, hash: h, used: frame,
      w: im.w, h: im.h, margin: im.margin, boxW: im.boxW, boxH: im.boxH, sizePx: im.sizePx,
      hasOuter: true, hasShad: false, fill, outer, shad: new Buffer<f32>(1),
    };
  }
  if (sbd > 0.0) {
    const shad = tlBlurAlpha(fill, im.w, im.h, sbd);
    return {
      text: text.clone(), size, align, ow, sblur, vertical, fontKey: fk, hash: h, used: frame,
      w: im.w, h: im.h, margin: im.margin, boxW: im.boxW, boxH: im.boxH, sizePx: im.sizePx,
      hasOuter: false, hasShad: true, fill, outer: new Buffer<f32>(1), shad,
    };
  }
  return {
    text: text.clone(), size, align, ow, sblur, vertical, fontKey: fk, hash: h, used: frame,
    w: im.w, h: im.h, margin: im.margin, boxW: im.boxW, boxH: im.boxH, sizePx: im.sizePx,
    hasOuter: false, hasShad: false, fill, outer: new Buffer<f32>(1), shad: new Buffer<f32>(1),
  };
}

// クリップ c の画像の番号（なければ -1）。数（hits / misses）は数えない。
function tlFind(cache: TextLayerCache, font: Font, c: Clip): i64 {
  const size = tlClipSize(c);
  const ow = tlClipOutline(c);
  const sblur = tlClipShadowBlur(c);
  const fk = tlFontKey(font);
  const h = tlHash(c.text, size, c.align, ow, sblur, c.vertical, fk);
  for (let i: usize = 0; i < cache.entries.length; i++) {
    if (
      cache.entries[i].hash == h && cache.entries[i].fontKey == fk && cache.entries[i].size == size &&
      cache.entries[i].align == c.align && cache.entries[i].ow == ow && cache.entries[i].sblur == sblur &&
      cache.entries[i].vertical == c.vertical && cache.entries[i].text == c.text
    ) {
      return i as i64;
    }
  }
  return -1;
}

// クリップ c の画像の番号（なければ作って入れる）。
function tlLookup(cache: mut TextLayerCache, font: Font, c: Clip): usize {
  const found = tlFind(cache, font, c);
  if (found >= 0) {
    const i = found as usize;
    cache.entries[i].used = cache.frame;
    cache.hits = cache.hits + 1;
    return i;
  }
  const size = tlClipSize(c);
  const ow = tlClipOutline(c);
  const sblur = tlClipShadowBlur(c);
  const fk = tlFontKey(font);
  const h = tlHash(c.text, size, c.align, ow, sblur, c.vertical, fk);
  cache.misses = cache.misses + 1;
  const e = tlBuild(font, c.text, size, c.align, ow, sblur, c.vertical, fk, h, cache.frame);
  const px = (e.w as i64) * (e.h as i64);
  // あふれるなら、一番長く使っていないものから捨てる（同じフレームで使ったものも、いま描き終えているので捨ててよい）
  let total: i64 = px;
  for (const x of cache.entries) {
    total = total + (x.w as i64) * (x.h as i64);
  }
  while (
    cache.entries.length > 0 &&
    ((cache.entries.length as i32) >= TL_CACHE_MAX || total > TL_CACHE_MAX_PIXELS)
  ) {
    let old: usize = 0;
    for (let i: usize = 1; i < cache.entries.length; i++) {
      if (cache.entries[i].used < cache.entries[old].used) {
        old = i;
      }
    }
    total = total - (cache.entries[old].w as i64) * (cache.entries[old].h as i64);
    tlRemoveAt(mut cache, old);
  }
  cache.entries.push(e);
  return cache.entries.length - 1;
}

// 描く範囲と位置を決める。alpha はフェードと opacity を掛けた不透明度。
function tlParams(e: TlEntry, c: Clip, p: Project, alpha: f32): TextClipParams {
  let sox = 0;
  let soy = 0;
  let hasShadow = 0;
  if (c.shadow != 0 && (c.shadow & 255) != 0) {
    hasShadow = 1;
    if (c.shadowPosSet) {
      sox = Math.floor(c.shadowX + 0.5) as i32;
      soy = Math.floor(c.shadowY + 0.5) as i32;
    } else {
      let so = Math.max(1, e.size / 16);
      if (e.sizePx < (e.size as f32)) {
        so = Math.max(1, (Math.floor((so as f32) * e.sizePx / (e.size as f32))) as i32);
      }
      sox = so;
      soy = so;
    }
  }
  const pad = Math.max(c.pad, 0);
  const bw = e.boxW + 2 * pad;
  const bh = e.boxH + 2 * pad;
  const bx = clipPos(c.x, c.xAbs, bw, p.width);
  const by = clipPos(c.y, c.yAbs, bh, p.height);
  const ox = bx + pad - e.margin;
  const oy = by + pad - e.margin;
  let rx0 = Math.min(ox, ox + sox);
  let ry0 = Math.min(oy, oy + soy);
  let rx1 = Math.max(ox + e.w, ox + e.w + sox);
  let ry1 = Math.max(oy + e.h, oy + e.h + soy);
  const bg = tlColor(c.bg);
  if (bg.w > 0.0) {
    rx0 = Math.min(rx0, bx);
    ry0 = Math.min(ry0, by);
    rx1 = Math.max(rx1, bx + bw);
    ry1 = Math.max(ry1, by + bh);
  }
  let hasO = 0;
  if (e.hasOuter) {
    hasO = 1;
  }
  let hasGrad = 0;
  let gradDx: f32 = 0.0;
  let gradDy: f32 = 1.0;
  if (c.color2 != 0 && (c.color2 & 255) != 0) {
    hasGrad = 1;
    gradDx = t3CosDeg(c.gradAngle as f64) as f32;
    gradDy = t3SinDeg(c.gradAngle as f64) as f32;
  }
  return {
    rx0: Math.max(rx0, 0),
    ry0: Math.max(ry0, 0),
    rx1: Math.min(rx1, p.width),
    ry1: Math.min(ry1, p.height),
    bx0: bx,
    by0: by,
    bx1: bx + bw,
    by1: by + bh,
    ox,
    oy,
    iw: e.w,
    ih: e.h,
    sox,
    soy,
    hasShadow,
    hasOutline: hasO,
    hasGrad,
    gradDx,
    gradDy,
    margin: e.margin,
    boxW: e.boxW,
    boxH: e.boxH,
    color: tlColor(c.color),
    color2: tlColor(c.color2),
    bg,
    shadow: tlColor(c.shadow),
    outline: tlColor(c.outline),
    alpha,
  };
}

function tlDrawEntry(canvas: mut Buffer<vec4<f32>>, e: TlEntry, c: Clip, p: Project, alpha: f32): void {
  const tp = tlParams(e, c, p, alpha);
  if (tp.rx0 >= tp.rx1 || tp.ry0 >= tp.ry1) {
    return;
  }
  const cn = (tp.ry1 * p.width) as u32;
  if (e.hasOuter && e.hasShad) {
    dispatch(tlDraw, cn, mut canvas, e.fill, e.outer, e.shad, p.width as u32, tp);
  } else if (e.hasOuter) {
    dispatch(tlDraw, cn, mut canvas, e.fill, e.outer, e.outer, p.width as u32, tp);
  } else if (e.hasShad) {
    dispatch(tlDraw, cn, mut canvas, e.fill, e.fill, e.shad, p.width as u32, tp);
  } else {
    dispatch(tlDraw, cn, mut canvas, e.fill, e.fill, e.fill, p.width as u32, tp);
  }
}

// 透明な層への重ね（ストレートアルファの over）。
kernel function tlTextOver(d: vec4<f32>, s: vec4<f32>, a: f32): vec4<f32> {
  const k = Math.min(Math.max(a, 0.0), 1.0);
  const oa = k + d.w * (1.0 - k);
  if (oa <= 0.0) {
    return vec4(0.0, 0.0, 0.0, 0.0);
  }
  const t = d.w * (1.0 - k);
  return vec4((s.x * k + d.x * t) / oa, (s.y * k + d.y * t) / oa, (s.z * k + d.z * t) / oa, oa);
}

// 文字のクリップを透明な層に描く（効果を掛けるとき用）。層の左上はキャンバスの (p.rx0, p.ry0)、幅は lw。
kernel function tlDrawLayer(
  i: u32, layer: mut Buffer<vec4<f32>>, fill: Buffer<f32>, outer: Buffer<f32>, shad: Buffer<f32>, lw: u32, p: TextClipParams,
): void {
  const x = p.rx0 + ((i % lw) as i32);
  const y = p.ry0 + ((i / lw) as i32);
  let c = vec4(0.0, 0.0, 0.0, 0.0);
  if (p.bg.w > 0.0 && x >= p.bx0 && y >= p.by0 && x < p.bx1 && y < p.by1) {
    c = tlTextOver(c, p.bg, p.bg.w);
  }
  const lx = x - p.ox;
  const ly = y - p.oy;
  if (p.hasShadow != 0 && p.shadow.w > 0.0) {
    const s = tlSample(shad, p.iw, p.ih, lx - p.sox, ly - p.soy);
    if (s > 0.0) {
      c = tlTextOver(c, p.shadow, s * p.shadow.w);
    }
  }
  if (p.hasOutline != 0) {
    const o = tlSample(outer, p.iw, p.ih, lx, ly);
    if (o > 0.0) {
      c = tlTextOver(c, p.outline, o * p.outline.w);
    }
  }
  const f = tlSample(fill, p.iw, p.ih, lx, ly);
  if (f > 0.0) {
    const fc = tlFillColor(lx, ly, p);
    c = tlTextOver(c, fc, f * fc.w);
  }
  layer[i] = c;
}

// 効果を掛けるための、文字のクリップの層の置き場所。キャンバスの (x, y) に w × h で置く（キャンバスの外は切ってある）。
// w か h が 0 なら描くものがない。
export struct TextLayerRect {
  x: i32;
  y: i32;
  w: i32;
  h: i32;
}

// 文字のクリップの層の置き場所を返す（文字の画像がなければ作って cache に入れる）。
// 呼ぶ側は長さ w * h の層を用意して textClipDrawLayer で描く（層を使い回せるように、確保は呼ぶ側に任せる）。
export function textClipRect(c: Clip, p: Project, font: Font, cache: mut TextLayerCache): TextLayerRect {
  const k = tlLookup(mut cache, font, c);
  const tp = tlParams(cache.entries[k], c, p, 1.0);
  if (tp.rx0 >= tp.rx1 || tp.ry0 >= tp.ry1) {
    return { x: 0, y: 0, w: 0, h: 0 };
  }
  return { x: tp.rx0, y: tp.ry0, w: tp.rx1 - tp.rx0, h: tp.ry1 - tp.ry0 };
}

// 文字のクリップを透明な層に描く（不透明度は掛けない。重ねるときに掛ける）。layer の長さは、同じフレームで
// textClipRect が返した w * h 以上にする（中身は何でもよい。w * h 個の要素をすべて書く）。
export function textClipDrawLayer(layer: mut Buffer<vec4<f32>>, c: Clip, p: Project, font: Font, cache: mut TextLayerCache): void {
  let k: usize = 0;
  const found = tlFind(cache, font, c);
  if (found >= 0) {
    k = found as usize;
  } else {
    k = tlLookup(mut cache, font, c);
  }
  const tp = tlParams(cache.entries[k], c, p, 1.0);
  if (tp.rx0 >= tp.rx1 || tp.ry0 >= tp.ry1) {
    return;
  }
  const lw = tp.rx1 - tp.rx0;
  const lh = tp.ry1 - tp.ry0;
  const n = Math.min((lw * lh) as u32, layer.length);
  if (cache.entries[k].hasOuter && cache.entries[k].hasShad) {
    dispatch(tlDrawLayer, n, mut layer, cache.entries[k].fill, cache.entries[k].outer, cache.entries[k].shad, lw as u32, tp);
  } else if (cache.entries[k].hasOuter) {
    dispatch(tlDrawLayer, n, mut layer, cache.entries[k].fill, cache.entries[k].outer, cache.entries[k].outer, lw as u32, tp);
  } else if (cache.entries[k].hasShad) {
    dispatch(tlDrawLayer, n, mut layer, cache.entries[k].fill, cache.entries[k].fill, cache.entries[k].shad, lw as u32, tp);
  } else {
    dispatch(tlDrawLayer, n, mut layer, cache.entries[k].fill, cache.entries[k].fill, cache.entries[k].fill, lw as u32, tp);
  }
}

// 効果を掛けるための、文字のクリップの層（層を毎回確保する版。renderFrame は textClipRect と textClipDrawLayer を使う）。
export struct TextLayerOut {
  layer: Buffer<vec4<f32>>;
  x: i32;
  y: i32;
  w: i32;
  h: i32;
}

// 文字のクリップを透明な層に描いて返す（不透明度は掛けない。重ねるときに掛ける）。文字の画像は cache から使い回す。
export function textClipLayer(c: Clip, p: Project, font: Font, cache: mut TextLayerCache): TextLayerOut {
  const r = textClipRect(c, p, font, mut cache);
  if (r.w <= 0 || r.h <= 0) {
    return { layer: new Buffer<vec4<f32>>(1), x: 0, y: 0, w: 0, h: 0 };
  }
  let layer = new Buffer<vec4<f32>>((r.w * r.h) as u32);
  textClipDrawLayer(mut layer, c, p, font, mut cache);
  return { layer, x: r.x, y: r.y, w: r.w, h: r.h };
}

// 文字のクリップをキャンバスに描く（置き場を使わない。1 回だけ描くとき用）。alpha はフェードと opacity を掛けた不透明度。
// 位置（x / y）は背景の箱（文字の箱 + pad）を基準にする。
export function renderTextClip(canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, font: Font, alpha: f32): void {
  const size = tlClipSize(c);
  const ow = tlClipOutline(c);
  const sblur = tlClipShadowBlur(c);
  const fk = tlFontKey(font);
  const e = tlBuild(font, c.text, size, c.align, ow, sblur, c.vertical, fk, 0, 0);
  tlDrawEntry(mut canvas, e, c, p, alpha);
}

// 文字のクリップをキャンバスに描く。文字の画像は cache から使い回す（なければ作って入れる）。
export function renderTextClipCached(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, font: Font, alpha: f32, cache: mut TextLayerCache,
): void {
  const k = tlLookup(mut cache, font, c);
  tlDrawEntry(mut canvas, cache.entries[k], c, p, alpha);
}
