// 縦書きの字形（OpenType の GSUB の 'vert' の機能）。
//
// 縦書きでは、句読点（、。）・小書きの仮名（ぁ っ ょ など）・括弧・長音などに、縦書き用の字形がある
// （句読点と小書きの仮名は升の右上に寄り、括弧・長音は縦向き）。書体の GSUB の 'vert' の機能の置き換え
// （型 1 の 1 字の置き換え。型 7 の拡張で包んだものも読む）を読んで、字形の番号を置き換える。
// 文字の種類（script）や言語は見ず、'vert' と名の付いた機能の置き換えをすべて使う（和文の書体ではどれも同じ）。
// 'vert' がない書体では置き換えない（呼ぶ側が回転や位置のずらしで代わりにする。ttf.um の ttRenderVertical）。
// ttf.um から呼ぶので、Font ではなく、ファイルのバイト列（Font.data）と cmap の表の位置（Font.cmapOff）を受け取る。

// 1 つの書体の 'vert' の置き換えの表（型 1 の副表の位置の並び。ファイルの先頭からのバイト数）。
export struct VertTable {
  subs: i32[];
}

function vtU16(d: u8[], o: i32): i32 {
  if (o < 0 || (o as usize) + 2 > d.length) {
    return 0;
  }
  const k = o as usize;
  return ((d[k] as i32) << 8) | (d[k + 1] as i32);
}

function vtU32(d: u8[], o: i32): i32 {
  if (o < 0 || (o as usize) + 4 > d.length) {
    return -1;
  }
  const k = o as usize;
  const v = ((d[k] as i64) << 24) | ((d[k + 1] as i64) << 16) | ((d[k + 2] as i64) << 8) | (d[k + 3] as i64);
  if (v > 2147483647) {
    return -1;
  }
  return v as i32;
}

function vtTag(d: u8[], o: i32, t: string): bool {
  if (o < 0 || (o as usize) + 4 > d.length) {
    return false;
  }
  for (let i: usize = 0; i < 4; i++) {
    if (d[(o as usize) + i] != t[i]) {
      return false;
    }
  }
  return true;
}

// 表の目録（dir）から tag の表の位置（なければ -1）。
function vtFind(d: u8[], dir: i32, tag: string): i32 {
  const n = vtU16(d, dir + 4);
  for (let i = 0; i < n; i++) {
    const r = dir + 12 + i * 16;
    if (vtTag(d, r, tag)) {
      return vtU32(d, r + 8);
    }
  }
  return -1;
}

// この書体の表の目録の位置。TTC では、cmap の位置が cmapOff と同じ目録を探す（Font は番号を持たないので）。
function vtDir(d: u8[], cmapOff: i32): i32 {
  if (!vtTag(d, 0, "ttcf")) {
    return 0;
  }
  const nf = vtU32(d, 8);
  for (let i = 0; i < nf && i < 256; i++) {
    const dir = vtU32(d, 12 + i * 4);
    if (dir >= 0 && vtFind(d, dir, "cmap") == cmapOff) {
      return dir;
    }
  }
  return -1;
}

// 書体の 'vert' の置き換えの表を読む（なければ subs が空）。d は Font.data、cmapOff は Font.cmapOff。
export function vertTable(d: u8[], cmapOff: i32): VertTable {
  let subs: i32[] = [];
  const dir = vtDir(d, cmapOff);
  if (dir < 0) {
    return { subs };
  }
  const gsub = vtFind(d, dir, "GSUB");
  if (gsub <= 0) {
    return { subs };
  }
  const featList = gsub + vtU16(d, gsub + 6);
  const lookList = gsub + vtU16(d, gsub + 8);
  const nLook = vtU16(d, lookList);
  // 'vert' の機能の lookup の番号（重なりは 1 回だけ）
  let looks: i32[] = [];
  const nFeat = vtU16(d, featList);
  for (let i = 0; i < nFeat; i++) {
    const rec = featList + 2 + i * 6;
    if (!vtTag(d, rec, "vert")) {
      continue;
    }
    const feat = featList + vtU16(d, rec + 4);
    const n = vtU16(d, feat + 2);
    for (let j = 0; j < n; j++) {
      const li = vtU16(d, feat + 4 + j * 2);
      let seen = false;
      for (const x of looks) {
        if (x == li) {
          seen = true;
        }
      }
      if (!seen && li < nLook) {
        looks.push(li);
      }
    }
  }
  for (const li of looks) {
    const look = lookList + vtU16(d, lookList + 2 + li * 2);
    const ty = vtU16(d, look);
    const ns = vtU16(d, look + 4);
    for (let k = 0; k < ns; k++) {
      let st = look + vtU16(d, look + 6 + k * 2);
      if (ty == 7) {
        // 拡張: 中身の型が 1 のときだけ
        if (vtU16(d, st + 2) != 1) {
          continue;
        }
        const ext = vtU32(d, st + 4);
        if (ext < 0) {
          continue;
        }
        st = st + ext;
      } else if (ty != 1) {
        continue;
      }
      subs.push(st);
    }
  }
  return { subs };
}

// 字形 g の、範囲（coverage）の中の番号（なければ -1）。
function vtCoverage(d: u8[], cov: i32, g: i32): i32 {
  const fmt = vtU16(d, cov);
  if (fmt == 1) {
    const n = vtU16(d, cov + 2);
    let lo = 0;
    let hi = n - 1;
    while (lo <= hi) {
      const mid = (lo + hi) / 2;
      const v = vtU16(d, cov + 4 + mid * 2);
      if (v == g) {
        return mid;
      }
      if (v < g) {
        lo = mid + 1;
      } else {
        hi = mid - 1;
      }
    }
    return -1;
  }
  if (fmt == 2) {
    const n = vtU16(d, cov + 2);
    let lo = 0;
    let hi = n - 1;
    while (lo <= hi) {
      const mid = (lo + hi) / 2;
      const r = cov + 4 + mid * 6;
      const s = vtU16(d, r);
      const e = vtU16(d, r + 2);
      if (g < s) {
        hi = mid - 1;
      } else if (g > e) {
        lo = mid + 1;
      } else {
        return vtU16(d, r + 4) + (g - s);
      }
    }
  }
  return -1;
}

// 縦書きの字形の番号（置き換えがなければ g のまま）。t は同じ d の vertTable の結果。
export function vertGlyph(d: u8[], t: VertTable, g: i32): i32 {
  for (const st of t.subs) {
    const fmt = vtU16(d, st);
    const ci = vtCoverage(d, st + vtU16(d, st + 2), g);
    if (ci < 0) {
      continue;
    }
    if (fmt == 1) {
      return (g + vtU16(d, st + 4)) & 0xffff;
    }
    if (fmt == 2 && ci < vtU16(d, st + 4)) {
      return vtU16(d, st + 6 + ci * 2);
    }
  }
  return g;
}

// ---- 字の詰め（OpenType の GPOS の 'palt' / 'vpal' の機能） ----
//
// 和文の書体は、かな・約物などを詰めて組むための字ごとの値を GPOS の 'palt'（横書き）と 'vpal'（縦書き）に持つ
// （型 1 の 1 字の位置合わせ。型 9 の拡張で包んだものも読む）。値は字形のずらし（XPlacement / YPlacement）と
// 送り幅の差（XAdvance / YAdvance）。どちらもフォントの単位で、送り幅の差は負なら詰める。
// YPlacement は上向きが正（縦書きでは、正なら字を上へ寄せる）。

// 1 つの書体の 'palt' か 'vpal' の表（型 1 の副表の位置の並び）。
export struct PaltTable {
  subs: i32[];
}

// 1 字の詰めの値（フォントの単位）。ok は表にその字があったか。
export struct PaltValue {
  ok: bool;
  xp: i32;
  yp: i32;
  xa: i32;
  ya: i32;
}

function vtI16(d: u8[], o: i32): i32 {
  const v = vtU16(d, o);
  return v >= 32768 ? v - 65536 : v;
}

// 書体の feat（"palt" か "vpal"）の位置合わせの表を読む（なければ subs が空）。
export function paltTable(d: u8[], cmapOff: i32, feat: string): PaltTable {
  let subs: i32[] = [];
  const dir = vtDir(d, cmapOff);
  if (dir < 0) {
    return { subs };
  }
  const gpos = vtFind(d, dir, "GPOS");
  if (gpos <= 0) {
    return { subs };
  }
  const featList = gpos + vtU16(d, gpos + 6);
  const lookList = gpos + vtU16(d, gpos + 8);
  const nLook = vtU16(d, lookList);
  let looks: i32[] = [];
  const nFeat = vtU16(d, featList);
  for (let i = 0; i < nFeat; i++) {
    const rec = featList + 2 + i * 6;
    if (!vtTag(d, rec, feat)) {
      continue;
    }
    const fo = featList + vtU16(d, rec + 4);
    const n = vtU16(d, fo + 2);
    for (let j = 0; j < n; j++) {
      const li = vtU16(d, fo + 4 + j * 2);
      let seen = false;
      for (const x of looks) {
        if (x == li) {
          seen = true;
        }
      }
      if (!seen && li < nLook) {
        looks.push(li);
      }
    }
  }
  for (const li of looks) {
    const look = lookList + vtU16(d, lookList + 2 + li * 2);
    const ty = vtU16(d, look);
    const ns = vtU16(d, look + 4);
    for (let k = 0; k < ns; k++) {
      let st = look + vtU16(d, look + 6 + k * 2);
      if (ty == 9) {
        // 拡張: 中身の型が 1 のときだけ
        if (vtU16(d, st + 2) != 1) {
          continue;
        }
        const ext = vtU32(d, st + 4);
        if (ext < 0) {
          continue;
        }
        st = st + ext;
      } else if (ty != 1) {
        continue;
      }
      subs.push(st);
    }
  }
  return { subs };
}

// ValueRecord（vf の bit の順に 2 バイトずつ）を読む。
function vtValue(d: u8[], o: i32, vf: i32): PaltValue {
  let v: PaltValue = { ok: true, xp: 0, yp: 0, xa: 0, ya: 0 };
  let p = o;
  if ((vf & 1) != 0) {
    v.xp = vtI16(d, p);
    p += 2;
  }
  if ((vf & 2) != 0) {
    v.yp = vtI16(d, p);
    p += 2;
  }
  if ((vf & 4) != 0) {
    v.xa = vtI16(d, p);
    p += 2;
  }
  if ((vf & 8) != 0) {
    v.ya = vtI16(d, p);
  }
  return v;
}

// ValueRecord のバイト数。
function vtValueSize(vf: i32): i32 {
  let n = 0;
  for (let b = 0; b < 8; b++) {
    if ((vf & (1 << b)) != 0) {
      n += 2;
    }
  }
  return n;
}

// 字形 g の詰めの値（表になければ ok = false）。t は同じ d の paltTable の結果。
export function paltValue(d: u8[], t: PaltTable, g: i32): PaltValue {
  for (const st of t.subs) {
    const fmt = vtU16(d, st);
    const ci = vtCoverage(d, st + vtU16(d, st + 2), g);
    if (ci < 0) {
      continue;
    }
    const vf = vtU16(d, st + 4);
    if (fmt == 1) {
      return vtValue(d, st + 6, vf);
    }
    if (fmt == 2 && ci < vtU16(d, st + 6)) {
      return vtValue(d, st + 8 + ci * vtValueSize(vf), vf);
    }
  }
  return { ok: false, xp: 0, yp: 0, xa: 0, ya: 0 };
}

// ---- 縦書きの送り（vhea / vmtx） ----

// vmtx の表の位置と、送りの高さを持つ字の数（vhea の numOfLongVerMetrics）。off が負なら表がない。
export struct VmtxTable {
  off: i32;
  n: i32;
}

// 書体の vmtx を読む。
export function vmtxTable(d: u8[], cmapOff: i32): VmtxTable {
  const dir = vtDir(d, cmapOff);
  if (dir < 0) {
    return { off: -1, n: 0 };
  }
  const vhea = vtFind(d, dir, "vhea");
  const vmtx = vtFind(d, dir, "vmtx");
  if (vhea <= 0 || vmtx <= 0) {
    return { off: -1, n: 0 };
  }
  const n = vtU16(d, vhea + 34);
  if (n <= 0) {
    return { off: -1, n: 0 };
  }
  return { off: vmtx, n };
}

// 字形 g の縦の送り（フォントの単位）。表がなければ -1。
export function vmtxAdvance(d: u8[], t: VmtxTable, g: i32): i32 {
  if (t.off < 0) {
    return -1;
  }
  const k = g < t.n ? g : t.n - 1;
  return vtU16(d, t.off + k * 4);
}
