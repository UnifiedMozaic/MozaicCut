// 小さな JSON の読み取り（書き起こしの結果を読むため）。値は木（AzJson）にする。
// 数は f64、文字列は UTF-8（\uXXXX とサロゲートの組も UTF-8 に直す）。誤りは位置つきの日本語の文で返す。

export const AZJ_NULL: i32 = 0;
export const AZJ_BOOL: i32 = 1;
export const AZJ_NUM: i32 = 2;
export const AZJ_STR: i32 = 3;
export const AZJ_ARR: i32 = 4;
export const AZJ_OBJ: i32 = 5;

export struct AzJson {
  kind: i32;
  b: bool;
  num: f64;
  str: string;
  // オブジェクトのキー（items と同じ順）
  keys: string[];
  items: AzJson[];
}

export struct AzJsonDoc {
  ok: bool;
  error: string;
  root: AzJson;
}

struct AzJp {
  src: u8[];
  pos: usize;
  err: string;
  depth: i32;
}

export function azjNull(): AzJson {
  return { kind: AZJ_NULL, b: false, num: 0.0, str: "", keys: [], items: [] };
}

function azjWs(p: mut AzJp): void {
  while (p.pos < p.src.length) {
    const c = p.src[p.pos];
    if (c == 32 || c == 9 || c == 10 || c == 13) {
      p.pos++;
    } else {
      break;
    }
  }
}

function azjFail(p: mut AzJp, msg: string): void {
  if (p.err == "") {
    // 行と列（1 から）
    let line = 1;
    let col = 1;
    for (let i: usize = 0; i < p.pos && i < p.src.length; i++) {
      if (p.src[i] == 10) {
        line++;
        col = 1;
      } else if ((p.src[i] & 192) != 128) {
        col++;
      }
    }
    p.err = `${line} 行 ${col} 列: ${msg}`;
  }
}

function azjHexVal(c: u8): i32 {
  if (c >= 48 && c <= 57) {
    return (c - 48) as i32;
  }
  if (c >= 97 && c <= 102) {
    return (c - 87) as i32;
  }
  if (c >= 65 && c <= 70) {
    return (c - 55) as i32;
  }
  return -1;
}

function azjHex4(p: mut AzJp): i32 {
  if (p.pos + 4 > p.src.length) {
    return -1;
  }
  let v: i32 = 0;
  for (let k: usize = 0; k < 4; k++) {
    const h = azjHexVal(p.src[p.pos + k]);
    if (h < 0) {
      return -1;
    }
    v = v * 16 + h;
  }
  p.pos += 4;
  return v;
}

export function azUtf8Push(out: mut u8[], cp: u32): void {
  if (cp < 128) {
    out.push(cp as u8);
  } else if (cp < 2048) {
    out.push((192 | (cp >> 6)) as u8);
    out.push((128 | (cp & 63)) as u8);
  } else if (cp < 65536) {
    out.push((224 | (cp >> 12)) as u8);
    out.push((128 | ((cp >> 6) & 63)) as u8);
    out.push((128 | (cp & 63)) as u8);
  } else {
    out.push((240 | (cp >> 18)) as u8);
    out.push((128 | ((cp >> 12) & 63)) as u8);
    out.push((128 | ((cp >> 6) & 63)) as u8);
    out.push((128 | (cp & 63)) as u8);
  }
}

function azjString(p: mut AzJp): string {
  // p.src[p.pos] は "
  p.pos++;
  let out: u8[] = [];
  while (true) {
    if (p.pos >= p.src.length) {
      azjFail(mut p, "文字列が閉じていません");
      return "";
    }
    const c = p.src[p.pos];
    if (c == 34) {
      p.pos++;
      break;
    }
    if (c == 92) {
      p.pos++;
      if (p.pos >= p.src.length) {
        azjFail(mut p, "文字列が閉じていません");
        return "";
      }
      const e = p.src[p.pos];
      p.pos++;
      if (e == 110) {
        out.push(10);
      } else if (e == 116) {
        out.push(9);
      } else if (e == 114) {
        out.push(13);
      } else if (e == 98) {
        out.push(8);
      } else if (e == 102) {
        out.push(12);
      } else if (e == 117) {
        let cp = azjHex4(mut p);
        if (cp < 0) {
          azjFail(mut p, "\\u の後ろは 16 進の 4 桁です");
          return "";
        }
        if (cp >= 55296 && cp < 56320) {
          // 上位のサロゲート。続く \uDC00..\uDFFF と組にする
          if (p.pos + 6 <= p.src.length && p.src[p.pos] == 92 && p.src[p.pos + 1] == 117) {
            p.pos += 2;
            const lo = azjHex4(mut p);
            if (lo >= 56320 && lo < 57344) {
              cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
            } else {
              cp = 65533;
            }
          } else {
            cp = 65533;
          }
        } else if (cp >= 56320 && cp < 57344) {
          cp = 65533;
        }
        azUtf8Push(mut out, cp as u32);
      } else {
        // \" \\ \/ とそれ以外（そのまま）
        out.push(e);
      }
      continue;
    }
    out.push(c);
    p.pos++;
  }
  return stringFromBytes(out);
}

function azjNumber(p: mut AzJp): f64 {
  const start = p.pos;
  let neg = false;
  if (p.pos < p.src.length && p.src[p.pos] == 45) {
    neg = true;
    p.pos++;
  }
  let v: f64 = 0.0;
  let digits = 0;
  while (p.pos < p.src.length && p.src[p.pos] >= 48 && p.src[p.pos] <= 57) {
    v = v * 10.0 + ((p.src[p.pos] - 48) as f64);
    p.pos++;
    digits++;
  }
  if (p.pos < p.src.length && p.src[p.pos] == 46) {
    p.pos++;
    let scale: f64 = 0.1;
    while (p.pos < p.src.length && p.src[p.pos] >= 48 && p.src[p.pos] <= 57) {
      v = v + ((p.src[p.pos] - 48) as f64) * scale;
      scale = scale * 0.1;
      p.pos++;
      digits++;
    }
  }
  if (digits == 0) {
    p.pos = start;
    azjFail(mut p, "数が読めません");
    return 0.0;
  }
  if (p.pos < p.src.length && (p.src[p.pos] == 101 || p.src[p.pos] == 69)) {
    p.pos++;
    let eneg = false;
    if (p.pos < p.src.length && (p.src[p.pos] == 45 || p.src[p.pos] == 43)) {
      eneg = p.src[p.pos] == 45;
      p.pos++;
    }
    let ex: i32 = 0;
    while (p.pos < p.src.length && p.src[p.pos] >= 48 && p.src[p.pos] <= 57) {
      ex = Math.min(ex * 10 + ((p.src[p.pos] - 48) as i32), 400);
      p.pos++;
    }
    for (let k: i32 = 0; k < ex; k++) {
      if (eneg) {
        v = v / 10.0;
      } else {
        v = v * 10.0;
      }
    }
  }
  if (neg) {
    return -v;
  }
  return v;
}

function azjWord(p: mut AzJp, w: string): bool {
  if (p.pos + w.length > p.src.length) {
    return false;
  }
  for (let k: usize = 0; k < w.length; k++) {
    if (p.src[p.pos + k] != w[k]) {
      return false;
    }
  }
  p.pos += w.length;
  return true;
}

function azjValue(p: mut AzJp): AzJson {
  let v = azjNull();
  azjWs(mut p);
  if (p.err != "") {
    return v;
  }
  if (p.pos >= p.src.length) {
    azjFail(mut p, "値がありません（ファイルが途中で終わっています）");
    return v;
  }
  if (p.depth > 200) {
    azjFail(mut p, "入れ子が深すぎます");
    return v;
  }
  const c = p.src[p.pos];
  if (c == 123) {
    p.pos++;
    p.depth++;
    v.kind = AZJ_OBJ;
    azjWs(mut p);
    if (p.pos < p.src.length && p.src[p.pos] == 125) {
      p.pos++;
      p.depth--;
      return v;
    }
    while (p.err == "") {
      azjWs(mut p);
      if (p.pos >= p.src.length || p.src[p.pos] != 34) {
        azjFail(mut p, "オブジェクトのキー（\"...\"）がありません");
        break;
      }
      const key = azjString(mut p);
      azjWs(mut p);
      if (p.pos >= p.src.length || p.src[p.pos] != 58) {
        azjFail(mut p, "キーの後ろに : がありません");
        break;
      }
      p.pos++;
      const item = azjValue(mut p);
      v.keys.push(key);
      v.items.push(item);
      azjWs(mut p);
      if (p.pos < p.src.length && p.src[p.pos] == 44) {
        p.pos++;
        continue;
      }
      if (p.pos < p.src.length && p.src[p.pos] == 125) {
        p.pos++;
        break;
      }
      azjFail(mut p, ", か } がありません");
    }
    p.depth--;
    return v;
  }
  if (c == 91) {
    p.pos++;
    p.depth++;
    v.kind = AZJ_ARR;
    azjWs(mut p);
    if (p.pos < p.src.length && p.src[p.pos] == 93) {
      p.pos++;
      p.depth--;
      return v;
    }
    while (p.err == "") {
      const item = azjValue(mut p);
      v.items.push(item);
      azjWs(mut p);
      if (p.pos < p.src.length && p.src[p.pos] == 44) {
        p.pos++;
        continue;
      }
      if (p.pos < p.src.length && p.src[p.pos] == 93) {
        p.pos++;
        break;
      }
      azjFail(mut p, ", か ] がありません");
    }
    p.depth--;
    return v;
  }
  if (c == 34) {
    v.kind = AZJ_STR;
    v.str = azjString(mut p);
    return v;
  }
  if (c == 116) {
    if (azjWord(mut p, "true")) {
      v.kind = AZJ_BOOL;
      v.b = true;
      return v;
    }
  } else if (c == 102) {
    if (azjWord(mut p, "false")) {
      v.kind = AZJ_BOOL;
      return v;
    }
  } else if (c == 110) {
    if (azjWord(mut p, "null")) {
      return v;
    }
  } else if (c == 45 || (c >= 48 && c <= 57)) {
    v.kind = AZJ_NUM;
    v.num = azjNumber(mut p);
    return v;
  }
  azjFail(mut p, "知らない値です（JSON ではありません）");
  return v;
}

export function azJsonParse(bytes: u8[]): AzJsonDoc {
  let p: AzJp = { src: bytes.clone(), pos: 0, err: "", depth: 0 };
  // UTF-8 の BOM を飛ばす
  if (p.src.length >= 3 && p.src[0] == 239 && p.src[1] == 187 && p.src[2] == 191) {
    p.pos = 3;
  }
  const root = azjValue(mut p);
  azjWs(mut p);
  if (p.err == "" && p.pos < p.src.length) {
    azjFail(mut p, "値の後ろに余分な文字があります");
  }
  if (p.err != "") {
    return { ok: false, error: p.err.clone(), root: azjNull() };
  }
  return { ok: true, error: "", root };
}

// オブジェクトのキーの番号（なければ -1）。
export function azjFind(v: AzJson, key: string): i32 {
  if (v.kind != AZJ_OBJ) {
    return -1;
  }
  for (let i: usize = 0; i < v.keys.length; i++) {
    if (v.keys[i] == key) {
      return i as i32;
    }
  }
  return -1;
}

export function azjHas(v: AzJson, key: string): bool {
  return azjFind(v, key) >= 0;
}

// キーの数の値（なければ、または数でなければ def）。
export function azjNum(v: AzJson, key: string, def: f64): f64 {
  const i = azjFind(v, key);
  if (i < 0) {
    return def;
  }
  const x = v.items[i as usize].kind;
  if (x == AZJ_NUM) {
    return v.items[i as usize].num;
  }
  return def;
}

export function azjStr(v: AzJson, key: string): string {
  const i = azjFind(v, key);
  if (i < 0) {
    return "";
  }
  if (v.items[i as usize].kind == AZJ_STR) {
    return v.items[i as usize].str.clone();
  }
  return "";
}
