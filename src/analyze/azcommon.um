// 解析（src/analyze/）の共通の道具: 区間、数と時刻の表示、JSON の文字列、対数と指数、Y4M の読み取り。
// 名前の空間は全ファイルで 1 つなので、この部品の名前にはすべて az / Az を前置する。
import { sub, parseNum, splitBy, isNan } from "../text.um";

// 区間（秒）。value は区間ごとの値（無音なら区間の中の最大の音量 dB、黒なら平均の明るさなど）。
export struct AzSpan {
  start: f64;
  end: f64;
  value: f64;
}

export function azSpan(start: f64, end: f64, value: f64): AzSpan {
  return { start, end, value };
}

// ---- 数と時刻の表示 ----

// 小数 3 桁で丸め、末尾の 0 を落とす（"3.2"、"10"、"0.033"）。op の時刻と JSON の数に使う。
export function azNum(v: f64): string {
  if (v != v) {
    return "null";
  }
  let neg = false;
  let x = v;
  if (x < 0) {
    neg = true;
    x = -x;
  }
  const scaled = Math.floor(x * 1000 + 0.5) as i64;
  const ip = scaled / 1000;
  let frac = scaled % 1000;
  let s = `${ip}`;
  if (frac != 0) {
    let digits = 3;
    while (frac % 10 == 0) {
      frac = frac / 10;
      digits--;
    }
    let fs = `${frac}`;
    while ((fs.length as i32) < digits) {
      fs = "0" + fs;
    }
    s = s + "." + fs;
  }
  if (neg && scaled != 0) {
    s = "-" + s;
  }
  return s;
}

// 小数 4 桁（スコアなど 0..1 の値）。
export function azNum4(v: f64): string {
  if (v != v) {
    return "null";
  }
  const r = Math.floor(v * 10000 + 0.5) / 10000;
  return `${r}`;
}

// m:ss.mmm（表と一覧に使う。text.um の fmtTime と同じ形）。
export function azClock(t: f64): string {
  let x = t;
  if (x < 0) {
    x = 0;
  }
  const ms = Math.floor(x * 1000 + 0.5) as i64;
  const m = ms / 60000;
  const s = (ms % 60000) / 1000;
  const frac = ms % 1000;
  let ss = `${s}`;
  if (s < 10) {
    ss = `0${s}`;
  }
  let ff = `${frac}`;
  if (frac < 10) {
    ff = `00${frac}`;
  } else if (frac < 100) {
    ff = `0${frac}`;
  }
  return `${m}:${ss}.${ff}`;
}

// SRT の時刻（00:00:01,500）。
export function azSrtTime(t: f64): string {
  let x = t;
  if (x < 0) {
    x = 0;
  }
  const ms = Math.floor(x * 1000 + 0.5) as i64;
  const h = ms / 3600000;
  const m = (ms % 3600000) / 60000;
  const s = (ms % 60000) / 1000;
  const f = ms % 1000;
  return `${azPad(h, 2)}:${azPad(m, 2)}:${azPad(s, 2)},${azPad(f, 3)}`;
}

export function azPad(v: i64, digits: i32): string {
  let s = `${v}`;
  while ((s.length as i32) < digits) {
    s = "0" + s;
  }
  return s;
}

// ---- JSON の文字列 ----

function azHex(v: u32): u8 {
  if (v < 10) {
    return (48 + v) as u8;
  }
  return (87 + v) as u8;
}

// JSON の文字列リテラル（引用符つき）。制御文字は \u00XX にする。
export function azJsonStr(s: string): string {
  let out: u8[] = [];
  out.push(34);
  for (const b of s) {
    if (b == 34) {
      out.push(92);
      out.push(34);
    } else if (b == 92) {
      out.push(92);
      out.push(92);
    } else if (b == 10) {
      out.push(92);
      out.push(110);
    } else if (b == 13) {
      out.push(92);
      out.push(114);
    } else if (b == 9) {
      out.push(92);
      out.push(116);
    } else if (b < 32) {
      out.push(92);
      out.push(117);
      out.push(48);
      out.push(48);
      out.push(azHex(((b as u32) >> 4) & 15));
      out.push(azHex((b as u32) & 15));
    } else {
      out.push(b);
    }
  }
  out.push(34);
  return stringFromBytes(out);
}

export function azSpansJson(spans: AzSpan[], valueName: string): string {
  let s = "[";
  for (let i: usize = 0; i < spans.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + `{"start":${azNum(spans[i].start)},"end":${azNum(spans[i].end)},"duration":${azNum(spans[i].end - spans[i].start)}`;
    if (valueName != "") {
      s = s + `,${azJsonStr(valueName)}:${azNum(spans[i].value)}`;
    }
    s = s + "}";
  }
  return s + "]";
}

// ---- 対数と指数（Math に log / exp がないので自前で求める。f64 で 1e-12 程度の誤差） ----

const AZ_LN2: f64 = 0.6931471805599453;
const AZ_LN10: f64 = 2.302585092994046;

// 自然対数。0 以下は -1e300。
export function azLn(v: f64): f64 {
  if (!(v > 0)) {
    return -1.0e300;
  }
  let x = v;
  let k: i32 = 0;
  while (x >= 2.0) {
    x = x / 2.0;
    k++;
  }
  while (x < 1.0) {
    x = x * 2.0;
    k--;
  }
  // ln x = 2 atanh((x-1)/(x+1))、x は [1, 2) なので y は [0, 1/3)
  const y = (x - 1.0) / (x + 1.0);
  const y2 = y * y;
  let term = y;
  let sum: f64 = 0.0;
  for (let n: i32 = 1; n < 60; n += 2) {
    sum = sum + term / (n as f64);
    term = term * y2;
  }
  return 2.0 * sum + (k as f64) * AZ_LN2;
}

export function azLog10(v: f64): f64 {
  if (!(v > 0)) {
    return -1.0e300;
  }
  return azLn(v) / AZ_LN10;
}

export function azExp(v: f64): f64 {
  if (v > 700) {
    return 1.0e300;
  }
  if (v < -700) {
    return 0.0;
  }
  const n = Math.floor(v / AZ_LN2);
  const r = v - n * AZ_LN2;
  let term: f64 = 1.0;
  let sum: f64 = 1.0;
  for (let i: i32 = 1; i < 30; i++) {
    term = term * r / (i as f64);
    sum = sum + term;
  }
  let k = n as i32;
  while (k > 0) {
    sum = sum * 2.0;
    k--;
  }
  while (k < 0) {
    sum = sum / 2.0;
    k++;
  }
  return sum;
}

// 10 の x 乗。
export function azPow10(x: f64): f64 {
  return azExp(x * AZ_LN10);
}

// 2 乗平均（0..1 の振幅の 2 乗）から dB。無音は -120 に止める。
export function azPowerDb(ms: f64): f64 {
  if (!(ms > 1.0e-12)) {
    return -120.0;
  }
  return 10.0 * azLog10(ms);
}

// ---- 区間の道具 ----

// 区間を始まりの順に並べる（挿入整列。区間の数は多くない）。
export function azSortSpans(spans: mut AzSpan[]): void {
  for (let i: usize = 1; i < spans.length; i++) {
    let j = i;
    while (j > 0 && spans[j - 1].start > spans[j].start) {
      const a = spans[j - 1];
      spans[j - 1] = spans[j];
      spans[j] = a;
      j--;
    }
  }
}

// 重なる・接する区間をまとめる（gap 以下の隙間もつなぐ）。並べてから使う。value は大きい方を残す。
export function azMergeSpans(spans: AzSpan[], gap: f64): AzSpan[] {
  let s: AzSpan[] = [];
  for (const x of spans) {
    s.push(x);
  }
  azSortSpans(mut s);
  let out: AzSpan[] = [];
  for (const x of s) {
    if (out.length > 0 && x.start <= out[out.length - 1].end + gap) {
      const k = out.length - 1;
      out[k].end = Math.max(out[k].end, x.end);
      out[k].value = Math.max(out[k].value, x.value);
    } else {
      out.push(x);
    }
  }
  return out;
}

// [from, to] から spans（並べてまとめたもの）を除いた残り。
export function azComplement(spans: AzSpan[], from: f64, to: f64): AzSpan[] {
  const m = azMergeSpans(spans, 0.0);
  let out: AzSpan[] = [];
  let cur = from;
  for (const x of m) {
    if (x.end <= cur) {
      continue;
    }
    if (x.start >= to) {
      break;
    }
    if (x.start > cur) {
      out.push(azSpan(cur, Math.min(x.start, to), 0.0));
    }
    cur = Math.max(cur, x.end);
  }
  if (cur < to) {
    out.push(azSpan(cur, to, 0.0));
  }
  return out;
}

// ---- Y4M（render.um の y4mInfo と同じ形式: "YUV4MPEG2 W.. H.. F30:1 ..."\n のあと "FRAME\n" + YUV 4:2:0 の本体） ----

export struct AzY4m {
  ok: bool;
  error: string;
  w: i32;
  h: i32;
  fpsNum: i32;
  fpsDen: i32;
  hdr: i64;
  frames: i64;
  // 1 コマの本体の大きさ（FRAME\n を除く）
  frameBytes: i64;
  // 展開した範囲の始まり（素材の秒。<file>.in）。なければ 0 で、hasIn が false。
  inPt: f64;
  hasIn: bool;
}

function azNoY4m(err: string): AzY4m {
  return { ok: false, error: err.clone(), w: 0, h: 0, fpsNum: 30, fpsDen: 1, hdr: 0, frames: 0, frameBytes: 0, inPt: 0.0, hasIn: false };
}

function azBytesText(bytes: u8[], a: usize, b: usize): string {
  let out: u8[] = [];
  for (let i = a; i < b; i++) {
    out.push(bytes[i]);
  }
  return stringFromBytes(out);
}

export function azY4mOpen(path: string): AzY4m {
  const head = readFileRange(path, 0, 512);
  if (head == null) {
    return azNoY4m(`'${path}' を読めません`);
  }
  const size = fileSize(path);
  if (size == null) {
    return azNoY4m(`'${path}' を読めません`);
  }
  let nl: usize = 0;
  while (nl < head.length && head[nl] != 10) {
    nl++;
  }
  if (nl >= head.length) {
    return azNoY4m(`'${path}' は Y4M ではありません（ヘッダの行がありません）`);
  }
  const toks = splitBy(azBytesText(head, 0, nl), 32);
  if (toks.length == 0 || toks[0] != "YUV4MPEG2") {
    return azNoY4m(`'${path}' は Y4M ではありません（YUV4MPEG2 で始まりません）`);
  }
  let m = azNoY4m("");
  for (const t of toks) {
    if (t.length > 1 && t[0] == 87) {
      m.w = parseNum(sub(t, 1, t.length)) as i32;
    } else if (t.length > 1 && t[0] == 72) {
      m.h = parseNum(sub(t, 1, t.length)) as i32;
    } else if (t.length > 1 && t[0] == 70) {
      const f = splitBy(sub(t, 1, t.length), 58);
      if (f.length == 2) {
        const a = parseNum(f[0]);
        const b = parseNum(f[1]);
        if (!isNan(a) && !isNan(b) && a > 0 && b > 0) {
          m.fpsNum = a as i32;
          m.fpsDen = b as i32;
        }
      }
    } else if (t.length > 1 && t[0] == 67) {
      // C420jpeg / C420mpeg2 / C420paldv / C420 は 4:2:0。それ以外は扱わない
      const cs = sub(t, 1, t.length);
      if (!(cs.length >= 3 && cs[0] == 52 && cs[1] == 50 && cs[2] == 48)) {
        return azNoY4m(`'${path}' の色の形式 ${cs} は扱えません（4:2:0 だけ）`);
      }
    }
  }
  if (m.w <= 0 || m.h <= 0 || m.w % 2 != 0 || m.h % 2 != 0) {
    return azNoY4m(`'${path}' の大きさ（${m.w}x${m.h}）が読めないか、偶数ではありません`);
  }
  m.hdr = (nl + 1) as i64;
  m.frameBytes = (m.w as i64) * (m.h as i64) * 3 / 2;
  m.frames = (size - m.hdr) / (m.frameBytes + 6);
  if (m.frames <= 0) {
    return azNoY4m(`'${path}' にコマがありません`);
  }
  const first = readFileRange(path, m.hdr, 6);
  let firstOk = false;
  if (first != null) {
    firstOk = first.length == 6 && first[0] == 70 && first[5] == 10;
  }
  if (!firstOk) {
    return azNoY4m(`'${path}' のコマの見出しが FRAME\\n ではありません（コマの引数は扱いません）`);
  }
  const inText = readFile(`${path}.in`);
  if (inText != null) {
    const v = parseNum(stringFromBytes(inText));
    if (!isNan(v)) {
      m.inPt = v;
      m.hasIn = true;
    }
  }
  m.ok = true;
  return m;
}

export function azFps(m: AzY4m): f64 {
  return (m.fpsNum as f64) / (m.fpsDen as f64);
}

// k 番目のコマの YUV（本体だけ）。読めなければ長さ 0。
export function azY4mFrame(path: string, m: AzY4m, k: i64): u8[] {
  const bytes = readFileRange(path, m.hdr + k * (m.frameBytes + 6) + 6, m.frameBytes);
  if (bytes != null) {
    return bytes.clone();
  }
  let e: u8[] = [];
  return e;
}
