// 生成したテーマ（src/gen/theme.um の ThTheme）を、uikit の UkTheme に写す。
// uikit の部品（ボタン・入力欄・メニューなど）は UkTheme の名前で色と大きさを引くので、ここで対応を決める。
// 対応は docs/design/mockups/components.html の部品の見た目から:
//   ふつうのボタン = bg.3 の面と line.strong の枠、ホバー bg.4、押下 bg.0。主のボタン = accent、文字は text.onAccent。
//   値の欄 = bg.3。部品の輪郭 = line.control（WCAG 1.4.11 の 3:1）。選択 = accent.tintSolid。暗幕は敷かない。
//   危ないボタン = error の枠と文字だけ（uikit の UK_BTN_DANGER）。フォーカスの輪 = 外は focusOuter、内は accent（二重）。
//   影 = shadow.popover（0 4px 12px）。
//
// UkTheme の 1 つの名前を、uikit は違う役の部品で使い回しているので、デザインどおりに分けられない所がある:
//   border       ふつうのボタンの枠と区切りの線の両方 → line.strong（ボタンの枠を見せる方を取る。区切りも line.strong になる）
//   borderStrong スクロールバーのつまみ → text.3（溝 bg.3 と区別する）
// thButton・thCheck・thFocusRing（下の仮の部品）は、uikit に同じものが入ったので、新しい画面では uikit の部品を使う。
import { UkTheme, ukThemeDefault, ukThemeScale, ukThemeSet } from "./uikit/theme.um";
import { UkRect, ukRect, ukShrink, ukLabel } from "./uikit/base.um";
import { UkCtx, UkHit, ukBehavior, ukId, ukDrawRound, ukDrawStroke, ukDrawTextIn, ukTextW } from "./uikit/core.um";
import { ukNext } from "./uikit/layout.um";
import { ukIcon, UK_I_CHECK } from "./uikit/icons.um";
import { ThTheme, TH_TS_SM, TH_TS_MD, TH_TS_LG, TH_RADIUS_MD, TH_RADIUS_SM, TH_BORDER_HAIRLINE, TH_SIZE_ICON_SM,
  TH_SIZE_SCROLLBAR, TH_SIZE_TAB_BAR, TH_SIZE_BUTTON_MD, TH_SIZE_PROPERTY_ROW, TH_SPACE_2, TH_TS_SIZE,
  TH_SHADOW_POPOVER_BLUR, TH_SHADOW_POPOVER_X, TH_SHADOW_POPOVER_Y, TH_BORDER_FOCUS, TH_BORDER_FOCUS_OFFSET, TH_SPACE_3,
  thPx, thLine } from "./gen/theme.um";

// 色 a に b を割合 t（0〜256）で混ぜる。
function thUkMix(a: u32, b: u32, t: u32): u32 {
  const u = 256 - t;
  const ra = (a >> 16) & 255;
  const ga = (a >> 8) & 255;
  const ba = a & 255;
  const rb = (b >> 16) & 255;
  const gb = (b >> 8) & 255;
  const bb = b & 255;
  const r = (ra * u + rb * t) >> 8;
  const g = (ga * u + gb * t) >> 8;
  const bl = (ba * u + bb * t) >> 8;
  return (a & 0xff000000) | (r << 16) | (g << 8) | bl;
}

// 色の不透明度を a（0〜255）にする。
function thUkAlpha(c: u32, a: u32): u32 {
  return (c & 0x00ffffff) | (a << 24);
}

// ThTheme から UkTheme を作る。倍率は th.scale（0.8〜2.0）。
export function thToUk(th: ThTheme): UkTheme {
  let u = ukThemeDefault(th.scale);
  const c = th.c;
  u.bg = c.bg0;
  u.panel = c.bg1;
  u.panelAlt = c.bg2;
  u.raised = c.bg3;
  u.raisedHover = c.bg4;
  u.raisedActive = c.bg0;
  u.inputBg = c.bg3;
  u.border = c.lineStrong;
  u.borderStrong = c.text3;
  u.lineControl = c.lineControl;                        // 部品の輪郭（bg.0〜bg.3 に 3:1 以上）
  u.text = c.text1;
  u.textDim = c.text2;
  u.textOff = c.textDisabled;
  u.accent = c.accent;
  u.accentHover = c.accentHover;
  u.accentActive = thUkMix(c.accent, 0xff000000, 51);   // モックアップの brightness(.8)
  u.onAccent = c.textOnAccent;
  u.danger = c.error;                                  // 危ないボタンは error の枠と文字だけ
  u.dangerHover = thUkMix(c.error, 0xffffffff, 38);
  u.dangerTint = c.errorTint;
  u.success = c.ok;
  u.warning = c.warn;
  u.focus = c.accent;
  u.focusOuter = c.focusOuter;
  u.selection = c.accentTintSolid;
  u.track = c.bg3;                                      // 進み具合・スクロールの溝（つまみ borderStrong と見分ける）
  u.shadow = th.shadowPopoverColor;
  u.tipBg = c.bgPopover;
  u.tipText = c.text1;
  // 大きさは倍率 1.0 の値を base に入れて、uikit に倍率を掛けさせる
  ukThemeSet(mut u, "size.font", 0, TH_TS_SIZE[TH_TS_MD as usize], false);
  ukThemeSet(mut u, "size.fontSmall", 0, TH_TS_SIZE[TH_TS_SM as usize], false);
  ukThemeSet(mut u, "size.fontLarge", 0, TH_TS_SIZE[TH_TS_LG as usize], false);
  ukThemeSet(mut u, "size.ctrlH", 0, TH_SIZE_BUTTON_MD as f32, false);
  ukThemeSet(mut u, "size.rowH", 0, TH_SIZE_PROPERTY_ROW as f32, false);
  ukThemeSet(mut u, "size.pad", 0, TH_SPACE_2 as f32, false);
  ukThemeSet(mut u, "size.gap", 0, TH_SPACE_2 as f32, false);
  ukThemeSet(mut u, "size.radius", 0, TH_RADIUS_MD as f32, false);
  ukThemeSet(mut u, "size.radiusSm", 0, TH_RADIUS_SM as f32, false);
  ukThemeSet(mut u, "size.stroke", 0, TH_BORDER_HAIRLINE as f32, false);
  ukThemeSet(mut u, "size.icon", 0, TH_SIZE_ICON_SM as f32, false);
  ukThemeSet(mut u, "size.scrollW", 0, TH_SIZE_SCROLLBAR as f32, false);
  ukThemeSet(mut u, "size.tabH", 0, TH_SIZE_TAB_BAR as f32, false);
  ukThemeSet(mut u, "size.menuH", 0, TH_SIZE_BUTTON_MD as f32, false);
  ukThemeSet(mut u, "size.shadowBlur", 0, TH_SHADOW_POPOVER_BLUR as f32, false);
  ukThemeSet(mut u, "size.shadowX", 0, TH_SHADOW_POPOVER_X as f32, false);
  ukThemeSet(mut u, "size.shadowY", 0, TH_SHADOW_POPOVER_Y as f32, false);
  ukThemeSet(mut u, "size.focusW", 0, TH_BORDER_FOCUS as f32, false);
  ukThemeSet(mut u, "size.focusOffset", 0, TH_BORDER_FOCUS_OFFSET as f32, false);
  ukThemeScale(mut u, th.scale);
  return u;
}

// 半透明の色を、下の面に重ねたときの不透明な色にする（見本や、半透明を描けない所で使う）。
export function thOver(top: u32, below: u32): u32 {
  const a = (top >> 24) & 255;
  return thUkMix(thUkAlpha(below, 255), thUkAlpha(top, 255), (a * 256 + 127) / 255);
}

// ---- 仮の部品（uikit に入るまで）: デザインどおりのボタン・チェックと、二重のフォーカスの輪 ----

// ボタンの種類（components.html の 5 行）
export const TH_BTN_SECONDARY: i32 = 0;  // ふつう: bg.3 の面、line.strong の枠
export const TH_BTN_PRIMARY: i32 = 1;    // 主: accent
export const TH_BTN_GHOST: i32 = 2;      // 弱い: 地も枠もなし、文字は text.2
export const TH_BTN_DANGER: i32 = 3;     // 危ない: 枠だけ（error の枠と文字、地は透明）
export const TH_BTN_AI: i32 = 4;         // AI: ai の面、文字は text.onAi
export const TH_BTN_KIND_COUNT: i32 = 5;

// 見た目の状態（見本で状態を固定して描くときに渡す。-1 なら操作から決める）
export const TH_ST_LIVE: i32 = -1;
export const TH_ST_NORMAL: i32 = 0;
export const TH_ST_HOVER: i32 = 1;
export const TH_ST_PRESSED: i32 = 2;
export const TH_ST_FOCUS: i32 = 3;
export const TH_ST_DISABLED: i32 = 4;
export const TH_ST_COUNT: i32 = 5;

// 明るさを掛ける（CSS の filter: brightness(k/256)）。
function thUkBright(c: u32, k: u32): u32 {
  const r = Math.min((((c >> 16) & 255) * k) >> 8, 255);
  const g = Math.min((((c >> 8) & 255) * k) >> 8, 255);
  const b = Math.min(((c & 255) * k) >> 8, 255);
  return (c & 0xff000000) | (r << 16) | (g << 8) | b;
}

// 二重のフォーカスの輪（正本: 外は focusOuter 1、内は accent 2、部品から 1 離す。CSS の
// outline:2px accent; outline-offset:1px; box-shadow:0 0 0 4px focusOuter と同じ見え方）。radius は部品の角。
export function thFocusRing(ui: mut UkCtx, th: ThTheme, r: UkRect, radius: i32): void {
  const off = th.borderFocusOffset;
  const fw = th.borderFocus;
  const outer = thLine(th, 1);
  const all = off + fw + outer;
  ukDrawStroke(mut ui, ukShrink(r, -all), radius + all, all, th.c.focusOuter);
  ukDrawStroke(mut ui, ukShrink(r, -(off + fw)), radius + off + fw, fw, th.c.accent);
}

// フォーカスがあり、キーボードで動かしたときだけ二重の輪を描く（uikit の ukFocusRing の代わり）。
export function thFocusRingIf(ui: mut UkCtx, th: ThTheme, r: UkRect, radius: i32, h: UkHit): void {
  if (h.focused && ui.focusVisible) {
    thFocusRing(mut ui, th, r, radius);
  }
}

// ボタンの [地, 枠, 文字] を、種類と状態から決める（components.html の .btn の規則）。
export function thButtonColors(th: ThTheme, kind: i32, st: i32): u32[] {
  const c = th.c;
  if (st == TH_ST_DISABLED) {
    if (kind == TH_BTN_PRIMARY) {
      return [c.bg3, c.bg3, c.textDisabled];
    }
    if (kind == TH_BTN_GHOST) {
      return [0, 0, c.textDisabled];
    }
    return [c.bg2, c.line, c.textDisabled];   // .btn.dis（危ない・AI もこれ）
  }
  const hov = st == TH_ST_HOVER;
  const prs = st == TH_ST_PRESSED;
  if (kind == TH_BTN_PRIMARY) {
    let bg = c.accent;
    if (hov) {
      bg = c.accentHover;
    } else if (prs) {
      bg = thUkBright(c.accent, 205);          // brightness(.8)
    }
    return [bg, bg, c.textOnAccent];
  }
  if (kind == TH_BTN_AI) {
    let bg = c.ai;
    if (hov) {
      bg = thUkBright(c.ai, 282);              // brightness(1.1)
    } else if (prs) {
      bg = thUkBright(c.ai, 218);              // brightness(.85)
    }
    return [bg, bg, c.textOnAi];
  }
  if (kind == TH_BTN_GHOST) {
    if (hov) {
      return [c.bg3, 0, c.text1];
    }
    if (prs) {
      return [c.bg0, 0, c.text2];
    }
    return [0, 0, c.text2];
  }
  if (kind == TH_BTN_DANGER) {
    if (hov) {
      return [c.errorTint, c.error, c.error];
    }
    if (prs) {
      return [c.bg0, c.error, c.error];
    }
    return [0, c.error, c.error];
  }
  if (hov) {
    return [c.bg4, c.lineStrong, c.text1];
  }
  if (prs) {
    return [c.bg0, c.lineStrong, c.text1];
  }
  return [c.bg3, c.lineStrong, c.text1];
}

// 1 つのボタンを r に描く（状態は st で決める。TH_ST_FOCUS は二重の輪をつける）。
export function thButtonDraw(ui: mut UkCtx, th: ThTheme, r0: UkRect, txt: string, kind: i32, st: i32): void {
  let r = r0;
  if (st == TH_ST_PRESSED) {
    r = ukRect(r0.x, r0.y + thLine(th, 1), r0.w, r0.h);   // translateY(1px)
  }
  const col = thButtonColors(th, kind, st);
  const rad = th.radiusMd;
  if ((col[0] >> 24) != 0) {
    ukDrawRound(mut ui, r, rad, col[0]);
  }
  if ((col[1] >> 24) != 0) {
    ukDrawStroke(mut ui, r, rad, th.borderHairline, col[1]);
  }
  ukDrawTextIn(mut ui, r, txt, ui.theme.fontSize, col[2], 1);
  if (st == TH_ST_FOCUS) {
    thFocusRing(mut ui, th, r, rad);
  }
}

// デザインどおりのボタン（uikit の ukButtonEx の代わり）。押されたら true。
// state は TH_ST_LIVE（ふつうに操作する）か、見本で固定する TH_ST_*。
export function thButton(ui: mut UkCtx, th: ThTheme, label: string, kind: i32, state: i32): bool {
  const id = ukId(ui, label);
  const txt = ukLabel(label);
  const tw = ukTextW(mut ui, txt, ui.theme.fontSize);
  const r = ukNext(mut ui, Math.max(tw + 2 * thPx(th, TH_SPACE_3), th.buttonMd), th.buttonMd);
  const off = ui.disabled > 0 || state == TH_ST_DISABLED;
  const h = ukBehavior(mut ui, id, r, !off);
  let st = state;
  if (st == TH_ST_LIVE) {
    st = TH_ST_NORMAL;
    if (off) {
      st = TH_ST_DISABLED;
    } else if (h.held && h.hover) {
      st = TH_ST_PRESSED;
    } else if (h.hover) {
      st = TH_ST_HOVER;
    }
  }
  thButtonDraw(mut ui, th, r, txt, kind, st);
  if (state == TH_ST_LIVE && !off) {
    thFocusRingIf(mut ui, th, r, th.radiusMd, h);
  }
  return h.clicked && !off;
}

// デザインどおりのチェック（.chk: bg.0 の地に line.control の枠、オンは accent の地に text.onAccent の印）。
export function thCheck(ui: mut UkCtx, th: ThTheme, label: string, on: bool, state: i32): bool {
  const id = ukId(ui, label);
  const txt = ukLabel(label);
  const bs = th.iconSm;
  const gap = th.space[2];
  const r = ukNext(mut ui, bs + gap + ukTextW(mut ui, txt, ui.theme.fontSize), th.buttonMd);
  const off = ui.disabled > 0 || state == TH_ST_DISABLED;
  const h = ukBehavior(mut ui, id, r, !off);
  let v = on;
  if (h.clicked && !off) {
    v = !v;
    ui.lastChanged = true;
  }
  const c = th.c;
  const br = ukRect(r.x, r.y + (r.h - bs) / 2, bs, bs);
  const rad = th.radiusSm;
  const hov = state == TH_ST_HOVER || (state == TH_ST_LIVE && h.hover);
  if (v) {
    let bg = c.accent;
    if (off) {
      bg = c.bg3;
    } else if (hov) {
      bg = c.accentHover;
    }
    ukDrawRound(mut ui, br, rad, bg);
    let ink = c.textOnAccent;
    if (off) {
      ink = c.textDisabled;
    }
    ukIcon(mut ui, ukShrink(br, th.borderHairline), UK_I_CHECK, ink);
  } else {
    ukDrawRound(mut ui, br, rad, c.bg0);
    let bc = c.lineControl;
    if (off) {
      bc = c.line;
    } else if (hov) {
      bc = c.text2;
    }
    ukDrawStroke(mut ui, br, rad, th.borderHairline, bc);
  }
  let tc = c.text1;
  if (off) {
    tc = c.textDisabled;
  }
  ukDrawTextIn(mut ui, ukRect(br.x + bs + gap, r.y, r.w - bs - gap, r.h), txt, ui.theme.fontSize, tc, 0);
  if (state == TH_ST_FOCUS) {
    thFocusRing(mut ui, th, br, rad);
  } else if (state == TH_ST_LIVE && !off) {
    thFocusRingIf(mut ui, th, br, rad, h);
  }
  return v;
}
