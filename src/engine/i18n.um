  i18nAdd(mut t, "keymap.preset.standard", "MozaicCut 標準", "MozaicCut Standard");
  i18nAdd(mut t, "keymap.preset.premiere", "Premiere Pro 互換", "Premiere Pro compatible");
  i18nAdd(mut t, "keymap.preset.resolve", "DaVinci Resolve 互換", "DaVinci Resolve compatible");
  i18nAdd(mut t, "keymap.preset.legacy", "MozaicCut 0.x", "MozaicCut 0.x");
  i18nAdd(mut t, "keymap.preset.short.standard", "標準", "Standard");
  i18nAdd(mut t, "keymap.preset.short.premiere", "Premiere 互換", "Premiere");
  i18nAdd(mut t, "keymap.preset.short.resolve", "Resolve 互換", "Resolve");
  i18nAdd(mut t, "keymap.layout.jis", "JIS", "JIS");
  i18nAdd(mut t, "keymap.layout.us", "US", "US");
  i18nAdd(mut t, "keymap.search", "コマンドやキーで探す", "Search commands or keys");
  i18nAdd(mut t, "keymap.export", "JSON に保存する", "Save as JSON");
  i18nAdd(mut t, "keymap.import", "JSON から読み込む", "Load from JSON");
  i18nAdd(mut t, "keymap.close", "閉じる", "Close");
  i18nAdd(mut t, "keymap.mods", "修飾キー", "Modifiers");
  i18nAdd(mut t, "keymap.mods.none", "なし", "None");
  i18nAdd(mut t, "keymap.mods.hint", "修飾キーを押すと、その組み合わせの割り当てに切り替わります", "Hold a modifier key to show the shortcuts that use it");
  i18nAdd(mut t, "keymap.legend.play", "再生と移動", "Playback and navigation");
  i18nAdd(mut t, "keymap.legend.mark", "印", "Marks");
  i18nAdd(mut t, "keymap.legend.tool", "ツール", "Tools");
  i18nAdd(mut t, "keymap.legend.ripple", "詰める", "Ripple");
  i18nAdd(mut t, "keymap.legend.over", "詰めない", "Overwrite");
  i18nAdd(mut t, "keymap.legend.view", "表示・その他", "View and other");
