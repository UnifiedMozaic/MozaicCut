  i18nAdd(mut t, "term.effect", "効果", "Effect");
  i18nAdd(mut t, "term.keyframe", "キーフレーム", "Keyframe");
  i18nAdd(mut t, "term.inspector", "インスペクタ", "Inspector");
  i18nAdd(mut t, "term.export", "書き出し", "Export");
  i18nAdd(mut t, "term.import", "読み込み", "Import");
  i18nAdd(mut t, "term.proposal", "提案", "Proposal");
