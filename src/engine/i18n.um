  i18nAdd(mut t, "term.author.ai", "AI", "AI");
  i18nAdd(mut t, "term.author.text", "テキスト", "Text");
  i18nAdd(mut t, "term.trim.ripple.tip", "リップル: 長さを変え、後ろを詰めたり押したりします", "Ripple: changes the length and pulls or pushes what follows");
  i18nAdd(mut t, "term.trim.roll.tip", "ロール: 編集点を動かし、全体の長さは変えません", "Roll: moves the edit point without changing the total length");
