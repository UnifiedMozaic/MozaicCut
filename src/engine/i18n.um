// 画面の文言の表（docs/design/ui.md の 16 章）。日本語と英語。文言は ID（場所.物.動き）で引く。
//
//   let t = i18nNew(I18N_JA);
//   i18nT(t, "keymap.title")                       → "キーの割り当て"
//   i18nFmt(t, "keymap.conflict.body", [a, b, c])  → {0} {1} {2} を置き換える
//   i18nSetLang(mut t, I18N_EN)                    設定の「言語」ですぐ切り替わる
//
// - 画面のコードに文言を直接書かない。新しい文言はここ（i18nBuild）に足す。英語は 1.3〜1.5 倍の長さを見込む。
// - i18n/ja.json・i18n/en.json（{"ID": "文言"} の平らな JSON）を i18nLoadJson で重ねられる（翻訳の直しを再ビルドなしで試す）。
// - 英語が空の項目は日本語を出す。ID が無ければ ID をそのまま出す（抜けに気づける）。
// - 用語集（16.2）は i18nGlossary。文言はこの用語に従う（「戻す」は注釈を戻すときだけ、など）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は i18n / I18n / I18N_ で始める。

export const I18N_JA: i32 = 0;
export const I18N_EN: i32 = 1;

const I18N_SLOTS: usize = 2048;

export struct I18n {
  lang: i32;
  ids: string[];
  ja: string[];
  en: string[];
  // ID のハッシュの表（開番地法。-1 は空き）
  slots: i32[];
}

export struct I18nTerm {
  ja: string;
  en: string;
  note: string;
}

function i18nHash(s: string): u32 {
  let h: u32 = 2166136261;
  for (let i: usize = 0; i < s.length; i++) {
    h = (h ^ (s[i] as u32)) * 16777619;
  }
  return h;
}

function i18nFind(t: I18n, id: string): i32 {
  let k = (i18nHash(id) as usize) & (I18N_SLOTS - 1);
  for (let n: usize = 0; n < I18N_SLOTS; n++) {
    const v = t.slots[k];
    if (v < 0) {
      return -1;
    }
    if (t.ids[v as usize] == id) {
      return v;
    }
    k = (k + 1) & (I18N_SLOTS - 1);
  }
  return -1;
}

// 足す（同じ ID があれば置き換える）。
export function i18nAdd(t: mut I18n, id: string, ja: string, en: string): void {
  const f = i18nFind(t, id);
  if (f >= 0) {
    t.ja[f as usize] = ja.clone();
    t.en[f as usize] = en.clone();
    return;
  }
  if (t.ids.length >= I18N_SLOTS - 1) {
    eprint("i18n: table is full");
    return;
  }
  const idx = t.ids.length as i32;
  t.ids.push(id.clone());
  t.ja.push(ja.clone());
  t.en.push(en.clone());
  let k = (i18nHash(id) as usize) & (I18N_SLOTS - 1);
  while (t.slots[k] >= 0) {
    k = (k + 1) & (I18N_SLOTS - 1);
  }
  t.slots[k] = idx;
}

export function i18nNew(lang: i32): I18n {
  let slots: i32[] = [];
  for (let i: usize = 0; i < I18N_SLOTS; i++) {
    slots.push(-1);
  }
  let t: I18n = { lang, ids: [], ja: [], en: [], slots };
  i18nBuild(mut t);
  return t;
}

export function i18nSetLang(t: mut I18n, lang: i32): void {
  t.lang = lang;
}

export function i18nHas(t: I18n, id: string): bool {
  return i18nFind(t, id) >= 0;
}

// ID の文言（今の言語）。
export function i18nT(t: I18n, id: string): string {
  const f = i18nFind(t, id);
  if (f < 0) {
    return id.clone();
  }
  if (t.lang == I18N_EN && t.en[f as usize].length > 0) {
    return t.en[f as usize].clone();
  }
  return t.ja[f as usize].clone();
}

// 言語を決めて引く（一覧で日本語と英語の両方で探すときなど）。
export function i18nTL(t: I18n, lang: i32, id: string): string {
  const f = i18nFind(t, id);
  if (f < 0) {
    return id.clone();
  }
  if (lang == I18N_EN && t.en[f as usize].length > 0) {
    return t.en[f as usize].clone();
  }
  return t.ja[f as usize].clone();
}

// {0} {1} … を args で置き換える。
export function i18nFmt(t: I18n, id: string, args: string[]): string {
  const s = i18nT(t, id);
  let out: u8[] = [];
  let i: usize = 0;
  while (i < s.length) {
    if (s[i] == 123 && i + 2 < s.length && s[i + 1] >= 48 && s[i + 1] <= 57 && s[i + 2] == 125) {
      const n = (s[i + 1] - 48) as usize;
      if (n < args.length) {
        for (let j: usize = 0; j < args[n].length; j++) {
          out.push(args[n][j]);
        }
      }
      i += 3;
    } else {
      out.push(s[i]);
      i++;
    }
  }
  return stringFromBytes(out);
}

// 日本語か英語が空の ID を返す（試しで使う。0.x のような固有名は両方同じでよい）。
export function i18nCheck(t: I18n): string[] {
  let out: string[] = [];
  for (let i: usize = 0; i < t.ids.length; i++) {
    if (t.ja[i].length == 0 || t.en[i].length == 0) {
      out.push(t.ids[i].clone());
    }
  }
  return out;
}

// {"ID": "文言", ...} の平らな JSON を重ねる（lang の側だけ）。読めた数を返す。
export function i18nLoadJson(t: mut I18n, lang: i32, json: string): i32 {
  let n = 0;
  let i: usize = 0;
  let key = "";
  let haveKey = false;
  while (i < json.length) {
    if (json[i] == 34) {
      let out: u8[] = [];
      let j = i + 1;
      while (j < json.length && json[j] != 34) {
        if (json[j] == 92 && j + 1 < json.length) {
          j++;
          if (json[j] == 110) {
            out.push(10);
          } else {
            out.push(json[j]);
          }
        } else {
          out.push(json[j]);
        }
        j++;
      }
      const s = stringFromBytes(out);
      i = j + 1;
      if (!haveKey) {
        key = s;
        haveKey = true;
      } else {
        const f = i18nFind(t, key);
        if (f >= 0) {
          if (lang == I18N_EN) {
            t.en[f as usize] = s;
          } else {
            t.ja[f as usize] = s;
          }
        } else if (lang == I18N_EN) {
          i18nAdd(mut t, key, "", s);
        } else {
          i18nAdd(mut t, key, s, "");
        }
        n++;
        haveKey = false;
      }
    } else {
      i++;
    }
  }
  return n;
}

// ---- 用語集（ui.md 16.2） ----

function i18nTerm(out: mut I18nTerm[], ja: string, en: string, note: string): void {
  out.push({ ja: ja.clone(), en: en.clone(), note: note.clone() });
}

export function i18nGlossary(): I18nTerm[] {
  let o: I18nTerm[] = [];
  i18nTerm(mut o, "プロジェクト", "project", "1 つの .mzc");
  i18nTerm(mut o, "シーケンス", "sequence", "タイムラインの 1 本");
  i18nTerm(mut o, "クリップ", "clip", "タイムラインの上のもの（.mzc の 1 行）");
  i18nTerm(mut o, "素材", "media", "元のファイル");
  i18nTerm(mut o, "メディアプール（素材の欄）", "media pool", "画面では「素材」と書く");
  i18nTerm(mut o, "ビン ／ スマートビン", "bin / smart bin", "素材のフォルダ ／ 条件で集めるフォルダ");
  i18nTerm(mut o, "トラック V1・A1", "track", "番号は 1 から。名前は人が付ける（「本編」「BGM」）");
  i18nTerm(mut o, "映像・音・文字・静止画・色", "video / audio / text / image / color", "クリップの種類。行の頭の語と並べるときは「映像（video）」");
  i18nTerm(mut o, "字幕 ／ テロップ", "subtitle / title", "字幕は話の文字、テロップは飾りの文字");
  i18nTerm(mut o, "ターゲット", "target", "入れる・貼る・分ける行き先のトラック（[V1] の札）");
  i18nTerm(mut o, "インポイント ／ アウトポイント（イン ／ アウト）", "in point / out point", "短く「イン」「アウト」とも書く");
  i18nTerm(mut o, "コマ", "frame", "画面の文言は「コマ」に統一する（「1 コマ戻る」「12 コマ」「コマ落ち」「コマ数」）。例外は業界の決まった語の「フレームレート」「マッチフレーム」だけ。別名「フレーム」で引ける");
  i18nTerm(mut o, "フレームレート", "frame rate", "「コマの速さ」とは書かない。表示は 30p 29.97p");
  i18nTerm(mut o, "解像度", "resolution", "「画面の大きさ」とは書かない。表示は 1920×1080");
  i18nTerm(mut o, "テキスト", "text (the .mzc body)", ".mzc の本文のこと（レールの「テキスト」、［テキストで開く］、「テキストで見る」）。「ソース」とは呼ばない");
  i18nTerm(mut o, "文字", "text clip", "文字のクリップ（.mzc の text 行）と左の欄の「文字」。テキストと混ぜない");
  i18nTerm(mut o, "ソース", "source", "ソースモニターとソースのパッチだけに使う");
  i18nTerm(mut o, "再生ヘッド", "playhead", "");
  i18nTerm(mut o, "編集点", "edit point", "クリップとクリップの境目");
  i18nTerm(mut o, "分割", "split", "");
  i18nTerm(mut o, "削除（隙間を残す）", "lift", "後ろを動かさない削除。キーの上の短い名前は「リフト」（Premiere の呼び方）");
  i18nTerm(mut o, "詰めて削除", "ripple delete", "後ろを詰める削除");
  i18nTerm(mut o, "イン〜アウトを詰めて削除", "extract", "Premiere の「抽出」");
  i18nTerm(mut o, "詰める ／ 詰めない", "ripple / overwrite", "2 系統の言い方");
  i18nTerm(mut o, "挿入 ／ 上書き", "insert / overwrite", "");
  i18nTerm(mut o, "リップル ／ ロール ／ スリップ ／ スライド", "ripple / roll / slip / slide", "トリムの種類。初めて出る所でツールチップに 1 行の説明（「リップル: 長さを変え、後ろを詰めたり押したりします」）");
  i18nTerm(mut o, "ブレード", "blade", "Resolve の呼び方。Premiere の「レーザー」も別名で引ける");
  i18nTerm(mut o, "マーカー", "marker", "");
  i18nTerm(mut o, "マッチフレーム", "match frame", "");
  i18nTerm(mut o, "参照", "reference", "at=clip_a.start+1.5");
  i18nTerm(mut o, "効果", "effect", "プラグインの効果");
  i18nTerm(mut o, "キーフレーム", "keyframe", "");
  i18nTerm(mut o, "インスペクタ", "inspector", "");
  i18nTerm(mut o, "書き出し ／ 書き出す", "export", "ワークスペースの名前は「出力」（ボタンの［書き出す…］と紛れないように）");
  i18nTerm(mut o, "読み込み ／ 読み込む", "import", "");
  i18nTerm(mut o, "提案", "proposal", "AI が出した、まだ書いていない op のまとまり");
  i18nTerm(mut o, "試算済み", "dry-run done", "機械が dry-run を済ませたこと。人の確認とは別");
  i18nTerm(mut o, "確認する", "review", "人が提案の中身を見ること（［確認する］）。機械の dry-run には使わない");
  i18nTerm(mut o, "適用する ／ 却下する", "apply / reject", "ボタンは動詞の終止形");
  i18nTerm(mut o, "取り消す ／ やり直す", "undo / redo", "Ctrl+Z ／ Ctrl+Shift+Z。履歴の［ここまで取り消す］、却下の［却下を取り消す］");
  i18nTerm(mut o, "復元する", "restore", "自動保存から作業を取り戻すこと（［自動保存から復元する］）");
  i18nTerm(mut o, "戻す", "uncomment", "注釈にしたクリップを戻すとき（テキストの欄の［戻す］）だけ使う");
  i18nTerm(mut o, "履歴", "history", "書き手つきの操作の流れ");
  i18nTerm(mut o, "問題", "problems", "診断（エラーと警告）のまとめた呼び方。「誤り」とは書かない（札は「✓ 問題なし」）");
  i18nTerm(mut o, "エラー ／ 警告", "error / warning", "種類の呼び方。数は「エラーの増加 0」「エラー 1 · 警告 1」");
  i18nTerm(mut o, "原因コード", "code", "unknown-key など");
  i18nTerm(mut o, "書き手（人 ／ AI ／ テキスト）", "author (you / AI / text)", "テキストは外のエディタ");
  return o;
}

