  i18nAdd(mut t, "term.smartBin", "スマートビン", "Smart bin");
  i18nAdd(mut t, "term.track", "トラック", "Track");
  i18nAdd(mut t, "term.video", "映像", "Video");
  i18nAdd(mut t, "term.audio", "音", "Audio");
  i18nAdd(mut t, "term.text", "文字", "Text");
  i18nAdd(mut t, "term.image", "静止画", "Image");
  i18nAdd(mut t, "term.color", "色", "Color");
  i18nAdd(mut t, "term.subtitle", "字幕", "Subtitle");
  i18nAdd(mut t, "term.title", "テロップ", "Title");
  i18nAdd(mut t, "term.target", "ターゲット", "Target");
  i18nAdd(mut t, "term.in", "イン", "In");
  i18nAdd(mut t, "term.out", "アウト", "Out");
  i18nAdd(mut t, "term.playhead", "再生ヘッド", "Playhead");
  i18nAdd(mut t, "term.editPoint", "編集点", "Edit point");
  i18nAdd(mut t, "term.split", "分割", "Split");
  i18nAdd(mut t, "term.lift", "削除（隙間を残す）", "Lift");
  i18nAdd(mut t, "term.rippleDelete", "詰めて削除", "Ripple delete");
  i18nAdd(mut t, "term.ripple", "詰める", "Ripple");
  i18nAdd(mut t, "term.overwrite", "詰めない", "Overwrite");
  i18nAdd(mut t, "term.insert", "挿入", "Insert");
  i18nAdd(mut t, "term.overwriteEdit", "上書き", "Overwrite");
  i18nAdd(mut t, "term.trim.ripple", "リップル", "Ripple");
  i18nAdd(mut t, "term.trim.roll", "ロール", "Roll");
  i18nAdd(mut t, "term.trim.slip", "スリップ", "Slip");
