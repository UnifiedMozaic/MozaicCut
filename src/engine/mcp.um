// ネイティブ MCP サーバー（Model Context Protocol / JSON-RPC 2.0 over stdio）。
// Node.js なしで Claude Code / Claude Desktop などから MozaicCut のプロジェクトを編集できる。
//
//   mozcut mcp [--root <フォルダ>]...
//
// ツール: schema / list_projects / create_project / check / show / analyze_audio / op / preview / render
// 安全のため、--root（省くとカレントフォルダ）の外のパスおよび ".." による遡りを拒否する。
import { AzJson, azJsonParse, azjFind, azjNum, azjStr, AZJ_OBJ, AZJ_ARR, AZJ_STR, AZJ_NUM, AZJ_BOOL } from "../effects/analyze/json.um";
import { Project, Probe, Diag, parseProjectReg, readProbes } from "./project.um";
import { jsonStr, jsonNum, diagsJson, projectJsonReg, showTextReg, schemaJsonReg } from "./report.um";
import { splitArgs, runOpsReg, OpResult, Change, Moved, BatchResult } from "./ops.um";
import { splitLines, appendText, sub, fmtTime } from "./text.um";
import { loadMedia, checkMedia, renderFrameReg, newRenderCache, writeBmp } from "./render.um";
import { encDefaults, encOpen, encStepReg, encFinish } from "./encode.um";
import { ffEnabled } from "./ffmpeg.um";
import { mediaProbeSources } from "./media.um";
import { projectFont } from "../effects/text/ttf.um";
import { FxReg } from "../gen/plugins.um";
import { MOZCUT_VERSION } from "../gen/version.um";
import { agJsonOf } from "../ai/ai_json.um";
import { aiCustomGuideText, aiAnalyzeAudioJson, aiBase64, aiPngBytes } from "./aiguide.um";

function mcpBytes(s: string): u8[] {
  let out: u8[] = [];
  for (const b of s) {
    out.push(b);
  }
  return out;
}

function mcpNormPath(p: string): string {
  let out: u8[] = [];
  for (let i: usize = 0; i < p.length; i++) {
    const b = p[i];
    if (b == 92) {
      out.push(47);
    } else if (b >= 65 && b <= 90) {
      out.push(b + 32);
    } else {
      out.push(b);
    }
  }
  while (out.length > 1 && out[out.length - 1] == 47) {
    out.pop();
  }
  return stringFromBytes(out);
}

function mcpHasDotDot(p: string): bool {
  let segStart: usize = 0;
  for (let i: usize = 0; i <= p.length; i++) {
    if (i == p.length || p[i] == 47 || p[i] == 92) {
      if (i - segStart == 2 && p[segStart] == 46 && p[segStart + 1] == 46) {
        return true;
      }
      segStart = i + 1;
    }
  }
  return false;
}

function mcpIsAbs(p: string): bool {
  if (p.length >= 1 && (p[0] == 47 || p[0] == 92)) {
    return true;
  }
  if (p.length >= 3 && p[1] == 58 && (p[2] == 47 || p[2] == 92)) {
    return true;
  }
  return false;
}

function mcpStartsWith(s: string, pre: string): bool {
  if (pre.length > s.length) {
    return false;
  }
  for (let i: usize = 0; i < pre.length; i++) {
    if (s[i] != pre[i]) {
      return false;
    }
  }
  return true;
}

function mcpEndsWithLower(s: string, suf: string): bool {
  if (suf.length > s.length) {
    return false;
  }
  const off = s.length - suf.length;
  for (let i: usize = 0; i < suf.length; i++) {
    let a = s[off + i];
    if (a >= 65 && a <= 90) {
      a = a + 32;
    }
    if (a != suf[i]) {
      return false;
    }
  }
  return true;
}

function mcpResolvePath(raw: string, roots: string[]): string {
  if (raw.length == 0 || mcpHasDotDot(raw)) {
    return "";
  }
  if (mcpIsAbs(raw)) {
    const np = mcpNormPath(raw);
    for (const r of roots) {
      const nr = mcpNormPath(r);
      if (np == nr || (mcpStartsWith(np, nr) && np.length > nr.length && np[nr.length] == 47)) {
        return raw.clone();
      }
    }
    return "";
  }
  if (roots.length == 0) {
    return raw.clone();
  }
  const base = roots[0].clone();
  if (base.length == 0 || base == ".") {
    return raw.clone();
  }
  const last = base[base.length - 1];
  if (last == 47 || last == 92) {
    return base + raw;
  }
  return `${base}/${raw}`;
}

function mcpDefaultCache(projectPath: string): string {
  let dot = projectPath.length;
  for (let i = projectPath.length; i > 0; i--) {
    const c = projectPath[i - 1];
    if (c == 47 || c == 92) {
      break;
    }
    if (c == 46) {
      dot = i - 1;
      break;
    }
  }
  return sub(projectPath, 0, dot) + ".cache";
}

function mcpReadProbes(projectPath: string, cache: string, bytes: u8[], reg: FxReg): Probe[] {
  let probes: Probe[] = [];
  if (cache.length > 0) {
    const pb = readFile(`${cache}/probe.txt`);
    if (pb != null) {
      probes = readProbes(stringFromBytes(pb));
    }
  }
  if (ffEnabled()) {
    let known: Probe[] = [];
    probes = mediaProbeSources(bytes, projectPath, probes, mut known);
  }
  return probes;
}

function mcpScanProjects(dir: string, depth: i32, out: mut string[]): void {
  if (depth > 5 || out.length >= 200) {
    return;
  }
  const names = listDir(dir);
  if (names == null) {
    return;
  }
  for (const name of names) {
    if (name == "" || name == "." || name == ".." || name == ".git" || name == "node_modules" || name == "build" || name == "dist") {
      continue;
    }
    if (mcpEndsWithLower(name, ".cache")) {
      continue;
    }
    let full = name.clone();
    if (dir != "" && dir != ".") {
      const last = dir[dir.length - 1];
      if (last == 47 || last == 92) {
        full = dir + name;
      } else {
        full = `${dir}/${name}`;
      }
    }
    if (mcpEndsWithLower(name, ".mzc")) {
      out.push(full);
      if (out.length >= 200) {
        return;
      }
    } else if (depth < 5) {
      const subList = listDir(full);
      if (subList != null) {
        mcpScanProjects(full, depth + 1, mut out);
      }
    }
  }
}

function mcpIdJson(root: AzJson): string {
  const k = azjFind(root, "id");
  if (k < 0) {
    return "null";
  }
  const kind = root.items[k as usize].kind;
  if (kind == AZJ_NUM) {
    return `${root.items[k as usize].num as i64}`;
  }
  if (kind == AZJ_STR) {
    return jsonStr(root.items[k as usize].str);
  }
  return "null";
}

function mcpRespOk(idJson: string, resultJson: string): void {
  print(`{"jsonrpc":"2.0","id":${idJson},"result":${resultJson}}`);
}

function mcpRespErr(idJson: string, code: i32, msg: string): void {
  print(`{"jsonrpc":"2.0","id":${idJson},"error":{"code":${code},"message":${jsonStr(msg)}}}`);
}

function mcpToolResult(text: string, isErr: bool): string {
  let errStr = "false";
  if (isErr) {
    errStr = "true";
  }
  return `{"content":[{"type":"text","text":${jsonStr(text)}}],"isError":${errStr}}`;
}

function mcpToolResultWithPng(text: string, pngB64: string): string {
  return `{"content":[{"type":"text","text":${jsonStr(text)}},{"type":"image","data":${jsonStr(pngB64)},"mimeType":"image/png"}],"isError":false}`;
}

function mcpChangesJson(chs: Change[]): string {
  let s = "[";
  for (let i: usize = 0; i < chs.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + `{"kind":${jsonStr(chs[i].kind)},"line":${chs[i].line},"before":${jsonStr(chs[i].before)},"after":${jsonStr(chs[i].after)}}`;
  }
  return s + "]";
}

function mcpMovedJson(ms: Moved[]): string {
  let s = "[";
  for (let i: usize = 0; i < ms.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    let id = "null";
    if (ms[i].id != "") {
      id = jsonStr(ms[i].id);
    }
    s = s + `{"id":${id},"line":${ms[i].line},"before":{"start":${jsonNum(ms[i].beforeStart)},"end":${jsonNum(ms[i].beforeEnd)}},"after":{"start":${jsonNum(ms[i].afterStart)},"end":${jsonNum(ms[i].afterEnd)}}}`;
  }
  return s + "]";
}

function mcpBatchJson(b: BatchResult, applied: bool): string {
  let s = `{"ok":${b.ok},"applied":${applied},"results":[`;
  for (let i: usize = 0; i < b.results.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + `{"op":${jsonStr(b.results[i].op)},"ok":${b.results[i].ok},"code":${jsonStr(b.results[i].code)},"desc":${jsonStr(b.results[i].desc)},"error":${jsonStr(b.results[i].error)},"hint":${jsonStr(b.results[i].hint)},"suggest":${jsonStr(b.results[i].suggest)},"newId":${jsonStr(b.results[i].newId)},"changes":${mcpChangesJson(b.results[i].changes)},"moved":${mcpMovedJson(b.results[i].moved)},"newDiagnostics":${diagsJson(b.results[i].newDiagnostics)}}`;
  }
  return s + `],"diagnostics":${diagsJson(b.diags)}}`;
}

function mcpInstructions(): string {
  const base = "MozaicCut ネイティブ MCP サーバーです。手順: list_projects（または create_project）→ schema（初回）と check → 音があれば analyze_audio → op（既定 dry_run）で差分確認 → op（apply=true）で保存 → preview で見た目を確認 → 必要なら render。";
  const custom = aiCustomGuideText();
  if (custom.length > 0) {
    return base + "\n\n" + custom;
  }
  return base;
}

function mcpToolsListJson(): string {
  return "{\"tools\":[" +
    "{\"name\":\"schema\",\"description\":\"MozaicCut の .mzc で使えるキー・独立プラグイン（GPU/CPU 効果・トランジション）・操作（op）・描画モード・エクスプレッション（音連動含む）・全 14 機能早見（features）を JSON で返す。section で絞れる。\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"section\":{\"type\":\"string\",\"enum\":[\"all\",\"keys\",\"effects\",\"transitions\",\"ops\",\"syntax\",\"blend\",\"expressions\",\"features\"]}},\"additionalProperties\":false}}," +
    "{\"name\":\"list_projects\",\"description\":\"許可フォルダ内の .mzc プロジェクト一覧を返す。\",\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}}," +
    "{\"name\":\"create_project\",\"description\":\"新しい .mzc プロジェクトを作成する。overwrite=true で既存上書き。\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"project\":{\"type\":\"string\",\"description\":\"作成する .mzc のパス\"},\"size\":{\"type\":\"string\",\"description\":\"解像度（既定 1280x720）\"},\"fps\":{\"type\":\"number\",\"description\":\"フレームレート（既定 30）\"},\"bg\":{\"type\":\"string\",\"description\":\"背景色 rrggbb（既定 000000）\"},\"bpm\":{\"type\":\"number\",\"description\":\"曲の BPM（省略可）\"},\"overwrite\":{\"type\":\"boolean\"}},\"required\":[\"project\"],\"additionalProperties\":false}}," +
    "{\"name\":\"check\",\"description\":\"プロジェクト（.mzc）の診断と全クリップ配置（キー・効果・キーフレーム・式・テキストアニメ・シェイプ・パーティクル・3D・描画モード・マスク・ミキサー）を JSON で返す。\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"project\":{\"type\":\"string\",\"description\":\".mzc ファイルのパス\"}},\"required\":[\"project\"],\"additionalProperties\":false}}," +
    "{\"name\":\"show\",\"description\":\"タイムラインの図とクリップ一覧をテキストで返す。\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"project\":{\"type\":\"string\"},\"width\":{\"type\":\"integer\"}},\"required\":[\"project\"],\"additionalProperties\":false}}," +
    "{\"name\":\"analyze_audio\",\"description\":\"プロジェクトの音声を FFT 解析し、推定 BPM・ビート時刻（beats）・盛り上がりピーク（peaks）・静かな区間（quietSections）・時刻ごとの音量/低域/中域/高域推移を JSON で返す。\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"project\":{\"type\":\"string\"},\"step\":{\"type\":\"number\",\"description\":\"推移の間隔（秒。0.05〜10、既定 0.25）\"}},\"required\":[\"project\"],\"additionalProperties\":false}}," +
    "{\"name\":\"op\",\"description\":\"プロジェクトへ操作を適用する。apply=false（既定）なら dry_run で差分（changes / moved）のみ返し、apply=true で保存して編集画面の履歴へ同期する。ops は文字列配列または改行区切り文字列。\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"project\":{\"type\":\"string\"},\"ops\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"array\",\"items\":{\"type\":\"string\"}}]},\"apply\":{\"type\":\"boolean\"}},\"required\":[\"project\",\"ops\"],\"additionalProperties\":false}}," +
    "{\"name\":\"preview\",\"description\":\"指定時刻の 1 コマを GPU+CPU プラグイン込みで合成し、PNG 画像（マルチモーダル image コンテンツ）として返す。out を指定するとファイルにも保存する。\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"project\":{\"type\":\"string\"},\"time\":{\"type\":\"number\"},\"max_width\":{\"type\":\"integer\",\"description\":\"返す PNG の最大幅（16〜1920、既定 768）\"},\"out\":{\"type\":\"string\",\"description\":\"任意の保存先ファイル（.png または .bmp）\"}},\"required\":[\"project\",\"time\"],\"additionalProperties\":false}}," +
    "{\"name\":\"render\",\"description\":\"プロジェクトを内蔵 FFmpeg で MP4 に書き出す（Node.js / 外部 ffmpeg 不要）。\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"project\":{\"type\":\"string\"},\"out\":{\"type\":\"string\"},\"from\":{\"type\":\"number\"},\"to\":{\"type\":\"number\"}},\"required\":[\"project\",\"out\"],\"additionalProperties\":false}}" +
    "]}";
}

function mcpCallTool(name: string, argsObj: AzJson, roots: string[], reg: FxReg): string {
  if (name == "schema") {
    let section = azjStr(argsObj, "section");
    if (section == "" || section == "all") {
      return mcpToolResult(schemaJsonReg(reg), false);
    }
    const all = schemaJsonReg(reg);
    const doc = azJsonParse(mcpBytes(all));
    if (!doc.ok || doc.root.kind != AZJ_OBJ) {
      return mcpToolResult("schema の解析に失敗しました", true);
    }
    const k = azjFind(doc.root, section);
    if (k < 0) {
      return mcpToolResult(`schema に section '${section}' はありません`, true);
    }
    return mcpToolResult(`{${jsonStr(section)}:${agJsonOf(doc.root.items[k as usize])}}`, false);
  }

  if (name == "list_projects") {
    let found: string[] = [];
    for (const r of roots) {
      mcpScanProjects(r, 0, mut found);
    }
    let s = "{\"projects\":[";
    for (let i: usize = 0; i < found.length; i++) {
      if (i > 0) {
        s = s + ",";
      }
      s = s + jsonStr(found[i]);
    }
    return mcpToolResult(s + "]}", false);
  }

  if (name == "create_project") {
    const rawProj = azjStr(argsObj, "project");
    const projPath = mcpResolvePath(rawProj, roots);
    if (projPath.length == 0 || !mcpEndsWithLower(projPath, ".mzc")) {
      return mcpToolResult(`許可フォルダ内の .mzc パスを指定してください: ${rawProj}`, true);
    }
    let overwrite = false;
    const ko = azjFind(argsObj, "overwrite");
    if (ko >= 0 && argsObj.items[ko as usize].kind == AZJ_BOOL) {
      overwrite = argsObj.items[ko as usize].b;
    }
    if (!overwrite && readFile(projPath) != null) {
      return mcpToolResult(`既に存在します（上書きするには overwrite=true）: ${projPath}`, true);
    }
    let size = azjStr(argsObj, "size");
    if (size == "") {
      size = "1280x720";
    }
    const fps = Math.min(Math.max(azjNum(argsObj, "fps", 30.0), 1.0), 240.0);
    let bg = azjStr(argsObj, "bg");
    if (bg == "") {
      bg = "0b0f1a";
    }
    const bpm = Math.max(azjNum(argsObj, "bpm", 0.0), 0.0);
    let head = `project size=${size} fps=${jsonNum(fps)} bg=${bg}`;
    if (bpm > 0.0) {
      head = head + ` bpm=${jsonNum(bpm)}`;
    }
    const body = `${head}\ncolor ${bg} id=bg at=0 dur=5 track=0\n`;
    if (!writeFile(projPath, mcpBytes(body))) {
      return mcpToolResult(`プロジェクトを作成できません: ${projPath}`, true);
    }
    return mcpToolResult(`{"ok":true,"project":${jsonStr(projPath)}}`, false);
  }

  const rawProj = azjStr(argsObj, "project");
  const projPath = mcpResolvePath(rawProj, roots);
  if (projPath.length == 0) {
    return mcpToolResult(`許可されたフォルダ外のプロジェクトです: ${rawProj}`, true);
  }
  const bytes = readFile(projPath);
  if (bytes == null) {
    return mcpToolResult(`プロジェクトを読めません: ${projPath}`, true);
  }
  const cache = mcpDefaultCache(projPath);
  const probes = mcpReadProbes(projPath, cache, bytes, reg);

  if (name == "check") {
    let diags: Diag[] = [];
    const p = parseProjectReg(bytes, probes, mut diags, reg);
    return mcpToolResult(projectJsonReg(p, diags, reg), false);
  }

  if (name == "show") {
    let diags: Diag[] = [];
    const p = parseProjectReg(bytes, probes, mut diags, reg);
    const w = Math.min(Math.max(azjNum(argsObj, "width", 100.0) as i32, 40), 400);
    return mcpToolResult(showTextReg(p, w, reg), false);
  }

  if (name == "analyze_audio") {
    let diags: Diag[] = [];
    const p = parseProjectReg(bytes, probes, mut diags, reg);
    for (const d of diags) {
      if (d.severity == "error") {
        return mcpToolResult(`プロジェクトに誤りがあります: ${d.msg}`, true);
      }
    }
    const step = azjNum(argsObj, "step", 0.25);
    return mcpToolResult(aiAnalyzeAudioJson(p, cache, step), false);
  }

  if (name == "op") {
    const kOps = azjFind(argsObj, "ops");
    if (kOps < 0) {
      return mcpToolResult("ops を渡してください", true);
    }
    let opsStr: string[] = [];
    let words: string[][] = [];
    const opsKind = argsObj.items[kOps as usize].kind;
    if (opsKind == AZJ_STR) {
      for (const l of splitLines(mcpBytes(argsObj.items[kOps as usize].str))) {
        const w = splitArgs(l);
        if (w.length == 0 || (w[0].length > 0 && w[0][0] == 35)) {
          continue;
        }
        opsStr.push(l.clone());
        words.push(w);
      }
    } else if (opsKind == AZJ_ARR) {
      for (let i: usize = 0; i < argsObj.items[kOps as usize].items.length; i++) {
        if (argsObj.items[kOps as usize].items[i].kind != AZJ_STR) {
          return mcpToolResult("ops の要素は文字列にしてください", true);
        }
        for (const l of splitLines(mcpBytes(argsObj.items[kOps as usize].items[i].str))) {
          const w = splitArgs(l);
          if (w.length == 0 || (w[0].length > 0 && w[0][0] == 35)) {
            continue;
          }
          opsStr.push(l.clone());
          words.push(w);
        }
      }
    } else {
      return mcpToolResult("ops は文字列または文字列配列で渡してください", true);
    }
    if (words.length == 0) {
      return mcpToolResult("ops が空です", true);
    }
    let apply = false;
    const kApp = azjFind(argsObj, "apply");
    if (kApp >= 0 && argsObj.items[kApp as usize].kind == AZJ_BOOL) {
      apply = argsObj.items[kApp as usize].b;
    }
    const lines = splitLines(bytes);
    const res = runOpsReg(lines, probes, words, reg);
    if (!res.ok) {
      return mcpToolResult(mcpBatchJson(res, false), true);
    }
    let crlf = false;
    for (let i: usize = 0; i + 1 < bytes.length; i++) {
      if (bytes[i] == 13 && bytes[i + 1] == 10) {
        crlf = true;
        break;
      }
    }
    if (apply) {
      let outB: u8[] = [];
      for (const l of res.lines) {
        appendText(mut outB, l);
        if (crlf) {
          outB.push(13);
        }
        outB.push(10);
      }
      if (!writeFile(projPath, outB)) {
        return mcpToolResult(`ファイルを保存できません: ${projPath}`, true);
      }
      // 編集画面の AI 履歴と同期するため <project>.history に 1 行追記する
      let desc = "";
      for (const r of res.results) {
        if (r.desc.length > 0) {
          if (desc.length > 0) {
            desc = desc + "。";
          }
          desc = desc + r.desc;
        }
      }
      let opsJson = "[";
      for (let i: usize = 0; i < opsStr.length; i++) {
        if (i > 0) {
          opsJson = opsJson + ",";
        }
        opsJson = opsJson + jsonStr(opsStr[i]);
      }
      opsJson = opsJson + "]";
      const histLine = `{"who":"ai","via":"mcp","client":"mcp","tool":"op","ops":${opsJson},"desc":${jsonStr(desc)},"changes":[]}\n`;
      appendFile(projPath + ".history", mcpBytes(histLine));
    }
    return mcpToolResult(mcpBatchJson(res, apply), false);
  }

  if (name == "preview") {
    let diags: Diag[] = [];
    const p = parseProjectReg(bytes, probes, mut diags, reg);
    for (const d of diags) {
      if (d.severity == "error") {
        return mcpToolResult(`プロジェクトに誤りがあります: ${d.msg}`, true);
      }
    }
    const t = Math.max(azjNum(argsObj, "time", 0.0), 0.0);
    const mw = Math.min(Math.max(azjNum(argsObj, "max_width", 768.0) as i32, 16), 1920);
    let outRaw = azjStr(argsObj, "out");
    let outPath = "";
    if (outRaw.length > 0) {
      outPath = mcpResolvePath(outRaw, roots);
      if (outPath.length == 0) {
        return mcpToolResult(`許可されたフォルダ外の出力先です: ${outRaw}`, true);
      }
    }
    const media = loadMedia(p, cache);
    const missing = checkMedia(p, media, cache, t, t);
    if (missing.length > 0) {
      return mcpToolResult(`素材が足りません: ${missing[0]}`, true);
    }
    const font = projectFont(p.fontPath, p.fontIndex);
    let canvas = new Buffer<vec4<f32>>((p.width * p.height) as u32);
    let rc = newRenderCache();
    renderFrameReg(p, media, cache, t, mut canvas, font, mut rc, reg);
    let ow = p.width;
    let oh = p.height;
    if (ow > mw) {
      oh = Math.max((p.height * mw) / p.width, 1);
      ow = mw;
    }
    const png = aiPngBytes(canvas, p.width, p.height, ow, oh);
    if (outPath.length > 0) {
      if (mcpEndsWithLower(outPath, ".bmp")) {
        if (!writeBmp(outPath, canvas, p.width, p.height)) {
          return mcpToolResult(`プレビュー画像を書けません: ${outPath}`, true);
        }
      } else {
        if (!writeFile(outPath, png)) {
          return mcpToolResult(`プレビュー画像を書けません: ${outPath}`, true);
        }
      }
    }
    const meta = `{"ok":true,"time":${jsonNum(t)},"width":${ow},"height":${oh},"projectWidth":${p.width},"projectHeight":${p.height},"beyondEnd":${t >= p.duration},"path":${jsonStr(outPath)}}`;
    return mcpToolResultWithPng(meta, aiBase64(png));
  }

  if (name == "render") {
    if (!ffEnabled()) {
      return mcpToolResult("このエンジンには FFmpeg が組み込まれていません", true);
    }
    let diags: Diag[] = [];
    const p = parseProjectReg(bytes, probes, mut diags, reg);
    for (const d of diags) {
      if (d.severity == "error") {
        return mcpToolResult(`プロジェクトに誤りがあります: ${d.msg}`, true);
      }
    }
    const outRaw = azjStr(argsObj, "out");
    const outPath = mcpResolvePath(outRaw, roots);
    if (outPath.length == 0) {
      return mcpToolResult(`許可されたフォルダ外の出力先です: ${outRaw}`, true);
    }
    const fromSec = Math.max(azjNum(argsObj, "from", 0.0), 0.0);
    const toSec = Math.min(azjNum(argsObj, "to", p.duration), p.duration);
    if (toSec <= fromSec) {
      return mcpToolResult(`書き出し範囲が空です（${fmtTime(fromSec)}〜${fmtTime(toSec)}）`, true);
    }
    const o = encDefaults(p, outPath, fromSec, toSec);
    let j = encOpen(p, cache, o);
    if (!j.ok) {
      const err = j.err.clone();
      encFinish(mut j);
      return mcpToolResult(`書き出しを開始できません: ${err}`, true);
    }
    while (!j.done) {
      encStepReg(mut j, p, clock() + 1.0, reg);
    }
    const ok = j.ok;
    const err = j.err.clone();
    const frames = j.f1 - j.f0;
    encFinish(mut j);
    if (!ok) {
      return mcpToolResult(`書き出しに失敗しました: ${err}`, true);
    }
    return mcpToolResult(`{"ok":true,"out":${jsonStr(outPath)},"frames":${frames}}`, false);
  }

  return mcpToolResult(`知らないツールです: ${name}`, true);
}

export function cmdMcp(argv: string[], reg: FxReg): i32 {
  let roots: string[] = [];
  for (let i: usize = 1; i < argv.length; i++) {
    if (argv[i] == "--root" && i + 1 < argv.length) {
      roots.push(argv[i + 1].clone());
      i++;
    } else if (mcpStartsWith(argv[i], "--root=")) {
      roots.push(sub(argv[i], 7, argv[i].length));
    }
  }
  if (roots.length == 0) {
    roots.push(".");
  }
  eprint(`mozcut-mcp: ネイティブ MCP サーバーを起動しました（v${MOZCUT_VERSION}・効果 ${reg.count()} 個・トランジション ${reg.wasm.trans.length} 個）`);
  while (true) {
    const line = readLine();
    if (line == null) {
      break;
    }
    const trimmed = line.clone();
    if (trimmed.length == 0) {
      continue;
    }
    const doc = azJsonParse(mcpBytes(trimmed));
    if (!doc.ok || doc.root.kind != AZJ_OBJ) {
      mcpRespErr("null", -32700, `JSON の解析に失敗しました: ${doc.error}`);
      continue;
    }
    const method = azjStr(doc.root, "method");
    const hasId = azjFind(doc.root, "id") >= 0;
    const idJson = mcpIdJson(doc.root);
    if (!hasId) {
      // 通知（notifications/initialized 等）は応答しない
      continue;
    }
    if (method == "initialize") {
      let proto = "2025-03-26";
      const kp = azjFind(doc.root, "params");
      if (kp >= 0 && doc.root.items[kp as usize].kind == AZJ_OBJ) {
        const pv = azjStr(doc.root.items[kp as usize], "protocolVersion");
        if (pv == "2025-06-18" || pv == "2025-03-26" || pv == "2024-11-05") {
          proto = pv;
        }
      }
      mcpRespOk(idJson, `{"protocolVersion":${jsonStr(proto)},"capabilities":{"tools":{}},"serverInfo":{"name":"mozaiccut","version":${jsonStr(MOZCUT_VERSION)}},"instructions":${jsonStr(mcpInstructions())}}`);
    } else if (method == "ping") {
      mcpRespOk(idJson, "{}");
    } else if (method == "tools/list") {
      mcpRespOk(idJson, mcpToolsListJson());
    } else if (method == "prompts/list") {
      mcpRespOk(idJson, "{\"prompts\":[]}");
    } else if (method == "resources/list") {
      mcpRespOk(idJson, "{\"resources\":[]}");
    } else if (method == "tools/call") {
      const kp = azjFind(doc.root, "params");
      if (kp < 0 || doc.root.items[kp as usize].kind != AZJ_OBJ) {
        mcpRespErr(idJson, -32602, "params がオブジェクトではありません");
        continue;
      }
      const tname = azjStr(doc.root.items[kp as usize], "name");
      const ka = azjFind(doc.root.items[kp as usize], "arguments");
      if (ka >= 0 && doc.root.items[kp as usize].items[ka as usize].kind == AZJ_OBJ) {
        mcpRespOk(idJson, mcpCallTool(tname, doc.root.items[kp as usize].items[ka as usize], roots, reg));
      } else {
        let empty: AzJson = { kind: AZJ_OBJ, b: false, num: 0.0, str: "", keys: [], items: [] };
        mcpRespOk(idJson, mcpCallTool(tname, empty, roots, reg));
      }
    } else {
      mcpRespErr(idJson, -32601, `未対応のメソッドです: ${method}`);
    }
  }
  return 0;
}
