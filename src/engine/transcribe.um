// 文字起こし: クリップの素材の音を whisper.cpp（whisper-cli）で書き起こし、字幕（add text の操作と .srt）にする。
// コマンド（main.um の transcribe）、編集画面（editor/e2c_tr.um）、AI（ai_tools.um・mcp.um の transcribe）が共有する。
//
// 流れ: 素材の in〜out の音を FFmpeg の組み込みで 16 kHz・1 チャンネルの WAV に書く → whisper-cli -ojf で
// トークンごとの時刻つきの JSON を作る → src/effects/analyze/transcript.um で読み、字幕に区切る →
// suggest.um の azProposeSubtitles で add text の操作にする（ID は sub_<n>、トラックは空いている上のトラック）。
//
// whisper-cli は外のプロセスとして待つ（processRun）。結果を標準出力にも書くので、MCP（標準出力が JSON-RPC）を
// 壊さないよう、Windows は cmd.exe とバッチのファイル、ほかは /bin/sh で標準出力とエラー出力を捨てて起動する。
import { Project, Clip, KIND_VIDEO, KIND_AUDIO, findClip } from "./project.um";
import { ffEnabled, ffOpenAudio, ffReadAudio, ffClose } from "./ffmpeg.um";
import { mediaSourcePath } from "./media.um";
import { appendText } from "./text.um";
import { jsonStr, jsonNum } from "./report.um";
import { AzWord, AzCue, AzCueOpts, azCueDefaults, azReadTranscript, azMakeCues, azSrt, azOneLine } from "../effects/analyze/transcript.um";
import { AzProposal, azSuggestDefaults, azProposeSubtitles } from "../effects/analyze/suggest.um";

export const TR_RATE: i32 = 16000;

export struct TrOpts {
  // 言葉（"ja"、"en"、"auto" は whisper に任せる）
  lang: string;
  // whisper-cli と ggml のモデルの場所（"" なら trFindWhisper / trFindModel で探す）
  whisper: string;
  model: string;
  // 字幕のトラック（-1 なら空いている上のトラック）と置き方
  subTrack: i32;
  subStyle: string;
  // 1 行の幅（半角を 1、全角を 2）と行の数
  maxWidth: i32;
  maxLines: i32;
  // whisper のスレッドの数（0 なら whisper の既定）
  threads: i32;
}

export function trDefaults(): TrOpts {
  const so = azSuggestDefaults();
  return { lang: "auto", whisper: "", model: "", subTrack: -1, subStyle: so.subStyle.clone(), maxWidth: 32, maxLines: 2, threads: 0 };
}

export struct TrResult {
  ok: bool;
  error: string;
  clip: string;
  whisper: string;
  model: string;
  language: string;
  // 字幕を足す操作（op にそのまま渡せる 1 行 1 つの文字列）
  ops: string[];
  // タイムラインの秒の字幕
  cues: AzCue[];
  // 書き起こしの全文（字幕を空白でつないだもの）
  text: string;
  warnings: string[];
  // 書き起こした素材の長さ（秒）
  seconds: f64;
}

function trFail(clip: string, msg: string): TrResult {
  return {
    ok: false, error: msg.clone(), clip: clip.clone(), whisper: "", model: "", language: "", ops: [], cues: [], text: "",
    warnings: [], seconds: 0,
  };
}

function trIsWindows(): bool {
  const p = exePath();
  if (p.length >= 2 && p[1] == 58) {
    return true;
  }
  for (const b of p) {
    if (b == 92) {
      return true;
    }
  }
  return false;
}

function trHome(): string {
  const u = envVar("USERPROFILE");
  if (u != "") {
    return u;
  }
  return envVar("HOME");
}

function trExists(path: string): bool {
  if (path == "") {
    return false;
  }
  const n = fileSize(path);
  return n != null;
}

// whisper-cli の場所。MOZCUT_WHISPER → 実行ファイルの隣の whisper/ → ホームの whisper.cpp/ → PATH の whisper-cli。
export function trFindWhisper(over: string): string {
  if (over != "") {
    return over.clone();
  }
  const env = envVar("MOZCUT_WHISPER");
  if (env != "") {
    return env;
  }
  let exe = "whisper-cli";
  if (trIsWindows()) {
    exe = "whisper-cli.exe";
  }
  let cands: string[] = [];
  const d = exeDir();
  if (d != "") {
    cands.push(`${d}/whisper/${exe}`);
    cands.push(`${d}/whisper/Release/${exe}`);
  }
  const h = trHome();
  if (h != "") {
    cands.push(`${h}/whisper.cpp/bin/Release/${exe}`);
    cands.push(`${h}/whisper.cpp/bin/${exe}`);
    cands.push(`${h}/whisper.cpp/build/bin/Release/${exe}`);
    cands.push(`${h}/whisper.cpp/build/bin/${exe}`);
  }
  for (const c of cands) {
    if (trExists(c)) {
      return c.clone();
    }
  }
  // 見つからなければ PATH から探してもらう（processRun は区切りのない名前を PATH から探す）
  return "whisper-cli";
}

// ggml のモデルの場所。MOZCUT_WHISPER_MODEL → whisper/models/ → ホームの whisper.cpp/models/ の、大きい順の名前。
export function trFindModel(over: string): string {
  if (over != "") {
    return over.clone();
  }
  const env = envVar("MOZCUT_WHISPER_MODEL");
  if (env != "") {
    return env;
  }
  let dirs: string[] = [];
  const d = exeDir();
  if (d != "") {
    dirs.push(`${d}/whisper/models`);
  }
  const h = trHome();
  if (h != "") {
    dirs.push(`${h}/whisper.cpp/models`);
  }
  const names: string[] = [
    "ggml-large-v3-turbo.bin", "ggml-large-v3-turbo-q5_0.bin", "ggml-large-v3.bin", "ggml-medium.bin", "ggml-small.bin",
    "ggml-base.bin", "ggml-tiny.bin",
  ];
  for (const dir of dirs) {
    for (const n of names) {
      const c = `${dir}/${n}`;
      if (trExists(c)) {
        return c;
      }
    }
  }
  return "";
}

// ---- 音を WAV に書く ----

function trPutU32(out: mut u8[], v: u32): void {
  out.push((v & 255) as u8);
  out.push(((v >> 8) & 255) as u8);
  out.push(((v >> 16) & 255) as u8);
  out.push(((v >> 24) & 255) as u8);
}

function trPutU16(out: mut u8[], v: u32): void {
  out.push((v & 255) as u8);
  out.push(((v >> 8) & 255) as u8);
}

// path の from 秒から len 秒の音を、16 kHz・1 チャンネル・s16 の WAV にする。失敗なら理由、成功なら ""。
function trWriteWav(src: string, from: f64, len: f64, wav: string): string {
  const o = ffOpenAudio(src);
  if (!o.ok) {
    return `'${src}' の音を開けません（${o.err}）`;
  }
  const want = Math.floor(len * (TR_RATE as f64)) as i64;
  let pcm: u8[] = [];
  let buf = new Buffer<f32>(16384);
  let got: i64 = 0;
  let t = from;
  while (got < want) {
    const n = ffReadAudio(o.handle, t, mut buf, TR_RATE);
    if (n <= 0) {
      break;
    }
    t = -1;
    const take = Math.min(n, want - got);
    for (let i: i64 = 0; i < take; i++) {
      let v = (buf[(i * 2) as u32] + buf[(i * 2 + 1) as u32]) * 0.5;
      v = Math.max(-1.0, Math.min(1.0, v));
      const s = Math.floor(v * 32767.0 + 0.5) as i32;
      const u = (s & 65535) as u32;
      pcm.push((u & 255) as u8);
      pcm.push(((u >> 8) & 255) as u8);
    }
    got += take;
  }
  ffClose(o.handle);
  if (got <= 0) {
    return `'${src}' に音がありません`;
  }
  let out: u8[] = [];
  appendText(mut out, "RIFF");
  trPutU32(mut out, (36 + pcm.length) as u32);
  appendText(mut out, "WAVEfmt ");
  trPutU32(mut out, 16);
  trPutU16(mut out, 1);
  trPutU16(mut out, 1);
  trPutU32(mut out, TR_RATE as u32);
  trPutU32(mut out, (TR_RATE * 2) as u32);
  trPutU16(mut out, 2);
  trPutU16(mut out, 16);
  appendText(mut out, "data");
  trPutU32(mut out, pcm.length as u32);
  for (const b of pcm) {
    out.push(b);
  }
  if (!writeFile(wav, out)) {
    return `'${wav}' に書けません`;
  }
  return "";
}

// ---- whisper-cli を動かす ----

function trBatQuote(s: string): string {
  let out: u8[] = [];
  out.push(34);
  for (const b of s) {
    if (b == 37) {
      out.push(37);
    }
    out.push(b);
  }
  out.push(34);
  return stringFromBytes(out);
}

function trBackslash(s: string): string {
  let out: u8[] = [];
  for (const b of s) {
    if (b == 47) {
      out.push(92);
    } else {
      out.push(b);
    }
  }
  return stringFromBytes(out);
}

// sh の '...'（' は '\'' にする）。
function trShQuote(s: string): string {
  let out: u8[] = [];
  out.push(39);
  for (const b of s) {
    if (b == 39) {
      appendText(mut out, "'\\''");
    } else {
      out.push(b);
    }
  }
  out.push(39);
  return stringFromBytes(out);
}

function trWorkDir(): string {
  let t = envVar("TEMP");
  if (t == "") {
    t = envVar("TMPDIR");
  }
  if (t == "") {
    t = "/tmp";
  }
  // 編集画面とコマンドが同時に動いても重ならないよう、プロセスの番号と時計で分ける
  const d = `${t}/mozcut-tr-${processId()}-${Math.floor(clock() * 1000.0) as i64}`;
  makeDir(d);
  return d;
}

// ---- 書き起こしの仕事 ----

// 書き起こしの仕事（trPrepare で作り、trRunSync か trStart / trPoll で動かし、trFinish で字幕にする）。
export struct TrJob {
  ok: bool;
  error: string;
  ref: string;
  whisper: string;
  model: string;
  // 作業のフォルダ（WAV・スクリプト・進み・終わりの印・結果の JSON）
  work: string;
  script: string;
  // 書き起こした素材の長さ（秒）
  seconds: f64;
  speed: f64;
  started: bool;
  startedAt: f64;
}

// 何もしていない仕事（編集画面の初めの値）。
export function trJobNone(): TrJob {
  return trJobFail("", "");
}

function trJobFail(ref: string, msg: string): TrJob {
  return {
    ok: false, error: msg.clone(), ref: ref.clone(), whisper: "", model: "", work: "", script: "", seconds: 0, speed: 1,
    started: false, startedAt: 0,
  };
}

// 動かすスクリプトを書く。whisper の標準出力は捨て、エラー出力（進み）は progress.txt に、終了コードは done.txt に書く。
function trWriteScript(work: string, exe: string, a: string[]): string {
  if (trIsWindows()) {
    const w = trBackslash(work);
    let bat: u8[] = [];
    appendText(mut bat, "@echo off\r\nchcp 65001 >NUL\r\n");
    appendText(mut bat, trBatQuote(trBackslash(exe)));
    for (const x of a) {
      appendText(mut bat, " ");
      appendText(mut bat, trBatQuote(x));
    }
    appendText(mut bat, ` >NUL 2>${trBatQuote(w + "\\progress.txt")}\r\n`);
    appendText(mut bat, "set MZC_CODE=%ERRORLEVEL%\r\n");
    appendText(mut bat, `>${trBatQuote(w + "\\done.tmp")} echo %MZC_CODE%\r\n`);
    appendText(mut bat, `move /y ${trBatQuote(w + "\\done.tmp")} ${trBatQuote(w + "\\done.txt")} >NUL\r\n`);
    appendText(mut bat, "exit /b %MZC_CODE%\r\n");
    const path = `${w}\\run.bat`;
    if (!writeFile(path, bat)) {
      return "";
    }
    return path;
  }
  let sh: u8[] = [];
  appendText(mut sh, trShQuote(exe));
  for (const x of a) {
    appendText(mut sh, " ");
    appendText(mut sh, trShQuote(x));
  }
  appendText(mut sh, ` >/dev/null 2>${trShQuote(work + "/progress.txt")}\n`);
  appendText(mut sh, "c=$?\n");
  appendText(mut sh, `echo $c > ${trShQuote(work + "/done.tmp")} && mv ${trShQuote(work + "/done.tmp")} ${trShQuote(work + "/done.txt")}\n`);
  appendText(mut sh, "exit $c\n");
  const path = `${work}/run.sh`;
  if (!writeFile(path, sh)) {
    return "";
  }
  return path;
}

// 素材の音を WAV にして、whisper を動かす用意をする。projPath は素材の相対パスを解くための .mzc の場所。
export function trPrepare(p: Project, projPath: string, ref: string, o: TrOpts): TrJob {
  const ci = findClip(p, ref);
  if (ci < 0) {
    return trJobFail(ref, `クリップ '${ref}' がありません`);
  }
  return trPrepareOf(projPath, ref, p.clips[ci as usize], o);
}

function trPrepareOf(projPath: string, ref: string, c: Clip, o: TrOpts): TrJob {
  if ((c.kind != KIND_VIDEO && c.kind != KIND_AUDIO) || c.src == "") {
    return trJobFail(ref, `'${ref}' は動画か音のクリップではありません（文字起こしは素材の音から行います）`);
  }
  if (!ffEnabled()) {
    return trJobFail(ref, "このビルドは FFmpeg なしなので、素材の音を読めません");
  }
  const whisper = trFindWhisper(o.whisper);
  const model = trFindModel(o.model);
  if (model == "" || !trExists(model)) {
    return trJobFail(ref,
      "whisper.cpp のモデル（ggml-base.bin など）が見つかりません。ホームの whisper.cpp/models/ に置くか、環境変数 MOZCUT_WHISPER_MODEL で指定します");
  }
  let speed = c.speed;
  if (!(speed > 0)) {
    speed = 1.0;
  }
  const len = c.dur * speed;
  if (!(len > 0.05)) {
    return trJobFail(ref, `'${ref}' の長さが 0 です`);
  }
  const work = trWorkDir();
  const wav = `${work}/audio.wav`;
  const src = mediaSourcePath(projPath, c.src);
  const werr = trWriteWav(src, c.inPt, len, wav);
  if (werr != "") {
    trCleanup(work);
    return trJobFail(ref, werr);
  }
  let a: string[] = ["-m", model.clone(), "-f", wav.clone(), "-ojf", "-of", `${work}/out`, "-np", "-pp"];
  let lang = o.lang.clone();
  if (lang == "") {
    lang = "auto";
  }
  a.push("-l");
  a.push(lang.clone());
  if (o.threads > 0) {
    a.push("-t");
    a.push(`${o.threads}`);
  }
  const script = trWriteScript(work, whisper, a);
  if (script == "") {
    trCleanup(work);
    return trJobFail(ref, `'${work}' に書けません`);
  }
  return {
    ok: true, error: "", ref: ref.clone(), whisper: whisper.clone(), model: model.clone(), work: work.clone(), script: script.clone(),
    seconds: len, speed: speed, started: false, startedAt: 0,
  };
}

function trCleanup(work: string): void {
  if (work == "") {
    return;
  }
  const names: string[] = ["audio.wav", "out.json", "run.bat", "run.sh", "progress.txt", "done.tmp", "done.txt"];
  for (const n of names) {
    fileRemove(`${work}/${n}`);
  }
  dirRemove(work);
}

function trSysCmd(): string {
  let root = envVar("SystemRoot");
  if (root == "") {
    root = "C:\\Windows";
  }
  return `${root}\\System32\\cmd.exe`;
}

// 待って動かす（コマンド・MCP・AI のツール）。
export function trRunSync(job: mut TrJob): void {
  if (!job.ok) {
    return;
  }
  job.started = true;
  job.startedAt = clock();
  if (trIsWindows()) {
    const ca: string[] = ["/d", "/c", job.script.clone()];
    processRun(trSysCmd(), ca);
  } else {
    const sa: string[] = [job.script.clone()];
    processRun("/bin/sh", sa);
  }
}

// 待たずに始める（編集画面）。終わったかは trPoll で見る。
export function trStart(job: mut TrJob): bool {
  if (!job.ok) {
    return false;
  }
  job.started = true;
  job.startedAt = clock();
  if (trIsWindows()) {
    const ca: string[] = ["/d", "/c", job.script.clone()];
    return processStart(trSysCmd(), ca);
  }
  const sa: string[] = [job.script.clone()];
  return processStart("/bin/sh", sa);
}

// 終わったら true（done.txt ができた）。
export function trPoll(job: TrJob): bool {
  return job.started && trExists(`${job.work}/done.txt`);
}

// whisper の進み（0..1。分からなければ -1）。エラー出力の最後の「progress = N%」。
export function trProgress(job: TrJob): f64 {
  const b = readFile(`${job.work}/progress.txt`);
  if (b == null) {
    return -1;
  }
  const key = "progress = ";
  let best: f64 = -1;
  let i: usize = 0;
  while (i + key.length < b.length) {
    let hit = true;
    for (let k: usize = 0; k < key.length; k++) {
      if (b[i + k] != key[k]) {
        hit = false;
        break;
      }
    }
    if (hit) {
      let j = i + key.length;
      let v: f64 = 0;
      let any = false;
      while (j < b.length && b[j] >= 48 && b[j] <= 57) {
        v = v * 10.0 + ((b[j] - 48) as f64);
        any = true;
        j++;
      }
      if (any) {
        best = Math.min(v, 100.0) / 100.0;
      }
      i = j;
    } else {
      i++;
    }
  }
  return best;
}

function trDoneCode(work: string): i32 {
  const b = readFile(`${work}/done.txt`);
  if (b == null) {
    return -1;
  }
  let v: i32 = 0;
  let any = false;
  let neg = false;
  for (const x of b) {
    if (x == 45 && !any) {
      neg = true;
    } else if (x >= 48 && x <= 57) {
      v = v * 10 + ((x - 48) as i32);
      any = true;
    } else if (any) {
      break;
    }
  }
  if (!any) {
    return -1;
  }
  if (neg) {
    return -v;
  }
  return v;
}

// 作業のフォルダを消す（編集画面を閉じるときなど、結果を使わないとき）。
export function trDiscard(job: TrJob): void {
  trCleanup(job.work);
}

// 書き起こしを読んで字幕にし、作業のフォルダを消す。p はいまのプロジェクト（ID を避け、クリップの位置を読む）。
export function trFinish(p: Project, job: TrJob, o: TrOpts): TrResult {
  if (!job.ok) {
    return trFail(job.ref, job.error);
  }
  const code = trDoneCode(job.work);
  const json = `${job.work}/out.json`;
  if (code != 0 || !trExists(json)) {
    trCleanup(job.work);
    if (code == 9009 || code == 127 || code == -1) {
      return trFail(job.ref, `whisper-cli（${job.whisper}）を始められません。whisper.cpp を置くか、環境変数 MOZCUT_WHISPER で場所を指定します`);
    }
    return trFail(job.ref, `whisper-cli（${job.whisper}）が失敗しました（終了コード ${code}）`);
  }
  const t = azReadTranscript(json);
  trCleanup(job.work);
  if (!t.ok) {
    return trFail(job.ref, `書き起こしを読めません（${t.error}）`);
  }
  const ci = findClip(p, job.ref);
  if (ci < 0) {
    return trFail(job.ref, `書き起こしの間にクリップ '${job.ref}' がなくなりました`);
  }
  return trResultOf(p, p.clips[ci as usize], job, t.words, t.language, t.warnings, o);
}

// 用意して、待って動かして、字幕にする。
export function trClip(p: Project, projPath: string, ref: string, o: TrOpts): TrResult {
  let job = trPrepare(p, projPath, ref, o);
  if (!job.ok) {
    return trFail(ref, job.error);
  }
  trRunSync(mut job);
  return trFinish(p, job, o);
}

function trResultOf(p: Project, c: Clip, job: TrJob, src: AzWord[], language: string, tw: string[], o: TrOpts): TrResult {
  const speed = job.speed;
  // ファイルの秒 x を「素材の秒」in + x / speed にする（azToTimeline は at + (素材の秒 - in) なので、タイムラインの秒は at + x / speed）
  let words: AzWord[] = [];
  for (const w of src) {
    words.push({ text: w.text.clone(), start: c.inPt + w.start / speed, end: c.inPt + w.end / speed, p: w.p, space: w.space });
  }
  let co = azCueDefaults();
  co.maxWidth = o.maxWidth;
  co.maxLines = o.maxLines;
  let so = azSuggestDefaults();
  so.subTrack = o.subTrack;
  so.subStyle = o.subStyle.clone();
  let ps: AzProposal[] = [];
  azProposeSubtitles(mut ps, p, c, words, 0.0, co, so);
  let ops: string[] = [];
  let cues: AzCue[] = [];
  let all: u8[] = [];
  for (const q of ps) {
    ops.push(q.op.clone());
  }
  const off = c.at - c.inPt;
  for (const q of azMakeCues(words, co)) {
    const s = Math.max(q.start + off, c.at);
    const e = Math.min(q.end + off, c.at + c.dur);
    if (e - s < 0.05) {
      continue;
    }
    cues.push({ start: s, end: e, text: q.text.clone() });
    if (all.length > 0) {
      all.push(32);
    }
    for (const b of q.text) {
      if (b == 10) {
        all.push(32);
      } else {
        all.push(b);
      }
    }
  }
  let warns: string[] = [];
  for (const w of tw) {
    warns.push(w.clone());
  }
  if (cues.length == 0) {
    warns.push("言葉が見つかりませんでした");
  }
  return {
    ok: true, error: "", clip: job.ref.clone(), whisper: job.whisper.clone(), model: job.model.clone(), language: language.clone(), ops: ops,
    cues: cues, text: stringFromBytes(all), warnings: warns, seconds: job.seconds,
  };
}

// 字幕の文字を 1 行にする（一覧に出すとき）。
export function trOneLine(s: string): string {
  return azOneLine(s);
}

// タイムラインの秒の字幕の SRT。
export function trSrt(r: TrResult): string {
  return azSrt(r.cues, 0.0);
}

export function trJson(r: TrResult): string {
  let out: u8[] = [];
  if (!r.ok) {
    appendText(mut out, `{"ok":false,"clip":${jsonStr(r.clip)},"error":${jsonStr(r.error)}}`);
    return stringFromBytes(out);
  }
  appendText(mut out, `{"ok":true,"clip":${jsonStr(r.clip)},"language":${jsonStr(r.language)},"seconds":${jsonNum(r.seconds)},"model":${jsonStr(r.model)},"text":${jsonStr(r.text)},"cues":[`);
  for (let i: usize = 0; i < r.cues.length; i++) {
    if (i > 0) {
      out.push(44);
    }
    appendText(mut out, `{"start":${jsonNum(r.cues[i].start)},"end":${jsonNum(r.cues[i].end)},"text":${jsonStr(r.cues[i].text)}}`);
  }
  appendText(mut out, "],\"ops\":[");
  for (let i: usize = 0; i < r.ops.length; i++) {
    if (i > 0) {
      out.push(44);
    }
    appendText(mut out, jsonStr(r.ops[i]));
  }
  appendText(mut out, "],\"warnings\":[");
  for (let i: usize = 0; i < r.warnings.length; i++) {
    if (i > 0) {
      out.push(44);
    }
    appendText(mut out, jsonStr(r.warnings[i]));
  }
  appendText(mut out, "]}");
  return stringFromBytes(out);
}
