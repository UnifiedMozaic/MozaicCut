// ---- kernel ----
//
// 書き込み先のキャンバスに重ねる kernel（composite / fillRect / yuvComposite / rgbaComposite、textlayer.um の tlDraw）は、
// kernel が自分の [i] にしか書けないので、キャンバスの添字で dispatch して層の外はすぐ戻る。ただし dispatch の個数は
// 「層の下の端の行まで」（rowsCount）にして、それより下の行は実行しない。層の範囲が空なら dispatch しない。

kernel function clamp01(v: f32): f32 {
  return Math.min(Math.max(v, 0.0), 1.0);
}

kernel function clearCanvas(i: u32, canvas: mut Buffer<vec4<f32>>, color: vec4<f32>): void {
  canvas[i] = color;
}

// 2D モーションブラー: 1 標本（ストレートアルファの src）をプリマルチプライで acc へ加算する。
kernel function mblurAcc(i: u32, acc: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  const s = src[i];
  const a = Math.min(Math.max(s.w, 0.0), 1.0);
  const prev = acc[i];
  acc[i] = vec4(prev.x + s.x * a, prev.y + s.y * a, prev.z + s.z * a, prev.w + a);
}

// 2D モーションブラー: ns 標本の平均を canvas へ合成する（プリマルチプライの source-over）。
kernel function mblurResolve(i: u32, canvas: mut Buffer<vec4<f32>>, acc: Buffer<vec4<f32>>, invN: f32): void {
  const p = acc[i] * invN;
  const a = Math.min(Math.max(p.w, 0.0), 1.0);
  if (a <= 0.0001) {
    return;
  }
  const d = canvas[i];
  const inv = 1.0 - a;
  canvas[i] = vec4(p.x + d.x * inv, p.y + d.y * inv, p.z + d.z * inv, Math.min(a + d.w * inv, 1.0));
}

// YUV 4:2:0 の 1 コマの i 番目の画素を RGBA にする。rgb は 0..1 に収める。
// 色の行列と範囲は係数で受け取る（media.um の mediaYuvK1 / mediaYuvK2。展開したキャッシュは BT.709 の限られた範囲で、
// k1 = (1.5748, 0.18732, 0.46812, 1.8556)、k2 = (16, 219, 128, 224)。FFmpeg で読んだ素材は素材の行列と範囲のまま）。
// g の 2 つ目の引き算の前の Math.max（値は変えない）は、GPU のシェーダのコンパイラが (a - b) - c を a - (b + c) に
// まとめて丸めが変わる（CPU と 1 ULP ずれる）のを防ぐため。2026-11、wgpu-native v29 の Vulkan と Direct3D 12 の両方で起きた。
kernel function yuvPixel(yuv: Buffer<u8>, i: u32, w: u32, h: u32, k1: vec4<f32>, k2: vec4<f32>): vec4<f32> {
  const x = i % w;
  const y = i / w;
  const cw = w / 2;
  const ci = (y / 2) * cw + x / 2;
  const plane = w * h;
  const yv = (yuv[i] as i32) as f32;
  const uv = (yuv[plane + ci] as i32) as f32;
  const vv = (yuv[plane + plane / 4 + ci] as i32) as f32;
  return yuvRgb(yv, uv, vv, k1, k2);
}

// yuvPixel と同じだが、コマを 4 バイトずつ u32 に詰めたまま受け取る（先読みの枠の並び。バイト j は words[j / 4] の
// (j % 4) * 8 ビット目から）。編集画面の再生で、枠をバイトにほどく手間を CPU から描画の kernel（GPU）に移すため。
kernel function yuvWordPixel(words: Buffer<u32>, i: u32, w: u32, h: u32, k1: vec4<f32>, k2: vec4<f32>): vec4<f32> {
  const x = i % w;
  const y = i / w;
  const cw = w / 2;
  const ci = (y / 2) * cw + x / 2;
  const plane = w * h;
  const yv = (wordByte(words, i) as i32) as f32;
  const uv = (wordByte(words, plane + ci) as i32) as f32;
  const vv = (wordByte(words, plane + plane / 4 + ci) as i32) as f32;
  return yuvRgb(yv, uv, vv, k1, k2);
}

kernel function wordByte(words: Buffer<u32>, j: u32): u32 {
  return (words[j / 4] >> ((j % 4) * 8)) & 255;
}

// Y・Cb・Cr の値（0〜255）を RGBA にする（yuvPixel / yuvWordPixel の共通の式）。
kernel function yuvRgb(yv: f32, uv: f32, vv: f32, k1: vec4<f32>, k2: vec4<f32>): vec4<f32> {
  const yy = (yv - k2.x) / k2.y;
  const cb = (uv - k2.z) / k2.w;
  const cr = (vv - k2.z) / k2.w;
  const r = yy + k1.x * cr;
  const g = Math.max(yy - k1.y * cb, -1.0e30) - k1.z * cr;
  const b = yy + k1.w * cb;
  return vec4(clamp01(r), clamp01(g), clamp01(b), 1.0);
}

// RGBA の 8 ビットの画素（PAM の本体）の i 番目を 0..1 の RGBA にする（ストレートアルファ）。
kernel function rgbaPixel(px: Buffer<u8>, i: u32): vec4<f32> {
  const k = i * 4;
  const r = ((px[k] as i32) as f32) / 255.0;
  const g = ((px[k + 1] as i32) as f32) / 255.0;
  const b = ((px[k + 2] as i32) as f32) / 255.0;
  const a = ((px[k + 3] as i32) as f32) / 255.0;
  return vec4(r, g, b, a);
}

// YUV の 1 コマを RGBA の層にする（効果を掛けるとき用）。
kernel function yuvToLayer(i: u32, layer: mut Buffer<vec4<f32>>, yuv: Buffer<u8>, w: u32, h: u32, k1: vec4<f32>, k2: vec4<f32>): void {
  layer[i] = yuvPixel(yuv, i, w, h, k1, k2);
}

// yuvToLayer の、u32 に詰めたままのコマの版（yuvWordPixel）。
kernel function yuvWordsToLayer(i: u32, layer: mut Buffer<vec4<f32>>, words: Buffer<u32>, w: u32, h: u32, k1: vec4<f32>, k2: vec4<f32>): void {
  layer[i] = yuvWordPixel(words, i, w, h, k1, k2);
}

// RGBA の 8 ビットの画素を層にする（効果を掛けるとき用）。
kernel function rgbaToLayer(i: u32, layer: mut Buffer<vec4<f32>>, px: Buffer<u8>): void {
  layer[i] = rgbaPixel(px, i);
}

kernel function blendOver(d: vec4<f32>, s: vec4<f32>, a: f32): vec4<f32> {
  return vec4(d.x + (s.x - d.x) * a, d.y + (s.y - d.y) * a, d.z + (s.z - d.z) * a, 1.0);
}

// 層を (lx, ly) に置いて重ねる。
kernel function composite(
  i: u32, canvas: mut Buffer<vec4<f32>>, layer: Buffer<vec4<f32>>,
  cw: u32, lx: i32, ly: i32, lw: i32, lh: i32, alpha: f32,
): void {
  const dx = ((i % cw) as i32) - lx;
  const dy = ((i / cw) as i32) - ly;
  if (dx < 0 || dy < 0 || dx >= lw || dy >= lh) {
    return;
  }
  const s = layer[(dy * lw + dx) as u32];
  canvas[i] = blendOver(canvas[i], s, s.w * alpha);
}

// 効果のない映像: YUV のコマを層に広げずに、その場で RGBA にして (lx, ly) に重ねる（yuvToLayer + composite と同じ値）。
kernel function yuvComposite(
  i: u32, canvas: mut Buffer<vec4<f32>>, yuv: Buffer<u8>,
  cw: u32, lx: i32, ly: i32, lw: i32, lh: i32, alpha: f32, k1: vec4<f32>, k2: vec4<f32>,
): void {
  const dx = ((i % cw) as i32) - lx;
  const dy = ((i / cw) as i32) - ly;
  if (dx < 0 || dy < 0 || dx >= lw || dy >= lh) {
    return;
  }
  const s = yuvPixel(yuv, (dy * lw + dx) as u32, lw as u32, lh as u32, k1, k2);
  canvas[i] = blendOver(canvas[i], s, s.w * alpha);
}

// yuvComposite の、u32 に詰めたままのコマの版（yuvWordPixel）。
kernel function yuvWordsComposite(
  i: u32, canvas: mut Buffer<vec4<f32>>, words: Buffer<u32>,
  cw: u32, lx: i32, ly: i32, lw: i32, lh: i32, alpha: f32, k1: vec4<f32>, k2: vec4<f32>,
): void {
  const dx = ((i % cw) as i32) - lx;
  const dy = ((i / cw) as i32) - ly;
  if (dx < 0 || dy < 0 || dx >= lw || dy >= lh) {
    return;
  }
  const s = yuvWordPixel(words, (dy * lw + dx) as u32, lw as u32, lh as u32, k1, k2);
  canvas[i] = blendOver(canvas[i], s, s.w * alpha);
}

// 効果のない画像: RGBA の画素を層に広げずに (lx, ly) に重ねる（rgbaToLayer + composite と同じ値）。
kernel function rgbaComposite(
  i: u32, canvas: mut Buffer<vec4<f32>>, px: Buffer<u8>,
  cw: u32, lx: i32, ly: i32, lw: i32, lh: i32, alpha: f32,
): void {
  const dx = ((i % cw) as i32) - lx;
  const dy = ((i / cw) as i32) - ly;
  if (dx < 0 || dy < 0 || dx >= lw || dy >= lh) {
    return;
  }
  const s = rgbaPixel(px, (dy * lw + dx) as u32);
  canvas[i] = blendOver(canvas[i], s, s.w * alpha);
}

kernel function fillRect(
  i: u32, canvas: mut Buffer<vec4<f32>>, cw: u32, x0: i32, y0: i32, x1: i32, y1: i32, color: vec4<f32>, alpha: f32,
): void {
  const x = (i % cw) as i32;
  const y = (i / cw) as i32;
  if (x < x0 || y < y0 || x >= x1 || y >= y1) {
    return;
  }
  canvas[i] = blendOver(canvas[i], color, color.w * alpha);
}

kernel function toByte(v: f32): u8 {
  return (Math.min(Math.max(v + 0.5, 0.0), 255.0) as i32) as u8;
}

// キャンバスを YUV 4:2:0（BT.709、リミテッドレンジ）にする。色差は 2x2 の平均。
kernel function toYuv(i: u32, out: mut Buffer<u8>, canvas: Buffer<vec4<f32>>, w: u32, h: u32): void {
  const n = w * h;
  if (i < n) {
    const c = canvas[i];
    const l = 0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z;
    out[i] = toByte(16.0 + 219.0 * l);
    return;
  }
  const cw = w / 2;
  const q = cw * (h / 2);
  let j = i - n;
  let isV = false;
  if (j >= q) {
    j = j - q;
    isV = true;
  }
  const x = (j % cw) * 2;
  const y = (j / cw) * 2;
  const k = y * w + x;
  const c = (canvas[k] + canvas[k + 1] + canvas[k + w] + canvas[k + w + 1]) * 0.25;
  const l = 0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z;
  if (isV) {
    out[i] = toByte(128.0 + 224.0 * (c.x - l) / 1.5748);
  } else {
    out[i] = toByte(128.0 + 224.0 * (c.z - l) / 1.8556);
  }
}

// ---- CPU 側 ----

export function colorVec(c: u32): vec4<f32> {
  const r = ((c >> 24) & 255) as f32;
  const g = ((c >> 16) & 255) as f32;
  const b = ((c >> 8) & 255) as f32;
  const a = (c & 255) as f32;
  return vec4(r / 255, g / 255, b / 255, a / 255);
}

export function videoCachePath(cache: string, i: usize): string {
  return `${cache}/clip${i}.y4m`;
}

export function imageCachePath(cache: string, i: usize): string {
  return `${cache}/clip${i}.pam`;
}

export function audioCachePath(cache: string, i: usize): string {
  return `${cache}/clip${i}.pcm`;
}

// クリップごとの素材を開く（映像・画像のクリップだけ。ほかは mediaNone()）。mode は media.um の MEDIA_OPEN_*。
// 書き出しと preview は MEDIA_OPEN_BEST（loadMedia）、編集画面は MEDIA_OPEN_FAST。
// 使い終えたら releaseMedia で閉じる（FFmpeg の組み込みの展開器を返すため）。
export function loadMediaFor(p: Project, cache: string, mode: i32): MediaSource[] {
  let out: MediaSource[] = [];
  for (let i: usize = 0; i < p.clips.length; i++) {
    const kind = p.clips[i].kind;
    if (kind == KIND_VIDEO || kind == KIND_IMAGE) {
      out.push(mediaOpenClip(p, cache, i, kind, mode));
    } else {
      out.push(mediaNone());
    }
  }
  return out;
}

export function loadMedia(p: Project, cache: string): MediaSource[] {
  return loadMediaFor(p, cache, MEDIA_OPEN_BEST);
}

// プロジェクトを書き換えたあとに素材を開き直す。FFmpeg の組み込みで開いていて、印（mediaClipKey）と開き方が同じ
// クリップは、old の展開器をそのまま使う（開き直すと、展開器の準備と先頭からの展開に数 ms〜数十 ms かかるため）。
// old は閉じる（使い続けるものは手放してから）。
export function reloadMedia(p: Project, cache: string, mode: i32, old: mut MediaSource[]): MediaSource[] {
  let out: MediaSource[] = [];
  for (let i: usize = 0; i < p.clips.length; i++) {
    const kind = p.clips[i].kind;
    if (kind != KIND_VIDEO && kind != KIND_IMAGE) {
      out.push(mediaNone());
      continue;
    }
    const key = mediaClipKey(p, p.clips[i], kind);
    let k: i64 = -1;
    if (key != "") {
      for (let j: usize = 0; j < old.length; j++) {
        if (old[j].ok && old[j].backend == MEDIA_BACKEND_FFMPEG && old[j].mode == mode && old[j].key == key) {
          k = j as i64;
          break;
        }
      }
    }
    if (k >= 0) {
      out.push(mediaTake(mut old[k as usize]));
    } else {
      out.push(mediaOpenClip(p, cache, i, kind, mode));
    }
  }
  releaseMedia(mut old);
  return out;
}

// 展開したキャッシュから読む素材があるか（編集画面は、あるときだけ展開の結果の変化を見に行く）。
export function mediaUsesCache(media: MediaSource[]): bool {
  for (const m of media) {
    if (m.kind != MEDIA_NONE && m.backend != MEDIA_BACKEND_FFMPEG) {
      return true;
    }
  }
  return false;
}

// loadMedia で開いた素材を閉じる。
export function releaseMedia(media: mut MediaSource[]): void {
  for (let i: usize = 0; i < media.length; i++) {
    mediaRelease(mut media[i]);
  }
}

// 素材が揃っているか。足りなければ説明を返す。
export function checkMedia(p: Project, media: MediaSource[], cache: string, from: f64, to: f64): string[] {
  let errs: string[] = [];
  for (let i: usize = 0; i < p.clips.length; i++) {
    const kind = p.clips[i].kind;
    const used = p.clips[i].at <= to && p.clips[i].at + p.clips[i].dur > from;
    if (used && kind == KIND_MODEL) {
      const mesh = loadObjMesh(modelPath(cache, p.clips[i]));
      if (!mesh.ok) {
        errs.push(`${p.clips[i].line} 行目: モデル '${p.clips[i].src}' を描けません（${mesh.err}）`);
      }
      continue;
    }
    if (used && (kind == KIND_VIDEO || kind == KIND_IMAGE) && !media[i].ok && media[i].backend == MEDIA_BACKEND_FFMPEG) {
      errs.push(`${p.clips[i].line} 行目: ${media[i].err}`);
    } else if (used && (kind == KIND_VIDEO || kind == KIND_IMAGE) && !media[i].ok) {
      let path = videoCachePath(cache, i);
      if (kind == KIND_IMAGE) {
        path = imageCachePath(cache, i);
      }
      if (ffEnabled()) {
        // FFmpeg の版は事前に展開しない。ここに来るのは、素材のファイルがなく、probe.txt の情報で読もうとしたクリップ
        errs.push(`${p.clips[i].line} 行目: 展開した素材 '${path}' がないか壊れています（素材のファイル '${p.clips[i].src}' が見つからないため、展開したキャッシュから読もうとしました）`);
      } else {
        errs.push(`${p.clips[i].line} 行目: 展開した素材 '${path}' がないか壊れています（mozcut.mjs を通して実行してください）`);
      }
    }
  }
  return errs;
}

// ---- 作業用の Buffer の置き場（フレームをまたいで使い回す） ----
// 層・効果の作業用・余白つきの層（vec4<f32>）と、素材の画素を写す Buffer（u8）は、毎コマ確保し直さずに使い回す
// （1280x720 の vec4<f32> は 14.7 MB。確保と 0 埋めに 2〜3 ms、GPU の経路では GPU 側の確保と送りも毎回かかる）。
// - 要る長さちょうどの Buffer を置き場から借り（takeV4 / takeU8）、使い終えたら返す（giveV4 / giveU8）。
//   長さが合うものがなければ新しく確保する。大きさが変わったときだけ作り直すことになる。
// - 返したものは、そのフレームのあいだは「使用中」に置き、次のフレームの始め（rcFrame）に置き場へ戻す。
//   同じフレームの 2 つのクリップが同じ Buffer を使わないので、GPU がまだ読んでいる素材を CPU が書き換えて待つことがない。
// - 借りた Buffer の中身は決まっていない（前に使ったときの値が残る）。借りた側がすべての要素を書いてから読む。
// - RC_KEEP_FRAMES フレーム使わなかったものは捨てる。数が RC_POOL_MAX を超えるか、vec4 の置き場の大きさの合計が
//   RC_POOL_V4_BYTES を超えたら、一番長く使っていないものから捨てる（GPU の経路では GPU 側にも同じ大きさの写しを持つ）。
// - 借りる・返すは関数の引数で受け渡す（RenderCache のフィールドを 2 つ同じ呼び出しに mut で渡すことは、UM の借用の
//   決まりでできないため。借りたものは呼ぶ側の変数になるので、fxApply(mut layer.b, mut tmp.b) のように渡せる）。

struct PoolV4 {
  b: Buffer<vec4<f32>>;
  used: i64;
}

struct PoolU8 {
  b: Buffer<u8>;
  used: i64;
}

struct PoolU32 {
  b: Buffer<u32>;
  used: i64;
}

const RC_KEEP_FRAMES: i64 = 30;
const RC_POOL_MAX: i32 = 24;
const RC_POOL_V4_BYTES: u64 = 256 * 1024 * 1024;

function v4PoolBytes(pool: PoolV4[]): u64 {
  let sum: u64 = 0;
  for (const e of pool) {
    sum += (e.b.length as u64) * 16;
  }
  return sum;
}

// 置き場から長さ n の Buffer を借りる（なければ確保する）。
function takeV4(rc: mut RenderCache, n: u32): PoolV4 {
  let k: i64 = -1;
  for (let i: usize = 0; i < rc.v4Free.length; i++) {
    if (rc.v4Free[i].b.length == n) {
      k = i as i64;
      break;
    }
  }
  if (k < 0) {
    return { b: new Buffer<vec4<f32>>(n), used: rc.frame };
  }
  // k 番目を取り出す（要素は移動できないので、後ろを一時の配列に移してから pop する）
  let rest: PoolV4[] = [];
  while ((rc.v4Free.length as i64) > k + 1) {
    rest.push(rc.v4Free.pop());
  }
  let e = rc.v4Free.pop();
  while (rest.length > 0) {
    rc.v4Free.push(rest.pop());
  }
  e.used = rc.frame;
  return e;
}

function giveV4(rc: mut RenderCache, e: own PoolV4): void {
  rc.v4Used.push(e);
}

function takeU8(rc: mut RenderCache, n: u32): PoolU8 {
  let k: i64 = -1;
  for (let i: usize = 0; i < rc.u8Free.length; i++) {
    if (rc.u8Free[i].b.length == n) {
      k = i as i64;
      break;
    }
  }
  if (k < 0) {
    return { b: new Buffer<u8>(n), used: rc.frame };
  }
  let rest: PoolU8[] = [];
  while ((rc.u8Free.length as i64) > k + 1) {
    rest.push(rc.u8Free.pop());
  }
  let e = rc.u8Free.pop();
  while (rest.length > 0) {
    rc.u8Free.push(rest.pop());
  }
  e.used = rc.frame;
  return e;
}

function giveU8(rc: mut RenderCache, e: own PoolU8): void {
  rc.u8Used.push(e);
}

// 先読みの枠から写す、u32 に詰めたままのコマの置き場（takeU8 / giveU8 と同じ決まり）。
function takeU32(rc: mut RenderCache, n: u32): PoolU32 {
  let k: i64 = -1;
  for (let i: usize = 0; i < rc.u32Free.length; i++) {
    if (rc.u32Free[i].b.length == n) {
      k = i as i64;
      break;
    }
  }
  if (k < 0) {
    return { b: new Buffer<u32>(n), used: rc.frame };
  }
  let rest: PoolU32[] = [];
  while ((rc.u32Free.length as i64) > k + 1) {
    rest.push(rc.u32Free.pop());
  }
  let e = rc.u32Free.pop();
  while (rest.length > 0) {
    rc.u32Free.push(rest.pop());
  }
  e.used = rc.frame;
  return e;
}

function giveU32(rc: mut RenderCache, e: own PoolU32): void {
  rc.u32Used.push(e);
}

// 置き場の v4 の Buffer を、長く使わないものとあふれたものを捨てて整える。
function trimV4(pool: mut PoolV4[], frame: i64): void {
  let i: usize = 0;
  while (i < pool.length) {
    if (frame - pool[i].used > RC_KEEP_FRAMES) {
      const last = pool.pop();
      if (i < pool.length) {
        pool[i] = last;
      }
    } else {
      i++;
    }
  }
  while ((pool.length as i32) > RC_POOL_MAX || (pool.length > 0 && v4PoolBytes(pool) > RC_POOL_V4_BYTES)) {
    let old: usize = 0;
    for (let j: usize = 1; j < pool.length; j++) {
      if (pool[j].used < pool[old].used) {
        old = j;
      }
    }
    const last = pool.pop();
    if (old < pool.length) {
      pool[old] = last;
    }
  }
}

function trimU8(pool: mut PoolU8[], frame: i64): void {
  let i: usize = 0;
  while (i < pool.length) {
    if (frame - pool[i].used > RC_KEEP_FRAMES) {
      const last = pool.pop();
      if (i < pool.length) {
        pool[i] = last;
      }
    } else {
      i++;
    }
  }
  while ((pool.length as i32) > RC_POOL_MAX) {
    let old: usize = 0;
    for (let j: usize = 1; j < pool.length; j++) {
      if (pool[j].used < pool[old].used) {
        old = j;
      }
    }
    const last = pool.pop();
    if (old < pool.length) {
      pool[old] = last;
    }
  }
}

// trimU8 と同じ（u32 の置き場）。
function trimU32(pool: mut PoolU32[], frame: i64): void {
  let i: usize = 0;
  while (i < pool.length) {
    if (frame - pool[i].used > RC_KEEP_FRAMES) {
      const last = pool.pop();
      if (i < pool.length) {
        pool[i] = last;
      }
    } else {
      i++;
    }
  }
  while ((pool.length as i32) > RC_POOL_MAX) {
    let old: usize = 0;
    for (let j: usize = 1; j < pool.length; j++) {
      if (pool[j].used < pool[old].used) {
        old = j;
      }
    }
    const last = pool.pop();
    if (old < pool.length) {
      pool[old] = last;
    }
  }
}

// クリップごとのフォントの置き場（text の行の font= / fontindex=）。1 度読んだら rc.fonts に置き、
// 使う間だけ pop して終わったら push で戻す（rc のほかの欄を mut で渡す関数へ、Font.data の写しを作らずに渡すため）。
const RC_FONT_MAX: i32 = 8;

struct PoolFont {
  path: string;
  index: i32;
  f: Font;
  used: i64;
}

function takeFont(rc: mut RenderCache, path: string, index: i32): PoolFont {
  let k: i64 = -1;
  for (let i: usize = 0; i < rc.fonts.length; i++) {
    if (rc.fonts[i].path == path && rc.fonts[i].index == index) {
      k = i as i64;
      break;
    }
  }
  if (k < 0) {
    return { path: path.clone(), index, f: loadFont(path, index), used: rc.frame };
  }
  let rest: PoolFont[] = [];
  while ((rc.fonts.length as i64) > k + 1) {
    rest.push(rc.fonts.pop());
  }
  let e = rc.fonts.pop();
  while (rest.length > 0) {
    rc.fonts.push(rest.pop());
  }
  e.used = rc.frame;
  return e;
}

function giveFont(rc: mut RenderCache, e: own PoolFont): void {
  let p = e;
  p.used = rc.frame;
  if ((rc.fonts.length as i32) >= RC_FONT_MAX) {
    let old: usize = 0;
    for (let j: usize = 1; j < rc.fonts.length; j++) {
      if (rc.fonts[j].used < rc.fonts[old].used) {
        old = j;
      }
    }
    const last = rc.fonts.pop();
    if (old < rc.fonts.length) {
      rc.fonts[old] = last;
    }
  }
  rc.fonts.push(p);
}

// プリコンポーズ（comp "<sub.mzc>"）の読み込みキャッシュ（pop / push で借りて返す）。
const RC_COMP_MAX: i32 = 8;
const RC_COMP_MAX_DEPTH: i32 = 4;

struct CompEntry {
  path: string;
  size: i64;
  proj: Project;
  media: MediaSource[];
  ok: bool;
  used: i64;
}

function releaseCompEntries(comps: mut CompEntry[]): void {
  for (let i: usize = 0; i < comps.length; i++) {
    releaseMedia(mut comps[i].media);
  }
}

function loadCompEntry(path: string, cache: string, frame: i64, reg: FxReg): CompEntry {
  const bytes = readFile(path);
  if (bytes == null) {
    return { path: path.clone(), size: -1, proj: emptyProject(), media: [], ok: false, used: frame };
  }
  const sz = fileSize(path);
  if (sz == null) {
    return { path: path.clone(), size: -1, proj: emptyProject(), media: [], ok: false, used: frame };
  }
  let known: Probe[] = [];
  const probes = mediaProbeSources(bytes, path, [], mut known);
  let err: Diag[] = [];
  const subP = parseProjectReg(bytes, probes, mut err, reg);
  const subMedia = loadMediaFor(subP, cache, MEDIA_OPEN_BEST);
  return { path: path.clone(), size: sz, proj: subP, media: subMedia, ok: true, used: frame };
}

function takeComp(rc: mut RenderCache, path: string, cache: string, reg: FxReg): CompEntry {
  let k: i64 = -1;
  for (let i: usize = 0; i < rc.comps.length; i++) {
    if (rc.comps[i].path == path) {
      k = i as i64;
      break;
    }
  }
  if (k >= 0) {
    let rest: CompEntry[] = [];
    while ((rc.comps.length as i64) > k + 1) {
      rest.push(rc.comps.pop());
    }
    let e = rc.comps.pop();
    while (rest.length > 0) {
      rc.comps.push(rest.pop());
    }
    const sz = fileSize(path);
    const szv = sz ?? -1;
    if (e.ok && szv >= 0 && szv == e.size) {
      e.used = rc.frame;
      return e;
    }
    releaseMedia(mut e.media);
  }
  return loadCompEntry(path, cache, rc.frame, reg);
}

function giveComp(rc: mut RenderCache, e: own CompEntry): void {
  let p = e;
  p.used = rc.frame;
  if ((rc.comps.length as i32) >= RC_COMP_MAX) {
    let old: usize = 0;
    for (let j: usize = 1; j < rc.comps.length; j++) {
      if (rc.comps[j].used < rc.comps[old].used) {
        old = j;
      }
    }
    let last = rc.comps.pop();
    if (old < rc.comps.length) {
      releaseMedia(mut rc.comps[old].media);
      rc.comps[old] = last;
    } else {
      releaseMedia(mut last.media);
    }
  }
  rc.comps.push(p);
}

function clipCompPath(c: Clip): string {
  if (c.file != "") {
    return c.file.clone();
  }
  return c.src.clone();
}

// フレームの始めに呼ぶ。使用中のものを置き場に戻し、長く使わないものとあふれたものを捨てる。
function rcFrame(rc: mut RenderCache): void {
  rc.frame = rc.frame + 1;
  while (rc.v4Used.length > 0) {
    rc.v4Free.push(rc.v4Used.pop());
  }
  while (rc.u8Used.length > 0) {
    rc.u8Free.push(rc.u8Used.pop());
  }
  trimV4(mut rc.v4Free, rc.frame);
  while (rc.u32Used.length > 0) {
    rc.u32Free.push(rc.u32Used.pop());
  }
  trimU8(mut rc.u8Free, rc.frame);
  trimU32(mut rc.u32Free, rc.frame);
}

// フレームをまたいで使い回すもの。呼ぶ側が newRenderCache() で 1 度だけ作り、renderFrame に毎回 mut で渡す。
// - text: 文字の画像（文字・大きさ・揃え・縁取り・フォントが同じなら作り直さない）
// - v4Free / v4Used / u8Free / u8Used / u32Free / u32Used: 作業用の Buffer の置き場（上の「作業用の Buffer の置き場」）
// - grade: 色の調整（grade.*）を焼いた表と読んだ .cube（gradelayer.um）
// - blendLut / blendTf: 描画モードの線形の光の表（project の blend.tf が変わったときだけ作り直す）
// - masks: クリップの番号ごとのマスク（マスクの行と層の大きさが同じなら作り直さない）
export struct RenderCache {
  text: TextLayerCache;
  grade: GradeCache;
  frame: i64;
  v4Free: PoolV4[];
  v4Used: PoolV4[];
  u8Free: PoolU8[];
  u8Used: PoolU8[];
  u32Free: PoolU32[];
  u32Used: PoolU32[];
  blendLut: MblLut;
  blendTf: u32;
  masks: MblMaskCache[];
  // shape の行の形の置き場（クリップの番号ごと。形・位置・時刻が同じコマは作り直さない）
  shape: ShapeCaches;
  // テキストアニメーターの字の並びとアトラス（文字・大きさ・縁取り・フォントが同じなら作り直さない）
  ta: TaCache;
  // パーティクルの状態（クリップごと。シミュレーションに関わる値が同じなら、時刻を進めるだけで作り直さない）
  pt: PtCache;
  // 3D レイヤーの画素を集めるアトラス（毎コマ空にして使い回す）と、重い場面の和の置き場（1 つ。pop / push で借りて返す。
  // t3Render に atlas と work を同じ rc から渡すと、同じ変数を mut と別の引数で渡すことになるため）
  t3atlas: T3Atlas;
  t3work: T3Work[];
  // 読んだモデル（model の行の .obj）と、そのファイルの場所（同じ番号）。一度読んだら作り直さない
  meshes: T3Mesh[];
  meshPaths: string[];
  // クリップごとのフォント（text の行の font= / fontindex=）
  fonts: PoolFont[];
  // プリコンポーズ（comp "<sub.mzc>"）の読み込みキャッシュと入れ子の深さ
  comps: CompEntry[];
  compDepth: i32;
  // 音連動（オーディオリアクティブ）の FFT キャッシュ
  audioReact: AudioReactCache;
}

export function newRenderCache(): RenderCache {
  return {
    text: newTextLayerCache(), grade: newGradeCache(), frame: 0, v4Free: [], v4Used: [], u8Free: [], u8Used: [],
    u32Free: [], u32Used: [],
    blendLut: mblNewLut(MBL_TF_DEFAULT), blendTf: MBL_TF_DEFAULT, masks: [], shape: newShapeCaches(), ta: newTaCache(),
    pt: ptNewCache(), t3atlas: t3AtlasNew(1 << 20), t3work: [t3WorkNew()], meshes: [], meshPaths: [], fonts: [], comps: [], compDepth: 0, audioReact: audioReactNew(),
  };
}

function newSubRenderCache(depth: i32): RenderCache {
  return {
    text: newTextLayerCache(), grade: newGradeCache(), frame: 0, v4Free: [], v4Used: [], u8Free: [], u8Used: [],
    u32Free: [], u32Used: [],
    blendLut: mblNewLut(MBL_TF_DEFAULT), blendTf: MBL_TF_DEFAULT, masks: [], shape: newShapeCaches(), ta: newTaCache(),
    pt: ptNewCache(), t3atlas: t3AtlasNew(1), t3work: [t3WorkNew()], meshes: [], meshPaths: [], fonts: [], comps: [], compDepth: depth, audioReact: audioReactNew(),
  };
}

// 置き場にある Buffer の数（試験・計測用）。
export function renderCacheBuffers(rc: RenderCache): i32 {
  return (rc.v4Free.length + rc.v4Used.length + rc.u8Free.length + rc.u8Used.length + rc.u32Free.length + rc.u32Used.length) as i32;
}

// ---- 描画 ----

function envelope(t: f64, dur: f64, fin: f64, fout: f64): f64 {
  let a: f64 = 1;
  if (fin > 0) {
    a = Math.min(a, t / fin);
  }
  if (fout > 0) {
    a = Math.min(a, (dur - t) / fout);
  }
  return Math.min(Math.max(a, 0.0), 1.0);
}

export function audioEnvelope(c: Clip, t: f64): f64 {
  return envelope(t, c.dur, Math.max(c.fadeIn, c.afadeIn), Math.max(c.fadeOut, c.afadeOut));
}

// ---- キーフレーム ----

// クリップのキーフレーム（Clip.anims）を、クリップの始まりからの時刻 lt で評価して差し替えた写し。
// 位置（x / y / pos）は左上からの画素のまま（xAbs / yAbs が立っている）。数は範囲に丸め、色は 0〜1 に丸めてある。
// timeremap は素材の時刻なので、ここでは差し替えない（clipSourceTime）。
export function clipAt(c: Clip, lt: f64): Clip {
  let o = clipCopy(c);
  for (const a of c.anims) {
    if (a.key == "timeremap") {
      continue;
    }
    const v = animEval(a.track, lt);
    if (o.kind == KIND_SHAPE && shapeAnimType(a.key) >= 0) {
      clipShapeAnim(mut o, a.key, v, a.lo, a.hi);
      continue;
    }
    if (a.fx >= 0) {
      const x = animClamp(v[0], a.lo, a.hi) as f32;
      for (let s: usize = 0; s < o.fx.length; s++) {
        if (o.fx[s].effect == a.fx) {
          o.fx[s].params[a.param as usize] = x;
        }
      }
      continue;
    }
    switch (a.key) {
      case "x":
        o.x = v[0];
        break;
      case "y":
        o.y = v[0];
        break;
      case "pos":
        o.x = v[0];
        o.y = v[1];
        break;
      case "opacity":
        o.opacity = animClamp(v[0], 0, 1) as f32;
        break;
      case "color":
        o.color = animEvalColor(a.track, lt);
        break;
      case "volume":
      case "vol":
        o.volume = animClamp(v[0], 0, 10) as f32;
        break;
    }
  }
  return o;
}

// shape の行の形のキーのキーフレームの値を ShapeSpec に入れる。
function clipShapeAnim(o: mut Clip, key: string, v: f64[4], lo: f64, hi: f64): void {
  const x = animClamp(v[0], lo, hi);
  switch (key) {
    case "pos":
      o.shape.posSet = true;
      o.shape.posX = v[0];
      o.shape.posY = v[1];
      break;
    case "anchor":
      o.shape.anchorX = v[0];
      o.shape.anchorY = v[1];
      break;
    case "rotation":
      o.shape.rotation = v[0];
      break;
    case "repeatrot":
      o.shape.repRot = v[0];
      break;
    case "scale":
      o.shape.scaleX = x;
      o.shape.scaleY = x;
      break;
    case "trimstart":
      o.shape.trimStart = x;
      break;
    case "trimend":
      o.shape.trimEnd = x;
      break;
    case "trimoffset":
      o.shape.trimOffset = x;
      break;
    case "strokew":
      o.shape.strokeW = x;
      break;
    case "r":
      o.shape.r = x;
      break;
    case "inner":
      o.shape.inner = x;
      o.shape.innerSet = true;
      break;
    case "w":
      o.shape.w = x;
      break;
    case "h":
      o.shape.h = x;
      break;
    case "radius":
      o.shape.radius = x;
      break;
    case "repeatx":
      o.shape.repX = x;
      break;
    case "repeaty":
      o.shape.repY = x;
      break;
    case "repeatscale":
      o.shape.repScale = x;
      break;
  }
}

// クリップの始まりからの時刻 lt に見せる素材の時刻（秒）。timeremap があればその値、なければ in + lt × speed。
export function clipSourceTime(c: Clip, lt: f64): f64 {
  for (const a of c.anims) {
    if (a.key == "timeremap") {
      return animRemapTime(a.track, lt);
    }
  }
  return lt * clipSpeed(c) + c.inPt;
}

// project の行の効果を、タイムラインの時刻 t のキーフレームの値にした写し。
function projectFxAt(p: Project, t: f64): FxUse[] {
  let out = p.fx.clone();
  for (const a of p.anims) {
    if (a.fx < 0) {
      continue;
    }
    const x = animClamp(animEval(a.track, t)[0], a.lo, a.hi) as f32;
    for (let s: usize = 0; s < out.length; s++) {
      if (out[s].effect == a.fx) {
        out[s].params[a.param as usize] = x;
      }
    }
  }
  return out;
}

// (x, y) に w × h で置く層について、キャンバスに重ねる kernel の dispatch の個数（層の下の端の行までの画素数）。
// 層がキャンバスと重ならなければ 0（dispatch しない）。
function rowsCount(p: Project, x: i32, y: i32, w: i32, h: i32): u32 {
  if (w <= 0 || h <= 0 || x >= p.width || y >= p.height || x + w <= 0 || y + h <= 0) {
    return 0;
  }
  const y1 = Math.min(y + h, p.height);
  return (y1 * p.width) as u32;
}

// クリップの効果（Clip.fx）を、行に書いた順に層に掛ける。作業用の tmp は 1 つ確保して使い回す。
// （1 回だけ掛けるとき用。renderFrame は置き場の tmp を渡して applyClipFxTmp を使う）
export function applyClipFx(layer: mut Buffer<vec4<f32>>, c: Clip, w: u32, h: u32): void {
  if (c.fx.length == 0) {
    return;
  }
  let tmp = new Buffer<vec4<f32>>(w * h);
  applyClipFxTmp(mut layer, mut tmp, c, w, h);
}

// クリップの効果を、作業用の tmp（長さ w * h 以上。中身は何でもよい）を使って掛ける。
export function applyClipFxTmp(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, c: Clip, w: u32, h: u32): void {
  applyClipFxTmpReg(mut layer, mut tmp, c, w, h, fxRegBuiltin());
}

export function applyClipFxTmpReg(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, c: Clip, w: u32, h: u32, reg: FxReg): void {
  for (const u of c.fx) {
    reg.apply(u.effect, mut layer, mut tmp, w, h, u.params);
  }
}

// 効果が周りへ広がる画素数の合計（@reach。blur / sharpen など）。
function clipFxReach(c: Clip, reg: FxReg): i32 {
  let r = 0;
  for (const u of c.fx) {
    r = r + reg.reach(u.effect, u.params);
  }
  return Math.min(r, 512);
}

// 層のまわりに pad 画素の透明な余白を足して写す。
kernel function padCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, pw: u32, w: i32, h: i32, pad: i32): void {
  const x = ((i % pw) as i32) - pad;
  const y = ((i / pw) as i32) - pad;
  if (x < 0 || y < 0 || x >= w || y >= h) {
    dst[i] = vec4(0.0, 0.0, 0.0, 0.0);
    return;
  }
  dst[i] = src[(y * w + x) as u32];
}

// 層を (lx, ly) に重ねる（層の下の端の行までだけ dispatch する）。
function compositeLayer(
  canvas: mut Buffer<vec4<f32>>, layer: Buffer<vec4<f32>>, p: Project, lx: i32, ly: i32, w: i32, h: i32, alpha: f32,
): void {
  const cnt = rowsCount(p, lx, ly, w, h);
  if (cnt > 0) {
    dispatch(composite, cnt, mut canvas, layer, p.width as u32, lx, ly, w, h, alpha);
  }
}

// 効果を掛けて (lx, ly) に重ねる。透明なまわりがある層（画像・文字）で、効果が広がる（blur など）なら、
// 広がる分の透明な余白を足した層に掛ける（層の四角で切れないように）。不透明な層（映像・色）は端をくり返す。
// 作業用の Buffer は置き場（rc）から借りる。
function fxComposite(
  canvas: mut Buffer<vec4<f32>>, layer: mut Buffer<vec4<f32>>, c: Clip, p: Project,
  lx: i32, ly: i32, w: i32, h: i32, alpha: f32, rc: mut RenderCache, reg: FxReg,
): void {
  const pad = clipFxReach(c, reg);
  if (pad > 0 && (c.kind == KIND_IMAGE || c.kind == KIND_TEXT || c.kind == KIND_COMP)) {
    const pw = w + 2 * pad;
    const ph = h + 2 * pad;
    const pn = (pw * ph) as u32;
    let big = takeV4(mut rc, pn);
    let tmp = takeV4(mut rc, pn);
    dispatch(padCopy, pn, mut big.b, layer, pw as u32, w, h, pad);
    applyClipFxTmpReg(mut big.b, mut tmp.b, c, pw as u32, ph as u32, reg);
    compositeLayer(mut canvas, big.b, p, lx - pad, ly - pad, pw, ph, alpha);
    giveV4(mut rc, own big);
    giveV4(mut rc, own tmp);
    return;
  }
  let tmp = takeV4(mut rc, (w * h) as u32);
  applyClipFxTmpReg(mut layer, mut tmp.b, c, w as u32, h as u32, reg);
  compositeLayer(mut canvas, layer, p, lx, ly, w, h, alpha);
  giveV4(mut rc, own tmp);
}

// st は見せる素材の時刻（秒。clipSourceTime）。
function drawVideo(
  canvas: mut Buffer<vec4<f32>>, c: Clip, m: MediaSource, p: Project, cache: string, idx: usize, st: f64, alpha: f32,
  rc: mut RenderCache, fc: FrameCache, reg: FxReg,
): void {
  const lx = clipPos(c.x, c.xAbs, m.w, p.width);
  const ly = clipPos(c.y, c.yAbs, m.h, p.height);
  const plain = c.fx.length == 0 && !clipGraded(c);
  const cnt = rowsCount(p, lx, ly, m.w, m.h);
  if (plain && cnt == 0) {
    return;
  }
  const k = videoFrameIndex(c, m, p, st);
  if (fc.slots > 0) {
    // 先読みの枠に当たれば、u32 に詰めたまま kernel に渡す（バイトにほどくのは kernel。GPU の経路なら GPU）
    let wd = takeU32(mut rc, ((m.frameBytes + 3) / 4) as u32);
    if (fcVideoWords(fc, idx, k, mut wd.b, m.w, m.h)) {
      if (plain) {
        dispatch(yuvWordsComposite, cnt, mut canvas, wd.b, p.width as u32, lx, ly, m.w, m.h, alpha, mediaYuvK1(m), mediaYuvK2(m));
        giveU32(mut rc, own wd);
        return;
      }
      const wn = (m.w * m.h) as u32;
      let wl = takeV4(mut rc, wn);
      dispatch(yuvWordsToLayer, wn, mut wl.b, wd.b, m.w as u32, m.h as u32, mediaYuvK1(m), mediaYuvK2(m));
      giveU32(mut rc, own wd);
      gradeLayer(mut wl.b, wn, c, cache, mut rc.grade);
      fxComposite(mut canvas, mut wl.b, c, p, lx, ly, m.w, m.h, alpha, mut rc, reg);
      giveV4(mut rc, own wl);
      return;
    }
    giveU32(mut rc, own wd);
  }
  // 枠に外れたら（枠がなければ）、ファイルから読む
  let yuv = takeU8(mut rc, m.frameBytes as u32);
  if (!mediaReadFrame(m, k, mut yuv.b)) {
    giveU8(mut rc, own yuv);
    return;
  }
  if (plain) {
    // 効果がなければ、層に広げずにキャンバスへ直接重ねる
    dispatch(yuvComposite, cnt, mut canvas, yuv.b, p.width as u32, lx, ly, m.w, m.h, alpha, mediaYuvK1(m), mediaYuvK2(m));
    giveU8(mut rc, own yuv);
    return;
  }
  const n = (m.w * m.h) as u32;
  let layer = takeV4(mut rc, n);
  dispatch(yuvToLayer, n, mut layer.b, yuv.b, m.w as u32, m.h as u32, mediaYuvK1(m), mediaYuvK2(m));
  giveU8(mut rc, own yuv);
  gradeLayer(mut layer.b, n, c, cache, mut rc.grade);
  fxComposite(mut canvas, mut layer.b, c, p, lx, ly, m.w, m.h, alpha, mut rc, reg);
  giveV4(mut rc, own layer);
}

// 素材の時刻 st の映像のコマ（YUV 4:2:0）を yuv に読む（先読みの置き場 fc にあればそこから）。読めなければ false。
function readVideoYuv(
  yuv: mut Buffer<u8>, c: Clip, m: MediaSource, p: Project, cache: string, idx: usize, st: f64, fc: FrameCache,
): bool {
  const fps = (p.fpsNum as f64) / (p.fpsDen as f64);
  // 展開した範囲の始まり（.in がなければ、計画どおり in か timeremap の範囲の始まり）
  let base = c.inPt;
  if (c.remapLo != UNSET) {
    base = c.remapLo;
  }
  // mediaFrameAt は (lt + clipIn − 展開の始まり) を数えるので、clipIn に base、lt に st − base を渡す
  const k = mediaFrameAt(m, base, st - base, fps);
  if (fcVideoYuv(fc, idx, k, mut yuv, m.w, m.h)) {
    return true;
  }
  return mediaReadFrame(m, k, mut yuv);
}

// 素材の時刻 st の映像のコマの番号（readVideoYuv と同じ数え方）。
function videoFrameIndex(c: Clip, m: MediaSource, p: Project, st: f64): i64 {
  const fps = (p.fpsNum as f64) / (p.fpsDen as f64);
  let base = c.inPt;
  if (c.remapLo != UNSET) {
    base = c.remapLo;
  }
  return mediaFrameAt(m, base, st - base, fps);
}

function drawImage(
  canvas: mut Buffer<vec4<f32>>, c: Clip, m: MediaSource, p: Project, cache: string, idx: usize, alpha: f32, rc: mut RenderCache, reg: FxReg,
): void {
  const lx = clipPos(c.x, c.xAbs, m.w, p.width);
  const ly = clipPos(c.y, c.yAbs, m.h, p.height);
  const plain = c.fx.length == 0 && !clipGraded(c);
  const cnt = rowsCount(p, lx, ly, m.w, m.h);
  if (plain && cnt == 0) {
    return;
  }
  const n = (m.w * m.h) as u32;
  let px = takeU8(mut rc, n * 4);
  if (!mediaReadFrame(m, 0, mut px.b)) {
    giveU8(mut rc, own px);
    return;
  }
  if (plain) {
    dispatch(rgbaComposite, cnt, mut canvas, px.b, p.width as u32, lx, ly, m.w, m.h, alpha);
    giveU8(mut rc, own px);
    return;
  }
  let layer = takeV4(mut rc, n);
  dispatch(rgbaToLayer, n, mut layer.b, px.b);
  giveU8(mut rc, own px);
  gradeLayer(mut layer.b, n, c, cache, mut rc.grade);
  fxComposite(mut canvas, mut layer.b, c, p, lx, ly, m.w, m.h, alpha, mut rc, reg);
  giveV4(mut rc, own layer);
}

function drawColor(canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, alpha: f32, rc: mut RenderCache, reg: FxReg): void {
  let w = c.w;
  let h = c.h;
  if (w <= 0) {
    w = p.width;
  }
  if (h <= 0) {
    h = p.height;
  }
  const x0 = clipPos(c.x, c.xAbs, w, p.width);
  const y0 = clipPos(c.y, c.yAbs, h, p.height);
  if (c.fx.length > 0) {
    // 効果があるときは、色を w × h の層に塗ってから効果を掛けて重ねる（video / image と同じ）。
    const n = (w * h) as u32;
    let layer = takeV4(mut rc, n);
    dispatch(clearCanvas, n, mut layer.b, colorVec(c.color));
    fxComposite(mut canvas, mut layer.b, c, p, x0, y0, w, h, alpha, mut rc, reg);
    giveV4(mut rc, own layer);
    return;
  }
  const cnt = rowsCount(p, x0, y0, w, h);
  if (cnt > 0) {
    dispatch(fillRect, cnt, mut canvas, p.width as u32, x0, y0, x0 + w, y0 + h, colorVec(c.color), alpha);
  }
}

// 文字のクリップ。効果がなければキャンバスに直接描き、あれば透明な層に描いて効果を掛けてから重ねる。
// テキストアニメーター（anim=）があれば、字ごとに動かして描く（lt はクリップの始まりからの時刻）。
function drawTextWithFont(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, font: Font, lt: f64, alpha: f32, rc: mut RenderCache, reg: FxReg,
): void {
  if (taClipAnimated(c)) {
    // 字の動きはクリップの中の時刻（in= で分けた後半も続きから。animout は full= から数える）
    let st = taStyleFromClip(c);
    st.dur = clipInnerDur(c);
    const it = clipInnerTime(c, lt);
    const spec = taClipSpec(c, p);
    if (c.fx.length == 0) {
      taDrawCanvas(mut canvas, p.width, p.height, st, spec, font, it, alpha, mut rc.ta);
      return;
    }
    let lo = taRenderLayer(p.width, p.height, st, spec, font, it, mut rc.ta);
    if (lo.w > 0 && lo.h > 0) {
      fxComposite(mut canvas, mut lo.layer, c, p, lo.x, lo.y, lo.w, lo.h, alpha, mut rc, reg);
    }
    return;
  }
  if (c.fx.length == 0) {
    renderTextClipCached(mut canvas, c, p, font, alpha, mut rc.text);
    return;
  }
  const r = textClipRect(c, p, font, mut rc.text);
  if (r.w <= 0 || r.h <= 0) {
    return;
  }
  let layer = takeV4(mut rc, (r.w * r.h) as u32);
  textClipDrawLayer(mut layer.b, c, p, font, mut rc.text);
  fxComposite(mut canvas, mut layer.b, c, p, r.x, r.y, r.w, r.h, alpha, mut rc, reg);
  giveV4(mut rc, own layer);
}

function drawText(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, font: Font, lt: f64, alpha: f32, rc: mut RenderCache, reg: FxReg,
): void {
  if (c.fontPath != "") {
    let cf = takeFont(mut rc, c.fontPath, c.fontIndex);
    if (cf.f.ok) {
      drawTextWithFont(mut canvas, c, p, cf.f, lt, alpha, mut rc, reg);
    } else {
      drawTextWithFont(mut canvas, c, p, font, lt, alpha, mut rc, reg);
    }
    giveFont(mut rc, own cf);
    return;
  }
  drawTextWithFont(mut canvas, c, p, font, lt, alpha, mut rc, reg);
}

// 時刻 t のコマをキャンバスに描く。font は文字のクリップのフォント（呼ぶ側が projectFont(p.fontPath, p.fontIndex) で 1 度だけ読む）。
// rc は newRenderCache() で作り、フレームをまたいで同じものを渡す（文字の画像と作業用の Buffer を作り直さないため）。
export function renderFrame(
  p: Project, media: MediaSource[], cache: string, t: f64, canvas: mut Buffer<vec4<f32>>, font: Font, rc: mut RenderCache,
): void {
  const fc = emptyFrameCache();
  renderFrameFromReg(p, media, cache, t, mut canvas, font, mut rc, fc, fxRegBuiltin());
}

export function renderFrameReg(
  p: Project, media: MediaSource[], cache: string, t: f64, canvas: mut Buffer<vec4<f32>>, font: Font, rc: mut RenderCache,
  reg: FxReg,
): void {
  const fc = emptyFrameCache();
  renderFrameFromReg(p, media, cache, t, mut canvas, font, mut rc, fc, reg);
}

export function renderFrameFrom(
  p: Project, media: MediaSource[], cache: string, t: f64, canvas: mut Buffer<vec4<f32>>, font: Font, rc: mut RenderCache,
  fc: FrameCache,
): void {
  renderFrameFromReg(p, media, cache, t, mut canvas, font, mut rc, fc, fxRegBuiltin());
}

export function renderFrameFromReg(
  p: Project, media: MediaSource[], cache: string, t: f64, canvas: mut Buffer<vec4<f32>>, font: Font, rc: mut RenderCache,
  fc: FrameCache, reg: FxReg,
): void {
  textCacheFrame(mut rc.text);
  gradeCacheFrame(mut rc.grade);
  taCacheFrame(mut rc.ta);
  ptCacheFrame(mut rc.pt);
  t3AtlasClear(mut rc.t3atlas);
  rcFrame(mut rc);
  if (rc.blendTf != p.blendTf) {
    rc.blendLut = mblNewLut(p.blendTf);
    rc.blendTf = p.blendTf;
  }
  const n = (p.width * p.height) as u32;
  let bgCol = colorVec(p.bg);
  if (rc.compDepth > 0 && p.bg == 0x000000ff) {
    // プリコンポーズの既定背景は透明にして親コンポジションへ合成する
    bgCol = vec4(0.0, 0.0, 0.0, 0.0);
  }
  dispatch(clearCanvas, n, mut canvas, bgCol);
  // エクスプレッション: このコマの値を先に全部求める（clip('ID') でほかのクリップの値を読むため）
  let ov: ExprOut[] = [];
  if (p.exprProgs.length > 0) {
    audioReactPrepare(mut rc.audioReact, p, cache);
    exprFrame(p, media, t, font, mut rc, mut ov, reg);
  }
  let layers3d: T3Layer[] = [];
  let models3d: T3Model[] = [];
  for (const ci of p.drawOrder) {
    const idx = ci as usize;
    const lt = t - p.clips[idx].at;
    if (lt < 0 || lt >= p.clips[idx].dur) {
      continue;
    }
    // ほかのクリップのトラックマットの元は、画面に描かない（マットにだけ使う）
    if (p.clips[idx].id != "" && isMatteSource(p, p.clips[idx].id)) {
      continue;
    }
    const st = clipSourceTime(p.clips[idx], lt);
    if (p.clips[idx].d3.is3d) {
      // 3D のレイヤーは、続けて並ぶ 3D のクリップを 1 組にして、組の終わりで t3Render で重ねる（After Effects と同じく、
      // 間に 2D のレイヤーがあると組が分かれる）
      let c = clipAt(p.clips[idx], lt);
      exprApply(mut c, idx, ov, reg);
      if (c.parent != "") {
        applyParent(mut c, idx, p, media, font, t, lt, ov, mut rc, reg);
      }
      if (c.kind == KIND_MODEL) {
        put3dModel(mut models3d, c, p, cache, lt, mut rc);
      } else {
        put3dLayer(mut layers3d, c, p, media, cache, idx, lt, st, font, mut rc, fc, reg);
      }
      continue;
    }
    flush3d(mut canvas, mut layers3d, mut models3d, p, t, mut rc);
    if (clipNeeds2dMblur(p.clips[idx], exprHas(idx, ov))) {
      drawClip2dMblur(mut canvas, p, media, cache, idx, t, ov, font, mut rc, fc, reg);
    } else if (exprHas(idx, ov) || p.clips[idx].parent != "") {
      // 式で決めた値と親レイヤーの変形は、キーフレームを評価した写しの上に差し替える
      let c = clipAt(p.clips[idx], lt);
      exprApply(mut c, idx, ov, reg);
      if (c.parent != "") {
        applyParent(mut c, idx, p, media, font, t, lt, ov, mut rc, reg);
      }
      drawClip(mut canvas, c, p, media, cache, idx, t, lt, st, font, mut rc, fc, reg);
    } else if (p.clips[idx].anims.length == 0) {
      drawClip(mut canvas, p.clips[idx], p, media, cache, idx, t, lt, st, font, mut rc, fc, reg);
    } else {
      // キーフレームのあるクリップは、その時刻の値にした写しで描く（不透明度もこの値で判断する）
      const c = clipAt(p.clips[idx], lt);
      drawClip(mut canvas, c, p, media, cache, idx, t, lt, st, font, mut rc, fc, reg);
    }
  }
  flush3d(mut canvas, mut layers3d, mut models3d, p, t, mut rc);
  // project の行の効果は、合成した画面全体に掛ける（行に書いた順。引数のキーフレームはタイムラインの時刻で評価する）
  if (p.fx.length > 0) {
    let tmp = takeV4(mut rc, n);
    let orig = takeV4(mut rc, n);
    const fxs = projectFxAt(p, t);
    for (const u of fxs) {
      reg.applyCached(u.effect, mut canvas, mut tmp.b, mut orig.b, p.width as u32, p.height as u32, u.params);
    }
    giveV4(mut rc, own orig);
    giveV4(mut rc, own tmp);
  }
}

// 2D レイヤーがモーションブラーを掛けるべき動きを持っているか。
function clipNeeds2dMblur(c: Clip, hasExpr: bool): bool {
  if (!c.d3.mblur || c.d3.is3d) {
    return false;
  }
  if (c.anims.length > 0 || c.parent != "" || hasExpr) {
    return true;
  }
  return t3TrackMoves(c.d3.tracks[T3L_RZ as usize]) || t3TrackMoves(c.d3.tracks[T3L_SCALE as usize]) ||
    t3TrackMoves(c.d3.tracks[T3L_ANCHOR as usize]);
}

// 2D モーションブラー: シャッター角内のサブフレーム時刻で複数回描画して平均合成する。
function drawClip2dMblur(
  canvas: mut Buffer<vec4<f32>>, p: Project, media: MediaSource[], cache: string, idx: usize, t: f64,
  ov: ExprOut[], font: Font, rc: mut RenderCache, fc: FrameCache, reg: FxReg,
): void {
  const fps = (Math.max(p.fpsNum, 1) as f64) / (Math.max(p.fpsDen, 1) as f64);
  let angle = p.scene3d.mbAngle;
  if (angle <= 0.0) {
    angle = 180.0;
  }
  let phase = -angle * 0.5;
  if (p.scene3d.mbPhaseSet) {
    phase = p.scene3d.mbPhase;
  }
  let ns = p.scene3d.mbSamples;
  if (ns < 2) {
    ns = 8;
  }
  if (ns > 16) {
    ns = 16;
  }
  const n = (p.width * p.height) as u32;
  let acc = takeV4(mut rc, n);
  let sb = takeV4(mut rc, n);
  dispatch(clearCanvas, n, mut acc.b, vec4(0.0, 0.0, 0.0, 0.0));
  for (let s = 0; s < ns; s++) {
    const frac = ((s as f64) + 0.5) / (ns as f64);
    const ts = t + ((phase + frac * angle) / 360.0) / fps;
    const lts = ts - p.clips[idx].at;
    const sts = clipSourceTime(p.clips[idx], lts);
    let cs = clipAt(p.clips[idx], lts);
    exprApply(mut cs, idx, ov, reg);
    if (cs.parent != "") {
      applyParent(mut cs, idx, p, media, font, ts, lts, ov, mut rc, reg);
    }
    dispatch(clearCanvas, n, mut sb.b, vec4(0.0, 0.0, 0.0, 0.0));
    drawClipDirect(mut sb.b, cs, p, media, cache, idx, ts, lts, sts, font, mut rc, fc, reg);
    dispatch(mblurAcc, n, mut acc.b, sb.b);
  }
  dispatch(mblurResolve, n, mut canvas, acc.b, 1.0 / (ns as f32));
  giveV4(mut rc, own sb);
  giveV4(mut rc, own acc);
}

// 1 つのクリップを描く（c は p.clips[idx] か、キーフレームを評価した写し。t はタイムラインの時刻、
// lt はクリップの始まりからの時刻、st は見せる素材の時刻）。
function drawClip(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, media: MediaSource[], cache: string, idx: usize, t: f64, lt: f64, st: f64,
  font: Font, rc: mut RenderCache, fc: FrameCache, reg: FxReg,
): void {
  let trDur = c.xfade;
  if (trDur <= 0.0 && c.trans != "" && c.fadeIn > 0.0) {
    trDur = c.fadeIn;
  }
  if (c.trans != "" && trDur > 0.0 && lt >= 0.0 && lt < trDur) {
    const n = (p.width * p.height) as u32;
    let nextBuf = takeV4(mut rc, n);
    let tmp = takeV4(mut rc, n);
    if (c.kind == KIND_TEXT || c.kind == KIND_SHAPE || c.kind == KIND_PARTICLES || c.kind == KIND_COMP) {
      // 文字・図形・粒は下の絵を保ったまま次フレームの絵を作る
      for (let k: u32 = 0; k < n; k++) {
        nextBuf.b[k] = canvas[k];
      }
    } else {
      dispatch(clearCanvas, n, mut nextBuf.b, colorVec(p.bg));
    }
    let c2 = clipCopy(c);
    c2.fadeIn = 0.0;
    drawClipDirect(mut nextBuf.b, c2, p, media, cache, idx, t, lt, st, font, mut rc, fc, reg);
    const prog = Math.min(Math.max(lt / trDur, 0.0), 1.0) as f32;
    transApply(c.trans, reg.wasm, mut canvas, nextBuf.b, mut tmp.b, p.width as u32, p.height as u32, prog, c.transAngle, c.transSoft, c.transParam);
    giveV4(mut rc, own tmp);
    giveV4(mut rc, own nextBuf);
    return;
  }
  drawClipDirect(mut canvas, c, p, media, cache, idx, t, lt, st, font, mut rc, fc, reg);
}

function drawClipDirect(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, media: MediaSource[], cache: string, idx: usize, t: f64, lt: f64, st: f64,
  font: Font, rc: mut RenderCache, fc: FrameCache, reg: FxReg,
): void {
  const env = envelope(lt, c.dur, c.fadeIn, c.fadeOut);
  const alpha = (env as f32) * c.opacity;
  if (alpha <= 0) {
    return;
  }
  if (c.blend.used || c.masks.length > 0 || clipXf2dOn(c, lt)) {
    drawBlended(mut canvas, c, p, media, cache, idx, t, st, font, alpha, mut rc, fc, reg);
    return;
  }
  const kind = c.kind;
  if (kind == KIND_VIDEO) {
    drawVideo(mut canvas, c, media[idx], p, cache, idx, st, alpha, mut rc, fc, reg);
  } else if (kind == KIND_IMAGE) {
    drawImage(mut canvas, c, media[idx], p, cache, idx, alpha, mut rc, reg);
  } else if (kind == KIND_COLOR) {
    drawColor(mut canvas, c, p, alpha, mut rc, reg);
  } else if (kind == KIND_TEXT) {
    drawText(mut canvas, c, p, font, lt, alpha, mut rc, reg);
  } else if (kind == KIND_SHAPE) {
    drawShape(mut canvas, c, p, idx, lt, alpha, mut rc, reg);
  } else if (kind == KIND_PARTICLES) {
    drawParticles(mut canvas, c, p, font, lt, alpha, mut rc, reg);
  } else if (kind == KIND_COMP) {
    drawComp(mut canvas, c, p, cache, idx, st, font, alpha, mut rc, reg);
  } else if (kind == KIND_SPECTRUM) {
    drawSpectrum(mut canvas, c, p, cache, idx, t, font, alpha, mut rc, reg);
  }
}

// オーディオスペクトラム（bars / wave / ring）を描く kernel。
kernel function spectrumKernel(
  i: u32, dst: mut Buffer<vec4<f32>>, vals: Buffer<f32>, w: u32, h: u32,
  style: i32, bars: i32, gain: f32, colA: vec4<f32>, colB: vec4<f32>,
): void {
  const px = (i % w) as f32;
  const py = (i / w) as f32;
  const wf = w as f32;
  const hf = h as f32;
  const u = (px + 0.5) / wf;
  const v = (py + 0.5) / hf;
  let a: f32 = 0.0;
  let gt: f32 = 1.0 - v;
  if (style == 0) {
    const nb = Math.max(bars, 4);
    const cell = u * (nb as f32);
    const bi = Math.min(Math.max(Math.floor(cell) as i32, 0), nb - 1);
    const frac = cell - Math.floor(cell);
    if (frac >= 0.14 && frac <= 0.86) {
      const si = Math.min((bi * 32) / nb, 31) as u32;
      const lvl = Math.min(Math.max(vals[si] * gain, 0.02), 1.0);
      const yFromBot = 1.0 - v;
      if (yFromBot <= lvl) {
        a = 1.0;
        gt = Math.min(yFromBot / Math.max(lvl, 0.01), 1.0);
      }
    }
  } else if (style == 1) {
    const pos = u * 63.0;
    const k0 = Math.min(Math.max(Math.floor(pos) as i32, 0), 62);
    const frac = pos - (k0 as f32);
    const s0 = vals[k0 as u32];
    const s1 = vals[(k0 + 1) as u32];
    const sv = (s0 + (s1 - s0) * frac) * gain;
    const cy = 0.5 - sv * 0.44;
    const dist = Math.abs(v - cy) * hf;
    const thick = Math.max(hf * 0.025, 2.2);
    if (dist < thick * 2.5) {
      a = Math.min(Math.max(1.0 - dist / (thick * 2.5), 0.0), 1.0);
      a = a * a;
      if (dist <= thick * 0.6) {
        a = 1.0;
      }
    }
    gt = u;
  } else {
    const dx = px + 0.5 - wf * 0.5;
    const dy = py + 0.5 - hf * 0.5;
    const rad = Math.sqrt(dx * dx + dy * dy);
    const minDim = Math.min(wf, hf);
    const r0 = minDim * 0.24;
    const rMax = minDim * 0.22;
    let ang: f32 = 0.0;
    if (rad > 0.001) {
      const ax = Math.abs(dx);
      const ay = Math.abs(dy);
      let t = 0.0;
      if (ax >= ay) {
        t = ay / ax;
        ang = t * (0.125 - 0.021 * (t - 1.0) * t);
      } else {
        t = ax / ay;
        ang = 0.25 - t * (0.125 - 0.021 * (t - 1.0) * t);
      }
      if (dx < 0.0 && dy >= 0.0) {
        ang = 0.5 - ang;
      } else if (dx < 0.0 && dy < 0.0) {
        ang = 0.5 + ang;
      } else if (dx >= 0.0 && dy < 0.0) {
        ang = 1.0 - ang;
      }
    }
    const nb = Math.max(bars, 8);
    const cell = ang * (nb as f32);
    const bi = Math.min(Math.max(Math.floor(cell) as i32, 0), nb - 1);
    const frac = cell - Math.floor(cell);
    const sym = bi < nb / 2 ? bi * 2 : (nb - 1 - bi) * 2;
    const si = Math.min((sym * 32) / nb, 31) as u32;
    const lvl = Math.min(Math.max(vals[si] * gain, 0.04), 1.0);
    const r1 = r0 + lvl * rMax;
    if (rad >= r0 - 2.0 && rad <= r0 + 1.5) {
      a = 0.9;
      gt = 0.0;
    } else if (rad >= r0 && rad <= r1 && frac >= 0.22 && frac <= 0.78) {
      a = 1.0;
      gt = Math.min((rad - r0) / Math.max(rMax, 1.0), 1.0);
    }
  }
  const col = vec4(
    colA.x + (colB.x - colA.x) * gt,
    colA.y + (colB.y - colA.y) * gt,
    colA.z + (colB.z - colA.z) * gt,
    (colA.w + (colB.w - colA.w) * gt) * a,
  );
  dst[i] = col;
}

function spectrumBoxW(c: Clip, p: Project): i32 {
  if (c.w > 0) {
    return c.w;
  }
  if (c.specStyle == 2) {
    return Math.min(p.width, p.height) * 60 / 100;
  }
  return p.width * 75 / 100;
}

function spectrumBoxH(c: Clip, p: Project): i32 {
  if (c.h > 0) {
    return c.h;
  }
  if (c.specStyle == 2) {
    return Math.min(p.width, p.height) * 60 / 100;
  }
  return p.height * 28 / 100;
}

function fillSpectrumLayer(layer: mut Buffer<vec4<f32>>, c: Clip, p: Project, cache: string, t: f64, w: i32, h: i32, rc: mut RenderCache): bool {
  audioReactPrepare(mut rc.audioReact, p, cache);
  const arf = audioReactAt(rc.audioReact, t);
  let vals = new Buffer<f32>(64);
  if (c.specStyle == 1) {
    for (let k: usize = 0; k < 64; k++) {
      let sv: f32 = 0.0;
      if (k < arf.wave.length) {
        sv = arf.wave[k] as f32;
      }
      vals[k as u32] = sv;
    }
  } else {
    for (let k: usize = 0; k < 32; k++) {
      let bv: f32 = 0.0;
      if (k < arf.bands32.length) {
        bv = arf.bands32[k] as f32;
      }
      vals[k as u32] = bv;
    }
  }
  const colA = colorVec(c.color);
  let colB = colA;
  if (c.color2 != 0) {
    colB = colorVec(c.color2);
  }
  dispatch(spectrumKernel, (w * h) as u32, mut layer, vals, w as u32, h as u32, c.specStyle, c.specBars, c.specGain, colA, colB);
  return true;
}

function drawSpectrum(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, cache: string, idx: usize, t: f64, font: Font, alpha: f32,
  rc: mut RenderCache, reg: FxReg,
): void {
  const w = spectrumBoxW(c, p);
  const h = spectrumBoxH(c, p);
  if (w <= 0 || h <= 0) {
    return;
  }
  const lx = clipPos(c.x, c.xAbs, w, p.width);
  const ly = clipPos(c.y, c.yAbs, h, p.height);
  const n = (w * h) as u32;
  let layer = takeV4(mut rc, n);
  fillSpectrumLayer(mut layer.b, c, p, cache, t, w, h, mut rc);
  if (c.fx.length > 0) {
    fxComposite(mut canvas, mut layer.b, c, p, lx, ly, w, h, alpha, mut rc, reg);
  } else {
    compositeLayer(mut canvas, layer.b, p, lx, ly, w, h, alpha);
  }
  giveV4(mut rc, own layer);
}

// comp の行（プリコンポーズ）。子コンポジションを透明な層に描いて重ねる。
function drawComp(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, cache: string, idx: usize, st: f64, font: Font, alpha: f32,
  rc: mut RenderCache, reg: FxReg,
): void {
  const r = clipLayerRect(c, mediaNone(), p, font, idx, 0.0, mut rc, reg);
  if (!r.ok) {
    return;
  }
  const n = (r.w * r.h) as u32;
  let layer = takeV4(mut rc, n);
  if (!fillClipLayer(mut layer.b, c, mediaNone(), p, cache, idx, st, font, mut rc, emptyFrameCache(), reg)) {
    giveV4(mut rc, own layer);
    return;
  }
  if (c.fx.length > 0) {
    fxComposite(mut canvas, mut layer.b, c, p, r.x, r.y, r.w, r.h, alpha, mut rc, reg);
  } else {
    compositeLayer(mut canvas, layer.b, p, r.x, r.y, r.w, r.h, alpha);
  }
  giveV4(mut rc, own layer);
}

// particles の行。状態は rc.pt がクリップの ID（なければ @行）ごとに持つ。emit=layer なら、layer= のクリップ
// （text / color）の始まりの層を 1 度だけ渡す。効果があれば画面の大きさの層に描いて掛ける（blend=add は加算で重ねる）。
function drawParticles(canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, font: Font, clt: f64, alpha: f32, rc: mut RenderCache, reg: FxReg): void {
  // 粒の計算はクリップの中の時刻（in= で分けた後半も、頭からやり直さずに続きから。粒の数は full= の長さで決める）
  const lt = clipInnerTime(c, clt);
  const idur = clipInnerDur(c);
  let ds: PtDiag[] = [];
  const spec = ptResolveSpec(ptSpecFromKv(c.kv, mut ds), p.width, p.height);
  let key = c.id.clone();
  if (key == "") {
    key = `@${c.line}`;
  }
  const W = p.width as u32;
  const H = p.height as u32;
  if (spec.emit == PT_EMIT_LAYER && ptCacheNeedsLayer(mut rc.pt, key, spec, idur)) {
    const j = findClip(p, spec.layer);
    if (j >= 0 && p.clips[j as usize].kind == KIND_TEXT) {
      const ju = j as usize;
      let lo = textClipLayer(p.clips[ju], p, font, mut rc.text);
      if (p.clips[ju].fontPath != "") {
        let cf = takeFont(mut rc, p.clips[ju].fontPath, p.clips[ju].fontIndex);
        if (cf.f.ok) {
          lo = textClipLayer(p.clips[ju], p, cf.f, mut rc.text);
        }
        giveFont(mut rc, own cf);
      }
      if (lo.w > 0 && lo.h > 0) {
        ptCacheSetLayer(mut rc.pt, key, spec, idur, lo.layer, lo.w as u32, lo.h as u32, lo.x as f32, lo.y as f32);
      }
    } else if (j >= 0 && p.clips[j as usize].kind == KIND_COLOR) {
      const ju = j as usize;
      let w = p.clips[ju].w;
      let h = p.clips[ju].h;
      if (w <= 0) {
        w = p.width;
      }
      if (h <= 0) {
        h = p.height;
      }
      let layer = new Buffer<vec4<f32>>((w * h) as u32);
      dispatch(clearCanvas, (w * h) as u32, mut layer, colorVec(p.clips[ju].color));
      ptCacheSetLayer(mut rc.pt, key, spec, idur, layer, w as u32, h as u32,
        clipPos(p.clips[ju].x, p.clips[ju].xAbs, w, p.width) as f32, clipPos(p.clips[ju].y, p.clips[ju].yAbs, h, p.height) as f32);
    }
  }
  if (c.fx.length == 0) {
    ptCacheDraw(mut rc.pt, key, spec, idur, lt, mut canvas, W, H, alpha);
    return;
  }
  let layer = takeV4(mut rc, W * H);
  ptCacheDrawLayer(mut rc.pt, key, spec, idur, lt, mut layer.b, W, H);
  if (spec.blend == PT_BLEND_ADD) {
    // 加算の粒は、効果を掛けた層を加算で重ねる（ふつうの重ねでは黒い背景の上でしか加算と同じにならない）
    let tmp = takeV4(mut rc, W * H);
    applyClipFxTmpReg(mut layer.b, mut tmp.b, c, W, H, reg);
    giveV4(mut rc, own tmp);
    ptAddLayer(mut canvas, layer.b, W * H, alpha);
  } else {
    fxComposite(mut canvas, mut layer.b, c, p, 0, 0, p.width, p.height, alpha, mut rc, reg);
  }
  giveV4(mut rc, own layer);
}

// shape の行（ベクターの図形）。効果がなければキャンバスに直接描き、あれば層に描いて効果を掛けてから重ねる。
// 層は効果が広がる分（margin）の透明な余白をすでに含むので、fxComposite は余白を足さない（KIND_SHAPE は image / text でない）。
function drawShape(canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, idx: usize, lt: f64, alpha: f32, rc: mut RenderCache, reg: FxReg): void {
  shapeCachesEnsure(mut rc.shape, idx);
  const margin = clipFxReach(c, reg);
  const r = shapePrepareAt(mut rc.shape.items[idx], c.shape, c.x, c.y, c.xAbs, c.yAbs, POS_CENTER, clipInnerTime(c, lt), clipInnerDur(c), p.width, p.height, margin);
  if (r.w <= 0 || r.h <= 0) {
    return;
  }
  if (c.fx.length == 0) {
    shapeDrawDirect(mut canvas, p.width, p.height, alpha, rc.shape.items[idx]);
    return;
  }
  let layer = takeV4(mut rc, (r.w * r.h) as u32);
  shapeRenderLayer(mut layer.b, rc.shape.items[idx]);
  fxComposite(mut canvas, mut layer.b, c, p, r.x, r.y, r.w, r.h, alpha, mut rc, reg);
  giveV4(mut rc, own layer);
}

// ---- エクスプレッション（src/effects/expr/） ----

// 1 つの式の、このコマの値。
struct ExprOut {
  clip: usize;
  key: string;
  v: ExprVal;
}

function exprHas(idx: usize, ov: ExprOut[]): bool {
  for (const o of ov) {
    if (o.clip == idx) {
      return true;
    }
  }
  return false;
}

// 式の値をクリップの写しに入れる。x / y / position は左上の画素（xAbs / yAbs）、opacity は 0〜1 に丸める。
function exprApply(c: mut Clip, idx: usize, ov: ExprOut[], reg: FxReg): void {
  for (const o of ov) {
    if (o.clip != idx) {
      continue;
    }
    if (o.key == "x") {
      c.x = o.v.x;
      c.xAbs = true;
    } else if (o.key == "y") {
      c.y = o.v.x;
      c.yAbs = true;
    } else if (o.key == "position") {
      c.x = o.v.x;
      c.y = o.v.y;
      c.xAbs = true;
      c.yAbs = true;
    } else if (o.key == "opacity") {
      c.opacity = Math.min(Math.max(o.v.x, 0.0), 1.0) as f32;
    } else if (o.key == "rotation") {
      if (c.kind == KIND_SHAPE) {
        c.shape.rotation = o.v.x;
      } else {
        c.d3.tracks[T3L_RZ as usize] = t3TrackConst(o.v.x);
      }
    } else if (o.key == "scale") {
      const sv = Math.max(o.v.x, 0.001);
      if (c.kind == KIND_SHAPE) {
        c.shape.scaleX = sv;
        c.shape.scaleY = sv;
      } else {
        c.d3.tracks[T3L_SCALE as usize] = t3TrackConst2(sv, sv);
      }
    } else if (o.key == "volume") {
      c.volume = Math.min(Math.max(o.v.x, 0.0), 10.0) as f32;
    } else {
      const fk = reg.findKey(o.key);
      if (fk.effect >= 0) {
        let k = fk.param;
        if (k < 0) {
          k = 0;
        }
        for (let s: usize = 0; s < c.fx.length; s++) {
          if (c.fx[s].effect == fk.effect) {
            c.fx[s].params[k as usize] = o.v.x as f32;
          }
        }
      }
    }
  }
}

// このコマの式の値を、評価の順（Project.exprOrder）に求めて ov に入れる。場面の値（ほかのクリップの x / y / w / h /
// opacity / 効果の引数）は、キーフレームを評価した後の値を、解いた後の画素で入れる（式の座標の約束）。
function exprFrame(p: Project, media: MediaSource[], t: f64, font: Font, rc: mut RenderCache, ov: mut ExprOut[], reg: FxReg): void {
  const fps = (p.fpsNum as f64) / (p.fpsDen as f64);
  let sc = exprSceneNew(own exprEnvForReg(reg), p.width as f64, p.height as f64, p.duration, fps);
  const arf = audioReactAt(rc.audioReact, t);
  exprSceneSetAudio(mut sc, arf.level, arf.bass, arf.mid, arf.high, arf.bands16);
  const sx = exprEnvSlot(sc.env, "x");
  const sy = exprEnvSlot(sc.env, "y");
  const sw = exprEnvSlot(sc.env, "w");
  const sh = exprEnvSlot(sc.env, "h");
  const so = exprEnvSlot(sc.env, "opacity");
  const srot = exprEnvSlot(sc.env, "rotation");
  const sscl = exprEnvSlot(sc.env, "scale");
  const sv = exprEnvSlot(sc.env, "volume");
  const si = exprEnvSlot(sc.env, "inPoint");
  const se = exprEnvSlot(sc.env, "outPoint");
  const sd = exprEnvSlot(sc.env, "duration");
  const sn = exprEnvSlot(sc.env, "index");
  for (let i: usize = 0; i < p.clips.length; i++) {
    sc.layers.push(exprLayerNew(p.clips[i].id, sc.env));
    const lt = t - p.clips[i].at;
    const c = clipAt(p.clips[i], lt);
    const li = i as i32;
    const r = clipLayerRect(c, media[i], p, font, i, lt, mut rc, reg);
    if (r.ok) {
      exprScenePut(mut sc, li, sx, exprNum(r.x as f64));
      exprScenePut(mut sc, li, sy, exprNum(r.y as f64));
      exprScenePut(mut sc, li, sw, exprNum(r.w as f64));
      exprScenePut(mut sc, li, sh, exprNum(r.h as f64));
    } else {
      exprScenePut(mut sc, li, sx, exprNum(clipPos(c.x, c.xAbs, 0, p.width) as f64));
      exprScenePut(mut sc, li, sy, exprNum(clipPos(c.y, c.yAbs, 0, p.height) as f64));
    }
    exprScenePut(mut sc, li, so, exprNum(c.opacity as f64));
    if (c.kind == KIND_SHAPE) {
      exprScenePut(mut sc, li, srot, exprNum(c.shape.rotation));
      exprScenePut(mut sc, li, sscl, exprNum(c.shape.scaleX));
    } else {
      exprScenePut(mut sc, li, srot, exprNum(t3TrackEval(c.d3.tracks[T3L_RZ as usize], lt, 0.0)));
      exprScenePut(mut sc, li, sscl, exprNum(t3TrackEvalC(c.d3.tracks[T3L_SCALE as usize], lt, 0, 1.0)));
    }
    exprScenePut(mut sc, li, sv, exprNum(c.volume as f64));
    exprScenePut(mut sc, li, si, exprNum(c.at));
    exprScenePut(mut sc, li, se, exprNum(c.at + c.dur));
    exprScenePut(mut sc, li, sd, exprNum(c.dur));
    exprScenePut(mut sc, li, sn, exprNum((i + 1) as f64));
    for (const u of c.fx) {
      const pc = reg.paramCount(u.effect);
      for (let k = 0; k < pc; k++) {
        if (k == 0) {
          const s0 = exprEnvSlot(sc.env, reg.name(u.effect));
          if (s0 >= 0) {
            exprScenePut(mut sc, li, s0, exprNum(u.params[0] as f64));
          }
        }
        const sk = exprEnvSlot(sc.env, reg.name(u.effect) + "." + reg.paramName(u.effect, k));
        if (sk >= 0) {
          exprScenePut(mut sc, li, sk, exprNum(u.params[k as usize] as f64));
        }
      }
    }
  }
  for (const oi of p.exprOrder) {
    const i = oi as usize;
    const li = p.exprNodes[i].layer as usize;
    let cx = exprCtxNew(t, exprLayerGet(sc.layers[li], p.exprNodes[i].slot), (li + 1) as i32, li as i32);
    // キーフレーム（loopOut / valueAtTime / key(n) が使う）。時刻はタイムラインの秒、値は AnimKey.v の 4 つ
    // （位置は左上の画素、色は 0〜1）。式の値の名前 position はキーフレームの pos
    let animKey = p.exprKeys[i].clone();
    if (animKey == "position") {
      animKey = "pos";
    }
    for (const a of p.clips[li].anims) {
      if (a.key == animKey) {
        for (const k of a.track.keys) {
          let interp = EXPR_KEY_LINEAR;
          if (k.outMode == ANIM_HOLD) {
            interp = EXPR_KEY_HOLD;
          }
          cx.keys.push({ t: p.clips[li].at + k.t, v: { x: k.v[0], y: k.v[1], z: k.v[2], w: k.v[3] }, interp });
        }
        // 値の表（valueAtTime / loopOut / loopIn が引く）: animEval の値をコマの 1/4 ごとに。イーズ・ベジェもキーフレームと同じ値
        const nk = a.track.keys.length;
        if (p.exprProgs[i].usesKeys && nk >= 2 && fps > 0) {
          const k0 = a.track.keys[0].t;
          const dt = 1.0 / (fps * 4.0);
          const n = (Math.ceil((a.track.keys[nk - 1].t - k0) / dt) as i64) + 1;
          let vals: f64[] = [];
          for (let j: i64 = 0; j < n; j++) {
            const v = animEval(a.track, k0 + (j as f64) * dt);
            vals.push(v[0]);
            vals.push(v[1]);
            vals.push(v[2]);
            vals.push(v[3]);
          }
          exprCtxSetCurve(mut cx, p.clips[li].at + k0, dt, own vals);
        }
      }
    }
    const r = exprEvalFull(p.exprProgs[i], cx, sc);
    exprScenePut(mut sc, li as i32, p.exprNodes[i].slot, r.v);
    ov.push({ clip: li, key: p.exprKeys[i].clone(), v: r.v });
  }
}

// ---- 親レイヤー（parent=<ID>） ----

function t3TrackConst2(a: f64, b: f64): T3Track {
  return { dims: 2, ts: [0.0], vs: [a, b], hold: [false], stat: true };
}

// 親レイヤーの連鎖（最大 16 段。輪・欠落があれば止まる）をたどって、子クリップ c の位置・回転・拡大を親に追従させる。
// 子クリップの x / y（shape は pos= があれば posX/posY）は親の中央からの相対位置（center は 0）として扱う。
function applyParent(
  c: mut Clip, idx: usize, p: Project, media: MediaSource[], font: Font, t: f64, lt: f64, ov: ExprOut[],
  rc: mut RenderCache, reg: FxReg,
): void {
  let chain: usize[] = [];
  let curPid = c.parent.clone();
  let guard = 0;
  while (curPid != "" && guard < 16) {
    guard++;
    const pi = findClip(p, curPid);
    if (pi < 0) {
      break;
    }
    const pu = pi as usize;
    if (pu == idx) {
      break;
    }
    let dup = false;
    for (const prev of chain) {
      if (prev == pu) {
        dup = true;
      }
    }
    if (dup) {
      break;
    }
    chain.push(pu);
    curPid = p.clips[pu].parent.clone();
  }
  if (chain.length == 0) {
    return;
  }
  // 根（一番上の親）から順に合成する
  let wCx = 0.0;
  let wCy = 0.0;
  let wZ = 0.0;
  let wRx = 0.0;
  let wRy = 0.0;
  let wRot = 0.0;
  let wSx = 1.0;
  let wSy = 1.0;
  let k = chain.length;
  while (k > 0) {
    k--;
    const ai = chain[k];
    const alt = t - p.clips[ai].at;
    let ac = clipAt(p.clips[ai], alt);
    exprApply(mut ac, ai, ov, reg);
    const isRoot = k == chain.length - 1;
    if (isRoot) {
      if (ac.kind == KIND_SHAPE) {
        const pl = shapePlaceAt(ac.shape, ac.x, ac.y, ac.xAbs, ac.yAbs, p.width, p.height, POS_CENTER);
        wCx = pl.x;
        wCy = pl.y;
        wRot = ac.shape.rotation;
        wSx = ac.shape.scaleX;
        wSy = ac.shape.scaleY;
      } else {
        const r = clipLayerRect(ac, media[ai], p, font, ai, alt, mut rc, reg);
        if (r.ok) {
          wCx = (r.x as f64) + (r.w as f64) / 2.0;
          wCy = (r.y as f64) + (r.h as f64) / 2.0;
        } else {
          wCx = clipPos(ac.x, ac.xAbs, 0, p.width) as f64;
          wCy = clipPos(ac.y, ac.yAbs, 0, p.height) as f64;
        }
        wCx = wCx + t3TrackEval(ac.d3.tracks[T3L_OX as usize], alt, 0.0);
        wCy = wCy + t3TrackEval(ac.d3.tracks[T3L_OY as usize], alt, 0.0);
        wZ = t3TrackEval(ac.d3.tracks[T3L_Z as usize], alt, 0.0);
        wRx = t3TrackEval(ac.d3.tracks[T3L_RX as usize], alt, 0.0);
        wRy = t3TrackEval(ac.d3.tracks[T3L_RY as usize], alt, 0.0);
        wRot = t3TrackEval(ac.d3.tracks[T3L_RZ as usize], alt, 0.0);
        wSx = t3TrackEvalC(ac.d3.tracks[T3L_SCALE as usize], alt, 0, 1.0);
        wSy = t3TrackEvalC(ac.d3.tracks[T3L_SCALE as usize], alt, 1, 1.0);
      }
    } else {
      let lx = 0.0;
      let ly = 0.0;
      let lZ = 0.0;
      let lRx = 0.0;
      let lRy = 0.0;
      let lRot = 0.0;
      let lSx = 1.0;
      let lSy = 1.0;
      if (ac.kind == KIND_SHAPE) {
        if (ac.shape.posSet) {
          lx = ac.shape.posX;
          ly = ac.shape.posY;
        } else {
          if (ac.x != POS_CENTER) {
            lx = ac.x;
          }
          if (ac.y != POS_CENTER) {
            ly = ac.y;
          }
        }
        lRot = ac.shape.rotation;
        lSx = ac.shape.scaleX;
        lSy = ac.shape.scaleY;
      } else {
        if (ac.x != POS_CENTER) {
          lx = ac.x;
        }
        if (ac.y != POS_CENTER) {
          ly = ac.y;
        }
        lx = lx + t3TrackEval(ac.d3.tracks[T3L_OX as usize], alt, 0.0);
        ly = ly + t3TrackEval(ac.d3.tracks[T3L_OY as usize], alt, 0.0);
        lZ = t3TrackEval(ac.d3.tracks[T3L_Z as usize], alt, 0.0);
        lRx = t3TrackEval(ac.d3.tracks[T3L_RX as usize], alt, 0.0);
        lRy = t3TrackEval(ac.d3.tracks[T3L_RY as usize], alt, 0.0);
        lRot = t3TrackEval(ac.d3.tracks[T3L_RZ as usize], alt, 0.0);
        lSx = t3TrackEvalC(ac.d3.tracks[T3L_SCALE as usize], alt, 0, 1.0);
        lSy = t3TrackEvalC(ac.d3.tracks[T3L_SCALE as usize], alt, 1, 1.0);
      }
      const cs = t3CosDeg(wRot);
      const sn = t3SinDeg(wRot);
      const dx = lx * wSx;
      const dy = ly * wSy;
      wCx = wCx + cs * dx - sn * dy;
      wCy = wCy + sn * dx + cs * dy;
      wZ = wZ + lZ;
      wRx = wRx + lRx;
      wRy = wRy + lRy;
      wRot = wRot + lRot;
      wSx = wSx * lSx;
      wSy = wSy * lSy;
    }
  }
  // 子クリップ c に合成した親の変形を掛ける
  const cs = t3CosDeg(wRot);
  const sn = t3SinDeg(wRot);
  if (c.kind == KIND_SHAPE) {
    let lx = 0.0;
    let ly = 0.0;
    if (c.shape.posSet) {
      lx = c.shape.posX;
      ly = c.shape.posY;
    } else {
      if (c.x != POS_CENTER) {
        lx = c.x;
      }
      if (c.y != POS_CENTER) {
        ly = c.y;
      }
    }
    const dx = lx * wSx;
    const dy = ly * wSy;
    c.shape.posSet = true;
    c.shape.posX = wCx + cs * dx - sn * dy;
    c.shape.posY = wCy + sn * dx + cs * dy;
    c.shape.rotation = c.shape.rotation + wRot;
    c.shape.scaleX = c.shape.scaleX * wSx;
    c.shape.scaleY = c.shape.scaleY * wSy;
    return;
  }
  const r = clipLayerRect(c, media[idx], p, font, idx, lt, mut rc, reg);
  if (!r.ok) {
    return;
  }
  let lx = 0.0;
  let ly = 0.0;
  if (c.x != POS_CENTER) {
    lx = c.x;
  }
  if (c.y != POS_CENTER) {
    ly = c.y;
  }
  lx = lx + t3TrackEval(c.d3.tracks[T3L_OX as usize], lt, 0.0);
  ly = ly + t3TrackEval(c.d3.tracks[T3L_OY as usize], lt, 0.0);
  const dx = lx * wSx;
  const dy = ly * wSy;
  const cx = wCx + cs * dx - sn * dy;
  const cy = wCy + sn * dx + cs * dy;
  c.x = cx - (r.w as f64) / 2.0;
  c.y = cy - (r.h as f64) / 2.0;
  c.xAbs = true;
  c.yAbs = true;
  if (c.d3.tracks[T3L_OX as usize].ts.length > 0) {
    c.d3.tracks[T3L_OX as usize] = t3TrackConst(0.0);
  }
  if (c.d3.tracks[T3L_OY as usize].ts.length > 0) {
    c.d3.tracks[T3L_OY as usize] = t3TrackConst(0.0);
  }
  const cRot = t3TrackEval(c.d3.tracks[T3L_RZ as usize], lt, 0.0) + wRot;
  const cSx = t3TrackEvalC(c.d3.tracks[T3L_SCALE as usize], lt, 0, 1.0) * wSx;
  const cSy = t3TrackEvalC(c.d3.tracks[T3L_SCALE as usize], lt, 1, 1.0) * wSy;
  if (cRot != 0.0 || c.d3.tracks[T3L_RZ as usize].ts.length > 0) {
    c.d3.tracks[T3L_RZ as usize] = t3TrackConst(cRot);
  }
  if (cSx != 1.0 || cSy != 1.0 || c.d3.tracks[T3L_SCALE as usize].ts.length > 0) {
    c.d3.tracks[T3L_SCALE as usize] = t3TrackConst2(cSx, cSy);
  }
  if (c.d3.is3d) {
    const cZ = t3TrackEval(c.d3.tracks[T3L_Z as usize], lt, 0.0) + wZ;
    const cRx = t3TrackEval(c.d3.tracks[T3L_RX as usize], lt, 0.0) + wRx;
    const cRy = t3TrackEval(c.d3.tracks[T3L_RY as usize], lt, 0.0) + wRy;
    c.d3.tracks[T3L_Z as usize] = t3TrackConst(cZ);
    c.d3.tracks[T3L_RX as usize] = t3TrackConst(cRx);
    c.d3.tracks[T3L_RY as usize] = t3TrackConst(cRy);
  }
}

// ---- 3D レイヤー（src/effects/threed/） ----

// 3D のクリップの層（マスク・効果を掛けたもの）をアトラスに入れ、T3Layer を layers に足す。描くものがなければ何もしない。
function put3dLayer(
  layers: mut T3Layer[], c: Clip, p: Project, media: MediaSource[], cache: string, idx: usize, lt: f64, st: f64, font: Font,
  rc: mut RenderCache, fc: FrameCache, reg: FxReg,
): void {
  const alpha = (envelope(lt, c.dur, c.fadeIn, c.fadeOut) as f32) * c.opacity;
  if (alpha <= 0) {
    return;
  }
  const r = clipLayerRect(c, media[idx], p, font, idx, lt, mut rc, reg);
  if (!r.ok) {
    return;
  }
  const n = (r.w * r.h) as u32;
  let layer = takeV4(mut rc, n);
  if (!fillClipLayer(mut layer.b, c, media[idx], p, cache, idx, st, font, mut rc, fc, reg)) {
    giveV4(mut rc, own layer);
    return;
  }
  if (c.masks.length > 0) {
    while (rc.masks.length <= idx) {
      rc.masks.push(mblNewMaskCache());
    }
    if (mblBuildMaskCached(mut rc.masks[idx], c.masks, r.w, r.h)) {
      dispatch(mblApplyMask, n, mut layer.b, rc.masks[idx].mask);
    }
  }
  const pad = clipFxReach(c, reg);
  if (c.fx.length > 0 && pad > 0 && (c.kind == KIND_IMAGE || c.kind == KIND_TEXT || c.kind == KIND_COMP)) {
    // 透明なまわりのある層は、効果が広がる分の余白を足して掛ける（中央は変わらない）
    const pw = r.w + 2 * pad;
    const ph = r.h + 2 * pad;
    const pn = (pw * ph) as u32;
    let big = takeV4(mut rc, pn);
    let tmp = takeV4(mut rc, pn);
    dispatch(padCopy, pn, mut big.b, layer.b, pw as u32, r.w, r.h, pad);
    applyClipFxTmpReg(mut big.b, mut tmp.b, c, pw as u32, ph as u32, reg);
    const slot = t3AtlasPut(mut rc.t3atlas, big.b, pw, ph);
    giveV4(mut rc, own big);
    giveV4(mut rc, own tmp);
    layers.push({ slot, spec: copyLayer3d(c.d3), baseX: (r.x as f64) + (r.w as f64) / 2, baseY: (r.y as f64) + (r.h as f64) / 2, start: c.at, alpha });
  } else {
    if (c.fx.length > 0) {
      let tmp = takeV4(mut rc, n);
      applyClipFxTmpReg(mut layer.b, mut tmp.b, c, r.w as u32, r.h as u32, reg);
      giveV4(mut rc, own tmp);
    }
    const slot = t3AtlasPut(mut rc.t3atlas, layer.b, r.w, r.h);
    layers.push({ slot, spec: copyLayer3d(c.d3), baseX: (r.x as f64) + (r.w as f64) / 2, baseY: (r.y as f64) + (r.h as f64) / 2, start: c.at, alpha });
  }
  giveV4(mut rc, own layer);
}

// model の行の .obj を読む（読んだものは rc に置いて使い回す）。rc.meshes の番号を返す。読めなくても置く（ok が false）。
function rcMesh(rc: mut RenderCache, path: string): i32 {
  for (let k: usize = 0; k < rc.meshPaths.length; k++) {
    if (rc.meshPaths[k] == path) {
      return k as i32;
    }
  }
  rc.meshes.push(loadObjMesh(path));
  rc.meshPaths.push(path.clone());
  return (rc.meshes.length - 1) as i32;
}

// .obj のファイルを読む。
export function loadObjMesh(path: string): T3Mesh {
  const b = readFile(path);
  if (b == null) {
    return { ok: false, err: `'${path}' を読めません`, pos: [], idx: [], nrm: [], ntri: 0 };
  }
  return t3ObjParse(b);
}

// model の行のファイルの場所（相対ならプロジェクトのフォルダから）。
export function modelPath(cache: string, c: Clip): string {
  return gradeLutPath(cache, c.src);
}

// model の行を 3D の組に足す。
function put3dModel(models: mut T3Model[], c: Clip, p: Project, cache: string, lt: f64, rc: mut RenderCache): void {
  const alpha = (envelope(lt, c.dur, c.fadeIn, c.fadeOut) as f32) * c.opacity;
  if (alpha <= 0) {
    return;
  }
  const mi = rcMesh(mut rc, modelPath(cache, c));
  if (!rc.meshes[mi as usize].ok) {
    return;
  }
  let size = c.size as f64;
  if (size <= 0) {
    size = (Math.min(p.width, p.height) as f64) / 2.0;
  }
  const sz = Math.max(Math.floor(size + 0.5) as i32, 1);
  const x = clipPos(c.x, c.xAbs, sz, p.width) as f64;
  const y = clipPos(c.y, c.yAbs, sz, p.height) as f64;
  models.push({
    mesh: mi, spec: copyLayer3d(c.d3), baseX: x + (sz as f64) / 2.0, baseY: y + (sz as f64) / 2.0, start: c.at, alpha,
    color: c.color, size,
  });
}

// 集めた 3D のレイヤーとモデルの組を、project のカメラ・ライトで重ねて空にする。
function flush3d(canvas: mut Buffer<vec4<f32>>, layers: mut T3Layer[], models: mut T3Model[], p: Project, t: f64, rc: mut RenderCache): void {
  if (layers.length == 0 && models.length == 0) {
    return;
  }
  if (rc.t3work.length == 0) {
    rc.t3work.push(t3WorkNew());
  }
  let work = rc.t3work.pop();
  const fps = (p.fpsNum as f64) / (p.fpsDen as f64);
  t3RenderModels(mut canvas, { spec: copyScene3d(p.scene3d), cw: p.width, ch: p.height, fps }, layers, models, rc.meshes, rc.t3atlas, mut work, t);
  rc.t3work.push(work);
  while (layers.length > 0) {
    layers.pop();
  }
  while (models.length > 0) {
    models.pop();
  }
}

// ---- 描画モード・マスク・トラックマット（src/effects/blend/） ----

// id がほかのクリップの matte= に使われているか（マットの元は画面に描かない）。
function isMatteSource(p: Project, id: string): bool {
  for (const c of p.clips) {
    if (c.blend.matte == id) {
      return true;
    }
  }
  return false;
}

struct LayerRect {
  ok: bool;
  x: i32;
  y: i32;
  w: i32;
  h: i32;
}

// クリップの層（効果の前の素材の絵）の置き場所と大きさ。shape の層は効果の広がる分の余白を含む。
function clipLayerRect(c: Clip, m: MediaSource, p: Project, font: Font, idx: usize, lt: f64, rc: mut RenderCache, reg: FxReg): LayerRect {
  const kind = c.kind;
  if (kind == KIND_SHAPE) {
    shapeCachesEnsure(mut rc.shape, idx);
    const r = shapePrepareAt(mut rc.shape.items[idx], c.shape, c.x, c.y, c.xAbs, c.yAbs, POS_CENTER, clipInnerTime(c, lt), clipInnerDur(c), p.width, p.height,
      clipFxReach(c, reg));
    return { ok: r.w > 0 && r.h > 0, x: r.x, y: r.y, w: r.w, h: r.h };
  }
  if (kind == KIND_VIDEO || kind == KIND_IMAGE) {
    if (!m.ok) {
      return { ok: false, x: 0, y: 0, w: 0, h: 0 };
    }
    return { ok: true, x: clipPos(c.x, c.xAbs, m.w, p.width), y: clipPos(c.y, c.yAbs, m.h, p.height), w: m.w, h: m.h };
  }
  if (kind == KIND_COLOR) {
    let w = c.w;
    let h = c.h;
    if (w <= 0) {
      w = p.width;
    }
    if (h <= 0) {
      h = p.height;
    }
    return { ok: true, x: clipPos(c.x, c.xAbs, w, p.width), y: clipPos(c.y, c.yAbs, h, p.height), w, h };
  }
  if (kind == KIND_TEXT) {
    if (c.fontPath != "") {
      let cf = takeFont(mut rc, c.fontPath, c.fontIndex);
      if (cf.f.ok) {
        const r = textClipRect(c, p, cf.f, mut rc.text);
        giveFont(mut rc, own cf);
        return { ok: r.w > 0 && r.h > 0, x: r.x, y: r.y, w: r.w, h: r.h };
      }
      giveFont(mut rc, own cf);
    }
    const r = textClipRect(c, p, font, mut rc.text);
    return { ok: r.w > 0 && r.h > 0, x: r.x, y: r.y, w: r.w, h: r.h };
  }
  if (kind == KIND_COMP) {
    if (rc.compDepth >= RC_COMP_MAX_DEPTH) {
      return { ok: false, x: 0, y: 0, w: 0, h: 0 };
    }
    const path = clipCompPath(c);
    if (path == "") {
      return { ok: false, x: 0, y: 0, w: 0, h: 0 };
    }
    let ce = takeComp(mut rc, path, "", reg);
    const ok = ce.ok;
    const w = ce.proj.width;
    const h = ce.proj.height;
    giveComp(mut rc, own ce);
    if (!ok || w <= 0 || h <= 0) {
      return { ok: false, x: 0, y: 0, w: 0, h: 0 };
    }
    return { ok: true, x: clipPos(c.x, c.xAbs, w, p.width), y: clipPos(c.y, c.yAbs, h, p.height), w, h };
  }
  if (kind == KIND_SPECTRUM) {
    const w = spectrumBoxW(c, p);
    const h = spectrumBoxH(c, p);
    return { ok: w > 0 && h > 0, x: clipPos(c.x, c.xAbs, w, p.width), y: clipPos(c.y, c.yAbs, h, p.height), w, h };
  }
  return { ok: false, x: 0, y: 0, w: 0, h: 0 };
}

// クリップの層を layer（clipLayerRect の大きさ）に描く。読めなければ false。
function fillClipLayer(
  layer: mut Buffer<vec4<f32>>, c: Clip, m: MediaSource, p: Project, cache: string, idx: usize, st: f64, font: Font,
  rc: mut RenderCache, fc: FrameCache, reg: FxReg,
): bool {
  const kind = c.kind;
  if (kind == KIND_VIDEO) {
    let yuv = takeU8(mut rc, m.frameBytes as u32);
    const ok = readVideoYuv(mut yuv.b, c, m, p, cache, idx, st, fc);
    if (ok) {
      dispatch(yuvToLayer, layer.length, mut layer, yuv.b, m.w as u32, m.h as u32, mediaYuvK1(m), mediaYuvK2(m));
    }
    giveU8(mut rc, own yuv);
    if (ok) {
      // 色の調整は層を作るときに掛ける（マスク・効果・描画モードより先。drawVideo / drawImage と同じ順）
      gradeLayer(mut layer, layer.length, c, cache, mut rc.grade);
    }
    return ok;
  }
  if (kind == KIND_IMAGE) {
    const n = (m.w * m.h) as u32;
    let px = takeU8(mut rc, n * 4);
    if (!mediaReadFrame(m, 0, mut px.b)) {
      giveU8(mut rc, own px);
      return false;
    }
    dispatch(rgbaToLayer, n, mut layer, px.b);
    giveU8(mut rc, own px);
    gradeLayer(mut layer, n, c, cache, mut rc.grade);
    return true;
  }
  if (kind == KIND_COLOR) {
    dispatch(clearCanvas, layer.length, mut layer, colorVec(c.color));
    return true;
  }
  if (kind == KIND_TEXT) {
    if (c.fontPath != "") {
      let cf = takeFont(mut rc, c.fontPath, c.fontIndex);
      if (cf.f.ok) {
        textClipDrawLayer(mut layer, c, p, cf.f, mut rc.text);
        giveFont(mut rc, own cf);
        return true;
      }
      giveFont(mut rc, own cf);
    }
    textClipDrawLayer(mut layer, c, p, font, mut rc.text);
    return true;
  }
  if (kind == KIND_SHAPE) {
    // clipLayerRect の shapePrepareAt で準備した形
    shapeRenderLayer(mut layer, rc.shape.items[idx]);
    return true;
  }
  if (kind == KIND_COMP) {
    if (rc.compDepth >= RC_COMP_MAX_DEPTH) {
      dispatch(clearCanvas, layer.length, mut layer, vec4(0.0, 0.0, 0.0, 0.0));
      return true;
    }
    const path = clipCompPath(c);
    if (path == "") {
      return false;
    }
    // 子の効果も親と同じ登録表（.mzplug を含む）で引く
    let ce = takeComp(mut rc, path, cache, reg);
    if (!ce.ok || (ce.proj.width * ce.proj.height) as u32 != layer.length) {
      giveComp(mut rc, own ce);
      return false;
    }
    let subRc = newSubRenderCache(rc.compDepth + 1);
    renderFrameFromReg(ce.proj, ce.media, cache, st, mut layer, font, mut subRc, emptyFrameCache(), reg);
    releaseCompEntries(mut subRc.comps);
    giveComp(mut rc, own ce);
    return true;
  }
  if (kind == KIND_SPECTRUM) {
    const w = spectrumBoxW(c, p);
    const h = spectrumBoxH(c, p);
    if ((w * h) as u32 != layer.length) {
      return false;
    }
    return fillSpectrumLayer(mut layer, c, p, cache, c.at + st, w, h, mut rc);
  }
  return false;
}

// クリップの層を作り、マスク（効果より前。After Effects と同じ）→ 効果 → 描画モードで dst に重ねる。
// matte はキャンバスの大きさのマット（flags に MBL_USE_MATTE を立てたときだけ使う）。
function blendClipOnto(
  dst: mut Buffer<vec4<f32>>, c: Clip, idx: usize, p: Project, media: MediaSource[], cache: string, lt: f64, st: f64, font: Font,
  alpha: f32, mode: u32, space: u32, matte: Buffer<f32>, flags: u32, rc: mut RenderCache, fc: FrameCache, reg: FxReg,
): void {
  const xf = clipXf2dOn(c, lt);
  if (xf && c.kind == KIND_TEXT && taClipAnimated(c)) {
    blendAnimTextXf(mut dst, c, idx, p, font, lt, alpha, mode, space, matte, flags, mut rc, reg);
    return;
  }
  const r = clipLayerRect(c, media[idx], p, font, idx, lt, mut rc, reg);
  if (!r.ok) {
    return;
  }
  const n = (r.w * r.h) as u32;
  let layer = takeV4(mut rc, n);
  if (!fillClipLayer(mut layer.b, c, media[idx], p, cache, idx, st, font, mut rc, fc, reg)) {
    giveV4(mut rc, own layer);
    return;
  }
  if (c.masks.length > 0) {
    while (rc.masks.length <= idx) {
      rc.masks.push(mblNewMaskCache());
    }
    if (mblBuildMaskCached(mut rc.masks[idx], c.masks, r.w, r.h)) {
      dispatch(mblApplyMask, n, mut layer.b, rc.masks[idx].mask);
    }
  }
  // 2D の変形の中心は、変形の前の層（効果の余白を除く）の中央
  const pcx = (r.x as f64) + (r.w as f64) / 2.0;
  const pcy = (r.y as f64) + (r.h as f64) / 2.0;
  const pad = clipFxReach(c, reg);
  if (c.fx.length > 0 && pad > 0 && (c.kind == KIND_IMAGE || c.kind == KIND_TEXT || c.kind == KIND_COMP)) {
    // 透明なまわりのある層は、効果が広がる分の余白を足して掛ける（fxComposite と同じ）
    const pw = r.w + 2 * pad;
    const ph = r.h + 2 * pad;
    const pn = (pw * ph) as u32;
    let big = takeV4(mut rc, pn);
    let tmp = takeV4(mut rc, pn);
    dispatch(padCopy, pn, mut big.b, layer.b, pw as u32, r.w, r.h, pad);
    applyClipFxTmpReg(mut big.b, mut tmp.b, c, pw as u32, ph as u32, reg);
    blendLayerXf(mut dst, big.b, c, p, lt, xf, r.x - pad, r.y - pad, pw, ph, pcx, pcy, alpha, mode, space, matte, flags, mut rc);
    giveV4(mut rc, own big);
    giveV4(mut rc, own tmp);
  } else {
    if (c.fx.length > 0) {
      let tmp = takeV4(mut rc, n);
      applyClipFxTmpReg(mut layer.b, mut tmp.b, c, r.w as u32, r.h as u32, reg);
      giveV4(mut rc, own tmp);
    }
    blendLayerXf(mut dst, layer.b, c, p, lt, xf, r.x, r.y, r.w, r.h, pcx, pcy, alpha, mode, space, matte, flags, mut rc);
  }
  giveV4(mut rc, own layer);
}

// ---- 2D の変形（src/effects/xform/） ----

// 2D の変形を掛けて描くクリップか（video / image / text / color で rotation / scale / anchor を書き、
// 時刻 lt の値が何かを変える）。値が既定のままのコマは、変形のない経路で描く（同じ絵で速い）。
function clipXf2dOn(c: Clip, lt: f64): bool {
  const k = c.kind;
  if (k != KIND_VIDEO && k != KIND_IMAGE && k != KIND_TEXT && k != KIND_COLOR && k != KIND_COMP && k != KIND_SPECTRUM) {
    return false;
  }
  if (c.d3.is3d || !xf2dUsed(c.d3)) {
    return false;
  }
  return !xf2dIdentity(xf2dAt(c.d3, lt));
}

// 層（(lx, ly) から lw × lh）を、xf なら 2D の変形を掛けてから描画モードで dst に重ねる。(pcx, pcy) は変形の中心。
function blendLayerXf(
  dst: mut Buffer<vec4<f32>>, layer: Buffer<vec4<f32>>, c: Clip, p: Project, lt: f64, xf: bool,
  lx: i32, ly: i32, lw: i32, lh: i32, pcx: f64, pcy: f64,
  alpha: f32, mode: u32, space: u32, matte: Buffer<f32>, flags: u32, rc: mut RenderCache,
): void {
  const none = mblNoMap();
  if (!xf) {
    mblCompositeLayer(mut dst, layer, none, matte, rc.blendLut, p.width, p.height, lx, ly, lw, lh, alpha, mode, space, flags);
    return;
  }
  const plan = xf2dPlan(xf2dAt(c.d3, lt), lx, ly, lw, lh, pcx, pcy, p.width, p.height);
  if (!plan.ok) {
    return;
  }
  let out = takeV4(mut rc, (plan.w * plan.h) as u32);
  xf2dWarpLayer(mut out.b, layer, lw, lh, plan);
  mblCompositeLayer(mut dst, out.b, none, matte, rc.blendLut, p.width, p.height, plan.x, plan.y, plan.w, plan.h, alpha, mode, space, flags);
  giveV4(mut rc, own out);
}

// テキストアニメーターのある文字に 2D の変形を掛けて重ねる。字ごとに動かした層（効果も掛ける）を、
// 動かす前の文字の四角の中央を中心に変形する（字の動きで中心がずれないように）。マスクは字の層の大きさで掛ける。
function blendAnimTextXfWithFont(
  dst: mut Buffer<vec4<f32>>, c: Clip, idx: usize, p: Project, font: Font, lt: f64,
  alpha: f32, mode: u32, space: u32, matte: Buffer<f32>, flags: u32, rc: mut RenderCache, reg: FxReg,
): void {
  const base = textClipRect(c, p, font, mut rc.text);
  if (base.w <= 0 || base.h <= 0) {
    return;
  }
  const pcx = (base.x as f64) + (base.w as f64) / 2.0;
  const pcy = (base.y as f64) + (base.h as f64) / 2.0;
  let st = taStyleFromClip(c);
  st.dur = clipInnerDur(c);
  let lo = taRenderLayer(p.width, p.height, st, taClipSpec(c, p), font, clipInnerTime(c, lt), mut rc.ta);
  if (lo.w <= 0 || lo.h <= 0) {
    return;
  }
  const n = (lo.w * lo.h) as u32;
  if (c.masks.length > 0) {
    while (rc.masks.length <= idx) {
      rc.masks.push(mblNewMaskCache());
    }
    if (mblBuildMaskCached(mut rc.masks[idx], c.masks, lo.w, lo.h)) {
      dispatch(mblApplyMask, n, mut lo.layer, rc.masks[idx].mask);
    }
  }
  const pad = clipFxReach(c, reg);
  if (c.fx.length > 0 && pad > 0) {
    const pw = lo.w + 2 * pad;
    const ph = lo.h + 2 * pad;
    const pn = (pw * ph) as u32;
    let big = takeV4(mut rc, pn);
    let tmp = takeV4(mut rc, pn);
    dispatch(padCopy, pn, mut big.b, lo.layer, pw as u32, lo.w, lo.h, pad);
    applyClipFxTmpReg(mut big.b, mut tmp.b, c, pw as u32, ph as u32, reg);
    blendLayerXf(mut dst, big.b, c, p, lt, true, lo.x - pad, lo.y - pad, pw, ph, pcx, pcy, alpha, mode, space, matte, flags, mut rc);
    giveV4(mut rc, own big);
    giveV4(mut rc, own tmp);
    return;
  }
  if (c.fx.length > 0) {
    let tmp = takeV4(mut rc, n);
    applyClipFxTmpReg(mut lo.layer, mut tmp.b, c, lo.w as u32, lo.h as u32, reg);
    giveV4(mut rc, own tmp);
  }
  blendLayerXf(mut dst, lo.layer, c, p, lt, true, lo.x, lo.y, lo.w, lo.h, pcx, pcy, alpha, mode, space, matte, flags, mut rc);
}

function blendAnimTextXf(
  dst: mut Buffer<vec4<f32>>, c: Clip, idx: usize, p: Project, font: Font, lt: f64,
  alpha: f32, mode: u32, space: u32, matte: Buffer<f32>, flags: u32, rc: mut RenderCache, reg: FxReg,
): void {
  if (c.fontPath != "") {
    let cf = takeFont(mut rc, c.fontPath, c.fontIndex);
    if (cf.f.ok) {
      blendAnimTextXfWithFont(mut dst, c, idx, p, cf.f, lt, alpha, mode, space, matte, flags, mut rc, reg);
    } else {
      blendAnimTextXfWithFont(mut dst, c, idx, p, font, lt, alpha, mode, space, matte, flags, mut rc, reg);
    }
    giveFont(mut rc, own cf);
    return;
  }
  blendAnimTextXfWithFont(mut dst, c, idx, p, font, lt, alpha, mode, space, matte, flags, mut rc, reg);
}

// 描画モード・マスク・トラックマットのあるクリップを描く。マットがあれば、先にマットの元をキャンバスの大きさの
// 透明な下地に描いてマットにする（元がその時刻になければマットは 0、反転なら 1）。キャンバスに重ねるときは
// いつも MBL_DST_OPAQUE（bg が透明でも blendOver と同じ式）。
function drawBlended(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, media: MediaSource[], cache: string, idx: usize, t: f64, st: f64,
  font: Font, alpha: f32, rc: mut RenderCache, fc: FrameCache, reg: FxReg,
): void {
  const lt = t - c.at;
  if (c.blend.matte == "") {
    const none = mblNoMap();
    blendClipOnto(mut canvas, c, idx, p, media, cache, lt, st, font, alpha, c.blend.mode, c.blend.space, none, MBL_DST_OPAQUE, mut rc, fc, reg);
    return;
  }
  const n = (p.width * p.height) as u32;
  let mc = takeV4(mut rc, n);
  mblClearTransparent(mut mc.b);
  const j = findClip(p, c.blend.matte);
  if (j >= 0) {
    const ju = j as usize;
    const lts = t - p.clips[ju].at;
    if (lts >= 0 && lts < p.clips[ju].dur) {
      const s = clipAt(p.clips[ju], lts);
      const sst = clipSourceTime(p.clips[ju], lts);
      const alphaS = (envelope(lts, s.dur, s.fadeIn, s.fadeOut) as f32) * s.opacity;
      if (alphaS > 0) {
        const none = mblNoMap();
        blendClipOnto(mut mc.b, s, ju, p, media, cache, lts, sst, font, alphaS, MBL_NORMAL, MBL_SPACE_DISPLAY, none, 0, mut rc, fc, reg);
      }
    }
  }
  let matte = new Buffer<f32>(n);
  mblMatteFrom(mut matte, mc.b, c.blend.matteKind, c.blend.matteInvert);
  giveV4(mut rc, own mc);
  blendClipOnto(mut canvas, c, idx, p, media, cache, lt, st, font, alpha, c.blend.mode, c.blend.space, matte,
    MBL_DST_OPAQUE | MBL_USE_MATTE, mut rc, fc, reg);
}

export function canvasToYuv(canvas: Buffer<vec4<f32>>, out: mut Buffer<u8>, w: i32, h: i32): void {
  dispatch(toYuv, out.length, mut out, canvas, w as u32, h as u32);
}

function push32(out: mut u8[], v: u32): void {
  out.push((v & 255) as u8);
  out.push(((v >> 8) & 255) as u8);
  out.push(((v >> 16) & 255) as u8);
  out.push(((v >> 24) & 255) as u8);
}

function byteOf(v: f32): u8 {
  return (Math.min(Math.max(v * 255 + 0.5, 0.0), 255.0) as i32) as u8;
}

// キャンバスを 24 ビットの BMP に書く（プレビュー用）。
export function writeBmp(path: string, canvas: Buffer<vec4<f32>>, w: i32, h: i32): bool {
  const rowBytes = ((w * 3 + 3) / 4) * 4;
  const dataBytes = (rowBytes * h) as u32;
  let out: u8[] = [66, 77];
  push32(mut out, 54 + dataBytes);
  push32(mut out, 0);
  push32(mut out, 54);
  push32(mut out, 40);
  push32(mut out, w as u32);
  push32(mut out, h as u32);
  out.push(1);
  out.push(0);
  out.push(24);
  out.push(0);
  push32(mut out, 0);
  push32(mut out, dataBytes);
  push32(mut out, 2835);
  push32(mut out, 2835);
  push32(mut out, 0);
  push32(mut out, 0);
  for (let y = h - 1; y >= 0; y--) {
    for (let x = 0; x < w; x++) {
      const c = canvas[(y * w + x) as u32];
      out.push(byteOf(c.z));
      out.push(byteOf(c.y));
      out.push(byteOf(c.x));
    }
    for (let k = w * 3; k < rowBytes; k++) {
      out.push(0);
    }
  }
  return writeFile(path, out);
}
