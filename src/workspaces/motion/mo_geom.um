// モニターの上の部品（変形のギズモ、点の編集）が使う、クリップの置き場所の計算。
// render.um と同じ規則（clipAt で時刻の値にしてから、shape は shapePlaceAt、ほかは clipPos）で求める。
// video / image / text / color の 2D の変形（rotation / scale / anchor。m6_xform/xform2d.um）も、shape と同じ形の MoXf にする。
import { Project, Clip, KIND_SHAPE, KIND_COLOR, KIND_TEXT, KIND_AUDIO, KIND_VIDEO, KIND_IMAGE, POS_CENTER, clipPos } from "../../engine/project.um";
import { clipAt } from "../../engine/render.um";
import { shapePlaceAt } from "../../effects/shape/shape.um";
import { shapeLocalBox } from "../../effects/shape/shape_geom.um";
import { shSin, shCos, shAtan2 } from "../../effects/shape/shape_math.um";
import { SH_PAINT_NONE } from "../../effects/shape/shape_spec.um";
import { xf2dAt } from "../../effects/xform/xform2d.um";

export const MO_PI: f64 = 3.141592653589793;

// クリップの変形: 形の中の点 (lx, ly) → キャンバス = (ax, ay) + R(rot) · ((lx − ancX)·sx, (ly − ancY)·sy)。
export struct MoXf {
  ok: bool;
  shape: bool;
  // 3D でない video / image / text / color（2D の変形を rotation / scale / anchor で書く）
  xf2d: bool;
  ax: f64;
  ay: f64;
  ancX: f64;
  ancY: f64;
  rot: f64;          // 度（時計回り）
  sx: f64;
  sy: f64;
  box: f64[];        // 形の中の箱 [x0, y0, x1, y1]（ギズモの枠）
  usePos: bool;      // 位置を pos= で決める（shape の pos=、または pos のキーフレーム）
  left: f64;         // x / y で置くとき、x / y に書く値（箱の左上の画素）
  top: f64;
  layerX: f64;       // 層（マスクの座標の 0,0）の左上と大きさ（shape でないクリップ）
  layerY: f64;
  layerW: f64;
  layerH: f64;
}

function moXfNone(): MoXf {
  return {
    ok: false, shape: false, xf2d: false, ax: 0, ay: 0, ancX: 0, ancY: 0, rot: 0, sx: 1, sy: 1, box: [0, 0, 0, 0], usePos: false,
    left: 0, top: 0, layerX: 0, layerY: 0, layerW: 0, layerH: 0,
  };
}

function moHasAnim(c: Clip, key: string): bool {
  for (const a of c.anims) {
    if (a.key == key) {
      return true;
    }
  }
  return false;
}

// クリップ ci の、クリップの始まりから lt 秒の変形。置き場所が分からない（音、大きさの分からない文字など）なら ok = false。
export function moClipXf(p: Project, ci: usize, lt: f64): MoXf {
  return moClipXfSized(p, ci, lt, 0, 0);
}

// moClipXf と同じ。mw・mh は video / image の展開した素材の大きさ（render.um が置くのと同じ大きさ。分からなければ 0）。
// w= も h= もない画像は素材の大きさで置かれるので、これを渡さないとキャンバスの大きさの箱と見なしてしまう。
export function moClipXfSized(p: Project, ci: usize, lt: f64, mw: i32, mh: i32): MoXf {
  let xf = moXfNone();
  const kind = p.clips[ci].kind;
  if (kind == KIND_AUDIO) {
    return xf;
  }
  const c = clipAt(p.clips[ci], lt);
  if (kind == KIND_SHAPE) {
    const pl = shapePlaceAt(c.shape, c.x, c.y, c.xAbs, c.yAbs, p.width, p.height, POS_CENTER);
    const lb = shapeLocalBox(c.shape);
    xf.ok = true;
    xf.shape = true;
    xf.ax = pl.x;
    xf.ay = pl.y;
    xf.ancX = c.shape.anchorX;
    xf.ancY = c.shape.anchorY;
    xf.rot = c.shape.rotation;
    xf.sx = c.shape.scaleX;
    xf.sy = c.shape.scaleY;
    xf.box = [lb[0], lb[1], lb[2], lb[3]];
    xf.usePos = c.shape.posSet || moHasAnim(p.clips[ci], "pos");
    // shapePlaceAt と同じ箱（線の太さの半分を含む、回転の前の箱）
    let e = 0.0;
    if (c.shape.stroke.kind != SH_PAINT_NONE && c.shape.strokeW > 0) {
      e = c.shape.strokeW * 0.5;
    }
    const ax0 = (lb[0] - e - c.shape.anchorX) * c.shape.scaleX;
    const ax1 = (lb[2] + e - c.shape.anchorX) * c.shape.scaleX;
    const ay0 = (lb[1] - e - c.shape.anchorY) * c.shape.scaleY;
    const ay1 = (lb[3] + e - c.shape.anchorY) * c.shape.scaleY;
    xf.left = pl.x + Math.min(ax0, ax1);
    xf.top = pl.y + Math.min(ay0, ay1);
    return xf;
  }
  let w = c.w;
  let h = c.h;
  if (kind == KIND_COLOR) {
    if (w <= 0) {
      w = p.width;
    }
    if (h <= 0) {
      h = p.height;
    }
  } else if (mw > 0 && mh > 0 && (kind == KIND_VIDEO || kind == KIND_IMAGE)) {
    w = mw;
    h = mh;
  } else {
    if (w <= 0 && h <= 0) {
      if (kind == KIND_TEXT) {
        return xf;
      }
      w = p.width;
      h = p.height;
    } else if (h <= 0) {
      h = w * p.height / Math.max(p.width, 1);
    } else if (w <= 0) {
      w = h * p.width / Math.max(p.height, 1);
    }
  }
  const lx = clipPos(c.x, c.xAbs, w, p.width) as f64;
  const ly = clipPos(c.y, c.yAbs, h, p.height) as f64;
  xf.ok = true;
  xf.ax = lx + (w as f64) * 0.5;
  xf.ay = ly + (h as f64) * 0.5;
  xf.box = [-(w as f64) * 0.5, -(h as f64) * 0.5, (w as f64) * 0.5, (h as f64) * 0.5];
  xf.usePos = moHasAnim(p.clips[ci], "pos");
  xf.left = lx;
  xf.top = ly;
  xf.layerX = lx;
  xf.layerY = ly;
  xf.layerW = w as f64;
  xf.layerH = h as f64;
  if (!c.d3.is3d) {
    // 2D の変形: キャンバス = 中央 + R·S·(層の中央からの点 − anchor)。基準点は中央の位置に来る
    const v = xf2dAt(c.d3, lt);
    xf.xf2d = true;
    xf.rot = v.rot;
    xf.sx = v.sx;
    xf.sy = v.sy;
    xf.ancX = v.ax;
    xf.ancY = v.ay;
  }
  return xf;
}

// 形の中の点 → キャンバス（[x, y]）。
export function moXfApply(xf: MoXf, lx: f64, ly: f64): f64[] {
  const t = xf.rot * MO_PI / 180.0;
  const cs = shCos(t);
  const sn = shSin(t);
  const dx = (lx - xf.ancX) * xf.sx;
  const dy = (ly - xf.ancY) * xf.sy;
  return [xf.ax + cs * dx - sn * dy, xf.ay + sn * dx + cs * dy];
}

// キャンバス → 形の中の点。
export function moXfInverse(xf: MoXf, x: f64, y: f64): f64[] {
  const t = xf.rot * MO_PI / 180.0;
  const cs = shCos(t);
  const sn = shSin(t);
  const dx = x - xf.ax;
  const dy = y - xf.ay;
  const rx = cs * dx + sn * dy;
  const ry = -sn * dx + cs * dy;
  const sx = Math.abs(xf.sx) < 1e-9 ? 1e-9 : xf.sx;
  const sy = Math.abs(xf.sy) < 1e-9 ? 1e-9 : xf.sy;
  return [rx / sx + xf.ancX, ry / sy + xf.ancY];
}

// キャンバスの点が形の箱の中か。
export function moXfInside(xf: MoXf, x: f64, y: f64): bool {
  if (!xf.ok) {
    return false;
  }
  const l = moXfInverse(xf, x, y);
  return l[0] >= Math.min(xf.box[0], xf.box[2]) && l[0] <= Math.max(xf.box[0], xf.box[2]) &&
    l[1] >= Math.min(xf.box[1], xf.box[3]) && l[1] <= Math.max(xf.box[1], xf.box[3]);
}

// 角度（度）。
export function moAngle(dy: f64, dx: f64): f64 {
  return shAtan2(dy, dx) * 180.0 / MO_PI;
}

// キャンバスの点 (x, y) にある一番上のクリップ（描く順の後ろから探す）。なければ -1。
// sizes はクリップごとの展開した素材の幅と高さ（[w0, h0, w1, h1, ...]。分からなければ空）。
export function moClipAtPoint(p: Project, t: f64, x: f64, y: f64, sizes: i32[]): i32 {
  let i = p.drawOrder.length as i32 - 1;
  while (i >= 0) {
    const ci = p.drawOrder[i as usize] as usize;
    const lt = t - p.clips[ci].at;
    if (lt >= 0 && lt < p.clips[ci].dur) {
      let mw = 0;
      let mh = 0;
      if (ci * 2 + 1 < sizes.length) {
        mw = sizes[ci * 2];
        mh = sizes[ci * 2 + 1];
      }
      const xf = moClipXfSized(p, ci, lt, mw, mh);
      if (moXfInside(xf, x, y)) {
        return ci as i32;
      }
    }
    i--;
  }
  return -1;
}
