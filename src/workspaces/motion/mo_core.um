// M6 の操作の画面（src/workspaces/motion/）の共通の部分: 色と大きさ（tokens.json から）、部品が返す出来事、
// キーフレームの列の引き方、今の値の文字、ops の操作の文字の作り方、キャンバスと画面の座標の変換。
//
// 部品はどれも「描いて出来事（MoEvent）を返す」関数で、.mzc を書き換えるのは ops.um の操作（key add / move / set / ease /
// remove / clear、set）だけにする（ui.md の「操作の仕組みは一つ」）。出来事の ops は 1 行の操作の文字（splitArgs で分けて
// runOps に渡す）。ドラッグの途中は MO_E_PREVIEW（見せるだけ。取り消しの履歴に積まない）、離したら MO_E_OP を返す。
import { UkTheme } from "../../ui/kit/theme.um";
import { Project, Clip, KIND_SHAPE, KIND_VIDEO, KIND_IMAGE, KIND_TEXT, KIND_COLOR, KIND_AUDIO } from "../../engine/project.um";
import { textNum, sub } from "../../engine/text.um";
import { hasKey, keyValue } from "../../engine/lineedit.um";
import { animEval, animFmtValue, animTypeForKey, ANIM_VEC2, ANIM_COLOR } from "../../effects/anim/anim.um";
import { shapeAnimType } from "../../engine/project.um";

// ---- 出来事 ----

export const MO_E_OP: i32 = 1;       // ops を .mzc に当てる（取り消しの 1 段）
export const MO_E_PREVIEW: i32 = 2;  // ドラッグの途中。ops を当てた写しで描いて見せるだけ
export const MO_E_SEEK: i32 = 3;     // 再生ヘッドを t（タイムラインの秒）へ
export const MO_E_SELECT: i32 = 4;   // キーを選んだ（text はキーの名前、n はキーの番号、t はタイムラインの秒）
export const MO_E_CANCEL: i32 = 5;   // ドラッグを Esc でやめた（見せていた写しを捨てる）

export struct MoEvent {
  kind: i32;
  ops: string[];
  t: f64;
  n: i32;
  text: string;
}

export function moEv(kind: i32, ops: string[], t: f64, n: i32, text: string): MoEvent {
  let o: string[] = [];
  for (const x of ops) {
    o.push(x.clone());
  }
  return { kind, ops: o, t, n, text: text.clone() };
}

// ---- 色と大きさ ----

export struct MoTheme {
  bg0: u32;
  bg1: u32;
  bg2: u32;
  bg3: u32;
  bg4: u32;
  viewer: u32;
  line: u32;
  lineStrong: u32;
  lineControl: u32;
  text1: u32;
  text2: u32;
  text3: u32;
  accent: u32;
  accentHover: u32;
  accentTint: u32;
  playhead: u32;
  playheadEdge: u32;
  edge: u32;          // 画面の上の取っ手の縁（黒。selection.clipOuter）
  handle: u32;        // 取っ手の地（白。selection.clipInner）
  warn: u32;
  // 成分ごとの線の色（x / 1 つ目、y / 2 つ目、3 つ目、4 つ目）。clip.*.mark
  dim: u32[];
  // クリップの面（種類ごと。KIND_* の番号で引く。0 は使わない）
  clipFace: u32[];
  clipMark: u32[];
  fsSm: f32;
  fsMd: f32;
  fsXs: f32;
  hair: i32;
  s1: i32;
  s2: i32;
  s3: i32;
  s4: i32;
  rowH: i32;
  kf: i32;            // キーフレームの印の半径（菱形の中心から角まで）
  hit: i32;           // 取っ手をつかめる半径
  missing: i32;
}

function moHexVal(b: u8): i32 {
  if (b >= 48 && b <= 57) {
    return (b - 48) as i32;
  }
  if (b >= 97 && b <= 102) {
    return (b - 87) as i32;
  }
  if (b >= 65 && b <= 70) {
    return (b - 55) as i32;
  }
  return -1;
}

// "#RRGGBB" / "#RRGGBBAA" → 0xAARRGGBB。読めなければ -1。
export function moHex(s: string): i64 {
  if (s.length != 7 && s.length != 9) {
    return -1;
  }
  if (s[0] != 35) {
    return -1;
  }
  let v: i64 = 0;
  for (let i: usize = 1; i < s.length; i++) {
    const h = moHexVal(s[i]);
    if (h < 0) {
      return -1;
    }
    v = v * 16 + (h as i64);
  }
  if (s.length == 7) {
    return v | 0xff000000;
  }
  const a = v & 255;
  return (a << 24) | (v >> 8);
}

function moFindFrom(s: string, pat: string, from: usize): i64 {
  if (pat.length == 0 || s.length < pat.length) {
    return -1;
  }
  let i = from;
  while (i + pat.length <= s.length) {
    let ok = true;
    for (let j: usize = 0; j < pat.length; j++) {
      if (s[i + j] != pat[j]) {
        ok = false;
        break;
      }
    }
    if (ok) {
      return i as i64;
    }
    i++;
  }
  return -1;
}

// tokens.json の値を道筋（"color.dark.semantic.playhead" を分けたもの）で引く。名前を順に後ろへ探す簡単な読み方で、
// tokens.json の入れ子（同じ名前が別の枝の前に出ない）を前提にする。値は "..." の中身（数ならその文字）。
export function moTok(json: string, path: string[]): string {
  let at: usize = 0;
  for (const seg of path) {
    const f = moFindFrom(json, "\"" + seg + "\"", at);
    if (f < 0) {
      return "";
    }
    at = (f as usize) + seg.length + 2;
  }
  // : の後ろの値
  while (at < json.length && (json[at] == 32 || json[at] == 58 || json[at] == 9 || json[at] == 10 || json[at] == 13)) {
    at++;
  }
  if (at >= json.length) {
    return "";
  }
  if (json[at] == 34) {
    let e = at + 1;
    while (e < json.length && json[e] != 34) {
      e++;
    }
    return sub(json, at + 1, e);
  }
  let e = at;
  while (e < json.length && json[e] != 44 && json[e] != 125 && json[e] != 32 && json[e] != 10) {
    e++;
  }
  return sub(json, at, e);
}

function moTokC(json: string, path: string[], fb: u32, miss: mut i32[]): u32 {
  const v = moHex(moTok(json, path));
  if (v < 0) {
    miss[0] = miss[0] + 1;
    return fb;
  }
  return v as u32;
}

function moTokN(json: string, path: string[], fb: f32, miss: mut i32[]): f32 {
  const s = moTok(json, path);
  if (s == "") {
    miss[0] = miss[0] + 1;
    return fb;
  }
  let v: f32 = 0;
  let frac: f32 = 0;
  let div: f32 = 1;
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 46) {
      frac = 1;
    } else if (s[i] >= 48 && s[i] <= 57) {
      if (frac > 0) {
        div = div * 10;
        v = v + ((s[i] - 48) as f32) / div;
      } else {
        v = v * 10 + ((s[i] - 48) as f32);
      }
    }
  }
  return v;
}

function moPx(v: f32, scale: f32): i32 {
  return Math.floor(v * scale + 0.5) as i32;
}

// tokens.json（中身の文字）と UI の倍率から作る。読めなかった値の数は missing。
export function moThemeFromTokens(json: string, scale: f32): MoTheme {
  let m: i32[] = [0];
  let th: MoTheme = {
    bg0: moTokC(json, ["color", "dark", "bg", "0"], 0xff141414, mut m),
    bg1: moTokC(json, ["color", "dark", "bg", "1"], 0xff1b1b1b, mut m),
    bg2: moTokC(json, ["color", "dark", "bg", "2"], 0xff222222, mut m),
    bg3: moTokC(json, ["color", "dark", "bg", "3"], 0xff2c2c2c, mut m),
    bg4: moTokC(json, ["color", "dark", "bg", "4"], 0xff383838, mut m),
    viewer: moTokC(json, ["color", "dark", "bg", "viewer"], 0xff0d0d0d, mut m),
    line: moTokC(json, ["color", "dark", "line", "default"], 0xff2c2c2c, mut m),
    lineStrong: moTokC(json, ["color", "dark", "line", "strong"], 0xff3c3c3c, mut m),
    lineControl: moTokC(json, ["color", "dark", "line", "control"], 0xff767676, mut m),
    text1: moTokC(json, ["color", "dark", "text", "1"], 0xffe6e6e6, mut m),
    text2: moTokC(json, ["color", "dark", "text", "2"], 0xffa3a3a3, mut m),
    text3: moTokC(json, ["color", "dark", "text", "3"], 0xff8c8c8c, mut m),
    accent: moTokC(json, ["color", "dark", "accent", "default"], 0xff4c8dff, mut m),
    accentHover: moTokC(json, ["color", "dark", "accent", "hover"], 0xff6fa3ff, mut m),
    accentTint: moTokC(json, ["color", "dark", "accent", "tint"], 0x294c8dff, mut m),
    playhead: moTokC(json, ["color", "dark", "semantic", "playhead"], 0xffff4d4d, mut m),
    playheadEdge: moTokC(json, ["color", "dark", "semantic", "playheadEdge"], 0xff000000, mut m),
    edge: moTokC(json, ["color", "dark", "selection", "clipOuter"], 0xff000000, mut m),
    handle: moTokC(json, ["color", "dark", "selection", "clipInner"], 0xffffffff, mut m),
    warn: moTokC(json, ["color", "dark", "semantic", "warn"], 0xfff08a3c, mut m),
    dim: [],
    clipFace: [],
    clipMark: [],
    fsSm: 12, fsMd: 13, fsXs: 11, hair: 1, s1: 2, s2: 4, s3: 8, s4: 12, rowH: 28, kf: 5, hit: 7, missing: 0,
  };
  th.dim.push(moTokC(json, ["color", "dark", "clip", "video", "mark"], 0xff56b4e9, mut m));
  th.dim.push(moTokC(json, ["color", "dark", "clip", "audio", "mark"], 0xff2fbf8f, mut m));
  th.dim.push(moTokC(json, ["color", "dark", "clip", "image", "mark"], 0xffe69f00, mut m));
  th.dim.push(moTokC(json, ["color", "dark", "clip", "text", "mark"], 0xffcc79a7, mut m));
  // KIND_* の番号の順（0 は使わない。shape は color と同じ面）
  const kinds: string[] = ["color", "video", "image", "text", "color", "audio", "color"];
  for (let k: usize = 0; k < kinds.length; k++) {
    th.clipFace.push(moTokC(json, ["color", "dark", "clip", kinds[k].clone(), "face"], 0xff3d3d3d, mut m));
    th.clipMark.push(moTokC(json, ["color", "dark", "clip", kinds[k].clone(), "mark"], 0xffbdbdbd, mut m));
  }
  th.fsXs = moTokN(json, ["font", "size", "xs", "size"], 11, mut m) * scale;
  th.fsSm = moTokN(json, ["font", "size", "sm", "size"], 12, mut m) * scale;
  th.fsMd = moTokN(json, ["font", "size", "md", "size"], 13, mut m) * scale;
  th.s1 = moPx(moTokN(json, ["space", "1"], 4, mut m), scale);
  th.s2 = moPx(moTokN(json, ["space", "2"], 8, mut m), scale);
  th.s3 = moPx(moTokN(json, ["space", "3"], 12, mut m), scale);
  th.s4 = moPx(moTokN(json, ["space", "4"], 16, mut m), scale);
  th.hair = Math.max(moPx(1, scale), 1);
  th.rowH = moPx(28, scale);
  th.kf = moPx(5, scale);
  th.hit = moPx(7, scale);
  th.missing = m[0];
  return th;
}

// uikit のテーマに入れる（文字の大きさは uikit の値をそのまま使う）。
export function moThemeToUk(th: MoTheme, t: mut UkTheme): void {
  t.bg = th.bg0;
  t.panel = th.bg1;
  t.panelAlt = th.bg2;
  t.raised = th.bg3;
  t.border = th.line;
  t.borderStrong = th.lineStrong;
  t.text = th.text1;
  t.textDim = th.text2;
  t.accent = th.accent;
  t.accentHover = th.accentHover;
}

// ---- 数と時刻の文字 ----

// d 桁の小数に丸めて書く（textNum は 4 桁まで）。
export function moNum(v: f64, d: i32): string {
  let m: f64 = 1;
  for (let i = 0; i < d; i++) {
    m = m * 10;
  }
  return textNum(Math.floor(v * m + 0.5) / m);
}

// 時刻をコマに合わせる（fps が 0 以下ならそのまま）。
export function moSnap(t: f64, fps: f64): f64 {
  if (!(fps > 0)) {
    return t;
  }
  return Math.floor(t * fps + 0.5) / fps;
}

export function moFps(p: Project): f64 {
  if (p.fpsDen <= 0) {
    return 30;
  }
  return (p.fpsNum as f64) / (p.fpsDen as f64);
}

// 画面の時刻の札（秒を 2 桁の小数で。コマは 00:00:01:15 のような書き方はタイムラインの部品に任せる）。
export function moTimeLabel(t: f64, fps: f64): string {
  const f = Math.floor(t * fps + 0.5) as i64;
  const fi = Math.floor(fps + 0.5) as i64;
  if (fi <= 0) {
    return moNum(t, 2) + " 秒";
  }
  const s = f / fi;
  const r = f % fi;
  let rs = `${r}`;
  if (r < 10) {
    rs = "0" + rs;
  }
  return `${s}:${rs}`;
}

// ---- クリップとキーフレームの列 ----

// 操作でクリップを指す文字（ID、なければ @行番号）。
export function moRef(c: Clip): string {
  if (c.id != "") {
    return c.id.clone();
  }
  return `@${c.line}`;
}

// クリップのキー key のキーフレームの列の番号（c.anims の）。なければ -1。
export function moAnimIndex(c: Clip, key: string): i32 {
  for (let i: usize = 0; i < c.anims.length; i++) {
    if (c.anims[i].key == key) {
      return i as i32;
    }
  }
  return -1;
}

// キー key の値の型（ANIM_*）。動かせないキーなら -1。
export function moKeyType(c: Clip, key: string): i32 {
  if (c.kind == KIND_SHAPE && shapeAnimType(key) >= 0) {
    return shapeAnimType(key);
  }
  return animTypeForKey(key);
}

// クリップの始まりからの時刻 lt に、キーの時刻が近い（半コマ以内）キーの番号。なければ -1。
export function moKeyAt(c: Clip, key: string, lt: f64, fps: f64): i32 {
  const ai = moAnimIndex(c, key);
  if (ai < 0) {
    return -1;
  }
  const tol = fps > 0 ? 0.5 / fps : 0.001;
  const a = ai as usize;
  for (let k: usize = 0; k < c.anims[a].track.keys.length; k++) {
    if (Math.abs(c.anims[a].track.keys[k].t - lt) <= tol) {
      return k as i32;
    }
  }
  return -1;
}

// 書いていないキーの既定の値（形のキーと、位置・不透明度）。
function moDefaultValue(c: Clip, key: string): string {
  switch (key) {
    case "opacity":
    case "scale":
      return "1";
    case "rotation":
    case "repeatrot":
      return "0";
    case "x": {
      if (c.x >= 1.0e29) {
        return "0";
      }
      return textNum(c.x);
    }
    case "y": {
      if (c.y >= 1.0e29) {
        return "0";
      }
      return textNum(c.y);
    }
    case "pos": {
      if (c.kind == KIND_SHAPE && c.shape.posSet) {
        return textNum(c.shape.posX) + "," + textNum(c.shape.posY);
      }
      let sx = "0";
      if (c.x < 1.0e29) {
        sx = textNum(c.x);
      }
      let sy = "0";
      if (c.y < 1.0e29) {
        sy = textNum(c.y);
      }
      return sx + "," + sy;
    }
    case "anchor":
      return textNum(c.shape.anchorX) + "," + textNum(c.shape.anchorY);
  }
  return "0";
}

// 時刻 lt（クリップの始まりから）のキー key の値の文字（key add に渡す形）。line はクリップの行。
export function moValueText(c: Clip, line: string, key: string, lt: f64): string {
  const ai = moAnimIndex(c, key);
  if (ai >= 0) {
    const a = ai as usize;
    return animFmtValue(c.anims[a].track.type, animEval(c.anims[a].track, lt));
  }
  if (hasKey(line, key)) {
    return keyValue(line, key);
  }
  return moDefaultValue(c, key);
}

// 値の文字を数にする（2 次元なら [x, y]）。読めない成分は 0。
export function moParseVals(s: string): f64[] {
  let out: f64[] = [];
  let cur: u8[] = [];
  for (let i: usize = 0; i <= s.length; i++) {
    if (i == s.length || s[i] == 44) {
      out.push(moAtof(stringFromBytes(cur)));
      cur.clear();
    } else {
      cur.push(s[i]);
    }
  }
  return out;
}

// 小数の文字を数にする（先頭の - と、指数のない形）。
export function moAtof(s: string): f64 {
  let v: f64 = 0;
  let div: f64 = 1;
  let frac = false;
  let neg = false;
  for (let i: usize = 0; i < s.length; i++) {
    const b = s[i];
    if (b == 45 && i == 0) {
      neg = true;
    } else if (b == 46) {
      frac = true;
    } else if (b >= 48 && b <= 57) {
      if (frac) {
        div = div * 10;
        v = v + ((b - 48) as f64) / div;
      } else {
        v = v * 10 + ((b - 48) as f64);
      }
    }
  }
  return neg ? -v : v;
}

// 値を決める操作: キーフレームのあるキーなら、その時刻にキーを打つ（同じ時刻のキーは置き換わる）。なければ set。
// lt はクリップの始まりからの秒（コマに合わせてから渡す）。
export function moOpValue(c: Clip, key: string, lt: f64, val: string): string {
  if (moAnimIndex(c, key) >= 0) {
    return `key add ${moRef(c)} ${key} ${moNum(lt, 4)} ${val}`;
  }
  return `set ${moRef(c)} ${key}=${val}`;
}

export function moIsVisual(kind: i32): bool {
  return kind == KIND_VIDEO || kind == KIND_IMAGE || kind == KIND_TEXT || kind == KIND_COLOR || kind == KIND_SHAPE;
}

export function moIsAudio(kind: i32): bool {
  return kind == KIND_AUDIO;
}

// 動かせるキーの一覧（インスペクタの行の順）。shape は形の変形、ほかは位置と不透明度。
export function moMotionKeys(c: Clip): string[] {
  if (c.kind == KIND_SHAPE) {
    if (c.shape.posSet || moAnimIndex(c, "pos") >= 0) {
      return ["pos", "rotation", "scale", "opacity"];
    }
    return ["x", "y", "rotation", "scale", "opacity"];
  }
  if (c.kind == KIND_AUDIO) {
    return ["volume"];
  }
  if (moAnimIndex(c, "pos") >= 0) {
    return ["pos", "opacity"];
  }
  return ["x", "y", "opacity"];
}

// 値の型の印（2 次元なら 2）。
export function moDims(type: i32): i32 {
  if (type == ANIM_VEC2) {
    return 2;
  }
  if (type == ANIM_COLOR) {
    return 4;
  }
  return 1;
}

// ---- キャンバスと画面 ----

// キャンバスの画素 (x, y) を画面の (ox + x·s, oy + y·s) に置く（モニターの表示の倍率とずらし）。
export struct MoView {
  ox: f64;
  oy: f64;
  s: f64;
}

export function moToScreenX(v: MoView, x: f64): f32 {
  return (v.ox + x * v.s) as f32;
}

export function moToScreenY(v: MoView, y: f64): f32 {
  return (v.oy + y * v.s) as f32;
}

export function moFromScreenX(v: MoView, x: i32): f64 {
  return ((x as f64) - v.ox) / v.s;
}

export function moFromScreenY(v: MoView, y: i32): f64 {
  return ((y as f64) - v.oy) / v.s;
}
