// (5) シェイプとマスクの点の編集（モニターの上）。
//
// - shape path の点: 頂点（四角）と、ベジェの制御点（丸。頂点との線つき）をドラッグする。頂点を動かすと、その頂点に
//   付いた 2 つの制御点（入りと出）も一緒に動く。書き戻しは set <クリップ> d="..."
// - mask path の点: 同じ。書き戻しは set @<マスクの行> d="..."
// - mask rect / ellipse: 箱の 4 つの角をドラッグして x / y / w / h を決める（set @<行> x= y= w= h=）
// d は絶対座標の M / L / C / Z に書き直す（相対の命令・円弧・2 次ベジェは、最初に動かしたときに 3 次ベジェになる）。
// 座標は 2 桁の小数まで。途中は MO_E_PREVIEW、離したら MO_E_OP。Esc でやめる。
import {
  UkCtx, ukBehavior, ukIdInt, ukDrawText, ukDrawLine, ukLineH, ukSetCursor, ukTooltip, ukKeyTake,
  UK_KEY_ESC, UK_CURSOR_MOVE,
} from "../../ui/kit/core.um";
import { UkRect, ukRect, ukAlpha } from "../../ui/kit/base.um";
import { Project, Clip, KIND_SHAPE } from "../../engine/project.um";
import { textStartsWith } from "../../engine/text.um";
import { keyValue, hasKey } from "../../engine/lineedit.um";
import { shapePathCmds, SH_PATH, SH_CMD_MOVE, SH_CMD_LINE, SH_CMD_CUBIC, SH_CMD_CLOSE } from "../../effects/shape/shape_spec.um";
import { MBL_SHAPE_PATH, MBL_UNITS_NORM } from "../../effects/blend/mask.um";
import {
  MoTheme, MoEvent, MoView, moEv, moRef, moNum, moToScreenX, moToScreenY, moFromScreenX, moFromScreenY,
  MO_E_OP, MO_E_PREVIEW, MO_E_CANCEL,
} from "./mo_core.um";
import { MoXf, moClipXf, moXfApply, moXfInverse } from "./mo_geom.um";
import { moSquare, moDot, moEdgedLine, moDashLine } from "./mo_draw.um";

// 点の集まり 1 つ（shape のパス、マスク 1 つ）。
export struct MoPtSet {
  kind: i32;        // 0 shape path、1 mask path、2 mask の箱
  line: i32;        // マスクの行（1 から）。shape なら 0
  cmds: f64[];      // パスの命令（SH_CMD_*）。箱なら [x, y, w, h]
  // マスクの座標 → キャンバス: (layerX + mx·kx, layerY + my·ky)
  layerX: f64;
  layerY: f64;
  kx: f64;
  ky: f64;
}

export struct MoPointsState {
  set: i32;         // つかんだ集まりの番号（-1 ならつかんでいない）
  idx: i32;         // cmds の中の x の位置
  dragging: bool;
  cancelled: bool;
  orig: f64[];      // つかんだときの cmds
  pressX: f64;      // つかんだ点（集まりの座標）
  pressY: f64;
  last: string;
}

export function moPointsStateNew(): MoPointsState {
  return { set: -1, idx: -1, dragging: false, cancelled: false, orig: [], pressX: 0, pressY: 0, last: "" };
}

export function moPointsBusy(st: MoPointsState): bool {
  return st.set >= 0;
}

// クリップ ci のマスクの行の番号（ファイルの順。to=<ID> のものだけ）。
export function moMaskLines(p: Project, lines: string[], ci: usize): i32[] {
  let out: i32[] = [];
  const id = p.clips[ci].id.clone();
  if (id == "") {
    return out;
  }
  for (let i: usize = 0; i < lines.length; i++) {
    if (textStartsWith(lines[i], "mask ") && hasKey(lines[i], "to") && keyValue(lines[i], "to") == id) {
      out.push((i + 1) as i32);
    }
  }
  return out;
}

// 編集できる点の集まりを作る（shape path のパスと、to= で掛けたマスク）。
export function moPointSets(p: Project, lines: string[], ci: usize, lt: f64): MoPtSet[] {
  let out: MoPtSet[] = [];
  const xf = moClipXf(p, ci, lt);
  if (!xf.ok) {
    return out;
  }
  if (p.clips[ci].kind == KIND_SHAPE) {
    if (p.clips[ci].shape.form == SH_PATH) {
      out.push({ kind: 0, line: 0, cmds: shapePathCmds(p.clips[ci].shape.pathText), layerX: 0, layerY: 0, kx: 1, ky: 1 });
    }
    return out;
  }
  const ml = moMaskLines(p, lines, ci);
  if (ml.length != p.clips[ci].masks.length) {
    // to= のないマスクが混ざっている（並びで掛かる先が決まる）。行との対応が分からないので出さない
    return out;
  }
  for (let j: usize = 0; j < ml.length; j++) {
    let kx = 1.0;
    let ky = 1.0;
    if (p.clips[ci].masks[j].units == MBL_UNITS_NORM) {
      kx = xf.layerW;
      ky = xf.layerH;
    } else if (p.clips[ci].masks[j].refW > 0 && p.clips[ci].masks[j].refH > 0) {
      kx = xf.layerW / (p.clips[ci].masks[j].refW as f64);
      ky = xf.layerH / (p.clips[ci].masks[j].refH as f64);
    }
    let s: MoPtSet = { kind: 1, line: ml[j], cmds: [], layerX: xf.layerX, layerY: xf.layerY, kx, ky };
    if (p.clips[ci].masks[j].shape == MBL_SHAPE_PATH) {
      s.cmds = shapePathCmds(p.clips[ci].masks[j].d);
    } else {
      s.kind = 2;
      let w = p.clips[ci].masks[j].w as f64;
      let h = p.clips[ci].masks[j].h as f64;
      if (w < 0) {
        w = xf.layerW / kx;
      }
      if (h < 0) {
        h = xf.layerH / ky;
      }
      s.cmds = [p.clips[ci].masks[j].x as f64, p.clips[ci].masks[j].y as f64, w, h];
    }
    out.push(s);
  }
  return out;
}

// 集まりの座標 → キャンバス。
function moSetToCanvas(s: MoPtSet, xf: MoXf, x: f64, y: f64): f64[] {
  if (s.kind == 0) {
    return moXfApply(xf, x, y);
  }
  const lx = s.layerX + x * s.kx;
  const ly = s.layerY + y * s.ky;
  if (xf.xf2d) {
    // 2D の変形のあるクリップのマスクは、層の中央からの点にして変形する（描画と同じく、マスクは変形の前に掛かる）
    return moXfApply(xf, lx - xf.ax, ly - xf.ay);
  }
  return [lx, ly];
}

function moCanvasToSet(s: MoPtSet, xf: MoXf, x: f64, y: f64): f64[] {
  if (s.kind == 0) {
    return moXfInverse(xf, x, y);
  }
  const kx = Math.abs(s.kx) < 1e-9 ? 1.0 : s.kx;
  const ky = Math.abs(s.ky) < 1e-9 ? 1.0 : s.ky;
  if (xf.xf2d) {
    const l = moXfInverse(xf, x, y);
    return [(l[0] + xf.ax - s.layerX) / kx, (l[1] + xf.ay - s.layerY) / ky];
  }
  return [(x - s.layerX) / kx, (y - s.layerY) / ky];
}

// 命令の列 → d の文字（絶対座標の M / L / C / Z）。
export function moPathText(cmds: f64[]): string {
  let s = "";
  let i: usize = 0;
  while (i < cmds.length) {
    const op = cmds[i];
    if (s != "") {
      s = s + " ";
    }
    if (op == SH_CMD_MOVE || op == SH_CMD_LINE) {
      if (op == SH_CMD_MOVE) {
        s = s + "M ";
      } else {
        s = s + "L ";
      }
      s = s + moNum(cmds[i + 1], 2) + " " + moNum(cmds[i + 2], 2);
      i += 3;
    } else if (op == SH_CMD_CUBIC) {
      s = s + "C";
      for (let k: usize = 1; k <= 6; k++) {
        s = s + " " + moNum(cmds[i + k], 2);
      }
      i += 7;
    } else {
      s = s + "Z";
      i += 1;
    }
  }
  return s;
}

// 点の種類: cmds の位置 → 0 頂点、1 制御点。頂点の位置と、付いている制御点の位置を返す並び（[x の位置, 種類]...）。
function moPathPoints(cmds: f64[]): i32[] {
  let out: i32[] = [];
  let i: usize = 0;
  while (i < cmds.length) {
    const op = cmds[i];
    if (op == SH_CMD_MOVE || op == SH_CMD_LINE) {
      out.push((i + 1) as i32);
      out.push(0);
      i += 3;
    } else if (op == SH_CMD_CUBIC) {
      out.push((i + 1) as i32);
      out.push(1);
      out.push((i + 3) as i32);
      out.push(1);
      out.push((i + 5) as i32);
      out.push(0);
      i += 7;
    } else {
      i += 1;
    }
  }
  return out;
}

// 頂点 at（x の位置）を (dx, dy) だけ動かした命令の列（付いた制御点も動かす）。
function moMoveVertex(orig: f64[], at: usize, dx: f64, dy: f64, vertex: bool): f64[] {
  let c = orig.clone();
  c[at] = orig[at] + dx;
  c[at + 1] = orig[at + 1] + dy;
  if (!vertex) {
    return c;
  }
  // この頂点で終わる 3 次ベジェの 2 つ目の制御点（at - 2）
  if (at >= 5 && moIsOpAt(orig, at - 5) && orig[at - 5] == SH_CMD_CUBIC) {
    c[at - 2] = orig[at - 2] + dx;
    c[at - 1] = orig[at - 1] + dy;
  }
  // 次の命令が 3 次ベジェなら、その 1 つ目の制御点
  const nx = at + 2;
  if (nx < orig.length && moIsOpAt(orig, nx) && orig[nx] == SH_CMD_CUBIC) {
    c[nx + 1] = orig[nx + 1] + dx;
    c[nx + 2] = orig[nx + 2] + dy;
  }
  return c;
}

// 動かした集まりを書き戻す操作。
function moPointsOp(c: Clip, s: MoPtSet, cmds: f64[]): string {
  if (s.kind == 0) {
    return `set ${moRef(c)} d="${moPathText(cmds)}"`;
  }
  if (s.kind == 1) {
    return `set @${s.line} d="${moPathText(cmds)}"`;
  }
  return `set @${s.line} x=${moNum(cmds[0], 2)} y=${moNum(cmds[1], 2)} w=${moNum(cmds[2], 2)} h=${moNum(cmds[3], 2)}`;
}

// 箱の角 k（0 左上、1 右上、2 右下、3 左下）を (dx, dy) 動かした [x, y, w, h]（裏返ったら並べ直す）。
function moMoveBox(o: f64[], k: i32, dx: f64, dy: f64): f64[] {
  let x0 = o[0];
  let y0 = o[1];
  let x1 = o[0] + o[2];
  let y1 = o[1] + o[3];
  if (k == 0 || k == 3) {
    x0 = x0 + dx;
  } else {
    x1 = x1 + dx;
  }
  if (k == 0 || k == 1) {
    y0 = y0 + dy;
  } else {
    y1 = y1 + dy;
  }
  return [Math.min(x0, x1), Math.min(y0, y1), Math.abs(x1 - x0), Math.abs(y1 - y0)];
}

// クリップ ci の点を描き、出来事を返す。lines は .mzc の行（マスクの行を探す）。
export function moPoints(ui: mut UkCtx, th: MoTheme, p: Project, lines: string[], ci: usize, lt: f64, view: MoView, st: mut MoPointsState): MoEvent[] {
  let out: MoEvent[] = [];
  const xf = moClipXf(p, ci, lt);
  if (!xf.ok) {
    return out;
  }
  const sets = moPointSets(p, lines, ci, lt);
  const ref = moRef(p.clips[ci]);
  const mxC = moFromScreenX(view, ui.inp.mx);
  const myC = moFromScreenY(view, ui.inp.my);
  for (let si: usize = 0; si < sets.length; si++) {
    const s = si as i32;
    // ドラッグ中なら、動かした形で描く
    let cmds = sets[si].cmds.clone();
    if (st.set == s && st.dragging && !st.cancelled) {
      const q = moCanvasToSet(sets[si], xf, mxC, myC);
      cmds = moPointsMoved(sets[si], st, q[0] - st.pressX, q[1] - st.pressY);
    }
    const col = sets[si].kind == 0 ? th.accent : th.warn;
    let held = false;
    let releasedHere = false;
    if (sets[si].kind == 2) {
      // 箱: 4 本の辺と 4 つの角
      const xs: f64[] = [cmds[0], cmds[0] + cmds[2], cmds[0] + cmds[2], cmds[0]];
      const ys: f64[] = [cmds[1], cmds[1], cmds[1] + cmds[3], cmds[1] + cmds[3]];
      let sx: f32[] = [];
      let sy: f32[] = [];
      for (let k: usize = 0; k < 4; k++) {
        const q = moSetToCanvas(sets[si], xf, xs[k], ys[k]);
        sx.push(moToScreenX(view, q[0]));
        sy.push(moToScreenY(view, q[1]));
      }
      for (let k: usize = 0; k < 4; k++) {
        moEdgedLine(mut ui, sx[k], sy[k], sx[(k + 1) % 4], sy[(k + 1) % 4], 1, col, ukAlpha(th.edge, 140));
      }
      for (let k: usize = 0; k < 4; k++) {
        const id = ukIdInt(ui, `mop.box.${ref}.${si}`, k as i32);
        const h = ukBehavior(mut ui, id, ukRect((sx[k] as i32) - th.hit, (sy[k] as i32) - th.hit, th.hit * 2 + 1, th.hit * 2 + 1), false);
        if (h.hover) {
          ukSetCursor(mut ui, UK_CURSOR_MOVE);
          ukTooltip(mut ui, `マスク（${sets[si].line} 行目）の角`);
        }
        if (h.pressed) {
          moPointsGrab(mut st, s, k as i32, sets[si], xf, mxC, myC);
        }
        if (st.set == s && st.idx == (k as i32)) {
          held = h.held;
          releasedHere = true;
        }
        moSquare(mut ui, sx[k], sy[k], 3, h.hover ? col : th.handle, th.edge);
      }
    } else {
      // パスの線（頂点のあいだ。3 次ベジェは 16 分割）
      let px = 0.0;
      let py = 0.0;
      let sx0 = 0.0;
      let sy0 = 0.0;
      let i: usize = 0;
      while (i < cmds.length) {
        const op = cmds[i];
        if (op == SH_CMD_MOVE) {
          px = cmds[i + 1];
          py = cmds[i + 2];
          sx0 = px;
          sy0 = py;
          i += 3;
        } else if (op == SH_CMD_LINE) {
          moPtSeg(mut ui, th, sets[si], xf, view, px, py, cmds[i + 1], cmds[i + 2], col);
          px = cmds[i + 1];
          py = cmds[i + 2];
          i += 3;
        } else if (op == SH_CMD_CUBIC) {
          let qx = px;
          let qy = py;
          for (let k = 1; k <= 16; k++) {
            const t = (k as f64) / 16.0;
            const u = 1.0 - t;
            const bx = u * u * u * px + 3.0 * u * u * t * cmds[i + 1] + 3.0 * u * t * t * cmds[i + 3] + t * t * t * cmds[i + 5];
            const by = u * u * u * py + 3.0 * u * u * t * cmds[i + 2] + 3.0 * u * t * t * cmds[i + 4] + t * t * t * cmds[i + 6];
            moPtSeg(mut ui, th, sets[si], xf, view, qx, qy, bx, by, col);
            qx = bx;
            qy = by;
          }
          // 制御点の線
          moPtHandleLine(mut ui, th, sets[si], xf, view, px, py, cmds[i + 1], cmds[i + 2]);
          moPtHandleLine(mut ui, th, sets[si], xf, view, cmds[i + 5], cmds[i + 6], cmds[i + 3], cmds[i + 4]);
          px = cmds[i + 5];
          py = cmds[i + 6];
          i += 7;
        } else {
          moPtSeg(mut ui, th, sets[si], xf, view, px, py, sx0, sy0, col);
          px = sx0;
          py = sy0;
          i += 1;
        }
      }
      // 点（頂点と制御点）
      const pts = moPathPoints(cmds);
      let k: usize = 0;
      while (k + 1 < pts.length) {
        const at = pts[k] as usize;
        const vertex = pts[k + 1] == 0;
        const q = moSetToCanvas(sets[si], xf, cmds[at], cmds[at + 1]);
        const hx = moToScreenX(view, q[0]);
        const hy = moToScreenY(view, q[1]);
        const id = ukIdInt(ui, `mop.pt.${ref}.${si}`, at as i32);
        const h = ukBehavior(mut ui, id, ukRect((hx as i32) - th.hit, (hy as i32) - th.hit, th.hit * 2 + 1, th.hit * 2 + 1), false);
        if (h.hover) {
          ukSetCursor(mut ui, UK_CURSOR_MOVE);
          if (vertex) {
            ukTooltip(mut ui, "頂点（制御点も一緒に動く）");
          } else {
            ukTooltip(mut ui, "制御点");
          }
        }
        if (h.pressed) {
          moPointsGrab(mut st, s, at as i32, sets[si], xf, mxC, myC);
        }
        if (st.set == s && st.idx == (at as i32)) {
          held = h.held;
          releasedHere = true;
        }
        if (vertex) {
          moSquare(mut ui, hx, hy, 3, h.hover ? col : th.handle, th.edge);
        } else {
          moDot(mut ui, hx, hy, 3, h.hover ? col : th.text1, th.edge);
        }
        k += 2;
      }
    }
    // ドラッグ
    if (st.set == s && releasedHere) {
      const q = moCanvasToSet(sets[si], xf, mxC, myC);
      const dx = q[0] - st.pressX;
      const dy = q[1] - st.pressY;
      if (held && !st.cancelled) {
        if (ukKeyTake(mut ui, UK_KEY_ESC)) {
          st.cancelled = true;
          if (st.dragging) {
            out.push(moEv(MO_E_CANCEL, [], 0, 0, ""));
          }
          st.dragging = false;
        } else if (Math.abs(ui.inp.mx - ui.activeX) + Math.abs(ui.inp.my - ui.activeY) >= 2 || st.dragging) {
          st.dragging = true;
          const op = moPointsOp(p.clips[ci], sets[si], moPointsMoved(sets[si], st, dx, dy));
          if (op != st.last) {
            st.last = op.clone();
            out.push(moEv(MO_E_PREVIEW, [op.clone()], 0, 0, ""));
          }
        }
      }
      if (!held) {
        if (st.dragging && !st.cancelled) {
          const op = moPointsOp(p.clips[ci], sets[si], moPointsMoved(sets[si], st, dx, dy));
          let what = "シェイプの点を動かす";
          if (sets[si].kind != 0) {
            what = `マスク（${sets[si].line} 行目）を動かす`;
          }
          out.push(moEv(MO_E_OP, [op.clone()], 0, 0, what));
        }
        st.set = -1;
        st.idx = -1;
        st.dragging = false;
        st.last = "";
      }
    }
  }
  if (st.set >= 0 && (st.set as usize) >= sets.length) {
    st.set = -1;
  }
  return out;
}

function moPointsMoved(s: MoPtSet, st: MoPointsState, dx: f64, dy: f64): f64[] {
  if (s.kind == 2) {
    return moMoveBox(st.orig, st.idx, dx, dy);
  }
  const at = st.idx as usize;
  if (at < 1 || at + 1 >= st.orig.length) {
    return st.orig.clone();
  }
  // 頂点か（M / L の x か、3 次ベジェの終わりの x）
  const vertex = (moIsOpAt(st.orig, at - 1) && st.orig[at - 1] != SH_CMD_CUBIC) || (at >= 5 && moIsOpAt(st.orig, at - 5) && st.orig[at - 5] == SH_CMD_CUBIC);
  return moMoveVertex(st.orig, at, dx, dy, vertex);
}

function moPointsGrab(st: mut MoPointsState, s: i32, idx: i32, set: MoPtSet, xf: MoXf, mx: f64, my: f64): void {
  st.set = s;
  st.idx = idx;
  st.dragging = false;
  st.cancelled = false;
  st.orig = set.cmds.clone();
  const q = moCanvasToSet(set, xf, mx, my);
  st.pressX = q[0];
  st.pressY = q[1];
  st.last = "";
}

function moPtSeg(ui: mut UkCtx, th: MoTheme, s: MoPtSet, xf: MoXf, view: MoView, ax: f64, ay: f64, bx: f64, by: f64, col: u32): void {
  const a = moSetToCanvas(s, xf, ax, ay);
  const b = moSetToCanvas(s, xf, bx, by);
  moEdgedLine(mut ui, moToScreenX(view, a[0]), moToScreenY(view, a[1]), moToScreenX(view, b[0]), moToScreenY(view, b[1]), 1, col, ukAlpha(th.edge, 140));
}

function moPtHandleLine(ui: mut UkCtx, th: MoTheme, s: MoPtSet, xf: MoXf, view: MoView, ax: f64, ay: f64, bx: f64, by: f64): void {
  const a = moSetToCanvas(s, xf, ax, ay);
  const b = moSetToCanvas(s, xf, bx, by);
  moDashLine(mut ui, moToScreenX(view, a[0]), moToScreenY(view, a[1]), moToScreenX(view, b[0]), moToScreenY(view, b[1]), 1, 3, th.text2);
}

// cmds の位置 at が命令の頭か（座標の値と命令の番号を取り違えないよう、頭から数える）。
function moIsOpAt(cmds: f64[], at: usize): bool {
  let i: usize = 0;
  while (i < cmds.length) {
    if (i == at) {
      return true;
    }
    if (i > at) {
      return false;
    }
    const op = cmds[i];
    if (op == SH_CMD_MOVE || op == SH_CMD_LINE) {
      i += 3;
    } else if (op == SH_CMD_CUBIC) {
      i += 7;
    } else {
      i += 1;
    }
  }
  return false;
}
