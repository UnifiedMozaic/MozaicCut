// (2) インスペクタの値の横のキーフレームの ◀ ◆ ▶（ui.md 7.3）。
//
// - ◇（キーフレームがない）を押す: 再生ヘッドの時刻に今の値でキーを打つ（key add。アニメーションが有効になる）
// - ◆ を押す: 再生ヘッドにキーがあれば消す（key remove。最後の 1 つなら key clear で今の値に戻す）、なければ打つ（key add）
// - Alt を押しながら ◆: キーフレームをやめる（key clear <クリップ> <キー> <今の時刻>。今の値をふつうの値で残す）
// - ◀ / ▶: 前 / 次のキーへ再生ヘッドを動かす（MO_E_SEEK）。キーフレームがあるキーだけに出す
// 再生ヘッドの位置にキーがあれば ◆ を accent で描く。
import {
  UkCtx, ukBehavior, ukId, ukDrawRect, ukDrawRound, ukDrawText, ukDrawTextIn, ukDrawTri, ukLineH, ukTooltip, ukDisable, ukEnable,
  UK_MOD_ALT,
} from "../../ui/kit/core.um";
import { UkRect, ukRect, ukAlpha } from "../../ui/kit/base.um";
import { Clip } from "../../engine/project.um";
import {
  MoTheme, MoEvent, moEv, moRef, moSnap, moNum, moAnimIndex, moKeyAt, moValueText, MO_E_OP, MO_E_SEEK, MO_E_SELECT,
} from "./mo_core.um";
import { moDiamond, moDiamondLine } from "./mo_draw.um";

// 前（dir < 0）/ 次（dir > 0）のキーの時刻（クリップの始まりから）。なければ NaN。
export function moNeighborKey(c: Clip, key: string, lt: f64, fps: f64, dir: i32): f64 {
  const ai = moAnimIndex(c, key);
  let best = 0.0 / 0.0;
  if (ai < 0) {
    return best;
  }
  const tol = fps > 0 ? 0.5 / fps : 0.001;
  const a = ai as usize;
  for (const k of c.anims[a].track.keys) {
    if (dir < 0 && k.t < lt - tol && (best != best || k.t > best)) {
      best = k.t;
    }
    if (dir > 0 && k.t > lt + tol && (best != best || k.t < best)) {
      best = k.t;
    }
  }
  return best;
}

// ボタンの四角の中の三角（dir < 0 で左向き）。
function moArrow(ui: mut UkCtx, r: UkRect, dir: i32, c: u32): void {
  const cx = (r.x as f32) + (r.w as f32) * 0.5;
  const cy = (r.y as f32) + (r.h as f32) * 0.5;
  const s: f32 = 4;
  if (dir < 0) {
    ukDrawTri(mut ui, cx + s * 0.6, cy - s, cx + s * 0.6, cy + s, cx - s * 0.8, cy, c);
  } else {
    ukDrawTri(mut ui, cx - s * 0.6, cy - s, cx + s * 0.8, cy, cx - s * 0.6, cy + s, c);
  }
}

// r の右の端に ◀ ◆ ▶ を並べて描き、出来事を返す。line はクリップの行（今の値を読む）、lt はクリップの始まりからの秒。
// 使った幅は r.h * 3（キーフレームがなければ r.h だけ。右の端に寄せる）。
export function moKeyNav(ui: mut UkCtx, th: MoTheme, c: Clip, line: string, key: string, lt: f64, fps: f64, r: UkRect): MoEvent[] {
  let out: MoEvent[] = [];
  const b = r.h;
  const animated = moAnimIndex(c, key) >= 0;
  const ltS = moSnap(lt, fps);
  const inside = lt >= 0 && lt <= c.dur;
  const kAt = moKeyAt(c, key, lt, fps);
  const xr = r.x + r.w - b;
  // ▶
  if (animated) {
    const nt = moNeighborKey(c, key, lt, fps, 1);
    const rr = ukRect(xr, r.y, b, b);
    ukDisable(mut ui, nt != nt);
    const h = ukBehavior(mut ui, ukId(ui, "mokn.next." + moRef(c) + "." + key), rr, true);
    ukEnable(mut ui, nt != nt);
    if (h.hover) {
      ukDrawRound(mut ui, rr, 3, th.bg4);
    }
    moArrow(mut ui, rr, 1, nt != nt ? th.text3 : (h.hover ? th.text1 : th.text2));
    ukTooltip(mut ui, "次のキーフレームへ");
    if (h.clicked && nt == nt) {
      out.push(moEv(MO_E_SEEK, [], c.at + nt, 0, ""));
    }
  }
  // ◆
  const dx = animated ? xr - b : xr;
  const dr = ukRect(dx, r.y, b, b);
  ukDisable(mut ui, !inside);
  const hd = ukBehavior(mut ui, ukId(ui, "mokn.key." + moRef(c) + "." + key), dr, true);
  ukEnable(mut ui, !inside);
  if (hd.hover) {
    ukDrawRound(mut ui, dr, 3, th.bg4);
  }
  const cx = (dr.x as f32) + (b as f32) * 0.5;
  const cy = (dr.y as f32) + (b as f32) * 0.5;
  const kr = (b as f32) * 0.24;
  if (!animated) {
    moDiamondLine(mut ui, cx, cy, kr, 1.2, hd.hover ? th.text1 : th.text2);
    ukTooltip(mut ui, "キーフレームを打つ（アニメーションを有効にする）");
  } else if (kAt >= 0) {
    moDiamond(mut ui, cx, cy, kr + 0.5, th.accent);
    ukTooltip(mut ui, "このキーを消す（Alt+クリックでキーフレームをやめる）");
  } else {
    moDiamond(mut ui, cx, cy, kr, hd.hover ? th.text1 : th.text2);
    ukTooltip(mut ui, "キーを打つ（Alt+クリックでキーフレームをやめる）");
  }
  if (hd.clicked && inside) {
    const ref = moRef(c);
    if (animated && (ui.inp.mods & UK_MOD_ALT) != 0) {
      out.push(moEv(MO_E_OP, [`key clear ${ref} ${key} ${moNum(ltS, 4)}`], 0, 0, `${key} のキーフレームをやめる`));
    } else if (kAt >= 0) {
      const a = moAnimIndex(c, key) as usize;
      if (c.anims[a].track.keys.length <= 1) {
        out.push(moEv(MO_E_OP, [`key clear ${ref} ${key}`], 0, 0, `${key} のキーフレームをやめる`));
      } else {
        out.push(moEv(MO_E_OP, [`key remove ${ref} ${key} #${kAt}`], 0, 0, `${key} のキーを消す`));
      }
    } else {
      const v = moValueText(c, line, key, lt);
      out.push(moEv(MO_E_OP, [`key add ${ref} ${key} ${moNum(ltS, 4)} ${v}`], 0, 0, `${key} にキーを打つ`));
    }
  }
  // ◀
  if (animated) {
    const pt = moNeighborKey(c, key, lt, fps, -1);
    const rr = ukRect(dx - b, r.y, b, b);
    ukDisable(mut ui, pt != pt);
    const h = ukBehavior(mut ui, ukId(ui, "mokn.prev." + moRef(c) + "." + key), rr, true);
    ukEnable(mut ui, pt != pt);
    if (h.hover) {
      ukDrawRound(mut ui, rr, 3, th.bg4);
    }
    moArrow(mut ui, rr, -1, pt != pt ? th.text3 : (h.hover ? th.text1 : th.text2));
    ukTooltip(mut ui, "前のキーフレームへ");
    if (h.clicked && pt == pt) {
      out.push(moEv(MO_E_SEEK, [], c.at + pt, 0, ""));
    }
  }
  return out;
}

// インスペクタの 1 行（ラベル・値・◀ ◆ ▶）。編集画面のインスペクタはこの行の代わりに moKeyNav だけを自分の行の右に置く。
// ラベルを押すと、そのキーを選ぶ（MO_E_SELECT。グラフエディタに出すキー）。selected なら行の地を accent の薄い色にする。
export function moPropRow(ui: mut UkCtx, th: MoTheme, c: Clip, line: string, key: string, label: string, lt: f64, fps: f64, r: UkRect, selected: bool): MoEvent[] {
  if (selected) {
    ukDrawRect(mut ui, r, th.accentTint);
  }
  const h = ukBehavior(mut ui, ukId(ui, "mokn.row." + moRef(c) + "." + key), ukRect(r.x, r.y, r.w - r.h * 3 - th.s2, r.h), false);
  if (h.hover && !selected) {
    ukDrawRect(mut ui, r, ukAlpha(th.text1, 10));
  }
  const lh = ukLineH(ui, th.fsSm);
  const animated = moAnimIndex(c, key) >= 0;
  if (animated) {
    ukDrawRect(mut ui, ukRect(r.x + 3, r.y + (r.h - 5) / 2, 5, 5), th.accent);
  }
  ukDrawText(mut ui, r.x + th.s3, r.y + (r.h - lh) / 2, label, th.fsSm, th.text2);
  const v = moValueText(c, line, key, lt);
  const vr = ukRect(r.x + 86, r.y + 2, r.w - 86 - r.h * 3 - th.s2, r.h - 4);
  ukDrawRound(mut ui, vr, 3, th.bg1);
  ukDrawTextIn(mut ui, ukRect(vr.x + th.s2, vr.y, vr.w - th.s2 * 2, vr.h), v, th.fsSm, animated ? th.accentHover : th.text1, 0);
  let out = moKeyNav(mut ui, th, c, line, key, lt, fps, ukRect(r.x + r.w - r.h * 3, r.y + 2, r.h * 3, r.h - 4));
  if (h.clicked) {
    out.push(moEv(MO_E_SELECT, [], 0, -1, key.clone()));
  }
  return out;
}
