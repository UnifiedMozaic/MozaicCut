// 書き出す場所を変える: 文字で入れる欄と、OS のフォルダのダイアログをつなぐ口。
//
// - 「変える…」（UE_EV_PICK_FOLDER）を押すと、state.um が folderEdit を立てる。wsxFolderBar がファイル名の箱の上に
//   欄を重ねて出し、Enter か［決める］で場所を変え、Esc か［やめる］で閉じる。
// - OS のダイアログ（SDL3 の windowOpenFolderDialog）は、窓を持っている呼ぶ側がつなぐ:
//     if (wsxFolderDialogWanted(st) && 使ってよい) { st.folderReq = windowOpenFolderDialog(win, "書き出す場所", st.ui.folder, false) ?? -1; }
//     pollWindowEvent の WindowEvent.Dialog(r, paths, _) で wsxFolderDialogDone(mut st, r, paths)
//   ダイアログを出したら文字の欄は閉じる。取り消し（paths が空）なら何も変えない。
//   見本とテストでは OS のダイアログを開かない（ws_export_demo.um は --dialogs を付けたときだけつなぐ）。
import { UkRect, ukRect, ukShrink } from "../../ui/kit/base.um";
import {
  UkCtx, ukBehaviorEx, ukId, ukSt, ukDrawRect, ukDrawRound, ukKeyTake, ukFocus, ukPushLayer, ukPopLayer, ukBlock,
  UK_KEY_ENTER, UK_KEY_ESC, UK_L_FLOAT,
} from "../../ui/kit/core.um";
import { ukTextEdit } from "../../ui/kit/widgets.um";
import { UeTheme } from "../../ui/export/theme.um";
import { ueTextFit, ueButton, ueButtonW, UE_B_NORMAL, UE_B_PRIMARY } from "../../ui/export/draw.um";
import { WsxState } from "./types.um";
import { wsxSetFolder } from "./state.um";

// 呼ぶ側が OS のダイアログを出すべきか（欄が開いたばかりで、まだダイアログを頼んでいない）
export function wsxFolderDialogWanted(st: WsxState, req: i32): bool {
  return st.folderEdit && req < 0;
}

// ダイアログの結果。req が頼んだものなら場所を変えて true（取り消しなら変えずに true）。欄は閉じる。
export function wsxFolderDialogDone(st: mut WsxState, req: i32, want: i32, paths: string[]): bool {
  if (req != want) {
    return false;
  }
  st.folderEdit = false;
  if (paths.length > 0) {
    wsxSetFolder(mut st, paths[0]);
  }
  return true;
}

// 文字で入れる欄（box はファイル名と場所の箱。その上に重ねる）。場所を変えたら true。
export function wsxFolderBar(ui: mut UkCtx, t: UeTheme, st: mut WsxState, box: UkRect): bool {
  if (!st.folderEdit) {
    return false;
  }
  ukPushLayer(mut ui, UK_L_FLOAT);
  ukBlock(mut ui, box);
  ukDrawRound(mut ui, box, t.rMd, t.accent);
  ukDrawRound(mut ui, ukShrink(box, t.hairline), Math.max(t.rMd - t.hairline, 0), t.bg2);
  const pad = t.s3;
  const fh = t.btnMd;
  const y0 = box.y + pad;
  ueTextFit(mut ui, box.x + pad, y0, box.w - pad * 2, t.lhSm, "書き出す場所（フォルダのパスを入れて Enter）", t.fsSm, t.text2);
  const y1 = y0 + t.lhSm + t.s1;
  const okW = ueButtonW(mut ui, t, "決める", t.btnSm);
  const ngW = ueButtonW(mut ui, t, "やめる", t.btnSm);
  const fw = Math.max(box.w - pad * 2 - okW - ngW - t.s2 * 2, t.s4);
  const f = ukRect(box.x + pad, y1, fw, fh);
  const id = ukId(ui, "wsx.folder");
  const hit = ukBehaviorEx(mut ui, id, f, true, false);
  ukFocus(mut ui, id, true);
  ukDrawRound(mut ui, f, t.rMd, t.accent);
  ukDrawRound(mut ui, ukShrink(f, t.hairline), Math.max(t.rMd - t.hairline, 0), t.bg0);
  const inner = ukRect(f.x + t.s2, f.y, f.w - t.s2 * 2, f.h);
  const si = ukSt(mut ui, id);
  const old = st.folderText.clone();
  st.folderText = ukTextEdit(mut ui, id, si, inner, old, hit, t.text1);
  const bx = f.x + f.w + t.s2;
  const by = y1 + (fh - t.btnSm) / 2;
  let decide = ueButton(mut ui, t, "wsx.folder.ok", "決める", ukRect(bx, by, okW, t.btnSm), UE_B_PRIMARY, st.folderText.length == 0, "");
  const cancel = ueButton(mut ui, t, "wsx.folder.ng", "やめる", ukRect(bx + okW + t.s2, by, ngW, t.btnSm), UE_B_NORMAL, false, "");
  if (ukKeyTake(mut ui, UK_KEY_ENTER) && st.folderText.length > 0) {
    decide = true;
  }
  ukPopLayer(mut ui);
  if (cancel || ukKeyTake(mut ui, UK_KEY_ESC)) {
    st.folderEdit = false;
    return false;
  }
  if (decide) {
    st.folderEdit = false;
    const folder = st.folderText.clone();
    wsxSetFolder(mut st, folder);
    return true;
  }
  return false;
}
