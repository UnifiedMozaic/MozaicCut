// 色のワークスペース（wsc）のスコープの計算: 実際のコマ（描画のキャンバス。Rec.709 の信号の値）から、
// src/effects/color/scope.um の kernel で波形・パレード・ベクトルスコープ・ヒストグラムを作る。
//
// 計算する所（dev）を選べる:
//   WSC_DEV_AUTO  GPU が使えるかぎり GPU（WSC_DEV_GPU と同じ）
//   WSC_DEV_CPU   cpu.dispatch（常に CPU の全コア）
//   WSC_DEV_GPU   gpu.prefer(true) のあいだに dispatch（GPU が使えない・UM_WGPU=1 でないビルドでは CPU）
// 数える段は整数の fetchAdd なので、CPU と GPU で数（RacyBuffer<u32>）は 1 つも違わない。描く段も同じ式で、
// 絵の画素も一致する（tests/ws_color で確かめる）。
// キャンバスは信号の値なので、伝達関数は COL_TF_LINEAR（そのまま測る）、行列は BT.709。
import { COL_TF_LINEAR, ColTfTab, colTfTabNew } from "../../effects/color/transfer.um";
import { COL_YCC_709 } from "../../effects/color/ycbcr.um";
import {
  COL_WAVE_LUMA, COL_WAVE_PARADE, COL_SCOPE_ROWS, COL_VEC_SIZE, COL_VEC_FIT, colWaveAccum, colWaveRender, colWaveCols,
  colVecAccum, colVecRender, colHistAccum, colHistReduce, colHistRender, colHistStrips, colHistMax,
} from "../../effects/color/scope.um";
import { UCP_SC_WAVE, UCP_SC_PARADE, UCP_SC_VECTOR, UCP_SC_HIST } from "../../ui/color/ucp_scope.um";

export const WSC_DEV_AUTO: i32 = 0;
export const WSC_DEV_CPU: i32 = 1;
export const WSC_DEV_GPU: i32 = 2;

export const WSC_SCOPE_GAIN: f32 = 4.0;

export function wscDevName(dev: i32): string {
  if (dev == WSC_DEV_CPU) {
    return "CPU";
  }
  if (dev == WSC_DEV_GPU) {
    if (gpu.available()) {
      return "GPU";
    }
    return "GPU（使えないので CPU）";
  }
  if (gpu.available()) {
    return "自動（CPU / GPU）";
  }
  return "自動（CPU）";
}

export function wscDevFind(name: string): i32 {
  if (name == "cpu") {
    return WSC_DEV_CPU;
  }
  if (name == "gpu") {
    return WSC_DEV_GPU;
  }
  return WSC_DEV_AUTO;
}

// 計算に使う伝達関数の表（COL_TF_LINEAR。一度だけ作る）。
export function wscScopeTab(): ColTfTab {
  return colTfTabNew(COL_TF_LINEAR, 203.0);
}

// ---- 数える ----

// 波形の数（列ごとに 768）。mode は COL_WAVE_LUMA / COL_WAVE_PARADE。
export function wscWaveCounts(dev: i32, t: ColTfTab, px: Buffer<vec4<f32>>, w: u32, h: u32, cols: u32, mode: u32): RacyBuffer<u32> {
  let counts = new RacyBuffer<u32>(Math.max(cols, 1) * 768);
  if (w == 0 || h == 0 || cols == 0) {
    return counts;
  }
  const n = cols * ((h + COL_SCOPE_ROWS - 1) / COL_SCOPE_ROWS);
  if (dev == WSC_DEV_CPU) {
    cpu.dispatch(colWaveAccum, n, mut counts, px, w, h, cols, COL_TF_LINEAR, 203.0, t.enc, COL_YCC_709, mode);
  } else {
    const prev = gpu.prefer(true);
    dispatch(colWaveAccum, n, mut counts, px, w, h, cols, COL_TF_LINEAR, 203.0, t.enc, COL_YCC_709, mode);
    gpu.prefer(prev);
  }
  return counts;
}

export function wscVecCounts(dev: i32, t: ColTfTab, px: Buffer<vec4<f32>>, npx: u32, zoom: f32): RacyBuffer<u32> {
  let counts = new RacyBuffer<u32>(COL_VEC_SIZE * COL_VEC_SIZE);
  if (npx == 0) {
    return counts;
  }
  const chunk: u32 = 256;
  const n = (npx + chunk - 1) / chunk;
  const z = zoom * COL_VEC_FIT;
  if (dev == WSC_DEV_CPU) {
    cpu.dispatch(colVecAccum, n, mut counts, px, npx, chunk, COL_TF_LINEAR, 203.0, t.enc, COL_YCC_709, z);
  } else {
    const prev = gpu.prefer(true);
    dispatch(colVecAccum, n, mut counts, px, npx, chunk, COL_TF_LINEAR, 203.0, t.enc, COL_YCC_709, z);
    gpu.prefer(prev);
  }
  return counts;
}

// ヒストグラムの数（R, G, B, 輝度 の 256 ずつ）。
export function wscHistCounts(dev: i32, t: ColTfTab, px: Buffer<vec4<f32>>, w: u32, h: u32): RacyBuffer<u32> {
  let counts = new RacyBuffer<u32>(1024);
  if (w == 0 || h == 0) {
    return counts;
  }
  const strips = colHistStrips(w);
  let part = new RacyBuffer<u32>(strips * 1024);
  const n = strips * ((h + COL_SCOPE_ROWS - 1) / COL_SCOPE_ROWS);
  if (dev == WSC_DEV_CPU) {
    cpu.dispatch(colHistAccum, n, mut part, px, w, h, strips, COL_TF_LINEAR, 203.0, t.enc, COL_YCC_709);
    cpu.dispatch(colHistReduce, 1024, mut counts, part, strips);
  } else {
    const prev = gpu.prefer(true);
    dispatch(colHistAccum, n, mut part, px, w, h, strips, COL_TF_LINEAR, 203.0, t.enc, COL_YCC_709);
    dispatch(colHistReduce, 1024, mut counts, part, strips);
    gpu.prefer(prev);
  }
  return counts;
}

// ---- 描く ----

function wscWaveMode(kind: i32): u32 {
  return kind == UCP_SC_PARADE ? COL_WAVE_PARADE : COL_WAVE_LUMA;
}

// スコープの絵（outW × outH、0xAARRGGBB）。kind は UCP_SC_*。
export function wscScopeImage(dev: i32, t: ColTfTab, kind: i32, px: Buffer<vec4<f32>>, w: u32, h: u32, outW: u32, outH: u32): Buffer<u32> {
  let img = new Buffer<u32>(Math.max(outW * outH, 1));
  if (outW == 0 || outH == 0) {
    return img;
  }
  const on = outW * outH;
  const prev = gpu.prefer(dev == WSC_DEV_GPU);
  if (kind == UCP_SC_WAVE || kind == UCP_SC_PARADE) {
    const mode = wscWaveMode(kind);
    const cols = colWaveCols(outW, mode);
    const counts = wscWaveCounts(dev, t, px, w, h, cols, mode);
    const perCol = Math.max((w as f32) * (h as f32) / (cols as f32), 1.0);
    const k = WSC_SCOPE_GAIN * (outH as f32) / perCol;
    if (dev == WSC_DEV_CPU) {
      cpu.dispatch(colWaveRender, on, mut img, counts, outW, outH, cols, mode, k);
    } else {
      dispatch(colWaveRender, on, mut img, counts, outW, outH, cols, mode, k);
    }
  } else if (kind == UCP_SC_VECTOR) {
    const counts = wscVecCounts(dev, t, px, w * h, 1.0);
    const side = Math.min(outW, outH);
    const binsPerPx = (COL_VEC_SIZE as f32) * (COL_VEC_SIZE as f32) / ((side as f32) * (side as f32));
    const k = WSC_SCOPE_GAIN * (COL_VEC_SIZE as f32) * (COL_VEC_SIZE as f32)
      / (Math.max((w * h) as f32, 1.0) * Math.max(binsPerPx, 1.0)) * 0.02;
    if (dev == WSC_DEV_CPU) {
      cpu.dispatch(colVecRender, on, mut img, counts, outW, outH, k, COL_YCC_709, COL_VEC_FIT);
    } else {
      dispatch(colVecRender, on, mut img, counts, outW, outH, k, COL_YCC_709, COL_VEC_FIT);
    }
  } else {
    const counts = wscHistCounts(dev, t, px, w, h);
    const m = colHistMax(counts);
    if (dev == WSC_DEV_CPU) {
      cpu.dispatch(colHistRender, on, mut img, counts, outW, outH, m as f32);
    } else {
      dispatch(colHistRender, on, mut img, counts, outW, outH, m as f32);
    }
  }
  gpu.prefer(prev);
  return img;
}

// カーブの後ろに薄く出す輝度のヒストグラム（256 段、最大で割って 0..1）。
export function wscLumaHist(dev: i32, t: ColTfTab, px: Buffer<vec4<f32>>, w: u32, h: u32): f64[] {
  let out: f64[] = [];
  if (w == 0 || h == 0) {
    return out;
  }
  const counts = wscHistCounts(dev, t, px, w, h);
  let m: u32 = 1;
  for (let b: u32 = 1; b < 255; b++) {
    m = Math.max(m, counts[768 + b]);
  }
  for (let b: u32 = 0; b < 256; b++) {
    out.push(Math.min((counts[768 + b] as f64) / (m as f64), 1.0));
  }
  return out;
}

// ---- モニターの絵 ----

// キャンバス（sw × sh の信号の値）を、画像 atlas（幅 aw）の (ax, ay) から ow × oh に縮めて写す。
// 出力の 1 画素に入るキャンバスの画素を、縦横それぞれ最大 4 点で平均する。
// i は atlas の添字（dispatch の数は (ay + oh) × aw。区画の外は何もしない）。
kernel function wscPicKernel(
  i: u32, atlas: mut Buffer<u32>, src: Buffer<vec4<f32>>, sw: u32, sh: u32, ow: u32, oh: u32, ax: u32, ay: u32, aw: u32,
): void {
  const gx = i % aw;
  const gy = i / aw;
  if (gx < ax || gy < ay || gx >= ax + ow || gy >= ay + oh) {
    return;
  }
  const x = gx - ax;
  const y = gy - ay;
  const fx0 = (x as f32) * (sw as f32) / (ow as f32);
  const fx1 = ((x + 1) as f32) * (sw as f32) / (ow as f32);
  const fy0 = (y as f32) * (sh as f32) / (oh as f32);
  const fy1 = ((y + 1) as f32) * (sh as f32) / (oh as f32);
  let r: f32 = 0.0;
  let g: f32 = 0.0;
  let b: f32 = 0.0;
  let n: f32 = 0.0;
  for (let j: u32 = 0; j < 4; j++) {
    const sy = Math.min((fy0 + (fy1 - fy0) * ((j as f32) + 0.5) / 4.0) as u32, sh - 1);
    for (let k: u32 = 0; k < 4; k++) {
      const sx = Math.min((fx0 + (fx1 - fx0) * ((k as f32) + 0.5) / 4.0) as u32, sw - 1);
      const c = src[sy * sw + sx];
      r += c.x;
      g += c.y;
      b += c.z;
      n += 1.0;
    }
  }
  const rr = Math.floor(Math.min(Math.max(r / n, 0.0), 1.0) * 255.0 + 0.5) as u32;
  const gg = Math.floor(Math.min(Math.max(g / n, 0.0), 1.0) * 255.0 + 0.5) as u32;
  const bb = Math.floor(Math.min(Math.max(b / n, 0.0), 1.0) * 255.0 + 0.5) as u32;
  atlas[i] = 0xff000000 | (rr << 16) | (gg << 8) | bb;
}

// 画像 img（w × h）を atlas（幅 aw）の (ax, ay) に写す。
kernel function wscBlitKernel(i: u32, atlas: mut Buffer<u32>, img: Buffer<u32>, w: u32, h: u32, ax: u32, ay: u32, aw: u32): void {
  const gx = i % aw;
  const gy = i / aw;
  if (gx < ax || gy < ay || gx >= ax + w || gy >= ay + h) {
    return;
  }
  atlas[i] = img[(gy - ay) * w + gx - ax];
}

export function wscPutPicture(
  atlas: mut Buffer<u32>, aw: i32, ah: i32, ax: i32, ay: i32, ow: i32, oh: i32, src: Buffer<vec4<f32>>, sw: i32, sh: i32,
): void {
  if (ow <= 0 || oh <= 0 || sw <= 0 || sh <= 0 || ax + ow > aw || ay + oh > ah || (src.length as i32) < sw * sh) {
    return;
  }
  dispatch(wscPicKernel, ((ay + oh) * aw) as u32, mut atlas, src, sw as u32, sh as u32, ow as u32, oh as u32, ax as u32, ay as u32, aw as u32);
}

export function wscPutImage(atlas: mut Buffer<u32>, aw: i32, ah: i32, ax: i32, ay: i32, w: i32, h: i32, img: Buffer<u32>): void {
  if (w <= 0 || h <= 0 || ax + w > aw || ay + h > ah || (img.length as i32) < w * h) {
    return;
  }
  dispatch(wscBlitKernel, ((ay + h) * aw) as u32, mut atlas, img, w as u32, h as u32, ax as u32, ay as u32, aw as u32);
}
