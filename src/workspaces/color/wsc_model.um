// 色のワークスペース（wsc）の値: .mzc のクリップの色の調整（Clip.grade / lut。project.um の grade.*）と、
// 色のパネル（src/ui/color の UcpGrade・UcpEdit）のあいだの写し。
//
//   パネルの key（ucp_state.um）        .mzc のキー
//   temperature / lift / curve.y ...  → grade.temperature / grade.lift / grade.curve.y ...
//   lut / lut.amount / lut.interp     → grade.lut / grade.lut.amount / grade.lut.interp
// 既定の値（何もしない値）にしたときは、行からそのキーを消す（unset）。行に書いていなければ何もしない。
// ドラッグの間（live）はファイルを書かず、読んだ Project のクリップに直接入れて描き直す（wscApplyLive）。
// 離したとき（live でない）に、1 回のドラッグを 1 つの操作（runOps の 1 回）にする（wscOpsFor）。
import { Project, Clip } from "../../engine/project.um";
import { hasKey } from "../../engine/lineedit.um";
import { parseNum, isNan } from "../../engine/text.um";
import { ColCurve, colGradeNew, colGradeSet, colGradeIsIdentity } from "../../effects/color/grade.um";
import { ColDiag, colLoadCube } from "../../effects/color/lut.um";
import { UcpGrade, UcpCurve, UcpEdit, UcpLutItem, ucpGradeNew } from "../../ui/color/ucp_state.um";

// 1 つの取り消しの単位（runOps に 1 回で渡す操作の並び）。
export struct WscOpBatch {
  ops: string[][];
}

function wscCurveOf(c: ColCurve): UcpCurve {
  return { xs: c.xs.clone(), ys: c.ys.clone() };
}

// クリップの調整 → パネルの値。
export function wscGradeOf(c: Clip): UcpGrade {
  let g = ucpGradeNew();
  g.temperature = c.grade.temperature;
  g.tint = c.grade.tint;
  g.exposure = c.grade.exposure;
  g.saturation = c.grade.saturation;
  g.lift = c.grade.lift;
  g.gamma = c.grade.gamma;
  g.gain = c.grade.gain;
  g.offset = c.grade.offset;
  // 並びは Y, R, G, B（UCP_CH_*）
  g.curves[0] = wscCurveOf(c.grade.curveY);
  g.curves[1] = wscCurveOf(c.grade.curveR);
  g.curves[2] = wscCurveOf(c.grade.curveG);
  g.curves[3] = wscCurveOf(c.grade.curveB);
  g.lut = c.lut.clone();
  g.lutAmount = c.lutAmount as f64;
  g.lutTetra = c.lutTetra;
  return g;
}

// パネルの key → .mzc のキー。
export function wscKeyOf(key: string): string {
  return "grade." + key;
}

function wscIsLutKey(key: string): bool {
  return key == "lut" || key == "lut.amount" || key == "lut.interp";
}

// 値が既定（何もしない）か。読めない値は既定ではない（そのまま書いて、診断で知らせる）。
export function wscIsDefault(key: string, val: string): bool {
  if (key == "lut") {
    return val.length == 0;
  }
  if (key == "lut.amount") {
    return parseNum(val) == 1;
  }
  if (key == "lut.interp") {
    return val == "tetrahedral";
  }
  let g = colGradeNew();
  if (colGradeSet(mut g, key, val) != "") {
    return false;
  }
  return colGradeIsIdentity(g);
}

// 操作でクリップを指す名前（ID がなければ @行）。
export function wscClipRef(c: Clip): string {
  if (c.id.length > 0) {
    return c.id.clone();
  }
  return `@${c.line}`;
}

// 1 チャンネルだけのキー（grade.lift.r など）を持つ項目か。パネルは 4 つまとめて（grade.lift）書く。
function wscHasChannels(key: string): bool {
  return key == "lift" || key == "gamma" || key == "gain" || key == "offset";
}

// 1 つの変更の操作（なければ空）。line はクリップの行の今の文。
// lift / gamma / gain / offset は、行にある 1 チャンネルのキー（grade.lift.r など）を先に消す
// （残すと、まとめて書いた値を上書きしたり、既定に戻しても値が残ったりする）。
function wscOpFor(c: Clip, line: string, e: UcpEdit): string[][] {
  const k = wscKeyOf(e.key);
  const ref = wscClipRef(c);
  let ops: string[][] = [];
  if (wscHasChannels(e.key)) {
    const chs: string[] = ["r", "g", "b", "m"];
    for (const ch of chs) {
      const sk = k + "." + ch;
      if (hasKey(line, sk)) {
        ops.push(["unset", ref.clone(), sk]);
      }
    }
  }
  if (wscIsDefault(e.key, e.val)) {
    if (hasKey(line, k)) {
      ops.push(["unset", ref.clone(), k]);
    }
    return ops;
  }
  ops.push(["set", ref.clone(), `${k}=${e.val}`]);
  return ops;
}

// このフレームの変更（live でなく、当てられるもの）を、取り消しの単位ごとの操作にする。
// 同じ batch の番号（0 でない）は 1 つにまとめる。何もしない変更（行にない既定の値）は落とす。
export function wscOpsFor(p: Project, lines: string[], ci: usize, edits: UcpEdit[]): WscOpBatch[] {
  let out: WscOpBatch[] = [];
  if (ci >= p.clips.length) {
    return out;
  }
  const ln = (p.clips[ci].line - 1) as usize;
  if (ln >= lines.length) {
    return out;
  }
  let batchIds: i32[] = [];
  for (const e of edits) {
    if (e.live || !e.valid) {
      continue;
    }
    const ops = wscOpFor(p.clips[ci], lines[ln], e);
    if (ops.length == 0) {
      continue;
    }
    if (e.batch != 0) {
      let found = -1;
      for (let k: usize = 0; k < batchIds.length; k++) {
        if (batchIds[k] == e.batch) {
          found = k as i32;
        }
      }
      if (found >= 0) {
        for (const op of ops) {
          let cp: string[] = [];
          for (const w of op) {
            cp.push(w.clone());
          }
          out[found as usize].ops.push(cp);
        }
        continue;
      }
      batchIds.push(e.batch);
    } else {
      batchIds.push(0);
    }
    out.push({ ops });
  }
  return out;
}

// ドラッグの間の値を、読んだ Project のクリップに直接入れる（ファイルは書かない）。読めない値なら false。
export function wscApplyLive(p: mut Project, ci: usize, key: string, val: string): bool {
  if (ci >= p.clips.length) {
    return false;
  }
  if (key == "lut") {
    p.clips[ci].lut = val.clone();
    return true;
  }
  if (key == "lut.amount") {
    const g = parseNum(val);
    if (isNan(g) || g < 0 || g > 1) {
      return false;
    }
    p.clips[ci].lutAmount = g as f32;
    return true;
  }
  if (key == "lut.interp") {
    p.clips[ci].lutTetra = val != "trilinear";
    return true;
  }
  if (colGradeSet(mut p.clips[ci].grade, key, val) != "") {
    return false;
  }
  p.clips[ci].hasGrade = !colGradeIsIdentity(p.clips[ci].grade);
  return true;
}

// .cube を読んで、パネルの LUT の一覧の 1 つにする。name は表示の名前、path は .mzc に書く値、file は読む場所。
export function wscLutItem(name: string, path: string, file: string): UcpLutItem {
  let diags: ColDiag[] = [];
  const l = colLoadCube(file, mut diags);
  let info = "";
  if (l.size3 >= 2) {
    info = `3D · ${l.size3}³`;
  }
  if (l.size1 >= 2) {
    if (info.length > 0) {
      info = `1D ${l.size1} + ` + info;
    } else {
      info = `1D · ${l.size1}`;
    }
  }
  if (l.ok) {
    info = info + ` · 入力 ${wscRange(l.min3.x as f64)}〜${wscRange(l.max3.x as f64)}`;
  }
  let it: UcpLutItem = {
    name: name.clone(), path: path.clone(), info, ok: l.ok, diagCode: "", diagSev: "", diagMsg: "", diagHint: "", diagWhere: "",
  };
  for (const d of diags) {
    if (d.severity == "error" || it.diagCode.length == 0) {
      it.diagCode = d.code.clone();
      it.diagSev = d.severity.clone();
      it.diagMsg = d.msg.clone();
      it.diagHint = d.hint.clone();
      if (d.line > 0) {
        it.diagWhere = `${name}:${d.line}`;
      } else {
        it.diagWhere = name.clone();
      }
      if (d.severity == "error") {
        break;
      }
    }
  }
  return it;
}

function wscRange(v: f64): string {
  if (v == Math.floor(v)) {
    return `${v as i64}`;
  }
  return `${v}`;
}
