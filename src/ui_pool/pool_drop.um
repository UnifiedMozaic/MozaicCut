// 素材のドロップの受け口。
//
// UM の窓の組み込み（SDL3）には、まだファイルのドロップのイベントが無い。来たら次のようにつなぐ:
//   SDL_EVENT_DROP_BEGIN              → poolDropBegin(mut drag)
//   SDL_EVENT_DROP_POSITION (x, y)    → poolDropMove(mut drag, x, y, density)  … 素材の欄・スタート画面の受け口の上なら印を出す
//   SDL_EVENT_DROP_FILE (path, x, y)  → poolDropAddPath(mut drag, path, x, y, density)
//   SDL_EVENT_DROP_COMPLETE (x, y)    → 落とした所に応じて poolDropPlan（素材の欄）/ poolStartDrop（pool_start.um）を呼び、poolDropEnd
// SDL3 のドロップの x, y は窓の座標（論理の点）で、UkRect は画素。density は SDL_GetWindowPixelDensity の値
// （125% なら 1.25、150% なら 1.5。ui.md 20 章）で、ここで画素に直す。uikit が窓のイベントを画素に直すようになったら 1.0 を渡す。
// ui.md 8 章「素材の欄に落とせばビンに、タイムラインに落とせばその位置に入る（UM に位置つきのドロップのイベントが要る）」。
import { UkRect, ukInside } from "../uikit/base.um";
import { POOL_K_VIDEO, POOL_K_AUDIO, POOL_K_TEXT, POOL_K_IMAGE } from "./pool_tokens.um";
import { PoolLib, PoolState, PoolMedia, POOL_SMART_NONE } from "./pool_model.um";

// 運ばれてきているもの（窓の外から）。
export struct PoolDrag {
  active: bool;
  x: i32;
  y: i32;
  paths: string[];
}

export function poolDragNew(): PoolDrag {
  return { active: false, x: -1, y: -1, paths: [] };
}

export function poolDropBegin(d: mut PoolDrag): void {
  d.active = true;
  d.paths.clear();
}

// 窓の座標（論理の点）を画素に直す。
export function poolDropToPx(v: f32, density: f32): i32 {
  const k = density > 0.0 ? density : 1.0;
  return Math.floor(v * k + 0.5) as i32;
}

export function poolDropMove(d: mut PoolDrag, x: f32, y: f32, density: f32): void {
  d.x = poolDropToPx(x, density);
  d.y = poolDropToPx(y, density);
}

export function poolDropAddPath(d: mut PoolDrag, path: string, x: f32, y: f32, density: f32): void {
  d.paths.push(path.clone());
  d.x = poolDropToPx(x, density);
  d.y = poolDropToPx(y, density);
}

export function poolDropEnd(d: mut PoolDrag): void {
  d.active = false;
  d.paths.clear();
  d.x = -1;
  d.y = -1;
}

// 運んでいるものが四角 r の上にあるか（素材の欄なら st.dropHover に入れる）。
export function poolDropOver(d: PoolDrag, r: UkRect): bool {
  return d.active && ukInside(r, d.x, d.y);
}

// ---- 場所の名前から ----

function poolLowerExt(path: string): string {
  let dot: i64 = -1;
  for (let i: usize = 0; i < path.length; i++) {
    if (path[i] == 46) {
      dot = i as i64;
    } else if (path[i] == 47 || path[i] == 92) {
      dot = -1;
    }
  }
  if (dot < 0) {
    return "";
  }
  let out: u8[] = [];
  for (let i = (dot as usize) + 1; i < path.length; i++) {
    let b = path[i];
    if (b >= 65 && b <= 90) {
      b = b + 32;
    }
    out.push(b);
  }
  return stringFromBytes(out);
}

// ファイルの名前（場所の最後の部分）。
export function poolBaseName(path: string): string {
  let s: usize = 0;
  for (let i: usize = 0; i < path.length; i++) {
    if (path[i] == 47 || path[i] == 92) {
      s = i + 1;
    }
  }
  let out: u8[] = [];
  for (let i = s; i < path.length; i++) {
    out.push(path[i]);
  }
  return stringFromBytes(out);
}

// 拡張子から素材の種類（-1 は素材でない。-2 は .mzc＝プロジェクト）。gif は動く絵として映像に入れる。
export function poolKindOfPath(path: string): i32 {
  const e = poolLowerExt(path);
  switch (e) {
    case "mp4": return POOL_K_VIDEO;
    case "mov": return POOL_K_VIDEO;
    case "mkv": return POOL_K_VIDEO;
    case "webm": return POOL_K_VIDEO;
    case "avi": return POOL_K_VIDEO;
    case "mxf": return POOL_K_VIDEO;
    case "m4v": return POOL_K_VIDEO;
    case "mts": return POOL_K_VIDEO;
    case "m2ts": return POOL_K_VIDEO;
    case "ts": return POOL_K_VIDEO;
    case "mpg": return POOL_K_VIDEO;
    case "mpeg": return POOL_K_VIDEO;
    case "wmv": return POOL_K_VIDEO;
    case "3gp": return POOL_K_VIDEO;
    case "flv": return POOL_K_VIDEO;
    case "gif": return POOL_K_VIDEO;
    case "wav": return POOL_K_AUDIO;
    case "mp3": return POOL_K_AUDIO;
    case "aac": return POOL_K_AUDIO;
    case "m4a": return POOL_K_AUDIO;
    case "flac": return POOL_K_AUDIO;
    case "ogg": return POOL_K_AUDIO;
    case "opus": return POOL_K_AUDIO;
    case "aif": return POOL_K_AUDIO;
    case "aiff": return POOL_K_AUDIO;
    case "wma": return POOL_K_AUDIO;
    case "png": return POOL_K_IMAGE;
    case "jpg": return POOL_K_IMAGE;
    case "jpeg": return POOL_K_IMAGE;
    case "webp": return POOL_K_IMAGE;
    case "tif": return POOL_K_IMAGE;
    case "tiff": return POOL_K_IMAGE;
    case "bmp": return POOL_K_IMAGE;
    case "heic": return POOL_K_IMAGE;
    case "avif": return POOL_K_IMAGE;
    case "exr": return POOL_K_IMAGE;
    case "srt": return POOL_K_TEXT;
    case "vtt": return POOL_K_TEXT;
    case "ass": return POOL_K_TEXT;
    case "ssa": return POOL_K_TEXT;
    case "mzc": return -2;
  }
  return -1;
}

// 場所の最後の部分に「.」が無ければフォルダとみなす（中の素材は編集画面が広げて読む）。
export function poolLooksLikeFolder(p: string): bool {
  let dot = false;
  for (let i: usize = 0; i < p.length; i++) {
    if (p[i] == 47 || p[i] == 92) {
      dot = false;
    } else {
      if (p[i] == 46) {
        dot = true;
      }
    }
  }
  return !dot && p.length > 0;
}

// 素材の欄に落としたものの振り分け（欄は lib を書き換えない。編集画面がこれを見て import の op を作る。ui.md 14 章の取り消しと履歴を通すため）。
export struct PoolDropPlan {
  // 読み込む素材の場所（同じ場所の素材がもうあるものは除いた）と、入れるビン（自分で作ったビンの番号。-1 は入れない）
  paths: string[];
  kinds: i32[];
  bin: i32;
  // フォルダ（中の素材は編集画面が広げて、同じように読む）
  folders: string[];
  // 読めない形式のファイルの場所（状態の帯に出す）
  rejected: string[];
  // もう素材の欄にあったので読まないものの数
  dups: i32;
}

// 落とした場所の一覧を振り分ける（lib と st は読むだけ）。
export function poolDropPlan(lib: PoolLib, st: PoolState, paths: string[]): PoolDropPlan {
  let plan: PoolDropPlan = { paths: [], kinds: [], bin: -1, folders: [], rejected: [], dups: 0 };
  if (st.bin >= 0 && (st.bin as usize) < lib.bins.length && lib.bins[st.bin as usize].smart == POOL_SMART_NONE) {
    plan.bin = st.bin;
  }
  for (const p of paths) {
    const k = poolKindOfPath(p);
    if (k < 0) {
      if (k == -1 && poolLooksLikeFolder(p)) {
        plan.folders.push(p.clone());
      } else {
        plan.rejected.push(p.clone());
      }
      continue;
    }
    // 同じ場所の素材はもう一度入れない
    let dup = false;
    for (const m of lib.media) {
      if (m.path == p) {
        dup = true;
      }
    }
    for (const q of plan.paths) {
      if (q == p) {
        dup = true;
      }
    }
    if (dup) {
      plan.dups = plan.dups + 1;
      continue;
    }
    plan.paths.push(p.clone());
    plan.kinds.push(k);
  }
  return plan;
}

// 振り分けの結果を、状態の帯に出す 1 文にする（何も言うことがなければ ""）。
//   例:「素材を 3 個読み込みます。2 個は読めない形式でした（メモ.docx ほか）」
export function poolDropNote(plan: PoolDropPlan): string {
  let s = "";
  const n = plan.paths.length as i32;
  if (n > 0 || plan.folders.length > 0) {
    s = `素材を ${n} 個読み込みます`;
    if (plan.folders.length > 0) {
      s = s + `（フォルダ ${plan.folders.length} 個の中も読みます）`;
    }
    s = s + "。";
  }
  if (plan.rejected.length > 0) {
    s = s + `${plan.rejected.length} 個は読めない形式でした（${poolBaseName(plan.rejected[0])}`;
    if (plan.rejected.length > 1) {
      s = s + " ほか";
    }
    s = s + "）。";
  }
  if (plan.dups > 0) {
    s = s + `${plan.dups} 個はもう素材にあります。`;
  }
  return s;
}

// 編集画面が読み込みの op から作る素材の形（ID は op が付ける。縮小画像はまだ）。見本と試しで使う。
export function poolNewMedia(path: string, kind: i32, bin: i32, now: i64): PoolMedia {
  return {
    id: "", name: poolBaseName(path), path: path.clone(), kind, durSec: 0.0, fpsNum: 0, fpsDen: 0, w: 0, h: 0, codec: "",
    note: "", usedFrac: 0.0, useCount: 0, offline: false, proxy: false, thumbReady: false, label: -1, importedAt: now,
    inSec: -1.0, outSec: -1.0, bin, aiPicked: false, aiWhy: "", aiAccepted: false, thumb: 0,
  };
}
