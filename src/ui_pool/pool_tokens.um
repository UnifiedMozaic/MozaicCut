// メディアプールとスタート画面のトークン: docs/design/tokens.json から、この 2 つの画面が使う色・寸法・文字の大きさを読む。
// uikit の UkTheme は汎用の色しか持たないので、素材の種類の色・意味の色の tint・カードの寸法などはここに持つ。
// 値は必ず tokens.json の道筋（"color.dark.bg.0" など）で引き、読めなければ既定（tokens.json version 2 と同じ値）のまま。
// 寸法は UI の倍率を掛けた画素で持つ（poolTkScale）。
import { ukParseHex } from "../uikit/theme.um";

// tokens.json を「道筋 → 値の文字列」の平らな表にしたもの。
export struct PoolTokTable {
  keys: string[];
  vals: string[];
}

function poolJsonWs(s: string, i0: usize): usize {
  let i = i0;
  while (i < s.length && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) {
    i++;
  }
  return i;
}

function poolJsonStr(s: string, i0: usize, end: mut usize[]): string {
  let out: u8[] = [];
  let i = i0 + 1;
  while (i < s.length && s[i] != 34) {
    if (s[i] == 92 && i + 1 < s.length) {
      i++;
    }
    out.push(s[i]);
    i++;
  }
  end[0] = i + 1;
  return stringFromBytes(out);
}

function poolJoinPath(path: string[]): string {
  let s = "";
  for (let i: usize = 0; i < path.length; i++) {
    if (i > 0) {
      s = s + ".";
    }
    s = s + path[i];
  }
  return s;
}

// JSON を平らな表にする。配列の要素は "道筋.0"、"道筋.1"… になる。
export function poolTokParse(json: string): PoolTokTable {
  let t: PoolTokTable = { keys: [], vals: [] };
  let path: string[] = [];
  let isObj: bool[] = [];
  let idx: i32[] = [];
  let pendingKey = false;
  let end: usize[] = [0];
  let i = poolJsonWs(json, 0);
  while (i < json.length) {
    const b = json[i];
    if (b == 123) {
      isObj.push(true);
      idx.push(0);
      path.push("");
      pendingKey = true;
      i++;
    } else if (b == 125 || b == 93) {
      if (isObj.length == 0) {
        return t;
      }
      isObj.pop();
      idx.pop();
      path.pop();
      i++;
    } else if (b == 91) {
      isObj.push(false);
      idx.push(0);
      path.push("0");
      i++;
    } else if (b == 44) {
      const d = isObj.length;
      if (d > 0) {
        if (isObj[d - 1]) {
          pendingKey = true;
        } else {
          idx[d - 1] = idx[d - 1] + 1;
          path[d - 1] = `${idx[d - 1]}`;
        }
      }
      i++;
    } else if (b == 58) {
      pendingKey = false;
      i++;
    } else if (b == 34) {
      const str = poolJsonStr(json, i, mut end);
      i = end[0];
      if (pendingKey && path.length > 0) {
        path[path.length - 1] = str;
        pendingKey = false;
      } else {
        t.keys.push(poolJoinPath(path));
        t.vals.push(str);
      }
    } else if (b == 32 || b == 9 || b == 10 || b == 13) {
      i++;
    } else {
      // 数・true・false・null
      let j = i;
      while (j < json.length && json[j] != 44 && json[j] != 125 && json[j] != 93 && json[j] != 32 && json[j] != 10 && json[j] != 13) {
        j++;
      }
      let raw: u8[] = [];
      for (let k = i; k < j; k++) {
        raw.push(json[k]);
      }
      t.keys.push(poolJoinPath(path));
      t.vals.push(stringFromBytes(raw));
      i = j;
    }
  }
  return t;
}

function poolTokFind(t: PoolTokTable, key: string): i64 {
  for (let i: usize = 0; i < t.keys.length; i++) {
    if (t.keys[i] == key) {
      return i as i64;
    }
  }
  return -1;
}

// 色（0xAARRGGBB）。なければ d。
export function poolTokColor(t: PoolTokTable, key: string, d: u32): u32 {
  const k = poolTokFind(t, key);
  if (k < 0) {
    return d;
  }
  const v = ukParseHex(t.vals[k as usize]);
  if (v < 0) {
    return d;
  }
  return v as u32;
}

// 数（小数も可）。なければ d。
export function poolTokNum(t: PoolTokTable, key: string, d: f32): f32 {
  const k = poolTokFind(t, key);
  if (k < 0) {
    return d;
  }
  const s = t.vals[k as usize].clone();
  let v: f32 = 0.0;
  let neg = false;
  let seen = false;
  let i: usize = 0;
  if (i < s.length && s[i] == 45) {
    neg = true;
    i++;
  }
  while (i < s.length && s[i] >= 48 && s[i] <= 57) {
    v = v * 10.0 + ((s[i] - 48) as f32);
    seen = true;
    i++;
  }
  if (i < s.length && s[i] == 46) {
    i++;
    let f: f32 = 0.1;
    while (i < s.length && s[i] >= 48 && s[i] <= 57) {
      v = v + ((s[i] - 48) as f32) * f;
      f = f * 0.1;
      seen = true;
      i++;
    }
  }
  if (!seen) {
    return d;
  }
  return neg ? -v : v;
}

// 文字列。なければ d。
export function poolTokStr(t: PoolTokTable, key: string, d: string): string {
  const k = poolTokFind(t, key);
  if (k < 0) {
    return d.clone();
  }
  return t.vals[k as usize].clone();
}

// ---- この 2 つの画面のトークン ----

export struct PoolTk {
  scale: f32;
  // 面
  bg0: u32;
  bg1: u32;
  bg2: u32;
  bg3: u32;
  bg4: u32;
  bgPopover: u32;
  line: u32;
  lineStrong: u32;
  lineControl: u32;
  // 文字
  text1: u32;
  text2: u32;
  text3: u32;
  textDis: u32;
  onAccent: u32;
  onDark: u32;
  // 意味の色
  accent: u32;
  accentHover: u32;
  accentTint: u32;
  accentTintSolid: u32;
  ok: u32;
  okTint: u32;
  warn: u32;
  warnTint: u32;
  error: u32;
  errorTint: u32;
  ai: u32;
  aiTint: u32;
  textSource: u32;
  textSourceTint: u32;
  hatchNeutral: u32;
  shadow: u32;
  // 素材の種類（mark と face）。並びは POOL_K_*
  kindMark: u32[5];
  kindFace: u32[5];
  tagBg: u32;
  // 選択（素材の格子・リスト・カードの輪は selection.list、フォーカスの二重の輪の外側は selection.clipOuter）
  selList: u32;
  selOuter: u32;
  // ラベルの 8 色と名前（label.*.name。利用者が名前を変えられる）
  labels: u32[8];
  labelNames: string[];
  // 文字の大きさ（倍率を掛けた画素）
  fsXs: f32;
  fsSm: f32;
  fsMd: f32;
  fsLg: f32;
  fsXl: f32;
  // 余白（space.1〜6）
  s1: i32;
  s2: i32;
  s3: i32;
  s4: i32;
  s5: i32;
  s6: i32;
  // 角
  rSm: i32;
  rMd: i32;
  rLg: i32;
  // 線
  hair: i32;
  focusW: i32;
  labelEdge: i32;
  // 決まった寸法
  topBar: i32;
  panelHeader: i32;
  statusBar: i32;
  row: i32;
  field: i32;
  fieldDialog: i32;
  btnSm: i32;
  btnMd: i32;
  btnLg: i32;
  iconSm: i32;
  iconMd: i32;
  hitMin: i32;
  startLeft: i32;
  startDrop: i32;
  startCardThumb: i32;
  // 素材の欄の寸法（ui.md 8 章。tokens.json にまだ無いので pool.* の道筋で引き、なければ ui.md の値）
  thumbH: i32;
  useBar: i32;
  hatchPeriod: i32;
  // 倍率を掛ける前の寸法（poolTkScale で使う）。並びは POOL_D_*
  base: f32[48];
}

// 素材の種類
export const POOL_K_VIDEO: i32 = 0;
export const POOL_K_AUDIO: i32 = 1;
export const POOL_K_TEXT: i32 = 2;
export const POOL_K_IMAGE: i32 = 3;
export const POOL_K_COLOR: i32 = 4;

const POOL_D_FS_XS: usize = 0;
const POOL_D_FS_SM: usize = 1;
const POOL_D_FS_MD: usize = 2;
const POOL_D_FS_LG: usize = 3;
const POOL_D_FS_XL: usize = 4;
const POOL_D_S1: usize = 5;
const POOL_D_S2: usize = 6;
const POOL_D_S3: usize = 7;
const POOL_D_S4: usize = 8;
const POOL_D_S5: usize = 9;
const POOL_D_S6: usize = 10;
const POOL_D_R_SM: usize = 11;
const POOL_D_R_MD: usize = 12;
const POOL_D_R_LG: usize = 13;
const POOL_D_HAIR: usize = 14;
const POOL_D_FOCUS: usize = 15;
const POOL_D_LABEL_EDGE: usize = 16;
const POOL_D_TOP_BAR: usize = 17;
const POOL_D_PANEL_HEADER: usize = 18;
const POOL_D_STATUS_BAR: usize = 19;
const POOL_D_ROW: usize = 20;
const POOL_D_FIELD: usize = 21;
const POOL_D_FIELD_DIALOG: usize = 22;
const POOL_D_BTN_SM: usize = 23;
const POOL_D_BTN_MD: usize = 24;
const POOL_D_BTN_LG: usize = 25;
const POOL_D_ICON_SM: usize = 26;
const POOL_D_ICON_MD: usize = 27;
const POOL_D_HIT_MIN: usize = 28;
const POOL_D_START_LEFT: usize = 29;
const POOL_D_START_DROP: usize = 30;
const POOL_D_START_THUMB: usize = 31;
const POOL_D_THUMB_H: usize = 32;
const POOL_D_USE_BAR: usize = 33;
const POOL_D_HATCH: usize = 34;

function poolTkPx(v: f32, s: f32): i32 {
  return Math.max(Math.floor(v * s + 0.5) as i32, 1);
}

// 線は倍率を掛けたあとで整数の画素に吸着させる（tokens.json の scale.note）。
function poolTkLine(v: f32, s: f32): i32 {
  return Math.max(Math.floor(v * Math.floor(s + 0.5) + 0.5) as i32, 1);
}

// 倍率を変える（0.8〜2.0）。
export function poolTkScale(t: mut PoolTk, scale: f32): void {
  let s = scale;
  if (!(s >= 0.8)) {
    s = 0.8;
  }
  s = Math.min(s, 2.0);
  t.scale = s;
  t.fsXs = t.base[POOL_D_FS_XS] * s;
  t.fsSm = t.base[POOL_D_FS_SM] * s;
  t.fsMd = t.base[POOL_D_FS_MD] * s;
  t.fsLg = t.base[POOL_D_FS_LG] * s;
  t.fsXl = t.base[POOL_D_FS_XL] * s;
  t.s1 = poolTkPx(t.base[POOL_D_S1], s);
  t.s2 = poolTkPx(t.base[POOL_D_S2], s);
  t.s3 = poolTkPx(t.base[POOL_D_S3], s);
  t.s4 = poolTkPx(t.base[POOL_D_S4], s);
  t.s5 = poolTkPx(t.base[POOL_D_S5], s);
  t.s6 = poolTkPx(t.base[POOL_D_S6], s);
  t.rSm = poolTkPx(t.base[POOL_D_R_SM], s);
  t.rMd = poolTkPx(t.base[POOL_D_R_MD], s);
  t.rLg = poolTkPx(t.base[POOL_D_R_LG], s);
  t.hair = poolTkLine(t.base[POOL_D_HAIR], s);
  t.focusW = poolTkLine(t.base[POOL_D_FOCUS], s);
  t.labelEdge = poolTkLine(t.base[POOL_D_LABEL_EDGE], s);
  t.topBar = poolTkPx(t.base[POOL_D_TOP_BAR], s);
  t.panelHeader = poolTkPx(t.base[POOL_D_PANEL_HEADER], s);
  t.statusBar = poolTkPx(t.base[POOL_D_STATUS_BAR], s);
  t.row = poolTkPx(t.base[POOL_D_ROW], s);
  t.field = poolTkPx(t.base[POOL_D_FIELD], s);
  t.fieldDialog = poolTkPx(t.base[POOL_D_FIELD_DIALOG], s);
  t.btnSm = poolTkPx(t.base[POOL_D_BTN_SM], s);
  t.btnMd = poolTkPx(t.base[POOL_D_BTN_MD], s);
  t.btnLg = poolTkPx(t.base[POOL_D_BTN_LG], s);
  t.iconSm = poolTkPx(t.base[POOL_D_ICON_SM], s);
  t.iconMd = poolTkPx(t.base[POOL_D_ICON_MD], s);
  t.hitMin = poolTkPx(t.base[POOL_D_HIT_MIN], s);
  t.startLeft = poolTkPx(t.base[POOL_D_START_LEFT], s);
  t.startDrop = poolTkPx(t.base[POOL_D_START_DROP], s);
  t.startCardThumb = poolTkPx(t.base[POOL_D_START_THUMB], s);
  t.thumbH = poolTkPx(t.base[POOL_D_THUMB_H], s);
  t.useBar = poolTkLine(t.base[POOL_D_USE_BAR], s);
  t.hatchPeriod = poolTkPx(t.base[POOL_D_HATCH], s);
}

// 既定（tokens.json version 2 の値）。
export function poolTkDefault(scale: f32): PoolTk {
  let base: f32[48];
  base[POOL_D_FS_XS] = 11.0;
  base[POOL_D_FS_SM] = 12.0;
  base[POOL_D_FS_MD] = 13.0;
  base[POOL_D_FS_LG] = 15.0;
  base[POOL_D_FS_XL] = 20.0;
  base[POOL_D_S1] = 4.0;
  base[POOL_D_S2] = 8.0;
  base[POOL_D_S3] = 12.0;
  base[POOL_D_S4] = 16.0;
  base[POOL_D_S5] = 24.0;
  base[POOL_D_S6] = 32.0;
  base[POOL_D_R_SM] = 3.0;
  base[POOL_D_R_MD] = 5.0;
  base[POOL_D_R_LG] = 8.0;
  base[POOL_D_HAIR] = 1.0;
  base[POOL_D_FOCUS] = 2.0;
  base[POOL_D_LABEL_EDGE] = 3.0;
  base[POOL_D_TOP_BAR] = 40.0;
  base[POOL_D_PANEL_HEADER] = 32.0;
  base[POOL_D_STATUS_BAR] = 24.0;
  base[POOL_D_ROW] = 28.0;
  base[POOL_D_FIELD] = 24.0;
  base[POOL_D_FIELD_DIALOG] = 32.0;
  base[POOL_D_BTN_SM] = 24.0;
  base[POOL_D_BTN_MD] = 28.0;
  base[POOL_D_BTN_LG] = 36.0;
  base[POOL_D_ICON_SM] = 16.0;
  base[POOL_D_ICON_MD] = 20.0;
  base[POOL_D_HIT_MIN] = 24.0;
  base[POOL_D_START_LEFT] = 420.0;
  base[POOL_D_START_DROP] = 160.0;
  base[POOL_D_START_THUMB] = 150.0;
  base[POOL_D_THUMB_H] = 64.0;
  base[POOL_D_USE_BAR] = 3.0;
  base[POOL_D_HATCH] = 6.0;
  let t: PoolTk = {
    scale: 1.0,
    bg0: 0xff141414, bg1: 0xff1b1b1b, bg2: 0xff222222, bg3: 0xff2c2c2c, bg4: 0xff383838, bgPopover: 0xff1f1f1f,
    line: 0xff2c2c2c, lineStrong: 0xff3c3c3c, lineControl: 0xff767676,
    text1: 0xffe6e6e6, text2: 0xffa3a3a3, text3: 0xff8c8c8c, textDis: 0xff666666, onAccent: 0xff141414,
    onDark: 0xfff2f2f2,
    accent: 0xff4c8dff, accentHover: 0xff6fa3ff, accentTint: 0x294c8dff, accentTintSolid: 0xff1e2a3d,
    ok: 0xff4cc38a, okTint: 0x244cc38a, warn: 0xfff08a3c, warnTint: 0x24f08a3c, error: 0xffff6b6b,
    errorTint: 0x24ff6b6b, ai: 0xffbd97f7, aiTint: 0x24bd97f7, textSource: 0xffd8d2c4, textSourceTint: 0x24d8d2c4,
    hatchNeutral: 0x40ffffff, shadow: 0x80000000,
    kindMark: [0xff56b4e9, 0xff2fbf8f, 0xffcc79a7, 0xffe69f00, 0xffbdbdbd],
    kindFace: [0xff234a63, 0xff1e4a3c, 0xff52304a, 0xff54401c, 0xff3d3d3d],
    tagBg: 0x59000000, selList: 0xff4c8dff, selOuter: 0xff000000,
    labels: [0xffc48a14, 0xff4a9ac6, 0xff13a077, 0xffcfc43c, 0xff2a86c8, 0xffd0662a, 0xffb06b92, 0xff848484],
    labelNames: ["橙", "空色", "緑", "黄", "青", "朱", "赤紫", "灰"],
    fsXs: 11.0, fsSm: 12.0, fsMd: 13.0, fsLg: 15.0, fsXl: 20.0,
    s1: 4, s2: 8, s3: 12, s4: 16, s5: 24, s6: 32, rSm: 3, rMd: 5, rLg: 8, hair: 1, focusW: 2, labelEdge: 3,
    topBar: 40, panelHeader: 32, statusBar: 24, row: 28, field: 24, fieldDialog: 32, btnSm: 24, btnMd: 28, btnLg: 36,
    iconSm: 16, iconMd: 20, hitMin: 24, startLeft: 420, startDrop: 160, startCardThumb: 150, thumbH: 64, useBar: 3,
    hatchPeriod: 6,
    base,
  };
  poolTkScale(mut t, scale);
  return t;
}

function poolTkSetBase(t: mut PoolTk, tb: PoolTokTable, i: usize, key: string): void {
  t.base[i] = poolTokNum(tb, key, t.base[i]);
}

// tokens.json の中身を読んで反映する。読んだ値の数を返す（目安）。
export function poolTkFromTokens(t: mut PoolTk, json: string): i32 {
  const tb = poolTokParse(json);
  const c = "color.dark.";
  t.bg0 = poolTokColor(tb, c + "bg.0", t.bg0);
  t.bg1 = poolTokColor(tb, c + "bg.1", t.bg1);
  t.bg2 = poolTokColor(tb, c + "bg.2", t.bg2);
  t.bg3 = poolTokColor(tb, c + "bg.3", t.bg3);
  t.bg4 = poolTokColor(tb, c + "bg.4", t.bg4);
  t.bgPopover = poolTokColor(tb, c + "bg.popover", t.bgPopover);
  t.line = poolTokColor(tb, c + "line.default", t.line);
  t.lineStrong = poolTokColor(tb, c + "line.strong", t.lineStrong);
  t.lineControl = poolTokColor(tb, c + "line.control", t.lineControl);
  t.text1 = poolTokColor(tb, c + "text.1", t.text1);
  t.text2 = poolTokColor(tb, c + "text.2", t.text2);
  t.text3 = poolTokColor(tb, c + "text.3", t.text3);
  t.textDis = poolTokColor(tb, c + "text.disabled", t.textDis);
  t.onAccent = poolTokColor(tb, c + "text.onAccent", t.onAccent);
  t.onDark = poolTokColor(tb, c + "text.onDark", t.onDark);
  t.accent = poolTokColor(tb, c + "accent.default", t.accent);
  t.accentHover = poolTokColor(tb, c + "accent.hover", t.accentHover);
  t.accentTint = poolTokColor(tb, c + "accent.tint", t.accentTint);
  t.accentTintSolid = poolTokColor(tb, c + "accent.tintSolid", t.accentTintSolid);
  const se = c + "semantic.";
  t.ok = poolTokColor(tb, se + "ok", t.ok);
  t.okTint = poolTokColor(tb, se + "okTint", t.okTint);
  t.warn = poolTokColor(tb, se + "warn", t.warn);
  t.warnTint = poolTokColor(tb, se + "warnTint", t.warnTint);
  t.error = poolTokColor(tb, se + "error", t.error);
  t.errorTint = poolTokColor(tb, se + "errorTint", t.errorTint);
  t.ai = poolTokColor(tb, se + "ai", t.ai);
  t.aiTint = poolTokColor(tb, se + "aiTint", t.aiTint);
  t.textSource = poolTokColor(tb, se + "textSource", t.textSource);
  t.textSourceTint = poolTokColor(tb, se + "textSourceTint", t.textSourceTint);
  t.hatchNeutral = poolTokColor(tb, se + "hatchNeutral", t.hatchNeutral);
  const kinds: string[] = ["video", "audio", "text", "image", "color"];
  for (let k: usize = 0; k < 5; k++) {
    t.kindMark[k] = poolTokColor(tb, c + "clip." + kinds[k] + ".mark", t.kindMark[k]);
    t.kindFace[k] = poolTokColor(tb, c + "clip." + kinds[k] + ".face", t.kindFace[k]);
  }
  t.tagBg = poolTokColor(tb, c + "clip.tagBg", t.tagBg);
  t.selList = poolTokColor(tb, c + "selection.list", t.selList);
  t.selOuter = poolTokColor(tb, c + "selection.clipOuter", t.selOuter);
  const labs: string[] = ["orange", "sky", "green", "yellow", "blue", "vermilion", "purple", "gray"];
  for (let k: usize = 0; k < 8; k++) {
    t.labels[k] = poolTokColor(tb, c + "label." + labs[k] + ".value", t.labels[k]);
    t.labelNames[k] = poolTokStr(tb, c + "label." + labs[k] + ".name", t.labelNames[k]);
  }
  poolTkSetBase(mut t, tb, POOL_D_FS_XS, "font.size.xs.size");
  poolTkSetBase(mut t, tb, POOL_D_FS_SM, "font.size.sm.size");
  poolTkSetBase(mut t, tb, POOL_D_FS_MD, "font.size.md.size");
  poolTkSetBase(mut t, tb, POOL_D_FS_LG, "font.size.lg.size");
  poolTkSetBase(mut t, tb, POOL_D_FS_XL, "font.size.xl.size");
  poolTkSetBase(mut t, tb, POOL_D_S1, "space.1");
  poolTkSetBase(mut t, tb, POOL_D_S2, "space.2");
  poolTkSetBase(mut t, tb, POOL_D_S3, "space.3");
  poolTkSetBase(mut t, tb, POOL_D_S4, "space.4");
  poolTkSetBase(mut t, tb, POOL_D_S5, "space.5");
  poolTkSetBase(mut t, tb, POOL_D_S6, "space.6");
  poolTkSetBase(mut t, tb, POOL_D_R_SM, "radius.sm");
  poolTkSetBase(mut t, tb, POOL_D_R_MD, "radius.md");
  poolTkSetBase(mut t, tb, POOL_D_R_LG, "radius.lg");
  poolTkSetBase(mut t, tb, POOL_D_HAIR, "border.hairline");
  poolTkSetBase(mut t, tb, POOL_D_FOCUS, "border.focus");
  poolTkSetBase(mut t, tb, POOL_D_LABEL_EDGE, "border.labelEdge");
  poolTkSetBase(mut t, tb, POOL_D_TOP_BAR, "size.topBar");
  poolTkSetBase(mut t, tb, POOL_D_PANEL_HEADER, "size.panelHeader");
  poolTkSetBase(mut t, tb, POOL_D_STATUS_BAR, "size.statusBar");
  poolTkSetBase(mut t, tb, POOL_D_ROW, "size.propertyRow");
  poolTkSetBase(mut t, tb, POOL_D_FIELD, "size.field");
  poolTkSetBase(mut t, tb, POOL_D_FIELD_DIALOG, "size.fieldDialog");
  poolTkSetBase(mut t, tb, POOL_D_BTN_SM, "size.button.sm");
  poolTkSetBase(mut t, tb, POOL_D_BTN_MD, "size.button.md");
  poolTkSetBase(mut t, tb, POOL_D_BTN_LG, "size.button.lg");
  poolTkSetBase(mut t, tb, POOL_D_ICON_SM, "size.icon.sm");
  poolTkSetBase(mut t, tb, POOL_D_ICON_MD, "size.icon.md");
  poolTkSetBase(mut t, tb, POOL_D_HIT_MIN, "size.hitTargetMin");
  poolTkSetBase(mut t, tb, POOL_D_START_LEFT, "size.start.left");
  poolTkSetBase(mut t, tb, POOL_D_START_DROP, "size.start.drop");
  poolTkSetBase(mut t, tb, POOL_D_START_THUMB, "size.start.cardThumb");
  poolTkSetBase(mut t, tb, POOL_D_THUMB_H, "size.pool.thumb");
  poolTkSetBase(mut t, tb, POOL_D_USE_BAR, "size.pool.useBar");
  poolTkSetBase(mut t, tb, POOL_D_HATCH, "pattern.hatch.period");
  const sc = t.scale;
  poolTkScale(mut t, sc);
  return tb.keys.length as i32;
}
