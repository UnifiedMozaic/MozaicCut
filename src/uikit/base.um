// uikit の土台: 四角、色、UTF-8、ハッシュ。ほかの uikit のファイルはみなこれを使う。
// 名前の空間は全ファイルで 1 つなので、uikit の名前はすべて uk / Uk / UK_ で始める。

// 画面の四角（画素。左上が (x, y)、幅 w、高さ h）。
export struct UkRect {
  x: i32;
  y: i32;
  w: i32;
  h: i32;
}

export function ukRect(x: i32, y: i32, w: i32, h: i32): UkRect {
  return { x, y, w: Math.max(w, 0), h: Math.max(h, 0) };
}

export function ukInside(r: UkRect, x: i32, y: i32): bool {
  return x >= r.x && y >= r.y && x < r.x + r.w && y < r.y + r.h;
}

// 2 つの四角の重なり（重ならなければ幅か高さが 0）。
export function ukIntersect(a: UkRect, b: UkRect): UkRect {
  const x0 = Math.max(a.x, b.x);
  const y0 = Math.max(a.y, b.y);
  const x1 = Math.min(a.x + a.w, b.x + b.w);
  const y1 = Math.min(a.y + a.h, b.y + b.h);
  return { x: x0, y: y0, w: Math.max(x1 - x0, 0), h: Math.max(y1 - y0, 0) };
}

export function ukEmpty(r: UkRect): bool {
  return r.w <= 0 || r.h <= 0;
}

// 四角を内側に d 画素縮める（負なら広げる）。
export function ukShrink(r: UkRect, d: i32): UkRect {
  return { x: r.x + d, y: r.y + d, w: Math.max(r.w - 2 * d, 0), h: Math.max(r.h - 2 * d, 0) };
}

// ---- 色（0xAARRGGBB） ----

export function ukRgba(r: i32, g: i32, b: i32, a: i32): u32 {
  const cr = (Math.min(Math.max(r, 0), 255)) as u32;
  const cg = (Math.min(Math.max(g, 0), 255)) as u32;
  const cb = (Math.min(Math.max(b, 0), 255)) as u32;
  const ca = (Math.min(Math.max(a, 0), 255)) as u32;
  return (ca << 24) | (cr << 16) | (cg << 8) | cb;
}

// 不透明度を掛ける（a は 0〜255）。
export function ukAlpha(c: u32, a: i32): u32 {
  const ca = (c >> 24) & 255;
  const na = (ca * (Math.min(Math.max(a, 0), 255) as u32) + 127) / 255;
  return (na << 24) | (c & 0xffffff);
}

// 2 色を t（0〜256）で混ぜる。t=0 で a、256 で b。
export function ukMix(a: u32, b: u32, t: i32): u32 {
  const tt = Math.min(Math.max(t, 0), 256) as u32;
  const it = 256 - tt;
  const ca = (((a >> 24) & 255) * it + ((b >> 24) & 255) * tt) >> 8;
  const cr = (((a >> 16) & 255) * it + ((b >> 16) & 255) * tt) >> 8;
  const cg = (((a >> 8) & 255) * it + ((b >> 8) & 255) * tt) >> 8;
  const cb = ((a & 255) * it + (b & 255) * tt) >> 8;
  return (ca << 24) | (cr << 16) | (cg << 8) | cb;
}

// 明るくする（amt>0）・暗くする（amt<0）。amt は -256〜256。
export function ukShade(c: u32, amt: i32): u32 {
  if (amt >= 0) {
    return ukMix(c, (c & 0xff000000) | 0xffffff, amt);
  }
  return ukMix(c, c & 0xff000000, -amt);
}

// ---- ハッシュ（FNV-1a） ----

export const UK_FNV: u32 = 2166136261;

export function ukHashStr(h0: u32, s: string): u32 {
  let h = h0;
  for (const b of s) {
    h = (h ^ (b as u32)) * 16777619;
  }
  return h;
}

export function ukHashU32(h0: u32, v: u32): u32 {
  let h = h0;
  h = (h ^ (v & 255)) * 16777619;
  h = (h ^ ((v >> 8) & 255)) * 16777619;
  h = (h ^ ((v >> 16) & 255)) * 16777619;
  h = (h ^ (v >> 24)) * 16777619;
  return h;
}

export function ukHashI32(h0: u32, v: i32): u32 {
  return ukHashU32(h0, v as u32);
}

// ---- UTF-8 ----

// 文字列の a バイト目から b バイト目の手前まで。
export function ukSub(s: string, a: usize, b: usize): string {
  const e = Math.min(b, s.length);
  if (a >= e) {
    return "";
  }
  let out = new Array<u8>(e - a);
  for (let i = a; i < e; i++) {
    out[i - a] = s[i];
  }
  return stringFromBytes(out);
}

// 符号位置を UTF-8 のバイト列にして out に足す。
export function ukPushUtf8(out: mut u8[], cp: u32): void {
  if (cp < 0x80) {
    out.push(cp as u8);
  } else if (cp < 0x800) {
    out.push((0xc0 | (cp >> 6)) as u8);
    out.push((0x80 | (cp & 63)) as u8);
  } else if (cp < 0x10000) {
    out.push((0xe0 | (cp >> 12)) as u8);
    out.push((0x80 | ((cp >> 6) & 63)) as u8);
    out.push((0x80 | (cp & 63)) as u8);
  } else {
    out.push((0xf0 | (cp >> 18)) as u8);
    out.push((0x80 | ((cp >> 12) & 63)) as u8);
    out.push((0x80 | ((cp >> 6) & 63)) as u8);
    out.push((0x80 | (cp & 63)) as u8);
  }
}

// 位置 i（バイト）の次の文字の先頭。
export function ukNextChar(s: string, i: usize): usize {
  if (i >= s.length) {
    return s.length;
  }
  let j = i + 1;
  while (j < s.length && (s[j] & 0xc0) == 0x80) {
    j++;
  }
  return j;
}

// 位置 i（バイト）の前の文字の先頭。
export function ukPrevChar(s: string, i: usize): usize {
  if (i == 0) {
    return 0;
  }
  let j = Math.min(i, s.length) - 1;
  while (j > 0 && (s[j] & 0xc0) == 0x80) {
    j--;
  }
  return j;
}

// 文字列 a の位置 at（バイト）に b を入れた新しい文字列。
export function ukInsert(a: string, at: usize, b: string): string {
  const p = Math.min(at, a.length);
  let out = new Array<u8>(a.length + b.length);
  for (let i: usize = 0; i < p; i++) {
    out[i] = a[i];
  }
  for (let i: usize = 0; i < b.length; i++) {
    out[p + i] = b[i];
  }
  for (let i = p; i < a.length; i++) {
    out[b.length + i] = a[i];
  }
  return stringFromBytes(out);
}

// 文字列 a の [x, y) を消した新しい文字列。
export function ukErase(a: string, x: usize, y: usize): string {
  const p = Math.min(x, a.length);
  const q = Math.min(Math.max(y, p), a.length);
  let out = new Array<u8>(a.length - (q - p));
  for (let i: usize = 0; i < p; i++) {
    out[i] = a[i];
  }
  for (let i = q; i < a.length; i++) {
    out[p + i - q] = a[i];
  }
  return stringFromBytes(out);
}

// 表示する部分（"保存##save" の "##" より前）。"##" がなければ全体。
export function ukLabel(s: string): string {
  for (let i: usize = 0; i + 1 < s.length; i++) {
    if (s[i] == 35 && s[i + 1] == 35) {
      return ukSub(s, 0, i);
    }
  }
  return s.clone();
}

export function ukIntText(v: i64): string {
  return `${v}`;
}

// 有限の数か（NaN と ±無限大は false）。
export function ukFinite(v: f64): bool {
  return v - v == 0.0;
}

// 小数を桁数 d で文字にする（d は 0〜6）。
// |v| が 1e15 を超える数は i64 に収まらないので、指数の形（"1.5e20"）で書く。NaN は "NaN"、無限大は "∞" / "-∞"。
export function ukFixed(v: f64, d0: i32): string {
  if (v != v) {
    return "NaN";
  }
  if (!ukFinite(v)) {
    if (v > 0.0) {
      return "∞";
    }
    return "-∞";
  }
  const d = Math.min(Math.max(d0, 0), 6);
  if (Math.abs(v) > 1e15) {
    return ukSci(v);
  }
  let m: f64 = 1.0;
  for (let i = 0; i < d; i++) {
    m = m * 10.0;
  }
  const neg = v < 0.0;
  const a = Math.floor(Math.abs(v) * m + 0.5) as i64;
  const ip = a / (m as i64);
  let s = `${ip}`;
  if (d > 0) {
    const fp = a % (m as i64);
    let fs = `${fp}`;
    while ((fs.length as i32) < d) {
      fs = "0" + fs;
    }
    s = s + "." + fs;
  }
  if (neg && a != 0) {
    s = "-" + s;
  }
  return s;
}

// 大きな数を "仮数e指数"（仮数は有効数字 4 桁）で書く。
function ukSci(v: f64): string {
  const neg = v < 0.0;
  let a = Math.abs(v);
  let e = 0;
  while (a >= 10.0) {
    a = a / 10.0;
    e++;
  }
  let q = Math.floor(a * 1000.0 + 0.5) as i64;
  if (q >= 10000) {
    q = q / 10;
    e++;
  }
  let fs = `${q % 1000}`;
  while (fs.length < 3) {
    fs = "0" + fs;
  }
  const s = `${q / 1000}.${fs}e${e}`;
  if (neg) {
    return "-" + s;
  }
  return s;
}
