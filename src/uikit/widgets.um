// uikit の部品: ボタン、トグル、チェック、ラジオ、スライダー、数値とタイムコードの入力欄、文字の入力欄、
// ドロップダウン、メニュー（右クリックを含む）、一覧（仮想化）、ダイアログ、進み具合、文字と見出し。
//
// 値は「渡して、新しい値を返してもらう」形で扱う（v = ukSlider(mut ui, "音量", v, ...)）。
// 直前の部品で値が変わったかは ui.lastChanged、入力欄で Enter を押したかは ui.lastSubmit で分かる。
// ラベルの "##" より後ろは ID の区別だけに使い、表示しない（"削除##clip3"）。
import {
  UkRect, ukRect, ukShrink, ukInside, ukIntersect, ukLabel, ukSub, ukNextChar, ukPrevChar, ukInsert, ukErase, ukFixed,
  ukAlpha, ukMix, ukFinite,
} from "./base.um";
import {
  UkCtx, UkHit, ukBehavior, ukBehaviorEx, ukId, ukIdInt, ukSt, ukPushId, ukPopId, ukPushLayer, ukPopLayer, ukPushClip, ukPopClip,
  ukPushClipScreen, ukBlock, ukMouseIn, ukKeyTake, ukKeyTakeMods, ukTextTake, ukFocus, ukDrawRect, ukDrawRound,
  ukDrawStroke, ukDrawShadow, ukDrawText, ukDrawTextIn, ukDrawLine, ukTextW, ukLineH, ukTextPrefixW, ukTextHit,
  ukTooltip, UK_KEY_ENTER, UK_KEY_ESC, UK_KEY_BACKSPACE, UK_KEY_DELETE, UK_KEY_LEFT, UK_KEY_RIGHT, UK_KEY_UP,
  UK_KEY_DOWN, UK_KEY_HOME, UK_KEY_END, UK_KEY_PGUP, UK_KEY_PGDN, UK_KEY_SPACE, UK_KEY_CHAR, UK_MOD_SHIFT, UK_MOD_CTRL,
  UK_MOD_META, UK_MOD_ALT, UK_L_MODAL, UK_L_POPUP, ukDrawCircle, ukPushIdInt, ukWakeAt, ukStPin,
} from "./core.um";
import { ukNext, ukTopBox, ukBeginRowAt, ukBeginColAt, ukEndBox, ukBeginScrollH, ukEndScroll, UK_COL } from "./layout.um";
import {
  ukIcon, UK_I_NONE, UK_I_CHECK, UK_I_DOWN, UK_I_RIGHT, UK_I_CLOSE, UK_I_DOT,
} from "./icons.um";

// ボタンの種類
export const UK_BTN_SECONDARY: i32 = 0;
export const UK_BTN_PRIMARY: i32 = 1;
export const UK_BTN_DANGER: i32 = 2;
export const UK_BTN_QUIET: i32 = 3;

// フォーカスの輪（キーボードで動かしたときだけ見せる）。
export function ukFocusRing(ui: mut UkCtx, r: UkRect, h: UkHit): void {
  if (h.focused && ui.focusVisible) {
    ukDrawStroke(mut ui, ukShrink(r, -2), ui.theme.radius + 2, 2, ui.theme.focus);
  }
}

// ---- 文字と見出し ----

export function ukTextLine(ui: mut UkCtx, s: string): void {
  const fs = ui.theme.fontSize;
  const w = ukTextW(mut ui, s, fs);
  const r = ukNext(mut ui, w, ukLineH(ui, fs) + 4);
  ukDrawTextIn(mut ui, r, s, fs, ui.theme.text, 0);
}

export function ukTextDim(ui: mut UkCtx, s: string): void {
  const fs = ui.theme.fontSmall;
  const w = ukTextW(mut ui, s, fs);
  const r = ukNext(mut ui, w, ukLineH(ui, fs) + 4);
  ukDrawTextIn(mut ui, r, s, fs, ui.theme.textDim, 0);
}

export function ukHeading(ui: mut UkCtx, s: string): void {
  const fs = ui.theme.fontLarge;
  const w = ukTextW(mut ui, s, fs);
  const r = ukNext(mut ui, w, ukLineH(ui, fs) + 6);
  ukDrawTextIn(mut ui, r, s, fs, ui.theme.text, 0);
}

// 小さな見出し（区切りの名前。上に余白、下に線）。
export function ukSection(ui: mut UkCtx, s: string): void {
  const fs = ui.theme.fontSmall;
  const r = ukNext(mut ui, ukTextW(mut ui, s, fs), ukLineH(ui, fs) + ui.theme.gap * 2);
  ukDrawTextIn(mut ui, ukRect(r.x, r.y + ui.theme.gap, r.w, r.h - ui.theme.gap - 2), s, fs, ui.theme.textDim, 0);
  ukDrawRect(mut ui, ukRect(r.x, r.y + r.h - 1, r.w, 1), ui.theme.border);
}

export function ukSeparator(ui: mut UkCtx): void {
  const r = ukNext(mut ui, 1, ui.theme.gap + 1);
  ukDrawRect(mut ui, ukRect(r.x, r.y + r.h / 2, Math.max(r.w, 1), Math.max(r.h > 2 ? 1 : 0, 1)), ui.theme.border);
}

// 名前つきの 1 行（左に名前、右に部品）。ukEndBox で閉じる。
export function ukBeginProp(ui: mut UkCtx, name: string, nameW: i32): void {
  const k = ukTopBox(ui);
  const r = ukNext(mut ui, ui.boxes[k].r.w, ui.theme.ctrlH);
  ukBeginRowAt(mut ui, r, [nameW, -1]);
  const nr = ukNext(mut ui, nameW, r.h);
  ukDrawTextIn(mut ui, nr, ukLabel(name), ui.theme.fontSize, ui.theme.textDim, 0);
}

// ---- ボタン ----

function ukBtnColors(ui: UkCtx, kind: i32, h: UkHit, off: bool): u32[] {
  // [地, 文字, 枠]
  const t = ui.theme;
  if (off) {
    if (kind == UK_BTN_QUIET) {
      return [0, t.textOff, 0];
    }
    return [t.raisedActive, t.textOff, t.border];
  }
  const down = h.held && h.hover;
  if (kind == UK_BTN_PRIMARY) {
    return [down ? t.accentActive : (h.hover ? t.accentHover : t.accent), t.onAccent, 0];
  }
  if (kind == UK_BTN_DANGER) {
    return [down ? ukMix(t.danger, 0xff000000, 40) : (h.hover ? t.dangerHover : t.danger), t.onAccent, 0];
  }
  if (kind == UK_BTN_QUIET) {
    return [down ? t.raisedActive : (h.hover ? t.raisedHover : 0), t.text, 0];
  }
  return [down ? t.raisedActive : (h.hover ? t.raisedHover : t.raised), t.text, t.border];
}

// ボタン。押されたら true。kind は UK_BTN_*、icon は UK_I_*（なしは UK_I_NONE）。
export function ukButtonEx(ui: mut UkCtx, label: string, kind: i32, icon: i32): bool {
  const id = ukId(ui, label);
  const txt = ukLabel(label);
  const fs = ui.theme.fontSize;
  const tw = ukTextW(mut ui, txt, fs);
  let nw = tw + ui.theme.pad * 2;
  if (icon != UK_I_NONE) {
    nw = nw + ui.theme.icon + (tw > 0 ? ui.theme.gap : 0);
  }
  const r = ukNext(mut ui, Math.max(nw, ui.theme.ctrlH), ui.theme.ctrlH);
  const off = ui.disabled > 0;
  const h = ukBehavior(mut ui, id, r, true);
  const c = ukBtnColors(ui, kind, h, off);
  if ((c[0] >> 24) != 0) {
    ukDrawRound(mut ui, r, ui.theme.radius, c[0]);
  }
  if ((c[2] >> 24) != 0) {
    ukDrawStroke(mut ui, r, ui.theme.radius, ui.theme.stroke, c[2]);
  }
  // 中身（アイコンと文字）を中央に
  let cw = tw;
  if (icon != UK_I_NONE) {
    cw = cw + ui.theme.icon + (tw > 0 ? ui.theme.gap : 0);
  }
  let x = r.x + Math.max((r.w - cw) / 2, ui.theme.pad);
  // 中身は自分の四角で切り取る（狭い行で隣にはみ出さない）
  ukPushClip(mut ui, r);
  if (icon != UK_I_NONE) {
    ukIcon(mut ui, ukRect(x, r.y + (r.h - ui.theme.icon) / 2, ui.theme.icon, ui.theme.icon), icon, c[1]);
    x = x + ui.theme.icon + ui.theme.gap;
  }
  if (tw > 0) {
    ukDrawTextIn(mut ui, ukRect(x, r.y, r.x + r.w - x - ui.theme.pad / 2, r.h), txt, fs, c[1], 0);
  }
  ukPopClip(mut ui);
  ukFocusRing(mut ui, r, h);
  return h.clicked;
}

export function ukButton(ui: mut UkCtx, label: string): bool {
  return ukButtonEx(mut ui, label, UK_BTN_SECONDARY, UK_I_NONE);
}

export function ukButtonPrimary(ui: mut UkCtx, label: string): bool {
  return ukButtonEx(mut ui, label, UK_BTN_PRIMARY, UK_I_NONE);
}

export function ukButtonDanger(ui: mut UkCtx, label: string): bool {
  return ukButtonEx(mut ui, label, UK_BTN_DANGER, UK_I_NONE);
}

// アイコンだけのボタン（正方形）。ラベルはツールチップに出す（"##" より前）。
export function ukIconButton(ui: mut UkCtx, label: string, icon: i32, on: bool): bool {
  const id = ukId(ui, label);
  const r = ukNext(mut ui, ui.theme.ctrlH, ui.theme.ctrlH);
  const off = ui.disabled > 0;
  const h = ukBehavior(mut ui, id, r, true);
  let c = ukBtnColors(ui, UK_BTN_QUIET, h, off);
  if (on && !off) {
    c[0] = ui.theme.selection;
    c[1] = ui.theme.text;
  }
  if ((c[0] >> 24) != 0) {
    ukDrawRound(mut ui, r, ui.theme.radius, c[0]);
  }
  const s = ui.theme.icon;
  // アイコンは自分の四角で切り取る（四角がアイコンより狭いとき、隣の文字に重ならない）
  ukPushClip(mut ui, r);
  ukIcon(mut ui, ukRect(r.x + (r.w - s) / 2, r.y + (r.h - s) / 2, s, s), icon, c[1]);
  ukPopClip(mut ui);
  ukFocusRing(mut ui, r, h);
  const tip = ukLabel(label);
  ukTooltip(mut ui, tip);
  return h.clicked;
}

// ---- トグル・チェック・ラジオ ----

export function ukToggle(ui: mut UkCtx, label: string, on: bool): bool {
  const id = ukId(ui, label);
  const txt = ukLabel(label);
  const fs = ui.theme.fontSize;
  const th = Math.max(ui.theme.ctrlH * 3 / 5, 10);
  const tw = th * 9 / 5;
  const r = ukNext(mut ui, tw + ui.theme.gap + ukTextW(mut ui, txt, fs), ui.theme.ctrlH);
  const off = ui.disabled > 0;
  const h = ukBehavior(mut ui, id, r, true);
  let v = on;
  if (h.clicked) {
    v = !v;
    ui.lastChanged = true;
  }
  const tr = ukRect(r.x, r.y + (r.h - th) / 2, tw, th);
  ukPushClip(mut ui, r);
  let bg = v ? (h.hover ? ui.theme.accentHover : ui.theme.accent) : (h.hover ? ui.theme.borderStrong : ui.theme.track);
  if (off) {
    bg = ui.theme.raisedActive;
  }
  ukDrawRound(mut ui, tr, th / 2, bg);
  if (!v) {
    ukDrawStroke(mut ui, tr, th / 2, ui.theme.stroke, ui.theme.border);
  }
  const kr = (th as f32) * 0.5 - 2.5;
  const kx = v ? (tr.x + tr.w) as f32 - (th as f32) * 0.5 : (tr.x as f32) + (th as f32) * 0.5;
  ukDrawCircle2(mut ui, kx, (tr.y as f32) + (th as f32) * 0.5, kr, off ? ui.theme.textOff : 0xffffffff);
  ukDrawTextIn(mut ui, ukRect(tr.x + tw + ui.theme.gap, r.y, r.w - tw - ui.theme.gap, r.h), txt, fs,
    off ? ui.theme.textOff : ui.theme.text, 0);
  ukPopClip(mut ui);
  if (h.focused && ui.focusVisible) {
    ukDrawStroke(mut ui, ukShrink(tr, -2), th / 2 + 2, 2, ui.theme.focus);
  }
  return v;
}

function ukDrawCircle2(ui: mut UkCtx, cx: f32, cy: f32, r: f32, c: u32): void {
  const sh = ui.theme.shadow;
  ukDrawCircleCmd(mut ui, cx, cy + 0.6, r + 0.6, ukAlpha(sh, 120));
  ukDrawCircleCmd(mut ui, cx, cy, r, c);
}

function ukDrawCircleCmd(ui: mut UkCtx, cx: f32, cy: f32, r: f32, c: u32): void {
  // 円は core の命令で描く（t=0 で塗り）
  ukDrawCircleFill(mut ui, cx, cy, r, c);
}

function ukDrawCircleFill(ui: mut UkCtx, cx: f32, cy: f32, r: f32, c: u32): void {
  ukDrawCircle(mut ui, cx, cy, r, 0.0, c);
}

export function ukCheck(ui: mut UkCtx, label: string, on: bool): bool {
  const id = ukId(ui, label);
  const txt = ukLabel(label);
  const fs = ui.theme.fontSize;
  const bs = ui.theme.icon + 2;
  const r = ukNext(mut ui, bs + ui.theme.gap + ukTextW(mut ui, txt, fs), ui.theme.ctrlH);
  const off = ui.disabled > 0;
  const h = ukBehavior(mut ui, id, r, true);
  let v = on;
  if (h.clicked) {
    v = !v;
    ui.lastChanged = true;
  }
  const br = ukRect(r.x, r.y + (r.h - bs) / 2, bs, bs);
  ukPushClip(mut ui, r);
  if (v) {
    ukDrawRound(mut ui, br, ui.theme.radiusSm, off ? ui.theme.raisedActive : (h.hover ? ui.theme.accentHover : ui.theme.accent));
    ukIcon(mut ui, ukShrink(br, 1), UK_I_CHECK, off ? ui.theme.textOff : ui.theme.onAccent);
  } else {
    ukDrawRound(mut ui, br, ui.theme.radiusSm, ui.theme.inputBg);
    ukDrawStroke(mut ui, br, ui.theme.radiusSm, ui.theme.stroke, h.hover ? ui.theme.textDim : ui.theme.borderStrong);
  }
  ukDrawTextIn(mut ui, ukRect(br.x + bs + ui.theme.gap, r.y, r.w - bs - ui.theme.gap, r.h), txt, fs,
    off ? ui.theme.textOff : ui.theme.text, 0);
  ukPopClip(mut ui);
  if (h.focused && ui.focusVisible) {
    ukDrawStroke(mut ui, ukShrink(br, -2), ui.theme.radiusSm + 2, 2, ui.theme.focus);
  }
  return v;
}

// ラジオ: 選ばれている値 cur と、この選択肢の値 val。押されたら val を返す。
export function ukRadio(ui: mut UkCtx, label: string, cur: i32, val: i32): i32 {
  const id = ukId(ui, label);
  const txt = ukLabel(label);
  const fs = ui.theme.fontSize;
  const bs = ui.theme.icon + 2;
  const r = ukNext(mut ui, bs + ui.theme.gap + ukTextW(mut ui, txt, fs), ui.theme.ctrlH);
  const off = ui.disabled > 0;
  const h = ukBehavior(mut ui, id, r, true);
  let v = cur;
  if (h.clicked && cur != val) {
    v = val;
    ui.lastChanged = true;
  }
  const on = v == val;
  const cx = (r.x as f32) + (bs as f32) * 0.5;
  const cy = (r.y as f32) + (r.h as f32) * 0.5;
  const rad = (bs as f32) * 0.5;
  ukPushClip(mut ui, r);
  if (on) {
    ukDrawCircle(mut ui, cx, cy, rad, 0.0, off ? ui.theme.raisedActive : (h.hover ? ui.theme.accentHover : ui.theme.accent));
    ukDrawCircle(mut ui, cx, cy, rad * 0.4, 0.0, off ? ui.theme.textOff : ui.theme.onAccent);
  } else {
    ukDrawCircle(mut ui, cx, cy, rad, 0.0, ui.theme.inputBg);
    ukDrawCircle(mut ui, cx, cy, rad, ui.theme.stroke as f32, h.hover ? ui.theme.textDim : ui.theme.borderStrong);
  }
  ukDrawTextIn(mut ui, ukRect(r.x + bs + ui.theme.gap, r.y, r.w - bs - ui.theme.gap, r.h), txt, fs,
    off ? ui.theme.textOff : ui.theme.text, 0);
  ukPopClip(mut ui);
  if (h.focused && ui.focusVisible) {
    ukDrawCircle(mut ui, cx, cy, rad + 2.5, 2.0, ui.theme.focus);
  }
  return v;
}

// ---- 文字の編集の芯（入力欄・数値の入力欄が使う） ----
//
// 覚えておく値: i[0] カーソル、i[1] 選択の端、i[2] 横のスクロール（画素）、d[1] 点滅の始まり。
// クリップボードは ui.clipboard（OS の組み込みが来たら、ここを OS とつなぐ）。
// IME の途中の文字は ui.imeText（組み込みが来たら window.um から ukEventImeComposition で入れる）をカーソルの所に下線つきで描く。

function ukClampChar(s: string, p0: i32): i32 {
  let p = Math.min(Math.max(p0, 0), s.length as i32) as usize;
  while (p > 0 && p < s.length && (s[p] & 0xc0) == 0x80) {
    p--;
  }
  return p as i32;
}

function ukIsWordByte(b: u8): bool {
  return (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128;
}

function ukWordLeft(s: string, p0: usize): usize {
  let p = p0;
  while (p > 0 && !ukIsWordByte(s[ukPrevChar(s, p)])) {
    p = ukPrevChar(s, p);
  }
  while (p > 0 && ukIsWordByte(s[ukPrevChar(s, p)])) {
    p = ukPrevChar(s, p);
  }
  return p;
}

function ukWordRight(s: string, p0: usize): usize {
  let p = p0;
  while (p < s.length && !ukIsWordByte(s[p])) {
    p = ukNextChar(s, p);
  }
  while (p < s.length && ukIsWordByte(s[p])) {
    p = ukNextChar(s, p);
  }
  return p;
}

// 選択を消した文字列（選択がなければそのまま）。カーソルと端を st に書く。
function ukDelSel(ui: mut UkCtx, si: usize, s: string): string {
  const a = Math.min(ui.st[si].i[0], ui.st[si].i[1]) as usize;
  const b = Math.max(ui.st[si].i[0], ui.st[si].i[1]) as usize;
  if (a == b) {
    return s.clone();
  }
  ui.st[si].i[0] = a as i32;
  ui.st[si].i[1] = a as i32;
  return ukErase(s, a, b);
}

// 文字を編集し、描く。inner は文字を置く四角。戻り値は新しい文字列。
export function ukTextEdit(ui: mut UkCtx, id: u32, si: usize, inner: UkRect, text: string, h: UkHit, color: u32): string {
  const fs = ui.theme.fontSize;
  let s = text.clone();
  ui.st[si].i[0] = ukClampChar(s, ui.st[si].i[0]);
  ui.st[si].i[1] = ukClampChar(s, ui.st[si].i[1]);
  const scroll0 = ui.st[si].i[2];
  let moved = false;
  // マウス
  if (h.pressed) {
    const p = ukTextHit(ui, s, ui.inp.mx - inner.x + scroll0, fs) as i32;
    ui.st[si].i[0] = p;
    if ((ui.inp.mods & UK_MOD_SHIFT) == 0) {
      ui.st[si].i[1] = p;
    }
    if (h.dbl) {
      ui.st[si].i[1] = 0;
      ui.st[si].i[0] = s.length as i32;
    }
    moved = true;
  } else if (h.held) {
    ui.st[si].i[0] = ukTextHit(ui, s, ui.inp.mx - inner.x + scroll0, fs) as i32;
    moved = true;
  }
  // ダイアログが開いている間は、下の層の入力欄にキーを渡さない
  const focused = ui.focus == id && ui.layer >= ui.modal;
  if (focused) {
    ui.textActive = true;
    // 1 文字のキー（修飾キーなし）は入力欄のもの。アプリのショートカットに渡さない
    for (let k: usize = 0; k < ui.inp.keys.length; k++) {
      const key = ui.inp.keys[k];
      const m = ui.inp.keyMods[k];
      if (key >= UK_KEY_CHAR && (m & (UK_MOD_CTRL | UK_MOD_META)) == 0) {
        ui.inp.keys[k] = 0;
      }
    }
    for (let k: usize = 0; k < ui.inp.keys.length; k++) {
      const key = ui.inp.keys[k];
      if (key == 0) {
        continue;
      }
      const m = ui.inp.keyMods[k];
      const shift = (m & UK_MOD_SHIFT) != 0;
      const ctrl = (m & (UK_MOD_CTRL | UK_MOD_META)) != 0;
      let took = true;
      const cur = ui.st[si].i[0] as usize;
      if (key == UK_KEY_LEFT || key == UK_KEY_RIGHT || key == UK_KEY_HOME || key == UK_KEY_END) {
        const a = Math.min(ui.st[si].i[0], ui.st[si].i[1]);
        const b = Math.max(ui.st[si].i[0], ui.st[si].i[1]);
        let np = cur;
        if (key == UK_KEY_LEFT) {
          np = ctrl ? ukWordLeft(s, cur) : ukPrevChar(s, cur);
          if (!shift && a != b) {
            np = a as usize;
          }
        } else if (key == UK_KEY_RIGHT) {
          np = ctrl ? ukWordRight(s, cur) : ukNextChar(s, cur);
          if (!shift && a != b) {
            np = b as usize;
          }
        } else if (key == UK_KEY_HOME) {
          np = 0;
        } else {
          np = s.length;
        }
        ui.st[si].i[0] = np as i32;
        if (!shift) {
          ui.st[si].i[1] = np as i32;
        }
      } else if (key == UK_KEY_BACKSPACE || key == UK_KEY_DELETE) {
        if (ui.st[si].i[0] != ui.st[si].i[1]) {
          s = ukDelSel(mut ui, si, s);
        } else if (key == UK_KEY_BACKSPACE && cur > 0) {
          const p = ctrl ? ukWordLeft(s, cur) : ukPrevChar(s, cur);
          s = ukErase(s, p, cur);
          ui.st[si].i[0] = p as i32;
          ui.st[si].i[1] = p as i32;
        } else if (key == UK_KEY_DELETE && cur < s.length) {
          const p = ctrl ? ukWordRight(s, cur) : ukNextChar(s, cur);
          s = ukErase(s, cur, p);
        }
        ui.lastChanged = true;
      } else if (key == UK_KEY_ENTER) {
        ui.lastSubmit = true;
      } else if (key == UK_KEY_ESC) {
        ui.focus = 0;
      } else if (ctrl && key == UK_KEY_CHAR + 97) {        // Ctrl+A
        ui.st[si].i[1] = 0;
        ui.st[si].i[0] = s.length as i32;
      } else if (ctrl && (key == UK_KEY_CHAR + 99 || key == UK_KEY_CHAR + 120)) {   // Ctrl+C / Ctrl+X
        const a = Math.min(ui.st[si].i[0], ui.st[si].i[1]) as usize;
        const b = Math.max(ui.st[si].i[0], ui.st[si].i[1]) as usize;
        if (a != b) {
          ui.clipboard = ukSub(s, a, b);
          if (key == UK_KEY_CHAR + 120) {
            s = ukDelSel(mut ui, si, s);
            ui.lastChanged = true;
          }
        }
      } else if (ctrl && key == UK_KEY_CHAR + 118) {       // Ctrl+V
        s = ukDelSel(mut ui, si, s);
        const c = ui.clipboard.clone();
        const p = ui.st[si].i[0] as usize;
        s = ukInsert(s, p, c);
        ui.st[si].i[0] = (p + c.length) as i32;
        ui.st[si].i[1] = ui.st[si].i[0];
        ui.lastChanged = true;
      } else if (key == UK_KEY_SPACE) {
        // 空白は Text で来るので、ここでは取るだけ
      } else {
        took = false;
      }
      if (took) {
        ui.inp.keys[k] = 0;
        moved = true;
      }
    }
    // 入力された文字（IME の確定を含む）
    const t = ukTextTake(mut ui);
    if (t.length > 0) {
      s = ukDelSel(mut ui, si, s);
      const p = ui.st[si].i[0] as usize;
      s = ukInsert(s, p, t);
      ui.st[si].i[0] = (p + t.length) as i32;
      ui.st[si].i[1] = ui.st[si].i[0];
      ui.lastChanged = true;
      moved = true;
    }
    if (moved) {
      ui.st[si].d[1] = ui.now;
    }
  }
  // カーソルが見えるようにスクロールする
  const cur = ui.st[si].i[0] as usize;
  const cx = ukTextPrefixW(ui, s, cur, fs);
  let scroll = ui.st[si].i[2];
  if (cx - scroll > inner.w - 2) {
    scroll = cx - inner.w + 2;
  }
  if (cx - scroll < 0) {
    scroll = cx;
  }
  const tw = ukTextW(mut ui, s, fs);
  scroll = Math.max(Math.min(scroll, Math.max(tw - inner.w + 2, 0)), 0);
  ui.st[si].i[2] = scroll;
  // 描く
  ukPushClip(mut ui, ukRect(inner.x - 1, inner.y, inner.w + 2, inner.h));
  const lh = ukLineH(ui, fs);
  const ty = inner.y + (inner.h - lh) / 2;
  const a = Math.min(ui.st[si].i[0], ui.st[si].i[1]) as usize;
  const b = Math.max(ui.st[si].i[0], ui.st[si].i[1]) as usize;
  if (focused && a != b) {
    const xa = ukTextPrefixW(ui, s, a, fs);
    const xb = ukTextPrefixW(ui, s, b, fs);
    ukDrawRect(mut ui, ukRect(inner.x - scroll + xa, ty, xb - xa, lh), ui.theme.selection);
  }
  if (s.length > 0) {
    ukDrawText(mut ui, inner.x - scroll, ty, s, fs, color);
  }
  if (focused) {
    let caretX = inner.x - scroll + cx;
    // IME の途中の文字
    if (ui.imeText.length > 0) {
      const ime = ui.imeText.clone();
      const iw = ukDrawText(mut ui, caretX, ty, ime, fs, color);
      ukDrawRect(mut ui, ukRect(caretX, ty + lh - 1, iw, 1), color);
      caretX = caretX + iw;
    }
    // 点滅（0.5 秒ずつ）。動かした直後は見せる。次に切り替わる時刻に起こしてもらう（毎フレーム描かない）
    const ph = ui.now - ui.st[si].d[1];
    const nph = Math.floor(ph * 2.0);
    const on = (nph as i64) % 2 == 0;
    if (on) {
      ukDrawRect(mut ui, ukRect(caretX, ty, Math.max(1, ui.theme.stroke), lh), ui.theme.text);
    }
    ukWakeAt(mut ui, ui.st[si].d[1] + (nph + 1.0) * 0.5);
  }
  ukPopClip(mut ui);
  return s;
}

// 入力欄の枠と地。
function ukFieldFrame(ui: mut UkCtx, r: UkRect, h: UkHit, editing: bool): void {
  const off = ui.disabled > 0;
  ukDrawRound(mut ui, r, ui.theme.radius, off ? ui.theme.raisedActive : ui.theme.inputBg);
  let bc = ui.theme.border;
  if (editing) {
    bc = ui.theme.accent;
  } else if (h.hover) {
    bc = ui.theme.borderStrong;
  }
  ukDrawStroke(mut ui, r, ui.theme.radius, ui.theme.stroke, bc);
  ukFocusRing(mut ui, r, h);
}

// 文字の入力欄。ラベルの "##" より前は、空のときに薄く出す説明。
export function ukTextField(ui: mut UkCtx, label: string, text: string): string {
  const id = ukId(ui, label);
  const r = ukNext(mut ui, 200, ui.theme.ctrlH);
  const h = ukBehaviorEx(mut ui, id, r, true, false);
  const si = ukSt(mut ui, id);
  const focused = ui.focus == id && ui.layer >= ui.modal;
  ukFieldFrame(mut ui, r, h, focused);
  const inner = ukRect(r.x + ui.theme.pad, r.y, r.w - ui.theme.pad * 2, r.h);
  if (ui.disabled > 0) {
    ukDrawTextIn(mut ui, inner, text, ui.theme.fontSize, ui.theme.textOff, 0);
    return text.clone();
  }
  const s = ukTextEdit(mut ui, id, si, inner, text, h, ui.theme.text);
  if (s.length == 0 && !(focused && ui.imeText.length > 0)) {
    const hint = ukLabel(label);
    ukDrawTextIn(mut ui, inner, hint, ui.theme.fontSize, ui.theme.textOff, 0);
  }
  ui.lastChanged = s != text;
  return s;
}

// ---- 数を読む・書く ----

// 小数を読む（"-1.5"、"+2"、"3e2" は読まない）。読めなければ false。
export function ukParseF64(s: string, out: mut f64[]): bool {
  let i: usize = 0;
  while (i < s.length && s[i] == 32) {
    i++;
  }
  let neg = false;
  if (i < s.length && (s[i] == 45 || s[i] == 43)) {
    neg = s[i] == 45;
    i++;
  }
  let v: f64 = 0.0;
  let any = false;
  while (i < s.length && s[i] >= 48 && s[i] <= 57) {
    v = v * 10.0 + ((s[i] - 48) as f64);
    i++;
    any = true;
  }
  if (i < s.length && (s[i] == 46 || s[i] == 44)) {
    i++;
    let f: f64 = 0.1;
    while (i < s.length && s[i] >= 48 && s[i] <= 57) {
      v = v + ((s[i] - 48) as f64) * f;
      f = f * 0.1;
      i++;
      any = true;
    }
  }
  while (i < s.length && s[i] == 32) {
    i++;
  }
  if (!any || i != s.length) {
    return false;
  }
  out[0] = neg ? -v : v;
  return true;
}

// v を step に揃え、lo〜hi に収める。lo が有限なら lo を基準に、そうでなければ 0 を基準に揃える（範囲のない欄で壊れない）。
// NaN・無限大は返さない（v が有限でなければ、範囲の中の 0 に近い値を返す）。
export function ukSnap(v: f64, lo: f64, hi: f64, step: f64): f64 {
  let x = v;
  if (!ukFinite(x)) {
    x = 0.0;
  }
  if (step > 0.0 && ukFinite(step)) {
    const base = ukFinite(lo) ? lo : 0.0;
    const q = base + Math.floor((x - base) / step + 0.5) * step;
    if (ukFinite(q)) {
      x = q;
    }
  }
  if (x < lo) {
    x = lo;
  }
  if (x > hi) {
    x = hi;
  }
  return x;
}

// ドラッグの 1 画素・上下のキーの 1 回で動く量。step があればそれ、なければ範囲の 1/200。
// 範囲が無限か大きすぎる（1e4 を超える）ときは、表示の桁の細かさ（10^-decimals）にする。
export function ukDragStep(lo: f64, hi: f64, step: f64, decimals: i32): f64 {
  if (step > 0.0 && ukFinite(step)) {
    return step;
  }
  const span = hi - lo;
  if (ukFinite(span) && span > 0.0 && span <= 10000.0) {
    return span / 200.0;
  }
  let fine: f64 = 1.0;
  for (let i = 0; i < Math.min(Math.max(decimals, 0), 6); i++) {
    fine = fine / 10.0;
  }
  return fine;
}

// ---- タイムコード ----

// 1 秒のコマ数（整数に丸めた名目の値。29.97 は 30）。
export function ukFpsInt(num: i32, den: i32): i64 {
  if (den <= 0) {
    return 30;
  }
  return Math.max(Math.floor((num as f64) / (den as f64) + 0.5) as i64, 1);
}

// ドロップフレームを使う速さか（29.97 = 30000/1001 と 59.94 = 60000/1001。ui.md 4.7 の既定）。
// 23.976 にはドロップフレームの決まりがないのでノンドロップ。
export function ukIsDropFrame(num: i32, den: i32): bool {
  return den == 1001 && (num == 30000 || num == 60000);
}

// ドロップフレームで飛ばすコマの数（10 分ごとを除く毎分。30 なら 2、60 なら 4）。ドロップフレームでなければ 0。
function ukDropCount(fps: i64, df: bool): i64 {
  if (!df || (fps != 30 && fps != 60)) {
    return 0;
  }
  return fps / 15;
}

function ukTwo(v: i64): string {
  if (v < 10) {
    return `0${v}`;
  }
  return `${v}`;
}

// コマ番号を "HH:MM:SS:FF" に（ノンドロップ）。
export function ukFormatTimecode(frame: i64, fps: i64): string {
  return ukFormatTimecodeDf(frame, fps, false);
}

// コマ番号をタイムコードに。df（ドロップフレーム。fps が 30 か 60 のときだけ効く）なら "HH:MM:SS;FF"。
// ドロップフレームは、10 分ごとの分を除く毎分の始めに、番号を 2（60 なら 4）飛ばす（1 時間 = 29.97 で 107892 コマ）。
export function ukFormatTimecodeDf(frame: i64, fps0: i64, df: bool): string {
  const fps = Math.max(fps0, 1);
  const neg = frame < 0;
  let f = neg ? -frame : frame;
  const d = ukDropCount(fps, df);
  if (d > 0) {
    const perMin = fps * 60 - d;
    const per10 = fps * 600 - 9 * d;
    const tens = f / per10;
    const rem = f % per10;
    let adj = 9 * d * tens;
    if (rem >= d) {
      adj = adj + d * ((rem - d) / perMin);
    }
    f = f + adj;
  }
  const ff = f % fps;
  const ts = f / fps;
  const ss = ts % 60;
  const mm = (ts / 60) % 60;
  const hh = ts / 3600;
  let sep = ":";
  if (d > 0) {
    sep = ";";
  }
  const s = `${ukTwo(hh)}:${ukTwo(mm)}:${ukTwo(ss)}${sep}${ukTwo(ff)}`;
  if (neg) {
    return "-" + s;
  }
  return s;
}

// "HH:MM:SS:FF" の右からの読み（区切りは : ; . のどれでも）。区切りがなければ数字を右から 2 桁ずつ FF SS MM HH と読む
// （"1000" は 10 秒 00 コマ。Premiere と同じ）。前に + / - があれば cur からの相対。読めなければ -1。
// 桁の数を確かめる（区切りなしは 8 桁まで、区切りのある欄は 3 桁まで、欄は 4 つまで）。あふれる数は -1。
export function ukParseTimecode(s0: string, fps: i64, cur: i64): i64 {
  return ukParseTimecodeDf(s0, fps, false, cur);
}

// ukParseTimecode のドロップフレーム版。df なら（fps が 30 か 60 のとき）絶対の時刻をドロップフレームとして読む。
// 相対（+ / -）の量は、名目の速さ（30 / 60）のコマ数として読む（"+1:00" は 30 コマ）。
export function ukParseTimecodeDf(s0: string, fps0: i64, df: bool, cur: i64): i64 {
  const fps = Math.max(fps0, 1);
  let i: usize = 0;
  let e = s0.length;
  while (i < e && s0[i] == 32) {
    i++;
  }
  while (e > i && s0[e - 1] == 32) {
    e--;
  }
  if (i >= e) {
    return -1;
  }
  let rel: i64 = 0;
  if (s0[i] == 43) {
    rel = 1;
    i++;
  } else if (s0[i] == 45) {
    rel = -1;
    i++;
  }
  let fields: i64[] = [];
  let hasSep = false;
  let v: i64 = 0;
  let digits = 0;
  let fieldDigits = 0;
  for (let k = i; k < e; k++) {
    const b = s0[k];
    if (b >= 48 && b <= 57) {
      v = v * 10 + ((b - 48) as i64);
      digits++;
      fieldDigits++;
      if (fieldDigits > 8) {
        return -1;
      }
    } else if (b == 58 || b == 59 || b == 46) {
      fields.push(v);
      v = 0;
      fieldDigits = 0;
      hasSep = true;
    } else {
      return -1;
    }
  }
  fields.push(v);
  if (fields.length > 4) {
    return -1;
  }
  if (!hasSep) {
    if (digits == 0 || digits > 8) {
      return -1;
    }
    // 右から 2 桁ずつ
    const all = fields[0];
    fields = [all / 1000000, (all / 10000) % 100, (all / 100) % 100, all % 100];
  } else {
    // 区切りのある欄は 3 桁まで（コマは 120fps でも 3 桁。時も 999 まで）
    let k2 = i;
    let run = 0;
    while (k2 < e) {
      const b = s0[k2];
      if (b >= 48 && b <= 57) {
        run++;
        if (run > 3) {
          return -1;
        }
      } else {
        run = 0;
      }
      k2++;
    }
  }
  // 右から FF, SS, MM, HH
  let hh: i64 = 0;
  let mm: i64 = 0;
  let ss: i64 = 0;
  let ff: i64 = 0;
  const n = fields.length;
  ff = fields[n - 1];
  if (n >= 2) {
    ss = fields[n - 2];
  }
  if (n >= 3) {
    mm = fields[n - 3];
  }
  if (n >= 4) {
    hh = fields[n - 4];
  }
  let total = ((hh * 60 + mm) * 60 + ss) * fps + ff;
  const d = ukDropCount(fps, df);
  if (d > 0 && rel == 0) {
    const tm = hh * 60 + mm;
    total = total - d * (tm - tm / 10);
    total = Math.max(total, 0);
  }
  if (total < 0) {
    return -1;
  }
  if (rel != 0) {
    return Math.max(cur + rel * total, 0);
  }
  return total;
}

// ---- 数値の入力欄（ドラッグで変える、クリックで打ち込む） ----
//
// 覚えておく値: i[3] 打ち込み中か、f[1] ドラッグで動いたか、d[0] ドラッグを始めたときの値、s 打ち込み中の文字。
// ドラッグ: 1 画素で step（ukDragStep）、Shift で 10 倍、Alt で 1/10（ui.md 7.3）。上下のキーで step ずつ（Shift で 10 倍）。
// 打ち込み中の Esc は打ち込みを取り消す（ダイアログの中でも、ダイアログより先に取る）。

// 打ち込みの共通部分。確定したら true を返し、確定した文字を ui.st[si].s に残す。
function ukNumEditBox(ui: mut UkCtx, id: u32, si: usize, r: UkRect, h: UkHit): i32 {
  // 戻り値: 0 打ち込み中、1 確定、2 取り消し
  if (ukKeyTake(mut ui, UK_KEY_ESC)) {
    ui.st[si].i[3] = 0;
    return 2;
  }
  const lost = ui.focus != id;
  const inner = ukRect(r.x + ui.theme.pad / 2, r.y, r.w - ui.theme.pad, r.h);
  ukDrawRound(mut ui, r, ui.theme.radius, ui.theme.inputBg);
  ukDrawStroke(mut ui, r, ui.theme.radius, ui.theme.stroke, ui.theme.accent);
  const s0 = ui.st[si].s.clone();
  const s = ukTextEdit(mut ui, id, si, inner, s0, h, ui.theme.text);
  ui.st[si].s = s;
  if (ui.lastSubmit || lost) {
    ui.st[si].i[3] = 0;
    ui.lastSubmit = false;
    return 1;
  }
  return 0;
}

function ukStartNumEdit(ui: mut UkCtx, id: u32, si: usize, text: string): void {
  ui.st[si].i[3] = 1;
  ui.st[si].s = text.clone();
  ui.st[si].i[0] = text.length as i32;
  ui.st[si].i[1] = 0;
  ui.st[si].i[2] = 0;
  ui.st[si].d[1] = ui.now;
  ukFocus(mut ui, id, false);
}

// 数値の入力欄。lo〜hi に収め、step に揃える（step=0 なら揃えない）。decimals は表示の桁。
export function ukNumber(ui: mut UkCtx, label: string, v: f64, lo: f64, hi: f64, step: f64, decimals: i32): f64 {
  const id = ukId(ui, label);
  const r = ukNext(mut ui, 90, ui.theme.ctrlH);
  return ukNumberAt(mut ui, id, r, v, lo, hi, step, decimals);
}

function ukNumberAt(ui: mut UkCtx, id: u32, r: UkRect, v: f64, lo: f64, hi: f64, step: f64, decimals: i32): f64 {
  const h = ukBehaviorEx(mut ui, id, r, true, false);
  const si = ukSt(mut ui, id);
  let nv = v;
  if (ui.disabled > 0) {
    ukFieldFrame(mut ui, r, h, false);
    ukDrawTextIn(mut ui, ukShrink(r, ui.theme.pad / 2), ukFixed(v, decimals), ui.theme.fontSize, ui.theme.textOff, 1);
    return v;
  }
  let ended = false;
  if (ui.st[si].i[3] != 0) {
    const c0 = ui.cmds.length;
    const res = ukNumEditBox(mut ui, id, si, r, h);
    if (res == 0) {
      ui.lastChanged = false;
      return v;
    }
    // 確定・取り消しのフレームは、ふだんの見た目で描く
    while (ui.cmds.length > c0) {
      ui.cmds.pop();
    }
    ended = true;
    if (res == 1) {
      let out: f64[] = [0.0];
      const txt = ui.st[si].s.clone();
      if (ukParseF64(txt, mut out)) {
        nv = Math.min(Math.max(out[0], lo), hi);
      }
    }
  }
  const dstep = ukDragStep(lo, hi, step, decimals);
  if (ended) {
    // 何もしない
  } else if (h.pressed) {
    ui.st[si].d[0] = v;
    ui.st[si].f[1] = 0.0;
  } else if (h.held) {
    const dx = ui.inp.mx - ui.activeX;
    if (Math.abs(dx) > 2) {
      ui.st[si].f[1] = 1.0;
    }
    if (ui.st[si].f[1] > 0.0) {
      let mul: f64 = 1.0;
      if ((ui.inp.mods & UK_MOD_SHIFT) != 0) {
        mul = 10.0;
      } else if ((ui.inp.mods & UK_MOD_ALT) != 0) {
        mul = 0.1;
      }
      nv = ukSnap(ui.st[si].d[0] + (dx as f64) * dstep * mul, lo, hi, step * (mul < 1.0 ? 0.1 : 1.0));
    }
  }
  if ((h.clicked && ui.st[si].f[1] == 0.0) || (h.focused && ukKeyTake(mut ui, UK_KEY_ENTER))) {
    // クリック（ドラッグせず）か Enter で打ち込みを始める
    ukStartNumEdit(mut ui, id, si, ukFixed(v, decimals));
  }
  if (h.focused) {
    const mu = ukKeyTakeMods(mut ui, UK_KEY_UP);
    if (mu >= 0) {
      nv = ukSnap(nv + dstep * ((mu & UK_MOD_SHIFT) != 0 ? 10.0 : 1.0), lo, hi, step);
    }
    const md = ukKeyTakeMods(mut ui, UK_KEY_DOWN);
    if (md >= 0) {
      nv = ukSnap(nv - dstep * ((md & UK_MOD_SHIFT) != 0 ? 10.0 : 1.0), lo, hi, step);
    }
  }
  ukFieldFrame(mut ui, r, h, false);
  const tc = h.hover || h.held ? ui.theme.accentHover : ui.theme.text;
  ukDrawTextIn(mut ui, ukShrink(r, ui.theme.pad / 2), ukFixed(nv, decimals), ui.theme.fontSize, tc, 1);
  ui.lastChanged = nv != v;
  return nv;
}

// タイムコードの入力欄。値はコマ番号。ドラッグで 1 画素 1 コマ（Shift で 10 コマ）、クリックで打ち込み（"+15" で 15 コマ進める）。
// 29.97 / 59.94 はドロップフレーム（"HH:MM:SS;FF"）で見せる（ui.md 4.7 の既定）。決めたいときは ukTimecodeEx。
export function ukTimecode(ui: mut UkCtx, label: string, frame: i64, fpsNum: i32, fpsDen: i32): i64 {
  return ukTimecodeEx(mut ui, label, frame, fpsNum, fpsDen, ukIsDropFrame(fpsNum, fpsDen));
}

// df でドロップフレームを使うかを決める版（df は fps が 30 か 60 のときだけ効く）。
export function ukTimecodeEx(ui: mut UkCtx, label: string, frame: i64, fpsNum: i32, fpsDen: i32, df: bool): i64 {
  const id = ukId(ui, label);
  const fps = ukFpsInt(fpsNum, fpsDen);
  const fs = ui.theme.fontSize;
  const r = ukNext(mut ui, ukTextW(mut ui, "00:00:00:00", fs) + ui.theme.pad * 2, ui.theme.ctrlH);
  const h = ukBehaviorEx(mut ui, id, r, true, false);
  const si = ukSt(mut ui, id);
  let nf = frame;
  let ended = false;
  if (ui.st[si].i[3] != 0) {
    const c0 = ui.cmds.length;
    const res = ukNumEditBox(mut ui, id, si, r, h);
    if (res == 0) {
      ui.lastChanged = false;
      return frame;
    }
    while (ui.cmds.length > c0) {
      ui.cmds.pop();
    }
    ended = true;
    if (res == 1) {
      const txt = ui.st[si].s.clone();
      const p = ukParseTimecodeDf(txt, fps, df, frame);
      if (p >= 0) {
        nf = p;
      }
    }
  }
  if (ended) {
    // 何もしない
  } else if (h.pressed) {
    ui.st[si].d[0] = frame as f64;
    ui.st[si].f[1] = 0.0;
  } else if (h.held) {
    const dx = ui.inp.mx - ui.activeX;
    if (Math.abs(dx) > 2) {
      ui.st[si].f[1] = 1.0;
    }
    if (ui.st[si].f[1] > 0.0) {
      const mul: i64 = (ui.inp.mods & UK_MOD_SHIFT) != 0 ? 10 : 1;
      nf = Math.max((ui.st[si].d[0] as i64) + (dx as i64) * mul, 0);
    }
  }
  if ((h.clicked && ui.st[si].f[1] == 0.0) || (h.focused && ukKeyTake(mut ui, UK_KEY_ENTER))) {
    ukStartNumEdit(mut ui, id, si, ukFormatTimecodeDf(frame, fps, df));
  }
  if (h.focused) {
    if (ukKeyTake(mut ui, UK_KEY_UP)) {
      nf = nf + 1;
    }
    if (ukKeyTake(mut ui, UK_KEY_DOWN)) {
      nf = Math.max(nf - 1, 0);
    }
  }
  ukFieldFrame(mut ui, r, h, false);
  const tc = h.hover || h.held ? ui.theme.accentHover : ui.theme.accent;
  ukDrawTextIn(mut ui, r, ukFormatTimecodeDf(nf, fps, df), fs, tc, 1);
  ui.lastChanged = nf != frame;
  return nf;
}

// ---- スライダー ----

// スライダー。溝を押すかドラッグで値を決め、右に値を出す。値をダブルクリックで打ち込み。
// フォーカス中は 左右 で step、PageUp/PageDown で 10 step、Home/End で端。
export function ukSlider(ui: mut UkCtx, label: string, v: f64, lo: f64, hi: f64, step: f64, decimals: i32): f64 {
  const id = ukId(ui, label);
  const r = ukNext(mut ui, 200, ui.theme.ctrlH);
  const vw = Math.min(Math.max(ukTextW(mut ui, ukFixed(hi, decimals), ui.theme.fontSize), ukTextW(mut ui, ukFixed(lo, decimals), ui.theme.fontSize)) + ui.theme.pad * 2, r.w / 2);
  const tr = ukRect(r.x, r.y, r.w - vw - ui.theme.gap, r.h);
  const vr = ukRect(r.x + r.w - vw, r.y, vw, r.h);
  ukPushId(mut ui, label);
  const vid = ukId(ui, "#v");
  ukPopId(mut ui);
  const vsi = ukSt(mut ui, vid);
  let nv = v;
  // 値の欄（打ち込み中なら入力欄）
  if (ui.st[vsi].i[3] != 0) {
    nv = ukNumberAt(mut ui, vid, vr, v, lo, hi, step, decimals);
  }
  const h = ukBehavior(mut ui, id, tr, true);
  const off = ui.disabled > 0;
  const span = hi - lo;
  const kr = Math.max(ui.theme.ctrlH / 3, 5);
  const x0 = tr.x + kr;
  const x1 = tr.x + tr.w - kr;
  if (h.dbl) {
    ukStartNumEdit(mut ui, vid, vsi, ukFixed(v, decimals));
  } else if ((h.pressed || h.held) && span > 0.0 && x1 > x0) {
    const t = ((ui.inp.mx - x0) as f64) / ((x1 - x0) as f64);
    nv = ukSnap(lo + t * span, lo, hi, step);
  }
  if (h.focused) {
    const st = step > 0.0 ? step : span / 100.0;
    while (ukKeyTake(mut ui, UK_KEY_LEFT)) {
      nv = ukSnap(nv - st, lo, hi, step);
    }
    while (ukKeyTake(mut ui, UK_KEY_RIGHT)) {
      nv = ukSnap(nv + st, lo, hi, step);
    }
    while (ukKeyTake(mut ui, UK_KEY_PGDN)) {
      nv = ukSnap(nv - st * 10.0, lo, hi, step);
    }
    while (ukKeyTake(mut ui, UK_KEY_PGUP)) {
      nv = ukSnap(nv + st * 10.0, lo, hi, step);
    }
    if (ukKeyTake(mut ui, UK_KEY_HOME)) {
      nv = lo;
    }
    if (ukKeyTake(mut ui, UK_KEY_END)) {
      nv = hi;
    }
  }
  // 描く（溝が作れないほど狭ければ、溝とつまみは描かない。値の文字だけ）
  if (x1 > x0) {
    const t = span > 0.0 ? (nv - lo) / span : 0.0;
    const kx = x0 + (Math.floor(t * ((x1 - x0) as f64) + 0.5) as i32);
    const ty = tr.y + tr.h / 2;
    const tt = Math.max(ui.theme.ctrlH / 7, 3);
    ukPushClip(mut ui, tr);
    ukDrawRound(mut ui, ukRect(x0, ty - tt / 2, x1 - x0, tt), tt / 2, ui.theme.track);
    ukDrawRound(mut ui, ukRect(x0, ty - tt / 2, kx - x0, tt), tt / 2, off ? ui.theme.textOff : ui.theme.accent);
    const kc = off ? ui.theme.textOff : (h.held ? ui.theme.text : (h.hover ? 0xffffffff : ui.theme.text));
    ukDrawCircle2(mut ui, kx as f32, ty as f32, (kr as f32) * (h.held || h.hover ? 0.85 : 0.75), kc);
    ukPopClip(mut ui);
    if (h.focused && ui.focusVisible) {
      ukDrawCircle(mut ui, kx as f32, ty as f32, kr as f32 + 2.0, 2.0, ui.theme.focus);
    }
  }
  if (ui.st[vsi].i[3] == 0) {
    ukDrawTextIn(mut ui, vr, ukFixed(nv, decimals), ui.theme.fontSize, off ? ui.theme.textOff : ui.theme.textDim, 2);
  }
  ui.lastId = id;
  ui.lastChanged = nv != v;
  return nv;
}

// ---- 進み具合 ----

// 進み具合（frac は 0〜1。負なら終わりの分からない動き）。
export function ukProgress(ui: mut UkCtx, frac: f64, label: string): void {
  const fs = ui.theme.fontSmall;
  let txt = "";
  if (frac >= 0.0) {
    txt = `${Math.floor(Math.min(Math.max(frac, 0.0), 1.0) * 100.0 + 0.5) as i64}%`;
  }
  const r = ukNext(mut ui, 200, ui.theme.ctrlH);
  let lw = 0;
  if (label.length > 0) {
    lw = ukTextW(mut ui, label, fs) + ui.theme.gap;
    ukDrawTextIn(mut ui, ukRect(r.x, r.y, lw, r.h), label, fs, ui.theme.textDim, 0);
  }
  const pw = ukTextW(mut ui, "100%", fs) + ui.theme.gap;
  const bh = Math.max(ui.theme.ctrlH / 4, 4);
  const br = ukRect(r.x + lw, r.y + (r.h - bh) / 2, r.w - lw - pw, bh);
  ukDrawRound(mut ui, br, bh / 2, ui.theme.track);
  if (frac >= 0.0) {
    const fw = Math.floor((br.w as f64) * Math.min(Math.max(frac, 0.0), 1.0) + 0.5) as i32;
    if (fw > 0) {
      ukDrawRound(mut ui, ukRect(br.x, br.y, Math.max(fw, bh), bh), bh / 2, ui.theme.accent);
    }
    ukDrawTextIn(mut ui, ukRect(r.x + r.w - pw, r.y, pw, r.h), txt, fs, ui.theme.textDim, 2);
  } else {
    // 行き来する帯
    const seg = Math.max(br.w / 4, bh);
    const ph = ui.now * 0.8 - Math.floor(ui.now * 0.8);
    const tri = ph < 0.5 ? ph * 2.0 : 2.0 - ph * 2.0;
    const sx = br.x + (Math.floor(tri * ((br.w - seg) as f64)) as i32);
    ukDrawRound(mut ui, ukRect(sx, br.y, seg, bh), bh / 2, ui.theme.accent);
    ui.wantFrame = true;
  }
}

// ---- ポップアップ（ドロップダウン・メニューの土台） ----
//
// ポップアップの覚えておく値（ID ごと）: i[0] 中身の自然な幅、i[1] 中身の自然な高さ（余白を含む）、i[2] キーで選んでいる項目。
// 高さは画面に収め、収まらない分はスクロールする領域に入れる（ホイールとスクロールバーで動く）。

// ID id のポップアップを (x, y) に開く。いまの深さより深いものは閉じる。
export function ukOpenPopup(ui: mut UkCtx, id: u32, x: i32, y: i32): void {
  ukClosePopupsAbove(mut ui);
  ui.popups.push(id);
  ui.popupX.push(x);
  ui.popupY.push(y);
  ui.popupFrame = ui.frame;
  ui.wantFrame = true;
}

// いまの深さより深いポップアップを閉じる。
export function ukClosePopupsAbove(ui: mut UkCtx): void {
  const d = ui.popupDepth as usize;
  while (ui.popups.length > d) {
    ui.popups.pop();
    ui.popupX.pop();
    ui.popupY.pop();
  }
}

export function ukClosePopups(ui: mut UkCtx): void {
  ui.popups.clear();
  ui.popupX.clear();
  ui.popupY.clear();
  ui.menuHeld = false;
  ui.wantFrame = true;
}

// いまの深さで、ID id のポップアップが開いているか。
export function ukPopupIsOpen(ui: UkCtx, id: u32): bool {
  const d = ui.popupDepth as usize;
  return d < ui.popups.length && ui.popups[d] == id;
}

// ポップアップの中のスクロールする領域の名前。
function ukPopScrollLabel(id: u32): string {
  return `#pop${id}`;
}

// ポップアップに使える高さ（画面の上下に 2 画素ずつ残す）。
function ukPopMaxH(ui: UkCtx): i32 {
  const pp = Math.max(ui.theme.pad / 2, 2);
  return Math.max(ui.H - 4, pp * 2 + ui.theme.menuH);
}

// ポップアップを始める。開いていなければ false（ukEndPopup は呼ばない）。幅は minW と中身の自然な幅の大きいほう。
export function ukBeginPopup(ui: mut UkCtx, id: u32, minW: i32): bool {
  if (!ukPopupIsOpen(ui, id)) {
    return false;
  }
  const d = ui.popupDepth as usize;
  const si = ukSt(mut ui, id);
  const pp = Math.max(ui.theme.pad / 2, 2);
  const w = Math.max(minW, ui.st[si].i[0]);
  const natH = Math.max(ui.st[si].i[1], pp * 2);
  const maxH = ukPopMaxH(ui);
  const hh = Math.min(natH, maxH);
  const scrolled = natH > maxH;
  let x = ui.popupX[d];
  let y = ui.popupY[d];
  if (x + w > ui.W - 2) {
    x = Math.max(ui.W - 2 - w, 2);
  }
  if (y + hh > ui.H - 2) {
    y = Math.max(ui.H - 2 - hh, 2);
  }
  ukPushLayer(mut ui, UK_L_POPUP + (d as i32));
  ukPushClipScreen(mut ui);
  const r = ukRect(x, y, w, hh);
  const sh = ui.theme.shadow;
  const c0 = ukDrawShadow(mut ui, ukRect(r.x, r.y + 2, r.w, r.h), ui.theme.radius, ui.theme.shadowBlur, sh) as i32;
  const c1 = ukDrawRound(mut ui, r, ui.theme.radius, ui.theme.raised) as i32;
  const c2 = ukDrawStroke(mut ui, r, ui.theme.radius, ui.theme.stroke, ui.theme.border) as i32;
  ui.popupRecs.push({ id, x, y, w, c0, c1, c2, scrolled });
  ukBeginColAt(mut ui, ukRect(x + pp, y + pp, w - pp * 2, 100000));
  const k = ukTopBox(ui);
  ui.boxes[k].gap = 0;
  if (scrolled) {
    ukBeginScrollH(mut ui, ukPopScrollLabel(id), ukRect(x + pp, y + pp, w - pp * 2, hh - pp * 2), -1);
    const k2 = ukTopBox(ui);
    ui.boxes[k2].gap = 0;
  }
  ui.popupDepth = ui.popupDepth + 1;
  return true;
}

export function ukEndPopup(ui: mut UkCtx): void {
  if (ui.popupRecs.length == 0) {
    return;
  }
  const rec = ui.popupRecs.pop();
  const pp = Math.max(ui.theme.pad / 2, 2);
  let natW = 0;
  let natH = 0;
  if (rec.scrolled) {
    // スクロールの中身から自然な大きさを測る
    const k = ukTopBox(ui);
    natW = Math.max(ui.boxes[k].maxX - ui.boxes[k].r.x, 0) + pp * 2 + ui.theme.scrollW;
    natH = Math.max(ui.boxes[k].maxY - ui.boxes[k].r.y, 0) + pp * 2;
    ukEndScroll(mut ui);
    ui.boxes.pop();
  } else {
    const b = ui.boxes.pop();
    natW = Math.max(b.maxX - b.r.x, 0) + pp * 2;
    natH = Math.max(b.maxY - b.r.y, 0) + pp * 2;
  }
  const si = ukSt(mut ui, rec.id);
  if (natW > ui.st[si].i[0] || natH != ui.st[si].i[1]) {
    ui.wantFrame = true;
  }
  ui.st[si].i[0] = Math.max(ui.st[si].i[0], natW);
  ui.st[si].i[1] = natH;
  const h = Math.min(natH, ukPopMaxH(ui));
  ui.cmds[rec.c0 as usize].h = h;
  ui.cmds[rec.c1 as usize].h = h;
  ui.cmds[rec.c2 as usize].h = h;
  ukBlock(mut ui, ukRect(rec.x, rec.y, rec.w, h));
  ukPopClip(mut ui);
  ukPopLayer(mut ui);
  ui.popupDepth = Math.max(ui.popupDepth - 1, 0);
}

// ポップアップ id の中で、上から top 画素・高さ h の所が見えるようにスクロールする（キーで選んだ項目に使う）。
function ukPopupReveal(ui: mut UkCtx, id: u32, top: i32, h: i32): void {
  const psi = ukSt(mut ui, id);
  const pp = Math.max(ui.theme.pad / 2, 2);
  const natH = ui.st[psi].i[1];
  const view = Math.min(natH, ukPopMaxH(ui)) - pp * 2;
  if (natH <= ukPopMaxH(ui) || view <= 0) {
    return;
  }
  const sid = ukId(ui, ukPopScrollLabel(id));
  const ssi = ukSt(mut ui, sid);
  const sy = Math.floor(ui.st[ssi].f[0]) as i32;
  if (top < sy) {
    ui.st[ssi].f[0] = top as f32;
  } else if (top + h > sy + view) {
    ui.st[ssi].f[0] = (top + h - view) as f32;
  }
}

// ---- メニュー ----

// メニューの項目（左に印、文字、右にショートカット）。押されたら true で、ポップアップを全部閉じる。
export function ukMenuItemEx(ui: mut UkCtx, label: string, shortcut: string, checked: bool, sub: bool): UkHit {
  return ukMenuItemHi(mut ui, label, shortcut, checked, sub, false);
}

// hi なら、マウスが乗っていなくても選んでいる色で描く（キーで選んだドロップダウンの項目）。
function ukMenuItemHi(ui: mut UkCtx, label: string, shortcut: string, checked: bool, sub: bool, hi: bool): UkHit {
  const id = ukId(ui, label);
  const txt = ukLabel(label);
  const fs = ui.theme.fontSize;
  const ic = ui.theme.icon;
  const tw = ukTextW(mut ui, txt, fs);
  const sw = shortcut.length > 0 ? ukTextW(mut ui, shortcut, ui.theme.fontSmall) + ui.theme.pad * 2 : 0;
  const r = ukNext(mut ui, ic + ui.theme.pad * 3 + tw + sw + (sub ? ic : 0), ui.theme.menuH);
  const off = ui.disabled > 0;
  let h = ukBehavior(mut ui, id, r, false);
  // 開いたフレームの押す・離すでは選ばない（開いたポップアップが押した所に重なっても、その 1 回のクリックで選ばれない）
  if (ui.popupFrame == ui.frame) {
    h.clicked = false;
  }
  // メニューバーを押したまま、ここまで動かして離した（Windows・macOS と同じ選び方）
  if (h.hover && ui.menuHeld && (ui.inp.released & 1) != 0 && !sub) {
    h.clicked = true;
  }
  if (h.hover && !sub) {
    // ほかの項目に乗ったら、この深さのサブメニューを閉じる
    ukClosePopupsAbove(mut ui);
  }
  const lit = (h.hover || hi) && !off;
  if (lit) {
    ukDrawRound(mut ui, r, ui.theme.radiusSm, ui.theme.accent);
  }
  const tc = off ? ui.theme.textOff : (lit ? ui.theme.onAccent : ui.theme.text);
  if (checked) {
    ukIcon(mut ui, ukRect(r.x + ui.theme.pad / 2, r.y + (r.h - ic) / 2, ic, ic), UK_I_CHECK, tc);
  }
  const tx = r.x + ic + ui.theme.pad;
  ukDrawTextIn(mut ui, ukRect(tx, r.y, r.w - (tx - r.x) - sw, r.h), txt, fs, tc, 0);
  if (sw > 0) {
    ukDrawTextIn(mut ui, ukRect(r.x + r.w - sw, r.y, sw - ui.theme.pad, r.h), shortcut, ui.theme.fontSmall,
      off ? ui.theme.textOff : (lit ? ui.theme.onAccent : ui.theme.textDim), 2);
  }
  if (sub) {
    ukIcon(mut ui, ukRect(r.x + r.w - ic - ui.theme.pad / 2, r.y + (r.h - ic) / 2, ic, ic), UK_I_RIGHT, tc);
  }
  if (h.clicked && !sub && !off) {
    ukClosePopups(mut ui);
  }
  return h;
}

export function ukMenuItem(ui: mut UkCtx, label: string, shortcut: string): bool {
  const h = ukMenuItemEx(mut ui, label, shortcut, false, false);
  return h.clicked && ui.disabled == 0;
}

// 印のつく項目。押されたら反転した値を返す。
export function ukMenuCheck(ui: mut UkCtx, label: string, shortcut: string, on: bool): bool {
  const h = ukMenuItemEx(mut ui, label, shortcut, on, false);
  if (h.clicked && ui.disabled == 0) {
    ui.lastChanged = true;
    return !on;
  }
  return on;
}

export function ukMenuSep(ui: mut UkCtx): void {
  const r = ukNext(mut ui, 1, ui.theme.gap + 1);
  ukDrawRect(mut ui, ukRect(r.x + ui.theme.pad / 2, r.y + r.h / 2, r.w - ui.theme.pad, 1), ui.theme.border);
}

// サブメニュー。乗ると右に開く。開いていれば true（ukEndMenu で閉じる）。
export function ukBeginSubMenu(ui: mut UkCtx, label: string): bool {
  const h = ukMenuItemEx(mut ui, label, "", false, true);
  const id = ukIdInt(ui, label, 7);
  if ((h.hover || h.pressed) && !ukPopupIsOpen(ui, id)) {
    ukOpenPopup(mut ui, id, ui.lastRect.x + ui.lastRect.w + 2, ui.lastRect.y - Math.max(ui.theme.pad / 2, 2));
  }
  return ukBeginPopup(mut ui, id, 160);
}

export function ukEndMenu(ui: mut UkCtx): void {
  ukEndPopup(mut ui);
}

// メニューバー（四角 r に横に並べる）。ukEndMenuBar で閉じる。
export function ukBeginMenuBar(ui: mut UkCtx, r: UkRect): void {
  ukDrawRect(mut ui, r, ui.theme.panelAlt);
  ukDrawRect(mut ui, ukRect(r.x, r.y + r.h - 1, r.w, 1), ui.theme.border);
  ukBeginRowAt(mut ui, ukRect(r.x + ui.theme.pad / 2, r.y, r.w - ui.theme.pad, r.h), []);
  const k = ukTopBox(ui);
  ui.boxes[k].gap = 0;
}

export function ukEndMenuBar(ui: mut UkCtx): void {
  ukEndBox(mut ui);
}

// メニューバーの 1 つ。押すと開き、どれかが開いている間は乗るだけで切り替わる。開いていれば true（ukEndMenu で閉じる）。
// 押したまま項目まで動かして離しても選べる（押した部品を持たないので、項目にホバーが付く）。
export function ukMenu(ui: mut UkCtx, label: string): bool {
  const id = ukId(ui, label);
  const txt = ukLabel(label);
  const fs = ui.theme.fontSize;
  const r = ukNext(mut ui, ukTextW(mut ui, txt, fs) + ui.theme.pad * 2, ui.theme.menuH);
  const h = ukBehavior(mut ui, id, r, false);
  const open = ukPopupIsOpen(ui, id);
  if (h.pressed) {
    if (open) {
      ukClosePopups(mut ui);
    } else {
      ukOpenPopup(mut ui, id, r.x, r.y + r.h);
      ui.menuHeld = true;
    }
    // 押したままの間も、項目にホバーが付くようにする
    if (ui.active == id) {
      ui.active = 0;
    }
  } else if (h.hover && !open && ui.popups.length > 0 && ui.popupDepth == 0) {
    ukOpenPopup(mut ui, id, r.x, r.y + r.h);
  }
  const nowOpen = ukPopupIsOpen(ui, id);
  if (nowOpen) {
    ukDrawRound(mut ui, ukShrink(r, 2), ui.theme.radiusSm, ui.theme.selection);
  } else if (h.hover) {
    ukDrawRound(mut ui, ukShrink(r, 2), ui.theme.radiusSm, ui.theme.raisedHover);
  }
  ukDrawTextIn(mut ui, r, txt, fs, ui.theme.text, 1);
  return ukBeginPopup(mut ui, id, 200);
}

// 右クリックのメニュー。四角 area を右クリックしたら、その所に開く。開いていれば true（ukEndMenu で閉じる）。
export function ukContextMenu(ui: mut UkCtx, label: string, area: UkRect): bool {
  const id = ukId(ui, label);
  if ((ui.inp.pressed & 4) != 0 && ukMouseIn(ui, area)) {
    ukOpenPopup(mut ui, id, ui.inp.mx, ui.inp.my);
    ui.activeTook = true;
  }
  return ukBeginPopup(mut ui, id, 180);
}

// ---- ドロップダウン ----
//
// 閉じているとき: 上下で前後の項目を選ぶ。Enter / Space で開く。
// 開いているとき: 上下・Home/End・PageUp/PageDown で項目を動かし（見えるようにスクロールする）、Enter / Space で選ぶ。Esc で閉じる。

export function ukDropdown(ui: mut UkCtx, label: string, items: string[], cur: i32): i32 {
  const id = ukId(ui, label);
  const fs = ui.theme.fontSize;
  let nw = 0;
  for (const it of items) {
    nw = Math.max(nw, ukTextW(mut ui, it, fs));
  }
  const r = ukNext(mut ui, nw + ui.theme.pad * 3 + ui.theme.icon, ui.theme.ctrlH);
  // Enter / Space は下で自分で扱う（閉じていれば開く、開いていれば選ぶ）
  const h = ukBehaviorEx(mut ui, id, r, true, false);
  const off = ui.disabled > 0;
  let sel = cur;
  const n = items.length as i32;
  const pid = ukIdInt(ui, label, 9);
  const psi = ukSt(mut ui, pid);
  const open = ukPopupIsOpen(ui, pid);
  if (h.pressed) {
    if (open) {
      ukClosePopups(mut ui);
    } else {
      ukOpenPopup(mut ui, pid, r.x, r.y + r.h + 2);
      ui.st[psi].i[2] = sel;
      ukPopupReveal(mut ui, pid, Math.max(sel, 0) * ui.theme.menuH, ui.theme.menuH);
    }
  }
  if (h.focused && !open && n > 0) {
    if (ukKeyTake(mut ui, UK_KEY_DOWN)) {
      sel = Math.min(sel + 1, n - 1);
    }
    if (ukKeyTake(mut ui, UK_KEY_UP)) {
      sel = Math.max(sel - 1, 0);
    }
    if (ukKeyTake(mut ui, UK_KEY_ENTER) || ukKeyTake(mut ui, UK_KEY_SPACE)) {
      ukOpenPopup(mut ui, pid, r.x, r.y + r.h + 2);
      ui.st[psi].i[2] = sel;
      ukPopupReveal(mut ui, pid, Math.max(sel, 0) * ui.theme.menuH, ui.theme.menuH);
    }
  } else if (h.focused && open && n > 0) {
    let hi = Math.min(Math.max(ui.st[psi].i[2], 0), n - 1);
    const page = Math.max((ukPopMaxH(ui) - ui.theme.pad) / ui.theme.menuH - 1, 1);
    let moved = false;
    while (ukKeyTake(mut ui, UK_KEY_DOWN)) {
      hi = Math.min(hi + 1, n - 1);
      moved = true;
    }
    while (ukKeyTake(mut ui, UK_KEY_UP)) {
      hi = Math.max(hi - 1, 0);
      moved = true;
    }
    while (ukKeyTake(mut ui, UK_KEY_PGDN)) {
      hi = Math.min(hi + page, n - 1);
      moved = true;
    }
    while (ukKeyTake(mut ui, UK_KEY_PGUP)) {
      hi = Math.max(hi - page, 0);
      moved = true;
    }
    if (ukKeyTake(mut ui, UK_KEY_HOME)) {
      hi = 0;
      moved = true;
    }
    if (ukKeyTake(mut ui, UK_KEY_END)) {
      hi = n - 1;
      moved = true;
    }
    ui.st[psi].i[2] = hi;
    if (moved) {
      ukPopupReveal(mut ui, pid, hi * ui.theme.menuH, ui.theme.menuH);
    }
    if (ukKeyTake(mut ui, UK_KEY_ENTER) || ukKeyTake(mut ui, UK_KEY_SPACE)) {
      sel = hi;
      ukClosePopups(mut ui);
    }
  }
  const c = ukBtnColors(ui, UK_BTN_SECONDARY, h, off);
  ukDrawRound(mut ui, r, ui.theme.radius, c[0]);
  ukDrawStroke(mut ui, r, ui.theme.radius, ui.theme.stroke, ukPopupIsOpen(ui, pid) ? ui.theme.accent : c[2]);
  let shown = "";
  if (sel >= 0 && sel < n) {
    shown = items[sel as usize].clone();
  }
  const ic = ui.theme.icon;
  ukDrawTextIn(mut ui, ukRect(r.x + ui.theme.pad, r.y, r.w - ui.theme.pad * 2 - ic, r.h), shown, fs, c[1], 0);
  ukPushClip(mut ui, r);
  ukIcon(mut ui, ukRect(r.x + r.w - ic - ui.theme.pad / 2 - 2, r.y + (r.h - ic) / 2, ic, ic), UK_I_DOWN, ui.theme.textDim);
  ukPopClip(mut ui);
  ukFocusRing(mut ui, r, h);
  if (ukBeginPopup(mut ui, pid, r.w)) {
    const hi = ui.st[psi].i[2];
    for (let i: usize = 0; i < items.length; i++) {
      ukPushIdInt(mut ui, i as i32);
      const it = items[i].clone();
      const ih = ukMenuItemHi(mut ui, it + "##dd", "", (i as i32) == sel, false, (i as i32) == hi);
      // マウスを動かして乗った項目を、キーで選ぶ項目にもする（動かしていないときはキーの選択を残す）
      if (ih.hover && ui.inp.moved) {
        ui.st[psi].i[2] = i as i32;
      }
      if (ih.clicked) {
        sel = i as i32;
      }
      ukPopId(mut ui);
    }
    ukEndPopup(mut ui);
  }
  ui.lastId = id;
  ui.lastChanged = sel != cur;
  return sel;
}

// ---- 一覧（大きい一覧の仮想化） ----
//
// ukBeginList で、見えている行の範囲 [first, last) が返る。その行だけ ukListRow で描く（10 万行でも速い）。
// フォーカス中は 上下・PageUp/PageDown・Home/End で選択が動き、選んだ行が見えるようにスクロールする。

export struct UkListRange {
  first: i32;
  last: i32;
  // キーで動いたあとの選択
  sel: i32;
}

export function ukBeginList(ui: mut UkCtx, label: string, r: UkRect, count: i32, sel: i32): UkListRange {
  const id = ukId(ui, label);
  const rowH = ui.theme.rowH;
  ui.focusOrder.push({ id, layer: ui.layer });
  if (ui.focus == id) {
    ui.focusSeen = true;
  }
  const focused = ui.focus == id && ui.disabled == 0 && ui.layer >= ui.modal;
  const si = ukSt(mut ui, id);
  let ns = sel;
  if (focused && count > 0) {
    const page = Math.max(r.h / rowH - 1, 1);
    let moved = false;
    while (ukKeyTake(mut ui, UK_KEY_DOWN)) {
      ns = Math.min(ns + 1, count - 1);
      moved = true;
    }
    while (ukKeyTake(mut ui, UK_KEY_UP)) {
      ns = Math.max(ns - 1, 0);
      moved = true;
    }
    while (ukKeyTake(mut ui, UK_KEY_PGDN)) {
      ns = Math.min(ns + page, count - 1);
      moved = true;
    }
    while (ukKeyTake(mut ui, UK_KEY_PGUP)) {
      ns = Math.max(ns - page, 0);
      moved = true;
    }
    if (ukKeyTake(mut ui, UK_KEY_HOME)) {
      ns = 0;
      moved = true;
    }
    if (ukKeyTake(mut ui, UK_KEY_END)) {
      ns = count - 1;
      moved = true;
    }
    if (moved) {
      // 選んだ行が見えるように
      const top = ns * rowH;
      const sy = Math.floor(ui.st[si].f[0]) as i32;
      if (top < sy) {
        ui.st[si].f[0] = top as f32;
      } else if (top + rowH > sy + r.h) {
        ui.st[si].f[0] = (top + rowH - r.h) as f32;
      }
    }
  }
  ukDrawRect(mut ui, r, ui.theme.inputBg);
  ukDrawStroke(mut ui, ukShrink(r, -1), 0, 1, focused && ui.focusVisible ? ui.theme.focus : ui.theme.border);
  ukBeginScrollH(mut ui, label, r, count * rowH);
  ukPushId(mut ui, label);
  const sy = Math.floor(ui.st[si].f[0]) as i32;
  const first = Math.max(sy / rowH, 0);
  const last = Math.min(count, first + r.h / rowH + 2);
  ui.lastChanged = ns != sel;
  return { first, last, sel: ns };
}

// 一覧の i 行目。押されたら pressed、ダブルクリックで dbl。
export function ukListRow(ui: mut UkCtx, i: i32, text: string, selected: bool): UkHit {
  const k = ukTopBox(ui);
  const b = ui.boxes[k].r;
  const rowH = ui.theme.rowH;
  const rr = ukRect(b.x, b.y + i * rowH, b.w, rowH);
  const id = ukIdInt(ui, "#row", i);
  const h = ukBehavior(mut ui, id, rr, false);
  if (h.pressed && ui.scrolls.length > 0) {
    const lid = ui.scrolls[ui.scrolls.length - 1].id;
    ukFocus(mut ui, lid, false);
    ui.activeTook = true;
  }
  if (selected) {
    ukDrawRect(mut ui, rr, ui.theme.selection);
  } else if (h.hover) {
    ukDrawRect(mut ui, rr, ui.theme.raisedHover);
  } else if (i % 2 == 1) {
    ukDrawRect(mut ui, rr, ui.theme.panel);
  }
  ukDrawTextIn(mut ui, ukRect(rr.x + ui.theme.pad, rr.y, rr.w - ui.theme.pad * 2, rr.h), text, ui.theme.fontSize,
    selected ? ui.theme.text : ui.theme.text, 0);
  return h;
}

export function ukEndList(ui: mut UkCtx): void {
  ukPopId(mut ui);
  ukEndScroll(mut ui);
}

// ---- ダイアログ ----
//
// ukOpenDialog で開き、毎フレーム ukBeginDialog / ukEndDialog の間に中身を置く。開いている間、下の部品には触れず、
// キーも届かない。開くとフォーカスを中の最初の部品に移し（前のフォーカスを覚える）、閉じると覚えたフォーカスに戻す（ui.md 19 章）。
// Esc（中身が取らなかったとき。打ち込み中の Esc は打ち込みの取り消し）か右上の × で閉じる。Tab はダイアログの中だけを回る。
// 後ろに暗幕は重ねない（ui.md 17.4。ダイアログの枠と影で分ける）。
//
// 覚えておく値: i[0] 開いているか、i[2] 最初の部品にフォーカスを移すか、i[3] 中身のフォーカスの並びの始まり、d[0] 開く前のフォーカス。

export function ukOpenDialog(ui: mut UkCtx, label: string): void {
  const id = ukId(ui, label);
  const si = ukSt(mut ui, id);
  ukStPin(mut ui, si);
  if (ui.st[si].i[0] == 0) {
    ui.st[si].i[0] = 1;
    ui.st[si].i[2] = 1;
    ui.st[si].d[0] = ui.focus as f64;
    // 下の部品のフォーカスを外す（開いたフレームの Enter / Space が裏の部品に届かない）
    ui.focus = 0;
  }
  ui.wantFrame = true;
}

// 閉じて、開く前のフォーカスに戻す。
function ukDialogClose(ui: mut UkCtx, si: usize): void {
  if (ui.st[si].i[0] == 0) {
    return;
  }
  ui.st[si].i[0] = 0;
  ui.st[si].i[2] = 0;
  const prev = ui.st[si].d[0] as u32;
  const vis = ui.focusVisible;
  ukFocus(mut ui, prev, vis);
  ui.wantFrame = true;
}

export function ukCloseDialog(ui: mut UkCtx, label: string): void {
  const id = ukId(ui, label);
  const si = ukSt(mut ui, id);
  ukDialogClose(mut ui, si);
}

export function ukDialogIsOpen(ui: mut UkCtx, label: string): bool {
  const id = ukId(ui, label);
  const si = ukSt(mut ui, id);
  return ui.st[si].i[0] != 0;
}

export function ukBeginDialog(ui: mut UkCtx, label: string, w0: i32, h0: i32): bool {
  const id = ukId(ui, label);
  const si = ukSt(mut ui, id);
  if (ui.st[si].i[0] == 0) {
    return false;
  }
  ukPushLayer(mut ui, UK_L_MODAL);
  ui.modalNext = Math.max(ui.modalNext, UK_L_MODAL);
  ukPushClipScreen(mut ui);
  const w = Math.min(w0, ui.W - 16);
  const h = Math.min(h0, ui.H - 16);
  const r = ukRect((ui.W - w) / 2, (ui.H - h) / 2, w, h);
  ukDrawShadow(mut ui, ukRect(r.x, r.y + 4, r.w, r.h), ui.theme.radius * 2, ui.theme.shadowBlur * 2, ui.theme.shadow);
  ukDrawRound(mut ui, r, ui.theme.radius * 2, ui.theme.panel);
  ukDrawStroke(mut ui, r, ui.theme.radius * 2, ui.theme.stroke, ui.theme.border);
  const th = ui.theme.tabH + ui.theme.pad;
  ukDrawTextIn(mut ui, ukRect(r.x + ui.theme.pad * 2, r.y, r.w - ui.theme.pad * 4 - ui.theme.ctrlH, th), ukLabel(label),
    ui.theme.fontLarge, ui.theme.text, 0);
  ukPushId(mut ui, label);
  ukBeginColAt(mut ui, ukRect(r.x + r.w - ui.theme.ctrlH - ui.theme.pad, r.y + (th - ui.theme.ctrlH) / 2, ui.theme.ctrlH, ui.theme.ctrlH));
  const closeX = ukIconButton(mut ui, "閉じる##dlgclose", UK_I_CLOSE, false);
  ukEndBox(mut ui);
  ukPopId(mut ui);
  if (closeX) {
    ukDialogClose(mut ui, si);
    ukPopClip(mut ui);
    ukPopLayer(mut ui);
    return false;
  }
  // 中身の部品は、フォーカスの並びのここから始まる（× は最初のフォーカスの候補にしない）
  ui.st[si].i[3] = ui.focusOrder.length as i32;
  ui.dialogs.push(id);
  ukDrawRect(mut ui, ukRect(r.x, r.y + th, r.w, 1), ui.theme.border);
  ukBeginColAt(mut ui, ukRect(r.x + ui.theme.pad * 2, r.y + th + ui.theme.pad * 2, r.w - ui.theme.pad * 4, r.h - th - ui.theme.pad * 4));
  return true;
}

// ダイアログの下の端のボタンの行（sizes は ukBeginRow と同じ）。ukEndBox で閉じる。
export function ukBeginDialogFooter(ui: mut UkCtx, sizes: i32[]): void {
  const k = ukTopBox(ui);
  const b = ui.boxes[k].r;
  ukBeginRowAt(mut ui, ukRect(b.x, b.y + b.h - ui.theme.ctrlH, b.w, ui.theme.ctrlH), sizes);
}

export function ukEndDialog(ui: mut UkCtx): void {
  ukEndBox(mut ui);
  if (ui.dialogs.length > 0) {
    const id = ui.dialogs.pop();
    const si = ukSt(mut ui, id);
    if (ui.popups.length == 0 && ukKeyTake(mut ui, UK_KEY_ESC)) {
      // 中身が Esc を取らなかった（打ち込み中ではない）ので、ダイアログを閉じる
      ukDialogClose(mut ui, si);
    } else if (ui.st[si].i[2] != 0) {
      // 開いた後の最初のフレーム: 中の最初の部品にフォーカスを移す
      ui.st[si].i[2] = 0;
      const start = Math.max(ui.st[si].i[3], 0) as usize;
      for (let k = start; k < ui.focusOrder.length; k++) {
        if (ui.focusOrder[k].layer >= UK_L_MODAL) {
          const fid = ui.focusOrder[k].id;
          const vis = ui.focusVisible;
          ukFocus(mut ui, fid, vis);
          break;
        }
      }
    }
  }
  ukPopClip(mut ui);
  ukPopLayer(mut ui);
}
