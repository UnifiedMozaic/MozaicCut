// uikit のテーマ: 色・文字の大きさ・余白・角の丸みなどの値を 1 つの構造体に持つ。
// 大きさの値は UI の倍率（1.0〜2.0）を掛けた画素で持つ（部品はそのまま使える）。倍率を変えるときは ukThemeScale で作り直す。
// docs/design/tokens.json があれば ukThemeFromTokens で読む（読めない値は既定のまま）。名前の対応は docs/design/uikit.md。
import { UkRect } from "./base.um";

export struct UkTheme {
  scale: f32;
  // ---- 色（0xAARRGGBB） ----
  bg: u32;           // 画面の地
  panel: u32;        // パネルの地
  panelAlt: u32;     // 一覧の 1 行おきの地、見出し
  raised: u32;       // ボタン・入力欄など、浮いた部品の地
  raisedHover: u32;
  raisedActive: u32;
  inputBg: u32;      // 入力欄の地
  border: u32;
  borderStrong: u32;
  text: u32;
  textDim: u32;
  textOff: u32;      // 使えない部品の文字
  accent: u32;       // 主のボタン・選ばれた所
  accentHover: u32;
  accentActive: u32;
  onAccent: u32;     // accent の上の文字
  danger: u32;
  dangerHover: u32;
  success: u32;
  warning: u32;
  focus: u32;        // キーボードのフォーカスの輪
  selection: u32;    // 選んだ文字・行の地
  track: u32;        // スライダー・進み具合・スクロールの溝
  overlay: u32;      // ダイアログの後ろを暗くする色（半透明）
  shadow: u32;       // 浮いたものの影（半透明）
  tipBg: u32;
  tipText: u32;
  // ---- 大きさ（倍率を掛けた画素） ----
  fontSize: f32;
  fontSmall: f32;
  fontLarge: f32;
  ctrlH: i32;        // ボタン・入力欄の高さ
  rowH: i32;         // 一覧の 1 行
  pad: i32;          // 部品の中の左右の余白
  gap: i32;          // 部品どうしの間
  radius: i32;
  radiusSm: i32;
  stroke: i32;       // 枠の太さ
  icon: i32;         // アイコンの大きさ
  scrollW: i32;      // スクロールバーの太さ
  tabH: i32;
  menuH: i32;        // メニューバーと項目の高さ
  splitW: i32;       // 仕切りのつかむ幅
  shadowBlur: i32;
  // ---- 倍率を掛ける前の値（ukThemeScale で使う） ----
  base: f32[16];
}

// 大きさの既定値（倍率 1.0。base の並び）
const UK_B_FONT: usize = 0;
const UK_B_FONT_SM: usize = 1;
const UK_B_FONT_LG: usize = 2;
const UK_B_CTRL_H: usize = 3;
const UK_B_ROW_H: usize = 4;
const UK_B_PAD: usize = 5;
const UK_B_GAP: usize = 6;
const UK_B_RADIUS: usize = 7;
const UK_B_RADIUS_SM: usize = 8;
const UK_B_STROKE: usize = 9;
const UK_B_ICON: usize = 10;
const UK_B_SCROLL_W: usize = 11;
const UK_B_TAB_H: usize = 12;
const UK_B_MENU_H: usize = 13;
const UK_B_SPLIT_W: usize = 14;
const UK_B_SHADOW: usize = 15;

// 既定のテーマ（暗い地。tokens.json がまだないときの仮の値）。scale は UI の倍率（1.0〜2.0 に収める）。
export function ukThemeDefault(scale: f32): UkTheme {
  let base: f32[16] = [13.0, 11.0, 16.0, 26.0, 22.0, 8.0, 6.0, 5.0, 3.0, 1.0, 14.0, 10.0, 28.0, 24.0, 6.0, 12.0];
  let t: UkTheme = {
    scale: 1.0,
    bg: 0xff16161a,
    panel: 0xff1e1e23,
    panelAlt: 0xff24242a,
    raised: 0xff2e2e35,
    raisedHover: 0xff383840,
    raisedActive: 0xff26262c,
    inputBg: 0xff141418,
    border: 0xff3a3a43,
    borderStrong: 0xff55555f,
    text: 0xffe6e6ea,
    textDim: 0xff9a9aa6,
    textOff: 0xff5c5c66,
    accent: 0xff3d7eff,
    accentHover: 0xff5a92ff,
    accentActive: 0xff2f68d8,
    onAccent: 0xffffffff,
    danger: 0xffe5484d,
    dangerHover: 0xfff06065,
    success: 0xff3fb950,
    warning: 0xffd29922,
    focus: 0xff7aa7ff,
    selection: 0xff2b4a80,
    track: 0xff2a2a31,
    overlay: 0x99000000,
    shadow: 0x80000000,
    tipBg: 0xfff0f0f4,
    tipText: 0xff16161a,
    fontSize: 13.0, fontSmall: 11.0, fontLarge: 16.0,
    ctrlH: 26, rowH: 22, pad: 8, gap: 6, radius: 5, radiusSm: 3, stroke: 1, icon: 14, scrollW: 10, tabH: 28,
    menuH: 24, splitW: 6, shadowBlur: 12,
    base,
  };
  ukThemeScale(mut t, scale);
  return t;
}

function ukScI(v: f32, s: f32): i32 {
  return Math.max(Math.floor(v * s + 0.5) as i32, 1);
}

// 倍率を変える（1.0〜2.0 に収める）。大きさの値を base から作り直す。
export function ukThemeScale(t: mut UkTheme, scale: f32): void {
  const s = Math.min(Math.max(scale, 1.0), 2.0);
  t.scale = s;
  t.fontSize = t.base[UK_B_FONT] * s;
  t.fontSmall = t.base[UK_B_FONT_SM] * s;
  t.fontLarge = t.base[UK_B_FONT_LG] * s;
  t.ctrlH = ukScI(t.base[UK_B_CTRL_H], s);
  t.rowH = ukScI(t.base[UK_B_ROW_H], s);
  t.pad = ukScI(t.base[UK_B_PAD], s);
  t.gap = ukScI(t.base[UK_B_GAP], s);
  t.radius = ukScI(t.base[UK_B_RADIUS], s);
  t.radiusSm = ukScI(t.base[UK_B_RADIUS_SM], s);
  t.stroke = ukScI(t.base[UK_B_STROKE], s);
  t.icon = ukScI(t.base[UK_B_ICON], s);
  t.scrollW = ukScI(t.base[UK_B_SCROLL_W], s);
  t.tabH = ukScI(t.base[UK_B_TAB_H], s);
  t.menuH = ukScI(t.base[UK_B_MENU_H], s);
  t.splitW = ukScI(t.base[UK_B_SPLIT_W], s);
  t.shadowBlur = ukScI(t.base[UK_B_SHADOW], s);
}

// 名前で 1 つの値を設定する（tokens.json の読み取りと、試し・設定画面から使う）。
// 色の名前は "color.<名前>"、大きさは "size.<名前>"（倍率 1.0 の画素）。分からない名前なら false。
export function ukThemeSet(t: mut UkTheme, name: string, color: u32, num: f32, isColor: bool): bool {
  if (isColor) {
    switch (name) {
      case "color.bg": t.bg = color; return true;
      case "color.panel": t.panel = color; return true;
      case "color.panelAlt": t.panelAlt = color; return true;
      case "color.raised": t.raised = color; return true;
      case "color.raisedHover": t.raisedHover = color; return true;
      case "color.raisedActive": t.raisedActive = color; return true;
      case "color.inputBg": t.inputBg = color; return true;
      case "color.border": t.border = color; return true;
      case "color.borderStrong": t.borderStrong = color; return true;
      case "color.text": t.text = color; return true;
      case "color.textDim": t.textDim = color; return true;
      case "color.textOff": t.textOff = color; return true;
      case "color.accent": t.accent = color; return true;
      case "color.accentHover": t.accentHover = color; return true;
      case "color.accentActive": t.accentActive = color; return true;
      case "color.onAccent": t.onAccent = color; return true;
      case "color.danger": t.danger = color; return true;
      case "color.dangerHover": t.dangerHover = color; return true;
      case "color.success": t.success = color; return true;
      case "color.warning": t.warning = color; return true;
      case "color.focus": t.focus = color; return true;
      case "color.selection": t.selection = color; return true;
      case "color.track": t.track = color; return true;
      case "color.overlay": t.overlay = color; return true;
      case "color.shadow": t.shadow = color; return true;
      case "color.tipBg": t.tipBg = color; return true;
      case "color.tipText": t.tipText = color; return true;
    }
    return false;
  }
  switch (name) {
    case "size.font": t.base[UK_B_FONT] = num; return true;
    case "size.fontSmall": t.base[UK_B_FONT_SM] = num; return true;
    case "size.fontLarge": t.base[UK_B_FONT_LG] = num; return true;
    case "size.ctrlH": t.base[UK_B_CTRL_H] = num; return true;
    case "size.rowH": t.base[UK_B_ROW_H] = num; return true;
    case "size.pad": t.base[UK_B_PAD] = num; return true;
    case "size.gap": t.base[UK_B_GAP] = num; return true;
    case "size.radius": t.base[UK_B_RADIUS] = num; return true;
    case "size.radiusSm": t.base[UK_B_RADIUS_SM] = num; return true;
    case "size.stroke": t.base[UK_B_STROKE] = num; return true;
    case "size.icon": t.base[UK_B_ICON] = num; return true;
    case "size.scrollW": t.base[UK_B_SCROLL_W] = num; return true;
    case "size.tabH": t.base[UK_B_TAB_H] = num; return true;
    case "size.menuH": t.base[UK_B_MENU_H] = num; return true;
    case "size.splitW": t.base[UK_B_SPLIT_W] = num; return true;
    case "size.shadowBlur": t.base[UK_B_SHADOW] = num; return true;
  }
  return false;
}

// ---- tokens.json の読み取り ----
//
// JSON のどの深さにあってもよい。値が "#rrggbb" / "#rrggbbaa" の文字列なら色、数なら大きさとして、
// キーの道筋の最後の 2 つ（"value" / "$value" は飛ばす）を "<親>.<名前>" にして ukThemeSet に渡す。
// 親の名前は "color" / "colors" → "color"、"size" / "sizes" / "space" / "spacing" / "radius" / "font" → "size" に読み替える。
// 例: {"color": {"bg": "#16161a"}}、{"colors": {"accent": {"$value": "#3d7eff"}}}、{"size": {"ctrlH": 26}}。
// 戻り値は設定できた値の数（読めない JSON なら -1）。

function ukHexVal(b: u8): i32 {
  if (b >= 48 && b <= 57) {
    return (b as i32) - 48;
  }
  if (b >= 97 && b <= 102) {
    return (b as i32) - 87;
  }
  if (b >= 65 && b <= 70) {
    return (b as i32) - 55;
  }
  return -1;
}

// "#rrggbb" か "#rrggbbaa" を 0xAARRGGBB に。読めなければ -1。
export function ukParseHex(s: string): i64 {
  if (s.length != 7 && s.length != 9) {
    return -1;
  }
  if (s[0] != 35) {
    return -1;
  }
  let v: i64 = 0;
  for (let i: usize = 1; i < s.length; i++) {
    const h = ukHexVal(s[i]);
    if (h < 0) {
      return -1;
    }
    v = v * 16 + (h as i64);
  }
  if (s.length == 7) {
    return v | 0xff000000;
  }
  // rrggbbaa → aarrggbb
  return ((v & 255) << 24) | (v >> 8);
}

function ukTokGroup(k: string): string {
  switch (k) {
    case "color": return "color";
    case "colors": return "color";
    case "size": return "size";
    case "sizes": return "size";
    case "space": return "size";
    case "spacing": return "size";
    case "radius": return "size";
    case "font": return "size";
  }
  return k.clone();
}

function ukJsonWs(s: string, i0: usize): usize {
  let i = i0;
  while (i < s.length && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) {
    i++;
  }
  return i;
}

// s[i] が '"' の文字列を読み、終わりの次の位置を end[0] に書く。エスケープは \" と \\ だけ扱う。
function ukJsonStr(s: string, i0: usize, end: mut usize[]): string {
  let out: u8[] = [];
  let i = i0 + 1;
  while (i < s.length && s[i] != 34) {
    if (s[i] == 92 && i + 1 < s.length) {
      i++;
    }
    out.push(s[i]);
    i++;
  }
  end[0] = i + 1;
  return stringFromBytes(out);
}

function ukTokApply(t: mut UkTheme, path: string[], color: u32, num: f32, isColor: bool): bool {
  // "value" / "$value" / "default" を除いた最後の 2 つ
  let names: string[] = [];
  for (const p of path) {
    if (p != "value" && p != "$value") {
      names.push(p.clone());
    }
  }
  if (names.length < 2) {
    return false;
  }
  const g = ukTokGroup(names[names.length - 2]);
  const key = g + "." + names[names.length - 1];
  return ukThemeSet(mut t, key, color, num, isColor);
}

export function ukThemeFromTokens(t: mut UkTheme, json: string): i32 {
  let path: string[] = [];
  // 各深さで、今のキーがあるか（配列の中なら false）
  let isObj: bool[] = [];
  let n = 0;
  let i = ukJsonWs(json, 0);
  let pendingKey = false;
  let end: usize[] = [0];
  while (i < json.length) {
    const b = json[i];
    if (b == 123) {            // {
      isObj.push(true);
      path.push("");
      pendingKey = true;
      i++;
    } else if (b == 125) {     // }
      if (isObj.length == 0) {
        return -1;
      }
      isObj.pop();
      path.pop();
      i++;
    } else if (b == 91) {      // [
      isObj.push(false);
      path.push("[]");
      i++;
    } else if (b == 93) {      // ]
      if (isObj.length == 0) {
        return -1;
      }
      isObj.pop();
      path.pop();
      i++;
    } else if (b == 44) {      // ,
      if (isObj.length > 0 && isObj[isObj.length - 1]) {
        pendingKey = true;
      }
      i++;
    } else if (b == 58) {      // :
      pendingKey = false;
      i++;
    } else if (b == 34) {      // "
      const str = ukJsonStr(json, i, mut end);
      i = end[0];
      if (pendingKey && path.length > 0) {
        path[path.length - 1] = str;
        pendingKey = false;
      } else {
        const c = ukParseHex(str);
        if (c >= 0) {
          if (ukTokApply(mut t, path, c as u32, 0.0, true)) {
            n++;
          }
        }
      }
    } else if ((b >= 48 && b <= 57) || b == 45) {
      let j = i;
      let v: f64 = 0.0;
      let neg = false;
      if (json[j] == 45) {
        neg = true;
        j++;
      }
      while (j < json.length && json[j] >= 48 && json[j] <= 57) {
        v = v * 10.0 + ((json[j] - 48) as f64);
        j++;
      }
      if (j < json.length && json[j] == 46) {
        j++;
        let f: f64 = 0.1;
        while (j < json.length && json[j] >= 48 && json[j] <= 57) {
          v = v + ((json[j] - 48) as f64) * f;
          f = f * 0.1;
          j++;
        }
      }
      // 単位 "px" などは飛ばす
      while (j < json.length && ((json[j] >= 97 && json[j] <= 122) || json[j] == 37)) {
        j++;
      }
      if (neg) {
        v = -v;
      }
      if (ukTokApply(mut t, path, 0, v as f32, false)) {
        n++;
      }
      i = j;
    } else {
      // true / false / null と空白
      i++;
    }
  }
  const sc = t.scale;
  ukThemeScale(mut t, sc);
  return n;
}

// 四角の左右に、テーマの余白（pad）を取った内側。
export function ukThemeRectPad(t: UkTheme, r: UkRect): UkRect {
  return { x: r.x + t.pad, y: r.y, w: Math.max(r.w - 2 * t.pad, 0), h: r.h };
}
