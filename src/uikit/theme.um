// uikit のテーマ: 色・文字の大きさ・余白・角の丸みなどの値を 1 つの構造体に持つ。
// 大きさの値は UI の倍率（0.8〜2.0。ui.md 20 章と tokens.json の scale）を掛けた画素で持つ（部品はそのまま使える）。
// 倍率を変えるときは ukThemeScale で作り直す。
// docs/design/tokens.json は ukThemeFromTokens で読む（道筋と UkTheme の名前の対応表は ukTokMap と docs/design/uikit.md）。
import { UkRect, ukMix } from "./base.um";

export struct UkTheme {
  scale: f32;
  // ---- 色（0xAARRGGBB） ----
  bg: u32;           // 画面の地（tokens: color.dark.bg.0）
  panel: u32;        // パネルの地（bg.1）
  panelAlt: u32;     // パネルの見出し・タブの帯・一覧の 1 行おき（bg.2）
  raised: u32;       // ボタン・入力欄など、浮いた部品の地（bg.3）
  raisedHover: u32;  // （bg.4）
  raisedActive: u32; // （bg.4）
  inputBg: u32;      // 入力欄の地（bg.1）
  border: u32;       // （line.default）
  borderStrong: u32; // （line.strong）
  lineControl: u32;  // 部品の輪郭: チェック・ラジオ・オフのトグル・スライダーの溝・値の欄の枠（line.control。bg.0〜bg.3 に 3:1 以上）
  text: u32;         // （text.1）
  textDim: u32;      // （text.2）
  textOff: u32;      // 使えない部品の文字（text.disabled）
  accent: u32;       // 主のボタン・選ばれた所（accent.default）
  accentHover: u32;  // （accent.hover）
  accentActive: u32; // （tokens にない。accent を暗くして作る）
  onAccent: u32;     // accent の上の文字（text.onDark）
  danger: u32;       // （semantic.error）
  dangerHover: u32;  // （tokens にない。danger を明るくして作る）
  success: u32;      // （semantic.ok）
  warning: u32;      // （semantic.warn）
  focus: u32;        // キーボードのフォーカスの輪（accent.default）
  selection: u32;    // 選んだ文字・行の地（accent.tintSolid。不透明）
  track: u32;        // スライダー・進み具合・スクロールの溝（bg.3）
  shadow: u32;       // 浮いたものの影（半透明。shadow.popover の rgba(0,0,0,.5)）
  tipBg: u32;        // （bg.popover）
  tipText: u32;      // （text.1）
  // ---- 大きさ（倍率を掛けた画素） ----
  fontSize: f32;
  fontSmall: f32;
  fontLarge: f32;
  ctrlH: i32;        // ボタン・入力欄の高さ
  rowH: i32;         // 一覧の 1 行
  pad: i32;          // 部品の中の左右の余白
  gap: i32;          // 部品どうしの間
  radius: i32;
  radiusSm: i32;
  stroke: i32;       // 枠の太さ
  icon: i32;         // アイコンの大きさ
  scrollW: i32;      // スクロールバーの太さ
  tabH: i32;
  menuH: i32;        // メニューバーと項目の高さ
  splitW: i32;       // 仕切りのつかむ幅
  shadowBlur: i32;
  // ---- 時間（秒） ----
  tipDelay: f64;     // ツールチップが出るまで（motion.duration.tooltipDelay）
  toastLife: f64;    // 通知を出しておく時間（motion.duration.toastHold）
  // ---- 倍率を掛ける前の値（ukThemeScale で使う） ----
  base: f32[16];
}

// 大きさの既定値（倍率 1.0。base の並び）
const UK_B_FONT: usize = 0;
const UK_B_FONT_SM: usize = 1;
const UK_B_FONT_LG: usize = 2;
const UK_B_CTRL_H: usize = 3;
const UK_B_ROW_H: usize = 4;
const UK_B_PAD: usize = 5;
const UK_B_GAP: usize = 6;
const UK_B_RADIUS: usize = 7;
const UK_B_RADIUS_SM: usize = 8;
const UK_B_STROKE: usize = 9;
const UK_B_ICON: usize = 10;
const UK_B_SCROLL_W: usize = 11;
const UK_B_TAB_H: usize = 12;
const UK_B_MENU_H: usize = 13;
const UK_B_SPLIT_W: usize = 14;
const UK_B_SHADOW: usize = 15;

// UI の倍率の範囲（ui.md 20 章の 80〜200%）
export const UK_SCALE_MIN: f32 = 0.8;
export const UK_SCALE_MAX: f32 = 2.0;

// 既定のテーマ（暗い地。tokens.json を読まないときの値で、tokens.json の dark と同じ向きの無彩色）。
// scale は UI の倍率（0.8〜2.0 に収める）。
export function ukThemeDefault(scale: f32): UkTheme {
  let base: f32[16] = [13.0, 11.0, 16.0, 26.0, 22.0, 8.0, 6.0, 5.0, 3.0, 1.0, 14.0, 10.0, 28.0, 24.0, 6.0, 12.0];
  let t: UkTheme = {
    scale: 1.0,
    bg: 0xff16161a,
    panel: 0xff1e1e23,
    panelAlt: 0xff24242a,
    raised: 0xff2e2e35,
    raisedHover: 0xff383840,
    raisedActive: 0xff26262c,
    inputBg: 0xff141418,
    border: 0xff3a3a43,
    borderStrong: 0xff55555f,
    lineControl: 0xff767676,
    text: 0xffe6e6ea,
    textDim: 0xff9a9aa6,
    textOff: 0xff5c5c66,
    accent: 0xff3d7eff,
    accentHover: 0xff5a92ff,
    accentActive: 0xff2f68d8,
    onAccent: 0xffffffff,
    danger: 0xffe5484d,
    dangerHover: 0xfff06065,
    success: 0xff3fb950,
    warning: 0xffd29922,
    focus: 0xff7aa7ff,
    selection: 0xff2b4a80,
    track: 0xff2a2a31,
    shadow: 0x80000000,
    tipBg: 0xfff0f0f4,
    tipText: 0xff16161a,
    fontSize: 13.0, fontSmall: 11.0, fontLarge: 16.0,
    ctrlH: 26, rowH: 22, pad: 8, gap: 6, radius: 5, radiusSm: 3, stroke: 1, icon: 14, scrollW: 10, tabH: 28,
    menuH: 24, splitW: 6, shadowBlur: 12,
    tipDelay: 0.6, toastLife: 4.0,
    base,
  };
  ukThemeScale(mut t, scale);
  return t;
}

function ukScI(v: f32, s: f32): i32 {
  return Math.max(Math.floor(v * s + 0.5) as i32, 1);
}

// 倍率を変える（0.8〜2.0 に収める）。大きさの値を base から作り直す。
// 線（stroke）は round(倍率) 画素にそろう（1px の線は 125% でも 1px。ui.md 20 章）。
export function ukThemeScale(t: mut UkTheme, scale: f32): void {
  let s = scale;
  if (!(s >= UK_SCALE_MIN)) {
    s = UK_SCALE_MIN;
  }
  s = Math.min(s, UK_SCALE_MAX);
  t.scale = s;
  t.fontSize = t.base[UK_B_FONT] * s;
  t.fontSmall = t.base[UK_B_FONT_SM] * s;
  t.fontLarge = t.base[UK_B_FONT_LG] * s;
  t.ctrlH = ukScI(t.base[UK_B_CTRL_H], s);
  t.rowH = ukScI(t.base[UK_B_ROW_H], s);
  t.pad = ukScI(t.base[UK_B_PAD], s);
  t.gap = ukScI(t.base[UK_B_GAP], s);
  t.radius = ukScI(t.base[UK_B_RADIUS], s);
  t.radiusSm = ukScI(t.base[UK_B_RADIUS_SM], s);
  t.stroke = ukScI(t.base[UK_B_STROKE], s);
  t.icon = ukScI(t.base[UK_B_ICON], s);
  t.scrollW = ukScI(t.base[UK_B_SCROLL_W], s);
  t.tabH = ukScI(t.base[UK_B_TAB_H], s);
  t.menuH = ukScI(t.base[UK_B_MENU_H], s);
  t.splitW = ukScI(t.base[UK_B_SPLIT_W], s);
  t.shadowBlur = ukScI(t.base[UK_B_SHADOW], s);
}

// 寸法を下限と上限に収める（負や 0、大きすぎる値で部品が壊れないように）。
function ukClampDim(v: f32, lo: f32, hi: f32): f32 {
  if (!(v >= lo)) {
    return lo;
  }
  return Math.min(v, hi);
}

// 名前で 1 つの値を設定する（tokens.json の読み取りと、試し・設定画面から使う）。
// 色の名前は "color.<名前>"、大きさは "size.<名前>"（倍率 1.0 の画素）、時間は "time.<名前>"（ミリ秒）。分からない名前なら false。
// 大きさと時間は下限・上限に収める。
export function ukThemeSet(t: mut UkTheme, name: string, color: u32, num: f32, isColor: bool): bool {
  if (isColor) {
    switch (name) {
      case "color.bg": t.bg = color; return true;
      case "color.panel": t.panel = color; return true;
      case "color.panelAlt": t.panelAlt = color; return true;
      case "color.raised": t.raised = color; return true;
      case "color.raisedHover": t.raisedHover = color; return true;
      case "color.raisedActive": t.raisedActive = color; return true;
      case "color.inputBg": t.inputBg = color; return true;
      case "color.border": t.border = color; return true;
      case "color.borderStrong": t.borderStrong = color; return true;
      case "color.lineControl": t.lineControl = color; return true;
      case "color.text": t.text = color; return true;
      case "color.textDim": t.textDim = color; return true;
      case "color.textOff": t.textOff = color; return true;
      case "color.accent": t.accent = color; return true;
      case "color.accentHover": t.accentHover = color; return true;
      case "color.accentActive": t.accentActive = color; return true;
      case "color.onAccent": t.onAccent = color; return true;
      case "color.danger": t.danger = color; return true;
      case "color.dangerHover": t.dangerHover = color; return true;
      case "color.success": t.success = color; return true;
      case "color.warning": t.warning = color; return true;
      case "color.focus": t.focus = color; return true;
      case "color.selection": t.selection = color; return true;
      case "color.track": t.track = color; return true;
      case "color.shadow": t.shadow = color; return true;
      case "color.tipBg": t.tipBg = color; return true;
      case "color.tipText": t.tipText = color; return true;
    }
    return false;
  }
  switch (name) {
    case "size.font": t.base[UK_B_FONT] = ukClampDim(num, 6.0, 72.0); return true;
    case "size.fontSmall": t.base[UK_B_FONT_SM] = ukClampDim(num, 6.0, 72.0); return true;
    case "size.fontLarge": t.base[UK_B_FONT_LG] = ukClampDim(num, 6.0, 96.0); return true;
    case "size.ctrlH": t.base[UK_B_CTRL_H] = ukClampDim(num, 12.0, 128.0); return true;
    case "size.rowH": t.base[UK_B_ROW_H] = ukClampDim(num, 12.0, 128.0); return true;
    case "size.pad": t.base[UK_B_PAD] = ukClampDim(num, 0.0, 64.0); return true;
    case "size.gap": t.base[UK_B_GAP] = ukClampDim(num, 0.0, 64.0); return true;
    case "size.radius": t.base[UK_B_RADIUS] = ukClampDim(num, 0.0, 64.0); return true;
    case "size.radiusSm": t.base[UK_B_RADIUS_SM] = ukClampDim(num, 0.0, 64.0); return true;
    case "size.stroke": t.base[UK_B_STROKE] = ukClampDim(num, 1.0, 8.0); return true;
    case "size.icon": t.base[UK_B_ICON] = ukClampDim(num, 8.0, 96.0); return true;
    case "size.scrollW": t.base[UK_B_SCROLL_W] = ukClampDim(num, 4.0, 64.0); return true;
    case "size.tabH": t.base[UK_B_TAB_H] = ukClampDim(num, 12.0, 128.0); return true;
    case "size.menuH": t.base[UK_B_MENU_H] = ukClampDim(num, 12.0, 128.0); return true;
    case "size.splitW": t.base[UK_B_SPLIT_W] = ukClampDim(num, 2.0, 32.0); return true;
    case "size.shadowBlur": t.base[UK_B_SHADOW] = ukClampDim(num, 0.0, 64.0); return true;
    case "time.tipDelay": t.tipDelay = (ukClampDim(num, 0.0, 5000.0) as f64) / 1000.0; return true;
    case "time.toastLife": t.toastLife = (ukClampDim(num, 500.0, 60000.0) as f64) / 1000.0; return true;
  }
  return false;
}

// ---- tokens.json の読み取り ----
//
// JSON の葉（色の "#rrggbb" / "#rrggbbaa"、数、"8px" / "600ms" のような単位つきの文字列）ごとに、キーの道筋を "." でつなぎ
// （DTCG の "value" / "$value" は飛ばす）、次の順で当てる:
//   1. 対応表 ukTokMap（MozaicCut の tokens.json の道筋。例: color.dark.bg.1 → color.panel と color.inputBg）
//   2. 道筋そのものが UkTheme の名前（"color.bg"、"size.ctrlH"、"time.tipDelay"）
// どちらにもない葉は「使わない値」として数える（クリップの色・ラベルの色など、uikit の外で使う値）。

// tokens.json の道筋 → UkTheme の名前（"," で区切って複数）。対応しなければ ""。
export function ukTokMap(path: string): string {
  switch (path) {
    case "color.dark.bg.0": return "color.bg";
    case "color.dark.bg.1": return "color.panel,color.inputBg";
    case "color.dark.bg.2": return "color.panelAlt";
    case "color.dark.bg.3": return "color.raised,color.track";
    case "color.dark.bg.4": return "color.raisedHover,color.raisedActive";
    case "color.dark.bg.popover": return "color.tipBg";
    case "color.dark.line.default": return "color.border";
    case "color.dark.line.strong": return "color.borderStrong";
    case "color.dark.line.control": return "color.lineControl";
    case "color.dark.text.1": return "color.text,color.tipText";
    case "color.dark.text.2": return "color.textDim";
    case "color.dark.text.disabled": return "color.textOff";
    case "color.dark.text.onDark": return "color.onAccent";
    case "color.dark.accent.default": return "color.accent,color.focus";
    case "color.dark.accent.hover": return "color.accentHover";
    case "color.dark.accent.tintSolid": return "color.selection";
    case "color.dark.semantic.ok": return "color.success";
    case "color.dark.semantic.warn": return "color.warning";
    case "color.dark.semantic.error": return "color.danger";
    case "font.size.md.size": return "size.font";
    case "font.size.sm.size": return "size.fontSmall";
    case "font.size.lg.size": return "size.fontLarge";
    case "size.button.md": return "size.ctrlH";
    case "space.2": return "size.pad";
    case "space.1": return "size.gap";
    case "radius.md": return "size.radius";
    case "radius.sm": return "size.radiusSm";
    case "border.hairline": return "size.stroke";
    case "size.icon.sm": return "size.icon";
    case "size.scrollbar": return "size.scrollW";
    case "size.tabBar": return "size.tabH";
    case "motion.duration.tooltipDelay": return "time.tipDelay";
    case "motion.duration.toastHold": return "time.toastLife";
  }
  return "";
}

// 対応表にある道筋の一覧（試しで、本物の tokens.json にすべてあるかを確かめる）。
export function ukTokPaths(): string[] {
  return [
    "color.dark.bg.0", "color.dark.bg.1", "color.dark.bg.2", "color.dark.bg.3", "color.dark.bg.4", "color.dark.bg.popover",
    "color.dark.line.default", "color.dark.line.strong", "color.dark.line.control", "color.dark.text.1", "color.dark.text.2",
    "color.dark.text.disabled", "color.dark.text.onDark", "color.dark.accent.default", "color.dark.accent.hover",
    "color.dark.accent.tintSolid", "color.dark.semantic.ok", "color.dark.semantic.warn", "color.dark.semantic.error",
    "font.size.md.size", "font.size.sm.size", "font.size.lg.size", "size.button.md", "space.2", "space.1", "radius.md",
    "radius.sm", "border.hairline", "size.icon.sm", "size.scrollbar", "size.tabBar", "motion.duration.tooltipDelay",
    "motion.duration.toastHold",
  ];
}

// 読み取りの結果。
export struct UkTokResult {
  // 設定できた UkTheme の値の数（読めない JSON なら -1）
  set: i32;
  // 当てられた道筋
  mapped: string[];
  // 色か寸法に見えるが、uikit では使わない（対応のない）道筋
  unused: string[];
}

function ukHexVal(b: u8): i32 {
  if (b >= 48 && b <= 57) {
    return (b as i32) - 48;
  }
  if (b >= 97 && b <= 102) {
    return (b as i32) - 87;
  }
  if (b >= 65 && b <= 70) {
    return (b as i32) - 55;
  }
  return -1;
}

// "#rrggbb" か "#rrggbbaa" を 0xAARRGGBB に。読めなければ -1。
export function ukParseHex(s: string): i64 {
  if (s.length != 7 && s.length != 9) {
    return -1;
  }
  if (s[0] != 35) {
    return -1;
  }
  let v: i64 = 0;
  for (let i: usize = 1; i < s.length; i++) {
    const h = ukHexVal(s[i]);
    if (h < 0) {
      return -1;
    }
    v = v * 16 + (h as i64);
  }
  if (s.length == 7) {
    return v | 0xff000000;
  }
  // rrggbbaa → aarrggbb
  return ((v & 255) << 24) | (v >> 8);
}

// 数を読む（"12"、"-1.5"、"8px"、"600ms"、"1.5rem" は読まない）。読めなければ false。単位は px と ms と無しだけ。
export function ukParseDim(s: string, out: mut f64[]): bool {
  let i: usize = 0;
  let neg = false;
  if (i < s.length && s[i] == 45) {
    neg = true;
    i++;
  }
  let v: f64 = 0.0;
  let any = false;
  while (i < s.length && s[i] >= 48 && s[i] <= 57) {
    v = v * 10.0 + ((s[i] - 48) as f64);
    i++;
    any = true;
  }
  if (i < s.length && s[i] == 46) {
    i++;
    let f: f64 = 0.1;
    while (i < s.length && s[i] >= 48 && s[i] <= 57) {
      v = v + ((s[i] - 48) as f64) * f;
      f = f * 0.1;
      i++;
      any = true;
    }
  }
  if (!any) {
    return false;
  }
  const rest = s.length - i;
  if (rest == 2 && ((s[i] == 112 && s[i + 1] == 120) || (s[i] == 109 && s[i + 1] == 115))) {
    // "px" か "ms"
  } else if (rest != 0) {
    return false;
  }
  out[0] = neg ? -v : v;
  return true;
}

function ukJsonWs(s: string, i0: usize): usize {
  let i = i0;
  while (i < s.length && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) {
    i++;
  }
  return i;
}

// s[i] が '"' の文字列を読み、終わりの次の位置を end[0] に書く。エスケープは \" と \\ だけ扱う。
function ukJsonStr(s: string, i0: usize, end: mut usize[]): string {
  let out: u8[] = [];
  let i = i0 + 1;
  while (i < s.length && s[i] != 34) {
    if (s[i] == 92 && i + 1 < s.length) {
      i++;
    }
    out.push(s[i]);
    i++;
  }
  end[0] = i + 1;
  return stringFromBytes(out);
}

// キーの道筋を "." でつなぐ（"value" / "$value" と、配列の中は除く）。配列の中なら ""。
function ukTokPath(path: string[]): string {
  let out = "";
  for (const p of path) {
    if (p == "[]") {
      return "";
    }
    if (p == "value" || p == "$value") {
      continue;
    }
    if (out.length > 0) {
      out = out + ".";
    }
    out = out + p;
  }
  return out;
}

// 1 つの葉を当てる。設定できた値の数を返す。
function ukTokApply(t: mut UkTheme, path: string[], color: u32, num: f32, isColor: bool, res: mut UkTokResult): i32 {
  const key = ukTokPath(path);
  if (key.length == 0) {
    return 0;
  }
  const names = ukTokMap(key);
  let n = 0;
  if (names.length > 0) {
    // "," で区切った名前を順に当てる
    let cur: u8[] = [];
    for (let i: usize = 0; i <= names.length; i++) {
      if (i == names.length || names[i] == 44) {
        const nm = stringFromBytes(cur);
        if (ukThemeSet(mut t, nm, color, num, isColor)) {
          n++;
        }
        cur.clear();
      } else {
        cur.push(names[i]);
      }
    }
  } else if (ukThemeSet(mut t, key, color, num, isColor)) {
    n = 1;
  }
  if (n > 0) {
    res.mapped.push(key);
  } else {
    res.unused.push(key);
  }
  return n;
}

// tokens.json を読んでテーマに当てる。戻り値は設定できた値の数（読めない JSON なら -1）。
export function ukThemeFromTokens(t: mut UkTheme, json: string): i32 {
  const r = ukThemeFromTokensEx(mut t, json);
  return r.set;
}

// ukThemeFromTokens と同じだが、当てた道筋と、使わなかった道筋も返す。
export function ukThemeFromTokensEx(t: mut UkTheme, json: string): UkTokResult {
  let res: UkTokResult = { set: 0, mapped: [], unused: [] };
  const accent0 = t.accent;
  const accentActive0 = t.accentActive;
  const danger0 = t.danger;
  const dangerHover0 = t.dangerHover;
  let path: string[] = [];
  // 各深さで、今のキーがあるか（配列の中なら false）
  let isObj: bool[] = [];
  let n = 0;
  let i = ukJsonWs(json, 0);
  let pendingKey = false;
  let end: usize[] = [0];
  let num: f64[] = [0.0];
  while (i < json.length) {
    const b = json[i];
    if (b == 123) {            // {
      isObj.push(true);
      path.push("");
      pendingKey = true;
      i++;
    } else if (b == 125) {     // }
      if (isObj.length == 0) {
        res.set = -1;
        return res;
      }
      isObj.pop();
      path.pop();
      i++;
    } else if (b == 91) {      // [
      isObj.push(false);
      path.push("[]");
      i++;
    } else if (b == 93) {      // ]
      if (isObj.length == 0) {
        res.set = -1;
        return res;
      }
      isObj.pop();
      path.pop();
      i++;
    } else if (b == 44) {      // ,
      if (isObj.length > 0 && isObj[isObj.length - 1]) {
        pendingKey = true;
      }
      i++;
    } else if (b == 58) {      // :
      pendingKey = false;
      i++;
    } else if (b == 34) {      // "
      const str = ukJsonStr(json, i, mut end);
      i = end[0];
      if (pendingKey && path.length > 0) {
        path[path.length - 1] = str;
        pendingKey = false;
      } else {
        const c = ukParseHex(str);
        if (c >= 0) {
          n += ukTokApply(mut t, path, c as u32, 0.0, true, mut res);
        } else if (ukParseDim(str, mut num)) {
          n += ukTokApply(mut t, path, 0, num[0] as f32, false, mut res);
        }
      }
    } else if ((b >= 48 && b <= 57) || b == 45) {
      let j = i;
      while (j < json.length && ((json[j] >= 48 && json[j] <= 57) || json[j] == 45 || json[j] == 46 || json[j] == 101 ||
        json[j] == 69 || json[j] == 43)) {
        j++;
      }
      let digits: u8[] = [];
      for (let k = i; k < j; k++) {
        digits.push(json[k]);
      }
      if (ukParseDim(stringFromBytes(digits), mut num)) {
        n += ukTokApply(mut t, path, 0, num[0] as f32, false, mut res);
      }
      i = j;
    } else {
      // true / false / null と空白
      i++;
    }
  }
  // tokens にない色を、読んだ色から作る
  if (t.accent != accent0 && t.accentActive == accentActive0) {
    t.accentActive = ukMix(t.accent, 0xff000000, 40);
  }
  if (t.danger != danger0 && t.dangerHover == dangerHover0) {
    t.dangerHover = ukMix(t.danger, 0xffffffff, 30);
  }
  const sc = t.scale;
  ukThemeScale(mut t, sc);
  res.set = n;
  return res;
}

// 四角の左右に、テーマの余白（pad）を取った内側。
export function ukThemeRectPad(t: UkTheme, r: UkRect): UkRect {
  return { x: r.x + t.pad, y: r.y, w: Math.max(r.w - 2 * t.pad, 0), h: r.h };
}
