// uikit とウィンドウ（UM の組み込み。中身は SDL3）のつなぎ: WindowEvent を uikit の入力に変える。画面を BMP に書く。
// ウィンドウを使うプログラムだけがこのファイルを import する（uikit のほかのファイルはウィンドウなしで動き、試しに使える）。
import {
  UkCtx, ukEventMouseMove, ukEventMouseButton, ukEventWheel, ukEventKey, ukEventMods, ukEventText,
  UK_KEY_TAB, UK_KEY_ENTER, UK_KEY_ESC, UK_KEY_BACKSPACE, UK_KEY_DELETE, UK_KEY_LEFT, UK_KEY_RIGHT, UK_KEY_UP,
  UK_KEY_DOWN, UK_KEY_HOME, UK_KEY_END, UK_KEY_PGUP, UK_KEY_PGDN, UK_KEY_SPACE, UK_KEY_F, UK_KEY_CHAR,
  UK_MOD_SHIFT, UK_MOD_CTRL, UK_MOD_ALT, UK_MOD_META,
} from "./core.um";

function ukModsBits(m: Mods): i32 {
  let b = 0;
  if (m.shift) {
    b = b | UK_MOD_SHIFT;
  }
  if (m.ctrl) {
    b = b | UK_MOD_CTRL;
  }
  if (m.alt) {
    b = b | UK_MOD_ALT;
  }
  if (m.meta) {
    b = b | UK_MOD_META;
  }
  return b;
}

function ukKeyCode(k: Key): i32 {
  match (k) {
    Key.Tab => { return UK_KEY_TAB; }
    Key.Enter => { return UK_KEY_ENTER; }
    Key.Escape => { return UK_KEY_ESC; }
    Key.Backspace => { return UK_KEY_BACKSPACE; }
    Key.Delete => { return UK_KEY_DELETE; }
    Key.Left => { return UK_KEY_LEFT; }
    Key.Right => { return UK_KEY_RIGHT; }
    Key.Up => { return UK_KEY_UP; }
    Key.Down => { return UK_KEY_DOWN; }
    Key.Home => { return UK_KEY_HOME; }
    Key.End => { return UK_KEY_END; }
    Key.PageUp => { return UK_KEY_PGUP; }
    Key.PageDown => { return UK_KEY_PGDN; }
    Key.Space => { return UK_KEY_SPACE; }
    Key.F(n) => { return UK_KEY_F + (n as i32); }
    Key.Char(cp) => { return UK_KEY_CHAR + (cp as i32); }
    _ => { return 0; }
  }
  return 0;
}

// ウィンドウのイベントの結果。
export struct UkWinRes {
  // 閉じる・終わるの要求
  quit: bool;
  // 大きさが変わった（新しい大きさ）
  resized: bool;
  w: i32;
  h: i32;
}

// ウィンドウのイベントを 1 つ uikit に渡す。
export function ukFeedWindowEvent(ui: mut UkCtx, e: WindowEvent, res: mut UkWinRes): void {
  match (e) {
    WindowEvent.Close(w) => { res.quit = true; }
    WindowEvent.Quit => { res.quit = true; }
    WindowEvent.Resize(w, nw, nh) => {
      if (nw > 0 && nh > 0) {
        res.resized = true;
        res.w = nw;
        res.h = nh;
      }
    }
    WindowEvent.MouseMove(w, x, y) => { ukEventMouseMove(mut ui, x, y); }
    WindowEvent.MouseDown(w, x, y, b) => { ukEventMouseButton(mut ui, x, y, b, true); }
    WindowEvent.MouseUp(w, x, y, b) => { ukEventMouseButton(mut ui, x, y, b, false); }
    WindowEvent.Wheel(w, dx, dy) => { ukEventWheel(mut ui, dx, dy); }
    WindowEvent.KeyDown(w, key, mods, rep) => {
      const k = ukKeyCode(key);
      if (k != 0) {
        ukEventKey(mut ui, k, ukModsBits(mods));
      } else {
        ukEventMods(mut ui, ukModsBits(mods));
      }
    }
    WindowEvent.KeyUp(w, key, mods) => { ukEventMods(mut ui, ukModsBits(mods)); }
    WindowEvent.Text(w, cp) => { ukEventText(mut ui, cp); }
    _ => {}
  }
}

export function ukWinResNew(): UkWinRes {
  return { quit: false, resized: false, w: 0, h: 0 };
}
