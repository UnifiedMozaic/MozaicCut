// 文字列の小さな道具。UM の文字列にはメソッドがないので、バイト単位で扱う。

// s[a..b) の部分文字列。
export function sub(s: string, a: usize, b: usize): string {
  let bytes: u8[] = [];
  for (let i = a; i < b; i++) {
    bytes.push(s[i]);
  }
  return stringFromBytes(bytes);
}

export function nan(): f64 {
  const z: f64 = 0.0;
  return z / z;
}

export function isNan(v: f64): bool {
  return v != v;
}

// 10 進の数（符号、小数点、指数を受け付ける）。読めなければ NaN。
export function parseNum(s: string): f64 {
  const n = s.length;
  if (n == 0) {
    return nan();
  }
  let i: usize = 0;
  let neg = false;
  if (s[0] == 45) {
    neg = true;
    i = 1;
  } else if (s[0] == 43) {
    i = 1;
  }
  let v: f64 = 0;
  let digits = 0;
  while (i < n && s[i] >= 48 && s[i] <= 57) {
    v = v * 10 + ((s[i] - 48) as f64);
    i++;
    digits++;
  }
  if (i < n && s[i] == 46) {
    i++;
    let scale: f64 = 0.1;
    while (i < n && s[i] >= 48 && s[i] <= 57) {
      v = v + ((s[i] - 48) as f64) * scale;
      scale = scale * 0.1;
      i++;
      digits++;
    }
  }
  if (digits == 0) {
    return nan();
  }
  if (i < n && (s[i] == 101 || s[i] == 69)) {
    i++;
    let eneg = false;
    if (i < n && s[i] == 45) {
      eneg = true;
      i++;
    } else if (i < n && s[i] == 43) {
      i++;
    }
    let e = 0;
    let edigits = 0;
    while (i < n && s[i] >= 48 && s[i] <= 57) {
      // 400 を超える指数は f64 では無限大か 0 になるので、そこで打ち切る（長いループと桁あふれを避ける）
      if (e <= 400) {
        e = e * 10 + ((s[i] - 48) as i32);
      }
      i++;
      edigits++;
    }
    if (edigits == 0) {
      return nan();
    }
    for (let k = 0; k < e; k++) {
      if (eneg) {
        v = v / 10;
      } else {
        v = v * 10;
      }
    }
  }
  if (i != n) {
    return nan();
  }
  if (neg) {
    return -v;
  }
  return v;
}

// 時間。秒（"12.5"）か、"分:秒"（"1:02.5"）、"時:分:秒"。読めなければ NaN。
export function parseTime(s: string): f64 {
  const n = s.length;
  let total: f64 = 0;
  let start: usize = 0;
  let parts = 0;
  for (let i: usize = 0; i <= n; i++) {
    if (i == n || s[i] == 58) {
      const part = parseNum(sub(s, start, i));
      if (isNan(part) || part < 0) {
        return nan();
      }
      // 分:秒 / 時:分:秒 の後ろの欄（分と秒）は 60 未満（1:99 は誤り）
      if (parts > 0 && part >= 60) {
        return nan();
      }
      total = total * 60 + part;
      parts++;
      start = i + 1;
    }
  }
  if (parts > 3) {
    return nan();
  }
  return total;
}

function hexDigit(c: u8): i32 {
  if (c >= 48 && c <= 57) {
    return (c - 48) as i32;
  }
  if (c >= 97 && c <= 102) {
    return (c - 87) as i32;
  }
  if (c >= 65 && c <= 70) {
    return (c - 55) as i32;
  }
  return -1;
}

// 色。"rrggbb" / "rrggbbaa"（先頭の # は省略可）か名前。0xRRGGBBAA を返す。読めなければ -1。
export function parseColor(s: string): i64 {
  switch (s) {
    case "white":
      return 0xffffffff;
    case "black":
      return 0x000000ff;
    case "red":
      return 0xff3030ff;
    case "green":
      return 0x30d050ff;
    case "blue":
      return 0x3060ffff;
    case "yellow":
      return 0xffe030ff;
    case "gray":
      return 0x808080ff;
    case "transparent":
    case "none":
      return 0;
  }
  let i: usize = 0;
  if (s.length > 0 && s[0] == 35) {
    i = 1;
  }
  const digits = s.length - i;
  if (digits != 6 && digits != 8) {
    return -1;
  }
  let v: i64 = 0;
  while (i < s.length) {
    const d = hexDigit(s[i]);
    if (d < 0) {
      return -1;
    }
    v = v * 16 + (d as i64);
    i++;
  }
  if (digits == 6) {
    v = v * 256 + 255;
  }
  return v;
}

// 整数の 10 進表記を UTF-8 のバイトで返す（BMP や Y4M のヘッダ用）。
export function intText(v: i64): string {
  return `${v}`;
}

export function appendText(out: mut u8[], s: string): void {
  for (const b of s) {
    out.push(b);
  }
}

// 区切り文字で分ける（タブ区切りの probe ファイル用）。
export function splitBy(s: string, sep: u8): string[] {
  let out: string[] = [];
  let start: usize = 0;
  for (let i: usize = 0; i <= s.length; i++) {
    if (i == s.length || s[i] == sep) {
      out.push(sub(s, start, i));
      start = i + 1;
    }
  }
  return out;
}

// バイト列を行に分ける（\r\n も \n も受け付ける）。
export function splitLines(bytes: u8[]): string[] {
  let out: string[] = [];
  let line: u8[] = [];
  for (const b of bytes) {
    if (b == 10) {
      if (line.length > 0 && line[line.length - 1] == 13) {
        line.pop();
      }
      out.push(stringFromBytes(line));
      line.clear();
    } else {
      line.push(b);
    }
  }
  if (line.length > 0) {
    if (line[line.length - 1] == 13) {
      line.pop();
    }
    out.push(stringFromBytes(line));
  }
  return out;
}

// 時間の表示（m:ss.mmm）。
export function fmtTime(t: f64): string {
  const ms = Math.floor(t * 1000 + 0.5) as i64;
  const m = ms / 60000;
  const s = (ms % 60000) / 1000;
  const frac = ms % 1000;
  let ss = `${s}`;
  if (s < 10) {
    ss = `0${s}`;
  }
  let ff = `${frac}`;
  if (frac < 10) {
    ff = `00${frac}`;
  } else if (frac < 100) {
    ff = `0${frac}`;
  }
  return `${m}:${ss}.${ff}`;
}

// s のバイト位置 b が何文字目か（1 から）。UTF-8 の 1 文字を 1 と数える（続きのバイト 10xxxxxx は数えない）。
export function textCharCol(s: string, b: usize): i32 {
  let col = 1;
  let i: usize = 0;
  while (i < b && i < s.length) {
    if ((s[i] & 0xc0) != 0x80) {
      col++;
    }
    i++;
  }
  return col;
}

// 編集距離（Levenshtein。バイト単位）。キーの候補の提示に使う。
export function textEditDistance(a: string, b: string): i32 {
  const m = b.length;
  let prev: i32[] = [];
  let cur: i32[] = [];
  for (let j: usize = 0; j <= m; j++) {
    prev.push(j as i32);
    cur.push(0);
  }
  for (let i: usize = 1; i <= a.length; i++) {
    cur[0] = i as i32;
    for (let j: usize = 1; j <= m; j++) {
      let cost = 1;
      if (a[i - 1] == b[j - 1]) {
        cost = 0;
      }
      let v = prev[j - 1] + cost;
      v = Math.min(v, prev[j] + 1);
      v = Math.min(v, cur[j - 1] + 1);
      cur[j] = v;
    }
    for (let j: usize = 0; j <= m; j++) {
      prev[j] = cur[j];
    }
  }
  return prev[m];
}

// word に近い候補（編集距離が小さいもの）。十分に近いものがなければ ""。同じ距離なら先の候補。
export function textNearest(word: string, cands: string[]): string {
  let limit = 1;
  if (word.length > 3) {
    limit = 2;
  }
  if (word.length > 7) {
    limit = 3;
  }
  let best = "";
  let bestD = limit + 1;
  for (const c of cands) {
    if (c == word) {
      continue;
    }
    const d = textEditDistance(word, c);
    if (d < bestD && d < (word.length as i32)) {
      best = c.clone();
      bestD = d;
    }
  }
  if (best != "") {
    return best;
  }
  // 近いものがなければ、片方がもう片方の先頭になっているもの（"brightness" と "bright"）。3 文字以上に限る。
  for (const c of cands) {
    if (c == word || c.length < 3 || word.length < 3) {
      continue;
    }
    if (textStartsWith(word, c) || textStartsWith(c, word)) {
      return c.clone();
    }
  }
  return "";
}

// s が prefix で始まるか。
export function textStartsWith(s: string, prefix: string): bool {
  if (prefix.length > s.length) {
    return false;
  }
  for (let i: usize = 0; i < prefix.length; i++) {
    if (s[i] != prefix[i]) {
      return false;
    }
  }
  return true;
}

// 数の表示（小数は 4 桁で丸め、末尾の 0 を落とす）。範囲の説明に使う。
export function textNum(v: f64): string {
  let neg = false;
  let x = v;
  if (x < 0) {
    neg = true;
    x = -x;
  }
  const scaled = Math.floor(x * 10000 + 0.5) as i64;
  const ip = scaled / 10000;
  let frac = scaled % 10000;
  let s = `${ip}`;
  if (frac != 0) {
    let digits = 4;
    while (frac % 10 == 0) {
      frac = frac / 10;
      digits--;
    }
    let fs = `${frac}`;
    while ((fs.length as i32) < digits) {
      fs = "0" + fs;
    }
    s = s + "." + fs;
  }
  if (neg && scaled != 0) {
    s = "-" + s;
  }
  return s;
}
