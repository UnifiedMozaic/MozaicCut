// ui_ai の描く道具: 札・キーの札・ボタン・チェック・斜線・点線・アイコン（✦ 人 </> など）・折り返し。
// uikit にまだない部品を、ここで仮に作る（報告の「uikit に足すべきもの」）。色と寸法はすべて AiTheme から取る。
import {
  UkCtx, UkHit, ukBehavior, ukId, ukDrawRect, ukDrawRound, ukDrawStroke, ukDrawLine, ukDrawTri, ukDrawCircle,
  ukDrawText, ukDrawTextIn, ukTextW, ukLineH, ukPushClip, ukPopClip, ukTooltip, ukMouseIn, ukBehaviorEx, ukWheelTake,
} from "../../ui/kit/core.um";
import { UkRect, ukRect, ukAlpha, ukShrink, ukNextChar, ukSub, ukIntersect } from "../../ui/kit/base.um";
import { glyphIndex, glyphAdvance } from "../../effects/text/ttf.um";
import { ukIcon, UK_I_CHECK, UK_I_WARN, UK_I_CLOSE, UK_I_EYE } from "../../ui/kit/icons.um";
import { AiTheme } from "./ai_theme.um";
import { aiStrs, AI_CHIP_PLAIN, AI_CHIP_RIPPLE, AI_CHIP_OK, AI_CHIP_WARN, AI_CHIP_ERR, AI_CHIP_AI, AI_CHIP_MONO } from "./ai_model.um";

// ---- アイコン（線と三角で描く。倍率でにじまない） ----

// ✦（AI の印）: 大きい 4 つ角の星と、右下の小さい星。
export function aiIconSparkle(ui: mut UkCtx, r: UkRect, c: u32): void {
  const s = Math.min(r.w, r.h) as f32;
  const x0 = r.x as f32;
  const y0 = r.y as f32;
  aiStar(mut ui, x0 + s * 0.375, y0 + s * 0.42, s * 0.30, s * 0.075, c);
  aiStar(mut ui, x0 + s * 0.72, y0 + s * 0.77, s * 0.15, s * 0.045, c);
}

function aiStar(ui: mut UkCtx, cx: f32, cy: f32, R: f32, w: f32, c: u32): void {
  ukDrawTri(mut ui, cx, cy - R, cx - w, cy, cx + w, cy, c);
  ukDrawTri(mut ui, cx, cy + R, cx - w, cy, cx + w, cy, c);
  ukDrawTri(mut ui, cx - R, cy, cx, cy - w, cx, cy + w, c);
  ukDrawTri(mut ui, cx + R, cy, cx, cy - w, cx, cy + w, c);
}

// 人（頭の丸と肩の弧）。
export function aiIconPerson(ui: mut UkCtx, r: UkRect, c: u32): void {
  const s = Math.min(r.w, r.h) as f32;
  const x0 = r.x as f32;
  const y0 = r.y as f32;
  const t = Math.max(s * 0.09, 1.2);
  ukDrawCircle(mut ui, x0 + s * 0.5, y0 + s * 0.34, s * 0.16, t, c);
  // 肩: 半円を 6 本の線で
  const cx = x0 + s * 0.5;
  const cy = y0 + s * 0.86;
  const R = s * 0.31;
  let px = cx - R;
  let py = cy;
  for (let k = 1; k <= 6; k++) {
    const a = 3.14159265 * (1.0 - (k as f32) / 6.0);
    const nx = cx + R * aiCos(a);
    const ny = cy - R * aiSin(a);
    ukDrawLine(mut ui, px, py, nx, ny, t, c);
    px = nx;
    py = ny;
  }
}

// </>（テキスト＝外のエディタの印）。
export function aiIconCode(ui: mut UkCtx, r: UkRect, c: u32): void {
  const s = Math.min(r.w, r.h) as f32;
  const x0 = r.x as f32;
  const y0 = r.y as f32;
  const t = Math.max(s * 0.09, 1.2);
  ukDrawLine(mut ui, x0 + s * 0.34, y0 + s * 0.28, x0 + s * 0.12, y0 + s * 0.5, t, c);
  ukDrawLine(mut ui, x0 + s * 0.12, y0 + s * 0.5, x0 + s * 0.34, y0 + s * 0.72, t, c);
  ukDrawLine(mut ui, x0 + s * 0.66, y0 + s * 0.28, x0 + s * 0.88, y0 + s * 0.5, t, c);
  ukDrawLine(mut ui, x0 + s * 0.88, y0 + s * 0.5, x0 + s * 0.66, y0 + s * 0.72, t, c);
  ukDrawLine(mut ui, x0 + s * 0.56, y0 + s * 0.22, x0 + s * 0.44, y0 + s * 0.78, t, c);
}

// 取り消す（左向きの曲がった矢印）。redo なら左右を反転。
export function aiIconUndo(ui: mut UkCtx, r: UkRect, c: u32, redo: bool): void {
  const s = Math.min(r.w, r.h) as f32;
  const x0 = r.x as f32;
  const y0 = r.y as f32;
  const t = Math.max(s * 0.09, 1.2);
  const f: f32 = redo ? -1.0 : 1.0;
  const cx = x0 + s * 0.5;
  const xa = cx + (0.34 - 0.5) * s * f;
  const xb = cx + (0.16 - 0.5) * s * f;
  const xc = cx + (0.6 - 0.5) * s * f;
  const xd = cx + (0.44 - 0.5) * s * f;
  ukDrawLine(mut ui, xa, y0 + s * 0.2, xb, y0 + s * 0.38, t, c);
  ukDrawLine(mut ui, xb, y0 + s * 0.38, xa, y0 + s * 0.56, t, c);
  ukDrawLine(mut ui, xb, y0 + s * 0.38, xc, y0 + s * 0.38, t, c);
  // 右の弧
  const acx = xc;
  const acy = y0 + s * 0.6;
  const R = s * 0.22;
  let px = acx;
  let py = acy - R;
  for (let k = 1; k <= 6; k++) {
    const a = 3.14159265 * (0.5 - (k as f32) / 6.0);
    const nx = acx + R * aiCos(a) * f;
    const ny = acy - R * aiSin(a);
    ukDrawLine(mut ui, px, py, nx, ny, t, c);
    px = nx;
    py = ny;
  }
  ukDrawLine(mut ui, px, py, xd, py, t, c);
}

// エラー（丸に ×）。
export function aiIconError(ui: mut UkCtx, r: UkRect, c: u32): void {
  const s = Math.min(r.w, r.h) as f32;
  const cx = (r.x as f32) + s * 0.5;
  const cy = (r.y as f32) + s * 0.5;
  const t = Math.max(s * 0.09, 1.2);
  ukDrawCircle(mut ui, cx, cy, s * 0.38, t, c);
  const d = s * 0.14;
  ukDrawLine(mut ui, cx - d, cy - d, cx + d, cy + d, t, c);
  ukDrawLine(mut ui, cx - d, cy + d, cx + d, cy - d, t, c);
}

export function aiIconWarn(ui: mut UkCtx, r: UkRect, c: u32): void {
  ukIcon(mut ui, r, UK_I_WARN, c);
}

export function aiIconOk(ui: mut UkCtx, r: UkRect, c: u32): void {
  const s = Math.min(r.w, r.h) as f32;
  const t = Math.max(s * 0.09, 1.2);
  ukDrawCircle(mut ui, (r.x as f32) + s * 0.5, (r.y as f32) + s * 0.5, s * 0.42, t, c);
  ukIcon(mut ui, ukShrink(r, Math.max(r.w / 4, 1)), UK_I_CHECK, c);
}

export function aiIconEye(ui: mut UkCtx, r: UkRect, c: u32): void {
  ukIcon(mut ui, r, UK_I_EYE, c);
}

// 書き手の印（人 ／ AI ／ テキスト）。
export function aiIconWho(ui: mut UkCtx, th: AiTheme, r: UkRect, who: i32): void {
  if (who == 1) {
    aiIconSparkle(mut ui, r, th.ai);
  } else if (who == 2) {
    aiIconCode(mut ui, r, th.textSource);
  } else {
    aiIconPerson(mut ui, r, th.text2);
  }
}

// cos と sin（Math にまだないので、周期で割った余りを -π〜π に寄せてテイラー展開）。
// 引数がどれだけ大きくても（Inf・NaN でも）繰り返しは一定で、止まらない。
export function aiCos(x0: f32): f32 {
  const pi: f64 = 3.141592653589793;
  let v = x0 as f64;
  if (!(v == v) || v > 1.0e15 || v < -1.0e15) {
    return 1.0;
  }
  // 周期の何周目かを捨てて、0〜1 の位相にしてから -π〜π へ
  let ph = v / (2.0 * pi);
  ph = ph - Math.floor(ph);
  if (ph > 0.5) {
    ph = ph - 1.0;
  }
  const x = (ph * 2.0 * pi) as f32;
  const x2 = x * x;
  return 1.0 - x2 / 2.0 + x2 * x2 / 24.0 - x2 * x2 * x2 / 720.0 + x2 * x2 * x2 * x2 / 40320.0 - x2 * x2 * x2 * x2 * x2 / 3628800.0;
}

// 明滅の強さ（0〜1）。elapsed は始まってからの秒、period は周期の秒（tokens の aiPulse）。
// 周期が 0 以下か「動きを減らす」のときは明滅させず、1 を返す（呼ぶ側は wantFrame を立てない）。
export function aiPulseK(elapsed: f64, period: f64, reduce: bool): f64 {
  if (reduce || !(period > 0.0) || !(elapsed == elapsed)) {
    return 1.0;
  }
  let ph = elapsed / period;
  ph = ph - Math.floor(ph);
  return 0.5 + 0.5 * (aiCos((ph * 6.283185307179586) as f32) as f64);
}

export function aiSin(x: f32): f32 {
  return aiCos(x - 1.57079633);
}

// ---- 線・点線・斜線 ----

// 点線の四角（1 本の太さ t。on 画素描いて off 画素空ける）。
export function aiDashRect(ui: mut UkCtx, r: UkRect, c: u32, t: i32, on: i32, off: i32): void {
  const step = on + off;
  let x = r.x;
  while (x < r.x + r.w) {
    const w = Math.min(on, r.x + r.w - x);
    ukDrawRect(mut ui, ukRect(x, r.y, w, t), c);
    ukDrawRect(mut ui, ukRect(x, r.y + r.h - t, w, t), c);
    x = x + step;
  }
  let y = r.y;
  while (y < r.y + r.h) {
    const h = Math.min(on, r.y + r.h - y);
    ukDrawRect(mut ui, ukRect(r.x, y, t, h), c);
    ukDrawRect(mut ui, ukRect(r.x + r.w - t, y, t, h), c);
    y = y + step;
  }
}

// 斜線（右上がり 45 度。period 画素ごと、太さ w）で四角を塗る。
export function aiHatch(ui: mut UkCtx, r: UkRect, c: u32, period: i32, w: f32): void {
  if (r.w <= 0 || r.h <= 0) {
    return;
  }
  ukPushClip(mut ui, r);
  const p = Math.max(period, 2);
  let k = r.x - r.h;
  while (k < r.x + r.w + p) {
    ukDrawLine(mut ui, k as f32, (r.y + r.h) as f32, (k + r.h) as f32, r.y as f32, w, c);
    k = k + p;
  }
  ukPopClip(mut ui);
}

// ---- 文字 ----

// s[i] から始まる UTF-8 の 1 文字の符号位置。
export function aiCp(s: string, i: usize): i32 {
  const b0 = s[i] as i32;
  if (b0 < 0x80) {
    return b0;
  }
  if (b0 >= 0xf0 && i + 3 < s.length) {
    return ((b0 & 7) << 18) | (((s[i + 1] as i32) & 63) << 12) | (((s[i + 2] as i32) & 63) << 6) | ((s[i + 3] as i32) & 63);
  }
  if (b0 >= 0xe0 && i + 2 < s.length) {
    return ((b0 & 15) << 12) | (((s[i + 1] as i32) & 63) << 6) | ((s[i + 2] as i32) & 63);
  }
  if (b0 >= 0xc0 && i + 1 < s.length) {
    return ((b0 & 31) << 6) | ((s[i + 1] as i32) & 63);
  }
  return 0xfffd;
}

// 1 文字の送り幅（画素。小数）。フォントがなければ uikit の測り方に任せる。
function aiCharW(ui: mut UkCtx, s: string, i: usize, j: usize, cp: i32, size: f32): f32 {
  if (!ui.font.ok) {
    return ukTextW(mut ui, ukSub(s, i, j), size) as f32;
  }
  return (glyphAdvance(ui.font, glyphIndex(ui.font, cp)) as f32) * size / (ui.font.unitsPerEm as f32);
}

// 行の頭に置かない文字（行頭禁則）: 句読点・閉じ括弧・小さい仮名・長音・「？！」・繰り返しの記号など。
export function aiNoStartCp(c: i32): bool {
  if (c < 0x80) {
    return c == 44 || c == 46 || c == 41 || c == 93 || c == 125 || c == 58 || c == 59 || c == 33 || c == 63 || c == 37;
  }
  // 、。〃々〉》」』】〕〗〙
  if (c == 0x3001 || c == 0x3002 || c == 0x3003 || c == 0x3005 || c == 0x3009 || c == 0x300b || c == 0x300d ||
    c == 0x300f || c == 0x3011 || c == 0x3015 || c == 0x3017 || c == 0x3019) {
    return true;
  }
  // 小さい平仮名 ぁぃぅぇぉっゃゅょゎゕゖ と ゝゞ
  if (c == 0x3041 || c == 0x3043 || c == 0x3045 || c == 0x3047 || c == 0x3049 || c == 0x3063 || c == 0x3083 ||
    c == 0x3085 || c == 0x3087 || c == 0x308e || c == 0x3095 || c == 0x3096 || c == 0x309d || c == 0x309e) {
    return true;
  }
  // 小さい片仮名 ァィゥェォッャュョヮヵヶ と ・ー ヽヾ
  if (c == 0x30a1 || c == 0x30a3 || c == 0x30a5 || c == 0x30a7 || c == 0x30a9 || c == 0x30c3 || c == 0x30e3 ||
    c == 0x30e5 || c == 0x30e7 || c == 0x30ee || c == 0x30f5 || c == 0x30f6 || c == 0x30fb || c == 0x30fc ||
    c == 0x30fd || c == 0x30fe) {
    return true;
  }
  // 全角の ！），．：；？］｝ と ’ ” ‥ …
  return c == 0xff01 || c == 0xff09 || c == 0xff0c || c == 0xff0e || c == 0xff1a || c == 0xff1b || c == 0xff1f ||
    c == 0xff3d || c == 0xff5d || c == 0x2019 || c == 0x201d || c == 0x2025 || c == 0x2026;
}

// 行の終わりに置かない文字（行末禁則）: 開き括弧。
export function aiNoEndCp(c: i32): bool {
  if (c < 0x80) {
    return c == 40 || c == 91 || c == 123;
  }
  // 〈《「『【〔〖〘（［｛‘“
  return c == 0x3008 || c == 0x300a || c == 0x300c || c == 0x300e || c == 0x3010 || c == 0x3014 || c == 0x3016 ||
    c == 0x3018 || c == 0xff08 || c == 0xff3b || c == 0xff5b || c == 0x2018 || c == 0x201c;
}

// 和文の文字か（その前後で折り返してよい）。
function aiWideCp(c: i32): bool {
  return c >= 0x2000;
}

// prev と c の間で折り返してよいか。英数字が続くところ（ID・op の文）は空白か「, ; /」の後だけ。
export function aiCanBreak(prev: i32, c: i32): bool {
  if (prev < 0 || aiNoStartCp(c) || aiNoEndCp(prev)) {
    return false;
  }
  if (prev == 32) {
    return true;
  }
  if (c == 32) {
    return false;
  }
  if (aiWideCp(prev) || aiWideCp(c)) {
    return true;
  }
  return prev == 44 || prev == 59 || prev == 47;
}

// 文字を幅 maxW で折り返す（禁則つき）。1 文字ずつ送り幅を足していくので、1 行で O(n)。
// 折り返せる所（aiCanBreak）がなければ文字の途中で切る。行頭禁則の文字は前の行にぶら下げる（はみ出してよい）。
export function aiWrap(ui: mut UkCtx, s: string, size: f32, maxW: i32): string[] {
  let out: string[] = [];
  if (s.length == 0) {
    return out;
  }
  const mw = Math.max(maxW, 1) as f32;
  let start: usize = 0;
  let w: f32 = 0.0;
  let brk: usize = 0;      // 折り返せる所（その文字の前）。start と同じなら無い
  let wBrk: f32 = 0.0;     // brk までの幅
  let prev: i32 = -1;
  let i: usize = 0;
  while (i < s.length) {
    const j = ukNextChar(s, i);
    const cp = aiCp(s, i);
    const cw = aiCharW(mut ui, s, i, j, cp, size);
    if (i > start && aiCanBreak(prev, cp)) {
      brk = i;
      wBrk = w;
    }
    if (i > start && w + cw > mw) {
      if (brk > start) {
        // 折り返せる所で切る（行末の空白は捨てる）
        out.push(aiTrimEnd(ukSub(s, start, brk)));
        w = w - wBrk;
        start = brk;
      } else if (aiNoStartCp(cp)) {
        // 行頭禁則: この文字まで前の行に入れる
        out.push(ukSub(s, start, j));
        start = j;
        w = 0.0;
        brk = start;
        prev = cp;
        i = j;
        continue;
      } else {
        out.push(ukSub(s, start, i));
        start = i;
        w = 0.0;
      }
      brk = start;
      // 行の頭の空白は飛ばす
      while (start < s.length && s[start] == 32) {
        start++;
      }
      if (start > i) {
        i = start;
        w = 0.0;
        prev = 32;
        continue;
      }
    }
    w = w + cw;
    prev = cp;
    i = j;
  }
  if (start < s.length) {
    out.push(ukSub(s, start, s.length));
  }
  return out;
}

function aiTrimEnd(s: string): string {
  let e = s.length;
  while (e > 0 && s[e - 1] == 32) {
    e--;
  }
  return ukSub(s, 0, e);
}

// lines を n 行までに切り、切ったなら最後の行の終わりを「…」にする。
export function aiClampLines(ui: mut UkCtx, lines: string[], n: usize, size: f32, maxW: i32): string[] {
  if (lines.length <= n) {
    return aiStrs(lines);
  }
  let out: string[] = [];
  for (let i: usize = 0; i + 1 < n; i++) {
    out.push(lines[i].clone());
  }
  let last = lines[n - 1].clone();
  const ell = "…";
  while (last.length > 0 && ukTextW(mut ui, last + ell, size) > maxW) {
    // 最後の 1 文字を落とす
    let k: usize = 0;
    let p: usize = 0;
    while (k < last.length) {
      p = k;
      k = ukNextChar(last, k);
    }
    last = ukSub(last, 0, p);
  }
  out.push(last + ell);
  return out;
}

// 1 行の文字を、行の高さ lh の箱の上下中央に描く。幅を返す。
export function aiText(ui: mut UkCtx, x: i32, y: i32, lh: i32, s: string, size: f32, c: u32): i32 {
  const h = ukLineH(ui, size);
  return ukDrawText(mut ui, x, y + (lh - h) / 2, s, size, c);
}

// 太字（600）の代わり: 1px ずらして 2 回描く（uikit に太字のフォントが入るまでの仮）。幅を返す。
export function aiTextBold(ui: mut UkCtx, x: i32, y: i32, lh: i32, s: string, size: f32, c: u32): i32 {
  aiText(mut ui, x + 1, y, lh, s, size, c);
  return aiText(mut ui, x, y, lh, s, size, c) + 1;
}

// 取り消し線つきの文字（人が外した op）。
export function aiTextStrike(ui: mut UkCtx, x: i32, y: i32, lh: i32, s: string, size: f32, c: u32, t: i32): i32 {
  const w = aiText(mut ui, x, y, lh, s, size, c);
  ukDrawRect(mut ui, ukRect(x, y + lh / 2, w, t), c);
  return w;
}

// ---- 札（チップ） ----

// 札の地と文字の色: [地, 文字]。薄い地は tokens の semantic.*Tint。
export function aiChipColors(th: AiTheme, kind: i32): u32[] {
  if (kind == AI_CHIP_RIPPLE) {
    return [th.rippleTint, th.ripple];
  }
  if (kind == AI_CHIP_OK) {
    return [th.okTint, th.ok];
  }
  if (kind == AI_CHIP_WARN) {
    return [th.warnTint, th.warn];
  }
  if (kind == AI_CHIP_ERR) {
    return [th.errorTint, th.error];
  }
  if (kind == AI_CHIP_AI) {
    return [th.aiTint, th.ai];
  }
  return [th.bg3, th.text2];
}

export function aiChipW(ui: mut UkCtx, th: AiTheme, text: string, size: f32): i32 {
  return ukTextW(mut ui, text, size) + th.s2 - 1 + th.s2 - 1;
}

// 札を (x, y) に高さ h で描き、幅を返す。maxW を超えるなら「…」で縮める。
export function aiDrawChip(ui: mut UkCtx, th: AiTheme, x: i32, y: i32, h: i32, kind: i32, text: string, size: f32, maxW: i32): i32 {
  const cc = aiChipColors(th, kind);
  const padX = th.s2 - 1;
  const w = Math.min(ukTextW(mut ui, text, size) + padX * 2, maxW);
  const r = ukRect(x, y, w, h);
  ukDrawRound(mut ui, r, th.rSm, cc[0]);
  ukDrawTextIn(mut ui, ukRect(x + padX, y, w - padX * 2, h), text, size, cc[1], 0);
  return w;
}

// 札を左から並べ、幅 maxW で折り返す。並べた高さを返す。
export function aiChipFlow(
  ui: mut UkCtx, th: AiTheme, x: i32, y: i32, maxW: i32, h: i32, kinds: i32[], texts: string[], size: f32,
): i32 {
  let cx = x;
  let cy = y;
  const gap = th.s1;
  for (let i: usize = 0; i < texts.length; i++) {
    const sz = aiChipSize(th, kinds[i], size);
    const w = Math.min(aiChipW(mut ui, th, texts[i], sz), maxW);
    if (cx > x && cx + w > x + maxW) {
      cx = x;
      cy = cy + h + gap;
    }
    aiDrawChip(mut ui, th, cx, cy, h, kinds[i], texts[i], sz, maxW);
    cx = cx + w + gap;
  }
  return cy + h - y;
}

// 札を折り返したときの高さ（描かずに測る）。
export function aiChipFlowH(ui: mut UkCtx, th: AiTheme, maxW: i32, h: i32, kinds: i32[], texts: string[], size: f32): i32 {
  if (texts.length == 0) {
    return 0;
  }
  let cx = 0;
  let rows = 1;
  for (let i: usize = 0; i < texts.length; i++) {
    const w = Math.min(aiChipW(mut ui, th, texts[i], aiChipSize(th, kinds[i], size)), maxW);
    if (cx > 0 && cx + w > maxW) {
      cx = 0;
      rows++;
    }
    cx = cx + w + th.s1;
  }
  return rows * h + (rows - 1) * th.s1;
}

// 札の文字の大きさ: ID・タイムコードの札（MONO）は xs（英数字だけ）、ほかは和文の入る size（sm 以上）。
export function aiChipSize(th: AiTheme, kind: i32, size: f32): f32 {
  if (kind == AI_CHIP_MONO) {
    return th.fsXs;
  }
  return size;
}

// キーの札（"Ctrl Enter"）。fg は文字、border は枠（ボタンの中なら薄い枠）。幅を返す。
export function aiKbd(ui: mut UkCtx, th: AiTheme, x: i32, y: i32, text: string, fg: u32, bg: u32, border: u32): i32 {
  const size = th.fsXs;
  const h = th.lhXs + 4 * th.hairline;
  const padX = th.s1 + th.hairline;
  const w = ukTextW(mut ui, text, size) + padX * 2;
  const r = ukRect(x, y, w, h);
  if ((bg >> 24) != 0) {
    ukDrawRound(mut ui, r, th.rSm, bg);
  }
  ukDrawStroke(mut ui, r, th.rSm, th.hairline, border);
  ukDrawTextIn(mut ui, ukRect(x + padX, y, w - padX * 2, h), text, size, fg, 0);
  return w;
}

export function aiKbdW(ui: mut UkCtx, th: AiTheme, text: string): i32 {
  return ukTextW(mut ui, text, th.fsXs) + (th.s1 + th.hairline) * 2;
}

// ---- ボタン ----

export const AI_BTN_SECONDARY: i32 = 0;
export const AI_BTN_AI: i32 = 1;        // AI の主のボタン（紫の地）
export const AI_BTN_QUIET: i32 = 2;     // 地も枠もない
export const AI_BTN_LINK: i32 = 3;      // 文字だけ（accent.hover）

// ボタンの自然な幅（文字・キーの札・アイコン）。
export function aiButtonW(ui: mut UkCtx, th: AiTheme, text: string, kbd: string, icon: bool, size: f32): i32 {
  let w = ukTextW(mut ui, text, size) + th.s3 * 2;
  if (kbd.length > 0) {
    w = w + th.s1 + 2 + aiKbdW(mut ui, th, kbd);
  }
  if (icon) {
    w = w + th.iconSm + th.s1 + 2;
  }
  return w;
}

// ボタン。id は ukId のラベル（"##" で区別）、icon が true なら左に ✦。押されたら true。
export function aiButton(
  ui: mut UkCtx, th: AiTheme, label: string, r: UkRect, kind: i32, text: string, kbd: string, icon: bool, size: f32,
): bool {
  const id = ukId(ui, label);
  const h = ukBehavior(mut ui, id, r, true);
  let bg: u32 = 0;
  let fg = th.text1;
  let border: u32 = 0;
  if (kind == AI_BTN_AI) {
    bg = h.held ? th.ai : (h.hover ? aiLift(th.ai) : th.ai);
    fg = th.textOnAi;
  } else if (kind == AI_BTN_SECONDARY) {
    bg = h.held ? th.bg2 : (h.hover ? th.bg4 : th.bg3);
    border = th.lineStrong;
  } else if (kind == AI_BTN_QUIET) {
    bg = h.hover ? th.bg3 : 0;
    fg = h.hover ? th.text1 : th.text2;
  } else {
    fg = h.hover ? th.text1 : th.accentHover;
  }
  if ((bg >> 24) != 0) {
    ukDrawRound(mut ui, r, th.rMd, bg);
  }
  if ((border >> 24) != 0) {
    ukDrawStroke(mut ui, r, th.rMd, th.hairline, border);
  }
  // 中身を中央に
  const tw = ukTextW(mut ui, text, size);
  let cw = tw;
  let kw = 0;
  if (kbd.length > 0) {
    kw = aiKbdW(mut ui, th, kbd);
    cw = cw + th.s1 + 2 + kw;
  }
  if (icon) {
    cw = cw + th.iconSm + th.s1 + 2;
  }
  let x = r.x + Math.max((r.w - cw) / 2, th.s2);
  if (kind == AI_BTN_LINK) {
    x = r.x;
  }
  if (icon) {
    aiIconSparkle(mut ui, ukRect(x, r.y + (r.h - th.iconSm) / 2, th.iconSm, th.iconSm), fg);
    x = x + th.iconSm + th.s1 + 2;
  }
  ukDrawTextIn(mut ui, ukRect(x, r.y, Math.min(tw, r.x + r.w - x), r.h), text, size, fg, 0);
  x = x + tw + th.s1 + 2;
  if (kbd.length > 0) {
    const kbBorder = kind == AI_BTN_AI ? ukAlpha(th.focusOuter, 64) : th.lineControl;
    const kbBg = kind == AI_BTN_AI ? 0 : th.bg1;
    aiKbd(mut ui, th, x, r.y + (r.h - th.lhXs - 4 * th.hairline) / 2, kbd, kind == AI_BTN_AI ? fg : th.text2, kbBg, kbBorder);
  }
  aiFocusRing(mut ui, th, r, th.rMd, h);
  return h.clicked;
}

// フォーカスの輪（ui.md 19 章）: キーボードで動かしたときだけ、部品から 1px 離して内に accent 2px、その外に focusOuter 1px。
export function aiFocusRing(ui: mut UkCtx, th: AiTheme, r: UkRect, radius: i32, h: UkHit): void {
  if (!h.focused || !ui.focusVisible) {
    return;
  }
  const gap = th.hairline;
  const inner = ukShrink(r, -(gap + th.focusW));
  ukDrawStroke(mut ui, ukShrink(inner, -th.hairline), radius + gap + th.focusW + th.hairline, th.hairline, th.focusOuter);
  ukDrawStroke(mut ui, inner, radius + gap + th.focusW, th.focusW, th.accent);
}

// 紫を少し明るく（ホバー）。tokens に ai.hover が足されたらそれを使う。
function aiLift(c: u32): u32 {
  const r = Math.min((((c >> 16) & 255) as i32) + 18, 255) as u32;
  const g = Math.min((((c >> 8) & 255) as i32) + 18, 255) as u32;
  const b = Math.min(((c & 255) as i32) + 18, 255) as u32;
  return (c & 0xff000000) | (r << 16) | (g << 8) | b;
}

// チェック（AI の op を選ぶ）。Tab で選べ、Space / Enter で押せる。押されたら true。on のときは ai の地に暗い ✓。
// 外した状態の枠は line.control（bg.0〜bg.3 に 3:1 以上）、ホバーで text.2。
export function aiCheckBox(ui: mut UkCtx, th: AiTheme, label: string, r: UkRect, on: bool): bool {
  const id = ukId(ui, label);
  const h = ukBehavior(mut ui, id, r, true);
  if (on) {
    ukDrawRound(mut ui, r, th.rSm, th.ai);
    ukIcon(mut ui, ukShrink(r, Math.max(r.w / 7, 1)), UK_I_CHECK, th.textOnAi);
  } else {
    ukDrawRound(mut ui, r, th.rSm, th.bg0);
    ukDrawStroke(mut ui, r, th.rSm, th.hairline, h.hover ? th.text2 : th.lineControl);
  }
  aiFocusRing(mut ui, th, r, th.rSm, h);
  return h.clicked;
}

// 押せないチェックの枠（当てはまらなくなった op）。
export function aiCheckBoxOff(ui: mut UkCtx, th: AiTheme, r: UkRect): void {
  ukDrawStroke(mut ui, r, th.rSm, th.hairline, th.textDis);
}

// × つきの札（AI に見せる札）。× が押されたら true。
export function aiChipClosable(ui: mut UkCtx, th: AiTheme, label: string, x: i32, y: i32, h: i32, text: string, size: f32): bool {
  const padX = th.s2 - 1;
  const tw = ukTextW(mut ui, text, size);
  const xs = h - 6;
  const w = padX + tw + th.s1 + xs + th.s1;
  ukDrawRound(mut ui, ukRect(x, y, w, h), th.rSm, th.aiTint);
  aiText(mut ui, x + padX, y, h, text, size, th.ai);
  const xr = ukRect(x + padX + tw + th.s1, y + 3, xs, xs);
  const id = ukId(ui, label);
  const hit = ukBehavior(mut ui, id, xr, true);
  ukIcon(mut ui, ukShrink(xr, 2), UK_I_CLOSE, hit.hover ? th.text1 : th.ai);
  aiFocusRing(mut ui, th, xr, th.rSm, hit);
  return hit.clicked;
}

export function aiChipClosableW(ui: mut UkCtx, th: AiTheme, text: string, size: f32, h: i32): i32 {
  return th.s2 - 1 + ukTextW(mut ui, text, size) + th.s1 + (h - 6) + th.s1;
}

// 何もない所のふるまい（ホバーと押したかを知るため）。
export function aiArea(ui: mut UkCtx, label: string, r: UkRect): UkHit {
  return ukBehavior(mut ui, ukId(ui, label), r, false);
}

// Tab で選べる行やタブ。keys が false なら、フォーカス中の Enter / Space を取らない（キーを自分で扱う行）。
export function aiAreaF(ui: mut UkCtx, label: string, r: UkRect, keys: bool): UkHit {
  return ukBehaviorEx(mut ui, ukId(ui, label), r, true, keys);
}

// 中の部品（チェック・ボタン）の後に置く行。中の部品がこのフレームの押下を取っていたら、行は押されたことにしない
// （押して離すのが同じフレームに来ると、uikit では後に置いた部品も押せてしまうため）。
export function aiAreaUnder(ui: mut UkCtx, label: string, r: UkRect, keys: bool): UkHit {
  const took = ui.activeTook;
  const f0 = ui.focus;
  let h = ukBehaviorEx(mut ui, ukId(ui, label), r, true, keys);
  if (took && h.pressed) {
    ui.focus = f0;
    h.focused = false;
    h.clicked = false;
    h.dbl = false;
    h.pressed = false;
  }
  return h;
}

// ---- キー（修飾キーを見てから取る） ----

// このフレームに押された key の番号（ui.inp.keys の何番目か。なければ -1）。取らない。
export function aiKeyFind(ui: UkCtx, key: i32): i32 {
  for (let i: usize = 0; i < ui.inp.keys.length; i++) {
    if (ui.inp.keys[i] == key) {
      return i as i32;
    }
  }
  return -1;
}

// key が修飾キー want（Shift・Ctrl・Alt・Meta のちょうどその組み合わせ）で押されていれば取って true。違えば取らない。
export function aiKeyTakeExact(ui: mut UkCtx, key: i32, want: i32): bool {
  for (let i: usize = 0; i < ui.inp.keys.length; i++) {
    if (ui.inp.keys[i] == key && (ui.inp.keyMods[i] & 15) == want) {
      ui.inp.keys[i] = 0;
      return true;
    }
  }
  return false;
}

// key を修飾キーにかかわらず捨てる（入力の欄で送らない Enter など）。
export function aiKeyDrop(ui: mut UkCtx, key: i32, want: i32): void {
  for (let i: usize = 0; i < ui.inp.keys.length; i++) {
    if (ui.inp.keys[i] == key && (ui.inp.keyMods[i] & 15) == want) {
      ui.inp.keys[i] = 0;
    }
  }
}

// 自前のスクロール: マウスが r の中ならホイールを取り、新しい位置を返す（0〜contentH - r.h）。
export function aiScroll(ui: mut UkCtx, r: UkRect, y: i32, contentH: i32, step: i32): i32 {
  let v = y;
  if (ukMouseIn(ui, r) && ui.inp.wheelFY != 0.0) {
    v = v - (Math.floor(ui.inp.wheelFY * (step as f64) + 0.5) as i32);
    ukWheelTake(mut ui);
  }
  return Math.max(Math.min(v, contentH - r.h), 0);
}

// スクロールのつまみ（中身が収まらないときだけ）。
export function aiScrollBar(ui: mut UkCtx, th: AiTheme, r: UkRect, y: i32, contentH: i32): void {
  if (contentH <= r.h || r.h <= 0) {
    return;
  }
  const w = th.s1 + 2;
  const kh = Math.max(r.h * r.h / contentH, th.s4);
  const ky = r.y + (r.h - kh) * y / Math.max(contentH - r.h, 1);
  ukDrawRound(mut ui, ukRect(r.x + r.w - w - 2, ky, w, kh), w / 2, th.bg4);
}

export function aiClipTo(a: UkRect, b: UkRect): UkRect {
  return ukIntersect(a, b);
}
