// AI に渡すツール（check・show・schema・op・preview・analyze_audio）と、system の文。
// 中身は tools/mcp-server.mjs と docs/ai.md の同じ名前のツールに合わせ、アプリの中の関数（report.um・ops.um・render.um）で
// 直接実行する（子プロセスは使わない）。違いは 2 つ:
//   - プロジェクトは、開いているもの（AgProject）だけ。project の引数はない。
//   - op の apply=true は保存せず「提案」を作る。利用者が［適用］を押したときだけ .mzc を書き換える（ai_agent.um）。
import { AzJson, azjFind, azjNum, azjStr, AZJ_OBJ, AZJ_ARR, AZJ_STR, AZJ_NUM } from "../effects/analyze/json.um";
import { Project, Probe, Diag, parseProjectReg } from "../engine/project.um";
import { jsonStr, jsonNum, diagsJson, projectJsonReg, showTextReg, schemaJsonReg } from "../engine/report.um";
import { OpResult, Change, Moved, BatchResult, splitArgs, runOpsReg } from "../engine/ops.um";
import { splitLines, appendText, fmtTime } from "../engine/text.um";
import { MediaSource, } from "../engine/media.um";
import { loadMedia, checkMedia, renderFrameReg, newRenderCache, RenderCache } from "../engine/render.um";
import { Font, projectFont } from "../effects/text/ttf.um";
import { FxReg, fxRegBuiltin } from "../gen/plugins.um";
import { trDefaults, trClip, trJson } from "../engine/transcribe.um";
import { aiCustomGuideText, aiAnalyzeAudioJson, aiListMediaJson, aiInspectMedia, aiBase64, aiPngBytes } from "../engine/aiguide.um";
import { agParse, agJsonOf, agjStrs, agjBool, agSchemaCheck, agBytes } from "./ai_json.um";
import { AgToolDef } from "./ai_provider.um";

// 開いているプロジェクト（ツールが読む所）。
export struct AgProject {
  path: string;      // .mzc のパス（ツールは毎回ここから読む）
  cache: string;     // 素材のキャッシュのフォルダ（なければ ""）
  probes: Probe[];   // 素材の情報（アプリが調べたもの。E2 なら e2ProbesWithImported）
}

// ツールを 1 回実行した結果。
export struct AgToolOut {
  text: string;        // AI に返す文（JSON か、人が読む文）
  isError: bool;
  imageType: string;   // 画像（preview）。空ならなし
  imageData: string;   // base64
  propose: bool;       // op の apply=true が通った（提案にする）
  ops: string[];       // そのときの op の文
  summary: string;     // 画面の履歴に出す 1 文（「check: 誤りなし（クリップ 3 個）」など）
}

function agOutNew(text: string, isError: bool): AgToolOut {
  return { text: text.clone(), isError, imageType: "", imageData: "", propose: false, ops: [], summary: "" };
}

export const AG_SCHEMA_SECTIONS: string = "[\"all\",\"keys\",\"effects\",\"transitions\",\"ops\",\"syntax\",\"blend\",\"expressions\",\"features\"]";
export const AG_PREVIEW_DEFAULT_WIDTH: i32 = 768;

// ---- ツールの定義（呼ぶたびに同じ文字列。キャッシュが効くように） ----

export function agToolDefs(): AgToolDef[] {
  let out: AgToolDef[] = [];
  out.push({
    name: "check",
    description: "開いているプロジェクトを調べ、誤り（diagnostics）と、配置した後の全クリップ（index・id・行番号・トラック・開始・終わり・キー・効果・キーフレーム・式・テキストアニメ・シェイプ・パーティクル・3D・描画モード・マスク）を JSON で返す。ファイルは書き換えない。ok が true なら誤り（error）はない。編集の前後に必ず呼ぶ。diagnostics[] の code・line・hint・suggest を読んで直す。",
    schema: "{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}",
  });
  out.push({
    name: "show",
    description: "タイムラインの図（トラックごとのクリップの並び）とクリップの一覧を、人が読む文で返す。全体の様子をつかむのに使う。正確な数値は check の JSON を使う。width は図の幅（文字数。40〜400、既定 100）。",
    schema: "{\"type\":\"object\",\"properties\":{\"width\":{\"type\":\"integer\",\"description\":\"図の幅（文字数。40〜400、既定 100）\"}},\"additionalProperties\":false}",
  });
  out.push({
    name: "schema",
    description: ".mzc に書けるキー・効果（独立プラグイン）・トランジション・操作（op の書き方と例）・時刻と参照・描画モード・エクスプレッション（音連動含む）・機能別早見（features）の一覧を JSON で返す。system に全体が入っているので、ふだんは呼ばなくてよい。section で一部だけを返す（keys / effects / transitions / ops / syntax / blend / expressions / features）。",
    schema: "{\"type\":\"object\",\"properties\":{\"section\":{\"type\":\"string\",\"enum\":" + AG_SCHEMA_SECTIONS + ",\"description\":\"返す部分（既定 all）\"}},\"additionalProperties\":false}",
  });
  out.push({
    name: "op",
    description: "プロジェクトに操作を試す。apply を付けない（false）と dry_run で、差分（変わる行の前と後）と、時刻が変わるほかのクリップ（moved）を返すだけ。apply=true にすると、同じ操作を利用者への「提案」にする（このツールは保存しない。利用者が［適用］を押したときだけ保存される）。手順: (1) apply なしで呼び、差分と results[].desc / moved が意図どおりか確かめる → (2) 同じ ops を apply=true で呼んで提案にする。ops は 1 要素に 1 操作。全部成功したときだけ通り、1 つでも失敗すれば何も変えない。誤りが増える操作は断られる。操作: move / trim / split / delete / cut / set / unset / renamekey / add（video/image/text/color/audio/shape/particles/spectrum/comp/mask/marker）/ rename / mix / key …（書き方と例は schema の ops と features）。クリップは ID（clip_b）、#番号、@行番号で指す。project 行の編集は set project ... を使う。",
    schema: "{\"type\":\"object\",\"properties\":{\"ops\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1,\"description\":\"操作。1 要素に 1 つ（例: \\\"move clip_b 5.5\\\"）。値に空白があれば \\\"...\\\" で囲む\"},\"apply\":{\"type\":\"boolean\",\"description\":\"true なら利用者への提案にする（保存はしない）。既定 false = dry_run\"}},\"required\":[\"ops\"],\"additionalProperties\":false}",
  });
  out.push({
    name: "preview",
    description: "タイムラインの指定の時刻（秒）の 1 コマを合成し、PNG の画像として返す。文字の大きさ・位置・重なりの順・色など、check では分からない見た目を確かめるのに使う。誤りのあるプロジェクトでは止まるので、先に check を通す。max_width は返す画像の最大の幅（画素。16〜1280、既定 768）。",
    schema: "{\"type\":\"object\",\"properties\":{\"time\":{\"type\":\"number\",\"description\":\"タイムライン上の時刻（秒。0 以上）\"},\"max_width\":{\"type\":\"integer\",\"description\":\"返す画像の最大の幅（画素。16〜1280、既定 768）\"}},\"required\":[\"time\"],\"additionalProperties\":false}",
  });
  out.push({
    name: "analyze_audio",
    description: "プロジェクト内の音声（BGM・声・動画の音）を FFT 解析し、推定 BPM・ビート時刻（beats）・盛り上がりピーク（peaks）・静かな区間（quietSections）・時刻ごとの音量/低域(bass)/中域(mid)/高域(high) 推移を JSON で返す。MV のビート合わせカット・サビ演出・音連動・マーカー打ちの前に必ず呼ぶ。step は推移の間隔（秒。既定 0.25）。",
    schema: "{\"type\":\"object\",\"properties\":{\"step\":{\"type\":\"number\",\"description\":\"エネルギー推移の間隔（秒。0.05〜10、既定 0.25）\"}},\"additionalProperties\":false}",
  });
  out.push({
    name: "transcribe",
    description: "動画・音のクリップの素材の音を whisper.cpp（手元）で書き起こし、字幕の区切り（cues: タイムラインの秒の start / end / text）・全文（text）と、字幕の text を足す操作（ops: add text ... id=sub_<n>。空いている上のトラック）を JSON で返す。プロジェクトは変えない。字幕を置くには ops を op に渡す。言葉の時刻は、話していない所を切る・発言に合わせて分けるのにも使える。素材の長さに応じて時間がかかる（CPU で実時間の数分の 1 程度）。字幕を置くときは返った ops をそのまま op に渡す（dry_run → apply=true）。",
    schema: "{\"type\":\"object\",\"properties\":{\"clip\":{\"type\":\"string\",\"description\":\"書き起こすクリップ（ID・#番号・@行番号）\"},\"lang\":{\"type\":\"string\",\"description\":\"言葉（ja / en など。既定 auto）\"}},\"required\":[\"clip\"],\"additionalProperties\":false}",
  });
  out.push({
    name: "list_media",
    description: "素材プール（未配置を含む）とプロジェクトフォルダ内の利用可能な動画・画像・音声ファイル一覧（パス・種別・長さ・解像度・fps・映像/音声の有無）を JSON で返す。返った path をそのまま add video / add image / add audio や inspect_media に渡せる。",
    schema: "{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}",
  });
  out.push({
    name: "inspect_media",
    description: "タイムラインに置く前の素材ファイルの中身を確認する。動画は等間隔の複数コマを並べたコンタクトシート PNG（または time 指定で特定時刻の 1 コマ PNG）、画像は PNG、音声のみはメタデータ JSON を返す。複数素材からベストなシーンや in=/out= 区間を選んで組み合わせるときに使う。",
    schema: "{\"type\":\"object\",\"properties\":{\"src\":{\"type\":\"string\",\"description\":\"list_media が返した素材のパス\"},\"time\":{\"type\":\"number\",\"description\":\"特定時刻の 1 コマだけ見たいときの秒数（省略すると動画はコンタクトシート）\"},\"frames\":{\"type\":\"integer\",\"description\":\"コンタクトシートのコマ数（1〜6、既定 4。time 指定時や画像は 1）\"},\"max_width\":{\"type\":\"integer\",\"description\":\"返す画像の最大幅（64〜1280、既定 768）\"}},\"required\":[\"src\"],\"additionalProperties\":false}",
  });
  return out;
}

// docs/ai.md の要点（system の頭。固定の文）。
function agGuideLines(): string[] {
  let l: string[] = [];
  l.push("あなたは動画編集ソフト MozaicCut の中で働く編集の助手です。利用者が開いているプロジェクト（.mzc）をツールで読み、操作（op）の提案を作ります。");
  l.push("利用者への返事は日本語で、短く分かりやすく書きます。");
  l.push("");
  l.push("# 決まった流れ");
  l.push("1. check で今の配置と誤りを読む（全体の様子は show）。未配置の素材やフォルダ内の素材を組み合わせたいときは list_media で一覧を取り、inspect_media で動画・画像の中身を目視して使う区間（in=/out=）や配置を決める。音声があるプロジェクトでは analyze_audio で BPM・ビート・ピーク・静かな区間を確認できる。話し声の字幕や、発言に合わせた編集には transcribe で書き起こす。書き方はこの system の後ろの schema にある。");
  l.push("2. 見た目が大事な変更（文字・位置・色・重なり・エフェクト・3D・シェイプ・パーティクル）は preview でフレームを確かめる。");
  l.push("3. op を apply なし（dry_run）で試し、results[].desc・changes・moved が意図どおりか確かめる。失敗したら results[].code / error / hint / suggest を読んで直し、試し直す。");
  l.push("4. 意図どおりなら、同じ ops を apply=true で呼んで提案にする。提案は利用者が［適用］を押すまで保存されない。apply=true の後は、提案が適用された前提でさらに編集しない（次の頼みを待つ）。");
  l.push("5. 最後に、何を提案したかを 1〜3 文でまとめる。");
  l.push("");
  l.push("# クリップの指し方と時刻");
  l.push("- クリップは ID（clip_b。いちばん安定）、#番号（#3。check の index）、@行番号（@9）で指す。project の行は set project ... で編集する。ID のないクリップは rename で ID を付けてから使うとよい。");
  l.push("- 時刻はタイムライン上の秒（5.5）か \"分:秒\"（1:02.5）。参照は clip_a.end、clip_a.start+1.5、after:clip_a。");
  l.push("- 操作は 1 要素に 1 つ。全部成功したときだけ通る（1 つでも失敗すれば何も変えない）。誤りが増える操作は断られる。");
  l.push("- キーフレームの時刻はクリップの始まりからの秒。x / y / pos は左上からの画素。");
  l.push("- 効果・トランジションはプラグインで増減するので、名前や範囲を覚え込まず、schema の effects / transitions で確かめる。");
  l.push("");
  l.push("# 守ること");
  l.push("- ファイルを直接書き換える手段はない。変更はすべて op の提案として出す。");
  l.push("- 利用者が頼んでいない大きな変更（多くのクリップを消す・全体を詰める）は、提案する前に返事で確かめる。");
  l.push("- 誤り（check の ok が false）があるプロジェクトでは、まず誤りを説明し、直す op を提案してよい。");
  return l;
}

// system の全文: 要点 →（ローカル追加指針があれば追記）→ schema（JSON）。
export function agSystemTextReg(reg: FxReg): string {
  let out: u8[] = [];
  for (const l of agGuideLines()) {
    appendText(mut out, l);
    out.push(10);
  }
  const custom = aiCustomGuideText();
  if (custom.length > 0) {
    out.push(10);
    appendText(mut out, custom);
    if (custom[custom.length - 1] != 10) {
      out.push(10);
    }
  }
  appendText(mut out, "\n# schema（.mzc に書けるキー・効果・トランジション・操作・エクスプレッション・機能別早見。schema --json と同じ）\n");
  appendText(mut out, schemaJsonReg(reg));
  out.push(10);
  return stringFromBytes(out);
}

export function agSystemText(): string {
  return agSystemTextReg(fxRegBuiltin());
}

// ---- 実行 ----

function agReadProject(proj: AgProject, ok: mut bool): u8[] {
  const b = readFile(proj.path);
  if (b == null) {
    ok = false;
    let e: u8[] = [];
    return e;
  }
  ok = true;
  return b.clone();
}

function agErrorCount(diags: Diag[]): i32 {
  let n = 0;
  for (const d of diags) {
    if (d.severity == "error") {
      n++;
    }
  }
  return n;
}

function agChangesJson(chs: Change[]): string {
  let s = "[";
  for (let i: usize = 0; i < chs.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + `{"kind":${jsonStr(chs[i].kind)},"line":${chs[i].line},"before":${jsonStr(chs[i].before)},"after":${jsonStr(chs[i].after)}}`;
  }
  return s + "]";
}

function agMovedJson(ms: Moved[]): string {
  let s = "[";
  for (let i: usize = 0; i < ms.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    let id = "null";
    if (ms[i].id != "") {
      id = jsonStr(ms[i].id);
    }
    s = s + `{"id":${id},"line":${ms[i].line},"before":{"start":${jsonNum(ms[i].beforeStart)},"end":${jsonNum(ms[i].beforeEnd)}},"after":{"start":${jsonNum(ms[i].afterStart)},"end":${jsonNum(ms[i].afterEnd)}}}`;
  }
  return s + "]";
}

function agResultJson(r: OpResult): string {
  return `{"op":${jsonStr(r.op)},"ok":${r.ok},"code":${jsonStr(r.code)},"desc":${jsonStr(r.desc)},"error":${jsonStr(r.error)},"hint":${jsonStr(r.hint)},"suggest":${jsonStr(r.suggest)},"newId":${jsonStr(r.newId)},"changes":${agChangesJson(r.changes)},"moved":${agMovedJson(r.moved)},"newDiagnostics":${diagsJson(r.newDiagnostics)}}`;
}

// op の結果の JSON（mozcut op --json と同じ形。saved はいつも false）。
export function agBatchJson(b: BatchResult): string {
  let s = `{"ok":${b.ok},"saved":false,"results":[`;
  for (let i: usize = 0; i < b.results.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + agResultJson(b.results[i]);
  }
  return s + `],"diagnostics":${diagsJson(b.diags)}}`;
}

function agToolCheck(proj: AgProject, reg: FxReg): AgToolOut {
  let ok = true;
  const text = agReadProject(proj, mut ok);
  if (!ok) {
    return agOutNew(`プロジェクト（${proj.path}）を読めません`, true);
  }
  let diags: Diag[] = [];
  const p = parseProjectReg(text, proj.probes, mut diags, reg);
  let out = agOutNew(projectJsonReg(p, diags, reg), false);
  const ne = agErrorCount(diags);
  if (ne == 0) {
    out.summary = `check: 誤りなし（クリップ ${p.clips.length} 個）`;
  } else {
    out.summary = `check: 誤り ${ne} 個`;
  }
  return out;
}

function agToolShow(proj: AgProject, input: AzJson, reg: FxReg): AgToolOut {
  let ok = true;
  const text = agReadProject(proj, mut ok);
  if (!ok) {
    return agOutNew(`プロジェクト（${proj.path}）を読めません`, true);
  }
  let width = azjNum(input, "width", 100.0) as i32;
  if (width < 40 || width > 400) {
    return agOutNew("width は 40〜400 です", true);
  }
  let diags: Diag[] = [];
  const p = parseProjectReg(text, proj.probes, mut diags, reg);
  let out = agOutNew(showTextReg(p, width, reg), false);
  out.summary = "show: タイムラインの図";
  return out;
}

function agToolSchema(input: AzJson, reg: FxReg): AgToolOut {
  let section = azjStr(input, "section");
  if (section == "") {
    section = "all";
  }
  const all = schemaJsonReg(reg);
  if (section == "all") {
    let out = agOutNew(all, false);
    out.summary = "schema: 全体";
    return out;
  }
  const d = agParse(all);
  if (!d.ok) {
    return agOutNew("schema を読めませんでした", true);
  }
  const i = azjFind(d.root, section);
  if (i < 0) {
    return agOutNew(`schema に ${section} はありません`, true);
  }
  let out = agOutNew(`{${jsonStr(section)}:${agJsonOf(d.root.items[i as usize])}}`, false);
  out.summary = `schema: ${section}`;
  return out;
}

// op の文の列を試す（dry_run）。
export function agDryRunReg(proj: AgProject, ops: string[], ok: mut bool, reg: FxReg): BatchResult {
  let readOk = true;
  const text = agReadProject(proj, mut readOk);
  let args: string[][] = [];
  for (const o of ops) {
    args.push(splitArgs(o));
  }
  let lines: string[] = [];
  if (readOk) {
    lines = splitLines(text);
  }
  ok = readOk;
  return runOpsReg(lines, proj.probes, args, reg);
}

export function agDryRun(proj: AgProject, ops: string[], ok: mut bool): BatchResult {
  return agDryRunReg(proj, ops, mut ok, fxRegBuiltin());
}

function agToolOp(proj: AgProject, input: AzJson, reg: FxReg): AgToolOut {
  let ops: string[] = [];
  for (const o of agjStrs(input, "ops")) {
    // 1 つの要素に改行で複数を書いたものも受け付ける
    for (const l of splitLines(agBytes(o))) {
      const w = splitArgs(l);
      if (w.length == 0 || (w[0].length > 0 && w[0][0] == 35)) {
        continue;
      }
      ops.push(l.clone());
    }
  }
  if (ops.length == 0) {
    return agOutNew("ops に操作を渡してください（例: \"move clip_b 5.5\"）。書き方は schema の ops", true);
  }
  const apply = agjBool(input, "apply", false);
  let readOk = true;
  const br = agDryRunReg(proj, ops, mut readOk, reg);
  if (!readOk) {
    return agOutNew(`プロジェクト（${proj.path}）を読めません`, true);
  }
  let head = "";
  if (!br.ok) {
    head = "失敗しました。何も変えていません。results[].code / error / hint / suggest を読んで直してください。\n";
  } else if (apply) {
    head = "利用者への提案にしました（まだ保存していません。利用者が［適用］を押すと保存されます）。\n";
  } else {
    head = "試しただけです（dry_run）。意図どおりなら、同じ ops を apply=true で呼んで提案にしてください。\n";
  }
  let out = agOutNew(head + agBatchJson(br), !br.ok);
  if (br.ok && apply) {
    out.propose = true;
    for (const o of ops) {
      out.ops.push(o.clone());
    }
    out.summary = `op: ${ops.length} 個の操作を提案`;
  } else if (br.ok) {
    out.summary = `op（試し）: ${ops.length} 個の操作`;
  } else {
    out.summary = "op: 失敗（何も変えていません）";
  }
  return out;
}

// ---- preview ----

export function agBase64(data: u8[]): string {
  return aiBase64(data);
}

export function agPngBytes(canvas: Buffer<vec4<f32>>, w: i32, h: i32, ow: i32, oh: i32): u8[] {
  return aiPngBytes(canvas, w, h, ow, oh);
}

function agToolPreview(proj: AgProject, input: AzJson, reg: FxReg): AgToolOut {
  const t = azjNum(input, "time", -1.0);
  if (!(t >= 0.0) || t > 10000000.0) {
    return agOutNew("time は 0 以上の秒です", true);
  }
  const mw = azjNum(input, "max_width", AG_PREVIEW_DEFAULT_WIDTH as f64) as i32;
  if (mw < 16 || mw > 1280) {
    return agOutNew("max_width は 16〜1280 です", true);
  }
  let ok = true;
  const text = agReadProject(proj, mut ok);
  if (!ok) {
    return agOutNew(`プロジェクト（${proj.path}）を読めません`, true);
  }
  let diags: Diag[] = [];
  const p = parseProjectReg(text, proj.probes, mut diags, reg);
  if (agErrorCount(diags) > 0) {
    return agOutNew("誤りのあるプロジェクトなので絵を作れません。先に check で誤りを確かめてください\n" + diagsJson(diags), true);
  }
  const media = loadMedia(p, proj.cache);
  const missing = checkMedia(p, media, proj.cache, t, t);
  if (missing.length > 0) {
    let msg = "素材を読めないので絵を作れません:";
    for (const m of missing) {
      msg = msg + "\n- " + m;
    }
    return agOutNew(msg, true);
  }
  const font = projectFont(p.fontPath, p.fontIndex);
  let canvas = new Buffer<vec4<f32>>((p.width * p.height) as u32);
  let rc = newRenderCache();
  renderFrameReg(p, media, proj.cache, t, mut canvas, font, mut rc, reg);
  let ow = p.width;
  let oh = p.height;
  if (ow > mw) {
    oh = Math.max((p.height * mw) / p.width, 1);
    ow = mw;
  }
  const png = agPngBytes(canvas, p.width, p.height, ow, oh);
  let note = "";
  if (t >= p.duration) {
    note = "（全体の長さより後ろなので、背景だけの絵です）";
  }
  let out = agOutNew(`{"time":${jsonNum(t)},"width":${ow},"height":${oh},"projectWidth":${p.width},"projectHeight":${p.height},"beyondEnd":${t >= p.duration}}${note}`, false);
  out.imageType = "image/png";
  out.imageData = agBase64(png);
  out.summary = `preview: ${fmtTime(t)} の絵（${ow}×${oh}）`;
  return out;
}

function agToolAnalyzeAudio(proj: AgProject, input: AzJson, reg: FxReg): AgToolOut {
  const step = azjNum(input, "step", 0.25);
  if (!(step >= 0.05) || step > 10.0) {
    return agOutNew("step は 0.05〜10 の秒です", true);
  }
  let ok = true;
  const text = agReadProject(proj, mut ok);
  if (!ok) {
    return agOutNew(`プロジェクト（${proj.path}）を読めません`, true);
  }
  let diags: Diag[] = [];
  const p = parseProjectReg(text, proj.probes, mut diags, reg);
  if (agErrorCount(diags) > 0) {
    return agOutNew("誤りのあるプロジェクトなので音声解析できません。先に check で誤りを確かめてください\n" + diagsJson(diags), true);
  }
  const res = aiAnalyzeAudioJson(p, proj.cache, step);
  let out = agOutNew(res, false);
  out.summary = "analyze_audio: 音声・ビート解析";
  return out;
}

function agToolTranscribe(proj: AgProject, input: AzJson, reg: FxReg): AgToolOut {
  let ok = true;
  const text = agReadProject(proj, mut ok);
  if (!ok) {
    return agOutNew(`プロジェクト（${proj.path}）を読めません`, true);
  }
  let diags: Diag[] = [];
  const p = parseProjectReg(text, proj.probes, mut diags, reg);
  if (agErrorCount(diags) > 0) {
    return agOutNew("誤りのあるプロジェクトなので書き起こせません。先に check で誤りを確かめてください\n" + diagsJson(diags), true);
  }
  let o = trDefaults();
  const lang = azjStr(input, "lang");
  if (lang != "") {
    o.lang = lang;
  }
  const clip = azjStr(input, "clip");
  const r = trClip(p, proj.path, clip, o);
  let out = agOutNew(trJson(r), !r.ok);
  out.summary = `transcribe: ${clip} を書き起こし（字幕 ${r.cues.length} 個）`;
  return out;
}

function agToolListMedia(proj: AgProject): AgToolOut {
  const res = aiListMediaJson(proj.path, proj.probes);
  let out = agOutNew(res, false);
  out.summary = "list_media: 素材一覧";
  return out;
}

function agToolInspectMedia(proj: AgProject, input: AzJson): AgToolOut {
  const src = azjStr(input, "src");
  const reqT = azjNum(input, "time", -1.0);
  const reqF = azjNum(input, "frames", 0.0) as i32;
  const maxW = azjNum(input, "max_width", AG_PREVIEW_DEFAULT_WIDTH as f64) as i32;
  const r = aiInspectMedia(proj.path, proj.probes, src, reqT, reqF, maxW);
  let out = agOutNew(r.text, !r.ok);
  if (r.ok && r.pngB64.length > 0) {
    out.imageType = "image/png";
    out.imageData = r.pngB64.clone();
  }
  out.summary = r.summary.clone();
  return out;
}

// ツールを実行する。input はツールの入力の JSON（文字列）。入力がスキーマに合わなければ実行せずに誤りを返す。
export function agRunToolReg(proj: AgProject, defs: AgToolDef[], name: string, input: string, reg: FxReg): AgToolOut {
  let schema = "";
  for (const d of defs) {
    if (d.name == name) {
      schema = d.schema.clone();
    }
  }
  if (schema == "") {
    return agOutNew(`知らないツールです: ${name}`, true);
  }
  const d = agParse(input);
  if (!d.ok) {
    return agOutNew(`ツールの入力が JSON として読めません（途中で切れた可能性があります）: ${d.error}`, true);
  }
  const sd = agParse(schema);
  const e = agSchemaCheck(sd.root, d.root, "input");
  if (e != "") {
    return agOutNew(`ツールの入力がスキーマに合いません: ${e}`, true);
  }
  if (name == "check") {
    return agToolCheck(proj, reg);
  }
  if (name == "show") {
    return agToolShow(proj, d.root, reg);
  }
  if (name == "schema") {
    return agToolSchema(d.root, reg);
  }
  if (name == "op") {
    return agToolOp(proj, d.root, reg);
  }
  if (name == "analyze_audio") {
    return agToolAnalyzeAudio(proj, d.root, reg);
  }
  if (name == "transcribe") {
    return agToolTranscribe(proj, d.root, reg);
  }
  if (name == "list_media") {
    return agToolListMedia(proj);
  }
  if (name == "inspect_media") {
    return agToolInspectMedia(proj, d.root);
  }
  return agToolPreview(proj, d.root, reg);
}

export function agRunTool(proj: AgProject, defs: AgToolDef[], name: string, input: string): AgToolOut {
  return agRunToolReg(proj, defs, name, input, fxRegBuiltin());
}
