// AI の層の JSON の道具: 文字列から読む、木（AzJson）を JSON の文字列に戻す、値を取り出す、
// ツールの入力がスキーマ（JSON Schema の小さな部分集合）に合うかを確かめる。
// 読み取りは src/effects/analyze/json.um の azJsonParse を使う（同じ木の形）。
//
// 名前の空間は全ファイルで 1 つなので、src/ai/ の名前はすべて ag / Ag / AG_ で始める（ui_ai の ai* とぶつけない）。
import { AzJson, AzJsonDoc, azJsonParse, azjNull, azjFind, AZJ_NULL, AZJ_BOOL, AZJ_NUM, AZJ_STR, AZJ_ARR, AZJ_OBJ } from "../effects/analyze/json.um";
import { jsonStr } from "../engine/report.um";
import { appendText } from "../engine/text.um";

// 文字列のバイト列。
export function agBytes(s: string): u8[] {
  let out: u8[] = [];
  for (const b of s) {
    out.push(b);
  }
  return out;
}

// 文字列の JSON を読む。
export function agParse(s: string): AzJsonDoc {
  return azJsonParse(agBytes(s));
}

// ---- 木を作る ----

export function agjStrV(s: string): AzJson {
  return { kind: AZJ_STR, b: false, num: 0.0, str: s.clone(), keys: [], items: [] };
}

export function agjNumV(v: f64): AzJson {
  return { kind: AZJ_NUM, b: false, num: v, str: "", keys: [], items: [] };
}

export function agjBoolV(b: bool): AzJson {
  return { kind: AZJ_BOOL, b, num: 0.0, str: "", keys: [], items: [] };
}

export function agjObjV(): AzJson {
  return { kind: AZJ_OBJ, b: false, num: 0.0, str: "", keys: [], items: [] };
}

export function agjArrV(): AzJson {
  return { kind: AZJ_ARR, b: false, num: 0.0, str: "", keys: [], items: [] };
}

// 木の写し（AzJson は自分の配列を持つので clone() が使えない）。
export function agjCopy(v: AzJson): AzJson {
  let out: AzJson = { kind: v.kind, b: v.b, num: v.num, str: v.str.clone(), keys: [], items: [] };
  for (const k of v.keys) {
    out.keys.push(k.clone());
  }
  for (const it of v.items) {
    out.items.push(agjCopy(it));
  }
  return out;
}

// ---- 書く ----

export function agJsonOf(v: AzJson): string {
  let out: u8[] = [];
  agJsonTo(mut out, v);
  return stringFromBytes(out);
}

function agNumIsFinite(v: f64): bool {
  return v == v && v - v == 0.0;
}

export function agJsonTo(out: mut u8[], v: AzJson): void {
  if (v.kind == AZJ_NULL) {
    appendText(mut out, "null");
  } else if (v.kind == AZJ_BOOL) {
    if (v.b) {
      appendText(mut out, "true");
    } else {
      appendText(mut out, "false");
    }
  } else if (v.kind == AZJ_NUM) {
    if (agNumIsFinite(v.num)) {
      appendText(mut out, `${v.num}`);
    } else {
      appendText(mut out, "null");
    }
  } else if (v.kind == AZJ_STR) {
    appendText(mut out, jsonStr(v.str));
  } else if (v.kind == AZJ_ARR) {
    out.push(91);
    for (let i: usize = 0; i < v.items.length; i++) {
      if (i > 0) {
        out.push(44);
      }
      agJsonTo(mut out, v.items[i]);
    }
    out.push(93);
  } else {
    out.push(123);
    for (let i: usize = 0; i < v.items.length; i++) {
      if (i > 0) {
        out.push(44);
      }
      appendText(mut out, jsonStr(v.keys[i]));
      out.push(58);
      agJsonTo(mut out, v.items[i]);
    }
    out.push(125);
  }
}

// 文字列の配列を JSON の配列にする。
export function agJsonStrs(list: string[]): string {
  let out: u8[] = [];
  out.push(91);
  for (let i: usize = 0; i < list.length; i++) {
    if (i > 0) {
      out.push(44);
    }
    appendText(mut out, jsonStr(list[i]));
  }
  out.push(93);
  return stringFromBytes(out);
}

// ---- 取り出す ----

// キーの値の種類（なければ -1）。
export function agjKind(v: AzJson, key: string): i32 {
  const i = azjFind(v, key);
  if (i < 0) {
    return -1;
  }
  return v.items[i as usize].kind;
}

// キーの値の写し（なければ null の値）。
export function agjGet(v: AzJson, key: string): AzJson {
  const i = azjFind(v, key);
  if (i < 0) {
    return azjNull();
  }
  return agjCopy(v.items[i as usize]);
}

// キーの値の bool（なければ def）。
export function agjBool(v: AzJson, key: string, def: bool): bool {
  const i = azjFind(v, key);
  if (i < 0 || v.items[i as usize].kind != AZJ_BOOL) {
    return def;
  }
  return v.items[i as usize].b;
}

// キーの値を JSON の文字列で（なければ ""）。
export function agjRaw(v: AzJson, key: string): string {
  const i = azjFind(v, key);
  if (i < 0) {
    return "";
  }
  return agJsonOf(v.items[i as usize]);
}

// キーの値が文字列の配列なら、その写し（ほかは空）。
export function agjStrs(v: AzJson, key: string): string[] {
  let out: string[] = [];
  const i = azjFind(v, key);
  if (i < 0 || v.items[i as usize].kind != AZJ_ARR) {
    return out;
  }
  for (const it of v.items[i as usize].items) {
    if (it.kind == AZJ_STR) {
      out.push(it.str.clone());
    }
  }
  return out;
}

// オブジェクトにキーと値を足す（同じキーがあれば置き換える）。
export function agjPut(o: mut AzJson, key: string, val: own AzJson): void {
  const i = azjFind(o, key);
  if (i >= 0) {
    o.items[i as usize] = val;
    return;
  }
  o.keys.push(key.clone());
  o.items.push(val);
}

// ---- スキーマ ----

function agKindName(k: i32): string {
  if (k == AZJ_NULL) {
    return "null";
  }
  if (k == AZJ_BOOL) {
    return "真偽値";
  }
  if (k == AZJ_NUM) {
    return "数";
  }
  if (k == AZJ_STR) {
    return "文字列";
  }
  if (k == AZJ_ARR) {
    return "配列";
  }
  return "オブジェクト";
}

function agTypeOk(t: string, v: AzJson): bool {
  if (t == "object") {
    return v.kind == AZJ_OBJ;
  }
  if (t == "array") {
    return v.kind == AZJ_ARR;
  }
  if (t == "string") {
    return v.kind == AZJ_STR;
  }
  if (t == "number") {
    return v.kind == AZJ_NUM;
  }
  if (t == "integer") {
    return v.kind == AZJ_NUM && v.num == Math.floor(v.num);
  }
  if (t == "boolean") {
    return v.kind == AZJ_BOOL;
  }
  if (t == "null") {
    return v.kind == AZJ_NULL;
  }
  return true;
}

// v がスキーマに合うか。合えば ""、合わなければ日本語の 1 文（where はその場所。"input.ops[1]" など）。
// 扱うのは type・properties・required・additionalProperties（false）・items・minItems・maxItems・enum・minimum・maximum・anyOf。
export function agSchemaCheck(schema: AzJson, v: AzJson, where: string): string {
  if (schema.kind != AZJ_OBJ) {
    return "";
  }
  // anyOf: どれか 1 つに合えばよい
  const ai = azjFind(schema, "anyOf");
  if (ai >= 0 && schema.items[ai as usize].kind == AZJ_ARR) {
    let first = "";
    for (const s of schema.items[ai as usize].items) {
      const e = agSchemaCheck(s, v, where);
      if (e == "") {
        return "";
      }
      if (first == "") {
        first = e;
      }
    }
    return first;
  }
  const ti = azjFind(schema, "type");
  if (ti >= 0 && schema.items[ti as usize].kind == AZJ_STR) {
    const t = schema.items[ti as usize].str.clone();
    if (!agTypeOk(t, v)) {
      return `${where} は ${t} の型でなければなりません（${agKindName(v.kind)} でした）`;
    }
  }
  const ei = azjFind(schema, "enum");
  if (ei >= 0 && schema.items[ei as usize].kind == AZJ_ARR) {
    let hit = false;
    let names = "";
    for (const c of schema.items[ei as usize].items) {
      if (names.length > 0) {
        names = names + " / ";
      }
      names = names + agJsonOf(c);
      if (c.kind == v.kind && c.kind == AZJ_STR && c.str == v.str) {
        hit = true;
      }
      if (c.kind == v.kind && c.kind == AZJ_NUM && c.num == v.num) {
        hit = true;
      }
    }
    if (!hit) {
      return `${where} は ${names} のどれかです`;
    }
  }
  if (v.kind == AZJ_NUM) {
    const mn = azjFind(schema, "minimum");
    if (mn >= 0 && schema.items[mn as usize].kind == AZJ_NUM && v.num < schema.items[mn as usize].num) {
      return `${where} は ${schema.items[mn as usize].num} 以上です`;
    }
    const mx = azjFind(schema, "maximum");
    if (mx >= 0 && schema.items[mx as usize].kind == AZJ_NUM && v.num > schema.items[mx as usize].num) {
      return `${where} は ${schema.items[mx as usize].num} 以下です`;
    }
  }
  if (v.kind == AZJ_ARR) {
    const mi = azjFind(schema, "minItems");
    if (mi >= 0 && schema.items[mi as usize].kind == AZJ_NUM && (v.items.length as f64) < schema.items[mi as usize].num) {
      return `${where} の要素は ${schema.items[mi as usize].num} 個以上です`;
    }
    const xi = azjFind(schema, "maxItems");
    if (xi >= 0 && schema.items[xi as usize].kind == AZJ_NUM && (v.items.length as f64) > schema.items[xi as usize].num) {
      return `${where} の要素は ${schema.items[xi as usize].num} 個までです`;
    }
    const ii = azjFind(schema, "items");
    if (ii >= 0) {
      for (let k: usize = 0; k < v.items.length; k++) {
        const e = agSchemaCheck(schema.items[ii as usize], v.items[k], `${where}[${k}]`);
        if (e != "") {
          return e;
        }
      }
    }
  }
  if (v.kind == AZJ_OBJ) {
    const pi = azjFind(schema, "properties");
    const ri = azjFind(schema, "required");
    if (ri >= 0 && schema.items[ri as usize].kind == AZJ_ARR) {
      for (const r of schema.items[ri as usize].items) {
        if (r.kind == AZJ_STR && azjFind(v, r.str) < 0) {
          return `${where} に ${r.str} がありません`;
        }
      }
    }
    let closed = false;
    const xi = azjFind(schema, "additionalProperties");
    if (xi >= 0 && schema.items[xi as usize].kind == AZJ_BOOL && !schema.items[xi as usize].b) {
      closed = true;
    }
    for (let k: usize = 0; k < v.keys.length; k++) {
      let sub = -1;
      if (pi >= 0) {
        sub = azjFind(schema.items[pi as usize], v.keys[k]);
      }
      if (sub < 0) {
        if (closed) {
          return `${where} に知らないキー ${v.keys[k]} があります`;
        }
        continue;
      }
      const e = agSchemaCheck(schema.items[pi as usize].items[sub as usize], v.items[k], `${where}.${v.keys[k]}`);
      if (e != "") {
        return e;
      }
    }
  }
  return "";
}
