// AI の提案・履歴・問題のパネル（ui_ai）のデータ。描くもの（ai_panel.um）とは分ける。
// 提案は ops.um の操作の列（dry-run 済みの BatchResult）から作り、履歴は .mzc.history の 1 行（JSON Lines）と行き来する。
// どの項目も「日本語の 1 文」と「op の文 / JSON」の 2 つの形を持つ（ui.md 1 章の 8、15.4）。
import { BatchResult, OpResult, Change, splitArgs } from "../ops.um";
import { Diag } from "../project.um";
import {
  AI_T_RIPPLE, AI_T_NO_MOVE, aiTxtRippleChip, aiTxtRippleTag, aiTxtOffTag, aiTxtSpots, aiTxtHistAi, aiTxtStatusReview,
  aiTxtStatusPending, AI_T_OFFLINE_SHORT,
} from "./ai_text.um";

// ---- 書き手 ----
export const AI_WHO_HUMAN: i32 = 0;
export const AI_WHO_AI: i32 = 1;
export const AI_WHO_TEXT: i32 = 2;

// ---- 札（チップ）の種類 ----
export const AI_CHIP_PLAIN: i32 = 0;
export const AI_CHIP_RIPPLE: i32 = 1;   // 詰める（黄）
export const AI_CHIP_OK: i32 = 2;       // 良い知らせ（緑）
export const AI_CHIP_WARN: i32 = 3;     // 警告（黄）
export const AI_CHIP_ERR: i32 = 4;      // 誤り（赤）
export const AI_CHIP_AI: i32 = 5;       // AI（紫）
export const AI_CHIP_MONO: i32 = 6;     // ID・タイムコード（等幅、無彩色）

export struct AiChip {
  kind: i32;
  text: string;
}

// ---- 差分の 1 行（変わったトークンだけ色を付ける） ----
export const AI_TOK_PLAIN: i32 = 0;
export const AI_TOK_KEY: i32 = 1;       // キーの名前（id= など）
export const AI_TOK_DEL: i32 = 2;
export const AI_TOK_ADD: i32 = 3;
export const AI_TOK_NOTE: i32 = 4;      // 「23 行目」などの補足

export struct AiTok {
  kind: i32;
  text: string;
}

export struct AiDiffLine {
  toks: AiTok[];
}

// ---- 提案のプレビュー（タイムラインに重ねる） ----
export const AI_PV_NONE: i32 = 0;
export const AI_PV_CUT: i32 = 1;        // 切る範囲（紫の斜線と「−0.80」の札）
export const AI_PV_SET: i32 = 2;        // 値が変わるクリップ（紫の点線の影と札）
export const AI_PV_OFF: i32 = 3;        // 人が外した op の範囲（灰色の点線と「外した」）
export const AI_PV_RIPPLE: i32 = 4;     // 後ろが詰まる範囲（黄の線と札）
export const AI_PV_OK: i32 = 5;         // 良い知らせの札だけ（緑。「✓ サビと 0 コマ差」）

// 1 つの op。
export struct AiOp {
  op: string;          // op の文（"cut 24.200000 25.000000"）
  tc: string;          // 1 文の頭のタイムコード（"00:00:24:06"。空なら出さない）
  desc: string;        // 日本語の 1 文（tc の後に続く）
  note: string;        // op の文の後ろの補足（「（1 を適用した後の時刻）」）
  chips: AiChip[];     // 影響の札
  diff: AiDiffLine[];  // .mzc の差分（フォーカスしたときに出す）
  json: string;        // JSON の形（［JSON で見る］）
  on: bool;            // 選ばれている
  byHuman: bool;       // 人が外した（on=false のとき「あなたが外しました」）
  stale: string;       // 当てはまらなくなった理由（空でなければ灰色にして理由を書く）
  bad: bool;           // 適用すると誤りが増える原因（赤）
  // プレビュー
  pv: i32;             // AI_PV_*
  t0: f64;             // 秒（タイムラインの時刻）
  t1: f64;
  track: i32;          // 0 から（-1 は全トラック）
  clipId: string;
  tag: string;         // 札の文字（"−0.80"、"in 0:00.0 → 0:12.4"）
  okTag: string;       // 良い知らせの札（タイムラインに緑で。空なら出さない）
  okTagT: f64;         // その札の時刻（秒）
  rippleN: i32;        // 後ろで動くクリップの数（詰める op）
  rippleSec: f64;      // 後ろが動く秒（詰めるなら負）
  // 選び直したときに上の 3 つの数をその場で作り直すための値（ops.um の結果から）
  movedIds: string[];  // この op で時刻が変わるクリップの ID
  lenSec: f64;         // 全体の長さの変化（秒）
  errN: i32;           // この op で増える誤りの数
  // 折り返しの覚え（幅・大きさが変わったときだけ測り直す）
  wrapW: i32;
  wrapSize: f32;
  descLines: string[];
}

export const AI_PROP_NEW: i32 = 0;       // 届いた（カード）
export const AI_PROP_REVIEW: i32 = 1;    // 確かめている
export const AI_PROP_APPLIED: i32 = 2;
export const AI_PROP_REJECTED: i32 = 3;

// AI の提案（dry-run 済みの op のまとまり）。
export struct AiProposal {
  id: string;          // 提案の ID（"p_0007"）
  state: i32;          // AI_PROP_*
  request: string;     // 人の頼み
  context: AiChip[];   // そのとき見せた文脈の札
  contextMore: i32;    // 札に出しきれない数（「＋2」）
  reply: string;       // AI の返事
  summary: string;     // カードの 1 文の要約
  errDelta: i32;       // 増える誤り
  moved: i32;          // 動くクリップ
  lengthDelta: f64;    // 全体の長さの変化（秒）
  recomputed: string;  // 計算し直したときの札（「計算し直しました（動くクリップ 11 → 12）」）
  ops: AiOp[];
  dirty: bool;         // 選び直した後、アプリがまだ dry-run し直していない（aiRecheckWanted）
  rejectedFromReview: bool;  // 確かめる欄で却下した（［元に戻す］で確かめる欄に戻す）
}

// 履歴の 1 行（.mzc.history の 1 行）。
export struct AiHist {
  t: string;           // ISO 8601（"2026-11-21T14:32:05+09:00"）
  who: i32;            // AI_WHO_*
  ops: string[];       // op の文
  desc: string;        // 日本語の 1 文
  changes: AiDiffLine[];
  applied: bool;       // AI の提案を人が適用した（「· あなたが適用」）
  open: bool;          // 中の op を開いている（AI の提案のとき）
  // 折り返しの覚え
  wrapW: i32;
  wrapSize: f32;
  descLines: string[];
}

// 問題（診断）の 1 件。
export struct AiDiagItem {
  severity: string;    // "error" / "warning"
  code: string;        // 原因コード
  msg: string;         // 日本語の理由
  hint: string;        // ヒント（直し方）
  file: string;        // "本編_v3.mzc"
  line: i32;
  col: i32;
  suggest: string;     // 推した候補（あれば［'x' に直す］）
  fixOp: string;       // 直す op の文（suggest から作る。空なら直すボタンを出さない）
}

// パネルが出す出来事。アプリは毎フレーム受け取り、ops.um・履歴・タイムラインにつなぐ。
export const AI_EV_NONE: i32 = 0;
export const AI_EV_REVIEW: i32 = 1;        // 提案を確かめる（prop）
export const AI_EV_APPLY: i32 = 2;         // 選んだ op を適用（prop。ops は aiSelectedOps）
export const AI_EV_REJECT: i32 = 3;        // 却下（prop）
export const AI_EV_TOGGLE_OP: i32 = 4;     // op を選ぶ・外す（prop, index）
export const AI_EV_FOCUS_OP: i32 = 5;      // op にフォーカス（prop, index）。タイムラインでその範囲へ
export const AI_EV_FOLLOWUP: i32 = 6;      // 直してほしい点を送る（prop, text）
export const AI_EV_ASK: i32 = 7;           // 新しく頼む（text）
export const AI_EV_JSON: i32 = 8;          // JSON で見る ／ 文で見る の切り替え（prop）
export const AI_EV_COMPARE: i32 = 9;       // モニターの「今 ／ 左右 ／ 提案の後」を次へ（Alt+C）
export const AI_EV_UNDO: i32 = 10;         // 取り消す
export const AI_EV_REDO: i32 = 11;         // やり直す
export const AI_EV_UNDO_TO: i32 = 12;      // ここまで戻す（index: その行の後まで戻す）
export const AI_EV_HIST_DIFF: i32 = 13;    // 差分を開く・閉じる（index）
export const AI_EV_HOVER_HIST: i32 = 14;   // 履歴の行にホバー（index。タイムラインで変わったクリップを光らせる）
export const AI_EV_JUMP: i32 = 15;         // 問題の場所へ（index。ソースの欄のその行・列へ）
export const AI_EV_FIX: i32 = 16;          // 問題を直す（index, text は op の文。履歴に「人」として積む）
export const AI_EV_HOVER_CLIP: i32 = 17;   // AI の返事の中の ID の札にホバー（text はクリップの ID）
export const AI_EV_SHARE_REMOVE: i32 = 18; // AI に見せる札を外す（index）
export const AI_EV_SHARE_ADD: i32 = 19;    // AI に見せる札を足す
export const AI_EV_CONNECT: i32 = 20;      // つなぎ方を見る
export const AI_EV_UNREJECT: i32 = 21;     // 却下を元に戻す（prop。通知の［元に戻す］）
export const AI_EV_REDO_TO: i32 = 22;      // ここまでやり直す（index: その行まで適用し直す。histPos = index + 1）
export const AI_EV_SELECT_DIAG: i32 = 23;  // 問題の行を選ぶ（index）
export const AI_EV_SHARE_TOGGLE: i32 = 24; // AI に見せるの切り替え（Ctrl+Shift+J。ai.share）
export const AI_EV_FOCUS_ASK: i32 = 25;    // 頼む欄へ（Ctrl+J。ai.focus。アプリは AI のタブを開く）

export struct AiEvent {
  kind: i32;
  prop: i32;
  index: i32;
  text: string;
}

export function aiEv(kind: i32, prop: i32, index: i32, text: string): AiEvent {
  return { kind, prop, index, text: text.clone() };
}

// ---- 作る ----

export function aiBoolText(b: bool): string {
  if (b) {
    return "true";
  }
  return "false";
}

// 文字列の配列の写し。
export function aiStrs(list: string[]): string[] {
  let out: string[] = [];
  for (const s of list) {
    out.push(s.clone());
  }
  return out;
}

export function aiChip(kind: i32, text: string): AiChip {
  return { kind, text: text.clone() };
}

export function aiOpNew(op: string, desc: string): AiOp {
  return {
    op: op.clone(), tc: "", desc: desc.clone(), note: "", chips: [], diff: [], json: "", on: true, byHuman: false, stale: "",
    bad: false, pv: AI_PV_NONE, t0: 0.0, t1: 0.0, track: -1, clipId: "", tag: "", okTag: "", okTagT: 0.0, rippleN: 0,
    rippleSec: 0.0, movedIds: [], lenSec: 0.0, errN: 0, wrapW: -1, wrapSize: 0.0, descLines: [],
  };
}

export function aiProposalNew(id: string, request: string, reply: string): AiProposal {
  return {
    id: id.clone(), state: AI_PROP_NEW, request: request.clone(), context: [], contextMore: 0, reply: reply.clone(),
    summary: reply.clone(), errDelta: 0, moved: 0, lengthDelta: 0.0, recomputed: "", ops: [], dirty: false,
    rejectedFromReview: false,
  };
}

// 履歴の 1 行を作る（折り返しの覚えは空）。
export function aiHistNew(t: string, who: i32, ops: string[], desc: string): AiHist {
  return {
    t: t.clone(), who, ops: aiStrs(ops), desc: desc.clone(), changes: [], applied: false, open: false, wrapW: -1,
    wrapSize: 0.0, descLines: [],
  };
}

// 選ばれている op の数。
export function aiSelectedCount(p: AiProposal): i32 {
  let n = 0;
  for (const o of p.ops) {
    if (o.on && o.stale.length == 0) {
      n++;
    }
  }
  return n;
}

// 選んだ op だけの新しいバッチ（op の文）。適用の前に、これで dry-run し直す（ui.md 15.2 の 5）。
export function aiSelectedOps(p: AiProposal): string[] {
  let out: string[] = [];
  for (const o of p.ops) {
    if (o.on && o.stale.length == 0) {
      out.push(o.op.clone());
    }
  }
  return out;
}

// 選んだ op を ops.um の runOps に渡せる形（引数に分けたもの）にする。
export function aiSelectedArgs(p: AiProposal): string[][] {
  let out: string[][] = [];
  for (const s of aiSelectedOps(p)) {
    out.push(splitArgs(s));
  }
  return out;
}

// ---- 数の文字 ----

function aiPad2(v: i64): string {
  if (v < 10) {
    return `0${v}`;
  }
  return `${v}`;
}

// 秒を小数 d 桁の文字に（負の数は「−」）。
export function aiSec(v: f64, d: i32): string {
  let neg = v < 0.0;
  let a = neg ? -v : v;
  let m: f64 = 1.0;
  for (let i = 0; i < d; i++) {
    m = m * 10.0;
  }
  const q = Math.floor(a * m + 0.5) as i64;
  const ip = q / (m as i64);
  let fp = q - ip * (m as i64);
  let s = `${ip}`;
  if (d > 0) {
    let fs = `${fp}`;
    while ((fs.length as i32) < d) {
      fs = "0" + fs;
    }
    s = s + "." + fs;
  }
  if (neg && q != 0) {
    return "−" + s;
  }
  return s;
}

// 符号つき（"+1.20" / "−0.80"）。
export function aiSecSigned(v: f64, d: i32): string {
  if (v > 0.0) {
    return "+" + aiSec(v, d);
  }
  return aiSec(v, d);
}

// 素材の中の時刻（"0:12.4"）。
export function aiMinSec(v: f64): string {
  const t = Math.max(v, 0.0);
  const m = Math.floor(t / 60.0) as i64;
  const rest = t - (m as f64) * 60.0;
  let s = aiSec(rest, 1);
  if (rest < 10.0) {
    s = "0" + s;
  }
  return `${m}:` + s;
}

// 秒をタイムコード（"00:00:12:12"。fps はコマ毎秒の整数。負は 0）にする。画面に出す時刻はこれを使う。
export function aiTimecode(sec: f64, fps: i32): string {
  const f = Math.max(fps, 1) as i64;
  const total = Math.floor(Math.max(sec, 0.0) * (f as f64) + 0.5) as i64;
  const ff = total % f;
  const s = total / f;
  return aiPad2(s / 3600) + ":" + aiPad2((s / 60) % 60) + ":" + aiPad2(s % 60) + ":" + aiPad2(ff);
}

// 秒をコマ数にする（四捨五入。符号つきの文字）。
export function aiFramesText(sec: f64, fps: i32): string {
  const n = Math.floor(Math.abs(sec) * (Math.max(fps, 1) as f64) + 0.5) as i64;
  if (sec < 0.0 && n != 0) {
    return `−${n}`;
  }
  return `${n}`;
}

// ISO 8601 の時刻から「14:32」を取り出す（読めなければそのまま）。
export function aiClockOf(t: string): string {
  let i: usize = 0;
  while (i < t.length && t[i] != 84) {
    i++;
  }
  if (i + 6 <= t.length) {
    let b: u8[] = [];
    for (let k = i + 1; k < i + 6; k++) {
      b.push(t[k]);
    }
    return stringFromBytes(b);
  }
  return t.clone();
}

// ---- 差分（変わったトークンだけ） ----

function aiWords(s: string): string[] {
  let out: string[] = [];
  let cur: u8[] = [];
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 32 || s[i] == 9) {
      if (cur.length > 0) {
        out.push(stringFromBytes(cur));
        cur = [];
      }
    } else {
      cur.push(s[i]);
    }
  }
  if (cur.length > 0) {
    out.push(stringFromBytes(cur));
  }
  return out;
}

function aiHas(list: string[], w: string): bool {
  for (const x of list) {
    if (x == w) {
      return true;
    }
  }
  return false;
}

// 1 行の書き換えを 1 行の差分にする: 前にだけある語を「消す」、後にだけある語を「足す」で並べる。
// 同じ語はそのまま（キー=値のキーの部分は KEY の色）。
export function aiDiffOfLine(lineNo: i32, before: string, after: string): AiDiffLine {
  let toks: AiTok[] = [];
  toks.push({ kind: AI_TOK_NOTE, text: `${lineNo} 行目` });
  const a = aiWords(before);
  const b = aiWords(after);
  let i: usize = 0;
  let j: usize = 0;
  while (i < a.length || j < b.length) {
    if (i < a.length && j < b.length && a[i] == b[j]) {
      toks.push({ kind: AI_TOK_PLAIN, text: a[i].clone() });
      i++;
      j++;
    } else if (i < a.length && !aiHas(b, a[i])) {
      toks.push({ kind: AI_TOK_DEL, text: a[i].clone() });
      i++;
    } else if (j < b.length && !aiHas(a, b[j])) {
      toks.push({ kind: AI_TOK_ADD, text: b[j].clone() });
      j++;
    } else if (i < a.length) {
      toks.push({ kind: AI_TOK_PLAIN, text: a[i].clone() });
      i++;
    } else {
      toks.push({ kind: AI_TOK_PLAIN, text: b[j].clone() });
      j++;
    }
  }
  return { toks };
}

// ops.um の Change の並びを差分の行にする。
export function aiDiffOfChanges(ch: Change[]): AiDiffLine[] {
  let out: AiDiffLine[] = [];
  for (const c of ch) {
    if (c.kind == "insert") {
      out.push({ toks: [{ kind: AI_TOK_NOTE, text: `${c.line} 行目` }, { kind: AI_TOK_ADD, text: c.after.clone() }] });
    } else if (c.kind == "comment") {
      out.push({ toks: [{ kind: AI_TOK_NOTE, text: `${c.line} 行目` }, { kind: AI_TOK_DEL, text: c.before.clone() }] });
    } else {
      out.push(aiDiffOfLine(c.line, c.before, c.after));
    }
  }
  return out;
}

// ---- JSON（文字列のエスケープだけ） ----

export function aiJsonQuote(s: string): string {
  let b: u8[] = [34];
  for (let i: usize = 0; i < s.length; i++) {
    const c = s[i];
    if (c == 34 || c == 92) {
      b.push(92);
      b.push(c);
    } else if (c == 10) {
      b.push(92);
      b.push(110);
    } else if (c == 13) {
      b.push(92);
      b.push(114);
    } else if (c == 9) {
      b.push(92);
      b.push(116);
    } else if (c < 32) {
      // そのほかの制御文字は \u00XX にする
      const hex = "0123456789abcdef";
      b.push(92);
      b.push(117);
      b.push(48);
      b.push(48);
      b.push(hex[(c >> 4) as usize]);
      b.push(hex[(c & 15) as usize]);
    } else {
      b.push(c);
    }
  }
  b.push(34);
  return stringFromBytes(b);
}

function aiJsonList(list: string[]): string {
  let s = "[";
  for (let i: usize = 0; i < list.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + aiJsonQuote(list[i]);
  }
  return s + "]";
}

export function aiWhoName(who: i32): string {
  if (who == AI_WHO_AI) {
    return "ai";
  }
  if (who == AI_WHO_TEXT) {
    return "text";
  }
  return "human";
}

export function aiWhoParse(s: string): i32 {
  if (s == "ai") {
    return AI_WHO_AI;
  }
  if (s == "text") {
    return AI_WHO_TEXT;
  }
  return AI_WHO_HUMAN;
}

function aiDiffText(d: AiDiffLine): string {
  let s = "";
  for (const t of d.toks) {
    if (t.kind == AI_TOK_NOTE) {
      continue;
    }
    if (s.length > 0) {
      s = s + " ";
    }
    if (t.kind == AI_TOK_DEL) {
      s = s + "-" + t.text;
    } else if (t.kind == AI_TOK_ADD) {
      s = s + "+" + t.text;
    } else {
      s = s + t.text;
    }
  }
  return s;
}

// 履歴の 1 行を .mzc.history の JSON Lines の 1 行にする（ui.md 14.2）。
export function aiHistToJson(h: AiHist): string {
  let ch: string[] = [];
  for (const d of h.changes) {
    ch.push(aiDiffText(d));
  }
  return "{\"t\":" + aiJsonQuote(h.t) + ",\"who\":" + aiJsonQuote(aiWhoName(h.who)) + ",\"ops\":" + aiJsonList(h.ops) +
    ",\"desc\":" + aiJsonQuote(h.desc) + ",\"changes\":" + aiJsonList(ch) + "}";
}

// 提案を JSON にする（［JSON で見る］・AI への返し）。
export function aiProposalToJson(p: AiProposal): string {
  let s = "{\"id\":" + aiJsonQuote(p.id) + ",\"request\":" + aiJsonQuote(p.request) + ",\"ops\":[";
  for (let i: usize = 0; i < p.ops.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + "{\"op\":" + aiJsonQuote(p.ops[i].op) + ",\"desc\":" + aiJsonQuote(p.ops[i].desc) + ",\"selected\":" + aiBoolText(p.ops[i].on) + "}";
  }
  return s + "],\"errorsAdded\":" + `${p.errDelta}` + ",\"moved\":" + `${p.moved}` + ",\"lengthDelta\":" + aiSec(p.lengthDelta, 3) + "}";
}

// ---- ops.um の結果から作る ----

// dry-run の結果（runOps の BatchResult）から提案の op を作る。opLines[i] が results[i] に対応する。
// 日本語の 1 文は OpResult.desc、差分は changes、影響の札は moved から作る。
export function aiProposalFromBatch(id: string, request: string, reply: string, opLines: string[], br: BatchResult): AiProposal {
  let p = aiProposalNew(id, request, reply);
  for (let i: usize = 0; i < br.results.length; i++) {
    let line = "";
    if (i < opLines.length) {
      line = opLines[i].clone();
    }
    let o = aiOpNew(line, br.results[i].desc);
    o.diff = aiDiffOfChanges(br.results[i].changes);
    const nm = br.results[i].moved.length;
    if (nm > 0) {
      const d = br.results[i].moved[0].afterStart - br.results[i].moved[0].beforeStart;
      o.rippleN = nm as i32;
      o.rippleSec = d;
      o.lenSec = d;
      if (d < 0.0) {
        o.chips.push(aiChip(AI_CHIP_RIPPLE, AI_T_RIPPLE));
        o.chips.push(aiChip(AI_CHIP_PLAIN, aiTxtRippleChip(nm as i32, aiSec(-d, 2), false)));
      } else {
        o.chips.push(aiChip(AI_CHIP_PLAIN, aiTxtRippleChip(nm as i32, aiSec(d, 2), true)));
      }
    } else if (br.results[i].ok) {
      o.chips.push(aiChip(AI_CHIP_PLAIN, AI_T_NO_MOVE));
    }
    if (!br.results[i].ok) {
      o.bad = true;
      o.chips.push(aiChip(AI_CHIP_ERR, br.results[i].error));
    }
    for (let k: usize = 0; k < br.results[i].newDiagnostics.length; k++) {
      o.errN = o.errN + 1;
      o.chips.push(aiChip(AI_CHIP_WARN, br.results[i].newDiagnostics[k].msg));
    }
    for (let k: usize = 0; k < nm; k++) {
      o.movedIds.push(br.results[i].moved[k].id.clone());
    }
    o.json = "{\"op\":" + aiJsonQuote(o.op) + ",\"ok\":" + aiBoolText(br.results[i].ok) + ",\"desc\":" + aiJsonQuote(br.results[i].desc) + "}";
    p.ops.push(o);
  }
  aiRecomputeSummary(mut p);
  return p;
}

// 選んでいる op だけから、上の 3 つの数（動くクリップ・全体の長さ・増える誤り）を作り直す。
// 選び直したとき（TOGGLE_OP）にその場で呼ぶ。アプリが dry-run し直したら aiApplyRecheckSummary で正しい値に置き換える。
export function aiRecomputeSummary(p: mut AiProposal): void {
  let ids: string[] = [];
  let len: f64 = 0.0;
  let err = 0;
  for (const o of p.ops) {
    if (!o.on || o.stale.length > 0) {
      continue;
    }
    for (const id of o.movedIds) {
      if (!aiHas(ids, id)) {
        ids.push(id.clone());
      }
    }
    len = len + o.lenSec;
    err = err + o.errN;
  }
  p.moved = ids.length as i32;
  p.lengthDelta = len;
  p.errDelta = err;
}

// 選んだ op だけで dry-run し直した結果（runOps(aiSelectedArgs(p)) の BatchResult）から、3 つの数を作り直す。
// aiRecheckWanted が返した提案に、アプリが呼ぶ。
export function aiApplyRecheckSummary(p: mut AiProposal, br: BatchResult): void {
  let ids: string[] = [];
  let err = 0;
  for (const r of br.results) {
    for (const m of r.moved) {
      if (!aiHas(ids, m.id)) {
        ids.push(m.id.clone());
      }
    }
    err = err + (r.newDiagnostics.length as i32);
  }
  p.moved = ids.length as i32;
  p.errDelta = err;
  let len: f64 = 0.0;
  for (const o of p.ops) {
    if (o.on && o.stale.length == 0) {
      len = len + o.lenSec;
    }
  }
  p.lengthDelta = len;
  p.dirty = false;
}

// 適用した提案を履歴の 1 行にする（desc は「AI の提案（N 操作）· あなたが適用」、changes は選んだ op の差分を合わせたもの）。
export function aiHistOfProposal(p: AiProposal, t: string): AiHist {
  const ops = aiSelectedOps(p);
  let h = aiHistNew(t, AI_WHO_AI, ops, aiTxtHistAi(ops.length as i32));
  h.applied = true;
  for (const o of p.ops) {
    if (o.on && o.stale.length == 0) {
      for (const d of o.diff) {
        h.changes.push(aiDiffClone(d));
      }
    }
  }
  return h;
}

// 選んだ op だけで dry-run し直した結果を当てる（ui.md 15.2 の 5）。
// 失敗した op は赤（bad）にして true を返す（書かない）。成功なら false（書いてよい）。
export function aiMarkRecheck(p: mut AiProposal, br: BatchResult): bool {
  let k: usize = 0;
  let failed = false;
  for (let i: usize = 0; i < p.ops.length; i++) {
    if (!p.ops[i].on || p.ops[i].stale.length > 0) {
      continue;
    }
    if (k < br.results.length) {
      const bad = !br.results[k].ok && br.results[k].code != "not-applied";
      p.ops[i].bad = bad || br.results[k].newDiagnostics.length > 0;
      if (p.ops[i].bad) {
        failed = true;
      }
    }
    k++;
  }
  return failed || !br.ok;
}

// ---- 診断 ----

// project.um の Diag を問題の 1 件にする。file は表示する名前（"本編_v3.mzc"）。
export function aiDiagOf(d: Diag, file: string): AiDiagItem {
  return {
    severity: d.severity.clone(), code: d.code.clone(), msg: d.msg.clone(), hint: d.hint.clone(), file: file.clone(),
    line: d.line, col: d.col, suggest: d.suggest.clone(), fixOp: "",
  };
}

export function aiDiagLoc(d: AiDiagItem): string {
  if (d.col > 0) {
    return d.file + `:${d.line}:${d.col}`;
  }
  return d.file + `:${d.line}`;
}

export function aiDiagCounts(list: AiDiagItem[]): i32[] {
  let e = 0;
  let w = 0;
  for (const d of list) {
    if (d.severity == "error") {
      e++;
    } else {
      w++;
    }
  }
  return [e, w];
}

// ---- プレビュー（タイムラインに重ねる情報） ----

// 重ねる 1 つ。kind は AI_PV_*。t0〜t1 は秒、track は 0 から（-1 は全トラック）。
export struct AiMark {
  kind: i32;
  op: i32;          // 提案の中の op の番号（0 から）
  t0: f64;
  t1: f64;
  track: i32;
  clipId: string;
  focus: bool;      // フォーカスしている op
}

// 札（近いものは 1 つにまとめた後）。t は札の左の時刻、text は「1 −0.80」「3 か所」など。
export struct AiTag {
  kind: i32;
  t: f64;
  track: i32;
  text: string;
  count: i32;
}

export struct AiPreview {
  marks: AiMark[];
  tags: AiTag[];
}

// 提案から、タイムラインに重ねる範囲と札を作る。pps は 1 秒の画素、minGap は札をまとめる画素の距離。
// 選ばれた op は CUT / SET、人が外した op は OFF、当てはまらなくなった op は出さない。
export function aiPreviewOf(p: AiProposal, focusOp: i32, pps: f64, minGap: f64): AiPreview {
  let marks: AiMark[] = [];
  let raw: AiTag[] = [];
  for (let i: usize = 0; i < p.ops.length; i++) {
    if (p.ops[i].pv == AI_PV_NONE || p.ops[i].stale.length > 0) {
      continue;
    }
    let kind = p.ops[i].pv;
    let text = `${i + 1} ` + p.ops[i].tag;
    if (!p.ops[i].on) {
      kind = AI_PV_OFF;
      text = aiTxtOffTag((i + 1) as i32);
    }
    const t0 = p.ops[i].t0;
    const t1 = p.ops[i].t1;
    const tr = p.ops[i].track;
    marks.push({ kind, op: i as i32, t0, t1, track: tr, clipId: p.ops[i].clipId.clone(), focus: (i as i32) == focusOp });
    raw.push({ kind, t: t0, track: tr, text, count: 1 });
    if (p.ops[i].on && p.ops[i].rippleN > 0 && p.ops[i].pv == AI_PV_CUT) {
      marks.push({ kind: AI_PV_RIPPLE, op: i as i32, t0: t1, t1, track: tr, clipId: "", focus: false });
    }
  }
  // 札を時刻の順に並べ、同じ種類で近いものを 1 つにまとめる（「3 か所」）
  let idx: i32[] = [];
  for (let i: usize = 0; i < raw.length; i++) {
    idx.push(i as i32);
  }
  for (let i: usize = 1; i < idx.length; i++) {
    let j = i;
    while (j > 0 && raw[idx[j - 1] as usize].t > raw[idx[j] as usize].t) {
      const tmp = idx[j - 1];
      idx[j - 1] = idx[j];
      idx[j] = tmp;
      j--;
    }
  }
  let tags: AiTag[] = [];
  for (const k of idx) {
    const ku = k as usize;
    if (tags.length > 0) {
      const last = tags.length - 1;
      if (tags[last].kind == raw[ku].kind && (raw[ku].t - tags[last].t) * pps < minGap) {
        tags[last].count = tags[last].count + 1;
        tags[last].text = aiTxtSpots(tags[last].count);
        continue;
      }
    }
    tags.push({ kind: raw[ku].kind, t: raw[ku].t, track: raw[ku].track, text: raw[ku].text.clone(), count: 1 });
  }
  // 良い知らせの札（まとめない）
  for (let i: usize = 0; i < p.ops.length; i++) {
    if (p.ops[i].on && p.ops[i].stale.length == 0 && p.ops[i].okTag.length > 0) {
      tags.push({ kind: AI_PV_OK, t: p.ops[i].okTagT, track: -1, text: p.ops[i].okTag.clone(), count: 1 });
    }
  }
  // 後ろが詰まる札: 選んでいる詰める op だけから作る（一番前の範囲の後ろに 1 つ）。
  // 個数は選んだ op で動くクリップの和集合（ID がなければ rippleN の一番大きいもの）、「最大」は選んだ op の rippleSec の和（一番後ろのずれ）。
  let firstRipple: f64 = -1.0;
  let nMax = 0;
  let sum: f64 = 0.0;
  let ids: string[] = [];
  for (let i: usize = 0; i < p.ops.length; i++) {
    if (p.ops[i].on && p.ops[i].stale.length == 0 && p.ops[i].rippleN > 0 && p.ops[i].pv == AI_PV_CUT) {
      if (firstRipple < 0.0 || p.ops[i].t1 < firstRipple) {
        firstRipple = p.ops[i].t1;
      }
      nMax = Math.max(nMax, p.ops[i].rippleN);
      sum = sum + p.ops[i].rippleSec;
      for (const id of p.ops[i].movedIds) {
        if (!aiHas(ids, id)) {
          ids.push(id.clone());
        }
      }
    }
  }
  if (firstRipple >= 0.0) {
    const n = ids.length > 0 ? (ids.length as i32) : nMax;
    tags.push({ kind: AI_PV_RIPPLE, t: firstRipple, track: -1, text: aiTxtRippleTag(n, aiSec(sum, 2)), count: 1 });
  }
  return { marks, tags };
}

// ---- パネルの状態 ----

export const AI_CMP_NOW: i32 = 0;
export const AI_CMP_SPLIT: i32 = 1;
export const AI_CMP_AFTER: i32 = 2;

export struct AiPanelState {
  connected: bool;
  thinking: bool;
  thinkingSince: f64;
  proposals: AiProposal[];
  review: i32;         // 確かめている提案（-1 はなし）
  focusOp: i32;
  showJson: bool;
  compare: i32;        // AI_CMP_*
  ask: string;         // 頼む欄の文字
  follow: string;      // 直してほしい点の欄の文字
  followOpen: bool;    // 直してほしい点の欄を開いている（［直す］）
  share: AiChip[];     // AI に見せる札
  history: AiHist[];
  histPos: i32;        // いまの位置（histPos 個まで適用済み。それより後は取り消した行）
  histDiff: i32;       // 差分を開いている行（-1 はなし）
  diags: AiDiagItem[];
  diagSel: i32;
  // スクロール（画素）
  scrollOps: i32;
  scrollHist: i32;
  scrollDiag: i32;
  scrollCards: i32;
  // そのほか
  fps: i32;            // タイムコードとコマ数に使う（シーケンスのコマ毎秒）
  reduceMotion: bool;  // 設定「動きを減らす」（明滅を止める。uikit の UkCtx に入ったらそちらへ）
  sharing: bool;       // 「AI に見せる」がオン（Ctrl+Shift+J で切り替え）
  expandTop: bool;     // 頼みと返事を全部見せる（［続きを読む］）
  hoverHist: i32;      // ホバーしている履歴の行（変わったときだけ AI_EV_HOVER_HIST を積む）
  followOp: bool;      // フォーカスした op が見えるところへスクロールする（↑↓ の後の 1 回）
  opTops: i32[];       // op の行の上の端（一覧の中身の座標。前のフレームに測ったもの）
  opHs: i32[];
  histTops: i32[];     // 履歴の行の上の端（histKey が変わったときだけ作り直す）
  histKey: u32;
  trap: u32[];         // 確かめる欄の中のフォーカスできる部品（Tab をこの中で回す）
  focusAsk: bool;      // 次のフレームで頼む欄にフォーカスを移す（Ctrl+J）
  // 却下の通知（［元に戻す］つき。uikit の ukToast にボタンと時間が付くまでの仮）
  toastText: string;
  toastT0: f64;
  toastProp: i32;      // ［元に戻す］で戻す提案（-1 はボタンなし）
}

export function aiPanelNew(): AiPanelState {
  return {
    connected: true, thinking: false, thinkingSince: 0.0, proposals: [], review: -1, focusOp: 0, showJson: false,
    compare: AI_CMP_SPLIT, ask: "", follow: "", followOpen: false, share: [], history: [], histPos: 0, histDiff: -1, diags: [], diagSel: -1,
    scrollOps: 0, scrollHist: 0, scrollDiag: 0, scrollCards: 0, fps: 30, reduceMotion: false, sharing: true, expandTop: false,
    hoverHist: -1, followOp: false, opTops: [], opHs: [], histTops: [], histKey: 0, trap: [], focusAsk: false, toastText: "",
    toastT0: -100.0, toastProp: -1,
  };
}

// 未確認の提案の数（タブの紫の札）。
export function aiPendingCount(st: AiPanelState): i32 {
  let n = 0;
  for (const p of st.proposals) {
    if (p.state == AI_PROP_NEW || p.state == AI_PROP_REVIEW) {
      n++;
    }
  }
  return n;
}

// 出来事を状態に当てる（パネルの中で閉じるもの: 選ぶ・外す、フォーカス、JSON の切り替え、確かめる、却下、比較）。
// 適用・取り消し・問題を直すなど、.mzc を書くものはアプリが ops.um で行い、その結果を aiHistPush などで返す。
export function aiPanelApplyEvent(st: mut AiPanelState, e: AiEvent): void {
  const pi = e.prop;
  const ok = pi >= 0 && (pi as usize) < st.proposals.length;
  if (e.kind == AI_EV_REVIEW && ok) {
    st.review = pi;
    st.proposals[pi as usize].state = AI_PROP_REVIEW;
    st.focusOp = 0;
    st.scrollOps = 0;
    st.followOpen = false;
  } else if (e.kind == AI_EV_REJECT && ok) {
    // 捨てずに印を付けるだけ（通知の［元に戻す］で戻せる。ui.md 15.2 の 6）
    st.proposals[pi as usize].rejectedFromReview = st.review == pi;
    st.proposals[pi as usize].state = AI_PROP_REJECTED;
    if (st.review == pi) {
      st.review = -1;
    }
  } else if (e.kind == AI_EV_UNREJECT && ok) {
    aiPanelRestore(mut st, pi);
  } else if (e.kind == AI_EV_TOGGLE_OP && ok) {
    const n = st.proposals[pi as usize].ops.length;
    if (e.index >= 0 && (e.index as usize) < n && st.proposals[pi as usize].ops[e.index as usize].stale.length == 0) {
      const v = !st.proposals[pi as usize].ops[e.index as usize].on;
      st.proposals[pi as usize].ops[e.index as usize].on = v;
      st.proposals[pi as usize].ops[e.index as usize].byHuman = !v;
      // 3 つの数と詰まる札をその場で作り直し、アプリに dry-run し直してもらう（aiRecheckWanted）
      aiRecomputeSummary(mut st.proposals[pi as usize]);
      st.proposals[pi as usize].dirty = true;
    }
  } else if (e.kind == AI_EV_FOCUS_OP) {
    st.focusOp = e.index;
    st.followOp = true;
  } else if (e.kind == AI_EV_SELECT_DIAG) {
    st.diagSel = e.index;
  } else if (e.kind == AI_EV_SHARE_TOGGLE) {
    st.sharing = !st.sharing;
  } else if (e.kind == AI_EV_FOCUS_ASK) {
    st.focusAsk = true;
  } else if (e.kind == AI_EV_JSON) {
    st.showJson = !st.showJson;
  } else if (e.kind == AI_EV_COMPARE) {
    st.compare = (st.compare + 1) % 3;
  } else if (e.kind == AI_EV_HIST_DIFF && e.text == "open") {
    // AI の提案の行を開く・閉じる（中の op を並べる）
    if (e.index >= 0 && (e.index as usize) < st.history.length) {
      st.history[e.index as usize].open = !st.history[e.index as usize].open;
    }
  } else if (e.kind == AI_EV_HIST_DIFF) {
    st.histDiff = st.histDiff == e.index ? -1 : e.index;
  } else if (e.kind == AI_EV_SHARE_REMOVE) {
    if (e.index >= 0 && (e.index as usize) < st.share.length) {
      let rest: AiChip[] = [];
      for (let i: usize = 0; i < st.share.length; i++) {
        if ((i as i32) != e.index) {
          rest.push(aiChip(st.share[i].kind, st.share[i].text));
        }
      }
      st.share = rest;
    }
  }
}

// 選び直した後、dry-run し直してほしい提案の番号（なければ -1）。
export function aiRecheckWanted(st: AiPanelState): i32 {
  for (let i: usize = 0; i < st.proposals.length; i++) {
    if (st.proposals[i].dirty && st.proposals[i].state != AI_PROP_REJECTED && st.proposals[i].state != AI_PROP_APPLIED) {
      return i as i32;
    }
  }
  return -1;
}

// 却下した提案を元に戻す（確かめる欄で却下したなら確かめる欄に戻す）。
export function aiPanelRestore(st: mut AiPanelState, pi: i32): void {
  if (pi < 0 || (pi as usize) >= st.proposals.length || st.proposals[pi as usize].state != AI_PROP_REJECTED) {
    return;
  }
  if (st.proposals[pi as usize].rejectedFromReview && st.review < 0) {
    st.proposals[pi as usize].state = AI_PROP_REVIEW;
    st.review = pi;
  } else {
    st.proposals[pi as usize].state = AI_PROP_NEW;
  }
  st.proposals[pi as usize].rejectedFromReview = false;
  if (st.toastProp == pi) {
    st.toastText = "";
    st.toastProp = -1;
  }
}

// 通知を出す（prop >= 0 なら［元に戻す］つき。出しておく時間は th.dToastUndo）。
export function aiToastShow(st: mut AiPanelState, text: string, prop: i32, now: f64): void {
  st.toastText = text.clone();
  st.toastT0 = now;
  st.toastProp = prop;
}

// 状態の帯の左の 1 文（つながっていなければ「AI はつながっていません」）。
export function aiStatusText(st: AiPanelState): string {
  if (!st.connected) {
    return AI_T_OFFLINE_SHORT;
  }
  if (st.review >= 0 && (st.review as usize) < st.proposals.length) {
    const p = st.review as usize;
    return aiTxtStatusReview(st.proposals[p].ops.length as i32, aiSelectedCount(st.proposals[p]));
  }
  const n = aiPendingCount(st);
  if (n > 0) {
    return aiTxtStatusPending(n);
  }
  return "";
}

// 履歴に積む（取り消した行より後ろは捨てる）。
export function aiHistPush(st: mut AiPanelState, h: AiHist): void {
  let keep: AiHist[] = [];
  for (let i: usize = 0; i < st.history.length && (i as i32) < st.histPos; i++) {
    keep.push(aiHistClone(st.history[i]));
  }
  let nh = aiHistClone(h);
  if (nh.who == AI_WHO_AI && nh.applied && nh.desc.length == 0) {
    // 履歴のファイルにも人が読む 1 文を残す
    nh.desc = aiTxtHistAi(nh.ops.length as i32);
  }
  keep.push(nh);
  st.history = keep;
  st.histPos = st.history.length as i32;
}

export function aiHistClone(h: AiHist): AiHist {
  let ch: AiDiffLine[] = [];
  for (const d of h.changes) {
    ch.push(aiDiffClone(d));
  }
  return {
    t: h.t.clone(), who: h.who, ops: aiStrs(h.ops), desc: h.desc.clone(), changes: ch, applied: h.applied, open: h.open,
    wrapW: -1, wrapSize: 0.0, descLines: [],
  };
}

export function aiDiffClone(d: AiDiffLine): AiDiffLine {
  let toks: AiTok[] = [];
  for (const t of d.toks) {
    toks.push({ kind: t.kind, text: t.text.clone() });
  }
  return { toks };
}
