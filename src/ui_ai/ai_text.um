// ui_ai の文言の表（ui.md 16.1「文言はすべて鍵で引く表に置く」）。
// i18n/ja.json ができるまでの仮。鍵（場所.物.動き）を名前にした定数と、数の入る文を作る関数を 1 か所に置く。
// デザインの文言が変わったら、ここだけを直す。画面のコード（ai_panel.um・ai_draw.um）に文言を直接書かない。

// ---- AI のタブ: 確かめる欄 ----
export const AI_T_REVIEW_TITLE: string = "AI の提案";                               // ai.review.title
export const AI_T_REVIEW_BADGE: string = "試算済み · 未確認";                        // ai.review.badge
export const AI_T_REVIEW_BADGE_TIP: string = "AI が dry-run で試算しました。ファイルにはまだ何も書いていません";
export const AI_T_JSON_SHOW: string = "JSON で見る";                                 // ai.review.json.show
export const AI_T_JSON_HIDE: string = "文で見る";                                    // ai.review.json.hide
export const AI_T_CTX_SHOWN: string = "見せたもの";                                  // ai.review.context
export const AI_T_MORE: string = "続きを読む";                                       // ai.review.more
export const AI_T_LESS: string = "たたむ";                                           // ai.review.less
export const AI_T_OFF: string = "外した";                                            // ai.op.off
export const AI_T_NO_MOVE: string = "動くクリップなし";                              // ai.op.noMove
export const AI_T_RIPPLE: string = "詰める";                                         // ai.op.ripple
export const AI_T_REJECT: string = "却下する";                                       // ai.review.reject
export const AI_T_FIX: string = "修正を頼む";                                        // ai.review.fix
export const AI_T_FIX_TIP: string = "直してほしい点を書いて、この提案の続きとして AI に送ります";
export const AI_T_FOLLOW_HINT: string = "直してほしい点を書く（Ctrl+Enter で送る）";  // ai.review.follow.hint
export const AI_T_NEED_SELECT: string = "操作を 1 つ以上選んでください";             // ai.review.apply.none
export const AI_T_KBD_APPLY: string = "Ctrl Enter";
export const AI_T_KBD_ESC: string = "Esc";
export const AI_T_KBD_ENTER: string = "Enter";

// ---- AI のタブ: カード・頼む欄・空 ----
export const AI_T_CARD_HEAD: string = "AI の提案 · 確かめ済み（まだ書いていません）";  // ai.card.head
export const AI_T_CARD_REVIEW: string = "確かめる";                                   // ai.card.review
export const AI_T_CARD_REJECT: string = "却下";                                       // ai.card.reject
export const AI_T_THINKING: string = "提案を作っています…";                           // ai.thinking
export const AI_T_SHARE: string = "AI に見せる";                                      // ai.share.label
export const AI_T_ASK_HINT: string = "AI に頼む（Ctrl+J）";                           // ai.ask.hint
export const AI_T_SEND: string = "送る";                                              // ai.ask.send
export const AI_T_EMPTY: string = "頼みたいことを書いてください。AI は提案だけを出し、あなたが適用するまでファイルは変わりません";
export const AI_T_OFFLINE: string = "AI はつながっていません。つなぐと、カットや字幕の提案を受け取れます。";
export const AI_T_CONNECT: string = "つなぎ方";
export const AI_T_REJECTED: string = "提案を却下しました";                            // ai.toast.rejected
export const AI_T_UNDO_REJECT: string = "元に戻す";                                   // ai.toast.undo
export const AI_T_APPLIED: string = "AI の提案を適用しました。Ctrl+Z で取り消せます";

// ---- 履歴 ----
export const AI_T_UNDO: string = "取り消す";
export const AI_T_REDO: string = "やり直す";
export const AI_T_KBD_UNDO: string = "Ctrl Z";
export const AI_T_KBD_REDO: string = "Ctrl Shift Z";
export const AI_T_DIFF: string = "差分";
export const AI_T_DIFF_CLOSE: string = "差分を閉じる";
export const AI_T_UNDO_TO: string = "ここまで戻す";
export const AI_T_NOW: string = "いまの位置";
export const AI_T_HIST_EMPTY: string = "まだ操作はありません。ここに、人・AI・テキストの変更が日本語で並びます。どれも Ctrl+Z で戻せます";

// ---- 問題 ----
export const AI_T_PROBLEMS: string = "問題";
export const AI_T_NO_PROBLEMS: string = "問題はありません";
export const AI_T_GO_SOURCE: string = "ソースの欄のこの場所へ";

// ---- 状態の帯 ----
export const AI_T_OFFLINE_SHORT: string = "AI はつながっていません";
export const AI_T_SHARING: string = "AI に見せています";

// ---- 数の入る文 ----

export function aiTxtErrAdded(n: i32): string {
  return `エラーの増加 ${n}`;
}

export function aiTxtMoved(n: i32): string {
  return `動くクリップ ${n}`;
}

// 「全体の長さ −1.43 秒（43 コマ）」。sec と frames は呼ぶ側で作る（符号つき）。
export function aiTxtLength(sec: string, frames: string): string {
  return "全体の長さ " + sec + " 秒（" + frames + " コマ）";
}

export function aiTxtFoot(n: i32): string {
  return `適用すると、履歴に「AI の提案（${n} 操作）」として 1 つ残り、Ctrl+Z の 1 回で取り消せます。`;
}

export function aiTxtApply(n: i32): string {
  return `選んだ ${n} 個を適用する`;
}

export function aiTxtCardMeta(nOps: i32, moved: i32, errDelta: i32): string {
  if (errDelta == 0) {
    return `${nOps} 操作 · 動くクリップ ${moved} · 誤りの増加 なし`;
  }
  return `${nOps} 操作 · 動くクリップ ${moved} · 誤りの増加 ${errDelta}`;
}

export function aiTxtHistAi(n: i32): string {
  return `AI の提案（${n} 操作）· あなたが適用`;
}

export function aiTxtCount(n: i32): string {
  return `${n} 件`;
}

export function aiTxtDiagCounts(e: i32, w: i32): string {
  return `エラー ${e} · 警告 ${w}`;
}

export function aiTxtFixTo(s: string): string {
  return "'" + s + "' に直す";
}

export function aiTxtStatusReview(nOps: i32, nSel: i32): string {
  return `AI の提案を確認しています（${nOps} 操作のうち ${nSel} 個を選択）`;
}

export function aiTxtStatusPending(n: i32): string {
  return `AI の提案 ${n} 件 未確認`;
}

export function aiTxtTopBadge(n: i32): string {
  return `AI · 提案 ${n}`;
}

// 後ろが詰まる札（「◀ 後ろの 14 個が詰まる（最大 −1.43 秒）」）。
export function aiTxtRippleTag(n: i32, sec: string): string {
  return `◀ 後ろの ${n} 個が詰まる（最大 ` + sec + " 秒）";
}

export function aiTxtRippleChip(n: i32, sec: string, back: bool): string {
  if (back) {
    return `後ろの ${n} 個が ` + sec + " 秒後ろへ";
  }
  return `後ろの ${n} 個が ` + sec + " 秒前へ";
}

export function aiTxtOffTag(no: i32): string {
  return `${no} ` + AI_T_OFF;
}

export function aiTxtSpots(n: i32): string {
  return `${n} か所`;
}
