// AI の提案・履歴・問題のパネル（ui_ai）が使うテーマ。
// 値の正本は docs/design/tokens.json。ここでは tokens.json を道筋（"color.dark.semantic.ai" など）で読み、
// 読めない値だけ既定（tokens.json の version 2 と同じ値）を使う。色や大きさを部品のコードに直接書かない。
// uikit の UkTheme に ai・text-3 などが入ったら、そちらに寄せる（報告の「uikit に足すべきもの」）。
import { ukParseHex } from "../uikit/theme.um";

// tokens.json を平らにしたもの（葉の値だけ。keys[i] は "a.b.c" の道筋）
export struct AiTokens {
  keys: string[];
  strs: string[];
  nums: f64[];
  isNum: bool[];
}

export struct AiTheme {
  scale: f32;
  // ---- 色（0xAARRGGBB） ----
  bg0: u32;
  bg1: u32;
  bg2: u32;
  bg3: u32;
  bg4: u32;
  popover: u32;
  line: u32;
  lineStrong: u32;
  lineControl: u32;  // 部品の輪郭（チェック・キーの札・［＋］の枠）。bg.0〜bg.3 に 3:1 以上
  text1: u32;
  text2: u32;
  text3: u32;
  textDis: u32;
  textOnLight: u32;
  textOnAi: u32;
  textOnOk: u32;
  textOnRipple: u32;
  textOnDark: u32;
  accent: u32;
  accentHover: u32;
  accentTint: u32;
  ai: u32;
  aiTint: u32;
  ok: u32;
  okTint: u32;
  warn: u32;
  warnTint: u32;
  error: u32;
  errorTint: u32;
  ripple: u32;
  rippleTint: u32;
  textSource: u32;
  textSourceTint: u32;
  reference: u32;
  focusOuter: u32;
  // ---- 文字（倍率を掛けた画素） ----
  fsXs: f32;
  fsSm: f32;
  fsMd: f32;
  fsLg: f32;
  fsCode: f32;
  fsCodeSm: f32;
  lhXs: i32;
  lhSm: i32;
  lhMd: i32;
  lhCode: i32;
  lhCodeSm: i32;
  // ---- 余白・角・寸法 ----
  s1: i32;
  s2: i32;
  s3: i32;
  s4: i32;
  s5: i32;
  rSm: i32;
  rMd: i32;
  rLg: i32;
  btnSm: i32;
  btnMd: i32;
  btnLg: i32;
  tabBar: i32;
  row: i32;
  field: i32;
  iconSm: i32;
  hairline: i32;
  focusW: i32;
  hatchPeriod: i32;
  dashOn: i32;
  dashOff: i32;
  // 薄い地の不透明度（0〜255。tokens の opacity.hatch など）
  hatchA: i32;
  // 「直前の操作」を光らせる時間（秒）と、提案の点の明滅の周期（秒）、取り消しつきの通知の時間（秒）
  dChange: f64;
  dPulse: f64;
  dToastUndo: f64;
}

// ---- tokens.json を平らに読む ----

function aiJsonWs(s: string, i0: usize): usize {
  let i = i0;
  while (i < s.length && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) {
    i++;
  }
  return i;
}

function aiJsonStr(s: string, i0: usize, end: mut usize[]): string {
  let out: u8[] = [];
  let i = i0 + 1;
  while (i < s.length && s[i] != 34) {
    if (s[i] == 92 && i + 1 < s.length) {
      i++;
    }
    out.push(s[i]);
    i++;
  }
  end[0] = i + 1;
  return stringFromBytes(out);
}

function aiJoin(path: string[]): string {
  let s = "";
  for (let i: usize = 0; i < path.length; i++) {
    if (i > 0) {
      s = s + ".";
    }
    s = s + path[i];
  }
  return s;
}

export function aiTokensEmpty(): AiTokens {
  return { keys: [], strs: [], nums: [], isNum: [] };
}

// tokens.json を読む。配列の要素は "[]" の道筋にする（使わない）。読めなければ空。
export function aiTokensParse(json: string): AiTokens {
  let tk = aiTokensEmpty();
  let path: string[] = [];
  let isObj: bool[] = [];
  let pendingKey = false;
  let end: usize[] = [0];
  let i = aiJsonWs(json, 0);
  while (i < json.length) {
    const b = json[i];
    if (b == 123) {
      isObj.push(true);
      path.push("");
      pendingKey = true;
      i++;
    } else if (b == 125 || b == 93) {
      if (isObj.length == 0) {
        return aiTokensEmpty();
      }
      isObj.pop();
      path.pop();
      i++;
    } else if (b == 91) {
      isObj.push(false);
      path.push("[]");
      i++;
    } else if (b == 44) {
      if (isObj.length > 0 && isObj[isObj.length - 1]) {
        pendingKey = true;
      }
      i++;
    } else if (b == 58) {
      pendingKey = false;
      i++;
    } else if (b == 34) {
      const str = aiJsonStr(json, i, mut end);
      i = end[0];
      if (pendingKey && path.length > 0) {
        path[path.length - 1] = str;
        pendingKey = false;
      } else {
        tk.keys.push(aiJoin(path));
        tk.strs.push(str);
        tk.nums.push(0.0);
        tk.isNum.push(false);
      }
    } else if ((b >= 48 && b <= 57) || b == 45) {
      let j = i;
      let v: f64 = 0.0;
      let neg = false;
      if (json[j] == 45) {
        neg = true;
        j++;
      }
      while (j < json.length && json[j] >= 48 && json[j] <= 57) {
        v = v * 10.0 + ((json[j] - 48) as f64);
        j++;
      }
      if (j < json.length && json[j] == 46) {
        j++;
        let f: f64 = 0.1;
        while (j < json.length && json[j] >= 48 && json[j] <= 57) {
          v = v + ((json[j] - 48) as f64) * f;
          f = f * 0.1;
          j++;
        }
      }
      if (neg) {
        v = -v;
      }
      tk.keys.push(aiJoin(path));
      tk.strs.push("");
      tk.nums.push(v);
      tk.isNum.push(true);
      i = j;
    } else {
      i++;
    }
  }
  return tk;
}

function aiTokFind(tk: AiTokens, key: string): i32 {
  for (let i: usize = 0; i < tk.keys.length; i++) {
    if (tk.keys[i] == key) {
      return i as i32;
    }
  }
  return -1;
}

// 色の値（"#rrggbb" / "#rrggbbaa"）。なければ def。
export function aiTokColor(tk: AiTokens, key: string, def: u32): u32 {
  const i = aiTokFind(tk, key);
  if (i < 0 || tk.isNum[i as usize]) {
    return def;
  }
  const c = ukParseHex(tk.strs[i as usize]);
  if (c < 0) {
    return def;
  }
  return c as u32;
}

// 数の値。なければ def。
export function aiTokNum(tk: AiTokens, key: string, def: f64): f64 {
  const i = aiTokFind(tk, key);
  if (i < 0 || !tk.isNum[i as usize]) {
    return def;
  }
  return tk.nums[i as usize];
}

function aiSc(tk: AiTokens, key: string, def: f64, s: f32): i32 {
  const v = aiTokNum(tk, key, def);
  return Math.max(Math.floor((v as f32) * s + 0.5) as i32, 1);
}

function aiScF(tk: AiTokens, key: string, def: f64, s: f32): f32 {
  return (aiTokNum(tk, key, def) as f32) * s;
}

// tokens から作る（scale は UI の倍率。uikit の ui.theme.scale を渡す）。
export function aiThemeFrom(tk: AiTokens, scale: f32): AiTheme {
  const s = scale;
  const C = "color.dark.";
  return {
    scale: s,
    bg0: aiTokColor(tk, C + "bg.0", 0xff141414),
    bg1: aiTokColor(tk, C + "bg.1", 0xff1b1b1b),
    bg2: aiTokColor(tk, C + "bg.2", 0xff222222),
    bg3: aiTokColor(tk, C + "bg.3", 0xff2c2c2c),
    bg4: aiTokColor(tk, C + "bg.4", 0xff383838),
    popover: aiTokColor(tk, C + "bg.popover", 0xff1f1f1f),
    line: aiTokColor(tk, C + "line.default", 0xff2c2c2c),
    lineStrong: aiTokColor(tk, C + "line.strong", 0xff3c3c3c),
    lineControl: aiTokColor(tk, C + "line.control", 0xff767676),
    text1: aiTokColor(tk, C + "text.1", 0xffe6e6e6),
    text2: aiTokColor(tk, C + "text.2", 0xffa3a3a3),
    text3: aiTokColor(tk, C + "text.3", 0xff8c8c8c),
    textDis: aiTokColor(tk, C + "text.disabled", 0xff666666),
    textOnLight: aiTokColor(tk, C + "text.onLight", 0xff141414),
    textOnAi: aiTokColor(tk, C + "text.onAi", 0xff141414),
    textOnOk: aiTokColor(tk, C + "text.onOk", 0xff141414),
    textOnRipple: aiTokColor(tk, C + "text.onRipple", 0xff141414),
    textOnDark: aiTokColor(tk, C + "text.onDark", 0xfff2f2f2),
    accent: aiTokColor(tk, C + "accent.default", 0xff4c8dff),
    accentHover: aiTokColor(tk, C + "accent.hover", 0xff6fa3ff),
    accentTint: aiTokColor(tk, C + "accent.tint", 0x294c8dff),
    ai: aiTokColor(tk, C + "semantic.ai", 0xffbd97f7),
    aiTint: aiTokColor(tk, C + "semantic.aiTint", 0x24bd97f7),
    ok: aiTokColor(tk, C + "semantic.ok", 0xff4cc38a),
    okTint: aiTokColor(tk, C + "semantic.okTint", 0x244cc38a),
    warn: aiTokColor(tk, C + "semantic.warn", 0xfff08a3c),
    warnTint: aiTokColor(tk, C + "semantic.warnTint", 0x24f08a3c),
    error: aiTokColor(tk, C + "semantic.error", 0xffff706c),
    errorTint: aiTokColor(tk, C + "semantic.errorTint", 0x1aff706c),
    ripple: aiTokColor(tk, C + "semantic.ripple", 0xfff2c94c),
    rippleTint: aiTokColor(tk, C + "semantic.rippleTint", 0x24f2c94c),
    textSource: aiTokColor(tk, C + "semantic.textSource", 0xffd8d2c4),
    textSourceTint: aiTokColor(tk, C + "semantic.textSourceTint", 0x24d8d2c4),
    reference: aiTokColor(tk, C + "semantic.reference", 0xff62d2e8),
    focusOuter: aiTokColor(tk, C + "semantic.focusOuter", 0xff000000),
    fsXs: aiScF(tk, "font.size.xs.size", 11.0, s),
    fsSm: aiScF(tk, "font.size.sm.size", 12.0, s),
    fsMd: aiScF(tk, "font.size.md.size", 13.0, s),
    fsLg: aiScF(tk, "font.size.lg.size", 15.0, s),
    fsCode: aiScF(tk, "font.size.code.size", 12.0, s),
    fsCodeSm: aiScF(tk, "font.size.codeSm.size", 11.0, s),
    lhXs: aiSc(tk, "font.size.xs.lineHeight", 14.0, s),
    lhSm: aiSc(tk, "font.size.sm.lineHeight", 16.0, s),
    lhMd: aiSc(tk, "font.size.md.lineHeight", 18.0, s),
    lhCode: aiSc(tk, "font.size.code.lineHeight", 18.0, s),
    lhCodeSm: aiSc(tk, "font.size.codeSm.lineHeight", 16.0, s),
    s1: aiSc(tk, "space.1", 4.0, s),
    s2: aiSc(tk, "space.2", 8.0, s),
    s3: aiSc(tk, "space.3", 12.0, s),
    s4: aiSc(tk, "space.4", 16.0, s),
    s5: aiSc(tk, "space.5", 24.0, s),
    rSm: aiSc(tk, "radius.sm", 3.0, s),
    rMd: aiSc(tk, "radius.md", 5.0, s),
    rLg: aiSc(tk, "radius.lg", 8.0, s),
    btnSm: aiSc(tk, "size.button.sm", 24.0, s),
    btnMd: aiSc(tk, "size.button.md", 28.0, s),
    btnLg: aiSc(tk, "size.button.lg", 36.0, s),
    tabBar: aiSc(tk, "size.tabBar", 32.0, s),
    row: aiSc(tk, "size.propertyRow", 28.0, s),
    field: aiSc(tk, "size.field", 24.0, s),
    iconSm: aiSc(tk, "size.icon.sm", 16.0, s),
    hairline: aiSc(tk, "border.hairline", 1.0, s),
    focusW: aiSc(tk, "border.focus", 2.0, s),
    hatchPeriod: aiSc(tk, "pattern.hatch.period", 6.0, s),
    dashOn: aiSc(tk, "pattern.dash.on", 3.0, s),
    dashOff: aiSc(tk, "pattern.dash.off", 2.0, s),
    hatchA: Math.floor(aiTokNum(tk, "opacity.hatch", 0.25) * 255.0 + 0.5) as i32,
    dChange: aiTokNum(tk, "motion.duration.changeHighlight", 600.0) / 1000.0,
    dPulse: aiTokNum(tk, "motion.duration.aiPulse", 1200.0) / 1000.0,
    dToastUndo: aiTokNum(tk, "motion.duration.toastHoldWithUndo", 8000.0) / 1000.0,
  };
}

// tokens.json を読めないときの既定（tokens.json の version 2 と同じ値）。
export function aiThemeDefault(scale: f32): AiTheme {
  return aiThemeFrom(aiTokensEmpty(), scale);
}
