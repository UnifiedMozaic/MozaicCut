// AI の提案と履歴のパネル（ui.md 3.9・3.10・14・15、mockups/ai.html）。
//
//   aiTabAi(ui, th, st, r, ev)        右の列の「AI」のタブの中身（提案のカード ／ 確かめる欄 ／ 頼む欄 ／ 空・接続なし）
//   aiTabHistory(ui, th, st, r, ev)   右の列の「履歴」のタブの中身（書き手つき・取り消し・やり直し・差分）
//   aiProblems(ui, th, st, r, ev)     左の欄の「問題」（診断の一覧。原因コード・直し方・場所へ）
//   aiPanelKeys(ui, st, ev, active)   AI のタブのキー（aiTabAi を描いた後に呼ぶ。active は AI のパネルが作業中のパネルのとき）
//   aiDrawPreview(ui, th, pv, ...)    タイムラインに重ねる斜線と札（タイムラインの部品が呼ぶ）
//   aiTopBadge(ui, th, st, r)         上の帯の「✦ AI · 提案 N」（考えている間は明滅）
//   aiDrawToast(ui, th, st, area, ev) 却下の通知（［元に戻す］つき）
//
// パネルは描いて出来事（AiEvent）を ev に積むだけで、.mzc は書かない。アプリが ops.um で適用・取り消しを行い、
// 結果を AiPanelState に返す（aiPanelApplyEvent・aiHistPush）。文言は ai_text.um の表から引く。
import {
  UkCtx, ukDrawRect, ukDrawRound, ukDrawStroke, ukDrawCircle, ukDrawTextIn, ukTextW, ukPushClip, ukPopClip, ukMouseIn,
  ukTooltip, ukId, ukFocus, ukPushLayer, ukPopLayer, ukPushClipScreen, ukWakeAt, ukDrawShadow,
  UK_KEY_UP, UK_KEY_DOWN, UK_KEY_SPACE, UK_KEY_ENTER, UK_KEY_ESC, UK_KEY_TAB, UK_KEY_CHAR, UK_MOD_CTRL, UK_MOD_ALT,
  UK_MOD_SHIFT, UK_L_TOAST,
} from "../uikit/core.um";
import { UkRect, ukRect, ukAlpha, ukShrink, ukHashI32, UK_FNV } from "../uikit/base.um";
import { ukSetNext } from "../uikit/layout.um";
import { ukTextField } from "../uikit/widgets.um";
import { ukIcon, UK_I_DOWN, UK_I_RIGHT, UK_I_PLUS } from "../uikit/icons.um";
import { AiTheme } from "./ai_theme.um";
import {
  AiPanelState, AiProposal, AiOp, AiHist, AiDiagItem, AiDiffLine, AiEvent, AiPreview, aiEv, aiSelectedCount,
  aiPendingCount, aiStrs, aiSec, aiSecSigned, aiFramesText, aiClockOf, aiDiagLoc, aiDiagCounts,
  AI_EV_REVIEW, AI_EV_APPLY, AI_EV_REJECT, AI_EV_TOGGLE_OP, AI_EV_FOCUS_OP, AI_EV_FOLLOWUP, AI_EV_ASK, AI_EV_JSON,
  AI_EV_COMPARE, AI_EV_UNDO, AI_EV_REDO, AI_EV_UNDO_TO, AI_EV_REDO_TO, AI_EV_HIST_DIFF, AI_EV_HOVER_HIST, AI_EV_JUMP,
  AI_EV_FIX, AI_EV_SHARE_REMOVE, AI_EV_SHARE_ADD, AI_EV_CONNECT, AI_EV_UNREJECT, AI_EV_SELECT_DIAG, AI_EV_SHARE_TOGGLE,
  AI_EV_FOCUS_ASK, AI_EV_STOP,
  AI_PROP_NEW, AI_PROP_REVIEW, AI_WHO_AI, AI_WHO_TEXT,
  AI_CHIP_PLAIN, AI_CHIP_OK, AI_CHIP_ERR, AI_CHIP_AI, AI_CHIP_MONO,
  AI_TOK_KEY, AI_TOK_DEL, AI_TOK_ADD, AI_TOK_NOTE,
  AI_PV_CUT, AI_PV_SET, AI_PV_OFF, AI_PV_RIPPLE, AI_PV_OK,
} from "./ai_model.um";
import {
  aiIconSparkle, aiIconWho, aiIconError, aiIconWarn, aiIconOk, aiIconUndo, aiDashRect, aiHatch, aiWrap, aiClampLines,
  aiText, aiTextBold, aiTextStrike, aiDrawChip, aiChipW, aiChipFlow, aiChipFlowH, aiKbd, aiButton, aiButtonW,
  aiCheckBox, aiCheckBoxOff, aiChipClosable, aiChipClosableW, aiArea, aiAreaF, aiAreaUnder, aiFocusRing, aiScroll, aiScrollBar,
  aiPulseK, aiKeyTakeExact, aiKeyDrop, aiKeyFind,
  AI_BTN_SECONDARY, AI_BTN_AI, AI_BTN_QUIET, AI_BTN_LINK,
} from "./ai_draw.um";
import {
  AI_T_REVIEW_TITLE, AI_T_REVIEW_BADGE, AI_T_REVIEW_BADGE_TIP, AI_T_JSON_SHOW, AI_T_JSON_HIDE, AI_T_CTX_SHOWN,
  AI_T_MORE, AI_T_LESS, AI_T_OFF, AI_T_REJECT, AI_T_FIX, AI_T_FIX_TIP, AI_T_FOLLOW_HINT, AI_T_NEED_SELECT,
  AI_T_KBD_APPLY, AI_T_KBD_ESC, AI_T_KBD_ENTER, AI_T_CARD_HEAD, AI_T_CARD_REVIEW, AI_T_CARD_REJECT, AI_T_THINKING,
  AI_T_SHARE, AI_T_ASK_HINT, AI_T_SEND, AI_T_EMPTY, AI_T_OFFLINE, AI_T_CONNECT, AI_T_UNDO_REJECT, AI_T_UNDO,
  AI_T_REDO, AI_T_KBD_UNDO, AI_T_KBD_REDO, AI_T_DIFF, AI_T_DIFF_CLOSE, AI_T_UNDO_TO, AI_T_NOW, AI_T_HIST_EMPTY,
  AI_T_PROBLEMS, AI_T_NO_PROBLEMS, AI_T_GO_SOURCE, AI_T_SHARING,
  aiTxtErrAdded, aiTxtMoved, aiTxtLength, aiTxtFoot, aiTxtApply, aiTxtCardMeta, aiTxtCount, aiTxtDiagCounts,
  aiTxtFixTo, aiTxtTopBadge, aiTxtHistAi, AI_T_OPEN_SETTINGS, AI_T_STOP, AI_T_ANSWERING,
} from "./ai_text.um";

// 入力の欄の ID（Ctrl+J でフォーカスを移すのに使う）
const AI_ASK_LABEL: string = "##aiask";
const AI_FOLLOW_LABEL: string = "##aifollow";

// ---- 右の列のタブの帯（右の列の部品ができるまでの仮。見本で使う） ----

// names のタブを描き、押されたタブの番号を返す（押されなければ cur）。badge は AI のタブの件数（0 なら出さない）。
export function aiTabBar(ui: mut UkCtx, th: AiTheme, r: UkRect, names: string[], cur: i32, badgeTab: i32, badge: i32): i32 {
  ukDrawRect(mut ui, r, th.bg2);
  ukDrawRect(mut ui, ukRect(r.x, r.y + r.h - th.hairline, r.w, th.hairline), th.line);
  let x = r.x + th.s1;
  let out = cur;
  for (let i: usize = 0; i < names.length; i++) {
    const tw = ukTextW(mut ui, names[i], th.fsSm);
    let w = tw + th.s3 * 2;
    let bw = 0;
    if ((i as i32) == badgeTab && badge > 0) {
      bw = Math.max(ukTextW(mut ui, `${badge}`, th.fsXs) + th.s2, th.s4);
      w = w + th.s1 + 2 + bw;
    }
    const tr = ukRect(x, r.y, w, r.h);
    const h = aiAreaF(mut ui, "aitab##" + names[i], tr, true);
    if (h.clicked) {
      out = i as i32;
    }
    const on = (i as i32) == cur;
    aiText(mut ui, x + th.s3, r.y, r.h, names[i], th.fsSm, on || h.hover ? th.text1 : th.text2);
    if (bw > 0) {
      const br = ukRect(x + th.s3 + tw + th.s1 + 2, r.y + (r.h - th.s4) / 2, bw, th.s4);
      ukDrawRound(mut ui, br, th.s4 / 2, th.ai);
      ukDrawTextIn(mut ui, br, `${badge}`, th.fsXs, th.textOnAi, 1);
    }
    if (on) {
      ukDrawRect(mut ui, ukRect(x + th.s2, r.y + r.h - 2 * th.hairline, w - th.s2 * 2, 2 * th.hairline), th.text1);
    }
    aiFocusRing(mut ui, th, ukShrink(tr, th.focusW + 2 * th.hairline), th.rSm, h);
    x = x + w;
  }
  return out;
}

// ---- 空の状態 ----

function aiEmpty(ui: mut UkCtx, th: AiTheme, r: UkRect, text: string): i32 {
  const lines = aiWrap(mut ui, text, th.fsMd, r.w - th.s5 * 2);
  let y = r.y + th.s5;
  for (const l of lines) {
    ukDrawTextIn(mut ui, ukRect(r.x + th.s5, y, r.w - th.s5 * 2, th.lhMd), l, th.fsMd, th.text2, 1);
    y = y + th.lhMd;
  }
  return y;
}

// ---- AI のタブ ----

export function aiTabAi(ui: mut UkCtx, th: AiTheme, st: mut AiPanelState, r: UkRect, ev: mut AiEvent[]): void {
  ukDrawRect(mut ui, r, th.bg1);
  st.trap = [];
  if (!st.connected) {
    // 相手の設定が足りなければ、何をすればよいかの 1 文と［設定を開く］（アプリは設定の AI の節を開く）
    let msg = AI_T_OFFLINE;
    let bl = AI_T_CONNECT;
    if (st.setup.length > 0) {
      msg = st.setup.clone();
      bl = AI_T_OPEN_SETTINGS;
    }
    const y = aiEmpty(mut ui, th, r, msg);
    const bw = aiButtonW(mut ui, th, bl, "", false, th.fsMd);
    if (aiButton(mut ui, th, bl + "##aiconnect", ukRect(r.x + (r.w - bw) / 2, y + th.s3, bw, th.btnMd), AI_BTN_SECONDARY,
      bl, "", false, th.fsMd)) {
      ev.push(aiEv(AI_EV_CONNECT, -1, -1, ""));
    }
    return;
  }
  if (st.review >= 0 && (st.review as usize) < st.proposals.length) {
    // 確かめる欄の中のフォーカスできる部品を覚える（aiPanelKeys が Tab をこの中で回す。ui.md 19 章）
    const f0 = ui.focusOrder.length;
    aiReview(mut ui, th, mut st, r, mut ev);
    let trap: u32[] = [];
    for (let k = f0; k < ui.focusOrder.length; k++) {
      trap.push(ui.focusOrder[k].id);
    }
    st.trap = trap;
    return;
  }
  aiCards(mut ui, th, mut st, r, mut ev);
}

// 入力の欄の Enter（ai.send は Ctrl+Enter だけ）。修飾キーのない Enter・Shift+Enter と、IME で変換中の Enter は捨てる。
// Ctrl+Enter が押されていれば true（欄には渡さない）。欄にフォーカスがないときは何もしない。
function aiFieldSend(ui: mut UkCtx, id: u32): bool {
  if (ui.focus != id || ui.layer < ui.modal) {
    return false;
  }
  const composing = ui.imeText.length > 0;
  let send = false;
  for (let i: usize = 0; i < ui.inp.keys.length; i++) {
    if (ui.inp.keys[i] != UK_KEY_ENTER) {
      continue;
    }
    const m = ui.inp.keyMods[i] & 15;
    if (m == UK_MOD_CTRL && !composing) {
      send = true;
    }
    ui.inp.keys[i] = 0;
  }
  return send;
}

// 確かめる欄（ui.md 15.2 の 4、mockups/ai.html の .rv）。
function aiReview(ui: mut UkCtx, th: AiTheme, st: mut AiPanelState, r: UkRect, ev: mut AiEvent[]): void {
  const pi = st.review;
  const pu = pi as usize;
  const padX = th.s3;
  const x = r.x + padX;
  const w = r.w - padX * 2;
  const lh = th.lhMd;
  const chipH = th.lhSm + 4;
  // ---- 下の欄の高さを先に決める（説明・［適用する］・［却下する］［修正を頼む］・直してほしい点の欄） ----
  const nSel = aiSelectedCount(st.proposals[pu]);
  const footPadY = th.s2 + 2;
  const footGap = th.s2;
  let footText = AI_T_NEED_SELECT;
  if (nSel > 0) {
    footText = aiTxtFoot(nSel);
  }
  const footLines = aiWrap(mut ui, footText, th.fsSm, w);
  const followOpen = st.followOpen;
  let footH = footPadY + (footLines.length as i32) * th.lhSm + footGap + th.btnMd + footGap + th.btnMd + footPadY;
  if (followOpen) {
    footH = footH + th.btnMd + footGap;
  }
  const fy = r.y + r.h - footH;
  // op の一覧に最低 2 行ぶんを残す。上の欄はその残りに収め、はみ出す分は切る（返事と頼みは 3 行まで）
  const minList = 2 * (lh * 2 + th.s3);
  const topMax = Math.max(fy - minList, r.y + chipH + th.s2 * 2);
  ukPushClip(mut ui, ukRect(r.x, r.y, r.w, topMax - r.y));
  // ---- 上: 見出し・頼み・返事・3 つの数 ----
  let y = r.y + th.s2;
  aiIconSparkle(mut ui, ukRect(x, y + (chipH - th.iconSm) / 2, th.iconSm, th.iconSm), th.ai);
  let cx = x + th.iconSm + th.s2;
  cx = cx + aiTextBold(mut ui, cx, y, chipH, AI_T_REVIEW_TITLE, th.fsSm, th.text1) + th.s2;
  let link = AI_T_JSON_SHOW;
  if (st.showJson) {
    link = AI_T_JSON_HIDE;
  }
  const lw = ukTextW(mut ui, link, th.fsSm);
  const bw0 = aiDrawChip(mut ui, th, cx, y, chipH, AI_CHIP_AI, AI_T_REVIEW_BADGE, th.fsSm, x + w - lw - th.s2 - cx);
  aiArea(mut ui, "aibadge", ukRect(cx, y, bw0, chipH));
  ukTooltip(mut ui, AI_T_REVIEW_BADGE_TIP);
  if (aiButton(mut ui, th, "aijson", ukRect(x + w - lw, y, lw, chipH), AI_BTN_LINK, link, "", false, th.fsSm)) {
    ev.push(aiEv(AI_EV_JSON, pi, -1, ""));
  }
  y = y + chipH + th.s1 + 2;
  // 人の頼み（吹き出し）と見せた文脈の札
  const bubMax = w * 88 / 100;
  const bubPadX = th.s2 + 2;
  const bubPadY = th.s1 + 2;
  const reqAll = aiWrap(mut ui, st.proposals[pu].request, th.fsSm, bubMax - bubPadX * 2);
  const replyAll = aiWrap(mut ui, st.proposals[pu].reply, th.fsSm, w - (th.s5 - 2) - th.s2);
  const clamped = reqAll.length > 3 || replyAll.length > 3;
  let lines = aiStrs(reqAll);
  let rl = aiStrs(replyAll);
  if (!st.expandTop) {
    lines = aiClampLines(mut ui, reqAll, 3, th.fsSm, bubMax - bubPadX * 2);
    rl = aiClampLines(mut ui, replyAll, 3, th.fsSm, w - (th.s5 - 2) - th.s2);
  }
  let textW = 0;
  for (const l of lines) {
    textW = Math.max(textW, ukTextW(mut ui, l, th.fsSm));
  }
  // 文脈の札の幅（吹き出しはこれより狭くしない）
  let ctxW = ukTextW(mut ui, AI_T_CTX_SHOWN, th.fsSm) + th.s1;
  for (const c of st.proposals[pu].context) {
    ctxW = ctxW + aiChipW(mut ui, th, c.text, th.fsXs) + th.s1;
  }
  if (st.proposals[pu].contextMore > 0) {
    ctxW = ctxW + aiChipW(mut ui, th, `＋${st.proposals[pu].contextMore}`, th.fsSm);
  }
  const ctxH = chipH;
  const bubW = Math.min(Math.max(textW, ctxW) + bubPadX * 2, bubMax);
  const bubH = bubPadY * 2 + (lines.length as i32) * lh + th.s1 + 1 + ctxH;
  const bub = ukRect(x + w - bubW, y, bubW, bubH);
  ukDrawRound(mut ui, bub, th.rLg, th.bg3);
  let by = bub.y + bubPadY;
  for (const l of lines) {
    aiText(mut ui, bub.x + bubPadX, by, lh, l, th.fsSm, th.text1);
    by = by + lh;
  }
  by = by + th.s1 + 1;
  let bx = bub.x + bubPadX;
  // bg.3 の上なので text.3 ではなく text.2（tokens の text.note）
  bx = bx + aiText(mut ui, bx, by, ctxH, AI_T_CTX_SHOWN, th.fsSm, th.text2) + th.s1;
  for (const c of st.proposals[pu].context) {
    bx = bx + aiDrawChip(mut ui, th, bx, by, ctxH, AI_CHIP_MONO, c.text, th.fsXs, bub.x + bub.w - bx) + th.s1;
  }
  if (st.proposals[pu].contextMore > 0) {
    aiDrawChip(mut ui, th, bx, by, ctxH, AI_CHIP_PLAIN, `＋${st.proposals[pu].contextMore}`, th.fsSm, bub.x + bub.w - bx);
  }
  y = y + bubH + th.s1 + 2;
  // AI の返事
  const av = th.s5 - 2;
  ukDrawCircle(mut ui, (x + av / 2) as f32, (y + av / 2) as f32, (av / 2) as f32, 0.0, th.aiTint);
  aiIconSparkle(mut ui, ukRect(x + (av - th.s3) / 2, y + (av - th.s3) / 2, th.s3, th.s3), th.ai);
  let ry = y + (av - lh) / 2;
  for (const l of rl) {
    aiText(mut ui, x + av + th.s2, ry, lh, l, th.fsSm, th.text1);
    ry = ry + lh;
  }
  if (clamped) {
    let mt = AI_T_MORE;
    if (st.expandTop) {
      mt = AI_T_LESS;
    }
    const mw = ukTextW(mut ui, mt, th.fsSm);
    if (aiButton(mut ui, th, "aimore", ukRect(x + av + th.s2, ry, mw, th.lhSm), AI_BTN_LINK, mt, "", false, th.fsSm)) {
      st.expandTop = !st.expandTop;
    }
    ry = ry + th.lhSm;
  }
  y = Math.max(y + av, ry) + th.s1 + 2;
  // 3 つの数（選び直すとその場で作り直す。aiRecomputeSummary）
  const ed = st.proposals[pu].errDelta;
  const ld = st.proposals[pu].lengthDelta;
  const kinds: i32[] = [ed > 0 ? AI_CHIP_ERR : AI_CHIP_OK, AI_CHIP_PLAIN, AI_CHIP_PLAIN];
  const texts: string[] = [aiTxtErrAdded(ed), aiTxtMoved(st.proposals[pu].moved),
    aiTxtLength(aiSecSigned(ld, 2), aiFramesText(Math.abs(ld), st.fps))];
  y = y + aiChipFlow(mut ui, th, x, y, w, chipH, kinds, texts, th.fsSm);
  if (st.proposals[pu].recomputed.length > 0) {
    y = y + th.s1;
    y = y + aiChipFlow(mut ui, th, x, y, w, chipH, [AI_CHIP_AI], [st.proposals[pu].recomputed.clone()], th.fsSm);
  }
  y = y + th.s2;
  ukPopClip(mut ui);
  y = Math.min(y, topMax);
  ukDrawRect(mut ui, ukRect(r.x, y, r.w, th.hairline), th.line);
  y = y + th.hairline;
  // ---- 中: op の一覧（スクロール） ----
  const listR = ukRect(r.x, y, r.w, Math.max(fy - y, 0));
  const nOps = st.proposals[pu].ops.length;
  // ↑↓ でフォーカスした op が見えるところへ寄せる（前のフレームに測った行の位置で）
  if (st.followOp && st.focusOp >= 0 && (st.focusOp as usize) < st.opTops.length) {
    const t = st.opTops[st.focusOp as usize];
    const hh = st.opHs[st.focusOp as usize];
    let want = st.scrollOps;
    if (t < want || hh > listR.h) {
      want = t;
    } else if (t + hh > want + listR.h) {
      want = t + hh - listR.h;
    }
    // 前のフレームの中身の高さで収める（届かない所を目指して止まらなくならないように）
    const last = st.opTops.length - 1;
    const maxScroll = Math.max(st.opTops[last] + st.opHs[last] + (th.s1 + 2) * 2 - listR.h, 0);
    want = Math.max(Math.min(want, maxScroll), 0);
    if (want == st.scrollOps) {
      // 見えている（差分が開いて高さが変わる次のフレームまで寄せ続け、見えたら止める）
      st.followOp = false;
    } else {
      st.scrollOps = want;
    }
  }
  ukPushClip(mut ui, listR);
  const pad0 = th.s1 + 2;
  let oy = listR.y + pad0 - st.scrollOps;
  let tops: i32[] = [];
  let hs: i32[] = [];
  const focusOp = st.focusOp;
  const json = st.showJson;
  for (let i: usize = 0; i < nOps; i++) {
    const isFocus = focusOp == (i as i32);
    const oh = aiOpRow(mut ui, th, mut st.proposals[pu].ops[i], i as i32, pi, isFocus, json, r.x, oy, r.w, listR, mut ev);
    tops.push(oy - listR.y + st.scrollOps);
    hs.push(oh);
    oy = oy + oh;
  }
  st.opTops = tops;
  st.opHs = hs;
  const contentH = oy + st.scrollOps - listR.y + pad0;
  ukPopClip(mut ui);
  st.scrollOps = aiScroll(mut ui, listR, st.scrollOps, contentH, th.lhMd * 3);
  aiScrollBar(mut ui, th, listR, st.scrollOps, contentH);
  // ---- 下の欄 ----
  ukDrawRect(mut ui, ukRect(r.x, fy, r.w, th.hairline), th.line);
  let yy = fy + footPadY;
  for (const l of footLines) {
    aiText(mut ui, x, yy, th.lhSm, l, th.fsSm, th.text2);
    yy = yy + th.lhSm;
  }
  yy = yy + footGap;
  // 1 段目: ［選んだ N 個を適用する Ctrl Enter］（全幅）。選んでいなければ押せない（理由は上の文）
  if (nSel == 0) {
    ukDrawRound(mut ui, ukRect(x, yy, w, th.btnMd), th.rMd, th.bg3);
    ukDrawTextIn(mut ui, ukRect(x, yy, w, th.btnMd), aiTxtApply(0), th.fsMd, th.textDis, 1);
  } else if (aiButton(mut ui, th, "aiapply", ukRect(x, yy, w, th.btnMd), AI_BTN_AI, aiTxtApply(nSel), AI_T_KBD_APPLY, false, th.fsMd)) {
    ev.push(aiEv(AI_EV_APPLY, pi, -1, ""));
  }
  yy = yy + th.btnMd + footGap;
  // 2 段目: ［却下する Esc］（伸びる）と［✦ 修正を頼む］
  const fixW = aiButtonW(mut ui, th, AI_T_FIX, "", true, th.fsMd);
  const rejW = w - fixW - th.s2;
  if (aiButton(mut ui, th, "aireject", ukRect(x, yy, rejW, th.btnMd), AI_BTN_SECONDARY, AI_T_REJECT, AI_T_KBD_ESC, false, th.fsMd)) {
    ev.push(aiEv(AI_EV_REJECT, pi, -1, ""));
  }
  if (aiButton(mut ui, th, "aifix", ukRect(x + rejW + th.s2, yy, fixW, th.btnMd), AI_BTN_SECONDARY, AI_T_FIX, "", true, th.fsMd)) {
    st.followOpen = !followOpen;
    if (st.followOpen) {
      ukFocus(mut ui, ukId(ui, AI_T_FOLLOW_HINT + AI_FOLLOW_LABEL), ui.focusVisible);
    }
  }
  ukTooltip(mut ui, AI_T_FIX_TIP);
  yy = yy + th.btnMd + footGap;
  if (followOpen) {
    const label = AI_T_FOLLOW_HINT + AI_FOLLOW_LABEL;
    const send = aiFieldSend(mut ui, ukId(ui, label));
    ukSetNext(mut ui, ukRect(x, yy, w, th.btnMd));
    const nf = ukTextField(mut ui, label, st.follow);
    if (send && nf.length > 0) {
      ev.push(aiEv(AI_EV_FOLLOWUP, pi, -1, nf));
      st.follow = "";
    } else {
      st.follow = nf;
    }
  }
}

// op の 1 文の折り返し（幅と大きさが変わったときだけ測り直す）。
function aiOpLines(ui: mut UkCtx, o: mut AiOp, size: f32, w: i32): string[] {
  if (o.wrapW != w || o.wrapSize != size) {
    let s = o.desc.clone();
    if (o.tc.length > 0) {
      s = o.tc + " " + o.desc;
    }
    o.descLines = aiWrap(mut ui, s, size, w);
    o.wrapW = w;
    o.wrapSize = size;
  }
  return aiStrs(o.descLines);
}

// op の 1 項目（ui.md 15.2 の 4 の「中」、mockups/ai.html の .op）。描いた高さを返す。
function aiOpRow(
  ui: mut UkCtx, th: AiTheme, o: mut AiOp, i: i32, pi: i32, focus: bool, json: bool, x0: i32, y0: i32, w0: i32,
  clipR: UkRect, ev: mut AiEvent[],
): i32 {
  const padX = th.s3;
  const padY = th.s1 + 2;
  const chkW = th.s4;
  const noW = th.s4 + 2;
  const gap = th.s2;
  const tx = x0 + padX + chkW + gap + noW + gap;
  const tw = w0 - (tx - x0) - padX;
  const lh = th.lhMd;
  const stale = o.stale.length > 0;
  const off = !o.on && !stale;
  // 高さを先に測る（1 文の折り返しは覚えておく）
  const dl = aiOpLines(mut ui, mut o, th.fsSm, tw);
  let opLines: string[] = [];
  if (json) {
    if (o.json.length > 0) {
      opLines = aiWrap(mut ui, o.json, th.fsCode, tw);
    } else {
      opLines = aiWrap(mut ui, o.op, th.fsCode, tw);
    }
  } else {
    opLines = [o.op.clone()];
  }
  let h = padY + (dl.length as i32) * lh + (opLines.length as i32) * lh;
  // 札: 人が外した op は「外した」を先頭に、当てはまらなくなった op は理由を先頭に
  let kinds: i32[] = [];
  let texts: string[] = [];
  if (stale) {
    kinds.push(AI_CHIP_PLAIN);
    texts.push(o.stale.clone());
  } else if (off) {
    kinds.push(AI_CHIP_PLAIN);
    texts.push(AI_T_OFF);
  }
  for (const c of o.chips) {
    kinds.push(c.kind);
    texts.push(c.text.clone());
  }
  const chipH = th.lhSm + 4;
  let chipsH = 0;
  if (texts.length > 0) {
    chipsH = th.s1 + aiChipFlowH(mut ui, th, tw, chipH, kinds, texts, th.fsSm);
  }
  let diffH = 0;
  if (focus && !json && o.diff.length > 0) {
    diffH = th.s1 + 2 + th.s2 * 2 + aiDiffH(mut ui, th, o.diff, tw - th.s2 * 2);
  }
  h = h + chipsH + diffH + padY;
  const rr = ukRect(x0, y0, w0, h);
  // 見えていなければ描かない
  if (rr.y + rr.h < clipR.y || rr.y > clipR.y + clipR.h) {
    return h;
  }
  // 地（ホバーはマウスの位置だけで決める。押すのは中のチェックが先）
  if (focus) {
    ukDrawRect(mut ui, rr, th.aiTint);
    ukDrawRect(mut ui, ukRect(rr.x, rr.y, 2 * th.hairline, rr.h), o.bad ? th.error : th.ai);
  } else if (o.bad) {
    ukDrawRect(mut ui, ukRect(rr.x, rr.y, 2 * th.hairline, rr.h), th.error);
  } else if (ukMouseIn(ui, aiIntersectY(rr, clipR))) {
    ukDrawRect(mut ui, rr, ukAlpha(th.bg3, 160));
  }
  // チェックと番号
  const cs = th.s3 + 2;
  const cr = ukRect(x0 + padX + (chkW - cs) / 2, y0 + padY + (lh - cs) / 2, cs, cs);
  if (!stale) {
    if (aiCheckBox(mut ui, th, `aichk##${i}`, cr, o.on)) {
      ev.push(aiEv(AI_EV_TOGGLE_OP, pi, i, ""));
    }
  } else {
    aiCheckBoxOff(mut ui, th, cr);
  }
  // 行（Tab で選べる。Space は aiPanelKeys が op の切り替えに使うので、ここでは取らない）
  const hit = aiAreaUnder(mut ui, `aiop##${i}`, aiIntersectY(rr, clipR), false);
  if (hit.clicked || (hit.focused && !focus)) {
    ev.push(aiEv(AI_EV_FOCUS_OP, pi, i, ""));
  }
  aiText(mut ui, x0 + padX + chkW + gap, y0 + padY, lh, `${i + 1}`, th.fsXs, th.text2);
  // 1 文: 外した op は text.2 と取り消し線、当てはまらない op は text.3、誤りは赤
  let y = y0 + padY;
  let dc = th.text1;
  if (stale) {
    dc = th.text3;
  } else if (o.bad) {
    dc = th.error;
  } else if (off) {
    dc = th.text2;
  }
  for (const l of dl) {
    if (off) {
      aiTextStrike(mut ui, tx, y, lh, l, th.fsSm, dc, th.hairline);
    } else {
      aiText(mut ui, tx, y, lh, l, th.fsSm, dc);
    }
    y = y + lh;
  }
  // op の文: text.2（外した・当てはまらない op は text.3）
  const oc = (off || stale) ? th.text3 : th.text2;
  for (const l of opLines) {
    const ow = aiText(mut ui, tx, y, lh, l, th.fsCode, oc);
    if (!json && o.note.length > 0) {
      aiText(mut ui, tx + ow + th.s2, y, lh, o.note, th.fsSm, oc);
    }
    y = y + lh;
  }
  if (texts.length > 0) {
    y = y + th.s1;
    y = y + aiChipFlow(mut ui, th, tx, y, tw, chipH, kinds, texts, th.fsSm);
  }
  if (diffH > 0) {
    y = y + th.s1 + 2;
    aiDiffBlock(mut ui, th, o.diff, ukRect(tx, y, tw, diffH - th.s1 - 2));
  }
  aiFocusRing(mut ui, th, ukShrink(aiIntersectY(rr, clipR), th.focusW + 2 * th.hairline), th.rSm, hit);
  return h;
}

// a の上下を b の中に切り詰める（左右はそのまま）。
function aiIntersectY(a: UkRect, b: UkRect): UkRect {
  const y0 = Math.max(a.y, b.y);
  const y1 = Math.min(a.y + a.h, b.y + b.h);
  return ukRect(a.x, y0, a.w, Math.max(y1 - y0, 0));
}

// ---- 差分の箱（.mzc の行。変わったトークンだけ緑・赤） ----

function aiDiffLineCount(ui: mut UkCtx, th: AiTheme, d: AiDiffLine, maxW: i32): i32 {
  let x = 0;
  let rows = 1;
  for (const t of d.toks) {
    const tw = ukTextW(mut ui, t.text, th.fsCodeSm);
    if (x > 0 && x + tw > maxW) {
      x = 0;
      rows++;
    }
    x = x + tw + ukTextW(mut ui, " ", th.fsCodeSm);
  }
  return rows;
}

function aiDiffH(ui: mut UkCtx, th: AiTheme, diff: AiDiffLine[], maxW: i32): i32 {
  let n = 0;
  for (const d of diff) {
    n = n + aiDiffLineCount(mut ui, th, d, maxW);
  }
  return n * th.lhCodeSm;
}

export function aiDiffBlock(ui: mut UkCtx, th: AiTheme, diff: AiDiffLine[], r: UkRect): void {
  ukDrawRound(mut ui, r, th.rSm, th.bg0);
  ukDrawStroke(mut ui, r, th.rSm, th.hairline, th.line);
  const pad = th.s2;
  const maxW = r.w - pad * 2;
  const sp = ukTextW(mut ui, " ", th.fsCodeSm);
  const lh = th.lhCodeSm;
  let y = r.y + pad;
  for (const d of diff) {
    let x = 0;
    for (const t of d.toks) {
      const tw = ukTextW(mut ui, t.text, th.fsCodeSm);
      if (x > 0 && x + tw > maxW) {
        x = 0;
        y = y + lh;
      }
      const px = r.x + pad + x;
      // key=value は key の部分をキーの色に
      let fg = th.text2;
      if (t.kind == AI_TOK_NOTE) {
        fg = th.text3;
      } else if (t.kind == AI_TOK_DEL) {
        fg = th.error;
        ukDrawRect(mut ui, ukRect(px, y + 1, tw, lh - 2), th.errorTint);
      } else if (t.kind == AI_TOK_ADD) {
        fg = th.ok;
        ukDrawRect(mut ui, ukRect(px, y + 1, tw, lh - 2), th.okTint);
      }
      const eq = aiEqAt(t.text);
      if (t.kind != AI_TOK_NOTE && t.kind != AI_TOK_DEL && t.kind != AI_TOK_ADD && eq > 0) {
        const k = aiSub(t.text, 0, eq);
        const kw = aiText(mut ui, px, y, lh, k, th.fsCodeSm, th.accentHover);
        aiText(mut ui, px + kw, y, lh, aiSub(t.text, eq, t.text.length), th.fsCodeSm, fg);
      } else if (t.kind == AI_TOK_DEL) {
        aiTextStrike(mut ui, px, y, lh, t.text, th.fsCodeSm, fg, th.hairline);
      } else {
        aiText(mut ui, px, y, lh, t.text, th.fsCodeSm, fg);
      }
      x = x + tw + sp;
    }
    y = y + lh;
  }
}

function aiEqAt(s: string): usize {
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 61) {
      return i;
    }
  }
  return 0;
}

function aiSub(s: string, a: usize, b: usize): string {
  let out: u8[] = [];
  for (let i = a; i < b && i < s.length; i++) {
    out.push(s[i]);
  }
  return stringFromBytes(out);
}

// ---- 提案のカードと頼む欄 ----

function aiCards(ui: mut UkCtx, th: AiTheme, st: mut AiPanelState, r: UkRect, ev: mut AiEvent[]): void {
  const padX = th.s3;
  const x = r.x + padX;
  const w = r.w - padX * 2;
  // 下: 頼む欄（AI に見せる札・入力・送る）。札は折り返して全部見せる（ui.md 15.1「何を見せているかを、いつも見せる」）
  const chipH = th.lhSm + 6;
  let rows = 1;
  let mx = 0;
  for (let i: usize = 0; i < st.share.length; i++) {
    const cw = aiChipClosableW(mut ui, th, st.share[i].text, th.fsSm, chipH);
    if (mx > 0 && mx + cw > w) {
      mx = 0;
      rows++;
    }
    mx = mx + cw + th.s1;
  }
  if (mx > 0 && mx + chipH > w) {
    rows++;
  }
  const chipsH = rows * chipH + (rows - 1) * th.s1;
  // いちばん下: この会話と今月の使った量・目安の注意（ある時だけ）
  let costLines: string[] = [];
  for (const part of aiCostParts(st.costTotal)) {
    for (const l of aiWrap(mut ui, part, th.fsXs, w)) {
      costLines.push(l.clone());
    }
  }
  const noteLines = aiWrap(mut ui, st.costNote, th.fsXs, w);
  let costH = 0;
  if (costLines.length > 0) {
    costH = ((costLines.length + noteLines.length) as i32) * th.lhSm + th.s1;
  }
  const askH = th.s2 + th.lhSm + th.s1 + chipsH + th.s2 + th.btnMd + th.s3 + costH;
  const ay = r.y + r.h - askH;
  // 上: カードの一覧
  const listR = ukRect(r.x, r.y, r.w, Math.max(ay - r.y, 0));
  ukPushClip(mut ui, listR);
  let y = r.y + th.s3 - st.scrollCards;
  let shown = 0;
  if (st.chatReq.length > 0) {
    y = y + aiChat(mut ui, th, st, x, y, w, mut ev) + th.s2;
  }
  for (let i: usize = 0; i < st.proposals.length; i++) {
    if (st.proposals[i].state != AI_PROP_NEW && st.proposals[i].state != AI_PROP_REVIEW) {
      continue;
    }
    y = y + aiCard(mut ui, th, st.proposals[i], i as i32, x, y, w, mut ev) + th.s2;
    shown++;
  }
  if (st.thinking) {
    // 考えている: 点がゆっくり明滅する（周期は tokens の aiPulse。動きを減らすときは止める）
    const k = aiPulseK(ui.now - st.thinkingSince, th.dPulse, st.reduceMotion);
    const a = 90 + (Math.floor(k * 165.0) as i32);
    const rowH = th.lhMd + th.s2;
    ukDrawCircle(mut ui, (x + th.s1 + 1) as f32, (y + rowH / 2) as f32, (th.s1 - 1) as f32, 0.0, ukAlpha(th.ai, a));
    let tk = AI_T_ANSWERING;
    if (st.chatReply.length > 0 || shown > 0) {
      tk = AI_T_THINKING;
    }
    aiText(mut ui, x + th.s3 + 2, y, rowH, tk, th.fsMd, th.ai);
    y = y + rowH;
    if (!st.reduceMotion && th.dPulse > 0.0) {
      ui.wantFrame = true;
    }
  } else if (shown == 0 && st.chatReq.length == 0) {
    y = aiEmpty(mut ui, th, ukRect(r.x, y, r.w, 0), AI_T_EMPTY);
  }
  const contentH = y + st.scrollCards - r.y + th.s3;
  ukPopClip(mut ui);
  if (st.chatFollow) {
    // 流れてくる返事: 一覧の終わりが見えるところまで寄せる
    st.scrollCards = Math.max(contentH - listR.h, 0);
    st.chatFollow = false;
  }
  st.scrollCards = aiScroll(mut ui, listR, st.scrollCards, contentH, th.lhMd * 3);
  aiScrollBar(mut ui, th, listR, st.scrollCards, contentH);
  // 頼む欄
  ukDrawRect(mut ui, ukRect(r.x, ay, r.w, th.hairline), th.line);
  let yy = ay + th.s2;
  aiText(mut ui, x, yy, th.lhSm, AI_T_SHARE, th.fsSm, th.text3);
  yy = yy + th.lhSm + th.s1;
  let cx = x;
  let cy = yy;
  for (let i: usize = 0; i < st.share.length; i++) {
    const cw = aiChipClosableW(mut ui, th, st.share[i].text, th.fsSm, chipH);
    if (cx > x && cx + cw > x + w) {
      cx = x;
      cy = cy + chipH + th.s1;
    }
    if (aiChipClosable(mut ui, th, `aishare##${i}`, cx, cy, chipH, st.share[i].text, th.fsSm)) {
      ev.push(aiEv(AI_EV_SHARE_REMOVE, -1, i as i32, ""));
    }
    cx = cx + cw + th.s1;
  }
  if (cx > x && cx + chipH > x + w) {
    cx = x;
    cy = cy + chipH + th.s1;
  }
  const plus = ukRect(cx, cy, chipH, chipH);
  const ph = aiAreaF(mut ui, "aishareadd", plus, true);
  ukDrawStroke(mut ui, plus, th.rSm, th.hairline, ph.hover ? th.text2 : th.lineControl);
  ukIcon(mut ui, ukShrink(plus, 4), UK_I_PLUS, ph.hover ? th.text1 : th.text2);
  aiFocusRing(mut ui, th, plus, th.rSm, ph);
  if (ph.clicked) {
    ev.push(aiEv(AI_EV_SHARE_ADD, -1, -1, ""));
  }
  yy = yy + chipsH + th.s2;
  let sendW = aiButtonW(mut ui, th, AI_T_SEND, AI_T_KBD_APPLY, false, th.fsMd);
  if (st.busy) {
    sendW = Math.max(sendW, aiButtonW(mut ui, th, AI_T_STOP, "", false, th.fsMd));
  }
  const label = AI_T_ASK_HINT + AI_ASK_LABEL;
  const askId = ukId(ui, label);
  if (st.focusAsk) {
    // Ctrl+J（ai.focus）: 頼む欄へ移り、輪を見せる
    ukFocus(mut ui, askId, true);
    st.focusAsk = false;
  }
  let send = aiFieldSend(mut ui, askId);
  ukSetNext(mut ui, ukRect(x, yy, w - sendW - th.s2, th.btnMd));
  const na = ukTextField(mut ui, label, st.ask);
  if (st.busy) {
    // 返事を待っている間は［止める］（送れない。打った頼みは欄に残す）
    send = false;
    if (aiButton(mut ui, th, "aistop", ukRect(x + w - sendW, yy, sendW, th.btnMd), AI_BTN_SECONDARY, AI_T_STOP, "", false, th.fsMd)) {
      ev.push(aiEv(AI_EV_STOP, -1, -1, ""));
    }
  } else if (aiButton(mut ui, th, "aisend", ukRect(x + w - sendW, yy, sendW, th.btnMd), AI_BTN_SECONDARY, AI_T_SEND, AI_T_KBD_APPLY, false, th.fsMd)) {
    send = true;
  }
  if (send && na.length > 0) {
    ev.push(aiEv(AI_EV_ASK, -1, -1, na));
    st.ask = "";
  } else {
    st.ask = na;
  }
  if (costLines.length > 0) {
    let ly = yy + th.btnMd + th.s1;
    for (const l of costLines) {
      aiText(mut ui, x, ly, th.lhSm, l, th.fsXs, th.text2);
      ly = ly + th.lhSm;
    }
    for (const l of noteLines) {
      aiText(mut ui, x, ly, th.lhSm, l, th.fsXs, th.text3);
      ly = ly + th.lhSm;
    }
  }
}

// 使った量の合計の文を改行で分ける。
function aiCostParts(s: string): string[] {
  let out: string[] = [];
  let cur: u8[] = [];
  for (const b of s) {
    if (b == 10) {
      out.push(stringFromBytes(cur));
      cur = [];
    } else {
      cur.push(b);
    }
  }
  if (cur.length > 0) {
    out.push(stringFromBytes(cur));
  }
  return out;
}

// 今の頼みのやりとり: 人の頼みの吹き出し・AI の返事（流れてくる分）・ツールの 1 文・誤り。高さを返す。
function aiChat(ui: mut UkCtx, th: AiTheme, st: AiPanelState, x: i32, y0: i32, w: i32, ev: mut AiEvent[]): i32 {
  const lh = th.lhMd;
  let y = y0;
  // 人の頼み（右寄せの吹き出し）
  const bubMax = w * 88 / 100;
  const padX = th.s2 + 2;
  const padY = th.s1 + 2;
  const req = aiWrap(mut ui, st.chatReq, th.fsSm, bubMax - padX * 2);
  let tw = 0;
  for (const l of req) {
    tw = Math.max(tw, ukTextW(mut ui, l, th.fsSm));
  }
  const bw = Math.min(tw + padX * 2, bubMax);
  const bh = padY * 2 + (req.length as i32) * lh;
  const bub = ukRect(x + w - bw, y, bw, bh);
  ukDrawRound(mut ui, bub, th.rLg, th.bg3);
  let by = bub.y + padY;
  for (const l of req) {
    aiText(mut ui, bub.x + padX, by, lh, l, th.fsSm, th.text1);
    by = by + lh;
  }
  y = y + bh + th.s2;
  // AI の返事（印と、折り返した文）
  const av = th.s5 - 2;
  const tx = x + av + th.s2;
  const tww = w - av - th.s2;
  if (st.chatReply.length > 0 || st.chatNotes.length > 0) {
    ukDrawCircle(mut ui, (x + av / 2) as f32, (y + av / 2) as f32, (av / 2) as f32, 0.0, th.aiTint);
    aiIconSparkle(mut ui, ukRect(x + (av - th.s3) / 2, y + (av - th.s3) / 2, th.s3, th.s3), th.ai);
    let ry = y + (av - lh) / 2;
    for (const n of st.chatNotes) {
      for (const l of aiWrap(mut ui, n, th.fsXs, tww)) {
        aiText(mut ui, tx, ry, th.lhSm, l, th.fsXs, th.text2);
        ry = ry + th.lhSm;
      }
    }
    for (const l of aiWrap(mut ui, st.chatReply, th.fsSm, tww)) {
      aiText(mut ui, tx, ry, lh, l, th.fsSm, th.text1);
      ry = ry + lh;
    }
    // この頼みの使った量（小さく）
    if (st.chatCost.length > 0 && !st.busy) {
      for (const l of aiWrap(mut ui, st.chatCost, th.fsXs, tww)) {
        aiText(mut ui, tx, ry, th.lhSm, l, th.fsXs, th.text3);
        ry = ry + th.lhSm;
      }
    }
    y = Math.max(y + av, ry) + th.s1;
  }
  // 誤り（赤と［設定を開く］）・断られた（黄）
  if (st.chatErr.length > 0) {
    const c = st.chatWarn ? th.warn : th.error;
    for (const l of aiWrap(mut ui, st.chatErr, th.fsSm, w)) {
      aiText(mut ui, x, y, lh, l, th.fsSm, c);
      y = y + lh;
    }
    if (!st.chatWarn) {
      y = y + th.s1;
      const sw = aiButtonW(mut ui, th, AI_T_OPEN_SETTINGS, "", false, th.fsMd);
      if (aiButton(mut ui, th, "aichatsettings", ukRect(x, y, sw, th.btnMd), AI_BTN_SECONDARY, AI_T_OPEN_SETTINGS, "", false, th.fsMd)) {
        ev.push(aiEv(AI_EV_CONNECT, -1, -1, ""));
      }
      y = y + th.btnMd;
    }
  }
  return y - y0;
}

// 提案のカード（ui.md 15.2 の 3）。高さを返す。
function aiCard(ui: mut UkCtx, th: AiTheme, p: AiProposal, i: i32, x: i32, y: i32, w: i32, ev: mut AiEvent[]): i32 {
  const pad = th.s3;
  const iw = w - pad * 2;
  const sl = aiWrap(mut ui, p.summary, th.fsMd, iw);
  const lh = th.lhMd;
  const chipH = th.lhSm + 4;
  let h = pad + th.lhSm + th.s2 + (sl.length as i32) * lh + th.s1 + th.lhSm + th.s3 + th.btnMd + pad;
  if (p.recomputed.length > 0) {
    h = h + chipH + th.s2;
  }
  const r = ukRect(x, y, w, h);
  ukDrawRound(mut ui, r, th.rLg, th.bg2);
  ukDrawStroke(mut ui, r, th.rLg, th.hairline, th.ai);
  let yy = y + pad;
  aiIconSparkle(mut ui, ukRect(x + pad, yy, th.iconSm, th.iconSm), th.ai);
  aiText(mut ui, x + pad + th.iconSm + th.s1 + 2, yy, th.lhSm, AI_T_CARD_HEAD, th.fsSm, th.ai);
  yy = yy + th.lhSm + th.s2;
  for (const l of sl) {
    aiText(mut ui, x + pad, yy, lh, l, th.fsMd, th.text1);
    yy = yy + lh;
  }
  yy = yy + th.s1;
  aiText(mut ui, x + pad, yy, th.lhSm, aiTxtCardMeta(p.ops.length as i32, p.moved, p.errDelta), th.fsSm, p.errDelta > 0 ? th.error : th.text2);
  yy = yy + th.lhSm + th.s3;
  if (p.recomputed.length > 0) {
    aiDrawChip(mut ui, th, x + pad, yy - th.s1, chipH, AI_CHIP_AI, p.recomputed, th.fsSm, iw);
    yy = yy + chipH + th.s2;
  }
  const rvW = aiButtonW(mut ui, th, AI_T_CARD_REVIEW, AI_T_KBD_ENTER, false, th.fsMd);
  if (aiButton(mut ui, th, `aireview##${i}`, ukRect(x + pad, yy, rvW, th.btnMd), AI_BTN_AI, AI_T_CARD_REVIEW, AI_T_KBD_ENTER, false, th.fsMd)) {
    ev.push(aiEv(AI_EV_REVIEW, i, -1, ""));
  }
  const rjW = aiButtonW(mut ui, th, AI_T_CARD_REJECT, "", false, th.fsMd);
  if (aiButton(mut ui, th, `aicardreject##${i}`, ukRect(x + pad + rvW + th.s2, yy, rjW, th.btnMd), AI_BTN_SECONDARY, AI_T_CARD_REJECT, "", false, th.fsMd)) {
    ev.push(aiEv(AI_EV_REJECT, i, -1, ""));
  }
  return h;
}

// ---- 履歴のタブ（ui.md 14.2） ----

// 履歴の 1 文（AI の提案を適用した行は「AI の提案（N 操作）· あなたが適用」）。
function aiHistDesc(h: AiHist): string {
  if (h.who == AI_WHO_AI && h.applied && h.desc.length == 0) {
    return aiTxtHistAi(h.ops.length as i32);
  }
  return h.desc.clone();
}

function aiHistLines(ui: mut UkCtx, h: mut AiHist, size: f32, w: i32): string[] {
  if (h.wrapW != w || h.wrapSize != size) {
    h.descLines = aiWrap(mut ui, aiHistDesc(h), size, w);
    h.wrapW = w;
    h.wrapSize = size;
  }
  return aiStrs(h.descLines);
}

// 履歴の 1 行の配置（高さを測るのと描くのとで同じ値を使う）。
struct AiHistGeo {
  tx: i32;
  tw: i32;
  timeW: i32;
  isAi: bool;
}

function aiHistGeo(ui: mut UkCtx, th: AiTheme, h: AiHist, x0: i32, w0: i32): AiHistGeo {
  const padX = th.s3;
  const tx = x0 + padX + th.iconSm + th.s2;
  const timeW = ukTextW(mut ui, "00:00", th.fsXs) + th.s2;
  const isAi = h.who == AI_WHO_AI && h.ops.length > 1;
  return { tx, tw: w0 - (tx - x0) - padX - timeW - (isAi ? th.iconSm : 0), timeW, isAi };
}

// 履歴の 1 行の高さ（折り返しは行に覚えておくので、幅が変わらなければ文字を測らない）。
function aiHistRowH(ui: mut UkCtx, th: AiTheme, h: mut AiHist, diffOpen: bool, x0: i32, w0: i32): i32 {
  const g = aiHistGeo(mut ui, th, h, x0, w0);
  const dl = aiHistLines(mut ui, mut h, th.fsMd, g.tw);
  const padY = th.s1 + 2;
  let hh = padY + (dl.length as i32) * th.lhMd;
  if (h.ops.length > 0 && !g.isAi) {
    hh = hh + th.lhCodeSm;
  }
  if (g.isAi && h.open) {
    hh = hh + (h.ops.length as i32) * th.lhCodeSm;
  }
  hh = hh + th.s1 + th.lhSm + 4;
  if (diffOpen && h.changes.length > 0) {
    hh = hh + th.s1 + th.s2 * 2 + aiDiffH(mut ui, th, h.changes, w0 - (g.tx - x0) - th.s3 - th.s2 * 2);
  }
  return hh + padY;
}

export function aiTabHistory(ui: mut UkCtx, th: AiTheme, st: mut AiPanelState, r: UkRect, ev: mut AiEvent[]): void {
  ukDrawRect(mut ui, r, th.bg1);
  const padX = th.s3;
  const x = r.x + padX;
  const w = r.w - padX * 2;
  // 上の帯: 取り消す・やり直す
  const barH = th.btnMd + th.s2 * 2;
  const by = r.y + th.s2;
  const uw = aiButtonW(mut ui, th, AI_T_UNDO, AI_T_KBD_UNDO, true, th.fsSm);
  const canUndo = st.histPos > 0;
  const canRedo = (st.histPos as usize) < st.history.length;
  if (aiHistBtn(mut ui, th, "aiundo", ukRect(x, by, uw, th.btnMd), AI_T_UNDO, AI_T_KBD_UNDO, false, canUndo)) {
    ev.push(aiEv(AI_EV_UNDO, -1, -1, ""));
  }
  const rw = aiButtonW(mut ui, th, AI_T_REDO, AI_T_KBD_REDO, true, th.fsSm);
  if (aiHistBtn(mut ui, th, "airedo", ukRect(x + uw + th.s1, by, rw, th.btnMd), AI_T_REDO, AI_T_KBD_REDO, true, canRedo)) {
    ev.push(aiEv(AI_EV_REDO, -1, -1, ""));
  }
  ukDrawTextIn(mut ui, ukRect(x, by, w, th.btnMd), aiTxtCount(st.history.length as i32), th.fsSm, th.text3, 2);
  ukDrawRect(mut ui, ukRect(r.x, r.y + barH - th.hairline, r.w, th.hairline), th.line);
  const listR = ukRect(r.x, r.y + barH, r.w, r.h - barH);
  if (st.history.length == 0) {
    aiEmpty(mut ui, th, listR, AI_T_HIST_EMPTY);
    return;
  }
  // 行の上の端を作る（幅・件数・いまの位置・開いている行が変わったときだけ。折り返しは行に覚えてある）
  const nowH = th.lhSm + 4;
  let key = ukHashI32(UK_FNV, r.w);
  key = ukHashI32(key, Math.floor(th.scale * 100.0) as i32);
  key = ukHashI32(key, st.history.length as i32);
  key = ukHashI32(key, st.histPos);
  key = ukHashI32(key, st.histDiff);
  for (let i: usize = 0; i < st.history.length; i++) {
    if (st.history[i].open) {
      key = ukHashI32(key, i as i32);
    }
  }
  if (key != st.histKey || st.histTops.length != st.history.length + 1) {
    let tops: i32[] = [];
    let y = th.s1;
    if (st.histPos == 0) {
      y = y + nowH;
    }
    for (let i: usize = 0; i < st.history.length; i++) {
      tops.push(y);
      const diffOpen = st.histDiff == (i as i32);
      y = y + aiHistRowH(mut ui, th, mut st.history[i], diffOpen, r.x, r.w);
      if ((i as i32) == st.histPos - 1) {
        y = y + nowH;
      }
    }
    tops.push(y);
    st.histTops = tops;
    st.histKey = key;
  }
  const n = st.history.length;
  const contentH = st.histTops[n] + th.s2;
  st.scrollHist = aiScroll(mut ui, listR, st.scrollHist, contentH, th.lhMd * 3);
  ukPushClip(mut ui, listR);
  // 見えている最初の行を二分探索で探し、見える行だけを描く
  let lo: usize = 0;
  let hi: usize = n;
  while (lo < hi) {
    const mid = (lo + hi) / 2;
    if (st.histTops[mid + 1] <= st.scrollHist) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  const base = listR.y - st.scrollHist;
  if (st.histPos == 0) {
    aiNowLine(mut ui, th, r, base + th.s1);
  }
  let hovered: i32 = -1;
  let i = lo;
  while (i < n && base + st.histTops[i] < listR.y + listR.h) {
    const undone = (i as i32) >= st.histPos;
    const diffOpen = st.histDiff == (i as i32);
    const y = base + st.histTops[i];
    const rowH = st.histTops[i + 1] - st.histTops[i] - ((i as i32) == st.histPos - 1 ? nowH : 0);
    if (aiHistRow(mut ui, th, mut st.history[i], i as i32, undone, diffOpen, r.x, y, r.w, rowH, listR, mut ev)) {
      hovered = i as i32;
    }
    if ((i as i32) == st.histPos - 1) {
      aiNowLine(mut ui, th, r, y + rowH);
    }
    i++;
  }
  ukPopClip(mut ui);
  aiScrollBar(mut ui, th, listR, st.scrollHist, contentH);
  // ホバーした行が変わったときだけ知らせる（離れたら -1）
  if (hovered != st.hoverHist) {
    st.hoverHist = hovered;
    ev.push(aiEv(AI_EV_HOVER_HIST, -1, hovered, ""));
  }
}

// いまの位置の線（この線より下は取り消した行）。
function aiNowLine(ui: mut UkCtx, th: AiTheme, r: UkRect, y: i32): void {
  const padX = th.s3;
  ukDrawRect(mut ui, ukRect(r.x + padX, y, r.w - padX * 2, 2 * th.hairline), th.text2);
  aiText(mut ui, r.x + r.w - padX - ukTextW(mut ui, AI_T_NOW, th.fsSm), y + 2, th.lhSm, AI_T_NOW, th.fsSm, th.text2);
}

function aiHistBtn(ui: mut UkCtx, th: AiTheme, label: string, r: UkRect, text: string, kbd: string, redo: bool, on: bool): bool {
  if (!on) {
    aiIconUndo(mut ui, ukRect(r.x + th.s3, r.y + (r.h - th.iconSm) / 2, th.iconSm, th.iconSm), th.textDis, redo);
    aiText(mut ui, r.x + th.s3 + th.iconSm + th.s1 + 2, r.y, r.h, text, th.fsSm, th.textDis);
    return false;
  }
  const c = aiButton(mut ui, th, label, r, AI_BTN_QUIET, "", "", false, th.fsSm);
  aiIconUndo(mut ui, ukRect(r.x + th.s3, r.y + (r.h - th.iconSm) / 2, th.iconSm, th.iconSm), th.text2, redo);
  const tx = r.x + th.s3 + th.iconSm + th.s1 + 2;
  const tw = aiText(mut ui, tx, r.y, r.h, text, th.fsSm, th.text1);
  aiKbd(mut ui, th, tx + tw + th.s1 + 2, r.y + (r.h - th.lhXs - 4 * th.hairline) / 2, kbd, th.text2, th.bg1, th.lineControl);
  return c;
}

// 履歴の 1 行（高さ hh は aiHistRowH で測ったもの）。マウスかキーボードのフォーカスが乗っていれば true。
function aiHistRow(
  ui: mut UkCtx, th: AiTheme, h: mut AiHist, i: i32, undone: bool, diffOpen: bool, x0: i32, y0: i32, w0: i32, hh: i32,
  clipR: UkRect, ev: mut AiEvent[],
): bool {
  const padX = th.s3;
  const padY = th.s1 + 2;
  const iconW = th.iconSm;
  const g = aiHistGeo(mut ui, th, h, x0, w0);
  const tx = g.tx;
  const lhD = th.lhMd;
  const lhO = th.lhCodeSm;
  const dl = aiHistLines(mut ui, mut h, th.fsMd, g.tw);
  const rr = ukRect(x0, y0, w0, hh);
  const vis = aiIntersectY(rr, clipR);
  const over = ukMouseIn(ui, vis);
  if (over) {
    ukDrawRect(mut ui, rr, ukAlpha(th.bg3, 160));
  }
  if (h.who == AI_WHO_TEXT) {
    ukDrawRect(mut ui, ukRect(rr.x, rr.y, 2 * th.hairline, rr.h), th.textSource);
  }
  aiIconWho(mut ui, th, ukRect(x0 + padX, y0 + padY + (lhD - iconW) / 2, iconW, iconW), h.who);
  let y = y0 + padY;
  const dc = undone ? th.text3 : th.text1;
  let dx = tx;
  if (g.isAi) {
    const cr = ukRect(tx, y + (lhD - th.iconSm) / 2, th.iconSm, th.iconSm);
    const ch = aiAreaF(mut ui, `aihistopen##${i}`, cr, true);
    ukIcon(mut ui, ukShrink(cr, 2), h.open ? UK_I_DOWN : UK_I_RIGHT, ch.hover ? th.text1 : th.text2);
    aiFocusRing(mut ui, th, cr, th.rSm, ch);
    if (ch.clicked) {
      ev.push(aiEv(AI_EV_HIST_DIFF, -1, i, "open"));
    }
    dx = tx + th.iconSm;
  }
  for (const l of dl) {
    aiText(mut ui, dx, y, lhD, l, th.fsMd, dc);
    y = y + lhD;
  }
  aiText(mut ui, x0 + w0 - padX - g.timeW + th.s2, y0 + padY, lhD, aiClockOf(h.t), th.fsXs, th.text3);
  if (h.ops.length > 0 && !g.isAi) {
    ukDrawTextIn(mut ui, ukRect(tx, y, w0 - (tx - x0) - padX, lhO), h.ops[0], th.fsCodeSm, th.text3, 0);
    y = y + lhO;
  }
  if (g.isAi && h.open) {
    for (let k: usize = 0; k < h.ops.length; k++) {
      ukDrawTextIn(mut ui, ukRect(tx + th.s3, y, w0 - (tx - x0) - padX - th.s3, lhO), `${k + 1}  ` + h.ops[k], th.fsCodeSm, th.text3, 0);
      y = y + lhO;
    }
  }
  // ［差分］［ここまで戻す］ ／ 取り消した行は［やり直す］（その行までやり直す）
  y = y + th.s1;
  const actH = th.lhSm + 4;
  let ax = tx;
  if (h.changes.length > 0) {
    let t1 = AI_T_DIFF;
    if (diffOpen) {
      t1 = AI_T_DIFF_CLOSE;
    }
    const w1 = ukTextW(mut ui, t1, th.fsSm);
    if (aiButton(mut ui, th, `aihistdiff##${i}`, ukRect(ax, y, w1, actH), AI_BTN_LINK, t1, "", false, th.fsSm)) {
      ev.push(aiEv(AI_EV_HIST_DIFF, -1, i, ""));
    }
    ax = ax + w1 + th.s3;
  }
  let t2 = AI_T_UNDO_TO;
  if (undone) {
    t2 = AI_T_REDO;
  }
  const w2 = ukTextW(mut ui, t2, th.fsSm);
  if (aiButton(mut ui, th, `aihistto##${i}`, ukRect(ax, y, w2, actH), AI_BTN_LINK, t2, "", false, th.fsSm)) {
    ev.push(aiEv(undone ? AI_EV_REDO_TO : AI_EV_UNDO_TO, -1, i, ""));
  }
  y = y + actH;
  if (diffOpen && h.changes.length > 0) {
    y = y + th.s1;
    aiDiffBlock(mut ui, th, h.changes, ukRect(tx, y, w0 - (tx - x0) - padX, y0 + hh - padY - y));
  }
  // 行（中のボタンの後に置くので、押すのはボタンが先。Tab で選べ、フォーカスはホバーと同じ扱い）
  const hit = aiAreaUnder(mut ui, `aihist##${i}`, vis, false);
  aiFocusRing(mut ui, th, ukShrink(vis, th.focusW + 2 * th.hairline), th.rSm, hit);
  return over || hit.focused;
}

// ---- 問題（ui.md 3.9） ----

export function aiProblems(ui: mut UkCtx, th: AiTheme, st: mut AiPanelState, r: UkRect, ev: mut AiEvent[]): void {
  ukDrawRect(mut ui, r, th.bg1);
  // 見出し
  const hh = th.tabBar;
  ukDrawRect(mut ui, ukRect(r.x, r.y, r.w, hh), th.bg2);
  ukDrawRect(mut ui, ukRect(r.x, r.y + hh - th.hairline, r.w, th.hairline), th.line);
  const tw = aiText(mut ui, r.x + th.s3, r.y, hh, AI_T_PROBLEMS, th.fsSm, th.text1);
  const cnt = aiDiagCounts(st.diags);
  aiText(mut ui, r.x + th.s3 + tw + th.s2, r.y, hh, aiTxtDiagCounts(cnt[0], cnt[1]), th.fsSm, cnt[0] > 0 ? th.error : th.text3);
  const listR = ukRect(r.x, r.y + hh, r.w, r.h - hh);
  if (st.diags.length == 0) {
    const s = th.s4 + 4;
    const tw2 = ukTextW(mut ui, AI_T_NO_PROBLEMS, th.fsMd);
    const x = listR.x + (listR.w - s - th.s2 - tw2) / 2;
    aiIconOk(mut ui, ukRect(x, listR.y + th.s5, s, s), th.ok);
    aiText(mut ui, x + s + th.s2, listR.y + th.s5, s, AI_T_NO_PROBLEMS, th.fsMd, th.text2);
    return;
  }
  ukPushClip(mut ui, listR);
  let y = listR.y - st.scrollDiag;
  const sel = st.diagSel;
  for (let i: usize = 0; i < st.diags.length; i++) {
    y = y + aiDiagRow(mut ui, th, st.diags[i], i as i32, sel == (i as i32), r.x, y, r.w, listR, mut ev);
  }
  const contentH = y + st.scrollDiag - listR.y;
  ukPopClip(mut ui);
  st.scrollDiag = aiScroll(mut ui, listR, st.scrollDiag, contentH, th.lhMd * 3);
  aiScrollBar(mut ui, th, listR, st.scrollDiag, contentH);
}

function aiDiagRow(
  ui: mut UkCtx, th: AiTheme, d: AiDiagItem, i: i32, sel: bool, x0: i32, y0: i32, w0: i32, clipR: UkRect,
  ev: mut AiEvent[],
): i32 {
  const padX = th.s3;
  const padY = th.s2;
  const iconW = th.iconSm;
  const tx = x0 + padX + iconW + th.s2;
  const tw = w0 - (tx - x0) - padX;
  const lh = th.lhMd;
  const ml = aiWrap(mut ui, d.msg, th.fsSm, tw);
  const hl = aiWrap(mut ui, d.hint, th.fsSm, tw);
  const codeH = th.lhSm + 4;
  const actH = th.btnSm;
  const hh = padY + codeH + th.s1 + ((ml.length + hl.length) as i32) * lh + th.s1 + actH + padY;
  const rr = ukRect(x0, y0, w0, hh);
  if (rr.y + rr.h < clipR.y || rr.y > clipR.y + clipR.h) {
    return hh;
  }
  const vis = aiIntersectY(rr, clipR);
  if (sel) {
    ukDrawRect(mut ui, rr, th.accentTint);
    ukDrawRect(mut ui, ukRect(rr.x, rr.y, 2 * th.hairline, rr.h), th.accent);
  } else if (ukMouseIn(ui, vis)) {
    ukDrawRect(mut ui, rr, ukAlpha(th.bg3, 160));
  }
  ukDrawRect(mut ui, ukRect(rr.x, rr.y + rr.h - th.hairline, rr.w, th.hairline), th.line);
  const isErr = d.severity == "error";
  const ir = ukRect(x0 + padX, y0 + padY + (codeH - iconW) / 2, iconW, iconW);
  if (isErr) {
    aiIconError(mut ui, ir, th.error);
  } else {
    aiIconWarn(mut ui, ir, th.warn);
  }
  let y = y0 + padY;
  aiDrawChip(mut ui, th, tx, y, codeH, isErr ? AI_CHIP_ERR : AI_CHIP_MONO, d.code, th.fsCodeSm, tw);
  y = y + codeH + th.s1;
  for (const l of ml) {
    aiText(mut ui, tx, y, lh, l, th.fsSm, th.text1);
    y = y + lh;
  }
  for (const l of hl) {
    aiText(mut ui, tx, y, lh, l, th.fsSm, th.text2);
    y = y + lh;
  }
  y = y + th.s1;
  // 場所（「本編_v3.mzc:7:12」。和文のファイル名が入るので sm）
  const loc = aiDiagLoc(d);
  const lw = ukTextW(mut ui, loc, th.fsSm);
  if (aiButton(mut ui, th, `aidiagloc##${i}`, ukRect(tx, y, lw, actH), AI_BTN_LINK, loc, "", false, th.fsSm)) {
    ev.push(aiEv(AI_EV_JUMP, -1, i, ""));
  }
  ukTooltip(mut ui, AI_T_GO_SOURCE);
  if (d.suggest.length > 0 && d.fixOp.length > 0) {
    const ft = aiTxtFixTo(d.suggest);
    const fw = aiButtonW(mut ui, th, ft, "", false, th.fsSm);
    if (aiButton(mut ui, th, `aidiagfix##${i}`, ukRect(x0 + w0 - padX - fw, y, fw, actH), AI_BTN_SECONDARY, ft, "", false, th.fsSm)) {
      ev.push(aiEv(AI_EV_FIX, -1, i, d.fixOp));
    }
    ukTooltip(mut ui, d.fixOp);
  }
  // 行（中のボタンの後。押す・Enter で選び、ダブルクリックで場所へ）
  const hit = aiAreaUnder(mut ui, `aidiag##${i}`, vis, true);
  if (hit.clicked) {
    ev.push(aiEv(AI_EV_SELECT_DIAG, -1, i, ""));
  }
  if (hit.dbl) {
    ev.push(aiEv(AI_EV_JUMP, -1, i, ""));
  }
  aiFocusRing(mut ui, th, ukShrink(vis, th.focusW + 2 * th.hairline), th.rSm, hit);
  return hh;
}

// ---- キー（ui.md 5 章の AI の表） ----

// AI のタブのキー。aiTabAi を描いた後に呼ぶ（中のボタンが先に Enter / Space を受ける）。
// active: AI のパネルが作業中のパネル（上の辺に accent の帯がある）とき true。タイムラインが作業中なら false にする
// （Space の再生・↑↓ の編集点を奪わない。ui.md 15.1・19 章）。キーは条件が合ったときだけ取り、合わなければ残す。
export function aiPanelKeys(ui: mut UkCtx, st: mut AiPanelState, ev: mut AiEvent[], active: bool): void {
  if (!active || !st.connected) {
    return;
  }
  const J = UK_KEY_CHAR + 106;
  // Ctrl+Shift+J（ai.share）と Ctrl+J（ai.focus）は入力の欄の中でも効く
  if (aiKeyTakeExact(mut ui, J, UK_MOD_CTRL | UK_MOD_SHIFT)) {
    ev.push(aiEv(AI_EV_SHARE_TOGGLE, -1, -1, ""));
  }
  if (aiKeyTakeExact(mut ui, J, UK_MOD_CTRL)) {
    ev.push(aiEv(AI_EV_FOCUS_ASK, -1, -1, ""));
  }
  if (ui.wantText || ui.textActive) {
    return;
  }
  if (st.review >= 0 && (st.review as usize) < st.proposals.length) {
    const pi = st.review;
    const n = st.proposals[pi as usize].ops.length as i32;
    // フォーカスが無いか、op の行・チェックにあるときだけ ↑↓ Space を使う
    let onOp = ui.focus == 0;
    for (let i = 0; i < n; i++) {
      if (ui.focus == ukId(ui, `aiop##${i}`) || ui.focus == ukId(ui, `aichk##${i}`)) {
        onOp = true;
      }
    }
    const inTrap = aiHasId(st.trap, ui.focus);
    if (onOp && n > 0) {
      let to = -1;
      if (aiKeyTakeExact(mut ui, UK_KEY_UP, 0)) {
        to = Math.max(st.focusOp - 1, 0);
      }
      if (aiKeyTakeExact(mut ui, UK_KEY_DOWN, 0)) {
        to = Math.min(st.focusOp + 1, n - 1);
      }
      if (to >= 0) {
        ev.push(aiEv(AI_EV_FOCUS_OP, pi, to, ""));
        if (ui.focus != 0) {
          ukFocus(mut ui, ukId(ui, `aiop##${to}`), true);
        }
      }
      if (st.focusOp >= 0 && aiKeyTakeExact(mut ui, UK_KEY_SPACE, 0)) {
        ev.push(aiEv(AI_EV_TOGGLE_OP, pi, st.focusOp, ""));
      }
    }
    if (onOp || inTrap) {
      if (aiSelectedCount(st.proposals[pi as usize]) > 0 && aiKeyTakeExact(mut ui, UK_KEY_ENTER, UK_MOD_CTRL)) {
        ev.push(aiEv(AI_EV_APPLY, pi, -1, ""));
      }
      if (aiKeyTakeExact(mut ui, UK_KEY_ESC, 0)) {
        ev.push(aiEv(AI_EV_REJECT, pi, -1, ""));
      }
      // Alt+C だけ（Ctrl+C のコピー・Ctrl+Alt+C の history.copy は取らない）
      if (aiKeyTakeExact(mut ui, UK_KEY_CHAR + 99, UK_MOD_ALT)) {
        ev.push(aiEv(AI_EV_COMPARE, pi, -1, ""));
      }
    }
    // 確かめる欄の中にフォーカスがあれば、Tab はこの中だけを回る（ui.md 19 章）
    if (inTrap && st.trap.length > 0) {
      let dir = 0;
      if (aiKeyTakeExact(mut ui, UK_KEY_TAB, 0)) {
        dir = 1;
      } else if (aiKeyTakeExact(mut ui, UK_KEY_TAB, UK_MOD_SHIFT)) {
        dir = -1;
      }
      if (dir != 0) {
        const m = st.trap.length as i32;
        let cur = 0;
        for (let k = 0; k < m; k++) {
          if (st.trap[k as usize] == ui.focus) {
            cur = k;
          }
        }
        ukFocus(mut ui, st.trap[((cur + dir + m) % m) as usize], true);
      }
    }
    return;
  }
  // カード: フォーカスが無いときの Enter（修飾なし）で、一番上の未確認の提案を確かめる。無ければ取らない
  if (ui.focus == 0) {
    for (let i: usize = 0; i < st.proposals.length; i++) {
      if (st.proposals[i].state == AI_PROP_NEW) {
        if (aiKeyTakeExact(mut ui, UK_KEY_ENTER, 0)) {
          ev.push(aiEv(AI_EV_REVIEW, i as i32, -1, ""));
        }
        break;
      }
    }
  }
}

function aiHasId(list: u32[], id: u32): bool {
  if (id == 0) {
    return false;
  }
  for (const v of list) {
    if (v == id) {
      return true;
    }
  }
  return false;
}

// ---- 上の帯の印と通知 ----

// 上の帯の「✦ AI · 提案 N」（r は置く場所。幅は中身に合わせ、右の端を r の右にそろえる）。
// 考えている間は ✦ が明滅する（ui.md 15.2 の 2）。つながっていなければ何も描かない。描いた幅を返す。
export function aiTopBadge(ui: mut UkCtx, th: AiTheme, st: AiPanelState, r: UkRect): i32 {
  if (!st.connected) {
    return 0;
  }
  const n = aiPendingCount(st);
  if (n == 0 && !st.thinking) {
    return 0;
  }
  let text = "AI";
  if (n > 0) {
    text = aiTxtTopBadge(n);
  }
  const h = th.lhSm + 4;
  const tw = ukTextW(mut ui, text, th.fsSm);
  const w = th.s1 + 2 + th.iconSm - 4 + th.s1 + tw + th.s2;
  const b = ukRect(r.x + r.w - w, r.y + (r.h - h) / 2, w, h);
  ukDrawRound(mut ui, b, th.rSm, th.aiTint);
  let ic = th.ai;
  if (st.thinking) {
    const k = aiPulseK(ui.now - st.thinkingSince, th.dPulse, st.reduceMotion);
    ic = ukAlpha(th.ai, 70 + (Math.floor(k * 185.0) as i32));
    if (!st.reduceMotion && th.dPulse > 0.0) {
      ui.wantFrame = true;
    }
  }
  aiIconSparkle(mut ui, ukRect(b.x + th.s1 + 2, b.y + (h - th.iconSm + 4) / 2, th.iconSm - 4, th.iconSm - 4), ic);
  aiText(mut ui, b.x + th.s1 + 2 + th.iconSm - 4 + th.s1, b.y, h, text, th.fsSm, th.ai);
  return w;
}

// 状態の帯の右の「エラー N · 警告 M」（問題の一覧と同じ数）。
export function aiStatusDiagText(st: AiPanelState): string {
  const c = aiDiagCounts(st.diags);
  return aiTxtDiagCounts(c[0], c[1]);
}

// 却下の通知（「提案を却下しました ［元に戻す］」を th.dToastUndo 秒。ui.md 15.2 の 6）。area の下の中央に出す。
// uikit の ukToast に［元に戻す］と時間の指定が付くまでの仮。毎フレーム、ほかを描いた後に呼ぶ。
export function aiDrawToast(ui: mut UkCtx, th: AiTheme, st: mut AiPanelState, area: UkRect, ev: mut AiEvent[]): void {
  if (st.toastText.length == 0) {
    return;
  }
  const life = th.dToastUndo;
  if (ui.now - st.toastT0 >= life) {
    st.toastText = "";
    st.toastProp = -1;
    return;
  }
  ukWakeAt(mut ui, st.toastT0 + life);
  ukPushLayer(mut ui, UK_L_TOAST);
  ukPushClipScreen(mut ui);
  const h = th.btnLg;
  const tw = ukTextW(mut ui, st.toastText, th.fsMd);
  let bw = 0;
  if (st.toastProp >= 0) {
    bw = ukTextW(mut ui, AI_T_UNDO_REJECT, th.fsMd) + th.s3;
  }
  const w = th.s4 + tw + bw + th.s4;
  const r = ukRect(area.x + (area.w - w) / 2, area.y + area.h - h - th.s4, w, h);
  ukDrawShadow(mut ui, r, th.rMd, th.s3, ukAlpha(th.focusOuter, 128));
  ukDrawRound(mut ui, r, th.rMd, th.popover);
  ukDrawStroke(mut ui, r, th.rMd, th.hairline, th.lineStrong);
  aiText(mut ui, r.x + th.s4, r.y, h, st.toastText, th.fsMd, th.text1);
  if (st.toastProp >= 0) {
    const bx = r.x + th.s4 + tw + th.s3;
    if (aiButton(mut ui, th, "aitoastundo", ukRect(bx, r.y, bw - th.s3, h), AI_BTN_LINK, AI_T_UNDO_REJECT, "", false, th.fsMd)) {
      ev.push(aiEv(AI_EV_UNREJECT, st.toastProp, -1, ""));
    }
  }
  ukPopClip(mut ui);
  ukPopLayer(mut ui);
}

// ---- タイムラインへの重ね（ui.md 15.2 の 4「タイムライン」） ----

// lanes はトラックの並ぶ四角（見出しを除く）。viewT0 は lanes の左の端の時刻、pps は 1 秒の画素。
// trackY / trackH はトラックごとの上の端と高さ（lanes の中の画素ではなく画面の座標）。tagY は札を置く高さ、rippleY は詰まる線の高さ、rippleTagY は「後ろの 14 個が詰まる」の札の高さ。
export function aiDrawPreview(
  ui: mut UkCtx, th: AiTheme, pv: AiPreview, lanes: UkRect, viewT0: f64, pps: f64, trackY: i32[], trackH: i32[],
  tagY: i32, rippleY: i32, rippleTagY: i32,
): void {
  ukPushClip(mut ui, lanes);
  const a = ((th.aiTint >> 24) & 255) as i32;
  for (const m of pv.marks) {
    const x0 = lanes.x + (Math.floor((m.t0 - viewT0) * pps) as i32);
    const x1 = lanes.x + (Math.floor((m.t1 - viewT0) * pps) as i32);
    let y0 = lanes.y;
    let h = lanes.h;
    if (m.track >= 0 && (m.track as usize) < trackY.length) {
      y0 = trackY[m.track as usize];
      h = trackH[m.track as usize];
    }
    if (m.kind == AI_PV_CUT) {
      const w = Math.max(x1 - x0, 4);
      const rr = ukRect(x0, lanes.y, w, lanes.h);
      ukDrawRect(mut ui, rr, ukAlpha(th.ai, a / 2 + 8));
      aiHatch(mut ui, rr, ukAlpha(th.ai, 150), Math.max(th.hatchPeriod - 1, 3), 1.4);
      ukDrawRect(mut ui, ukRect(x0, lanes.y, th.hairline, lanes.h), th.ai);
      ukDrawRect(mut ui, ukRect(x0 + w - th.hairline, lanes.y, th.hairline, lanes.h), th.ai);
    } else if (m.kind == AI_PV_SET) {
      aiDashRect(mut ui, ukRect(x0, y0 + 2, Math.max(x1 - x0, 4), h - 4), th.ai, 2 * th.hairline, th.dashOn, th.dashOff);
    } else if (m.kind == AI_PV_OFF) {
      aiDashRect(mut ui, ukRect(x0, lanes.y, Math.max(x1 - x0, 4), lanes.h), th.text3, th.hairline, th.dashOn, th.dashOff);
    } else if (m.kind == AI_PV_RIPPLE) {
      // 後ろが詰まる: 黄の線が右へ薄れていく
      const len = Math.max(lanes.x + lanes.w - x0, 0);
      const steps = 16;
      for (let k = 0; k < steps; k++) {
        const sx = x0 + len * k / steps;
        const al = 255 - 255 * k / steps;
        ukDrawRect(mut ui, ukRect(sx, rippleY, len / steps + 1, 2 * th.hairline), ukAlpha(th.ripple, al));
      }
    }
  }
  // 札（和文が入るので sm。AI の札は太字の代わりに 2 回描く）
  for (const t of pv.tags) {
    let x = lanes.x + (Math.floor((t.t - viewT0) * pps) as i32) - th.s3 - 2;
    const h = th.lhSm;
    const tw = ukTextW(mut ui, t.text, th.fsSm) + th.s1 * 2 + 3;
    let y = tagY;
    if (t.kind == AI_PV_SET && t.track >= 0 && (t.track as usize) < trackY.length) {
      y = trackY[t.track as usize] + (trackH[t.track as usize] - h) / 2;
      // 値が変わるクリップの札は、見えている所の真ん中あたりに
      const m = aiSetMid(pv, t.track);
      if (m >= 0.0) {
        x = lanes.x + (Math.floor((m - viewT0) * pps) as i32) - tw / 2;
      }
      x = Math.max(x, lanes.x + th.s1);
    }
    if (t.kind == AI_PV_RIPPLE) {
      y = rippleTagY;
      x = lanes.x + (Math.floor((t.t - viewT0) * pps) as i32) + th.s1;
    }
    if (t.kind == AI_PV_OK) {
      y = lanes.y + th.s1 + 2;
      x = lanes.x + (Math.floor((t.t - viewT0) * pps) as i32) + th.s1 + 2;
    }
    const rr = ukRect(x, y, tw, h);
    if (t.kind == AI_PV_RIPPLE) {
      ukDrawRound(mut ui, rr, th.rSm, th.ripple);
      aiTextBold(mut ui, x + th.s1 + 1, y, h, t.text, th.fsSm, th.textOnRipple);
    } else if (t.kind == AI_PV_OFF) {
      ukDrawRound(mut ui, rr, th.rSm, th.bg4);
      aiText(mut ui, x + th.s1 + 1, y, h, t.text, th.fsSm, th.text2);
    } else if (t.kind == AI_PV_OK) {
      ukDrawRound(mut ui, rr, th.rSm, th.ok);
      aiTextBold(mut ui, x + th.s1 + 1, y, h, t.text, th.fsSm, th.textOnOk);
    } else {
      ukDrawRound(mut ui, rr, th.rSm, th.ai);
      aiTextBold(mut ui, x + th.s1 + 1, y, h, t.text, th.fsSm, th.textOnAi);
    }
  }
  ukPopClip(mut ui);
}

// SET の範囲の真ん中の時刻（なければ -1）。
function aiSetMid(pv: AiPreview, track: i32): f64 {
  for (const m of pv.marks) {
    if (m.kind == AI_PV_SET && m.track == track) {
      return (m.t0 + m.t1) * 0.5;
    }
  }
  return -1.0;
}

// AI が話題にしたクリップにホバーしたときの枠（紫 2px の点線。ui.md 15.3）。
export function aiDrawClipHover(ui: mut UkCtx, th: AiTheme, r: UkRect): void {
  aiDashRect(mut ui, ukShrink(r, -2 * th.hairline), th.ai, 2 * th.hairline, th.dashOn, th.dashOff);
}

// 状態の帯の右の「AI に見せています」（見せているときだけ。目の印は呼ぶ側）。
export function aiSharingText(st: AiPanelState): string {
  if (st.connected && st.sharing) {
    return AI_T_SHARING;
  }
  return "";
}
