// 書き出しの予約（キュー）の状態機械。
//
// 仕事（RenderJob）の状態は 待ち → 実行中 → 完了 / 失敗 / 取り消し。失敗と取り消しは、やり直し（rqRetry）で待ちに戻せる。
//
//   待ち ──rqStart / rqTick──▶ 実行中 ──rqFinish──▶ 完了
//    │                          ├──rqFail────▶ 失敗 ──rqRetry──▶ 待ち
//    └──rqCancel──▶ 取り消し ◀──rqCancel─┘              取り消し ──rqRetry──▶ 待ち
//
// - 時刻（now）は呼ぶ側が渡す（clock() の秒）。グローバル変数がないので、キューは値として持ち回り、mut で渡す。
// - 進み具合はコマ数（doneFrames / totalFrames）。残り時間の見込みは、進み具合の報告からならした速さ（コマ/秒）で求める。
// - 同時に実行する数は maxParallel（既定 1）。rqTick が空いている分だけ、待ちの仕事を並びの順に始める。
// - 状態に合わない操作（完了した仕事の取り消しなど）は、何も変えずに ok=false と日本語の理由（RqResult）を返す。
//
// 実際の圧縮（FFmpeg）とのつなぎ口:
// - rqEncodeTask が、仕事とプリセットから ffmpeg の引数（-progress pipe:1 つき）を作る。
//   いまは tools/mozcut.mjs が ffmpeg を起動し、標準出力の行を rqFfmpegProgress に、終了コードを rqFfmpegExit に渡す。
//   FFmpeg の組み込み（UM のネイティブの組み込み）が来たら、同じ引数・同じ行で組み込みにつなぐ。
//
// 名前の空間は全ファイルで 1 つなので、公開する名前は rq / Rq / RenderJob / RenderQueue で始める。
import { sub, isNan, textNum, textStartsWith, parseNum } from "./text.um";
import { Project } from "./project.um";
import { jsonStr, jsonNum } from "./report.um";
import { ExportPreset, exportPresetFfmpegArgs } from "./presets.um";

export const RQ_WAITING: i32 = 0;
export const RQ_RUNNING: i32 = 1;
export const RQ_DONE: i32 = 2;
export const RQ_FAILED: i32 = 3;
export const RQ_CANCELED: i32 = 4;

export struct RenderJob {
  id: i32;
  // 人向けの名前（既定は書き出すファイルの名前）
  name: string;
  project: string;
  output: string;
  presetId: string;
  // 書き出す範囲（秒。toSec が負なら最後まで）
  fromSec: f64;
  toSec: f64;
  state: i32;
  // 進み具合（コマ数）と、そのコマの速さ（ffmpeg の out_time からコマ数を求めるのに使う。0 なら使わない）
  totalFrames: i64;
  doneFrames: i64;
  fps: f64;
  // 実行中の段階（"render" = 合成、"encode" = 圧縮。待ちのあいだは ""）
  phase: string;
  queuedAt: f64;
  startedAt: f64;
  finishedAt: f64;
  // 速さのならし: 最後に速さを測った時刻とコマ数、ならした速さ（コマ/秒。0 は未知）、最後の報告の時刻
  sampleAt: f64;
  sampleFrames: i64;
  rate: f64;
  lastReportAt: f64;
  // ffmpeg の frame= を見たか（見ていなければ out_time から進み具合を求める。音だけの書き出し）
  sawFrame: bool;
  // 失敗の理由（code は英小文字とハイフン、msg は日本語）
  errorCode: string;
  error: string;
  // 始めた回数（やり直しで増える）
  attempts: i32;
}

export struct RenderQueue {
  jobs: RenderJob[];
  nextId: i32;
  maxParallel: i32;
}

// 操作の結果。ok が false なら何も変えていない。code は英小文字とハイフン、msg と hint は日本語。
export struct RqResult {
  ok: bool;
  code: string;
  msg: string;
  hint: string;
}

// ffmpeg を起動する仕事（つなぎ口）。program は "ffmpeg"（FFMPEG の環境変数で置き換えるのは起動する側）。
export struct RqEncodeTask {
  jobId: i32;
  program: string;
  args: string[];
  output: string;
}

// 速さをならす係数（新しい測定の重み）と、測る間隔の下限（秒）。
const RQ_RATE_ALPHA: f64 = 0.3;
const RQ_RATE_MIN_DT: f64 = 0.25;

// ---- 作る・足す ----

export function rqNew(maxParallel: i32): RenderQueue {
  let n = maxParallel;
  if (n < 1) {
    n = 1;
  }
  return { jobs: [], nextId: 1, maxParallel: n };
}

// 同時に実行する数を変える（1 以上）。いま実行中の仕事は止めない。
export function rqSetParallel(q: mut RenderQueue, n: i32): void {
  let m = n;
  if (m < 1) {
    m = 1;
  }
  q.maxParallel = m;
}

// 仕事を待ちの最後に足す。totalFrames は書き出すコマ数（0 なら進み具合は未知）、fps はコマの速さ。
// name が "" なら output の名前の部分を使う。足した仕事の id を返す。
export function rqAdd(q: mut RenderQueue, name: string, project: string, output: string, presetId: string,
                      fromSec: f64, toSec: f64, totalFrames: i64, fps: f64, now: f64): i32 {
  const id = q.nextId;
  q.nextId = q.nextId + 1;
  let nm = name.clone();
  if (nm.length == 0) {
    nm = rqBaseName(output);
  }
  let total = totalFrames;
  if (total < 0) {
    total = 0;
  }
  q.jobs.push({
    id,
    name: nm,
    project: project.clone(),
    output: output.clone(),
    presetId: presetId.clone(),
    fromSec,
    toSec,
    state: RQ_WAITING,
    totalFrames: total,
    doneFrames: 0,
    fps,
    phase: "",
    queuedAt: now,
    startedAt: 0,
    finishedAt: 0,
    sampleAt: 0,
    sampleFrames: 0,
    rate: 0,
    lastReportAt: 0,
    sawFrame: false,
    errorCode: "",
    error: "",
    attempts: 0,
  });
  return id;
}

function rqBaseName(path: string): string {
  let k = path.length;
  while (k > 0 && path[k - 1] != 47 && path[k - 1] != 92) {
    k--;
  }
  return sub(path, k, path.length);
}

// id の仕事の添字。なければ -1。
export function rqFind(q: RenderQueue, id: i32): i32 {
  for (let i: usize = 0; i < q.jobs.length; i++) {
    if (q.jobs[i].id == id) {
      return i as i32;
    }
  }
  return -1;
}

function rqOk(msg: string): RqResult {
  return { ok: true, code: "", msg: msg.clone(), hint: "" };
}

function rqNg(code: string, msg: string, hint: string): RqResult {
  return { ok: false, code: code.clone(), msg: msg.clone(), hint: hint.clone() };
}

function rqUnknown(id: i32): RqResult {
  return rqNg("rq-unknown-job", `書き出しの仕事 #${id} はありません`, "rqQueueJson の jobs の id を使います");
}

function rqBadState(j: RenderJob, what: string, hint: string): RqResult {
  return rqNg("rq-bad-state", `#${j.id}（${j.name}）は${rqStateLabel(j.state)}なので、${what}できません`, hint);
}

// ---- 状態の名前 ----

// 機械向けの状態の名前。
export function rqStateName(state: i32): string {
  switch (state) {
    case RQ_WAITING:
      return "waiting";
    case RQ_RUNNING:
      return "running";
    case RQ_DONE:
      return "done";
    case RQ_FAILED:
      return "failed";
    case RQ_CANCELED:
      return "canceled";
    default:
      return "unknown";
  }
}

// 人向けの状態の名前。
export function rqStateLabel(state: i32): string {
  switch (state) {
    case RQ_WAITING:
      return "待ち";
    case RQ_RUNNING:
      return "実行中";
    case RQ_DONE:
      return "完了";
    case RQ_FAILED:
      return "失敗";
    case RQ_CANCELED:
      return "取り消し";
    default:
      return "不明";
  }
}

// 終わった状態（完了・失敗・取り消し）か。
export function rqIsFinished(state: i32): bool {
  return state == RQ_DONE || state == RQ_FAILED || state == RQ_CANCELED;
}

export function rqRunningCount(q: RenderQueue): i32 {
  let n = 0;
  for (const j of q.jobs) {
    if (j.state == RQ_RUNNING) {
      n++;
    }
  }
  return n;
}

export function rqWaitingCount(q: RenderQueue): i32 {
  let n = 0;
  for (const j of q.jobs) {
    if (j.state == RQ_WAITING) {
      n++;
    }
  }
  return n;
}

// ---- 状態の移り変わり ----

// 待ちの仕事を始める（同時に実行する数の上限は見ない。上限を守るなら rqTick を使う）。
export function rqStart(q: mut RenderQueue, id: i32, now: f64): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  const i = k as usize;
  if (q.jobs[i].state != RQ_WAITING) {
    return rqBadState(q.jobs[i], "始められ", "失敗・取り消しの仕事は rqRetry で待ちに戻してから始めます");
  }
  q.jobs[i].state = RQ_RUNNING;
  q.jobs[i].phase = "render";
  q.jobs[i].startedAt = now;
  q.jobs[i].finishedAt = 0;
  q.jobs[i].doneFrames = 0;
  q.jobs[i].sampleAt = now;
  q.jobs[i].sampleFrames = 0;
  q.jobs[i].rate = 0;
  q.jobs[i].lastReportAt = now;
  q.jobs[i].sawFrame = false;
  q.jobs[i].errorCode = "";
  q.jobs[i].error = "";
  q.jobs[i].attempts = q.jobs[i].attempts + 1;
  return rqOk(`#${id}（${q.jobs[i].name}）を始めました`);
}

// 空いている分（maxParallel − 実行中の数）だけ、待ちの仕事を並びの順に始める。始めた仕事の id を返す。
export function rqTick(q: mut RenderQueue, now: f64): i32[] {
  let started: i32[] = [];
  let free = q.maxParallel - rqRunningCount(q);
  let i: usize = 0;
  while (free > 0 && i < q.jobs.length) {
    if (q.jobs[i].state == RQ_WAITING) {
      const id = q.jobs[i].id;
      const r = rqStart(mut q, id, now);
      if (r.ok) {
        started.push(id);
        free--;
      }
    }
    i++;
  }
  return started;
}

// 実行中の段階を変える（"render" / "encode"）。
export function rqSetPhase(q: mut RenderQueue, id: i32, phase: string): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  const i = k as usize;
  if (q.jobs[i].state != RQ_RUNNING) {
    return rqBadState(q.jobs[i], "段階を変え", "");
  }
  q.jobs[i].phase = phase.clone();
  return rqOk("");
}

// 進み具合を報告する（書き終えたコマ数）。totalFrames を超える値は totalFrames にする。
// 前より少ない値（段階が変わって数え直した）は受け付け、速さの測り直しを始める。
export function rqProgress(q: mut RenderQueue, id: i32, doneFrames: i64, now: f64): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  const i = k as usize;
  if (q.jobs[i].state != RQ_RUNNING) {
    return rqBadState(q.jobs[i], "進み具合を報告", "実行中の仕事だけが進みます");
  }
  let f = doneFrames;
  if (f < 0) {
    f = 0;
  }
  if (q.jobs[i].totalFrames > 0 && f > q.jobs[i].totalFrames) {
    f = q.jobs[i].totalFrames;
  }
  if (f < q.jobs[i].sampleFrames) {
    q.jobs[i].sampleFrames = f;
    q.jobs[i].sampleAt = now;
  } else {
    const dt = now - q.jobs[i].sampleAt;
    if (dt >= RQ_RATE_MIN_DT) {
      const inst = ((f - q.jobs[i].sampleFrames) as f64) / dt;
      if (q.jobs[i].rate <= 0) {
        q.jobs[i].rate = inst;
      } else {
        q.jobs[i].rate = q.jobs[i].rate * (1.0 - RQ_RATE_ALPHA) + inst * RQ_RATE_ALPHA;
      }
      q.jobs[i].sampleAt = now;
      q.jobs[i].sampleFrames = f;
    }
  }
  q.jobs[i].doneFrames = f;
  q.jobs[i].lastReportAt = now;
  return rqOk("");
}

// 完了にする（進み具合は 100%）。
export function rqFinish(q: mut RenderQueue, id: i32, now: f64): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  const i = k as usize;
  if (q.jobs[i].state != RQ_RUNNING) {
    return rqBadState(q.jobs[i], "完了に", "");
  }
  q.jobs[i].state = RQ_DONE;
  q.jobs[i].phase = "";
  q.jobs[i].finishedAt = now;
  if (q.jobs[i].totalFrames > 0) {
    q.jobs[i].doneFrames = q.jobs[i].totalFrames;
  }
  return rqOk(`#${id}（${q.jobs[i].name}）を書き出しました（${rqDurationText(now - q.jobs[i].startedAt)}）`);
}

// 失敗にする。code は英小文字とハイフン（"encode-failed" / "render-failed" など）、msg は日本語の理由。
export function rqFail(q: mut RenderQueue, id: i32, code: string, msg: string, now: f64): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  const i = k as usize;
  if (q.jobs[i].state != RQ_RUNNING) {
    return rqBadState(q.jobs[i], "失敗に", "");
  }
  q.jobs[i].state = RQ_FAILED;
  q.jobs[i].phase = "";
  q.jobs[i].finishedAt = now;
  q.jobs[i].errorCode = code.clone();
  q.jobs[i].error = msg.clone();
  return rqOk(`#${id}（${q.jobs[i].name}）は失敗しました: ${msg}`);
}

// 取り消す。待ちならすぐに、実行中なら取り消しにする（実行している ffmpeg などを止めるのは呼ぶ側。
// 止めるべきかは rqShouldStop で確かめる）。終わった仕事は取り消せない。
export function rqCancel(q: mut RenderQueue, id: i32, now: f64): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  const i = k as usize;
  if (rqIsFinished(q.jobs[i].state)) {
    return rqBadState(q.jobs[i], "取り消", "終わった仕事を一覧から消すなら rqRemove を使います");
  }
  const wasRunning = q.jobs[i].state == RQ_RUNNING;
  q.jobs[i].state = RQ_CANCELED;
  q.jobs[i].phase = "";
  q.jobs[i].finishedAt = now;
  if (wasRunning) {
    return rqOk(`#${id}（${q.jobs[i].name}）を取り消しました（書きかけのファイルは残っているかもしれません）`);
  }
  return rqOk(`#${id}（${q.jobs[i].name}）を取り消しました`);
}

// 実行している処理を止めるべきか（取り消された・ない仕事）。合成や圧縮の途中で呼んで確かめる。
export function rqShouldStop(q: RenderQueue, id: i32): bool {
  const k = rqFind(q, id);
  if (k < 0) {
    return true;
  }
  return q.jobs[k as usize].state != RQ_RUNNING;
}

// やり直す（失敗・取り消しの仕事を待ちの最後に戻す。進み具合と失敗の理由は消す）。
export function rqRetry(q: mut RenderQueue, id: i32, now: f64): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  const i = k as usize;
  const st = q.jobs[i].state;
  if (st != RQ_FAILED && st != RQ_CANCELED) {
    return rqBadState(q.jobs[i], "やり直", "やり直せるのは失敗と取り消しの仕事です");
  }
  q.jobs[i].state = RQ_WAITING;
  q.jobs[i].phase = "";
  q.jobs[i].doneFrames = 0;
  q.jobs[i].rate = 0;
  q.jobs[i].queuedAt = now;
  q.jobs[i].startedAt = 0;
  q.jobs[i].finishedAt = 0;
  q.jobs[i].errorCode = "";
  q.jobs[i].error = "";
  const last = q.jobs.length - 1;
  rqMoveIndex(mut q, i, last);
  return rqOk(`#${id}（${q.jobs[last].name}）を待ちに戻しました`);
}

// 並びを変える（待ちの仕事を始める順）。to は 0 から数えた新しい位置（範囲の外は端）。
export function rqMove(q: mut RenderQueue, id: i32, to: i32): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  let t = to;
  if (t < 0) {
    t = 0;
  }
  if ((t as usize) >= q.jobs.length) {
    t = (q.jobs.length - 1) as i32;
  }
  rqMoveIndex(mut q, k as usize, t as usize);
  return rqOk("");
}

// 一覧から消す（実行中は消せない。先に取り消す）。
export function rqRemove(q: mut RenderQueue, id: i32): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  if (q.jobs[k as usize].state == RQ_RUNNING) {
    return rqBadState(q.jobs[k as usize], "一覧から消せ", "先に rqCancel で取り消します");
  }
  let keep: RenderJob[] = [];
  for (let i: usize = 0; i < q.jobs.length; i++) {
    if (i != (k as usize)) {
      keep.push(rqCloneJob(q.jobs[i]));
    }
  }
  q.jobs = keep;
  return rqOk(`#${id} を一覧から消しました`);
}

// 完了と取り消しの仕事を一覧から消す（失敗は理由を見られるように残す）。消した数を返す。
export function rqClearFinished(q: mut RenderQueue): i32 {
  let keep: RenderJob[] = [];
  let n = 0;
  for (const j of q.jobs) {
    if (j.state == RQ_DONE || j.state == RQ_CANCELED) {
      n++;
    } else {
      keep.push(rqCloneJob(j));
    }
  }
  q.jobs = keep;
  return n;
}

function rqCloneJob(j: RenderJob): RenderJob {
  return {
    id: j.id, name: j.name.clone(), project: j.project.clone(), output: j.output.clone(), presetId: j.presetId.clone(),
    fromSec: j.fromSec, toSec: j.toSec, state: j.state, totalFrames: j.totalFrames, doneFrames: j.doneFrames, fps: j.fps,
    phase: j.phase.clone(), queuedAt: j.queuedAt, startedAt: j.startedAt, finishedAt: j.finishedAt,
    sampleAt: j.sampleAt, sampleFrames: j.sampleFrames, rate: j.rate, lastReportAt: j.lastReportAt, sawFrame: j.sawFrame,
    errorCode: j.errorCode.clone(), error: j.error.clone(), attempts: j.attempts,
  };
}

// jobs[from] を jobs[to] の位置へ動かす（間の仕事はずれる）。
function rqMoveIndex(q: mut RenderQueue, from: usize, to: usize): void {
  if (from == to || from >= q.jobs.length || to >= q.jobs.length) {
    return;
  }
  let order: RenderJob[] = [];
  const moving = rqCloneJob(q.jobs[from]);
  let placed = false;
  let k: usize = 0;
  for (let i: usize = 0; i < q.jobs.length; i++) {
    if (i == from) {
      continue;
    }
    if (k == to && !placed) {
      order.push(rqCloneJob(moving));
      placed = true;
    }
    order.push(rqCloneJob(q.jobs[i]));
    k++;
  }
  if (!placed) {
    order.push(rqCloneJob(moving));
  }
  q.jobs = order;
}

// ---- 進み具合と残り時間 ----

// 進み具合（0..1）。コマ数が未知なら、完了は 1、ほかは 0。
export function rqFraction(j: RenderJob): f64 {
  if (j.state == RQ_DONE) {
    return 1;
  }
  if (j.totalFrames <= 0) {
    return 0;
  }
  return (j.doneFrames as f64) / (j.totalFrames as f64);
}

// 経過した時間（秒）。始めていなければ 0。
export function rqElapsed(j: RenderJob, now: f64): f64 {
  if (j.state == RQ_WAITING || j.startedAt <= 0) {
    return 0;
  }
  if (rqIsFinished(j.state)) {
    return j.finishedAt - j.startedAt;
  }
  return now - j.startedAt;
}

// 仕事の速さの見込み（コマ/秒。0 は未知）。ならした速さがあればそれ、なければ始めてからの平均。
export function rqRate(j: RenderJob, now: f64): f64 {
  if (j.rate > 0) {
    return j.rate;
  }
  const el = rqElapsed(j, now);
  if (el > RQ_RATE_MIN_DT && j.doneFrames > 0) {
    return (j.doneFrames as f64) / el;
  }
  return 0;
}

// 残り時間の見込み（秒）。完了は 0、失敗・取り消しと見込みが立たないものは -1。
// 実行中は（残りのコマ数 ÷ 速さ）から、最後の報告からの経過を引く（報告のあいだも減っていくように）。
export function rqEta(j: RenderJob, now: f64): f64 {
  if (j.state == RQ_DONE) {
    return 0;
  }
  if (j.state != RQ_RUNNING || j.totalFrames <= 0) {
    return -1;
  }
  const r = rqRate(j, now);
  if (r <= 0) {
    return -1;
  }
  let eta = ((j.totalFrames - j.doneFrames) as f64) / r;
  if (j.rate > 0) {
    eta = eta - (now - j.lastReportAt);
  }
  if (eta < 0) {
    eta = 0;
  }
  return eta;
}

// キュー全体の残り時間の見込み（秒。待ちと実行中のすべて）。見込みが立たなければ -1。
// 待ちの仕事の速さは、実行中・完了の仕事の速さ（最後に分かったもの）を使う。同時に実行する数で割る。
export function rqQueueEta(q: RenderQueue, now: f64): f64 {
  let rate: f64 = 0;
  for (const j of q.jobs) {
    if (j.state == RQ_RUNNING) {
      const r = rqRate(j, now);
      if (r > 0) {
        rate = r;
      }
    } else if (j.state == RQ_DONE && rate <= 0) {
      const el = j.finishedAt - j.startedAt;
      if (el > 0 && j.totalFrames > 0) {
        rate = (j.totalFrames as f64) / el;
      }
    }
  }
  let work: f64 = 0;
  let longest: f64 = 0;
  let any = false;
  for (const j of q.jobs) {
    if (j.state == RQ_RUNNING) {
      any = true;
      const e = rqEta(j, now);
      if (e < 0) {
        return -1;
      }
      work = work + e;
      if (e > longest) {
        longest = e;
      }
    } else if (j.state == RQ_WAITING) {
      any = true;
      if (rate <= 0 || j.totalFrames <= 0) {
        return -1;
      }
      work = work + (j.totalFrames as f64) / rate;
    }
  }
  if (!any) {
    return 0;
  }
  let total = work / (q.maxParallel as f64);
  if (total < longest) {
    total = longest;
  }
  return total;
}

// 時間の人向けの表記（"約 5 秒"、"約 1 分 20 秒"、"約 1 時間 5 分"）。負は "見込みなし"。
export function rqDurationText(sec: f64): string {
  if (isNan(sec) || sec < 0) {
    return "見込みなし";
  }
  const s = Math.floor(sec + 0.5) as i64;
  if (s < 1) {
    return "1 秒未満";
  }
  if (s < 60) {
    return `約 ${s} 秒`;
  }
  if (s < 3600) {
    const m = s / 60;
    const r = s % 60;
    if (r == 0) {
      return `約 ${m} 分`;
    }
    return `約 ${m} 分 ${r} 秒`;
  }
  const h = s / 3600;
  const m = (s % 3600) / 60;
  if (m == 0) {
    return `約 ${h} 時間`;
  }
  return `約 ${h} 時間 ${m} 分`;
}

// ---- FFmpeg とのつなぎ口 ----

// 仕事とプリセットから、ffmpeg を起動する仕事を作る。進み具合は -progress pipe:1 で標準出力に出させ、
// その行を rqFfmpegProgress に渡す。y4m と pcm は render が書いた中間のファイル。
export function rqEncodeTask(j: RenderJob, p: Project, preset: ExportPreset, y4m: string, pcm: string): RqEncodeTask {
  let args: string[] = ["-progress", "pipe:1", "-nostats"];
  const enc = exportPresetFfmpegArgs(p, preset, y4m, pcm, j.output);
  for (const a of enc) {
    args.push(a.clone());
  }
  return { jobId: j.id, program: "ffmpeg", args, output: j.output.clone() };
}

// ffmpeg の -progress の 1 行（"frame=120"、"out_time_us=4000000"、"progress=continue"）を進み具合にする。
// frame= を見た仕事はそれを、見ていない仕事（音だけ）は out_time_us × fps をコマ数にする。
// 知らない行・関係のない行は無視して ok を返す。段階は "encode" にする。
export function rqFfmpegProgress(q: mut RenderQueue, id: i32, line: string, now: f64): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  const i = k as usize;
  if (q.jobs[i].state != RQ_RUNNING) {
    return rqBadState(q.jobs[i], "進み具合を報告", "");
  }
  let eq: usize = 0;
  while (eq < line.length && line[eq] != 61) {
    eq++;
  }
  if (eq >= line.length) {
    return rqOk("");
  }
  const key = rqTrim(sub(line, 0, eq));
  const val = rqTrim(sub(line, eq + 1, line.length));
  q.jobs[i].phase = "encode";
  if (key == "frame") {
    const v = parseNum(val);
    if (!isNan(v) && v >= 0) {
      q.jobs[i].sawFrame = true;
      return rqProgress(mut q, id, Math.floor(v) as i64, now);
    }
    return rqOk("");
  }
  if ((key == "out_time_us" || key == "out_time_ms") && !q.jobs[i].sawFrame && q.jobs[i].fps > 0) {
    // ffmpeg の out_time_ms は歴史的な理由でマイクロ秒
    const v = parseNum(val);
    if (!isNan(v) && v >= 0) {
      const frames = Math.floor(v / 1000000.0 * q.jobs[i].fps) as i64;
      return rqProgress(mut q, id, frames, now);
    }
  }
  return rqOk("");
}

function rqTrim(s: string): string {
  let a: usize = 0;
  let b = s.length;
  while (a < b && (s[a] == 32 || s[a] == 9 || s[a] == 13)) {
    a++;
  }
  while (b > a && (s[b - 1] == 32 || s[b - 1] == 9 || s[b - 1] == 13)) {
    b--;
  }
  return sub(s, a, b);
}

// ffmpeg が終わったときに呼ぶ。終了コード 0 なら完了、それ以外は失敗（code は "encode-failed"、
// msg に終了コードと、stderr の最後の行（あれば）を入れる）。取り消した仕事なら何もしない（ok）。
export function rqFfmpegExit(q: mut RenderQueue, id: i32, exitCode: i32, stderrTail: string, now: f64): RqResult {
  const k = rqFind(q, id);
  if (k < 0) {
    return rqUnknown(id);
  }
  if (q.jobs[k as usize].state == RQ_CANCELED) {
    return rqOk("");
  }
  if (exitCode == 0) {
    return rqFinish(mut q, id, now);
  }
  let msg = `ffmpeg が終了コード ${exitCode} で止まりました`;
  const tail = rqTrim(stderrTail);
  if (tail.length > 0) {
    msg = msg + `（${tail}）`;
  }
  return rqFail(mut q, id, "encode-failed", msg, now);
}

// ---- 出力 ----

// 人向けの 1 行（"#3 demo.mp4 — 実行中 45%（1350/3000 コマ、残り 約 1 分 20 秒）"）。
export function rqJobText(j: RenderJob, now: f64): string {
  let s = `#${j.id} ${j.name} — ${rqStateLabel(j.state)}`;
  if (j.state == RQ_RUNNING) {
    const pct = Math.floor(rqFraction(j) * 100) as i64;
    let detail = "";
    if (j.totalFrames > 0) {
      detail = `${pct}%（${j.doneFrames}/${j.totalFrames} コマ、残り ${rqDurationText(rqEta(j, now))}）`;
    } else {
      detail = `（${j.doneFrames} コマ）`;
    }
    if (j.phase == "encode") {
      s = s + " 圧縮 " + detail;
    } else {
      s = s + " " + detail;
    }
  } else if (j.state == RQ_DONE) {
    s = s + `（${rqDurationText(rqElapsed(j, now))}）`;
  } else if (j.state == RQ_FAILED) {
    s = s + `: ${j.error}`;
  }
  return s;
}

// 一覧の人向けの文（1 行に 1 つの仕事。最後に全体の残り時間）。
export function rqQueueText(q: RenderQueue, now: f64): string {
  if (q.jobs.length == 0) {
    return "書き出しの予約はありません";
  }
  let s = "";
  for (const j of q.jobs) {
    s = s + rqJobText(j, now) + "\n";
  }
  const r = rqRunningCount(q);
  const w = rqWaitingCount(q);
  if (r + w > 0) {
    s = s + `実行中 ${r} 件、待ち ${w} 件、残り ${rqDurationText(rqQueueEta(q, now))}`;
  } else {
    s = s + "すべて終わりました";
  }
  return s;
}

// 仕事 1 つの JSON。時間は秒の数、見込みが立たないものは null。
export function rqJobJson(j: RenderJob, now: f64): string {
  let s = `{"id":${j.id},"name":${jsonStr(j.name)},"project":${jsonStr(j.project)},"output":${jsonStr(j.output)}`;
  s = s + `,"preset":${jsonStr(j.presetId)},"from":${jsonNum(j.fromSec)},"to":`;
  if (j.toSec < 0) {
    s = s + "null";
  } else {
    s = s + jsonNum(j.toSec);
  }
  s = s + `,"state":"${rqStateName(j.state)}","stateLabel":${jsonStr(rqStateLabel(j.state))}`;
  if (j.phase.length == 0) {
    s = s + `,"phase":null`;
  } else {
    s = s + `,"phase":${jsonStr(j.phase)}`;
  }
  s = s + `,"totalFrames":${j.totalFrames},"doneFrames":${j.doneFrames},"fraction":${jsonNum(rqFraction(j))}`;
  const rate = rqRate(j, now);
  if (rate > 0 && j.state == RQ_RUNNING) {
    s = s + `,"rate":${jsonNum(rate)}`;
  } else {
    s = s + `,"rate":null`;
  }
  const eta = rqEta(j, now);
  if (eta < 0) {
    s = s + `,"eta":null`;
  } else {
    s = s + `,"eta":${jsonNum(eta)}`;
  }
  s = s + `,"elapsed":${jsonNum(rqElapsed(j, now))},"attempts":${j.attempts}`;
  if (j.state == RQ_FAILED) {
    s = s + `,"error":{"code":${jsonStr(j.errorCode)},"msg":${jsonStr(j.error)}}`;
  } else {
    s = s + `,"error":null`;
  }
  s = s + `,"text":${jsonStr(rqJobText(j, now))}}`;
  return s;
}

// キュー全体の JSON（{"maxParallel":..,"running":..,"waiting":..,"eta":..,"jobs":[...]}）。
export function rqQueueJson(q: RenderQueue, now: f64): string {
  let s = `{"maxParallel":${q.maxParallel},"running":${rqRunningCount(q)},"waiting":${rqWaitingCount(q)},"eta":`;
  const eta = rqQueueEta(q, now);
  if (eta < 0) {
    s = s + "null";
  } else {
    s = s + jsonNum(eta);
  }
  s = s + `,"jobs":[`;
  for (let i: usize = 0; i < q.jobs.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + rqJobJson(q.jobs[i], now);
  }
  return s + "]}";
}

// 操作の結果の JSON（{"ok":..,"code":..,"msg":..,"hint":..}。ok なら code は null）。
export function rqResultJson(r: RqResult): string {
  if (r.ok) {
    return `{"ok":true,"code":null,"msg":${jsonStr(r.msg)},"hint":null}`;
  }
  return `{"ok":false,"code":${jsonStr(r.code)},"msg":${jsonStr(r.msg)},"hint":${jsonStr(r.hint)}}`;
}
