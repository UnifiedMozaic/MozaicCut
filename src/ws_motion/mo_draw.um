// M6 の操作の画面で使う小さな描き方（キーフレームの菱形、取っ手の四角と丸、点線）。
import { UkCtx, ukDrawTri, ukDrawLine, ukDrawRect, ukDrawCircle } from "../uikit/core.um";
import { ukRect } from "../uikit/base.um";

// 塗った菱形（中心 cx, cy、中心から角まで r）。
export function moDiamond(ui: mut UkCtx, cx: f32, cy: f32, r: f32, c: u32): void {
  ukDrawTri(mut ui, cx - r, cy, cx, cy - r, cx + r, cy, c);
  ukDrawTri(mut ui, cx - r, cy, cx + r, cy, cx, cy + r, c);
}

// 縁つきの菱形（縁 edge の 1 つ大きい菱形の上に塗る）。
export function moDiamondEdged(ui: mut UkCtx, cx: f32, cy: f32, r: f32, c: u32, edge: u32): void {
  moDiamond(mut ui, cx, cy, r + 1.5, edge);
  moDiamond(mut ui, cx, cy, r, c);
}

// 輪郭だけの菱形（◇）。
export function moDiamondLine(ui: mut UkCtx, cx: f32, cy: f32, r: f32, t: f32, c: u32): void {
  ukDrawLine(mut ui, cx - r, cy, cx, cy - r, t, c);
  ukDrawLine(mut ui, cx, cy - r, cx + r, cy, t, c);
  ukDrawLine(mut ui, cx + r, cy, cx, cy + r, t, c);
  ukDrawLine(mut ui, cx, cy + r, cx - r, cy, t, c);
}

// 取っ手の四角（白に黒の縁。画面の上の位置・大きさの取っ手、パスの点）。
export function moSquare(ui: mut UkCtx, cx: f32, cy: f32, half: i32, fill: u32, edge: u32): void {
  const x = Math.floor(cx) as i32;
  const y = Math.floor(cy) as i32;
  ukDrawRect(mut ui, ukRect(x - half - 1, y - half - 1, half * 2 + 3, half * 2 + 3), edge);
  ukDrawRect(mut ui, ukRect(x - half, y - half, half * 2 + 1, half * 2 + 1), fill);
}

// 取っ手の丸（塗り＋縁。t <= 0 なら塗り）。
export function moDot(ui: mut UkCtx, cx: f32, cy: f32, r: f32, fill: u32, edge: u32): void {
  ukDrawCircle(mut ui, cx, cy, r + 1.5, 0, edge);
  ukDrawCircle(mut ui, cx, cy, r, 0, fill);
}

// 縁つきの線（黒の太い線の上に色の線。映像の上でも見えるように）。
export function moEdgedLine(ui: mut UkCtx, ax: f32, ay: f32, bx: f32, by: f32, t: f32, c: u32, edge: u32): void {
  ukDrawLine(mut ui, ax, ay, bx, by, t + 2, edge);
  ukDrawLine(mut ui, ax, ay, bx, by, t, c);
}

// 点線（dash の長さで描いて同じだけ空ける）。
export function moDashLine(ui: mut UkCtx, ax: f32, ay: f32, bx: f32, by: f32, t: f32, dash: f32, c: u32): void {
  const dx = bx - ax;
  const dy = by - ay;
  const len = Math.sqrt(dx * dx + dy * dy);
  if (len <= 0) {
    return;
  }
  const n = Math.floor(len / (dash * 2)) as i32 + 1;
  for (let i = 0; i < n; i++) {
    const a = (i as f32) * dash * 2 / len;
    const b = Math.min(((i as f32) * dash * 2 + dash) / len, 1.0);
    ukDrawLine(mut ui, ax + dx * a, ay + dy * a, ax + dx * b, ay + dy * b, t, c);
  }
}
