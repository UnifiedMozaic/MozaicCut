// (4) モニターの上の変形のギズモ: 位置・大きさ・回転を直接つかんで動かす。
//
// - 枠の中をドラッグ: 位置（shape で pos= を使うなら pos、ほかは x / y。x / y は箱の左上の画素で書く）
// - 角の四角をドラッグ: 大きさ（scale。anchor を中心に、つかんだ点と anchor の距離の比。横と縦の比は保つ）
// - 上の丸をドラッグ: 回転（rotation。anchor のまわりの角度。Shift で 15 度ずつ）
// 大きさと回転は shape と、3D でない video / image / text / color（2D の変形。m6_xform/xform2d.um）で使える。
// 途中は MO_E_PREVIEW、離したら MO_E_OP。値を決める操作は moOpValue（キーフレームのあるキーならその時刻に key add、
// なければ set）。時刻は再生ヘッドをコマに合わせたもの。Esc でやめる。
import {
  UkCtx, ukBehavior, ukIdInt, ukDrawText, ukLineH, ukSetCursor, ukTooltip, ukKeyTake, ukMouseIn,
  UK_KEY_ESC, UK_MOD_SHIFT, UK_CURSOR_MOVE, UK_CURSOR_CROSSHAIR,
} from "../uikit/core.um";
import { UkRect, ukRect, ukAlpha } from "../uikit/base.um";
import { Project, Clip, KIND_SHAPE } from "../project.um";
import { T3L_RZ, T3L_SCALE } from "../m6_3d/t3parse.um";
import {
  MoTheme, MoEvent, MoView, moEv, moRef, moSnap, moNum, moFps, moOpValue, moToScreenX, moToScreenY, moFromScreenX, moFromScreenY,
  MO_E_OP, MO_E_PREVIEW, MO_E_CANCEL,
} from "./mo_core.um";
import { MoXf, moClipXfSized, moXfApply, moXfInside, moAngle } from "./mo_geom.um";
import { moSquare, moDot, moEdgedLine, moDashLine } from "./mo_draw.um";

const MO_Z_NONE: i32 = 0;
const MO_Z_MOVE: i32 = 1;
const MO_Z_SCALE: i32 = 2;
const MO_Z_ROT: i32 = 3;

export struct MoGizmoState {
  mode: i32;
  dragging: bool;
  cancelled: bool;
  // つかんだときの値
  ax: f64;
  ay: f64;
  left: f64;
  top: f64;
  scale: f64;
  scaleY: f64;
  rot: f64;
  pressX: f64;     // つかんだ点（キャンバス）
  pressY: f64;
  last: string;
  label: string;   // ドラッグ中に出す値
}

export function moGizmoStateNew(): MoGizmoState {
  return { mode: MO_Z_NONE, dragging: false, cancelled: false, ax: 0, ay: 0, left: 0, top: 0, scale: 1, scaleY: 1, rot: 0, pressX: 0, pressY: 0, last: "", label: "" };
}

// ギズモがつかんでいる（ドラッグ中）か。モニターの部品が、ほかのクリップを選ぶクリックと分けるのに使う。
export function moGizmoBusy(st: MoGizmoState): bool {
  return st.mode != MO_Z_NONE;
}

// 今のドラッグの値の操作。
function moGizmoOps(c: Clip, xf: MoXf, st: MoGizmoState, mx: f64, my: f64, shift: bool, lt: f64, lab: mut string[]): string[] {
  let ops: string[] = [];
  const dx = mx - st.pressX;
  const dy = my - st.pressY;
  if (st.mode == MO_Z_MOVE) {
    if (xf.usePos) {
      const nx = st.ax + dx;
      const ny = st.ay + dy;
      ops.push(moOpValue(c, "pos", lt, moNum(nx, 1) + "," + moNum(ny, 1)));
      lab[0] = `pos ${moNum(nx, 1)}, ${moNum(ny, 1)}`;
    } else {
      const nx = Math.floor(st.left + dx + 0.5);
      const ny = Math.floor(st.top + dy + 0.5);
      if (nx != Math.floor(st.left + 0.5)) {
        ops.push(moOpValue(c, "x", lt, moNum(nx, 0)));
      }
      if (ny != Math.floor(st.top + 0.5)) {
        ops.push(moOpValue(c, "y", lt, moNum(ny, 0)));
      }
      lab[0] = `x ${moNum(nx, 0)}  y ${moNum(ny, 0)}`;
    }
  } else if (st.mode == MO_Z_SCALE) {
    const d0 = Math.sqrt((st.pressX - st.ax) * (st.pressX - st.ax) + (st.pressY - st.ay) * (st.pressY - st.ay));
    const d1 = Math.sqrt((mx - st.ax) * (mx - st.ax) + (my - st.ay) * (my - st.ay));
    if (d0 > 1e-6) {
      let s = st.scale * d1 / d0;
      if (shift) {
        s = Math.floor(s * 10 + 0.5) / 10;
      }
      // 横と縦が違えば、比を保って両方を書く（2D の scale=横,縦）
      let val = moNum(s, 3);
      if (!xf.shape && st.scale != st.scaleY && Math.abs(st.scale) > 1e-9) {
        val = val + "," + moNum(s * st.scaleY / st.scale, 3);
      }
      ops.push(moXfOpValue(c, "scale", lt, val));
      lab[0] = `scale ${val}`;
    }
  } else if (st.mode == MO_Z_ROT) {
    const a0 = moAngle(st.pressY - st.ay, st.pressX - st.ax);
    const a1 = moAngle(my - st.ay, mx - st.ax);
    let da = a1 - a0;
    while (da > 180) {
      da = da - 360;
    }
    while (da < -180) {
      da = da + 360;
    }
    let r = st.rot + da;
    if (shift) {
      r = Math.floor(r / 15 + 0.5) * 15;
    }
    ops.push(moXfOpValue(c, "rotation", lt, moNum(r, 2)));
    lab[0] = `rotation ${moNum(r, 1)}°`;
  }
  return ops;
}

// rotation / scale の値を決める操作。2D の変形のキー（Clip.d3 のトラック）にキーフレーム（値@時刻）があれば、
// その時刻に key add（moOpValue は Clip.anims だけを見るので、shape 以外ではここで分ける）。
function moXfOpValue(c: Clip, key: string, lt: f64, val: string): string {
  if (c.kind != KIND_SHAPE) {
    let k = T3L_RZ;
    if (key == "scale") {
      k = T3L_SCALE;
    }
    if (c.d3.tracks[k as usize].ts.length > 0 && !c.d3.tracks[k as usize].stat) {
      return `key add ${moRef(c)} ${key} ${moNum(lt, 4)} ${val}`;
    }
  }
  return moOpValue(c, key, lt, val);
}

function moJoin(ops: string[]): string {
  let s = "";
  for (const o of ops) {
    s = s + o + " | ";
  }
  return s;
}

// クリップ ci のギズモを描き、出来事を返す。lt はクリップの始まりからの秒、view はキャンバス → 画面、area はモニターの四角
// （この外でドラッグが始まらないように）。mw・mh は video / image の展開した素材の大きさ（分からなければ 0。moClipXfSized）。
export function moGizmo(ui: mut UkCtx, th: MoTheme, p: Project, ci: usize, lt: f64, mw: i32, mh: i32, view: MoView, area: UkRect, st: mut MoGizmoState): MoEvent[] {
  let out: MoEvent[] = [];
  const xf = moClipXfSized(p, ci, lt, mw, mh);
  if (!xf.ok) {
    return out;
  }
  const fps = moFps(p);
  const ltS = moSnap(lt, fps);
  const ref = moRef(p.clips[ci]);
  const b = xf.box.clone();
  // 角（左上・右上・右下・左下）
  let cx: f32[] = [];
  let cy: f32[] = [];
  const lxs: f64[] = [b[0], b[2], b[2], b[0]];
  const lys: f64[] = [b[1], b[1], b[3], b[3]];
  for (let k: usize = 0; k < 4; k++) {
    const q = moXfApply(xf, lxs[k], lys[k]);
    cx.push(moToScreenX(view, q[0]));
    cy.push(moToScreenY(view, q[1]));
  }
  // 回転の取っ手: 上の辺の中央から外へ 24 画素
  const tq = moXfApply(xf, (b[0] + b[2]) * 0.5, b[1]);
  const tmx = moToScreenX(view, tq[0]);
  const tmy = moToScreenY(view, tq[1]);
  const acx = moToScreenX(view, xf.ax);
  const acy = moToScreenY(view, xf.ay);
  let ux = tmx - acx;
  let uy = tmy - acy;
  const ul = Math.sqrt(ux * ux + uy * uy);
  if (ul > 1e-3) {
    ux = ux / ul;
    uy = uy / ul;
  } else {
    ux = 0;
    uy = -1;
  }
  if (xf.sy < 0) {
    ux = -ux;
    uy = -uy;
  }
  const rhx = tmx + ux * 24;
  const rhy = tmy + uy * 24;
  const mxC = moFromScreenX(view, ui.inp.mx);
  const myC = moFromScreenY(view, ui.inp.my);
  const shift = (ui.inp.mods & UK_MOD_SHIFT) != 0;
  let modeHover = MO_Z_NONE;
  // 取っ手を先に（押したときに枠の中より先に取る）
  let ids: u32[] = [];
  let hits: i32[] = [];
  if (xf.shape || xf.xf2d) {
    for (let k: usize = 0; k < 4; k++) {
      const id = ukIdInt(ui, "moz.corner." + ref, k as i32);
      const h = ukBehavior(mut ui, id, ukRect((cx[k] as i32) - th.hit, (cy[k] as i32) - th.hit, th.hit * 2 + 1, th.hit * 2 + 1), false);
      if (h.hover) {
        modeHover = MO_Z_SCALE;
        ukTooltip(mut ui, "大きさ（Shift で 0.1 ずつ）");
      }
      if (h.pressed) {
        moGizmoGrab(mut st, MO_Z_SCALE, xf, p.clips[ci], lt, mxC, myC);
      }
      ids.push(id);
      hits.push(h.held ? 1 : 0);
    }
    const rid = ukIdInt(ui, "moz.rot." + ref, 0);
    const rh = ukBehavior(mut ui, rid, ukRect((rhx as i32) - th.hit, (rhy as i32) - th.hit, th.hit * 2 + 1, th.hit * 2 + 1), false);
    if (rh.hover) {
      modeHover = MO_Z_ROT;
      ukTooltip(mut ui, "回転（Shift で 15 度ずつ）");
    }
    if (rh.pressed) {
      moGizmoGrab(mut st, MO_Z_ROT, xf, p.clips[ci], lt, mxC, myC);
    }
    ids.push(rid);
    hits.push(rh.held ? 1 : 0);
  }
  const inside = moXfInside(xf, mxC, myC) && ukMouseIn(ui, area);
  let bx0 = Math.min(Math.min(cx[0], cx[1]), Math.min(cx[2], cx[3])) as i32;
  let by0 = Math.min(Math.min(cy[0], cy[1]), Math.min(cy[2], cy[3])) as i32;
  let bx1 = Math.max(Math.max(cx[0], cx[1]), Math.max(cx[2], cx[3])) as i32;
  let by1 = Math.max(Math.max(cy[0], cy[1]), Math.max(cy[2], cy[3])) as i32;
  const bodyR = inside ? ukRect(bx0, by0, bx1 - bx0 + 1, by1 - by0 + 1) : ukRect(0, 0, 0, 0);
  const bid = ukIdInt(ui, "moz.body." + ref, 0);
  const bh = ukBehavior(mut ui, bid, bodyR, false);
  if (bh.hover && modeHover == MO_Z_NONE) {
    modeHover = MO_Z_MOVE;
  }
  if (bh.pressed) {
    moGizmoGrab(mut st, MO_Z_MOVE, xf, p.clips[ci], lt, mxC, myC);
  }
  ids.push(bid);
  hits.push(bh.held ? 1 : 0);
  let held = false;
  for (const hv of hits) {
    if (hv != 0) {
      held = true;
    }
  }
  if (modeHover == MO_Z_MOVE || st.mode == MO_Z_MOVE) {
    ukSetCursor(mut ui, UK_CURSOR_MOVE);
  } else if (modeHover != MO_Z_NONE || st.mode != MO_Z_NONE) {
    ukSetCursor(mut ui, UK_CURSOR_CROSSHAIR);
  }
  // ドラッグ
  if (st.mode != MO_Z_NONE) {
    if (held && !st.cancelled) {
      if (ukKeyTake(mut ui, UK_KEY_ESC)) {
        st.cancelled = true;
        if (st.dragging) {
          out.push(moEv(MO_E_CANCEL, [], 0, 0, ""));
        }
        st.dragging = false;
      } else {
        const moved = Math.abs(ui.inp.mx - ui.activeX) + Math.abs(ui.inp.my - ui.activeY) >= 2;
        if (moved || st.dragging) {
          st.dragging = true;
          let lab: string[] = [""];
          const ops = moGizmoOps(p.clips[ci], xf, st, mxC, myC, shift, ltS, mut lab);
          st.label = lab[0].clone();
          const j = moJoin(ops);
          if (j != st.last && ops.length > 0) {
            st.last = j.clone();
            out.push(moEv(MO_E_PREVIEW, ops, 0, 0, ""));
          }
        }
      }
    }
    if (!held) {
      if (st.dragging && !st.cancelled) {
        let lab: string[] = [""];
        const ops = moGizmoOps(p.clips[ci], xf, st, mxC, myC, shift, ltS, mut lab);
        if (ops.length > 0) {
          out.push(moEv(MO_E_OP, ops, 0, 0, `${ref} を ${lab[0]} にする`));
        }
      }
      st.mode = MO_Z_NONE;
      st.dragging = false;
      st.last = "";
    }
  }
  // 描く
  for (let k: usize = 0; k < 4; k++) {
    const n = (k + 1) % 4;
    moEdgedLine(mut ui, cx[k], cy[k], cx[n], cy[n], 1.2, th.accent, ukAlpha(th.edge, 160));
  }
  // anchor（十字と丸）
  moEdgedLine(mut ui, acx - 7, acy, acx + 7, acy, 1, th.handle, th.edge);
  moEdgedLine(mut ui, acx, acy - 7, acx, acy + 7, 1, th.handle, th.edge);
  if (xf.shape || xf.xf2d) {
    moDashLine(mut ui, tmx, tmy, rhx, rhy, 1, 3, th.accent);
    moDot(mut ui, rhx, rhy, 4.5, modeHover == MO_Z_ROT || st.mode == MO_Z_ROT ? th.accent : th.handle, th.edge);
    for (let k: usize = 0; k < 4; k++) {
      moSquare(mut ui, cx[k], cy[k], 3, th.handle, th.edge);
    }
  }
  if (st.dragging && st.label != "") {
    const lh = ukLineH(ui, th.fsSm);
    ukDrawText(mut ui, bx0, by1 + 6, st.label, th.fsSm, th.handle);
    ukDrawText(mut ui, bx0, by1 + 6 + lh, `${moNum(ltS, 3)} 秒`, th.fsXs, ukAlpha(th.handle, 180));
  }
  return out;
}

function moGizmoGrab(st: mut MoGizmoState, mode: i32, xf: MoXf, c: Clip, lt: f64, mx: f64, my: f64): void {
  st.mode = mode;
  st.dragging = false;
  st.cancelled = false;
  st.ax = xf.ax;
  st.ay = xf.ay;
  st.left = xf.left;
  st.top = xf.top;
  st.scale = xf.sx;
  st.scaleY = xf.sy;
  st.rot = xf.rot;
  st.pressX = mx;
  st.pressY = my;
  st.last = "";
  st.label = "";
}
