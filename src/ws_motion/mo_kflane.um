// (1) タイムラインのクリップの上のキーフレームの印。
//
// タイムラインの部品がクリップの四角を描いたあとで moKfOnClip を呼ぶ。キーフレームのあるキーごとに 1 段（クリップが
// 低ければ 1 段にまとめる）で菱形を出し、左右のドラッグでキーの時刻を動かす（コマに合わせる。Shift で合わせない）。
// - 押して離す: そのキーを選び（MO_E_SELECT）、再生ヘッドをキーへ（MO_E_SEEK）
// - ドラッグ: 途中は MO_E_PREVIEW（key move）、離したら MO_E_OP（key move <クリップ> <キー> #番号 <秒>）。Esc でやめる
// - 選んだキーの上で Delete: key remove（最後の 1 つなら key clear）
import {
  UkCtx, ukBehavior, ukIdInt, ukDrawRect, ukDrawText, ukLineH, ukKeyTake, ukMouseIn, ukSetCursor, ukTooltip,
  UK_KEY_DELETE, UK_KEY_BACKSPACE, UK_KEY_ESC, UK_MOD_SHIFT, UK_CURSOR_RESIZE_EW,
} from "../uikit/core.um";
import { UkRect, ukRect, ukAlpha } from "../uikit/base.um";
import { Clip } from "../project.um";
import {
  MoTheme, MoEvent, moEv, moRef, moSnap, moNum, moTimeLabel, MO_E_OP, MO_E_PREVIEW, MO_E_SEEK, MO_E_SELECT, MO_E_CANCEL,
} from "./mo_core.um";
import { moDiamondEdged } from "./mo_draw.um";

export struct MoKfState {
  // 選んだキー（キーの名前と番号。"" なら選んでいない）
  selKey: string;
  selIdx: i32;
  // ドラッグ中のキー
  dragKey: string;
  dragIdx: i32;
  dragT0: f64;
  dragT: f64;
  dragging: bool;
  cancelled: bool;
  // 動かせる範囲（前後のキーの 1 コマ内側。並びを変えない）
  tMin: f64;
  tMax: f64;
}

export function moKfStateNew(): MoKfState {
  return { selKey: "", selIdx: -1, dragKey: "", dragIdx: -1, dragT0: 0, dragT: 0, dragging: false, cancelled: false, tMin: -1.0e9, tMax: 1.0e9 };
}

// 段の y（中心）。n 段をクリップの名前の帯（上 16 画素）の下に並べる。入らなければ全部を真ん中の 1 段にする。
function moKfRowY(r: UkRect, i: i32, n: i32, top: i32): f32 {
  const avail = r.h - top - 2;
  if (n <= 1 || avail < n * 9) {
    return (r.y as f32) + (r.h as f32) * 0.5 + (top as f32) * 0.25;
  }
  const step = (avail as f32) / (n as f32);
  return (r.y + top) as f32 + step * ((i as f32) + 0.5);
}

// clipR はクリップの四角（左の端がクリップの始まり）、pxPerSec はタイムラインの 1 秒の画素、fps はコマの数。
export function moKfOnClip(ui: mut UkCtx, th: MoTheme, c: Clip, clipR: UkRect, pxPerSec: f64, fps: f64, st: mut MoKfState): MoEvent[] {
  let out: MoEvent[] = [];
  const n = c.anims.length as i32;
  if (n == 0 || pxPerSec <= 0) {
    return out;
  }
  const top = Math.min(16, clipR.h / 3);
  const r = th.kf as f32;
  // 選んだ段の地を薄く
  for (let i = 0; i < n; i++) {
    const a = i as usize;
    const key = c.anims[a].key.clone();
    const cy = moKfRowY(clipR, i, n, top);
    if (n > 1 && clipR.h - top - 2 >= n * 9) {
      if (st.selKey == key) {
        ukDrawRect(mut ui, ukRect(clipR.x, (cy as i32) - 4, clipR.w, 9), ukAlpha(th.accent, 40));
      }
      // 段の名前（幅があれば左の端に）
      if (clipR.w > 120 && clipR.h - top - 2 >= n * 14) {
        ukDrawText(mut ui, clipR.x + th.kf * 2 + 4, (cy as i32) - ukLineH(ui, th.fsXs) / 2, key, th.fsXs, ukAlpha(th.text1, 150));
      }
    }
    const nk = c.anims[a].track.keys.length;
    for (let k: usize = 0; k < nk; k++) {
      const kt = c.anims[a].track.keys[k].t;
      const id = ukIdInt(ui, "mokf." + moRef(c) + "." + key, k as i32);
      const x0 = (clipR.x as f64) + kt * pxPerSec;
      const hr = ukRect((x0 as i32) - th.hit, (cy as i32) - th.hit, th.hit * 2 + 1, th.hit * 2 + 1);
      const h = ukBehavior(mut ui, id, hr, false);
      const mine = st.dragKey == key && st.dragIdx == (k as i32);
      if (h.hover) {
        ukSetCursor(mut ui, UK_CURSOR_RESIZE_EW);
        ukTooltip(mut ui, `${key} #${k}  ${moTimeLabel(kt, fps)}（${moNum(kt, 3)} 秒）`);
      }
      if (h.pressed) {
        st.dragKey = key.clone();
        st.dragIdx = k as i32;
        st.dragT0 = kt;
        st.dragT = kt;
        st.dragging = false;
        st.cancelled = false;
        st.tMin = k > 0 ? c.anims[a].track.keys[k - 1].t + 1.0 / fps : -1.0e9;
        st.tMax = k + 1 < nk ? c.anims[a].track.keys[k + 1].t - 1.0 / fps : 1.0e9;
      }
      if (h.held && mine && !st.cancelled) {
        if (ukKeyTake(mut ui, UK_KEY_ESC)) {
          st.cancelled = true;
          if (st.dragging) {
            out.push(moEv(MO_E_CANCEL, [], 0, 0, ""));
          }
          st.dragging = false;
        } else {
          const dx = (ui.inp.mx - ui.activeX) as f64;
          if (Math.abs(dx) >= 3 || st.dragging) {
            let nt = st.dragT0 + dx / pxPerSec;
            if ((ui.inp.mods & UK_MOD_SHIFT) == 0) {
              nt = moSnap(nt, fps);
            }
            nt = Math.min(Math.max(nt, st.tMin), st.tMax);
            if (!st.dragging || nt != st.dragT) {
              st.dragging = true;
              st.dragT = nt;
              out.push(moEv(MO_E_PREVIEW, [`key move ${moRef(c)} ${key} #${k} ${moNum(nt, 4)}`], 0, 0, ""));
            }
          }
        }
      }
      if (!h.held && mine && st.dragKey != "") {
        // 離した
        if (st.dragging && !st.cancelled && st.dragT != st.dragT0) {
          out.push(moEv(MO_E_OP, [`key move ${moRef(c)} ${key} #${k} ${moNum(st.dragT, 4)}`], 0, 0, `${key} のキーを動かす`));
        } else if (!st.cancelled && h.clicked) {
          st.selKey = key.clone();
          st.selIdx = k as i32;
          out.push(moEv(MO_E_SELECT, [], c.at + kt, k as i32, key.clone()));
          out.push(moEv(MO_E_SEEK, [], c.at + kt, 0, ""));
        }
        st.dragKey = "";
        st.dragIdx = -1;
        st.dragging = false;
      }
      // 描く（ドラッグ中は元の所を薄く、動かす先を強く）
      const sel = st.selKey == key && st.selIdx == (k as i32);
      let col = sel ? th.accent : th.text1;
      if (h.hover && !sel) {
        col = th.handle;
      }
      if (mine && st.dragging) {
        moDiamondEdged(mut ui, x0 as f32, cy, r, ukAlpha(th.text1, 90), th.edge);
        const xn = (clipR.x as f64) + st.dragT * pxPerSec;
        moDiamondEdged(mut ui, xn as f32, cy, r, th.accent, th.edge);
        ukDrawText(mut ui, (xn as i32) + th.kf + 3, (cy as i32) - ukLineH(ui, th.fsXs) - 2, moTimeLabel(st.dragT, fps), th.fsXs, th.text1);
      } else {
        moDiamondEdged(mut ui, x0 as f32, cy, r, col, th.edge);
      }
    }
  }
  // 選んだキーを消す（クリップの上にマウスがあるとき）
  if (st.selKey != "" && ukMouseIn(ui, clipR)) {
    const ai = moKfAnim(c, st.selKey);
    if (ai >= 0 && (ukKeyTake(mut ui, UK_KEY_DELETE) || ukKeyTake(mut ui, UK_KEY_BACKSPACE))) {
      const a = ai as usize;
      if (c.anims[a].track.keys.length <= 1) {
        out.push(moEv(MO_E_OP, [`key clear ${moRef(c)} ${st.selKey}`], 0, 0, `${st.selKey} のキーフレームをやめる`));
      } else {
        out.push(moEv(MO_E_OP, [`key remove ${moRef(c)} ${st.selKey} #${st.selIdx}`], 0, 0, `${st.selKey} のキーを消す`));
      }
      st.selKey = "";
      st.selIdx = -1;
    }
  }
  return out;
}

function moKfAnim(c: Clip, key: string): i32 {
  for (let i: usize = 0; i < c.anims.length; i++) {
    if (c.anims[i].key == key) {
      return i as i32;
    }
  }
  return -1;
}
