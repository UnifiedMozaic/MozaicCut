// シェイプレイヤーの小さな道具: 三角関数（UM の Math には sqrt / floor / ceil / abs / min / max しかない）、
// 数・色・点の読み取り。形の計算（CPU）だけで使い、kernel では使わない。
// 名前の空間は全ファイルで 1 つなので、すべて sh を前に付ける。
// 色の読み取りはコア（text.um の parseColor）と同じものを使う（text / color の行と受け付ける書き方をそろえる）。
import { parseColor } from "../text.um";

// 座標・長さとして受け付ける値の大きさの上限（パスの座標・anchor・pos・グラデーションの点・破線）。
export const SH_COORD_MAX: f64 = 1000000.0;

export const SH_PI: f64 = 3.141592653589793;
export const SH_TAU: f64 = 6.283185307179586;

// sin（f64）。[-π/2, π/2] に寄せてから級数（x^19 まで。誤差は 1e-15 ほど）。
export function shSin(x0: f64): f64 {
  let x = x0;
  if (x != x || x > 1.0e15 || x < -1.0e15) {
    return 0;
  }
  const k = Math.floor(x / SH_TAU + 0.5);
  x = x - k * SH_TAU;
  if (x > SH_PI * 0.5) {
    x = SH_PI - x;
  } else if (x < -SH_PI * 0.5) {
    x = -SH_PI - x;
  }
  const x2 = x * x;
  let term = x;
  let sum = x;
  for (let n = 1; n <= 9; n++) {
    const a = (2 * n) as f64;
    term = -term * x2 / (a * (a + 1.0));
    sum = sum + term;
  }
  return sum;
}

export function shCos(x: f64): f64 {
  return shSin(x + SH_PI * 0.5);
}

// atan（|z| <= 1）。半角の公式で 2 回小さくしてから級数。
function shAtanUnit(z: f64): f64 {
  let t = z;
  t = t / (1.0 + Math.sqrt(1.0 + t * t));
  t = t / (1.0 + Math.sqrt(1.0 + t * t));
  // |t| <= tan(π/16) ≈ 0.199
  const t2 = t * t;
  let term = t;
  let sum = t;
  for (let n = 1; n <= 12; n++) {
    term = -term * t2;
    sum = sum + term / ((2 * n + 1) as f64);
  }
  return sum * 4.0;
}

export function shAtan2(y: f64, x: f64): f64 {
  if (x == 0 && y == 0) {
    return 0;
  }
  const ax = Math.abs(x);
  const ay = Math.abs(y);
  let a: f64 = 0;
  if (ay <= ax) {
    a = shAtanUnit(ay / ax);
  } else {
    a = SH_PI * 0.5 - shAtanUnit(ax / ay);
  }
  if (x < 0) {
    a = SH_PI - a;
  }
  if (y < 0) {
    a = -a;
  }
  return a;
}

export function shTan(x: f64): f64 {
  return shSin(x) / shCos(x);
}

// ---- 文字列 ----

export function shSub(s: string, a: usize, b: usize): string {
  let out: u8[] = [];
  for (let i = a; i < b && i < s.length; i++) {
    out.push(s[i]);
  }
  return stringFromBytes(out);
}

export struct ShNum {
  ok: bool;
  v: f64;
}

// 数。符号・小数・指数（1e3）。前後の空白は許さない（項目は shTrimSpace してから渡す）。有限でなければ読めない。
export function shParseNum(s: string): ShNum {
  const n = s.length;
  let i: usize = 0;
  let neg = false;
  if (n > 0 && s[0] == 45) {
    neg = true;
    i = 1;
  } else if (n > 0 && s[0] == 43) {
    i = 1;
  }
  let v: f64 = 0;
  let digits = 0;
  while (i < n && s[i] >= 48 && s[i] <= 57) {
    v = v * 10 + ((s[i] - 48) as f64);
    i++;
    digits++;
  }
  if (i < n && s[i] == 46) {
    i++;
    let scale: f64 = 0.1;
    while (i < n && s[i] >= 48 && s[i] <= 57) {
      v = v + ((s[i] - 48) as f64) * scale;
      scale = scale * 0.1;
      i++;
      digits++;
    }
  }
  if (digits == 0) {
    return { ok: false, v: 0 };
  }
  if (i < n && (s[i] == 101 || s[i] == 69)) {
    i++;
    let eneg = false;
    if (i < n && s[i] == 45) {
      eneg = true;
      i++;
    } else if (i < n && s[i] == 43) {
      i++;
    }
    let e = 0;
    let ed = 0;
    while (i < n && s[i] >= 48 && s[i] <= 57) {
      if (e <= 400) {
        e = e * 10 + ((s[i] - 48) as i32);
      }
      i++;
      ed++;
    }
    if (ed == 0) {
      return { ok: false, v: 0 };
    }
    for (let k = 0; k < e; k++) {
      if (eneg) {
        v = v / 10;
      } else {
        v = v * 10;
      }
    }
  }
  if (i != n) {
    return { ok: false, v: 0 };
  }
  // 有限でない値（1e400 など）は数として受け付けない
  if (v - v != 0.0) {
    return { ok: false, v: 0 };
  }
  if (neg) {
    v = -v;
  }
  return { ok: true, v };
}

function shIsBlank(c: u8): bool {
  return c == 32 || c == 9 || c == 10 || c == 13;
}

// 前後の空白を取り除く（"#ff0000, #0000ff" のようにコンマのあとに空白を入れた書き方も読めるように）。
export function shTrimSpace(s: string): string {
  let a: usize = 0;
  let b = s.length;
  while (a < b && shIsBlank(s[a])) {
    a++;
  }
  while (b > a && shIsBlank(s[b - 1])) {
    b--;
  }
  return shSub(s, a, b);
}

// "x,y" の点。1 つだけ（"5"）なら両方に同じ値。項目の前後の空白は許す（"0, -200"）。
export struct ShPoint {
  ok: bool;
  x: f64;
  y: f64;
}

export function shParsePoint(s: string): ShPoint {
  let comma: usize = s.length;
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 44) {
      comma = i;
      break;
    }
  }
  if (comma == s.length) {
    const a = shParseNum(shTrimSpace(s));
    return { ok: a.ok, x: a.v, y: a.v };
  }
  const a = shParseNum(shTrimSpace(shSub(s, 0, comma)));
  const b = shParseNum(shTrimSpace(shSub(s, comma + 1, s.length)));
  return { ok: a.ok && b.ok, x: a.v, y: b.v };
}

// 色（0xRRGGBBAA）。コアの parseColor（text.um）と同じ書き方: 名前（white black red green blue yellow gray transparent）、
// #rrggbb、#rrggbbaa（# は省ける）。前後の空白は取り除く。読めなければ -1。"none" は塗りの側で先に扱う。
export function shParseColor(s0: string): i64 {
  const s = shTrimSpace(s0);
  if (s == "none") {
    return -1;
  }
  return parseColor(s);
}

// 小数を短い文字列に（説明・JSON 用。小数 4 桁で丸め、末尾の 0 を落とす）。
export function shNumText(v: f64): string {
  let neg = v < 0;
  let a = Math.abs(v);
  let whole = Math.floor(a);
  let frac = Math.floor((a - whole) * 10000.0 + 0.5);
  if (frac >= 10000.0) {
    whole = whole + 1.0;
    frac = 0;
  }
  let s = String(whole as i64);
  if (frac > 0) {
    let f = frac as i64;
    let digits: u8[] = [];
    for (let k = 0; k < 4; k++) {
      digits.push((48 + (f % 10)) as u8);
      f = f / 10;
    }
    // 逆順に並んでいるので、末尾（= digits の先頭）の 0 を落としてから逆に並べる
    let start: usize = 0;
    while (start < digits.length && digits[start] == 48) {
      start++;
    }
    let out: u8[] = [];
    out.push(46);
    let j = digits.length;
    while (j > start) {
      j--;
      out.push(digits[j]);
    }
    s = s + stringFromBytes(out);
  }
  if (neg && (whole > 0 || frac > 0)) {
    s = "-" + s;
  }
  return s;
}
