// 素材の読み手（境界）。映像のコマ・画像・音を、どこから来たかを知らずに読むための形。
//
// 実装は 2 つ。
// - MEDIA_BACKEND_FFMPEG: FFmpeg の組み込み（ffmpeg.um）で素材のファイルを直接開き、その場で展開する。
//   クリップが素材のファイルの場所（Clip.file。mediaProbeSources が調べたもの）を持つときに使う。
//   映像はプロジェクトのコマの速さの「n 番目のコマ」を、素材の in + (n + 0.5) / fps 秒に表示されるコマとして読み
//   （ffmpeg の fps フィルタの near の丸めと同じコマ）、クリップの w / h / fit に合わせて拡大縮小（cover は切り抜き）する。
//   YUV は素材の色の行列と範囲のまま受け取り、変換の係数（mediaYuvK1 / mediaYuvK2）を描画の kernel に渡す。
//   画像は開いたときに 1 度だけ展開して持っておく。音はプロジェクトの rate のステレオの f32 で読む。
// - MEDIA_BACKEND_CACHE（予備。FFmpeg なしの版と、素材のファイルがない試験の素材）: tools/mozcut.mjs が ffmpeg で
//   展開したキャッシュを読む:
//   映像 <cache>/clip<i>.y4m  Y4M（YUV 4:2:0、8 ビット、BT.709 リミテッドレンジ）。<file>.in に展開した範囲の始まり（素材の秒）
//   画像 <cache>/clip<i>.pam  PAM（RGBA 8 ビット、ストレートアルファ）
//   音   <cache>/clip<i>.pcm  s16le のインターリーブ（既定はステレオ、プロジェクトの rate）。先頭がクリップの 0 秒
// 描画（render.um の drawVideo / drawImage）と音のミックス（audio.um）は、ここを通して読む。
//
// どちらの実装も下の関数の中で backend を見て分ける。呼ぶ側（playback.um、render.um、audio.um）は実装を知らずに
// 次の約束で使う:
//
//   開く   mediaOpenClip(p, cache, index, kind, mode) … プロジェクトのクリップ（index 番目）の素材を、種類 kind
//            （KIND_VIDEO / KIND_IMAGE / KIND_AUDIO。映像のクリップの音は KIND_AUDIO）として開く。mode は MEDIA_OPEN_*
//          mediaOpenY4m(path) / mediaOpenPam(path) / mediaOpenPcm(path, rate, channels) … キャッシュのファイルを直接開く
//          失敗しても MediaSource を返す（ok = false、err に日本語の理由）。例外はない。
//   情報   MediaSource のフィールド（w, h, pix, fpsNum/fpsDen, frames, frameBytes, inPt, rate, channels, samples）と、
//          mediaSourceText(m)（人向けの 1 行）/ mediaSourceJson(m)（機械向け）
//   コマ   mediaReadFrame(m, n, mut out: Buffer<u8>): bool      … n 番目（0 始まり）のコマを out の先頭に書く
//          mediaReadFrameRacy(m, n, out: RacyBuffer<u32>, offset): bool … 先読みのスレッドが、共有のコマの置き場に書く版
//            （4 バイトずつ u32 に詰める。リトルエンディアン: バイト j は out[offset + j/4] の (j%4)*8 ビット目から）
//          映像は MEDIA_PIX_YUV420（Y 面 w*h、U 面 w/2*h/2、V 面 w/2*h/2）、画像は MEDIA_PIX_RGBA8（w*h*4）。
//          バイト数は m.frameBytes。n が範囲の外、読めない、壊れているなら false（out は書きかけのことがある）。
//   音     mediaReadSound(mut m, first, count, mut out: f32[]): i64
//          first サンプル目（1 チャンネルあたりの番号）から count サンプルを、インターリーブの f32（-1..1）で out に書く。
//          out の長さは count * channels にそろえる（終わりより後ろは 0）。戻り値は実際に読めたサンプル数（読めなければ -1）。
//   閉じる mediaRelease(mut m) … 組み込みの展開器を返す（キャッシュは何も持たないので、ok を false にするだけ）。
//   写し   mediaSpec(m) … 展開器を持たない写し。mediaReopen(spec) で、別のスレッドが自分の展開器を開き直す（先読み）。
//
// 決まり:
// - 関数の名前は、UM の FFmpeg の組み込み（標準の動画・音声の関数と、その下の低い層の組み込み）とぶつけない。
//   UM は名前の空間が 1 つで、同じ名前の関数をプログラムが定義すると組み込みのほうが隠れるため（開く・閉じる・音を読む・
//   情報の文字列の名前がぶつかっていたので、mediaOpenY4m / mediaOpenPam / mediaOpenPcm / mediaRelease / mediaReadSound /
//   mediaSourceText / mediaSourceJson にした）。
// - MediaSource は 1 つのスレッドで使う（組み込みの展開器は同時に 2 つのスレッドから使えない）。先読みのスレッドは
//   自分で開き直した MediaSource を持つ（playback.um の PrefetchWorker と mediaReopen）。
// - コマの番号は、展開した範囲（キャッシュ）か、クリップの in から数えた番号。クリップの時刻からの換算は mediaFrameAt。
import { sub, parseNum, splitBy, isNan, textNum, nan } from "./text.um";
import { Project, Clip, Probe, Diag, UNSET, KIND_VIDEO, KIND_IMAGE, KIND_AUDIO, FIT_COVER, FIT_STRETCH, parseProject } from "./project.um";
import { FfInfo, FfOpen, ffEnabled, ffProbe, ffOpenVideo, ffOpenAudio, ffReaderInfo, ffClose, ffReadVideo, ffReadAudio, FF_PIX_YUV420, FF_PIX_YUV420_VIA10, FF_PIX_YUV420_VIA10_FULL, FF_PIX_RGBA8 } from "./ffmpeg.um";

export const MEDIA_NONE: i32 = 0;
export const MEDIA_VIDEO: i32 = 1;
export const MEDIA_IMAGE: i32 = 2;
export const MEDIA_AUDIO: i32 = 3;

// 画素の形
export const MEDIA_PIX_NONE: i32 = 0;
export const MEDIA_PIX_YUV420: i32 = 1;
export const MEDIA_PIX_RGBA8: i32 = 2;

// 読み手の実装
export const MEDIA_BACKEND_CACHE: i32 = 1;
export const MEDIA_BACKEND_FFMPEG: i32 = 2;

// YUV の色の行列（MediaSource.mat）。キャッシュは常に BT.709。
export const MEDIA_MAT_709: i32 = 0;
export const MEDIA_MAT_601: i32 = 1;
export const MEDIA_MAT_2020: i32 = 2;

export struct MediaSource {
  ok: bool;
  kind: i32;
  backend: i32;
  path: string;
  // 開けなかった理由（日本語）。ok なら ""。
  err: string;
  // 映像・画像
  w: i32;
  h: i32;
  pix: i32;
  fpsNum: i32;
  fpsDen: i32;
  frames: i64;
  frameBytes: i64;
  // 展開した範囲の始まり（素材の秒）。分からなければ UNSET（render.um の Media.inPt と同じ）。
  inPt: f64;
  // 音
  rate: i32;
  channels: i32;
  samples: i64;
  // キャッシュの読み方: 本体の始まりと、1 コマの間隔（Y4M は "FRAME\n" の 6 バイトを含む）
  hdr: i64;
  stride: i64;
  // 組み込みの展開器の持ち手（MEDIA_BACKEND_FFMPEG 用。開いていなければ 0）。
  handle: i64;
  // 展開の中身がわかる値（mozcut.mjs が <file>.key に書く、元の素材の場所・大きさ・更新時刻と展開の引数）。
  // 展開を始めるときに消し、置き換えたあと最後に書く。なければ ""。編集画面が、展開し直したかを知るのに使う
  // （大きさ・コマ数・始まりが同じでも中身が変わることがある）。
  key: string;
  // ---- MEDIA_BACKEND_FFMPEG ----
  // 素材のファイル
  file: string;
  // 開き方（MEDIA_OPEN_*）
  mode: i32;
  // YUV の色の行列（MEDIA_MAT_*）と範囲（true ならいっぱいの範囲）
  mat: i32;
  fullRange: bool;
  // 展開器に頼む大きさ（拡大縮小の後）と、そこから w × h を切り抜く左上（cover のとき。ほかは 0）
  scaleW: i32;
  scaleH: i32;
  cropX: i32;
  cropY: i32;
  // 素材の長さ（秒。分からなければ -1）とコマの速さ（コマ/秒）
  srcDur: f64;
  srcFps: f64;
  // 素材の大きさ（拡大縮小しないときに、UM の変換の誤りを避けるのに使う。mediaFfFrame）
  srcW: i32;
  srcH: i32;
  // 音: 次に続けて読める標本の番号（クリップの始まりから。分からなければ -1）
  next: i64;
  // 画像: 開いたときに展開した RGBA（w * h * 4）
  img: u8[];
}

// 開き方（mediaOpenClip の mode）。キャッシュの読み手では、どれも同じ（何も持たないので）。
// - MEDIA_OPEN_INFO: 情報だけ（コマの番号の換算に使う。展開器は開かない）
// - MEDIA_OPEN_FAST: 読める状態で開く。拡大縮小は速さを優先（編集画面）
// - MEDIA_OPEN_BEST: 読める状態で開く。拡大縮小は画質を優先（書き出し・preview）
export const MEDIA_OPEN_INFO: i32 = 0;
export const MEDIA_OPEN_FAST: i32 = 1;
export const MEDIA_OPEN_BEST: i32 = 2;

function mediaEmpty(kind: i32, path: string, err: string): MediaSource {
  return {
    ok: false, kind: kind, backend: MEDIA_BACKEND_CACHE, path: path.clone(), err: err.clone(),
    w: 0, h: 0, pix: MEDIA_PIX_NONE, fpsNum: 0, fpsDen: 1, frames: 0, frameBytes: 0, inPt: UNSET,
    rate: 0, channels: 0, samples: 0, hdr: 0, stride: 0, handle: 0, key: "",
    file: "", mode: MEDIA_OPEN_INFO, mat: MEDIA_MAT_709, fullRange: false, scaleW: 0, scaleH: 0, cropX: 0, cropY: 0,
    srcDur: -1, srcFps: 0, srcW: 0, srcH: 0, next: -1, img: [],
  };
}

// 素材のないクリップ（文字・色など）の MediaSource（ok = false、err は ""）。
export function mediaNone(): MediaSource {
  return mediaEmpty(MEDIA_NONE, "", "");
}

function mediaLineEnd(bytes: u8[], from: usize): usize {
  let i = from;
  while (i < bytes.length && bytes[i] != 10) {
    i++;
  }
  return i;
}

function mediaBytesText(bytes: u8[], a: usize, b: usize): string {
  let out: u8[] = [];
  for (let i = a; i < b; i++) {
    out.push(bytes[i]);
  }
  return stringFromBytes(out);
}

// "30:1" のような分数。読めなければ num = 0。
function mediaParseRatio(s: string, m: mut MediaSource): void {
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 58) {
      const a = parseNum(sub(s, 0, i));
      const b = parseNum(sub(s, i + 1, s.length));
      if (!isNan(a) && !isNan(b) && a > 0 && b > 0) {
        m.fpsNum = a as i32;
        m.fpsDen = b as i32;
      }
      return;
    }
  }
}

// キャッシュのファイルの場所（render.um の videoCachePath / imageCachePath / audioCachePath と同じ）。
export function mediaCachePath(cache: string, index: usize, kind: i32): string {
  if (kind == MEDIA_VIDEO) {
    return `${cache}/clip${index}.y4m`;
  }
  if (kind == MEDIA_IMAGE) {
    return `${cache}/clip${index}.pam`;
  }
  return `${cache}/clip${index}.pcm`;
}

// 映像を開く。Y4M: "YUV4MPEG2 W1280 H720 F30:1 ..."\n のあと "FRAME\n" + 本体 がくり返す。
export function mediaOpenY4m(path: string): MediaSource {
  const head = readFileRange(path, 0, 512);
  if (head == null) {
    return mediaEmpty(MEDIA_VIDEO, path, `展開した映像 '${path}' が読めません`);
  }
  const size = fileSize(path);
  if (size == null) {
    return mediaEmpty(MEDIA_VIDEO, path, `展開した映像 '${path}' が読めません`);
  }
  const nl = mediaLineEnd(head, 0);
  if (nl >= head.length) {
    return mediaEmpty(MEDIA_VIDEO, path, `'${path}' の見出しが壊れています`);
  }
  const toks = splitBy(mediaBytesText(head, 0, nl), 32);
  if (toks.length == 0 || toks[0] != "YUV4MPEG2") {
    return mediaEmpty(MEDIA_VIDEO, path, `'${path}' は Y4M ではありません`);
  }
  let m = mediaEmpty(MEDIA_VIDEO, path, "");
  for (const t of toks) {
    if (t.length > 1 && t[0] == 87) {
      m.w = parseNum(sub(t, 1, t.length)) as i32;
    } else if (t.length > 1 && t[0] == 72) {
      m.h = parseNum(sub(t, 1, t.length)) as i32;
    } else if (t.length > 1 && t[0] == 70) {
      mediaParseRatio(sub(t, 1, t.length), mut m);
    } else if (t.length > 1 && t[0] == 67) {
      // C420jpeg / C420mpeg2 / C420paldv / C420 だけを扱う（4:2:0 の 8 ビット）
      const cs = sub(t, 1, t.length);
      if (cs.length < 3 || cs[0] != 52 || cs[1] != 50 || cs[2] != 48 || (cs.length > 3 && cs[3] == 112)) {
        m.err = `'${path}' の色の形 '${cs}' は扱えません（4:2:0 の 8 ビットだけ）`;
        return m;
      }
    }
  }
  if (m.w <= 0 || m.h <= 0 || m.w % 2 != 0 || m.h % 2 != 0) {
    m.err = `'${path}' の大きさ ${m.w}x${m.h} は扱えません（幅と高さは 2 の倍数）`;
    return m;
  }
  m.pix = MEDIA_PIX_YUV420;
  m.hdr = (nl + 1) as i64;
  m.frameBytes = (m.w as i64) * (m.h as i64) * 3 / 2;
  m.stride = m.frameBytes + 6;
  m.frames = (size - m.hdr) / m.stride;
  if (m.frames <= 0) {
    m.err = `'${path}' にコマがありません`;
    return m;
  }
  const inText = readFile(`${path}.in`);
  if (inText != null) {
    const v = parseNum(stringFromBytes(inText));
    if (!isNan(v)) {
      m.inPt = v;
    }
  }
  m.ok = true;
  return m;
}

// 画像を開く。PAM: "P7\nWIDTH w\nHEIGHT h\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n" + 本体
export function mediaOpenPam(path: string): MediaSource {
  const head = readFileRange(path, 0, 512);
  if (head == null) {
    return mediaEmpty(MEDIA_IMAGE, path, `展開した画像 '${path}' が読めません`);
  }
  let m = mediaEmpty(MEDIA_IMAGE, path, "");
  let depth = 0;
  let pos: usize = 0;
  while (pos < head.length) {
    const e = mediaLineEnd(head, pos);
    if (e >= head.length) {
      break;
    }
    const f = splitBy(mediaBytesText(head, pos, e), 32);
    pos = e + 1;
    if (f.length == 0) {
      continue;
    }
    if (f[0] == "ENDHDR") {
      if (m.w <= 0 || m.h <= 0 || depth != 4) {
        m.err = `'${path}' は RGBA の PAM ではありません`;
        return m;
      }
      m.hdr = pos as i64;
      m.pix = MEDIA_PIX_RGBA8;
      m.frames = 1;
      m.frameBytes = (m.w as i64) * (m.h as i64) * 4;
      m.stride = m.frameBytes;
      m.ok = true;
      return m;
    }
    if (f.length >= 2) {
      const v = parseNum(f[1]);
      if (!isNan(v)) {
        if (f[0] == "WIDTH") {
          m.w = v as i32;
        } else if (f[0] == "HEIGHT") {
          m.h = v as i32;
        } else if (f[0] == "DEPTH") {
          depth = v as i32;
        }
      }
    }
  }
  m.err = `'${path}' の見出しが壊れています`;
  return m;
}

// 音を開く。s16le のインターリーブ（見出しなし）。rate と channels は呼ぶ側が知っている値（展開したときの値）を渡す。
export function mediaOpenPcm(path: string, rate: i32, channels: i32): MediaSource {
  const size = fileSize(path);
  if (size == null) {
    return mediaEmpty(MEDIA_AUDIO, path, `展開した音 '${path}' が読めません`);
  }
  let m = mediaEmpty(MEDIA_AUDIO, path, "");
  if (rate <= 0 || channels <= 0) {
    m.err = `'${path}' の標本化周波数（${rate}）かチャンネル数（${channels}）が正しくありません`;
    return m;
  }
  m.rate = rate;
  m.channels = channels;
  m.samples = size / ((channels as i64) * 2);
  m.ok = true;
  return m;
}

// 展開したファイルの .key の中身（なければ ""）。
function mediaKeyOf(path: string): string {
  const b = readFile(`${path}.key`);
  if (b == null) {
    return "";
  }
  return stringFromBytes(b);
}

// プロジェクト p の index 番目のクリップの素材を、種類 kind（KIND_VIDEO / KIND_IMAGE / KIND_AUDIO）として開く。
// KIND_AUDIO は、音だけのクリップでも映像のクリップの音でもよい（映像と音は別の MediaSource）。
// 音は mozcut.mjs が展開するときと同じ、プロジェクトの rate のステレオ。ほかの種類は mediaNone()。
// mode は MEDIA_OPEN_*。
export function mediaOpenClip(p: Project, cache: string, index: usize, kind: i32, mode: i32): MediaSource {
  if (ffEnabled() && index < p.clips.length && p.clips[index].file != "" && (kind == KIND_VIDEO || kind == KIND_IMAGE || kind == KIND_AUDIO)) {
    return mediaOpenFile(p, p.clips[index], kind, mode);
  }
  if (kind == KIND_VIDEO) {
    const path = mediaCachePath(cache, index, MEDIA_VIDEO);
    let m = mediaOpenY4m(path);
    m.key = mediaKeyOf(path);
    return m;
  }
  if (kind == KIND_IMAGE) {
    const path = mediaCachePath(cache, index, MEDIA_IMAGE);
    let m = mediaOpenPam(path);
    m.key = mediaKeyOf(path);
    return m;
  }
  if (kind == KIND_AUDIO) {
    return mediaOpenPcm(mediaCachePath(cache, index, MEDIA_AUDIO), p.rate, 2);
  }
  return mediaNone();
}

// 閉じる。FFmpeg の展開器を返す（キャッシュの読み手は何も持たない）。
export function mediaRelease(m: mut MediaSource): void {
  if (m.backend == MEDIA_BACKEND_FFMPEG && m.handle != 0) {
    ffClose(m.handle);
  }
  m.ok = false;
  m.handle = 0;
}

// クリップの中の時刻 lt（クリップの始まりからの秒）に見せるコマの番号。render.um の drawVideo と同じ式。
// clipIn はクリップの in（Clip.inPt）、fps はプロジェクトのコマの速さ。展開の始まり（m.inPt）が分かれば、それを基準にずらす。
export function mediaFrameAt(m: MediaSource, clipIn: f64, lt: f64, fps: f64): i64 {
  let base = clipIn;
  if (m.inPt != UNSET) {
    base = m.inPt;
  }
  let k = Math.floor((lt + clipIn - base) * fps + 0.000001) as i64;
  if (k >= m.frames) {
    k = m.frames - 1;
  }
  if (k < 0) {
    k = 0;
  }
  return k;
}

// n 番目のコマを読む範囲（[位置, バイト数]）。Y4M は "FRAME" の行を含む 1 コマ分。読めない番号ならバイト数 0。
function mediaFrameSpan(m: MediaSource, n: i64): i64[2] {
  if (!m.ok || n < 0 || n >= m.frames) {
    return [0, 0];
  }
  if (m.kind == MEDIA_VIDEO) {
    return [m.hdr + n * m.stride, m.stride];
  }
  if (m.kind == MEDIA_IMAGE) {
    return [m.hdr, m.frameBytes];
  }
  return [0, 0];
}

// 読んだバイト列が 1 コマとして正しいか（長さと、Y4M の "FRAME" の行）。
function mediaFrameValid(m: MediaSource, raw: u8[], len: i64): bool {
  if ((raw.length as i64) != len) {
    return false;
  }
  if (m.kind == MEDIA_VIDEO) {
    return raw[0] == 70 && raw[1] == 82 && raw[2] == 65 && raw[3] == 77 && raw[4] == 69 && raw[5] == 10;
  }
  return true;
}

// 本体が始まる位置（mediaFrameBytes の結果の中）。
function mediaBodyStart(m: MediaSource): usize {
  if (m.kind == MEDIA_VIDEO) {
    return 6;
  }
  return 0;
}

// n 番目のコマを out の先頭に書く（m.frameBytes バイト）。
export function mediaReadFrame(m: MediaSource, n: i64, out: mut Buffer<u8>): bool {
  if ((out.length as i64) < m.frameBytes) {
    return false;
  }
  if (m.backend == MEDIA_BACKEND_FFMPEG) {
    return mediaFfFrame(m, n, mut out);
  }
  const sp = mediaFrameSpan(m, n);
  if (sp[1] <= 0) {
    return false;
  }
  const raw = readFileRange(m.path, sp[0], sp[1]);
  if (raw == null) {
    return false;
  }
  if (!mediaFrameValid(m, raw, sp[1])) {
    return false;
  }
  // 本体だけを写す。for-of の写しは clang がベクトル化する（添字で読むより速い。1280x720 で 0.1 ms 前後）
  const s = mediaBodyStart(m);
  let j: u32 = 0;
  let i: usize = 0;
  for (const b of raw) {
    if (i >= s) {
      out[j] = b;
      j++;
    }
    i++;
  }
  return true;
}

// n 番目のコマを、共有の置き場 out の offset 要素目から、4 バイトずつ u32 に詰めて書く（先読みのスレッド用）。
// バイト j は out[offset + j/4] の (j%4)*8 ビット目から。要素ごとにアトミックに書くので、1 バイトずつより 4 倍少なく済む。
// 書き終わったことは、呼ぶ側が印（store）で知らせる。
export function mediaReadFrameRacy(m: MediaSource, n: i64, out: RacyBuffer<u32>, offset: u32): bool {
  const words = (m.frameBytes + 3) / 4;
  if ((out.length as i64) < (offset as i64) + words) {
    return false;
  }
  if (m.backend == MEDIA_BACKEND_FFMPEG) {
    // 展開器は Buffer に書くので、1 コマ分を受けてから詰める（1080p で 3 MB。確保は展開に比べて小さい）
    let tmp = new Buffer<u8>(m.frameBytes as u32);
    if (!mediaFfFrame(m, n, mut tmp)) {
      return false;
    }
    mediaPackRacy(tmp, m.frameBytes as usize, out, offset);
    return true;
  }
  const sp = mediaFrameSpan(m, n);
  if (sp[1] <= 0) {
    return false;
  }
  const raw = readFileRange(m.path, sp[0], sp[1]);
  if (raw == null) {
    return false;
  }
  if (!mediaFrameValid(m, raw, sp[1])) {
    return false;
  }
  const s = mediaBodyStart(m);
  const nb = m.frameBytes as usize;
  const full = nb / 4;
  for (let q: usize = 0; q < full; q++) {
    const j = s + q * 4;
    out[offset + (q as u32)] = (raw[j] as u32) | ((raw[j + 1] as u32) << 8) | ((raw[j + 2] as u32) << 16) | ((raw[j + 3] as u32) << 24);
  }
  if (full * 4 < nb) {
    let v: u32 = 0;
    for (let j = full * 4; j < nb; j++) {
      v = v | ((raw[s + j] as u32) << (((j - full * 4) * 8) as u32));
    }
    out[offset + (full as u32)] = v;
  }
  return true;
}

// first サンプル目から count サンプルを、インターリーブの f32（-1..1）で読む。out の長さは count * channels になる。
export function mediaReadSound(m: mut MediaSource, first: i64, count: i64, out: mut f32[]): i64 {
  out.clear();
  if (count <= 0) {
    return 0;
  }
  const ch = m.channels as i64;
  for (let i: i64 = 0; i < count * ch; i++) {
    out.push(0);
  }
  if (!m.ok || m.kind != MEDIA_AUDIO) {
    return -1;
  }
  if (m.backend == MEDIA_BACKEND_FFMPEG) {
    return mediaFfSound(mut m, first, count, mut out);
  }
  const s0 = Math.max(first, 0);
  const s1 = Math.min(first + count, m.samples);
  if (s0 >= s1) {
    return 0;
  }
  const bytes = readFileRange(m.path, s0 * ch * 2, (s1 - s0) * ch * 2);
  if (bytes == null) {
    return -1;
  }
  const vals = bytes.length / 2;
  const o = ((s0 - first) * ch) as usize;
  for (let j: usize = 0; j < vals; j++) {
    let v = (bytes[j * 2] as i32) | ((bytes[j * 2 + 1] as i32) << 8);
    if (v >= 32768) {
      v -= 65536;
    }
    out[o + j] = (v as f32) / 32768.0;
  }
  return (vals as i64) / ch;
}

// 人向けの 1 行。例: 「映像 1280x720 30/1 コマ/秒 122 コマ（展開の始まり 1 秒）」
export function mediaSourceText(m: MediaSource): string {
  if (!m.ok) {
    if (m.err == "") {
      return "素材なし";
    }
    return `読めない素材: ${m.err}`;
  }
  if (m.kind == MEDIA_VIDEO) {
    let s = `映像 ${m.w}x${m.h} ${m.fpsNum}/${m.fpsDen} コマ/秒 ${m.frames} コマ`;
    if (m.inPt != UNSET) {
      s = `${s}（展開の始まり ${textNum(m.inPt)} 秒）`;
    }
    return s;
  }
  if (m.kind == MEDIA_IMAGE) {
    return `画像 ${m.w}x${m.h}`;
  }
  return `音 ${m.rate} Hz ${m.channels} チャンネル ${m.samples} サンプル`;
}

function mediaJsonStr(s: string): string {
  let out: u8[] = [34];
  for (let i: usize = 0; i < s.length; i++) {
    const c = s[i];
    if (c == 34 || c == 92) {
      out.push(92);
      out.push(c);
    } else if (c == 10) {
      out.push(92);
      out.push(110);
    } else if (c < 32) {
      out.push(32);
    } else {
      out.push(c);
    }
  }
  out.push(34);
  return stringFromBytes(out);
}

// 機械向け。{"ok":..,"kind":"video"|"image"|"audio"|"none","path":..,"error":..,"width":..,"height":..,
// "fps":"30/1","frames":..,"frameBytes":..,"in":秒|null,"rate":..,"channels":..,"samples":..}
export function mediaSourceJson(m: MediaSource): string {
  let kind = "none";
  if (m.kind == MEDIA_VIDEO) {
    kind = "video";
  } else if (m.kind == MEDIA_IMAGE) {
    kind = "image";
  } else if (m.kind == MEDIA_AUDIO) {
    kind = "audio";
  }
  let inText = "null";
  if (m.inPt != UNSET) {
    inText = textNum(m.inPt);
  }
  let okText = "false";
  if (m.ok) {
    okText = "true";
  }
  return `{"ok":${okText},"kind":"${kind}","path":${mediaJsonStr(m.path)},"error":${mediaJsonStr(m.err)},"width":${m.w},"height":${m.h},"fps":"${m.fpsNum}/${m.fpsDen}","frames":${m.frames},"frameBytes":${m.frameBytes},"in":${inText},"rate":${m.rate},"channels":${m.channels},"samples":${m.samples}}`;
}

// ---- MEDIA_BACKEND_FFMPEG ----

// av_rescale と同じ: a * b / c を近い整数に丸める（ちょうど半分は 0 から遠い方へ）。
function mediaRescale(a: i64, b: i64, c: i64): i64 {
  if (c <= 0) {
    return 0;
  }
  return (a * b * 2 + c) / (c * 2);
}

function mediaEven(v: i32): i32 {
  return v + (v & 1);
}

// クリップに置く大きさ（main.um の scaleFilter が ffmpeg の scale / crop フィルタに頼むのと同じ大きさ）。
// 素材の大きさ sw × sh から [拡大縮小の幅, 高さ, 切り抜いた幅, 高さ, 切り抜く左, 上] を決める。
function mediaFitSize(c: Clip, p: Project, sw: i32, sh: i32, isVideo: bool): i32[6] {
  let tw = c.w;
  let th = c.h;
  if (isVideo) {
    tw = mediaEven(tw);
    th = mediaEven(th);
  }
  const sw64 = Math.max(sw, 1) as i64;
  const sh64 = Math.max(sh, 1) as i64;
  if (tw <= 0 && th <= 0) {
    if (!isVideo) {
      return [sw, sh, sw, sh, 0, 0];
    }
    tw = p.width;
    th = p.height;
  } else if (tw <= 0) {
    // scale=-2:h（映像は偶数）/ scale=-1:h（画像）
    let w = mediaRescale(th as i64, sw64, sh64) as i32;
    if (isVideo) {
      w = (mediaRescale(th as i64, sw64, sh64 * 2) * 2) as i32;
    }
    w = Math.max(w, 1);
    return [w, th, w, th, 0, 0];
  } else if (th <= 0) {
    let h = mediaRescale(tw as i64, sh64, sw64) as i32;
    if (isVideo) {
      h = (mediaRescale(tw as i64, sh64, sw64 * 2) * 2) as i32;
    }
    h = Math.max(h, 1);
    return [tw, h, tw, h, 0, 0];
  }
  if (c.fit == FIT_STRETCH) {
    return [tw, th, tw, th, 0, 0];
  }
  const fw = mediaRescale(th as i64, sw64, sh64) as i32;
  const fh = mediaRescale(tw as i64, sh64, sw64) as i32;
  if (c.fit == FIT_COVER) {
    const w = Math.max(fw, tw);
    const h = Math.max(fh, th);
    let x = (w - tw) / 2;
    let y = (h - th) / 2;
    if (isVideo) {
      // YUV 4:2:0 の色差の面とそろえる（ffmpeg の crop も偶数に丸める）
      x = x & -2;
      y = y & -2;
    }
    return [w, h, tw, th, x, y];
  }
  let w = Math.min(fw, tw);
  let h = Math.min(fh, th);
  if (isVideo) {
    w = Math.max((w / 2) * 2, 2);
    h = Math.max((h / 2) * 2, 2);
  }
  return [w, h, w, h, 0, 0];
}

// 素材の情報から YUV の色の行列と範囲を決める。書いていなければ BT.601 とみなす。これは ffmpeg のコマンド
// （libswscale の既定。前の版の展開のキャッシュも同じ）の扱いで、ffmpeg のコマンドで RGB から作った印のない素材は
// 大きさによらず BT.601 で変換されているため（UM の RGB の受け取りは高さ 720 以上を BT.709 とみなすが、
// MozaicCut は YUV のまま受け取ってここで決める）。
function mediaMatrixOf(m: mut MediaSource, info: FfInfo): void {
  const cs = info.colorSpace.clone();
  if (cs == "bt709") {
    m.mat = MEDIA_MAT_709;
  } else if (cs == "bt2020nc" || cs == "bt2020c") {
    m.mat = MEDIA_MAT_2020;
  } else {
    m.mat = MEDIA_MAT_601;
  }
  const pf = info.pixelFormat.clone();
  m.fullRange = info.colorRange == "pc" || (pf.length > 4 && pf[0] == 121 && pf[1] == 117 && pf[2] == 118 && pf[3] == 106);
}

// YUV を RGB にする係数（render.um の yuvPixel に渡す）。K1 = (Cr→R, Cb→G, Cr→G, Cb→B)、K2 = (Y の黒, Y の幅, 色差の中央, 色差の幅)。
// キャッシュ（BT.709 の限られた範囲）は前の式の定数と同じ値になる。
export function mediaYuvK1(m: MediaSource): vec4<f32> {
  if (m.mat == MEDIA_MAT_601) {
    return vec4(1.402, 0.344136, 0.714136, 1.772);
  }
  if (m.mat == MEDIA_MAT_2020) {
    return vec4(1.4746, 0.164553, 0.571353, 1.8814);
  }
  return vec4(1.5748, 0.18732, 0.46812, 1.8556);
}

export function mediaYuvK2(m: MediaSource): vec4<f32> {
  if (m.fullRange) {
    return vec4(0.0, 255.0, 128.0, 255.0);
  }
  return vec4(16.0, 219.0, 128.0, 224.0);
}

// ハードウェアの展開を使うか。展開したコマを GPU から CPU に写す手間があるので、1080p までは CPU の展開のほうが速い
// （UM の docs/media.ja.md の「速さ」。この機械の 720p の H.264 で、CPU 0.6 ms、d3d11va 2.3 ms / コマ）。
// 大きな素材（高さ 1440 を超える 4K など）だけ "auto"（使えなければ黙って CPU）。画像は CPU。
function mediaHwFor(kind: i32, height: i32): string {
  if (kind == MEDIA_VIDEO && height > 1440) {
    return "auto";
  }
  return "none";
}

// 開いた素材が同じものかを見分ける印（素材の場所・種類・in・長さ・置く大きさ・プロジェクトの大きさと速さ）。
// FFmpeg の組み込みで開くクリップでなければ ""。編集画面の書き換えで、変わらないクリップの展開器を使い続けるのに使う。
export function mediaClipKey(p: Project, c: Clip, kind: i32): string {
  if (!ffEnabled() || c.file == "") {
    return "";
  }
  return `${kind}|${c.file}|${c.inPt}|${c.dur}|${c.w}|${c.h}|${c.fit}|${p.width}x${p.height}|${p.fpsNum}/${p.fpsDen}|${p.rate}`;
}

// m の展開器（と画像の画素）を受け取った MediaSource を返す。m のほうは展開器を手放す（m を mediaRelease しても閉じない）。
export function mediaTake(m: mut MediaSource): MediaSource {
  let out = mediaSpec(m);
  out.handle = m.handle;
  out.next = m.next;
  out.img = m.img.clone();
  m.handle = 0;
  m.ok = false;
  return out;
}

// 素材のファイルを開く（mediaOpenClip から。ffEnabled() で c.file があるとき）。
function mediaOpenFile(p: Project, c: Clip, kind: i32, mode: i32): MediaSource {
  let mk = MEDIA_VIDEO;
  if (kind == KIND_IMAGE) {
    mk = MEDIA_IMAGE;
  } else if (kind == KIND_AUDIO) {
    mk = MEDIA_AUDIO;
  }
  let m = mediaEmpty(mk, c.file, "");
  m.backend = MEDIA_BACKEND_FFMPEG;
  m.file = c.file.clone();
  m.mode = mode;
  m.inPt = c.inPt;
  m.fpsNum = Math.max(p.fpsNum, 1);
  m.fpsDen = Math.max(p.fpsDen, 1);
  m.rate = p.rate;
  m.channels = 2;
  // 編集画面で in を変えたときなどに開き直さずに済むよう、クリップの長さと配置は開くときの値を持つ
  m.key = mediaClipKey(p, c, kind);
  if (mk == MEDIA_AUDIO) {
    m.samples = Math.floor(c.dur * (p.rate as f64) + 0.5) as i64;
    if (mode != MEDIA_OPEN_INFO) {
      const o = ffOpenAudio(c.file);
      if (!o.ok) {
        m.err = `素材 '${c.src}' の音を開けません: ${o.err}`;
        return m;
      }
      m.handle = o.handle;
    }
    m.ok = true;
    return m;
  }
  let info = ffProbe(c.file);
  if (mode != MEDIA_OPEN_INFO) {
    const o = ffOpenVideo(c.file, mediaHwFor(mk, info.height));
    if (!o.ok) {
      m.err = `素材 '${c.src}' を開けません: ${o.err}`;
      return m;
    }
    m.handle = o.handle;
    info = ffReaderInfo(o.handle);
  }
  if (!info.ok) {
    m.err = `素材 '${c.src}' を読めません: ${info.err}`;
    return m;
  }
  if (!info.hasVideo || info.width <= 0 || info.height <= 0) {
    m.err = `素材 '${c.src}' に映像がありません`;
    return m;
  }
  m.srcDur = info.duration;
  m.srcW = info.width;
  m.srcH = info.height;
  m.srcFps = 0;
  if (info.fpsNum > 0 && info.fpsDen > 0) {
    m.srcFps = (info.fpsNum as f64) / (info.fpsDen as f64);
  }
  const sz = mediaFitSize(c, p, info.width, info.height, mk == MEDIA_VIDEO);
  m.scaleW = sz[0];
  m.scaleH = sz[1];
  m.w = sz[2];
  m.h = sz[3];
  m.cropX = sz[4];
  m.cropY = sz[5];
  if (mk == MEDIA_IMAGE) {
    m.pix = MEDIA_PIX_RGBA8;
    m.frames = 1;
    m.frameBytes = (m.w as i64) * (m.h as i64) * 4;
    if (mode != MEDIA_OPEN_INFO) {
      let px = new Buffer<u8>((m.scaleW * m.scaleH * 4) as u32);
      let why = "";
      const t = ffReadVideo(m.handle, 0, mut px, FF_PIX_RGBA8, m.scaleW, m.scaleH, mode == MEDIA_OPEN_FAST, mut why);
      ffClose(m.handle);
      m.handle = 0;
      if (t < 0) {
        m.err = `素材 '${c.src}' の画像を読めません: ${why}`;
        return m;
      }
      mediaCropRgba(px, m.scaleW, m.cropX, m.cropY, m.w, m.h, mut m.img);
    }
    m.ok = true;
    return m;
  }
  mediaMatrixOf(mut m, info);
  m.pix = MEDIA_PIX_YUV420;
  m.frameBytes = (m.w as i64) * (m.h as i64) * 3 / 2;
  // 展開のキャッシュと同じく、クリップの長さより 2 コマ長めまで読める。素材の終わりより後ろは数えない
  const fps = (m.fpsNum as f64) / (m.fpsDen as f64);
  let frames = Math.ceil((c.dur + 2.0 / fps) * fps - 0.000001) as i64;
  if (m.srcDur > 0) {
    frames = Math.min(frames, Math.ceil((m.srcDur - c.inPt) * fps - 0.000001) as i64);
  }
  m.frames = Math.max(frames, 1);
  m.ok = true;
  return m;
}

// 展開器を持たない写し（別のスレッドが mediaReopen で開き直すため）。画像の画素は写さない。
export function mediaSpec(m: MediaSource): MediaSource {
  return {
    ok: m.ok, kind: m.kind, backend: m.backend, path: m.path.clone(), err: m.err.clone(),
    w: m.w, h: m.h, pix: m.pix, fpsNum: m.fpsNum, fpsDen: m.fpsDen, frames: m.frames, frameBytes: m.frameBytes, inPt: m.inPt,
    rate: m.rate, channels: m.channels, samples: m.samples, hdr: m.hdr, stride: m.stride, handle: 0, key: m.key.clone(),
    file: m.file.clone(), mode: m.mode, mat: m.mat, fullRange: m.fullRange, scaleW: m.scaleW, scaleH: m.scaleH,
    cropX: m.cropX, cropY: m.cropY, srcDur: m.srcDur, srcFps: m.srcFps, srcW: m.srcW, srcH: m.srcH, next: -1, img: [],
  };
}

// 写し（mediaSpec）から、このスレッドの展開器を開き直す。mode が MEDIA_OPEN_INFO なら fast で開く。
// キャッシュの読み手はそのまま使える（ファイルの場所を持つだけなので）。
export function mediaReopen(spec: MediaSource): MediaSource {
  let m = mediaSpec(spec);
  if (m.backend != MEDIA_BACKEND_FFMPEG || !m.ok || m.kind == MEDIA_IMAGE) {
    return m;
  }
  if (m.mode == MEDIA_OPEN_INFO) {
    m.mode = MEDIA_OPEN_FAST;
  }
  // 展開器の選び方は、開いたときと同じく素材の高さで決める（置く大きさではない。4K の素材を 1080p に置いてもハードウェア）
  let o: FfOpen = { ok: false, handle: 0, err: "" };
  if (m.kind == MEDIA_AUDIO) {
    o = ffOpenAudio(m.file);
  } else {
    o = ffOpenVideo(m.file, mediaHwFor(m.kind, m.srcH));
  }
  if (!o.ok) {
    m.ok = false;
    m.err = `素材 '${m.path}' を開けません: ${o.err}`;
    return m;
  }
  m.handle = o.handle;
  return m;
}

// RGBA（幅 sw）の (x, y) から w × h を切り抜いて dst に入れる。
function mediaCropRgba(src: Buffer<u8>, sw: i32, x: i32, y: i32, w: i32, h: i32, dst: mut u8[]): void {
  dst.clear();
  for (let r = 0; r < h; r++) {
    const base = (((y + r) * sw + x) * 4) as u32;
    for (let k: u32 = 0; k < (w * 4) as u32; k++) {
      dst.push(src[base + k]);
    }
  }
}

// YUV 4:2:0（大きさ sw × sh。色差の面は ⌈sw/2⌉ × ⌈sh/2⌉）の (x, y)（偶数）から w × h（偶数）を切り抜いて dst の先頭に書く。
function mediaCropYuv(src: Buffer<u8>, sw: i32, sh: i32, x: i32, y: i32, w: i32, h: i32, dst: mut Buffer<u8>): void {
  let o: u32 = 0;
  for (let r = 0; r < h; r++) {
    const base = ((y + r) * sw + x) as u32;
    for (let k: u32 = 0; k < w as u32; k++) {
      dst[o] = src[base + k];
      o++;
    }
  }
  const scw = (sw + 1) / 2;
  const sch = (sh + 1) / 2;
  const cw = w / 2;
  const ch = h / 2;
  for (let plane = 0; plane < 2; plane++) {
    const pbase = sw * sh + plane * scw * sch;
    for (let r = 0; r < ch; r++) {
      const base = (pbase + (y / 2 + r) * scw + x / 2) as u32;
      for (let k: u32 = 0; k < cw as u32; k++) {
        dst[o] = src[base + k];
        o++;
      }
    }
  }
}

// n 番目のコマ（クリップの in から、プロジェクトのコマの速さで数えた番号）を展開して out の先頭に書く。
function mediaFfFrame(m: MediaSource, n: i64, out: mut Buffer<u8>): bool {
  if (!m.ok || n < 0 || n >= m.frames) {
    return false;
  }
  if (m.kind == MEDIA_IMAGE) {
    let j: u32 = 0;
    for (const b of m.img) {
      out[j] = b;
      j++;
    }
    return (j as i64) == m.frameBytes;
  }
  if (m.handle == 0) {
    return false;
  }
  // 番号 n のコマは、時刻 (n + 0.5) / fps に表示されている素材のコマ（ffmpeg の fps フィルタと同じ選び方）
  let t = m.inPt + ((n as f64) + 0.5) * (m.fpsDen as f64) / (m.fpsNum as f64);
  if (m.srcDur > 0 && m.srcFps > 0) {
    // 最後のコマより後ろは最後のコマ（素材の長さの端数で End にならないように）
    t = Math.min(t, m.srcDur - 0.5 / m.srcFps);
  }
  t = Math.max(t, 0.0);
  const fast = m.mode != MEDIA_OPEN_BEST;
  let why = "";
  // 素材と同じ大きさなら 10 ビットの経路で受け取る（ffmpeg.um の FF_PIX_YUV420_VIA10。UM の組み込みの誤りの回り道）
  let pix = FF_PIX_YUV420;
  if (m.scaleW == m.srcW && m.scaleH == m.srcH) {
    pix = FF_PIX_YUV420_VIA10;
    if (m.fullRange) {
      pix = FF_PIX_YUV420_VIA10_FULL;
    }
  }
  if (m.cropX == 0 && m.cropY == 0 && m.scaleW == m.w && m.scaleH == m.h) {
    return ffReadVideo(m.handle, t, mut out, pix, m.w, m.h, fast, mut why) >= 0;
  }
  const sb = (m.scaleW * m.scaleH + 2 * ((m.scaleW + 1) / 2) * ((m.scaleH + 1) / 2)) as u32;
  let big = new Buffer<u8>(sb);
  if (ffReadVideo(m.handle, t, mut big, pix, m.scaleW, m.scaleH, fast, mut why) < 0) {
    return false;
  }
  mediaCropYuv(big, m.scaleW, m.scaleH, m.cropX, m.cropY, m.w, m.h, mut out);
  return true;
}

// Buffer<u8> の先頭 nb バイトを、共有の置き場 out の offset 要素目から 4 バイトずつ u32 に詰めて書く。
function mediaPackRacy(src: Buffer<u8>, nb: usize, out: RacyBuffer<u32>, offset: u32): void {
  const full = nb / 4;
  for (let q: usize = 0; q < full; q++) {
    const j = (q * 4) as u32;
    out[offset + (q as u32)] = (src[j] as u32) | ((src[j + 1] as u32) << 8) | ((src[j + 2] as u32) << 16) | ((src[j + 3] as u32) << 24);
  }
  if (full * 4 < nb) {
    let v: u32 = 0;
    for (let j = full * 4; j < nb; j++) {
      v = v | ((src[j as u32] as u32) << (((j - full * 4) * 8) as u32));
    }
    out[offset + (full as u32)] = v;
  }
}

// 音を first 標本目（クリップの始まりから）から count 標本、ステレオの f32 で out（count * 2、先に 0 で埋めてある）に書く。
// 前の読み込みの続きなら、シークせずに続きを読む。戻り値は読めた標本の数（クリップの長さで切る）。
function mediaFfSound(m: mut MediaSource, first: i64, count: i64, out: mut f32[]): i64 {
  if (m.handle == 0) {
    return -1;
  }
  const s0 = Math.max(first, 0);
  const s1 = Math.min(first + count, m.samples);
  if (s0 >= s1) {
    return 0;
  }
  const want = s1 - s0;
  let buf = new Buffer<f32>((want * 2) as u32);
  let got: i64 = 0;
  let t = m.inPt + (s0 as f64) / (m.rate as f64);
  if (m.next == s0) {
    t = -1;
  }
  while (got < want) {
    const n = ffReadAudio(m.handle, t, mut buf, m.rate);
    if (n <= 0) {
      break;
    }
    const take = Math.min(n, want - got);
    const o = ((s0 - first + got) * 2) as usize;
    for (let j: usize = 0; j < (take * 2) as usize; j++) {
      out[o + j] = buf[j as u32];
    }
    got += take;
    t = -1;
    if (take < n) {
      // 読みすぎた分は捨てたので、次は位置を指定して読む
      m.next = -1;
      return got;
    }
    if (got < want) {
      // 残りの分だけを頼む
      buf = new Buffer<f32>(((want - got) * 2) as u32);
    }
  }
  m.next = s0 + got;
  return got;
}

// ---- 素材の情報（FFmpeg の組み込みで調べる） ----

function mediaIsSep(b: u8): bool {
  return b == 47 || b == 92;
}

function mediaIsAbs(s: string): bool {
  if (s.length > 0 && mediaIsSep(s[0])) {
    return true;
  }
  return s.length > 2 && s[1] == 58 && mediaIsSep(s[2]);
}

// 素材のファイルの場所。プロジェクトのファイル（projectPath）のあるフォルダから解決する（mozcut.mjs と同じ）。
// 絶対パスと、フォルダの分からないプロジェクトの場所（区切りなし）では src のまま。
export function mediaSourcePath(projectPath: string, src: string): string {
  if (mediaIsAbs(src)) {
    return src.clone();
  }
  let end: usize = 0;
  let found = false;
  let sep: u8 = 47;
  for (let i: usize = 0; i < projectPath.length; i++) {
    if (mediaIsSep(projectPath[i])) {
      end = i;
      found = true;
      sep = projectPath[i];
    }
  }
  if (!found) {
    return src.clone();
  }
  let out: u8[] = [];
  for (let i: usize = 0; i <= end; i++) {
    out.push(projectPath[i]);
  }
  for (const b of src) {
    if (mediaIsSep(b)) {
      out.push(sep);
    } else {
      out.push(b);
    }
  }
  return stringFromBytes(out);
}

function mediaFindProbe(probes: Probe[], src: string): i64 {
  for (let i: usize = 0; i < probes.length; i++) {
    if (probes[i].path == src) {
      return i as i64;
    }
  }
  return -1;
}

// 調べた結果の中から、ファイルの場所が file のもの。なければ -1。
function mediaFindFile(probes: Probe[], file: string): i64 {
  for (let i: usize = 0; i < probes.length; i++) {
    if (probes[i].file == file) {
      return i as i64;
    }
  }
  return -1;
}

// 調べた結果 q を known に覚える。同じ場所（file）のものがあれば置き換える（場所ごとに 1 件。読めなかったものも、
// 読めない印のまま覚える）。番号を返す。
export function mediaRemember(known: mut Probe[], q: Probe): usize {
  const k = mediaFindFile(known, q.file);
  if (k >= 0) {
    known[k as usize] = mediaCopyProbe(q);
    return k as usize;
  }
  known.push(mediaCopyProbe(q));
  return known.length - 1;
}

function mediaCopyProbe(q: Probe): Probe {
  return {
    path: q.path.clone(), dur: q.dur, hasVideo: q.hasVideo, hasAudio: q.hasAudio, missing: q.missing, looked: q.looked.clone(),
    file: q.file.clone(), unreadable: q.unreadable.clone(),
  };
}

// 1 つの素材（.mzc に書く名前 src、ファイルの場所 file）を FFmpeg で調べる。読めなければ（FFmpeg なしの版も）
// unreadable に理由（空にはしない）を入れて返す（file も持つ）。編集画面が、落としたファイルを足す前にも使う。
export function mediaProbeFile(src: string, file: string): Probe {
  const info = ffProbe(file);
  if (!info.ok) {
    let why = info.err.clone();
    if (why == "") {
      why = "FFmpeg で読めません";
    }
    return { path: src.clone(), dur: nan(), hasVideo: false, hasAudio: false, missing: false, looked: "", file: file.clone(), unreadable: why };
  }
  let dur = info.duration;
  if (dur <= 0) {
    dur = nan();
  }
  return { path: src.clone(), dur, hasVideo: info.hasVideo, hasAudio: info.hasAudio, missing: false, looked: "", file: file.clone(), unreadable: "" };
}

// プロジェクト（text、場所は projectPath）の素材を調べて Probe の並びにする。parseProject に渡す。
// FFmpeg の組み込みがなければ fallback（probe.txt から読んだもの）をそのまま返す。あれば素材ごとに:
//   ファイルがあり FFmpeg で読める → FFmpeg で調べた情報（file つき。描画は素材を直接開く）
//   ファイルはあるが読めない         → 読めない印（unreadable に FFmpeg の理由、file つき）。エンジンが unreadable-source に
//                                      する（fallback にあっても。FFmpeg の版は事前に展開しないので、キャッシュはないため）
//   ファイルがなく fallback にある   → fallback の情報（file なし。展開したキャッシュから読む。テストの架空の素材など）
//   ファイルがない                   → fallback が空なら、見つからない印（missing、looked に探した場所）。エンジンが
//                                      missing-source にする。fallback があるときは入れない（probe.txt を書いた側が
//                                      調べなかった素材として unknown-length になる。前の版と同じ）
// known は前に調べた結果（編集画面が書き換えのたびに調べ直さないため）。ファイルの場所ごとに 1 件で、読めなかった
// ものも読めない印のまま覚える（mediaRemember）。同じファイルを別の名前で書いた行も、調べ直さない。
export function mediaProbeSources(text: u8[], projectPath: string, fallback: Probe[], known: mut Probe[]): Probe[] {
  if (!ffEnabled()) {
    let same: Probe[] = [];
    for (const q of fallback) {
      same.push(mediaCopyProbe(q));
    }
    return same;
  }
  let err: Diag[] = [];
  const p = parseProject(text, fallback, mut err);
  let out: Probe[] = [];
  for (const c of p.clips) {
    if (c.src == "" || mediaFindProbe(out, c.src) >= 0) {
      continue;
    }
    const file = mediaSourcePath(projectPath, c.src);
    const exists = fileSize(file) != null;
    if (exists) {
      let k = mediaFindFile(known, file);
      if (k < 0) {
        k = mediaRemember(mut known, mediaProbeFile(c.src, file)) as i64;
      }
      // 名前（.mzc に書いた src）は行のもの。覚えた結果は、同じファイルを別の名前で書いた行のことがある
      let q = mediaCopyProbe(known[k as usize]);
      q.path = c.src.clone();
      out.push(q);
      continue;
    }
    const f = mediaFindProbe(fallback, c.src);
    if (f >= 0) {
      out.push(mediaCopyProbe(fallback[f as usize]));
    } else if (!exists && fallback.length == 0) {
      out.push({ path: c.src.clone(), dur: nan(), hasVideo: false, hasAudio: false, missing: true, looked: file.clone(), file: "", unreadable: "" });
    }
  }
  return out;
}
