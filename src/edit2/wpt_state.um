// 素材の欄の本物の縮小画像（wire_pthumb.um）の状態: 作った絵と、作ろうとした素材。E2View.pth に入れる
// （wire_pthumb.um だけが書き換える）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wpt / Wpt で始める。

// 素材 1 つの縮小画像（最初のコマ。0xAARRGGBB の w × h）。
export struct WptPic {
  id: string;
  w: i32;
  h: i32;
  img: Buffer<u32>;
}

export struct WptState {
  pics: WptPic[];
  // 作ろうとした素材の ID（作れなかったものも入れ、毎フレーム作り直さない）
  tried: string[];
}

export function wptStateNew(): WptState {
  return { pics: [], tried: [] };
}
