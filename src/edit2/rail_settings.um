// 左の欄の「設定」（レールの 設定）: 設定（表示・キーの割り当て・自動保存・キャッシュの場所など）。
// edit2.um がレールで「設定」を選んだときに、左の欄の四角 r を渡して呼ぶ。担当はこのファイルだけを書く。
// いまは見出しだけを描く（中身は担当が書く）。
//
// 書き換えてよいもの: ed（e2ApplyOps・e2SetStatus を通して）、kit、v（ほかの担当の *_state.um の中は除く）。
// 状態が要るなら、このファイル専用の状態の struct を *_state.um に作り、E2View に足す（wm_state.um が見本）。
// コマンドを実行するなら、文字の ID を返さずに e2_cmds.um の e2CmdRun を呼ぶ。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は railSettings で始める。
import { UkCtx } from "../uikit/core.um";
import { UkRect } from "../uikit/base.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";
import { e2PanelHead } from "./e2_chrome.um";

export function railSettings(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, r: UkRect): void {
  const body = e2PanelHead(mut ui, kit, r, "設定");
}
