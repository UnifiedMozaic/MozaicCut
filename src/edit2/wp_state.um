// 配線（素材の欄）の状態: 素材をタイムラインへ運んでいる間の落とし先。E2View.wp に入れる（wire_pool.um と wp_*.um だけが書き換える）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wp / Wp で始める。

export struct WpState {
  // 素材をタイムラインへ運んでいる間の落とし先（dropOn のときだけ。時刻・行）
  dropOn: bool;
  dropT: f64;
  dropRow: i32;
}

export function wpStateNew(): WpState {
  return {
    dropOn: false, dropT: 0.0, dropRow: -1,
  };
}
