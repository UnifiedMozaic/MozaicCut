// コマンド（表示と再生）: view.*・workspace.*・panel.*・play.*・playhead.*（マーカーとイン・アウトへの移動を除く）・tool.*。
// 表（e2_cmds.um の e2CmdTable）に並べたコマンドのうち、このファイルが受け持つものの中身。
//
// - e2cViewReady(id): つないだ（実行できる）コマンドなら true。true のものだけがメニュー・右クリック・コマンドの欄に出る。
// - e2cViewRun(...): 実行したら true。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は e2cView で始める。
import { UkCtx } from "../uikit/core.um";
import {
  E2, e2SetStatus, e2PbRequest, E2_PB_TOGGLE, E2_PB_SEEK, E2_PB_STEP, E2_PB_J, E2_PB_K, E2_PB_L,
} from "./e2_state.um";
import {
  E2Kit, E2View, E2_TAB_INSPECTOR, E2_TAB_HISTORY, E2_WS_EDIT, E2_WS_COLOR, E2_WS_AUDIO, E2_WS_OUTPUT,
} from "./e2_view.um";

export function e2cViewReady(id: string): bool {
  const ok: string[] = [
    "workspace.edit", "workspace.color", "workspace.audio", "workspace.export",
    "view.rightColumn", "view.focusMode", "view.resetLayout", "panel.inspector", "panel.history", "panel.problems",
    "play.toggle", "play.reverse", "play.stop", "play.forward", "playhead.stepBack", "playhead.stepForward",
    "playhead.step10Back", "playhead.step10Forward", "playhead.back1s", "playhead.forward1s", "playhead.start", "playhead.end",
    "view.fit", "view.snap",
  ];
  for (const s of ok) {
    if (s == id) {
      return true;
    }
  }
  return false;
}

export function e2cViewRun(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, id: string): bool {
  if (id == "workspace.edit") {
    v.workspace = E2_WS_EDIT;
  } else if (id == "workspace.color") {
    v.workspace = E2_WS_COLOR;
  } else if (id == "workspace.audio") {
    v.workspace = E2_WS_AUDIO;
  } else if (id == "workspace.export") {
    v.workspace = E2_WS_OUTPUT;
  } else if (id == "view.rightColumn") {
    v.rightOpen = !v.rightOpen;
  } else if (id == "view.focusMode") {
    const open = !(v.leftOpen || v.rightOpen);
    v.leftOpen = open;
    v.rightOpen = open;
  } else if (id == "view.resetLayout") {
    v.leftW = 260;
    v.rightW = 320;
    v.tlFrac = 0.44;
    v.leftOpen = true;
    v.rightOpen = true;
  } else if (id == "panel.problems") {
    v.leftOpen = true;
    v.railSel = 5;
  } else if (id == "panel.inspector") {
    v.rightOpen = true;
    v.rightTab = E2_TAB_INSPECTOR;
  } else if (id == "panel.history") {
    v.rightOpen = true;
    v.rightTab = E2_TAB_HISTORY;
  } else if (id == "play.toggle") {
    e2PbRequest(mut ed, E2_PB_TOGGLE, 0.0);
  } else if (id == "play.reverse") {
    e2PbRequest(mut ed, E2_PB_J, 0.0);
  } else if (id == "play.stop") {
    e2PbRequest(mut ed, E2_PB_K, 0.0);
  } else if (id == "play.forward") {
    e2PbRequest(mut ed, E2_PB_L, 0.0);
  } else if (id == "playhead.stepBack") {
    e2PbRequest(mut ed, E2_PB_STEP, -1.0);
  } else if (id == "playhead.stepForward") {
    e2PbRequest(mut ed, E2_PB_STEP, 1.0);
  } else if (id == "playhead.step10Back") {
    e2PbRequest(mut ed, E2_PB_STEP, -10.0);
  } else if (id == "playhead.step10Forward") {
    e2PbRequest(mut ed, E2_PB_STEP, 10.0);
  } else if (id == "playhead.back1s") {
    e2PbRequest(mut ed, E2_PB_SEEK, Math.max(ed.t - 1.0, 0.0));
  } else if (id == "playhead.forward1s") {
    e2PbRequest(mut ed, E2_PB_SEEK, Math.min(ed.t + 1.0, ed.project.duration));
  } else if (id == "playhead.start") {
    e2PbRequest(mut ed, E2_PB_SEEK, 0.0);
  } else if (id == "playhead.end") {
    e2PbRequest(mut ed, E2_PB_SEEK, ed.project.duration);
  } else if (id == "view.fit") {
    v.tl.fit = true;
  } else if (id == "view.snap") {
    v.tl.snap = !v.tl.snap;
    if (v.tl.snap) {
      e2SetStatus(mut ed, "スナップを入れました", false);
    } else {
      e2SetStatus(mut ed, "スナップを切りました", false);
    }
  } else {
    // view.zoomIn・view.zoomOut・view.cleanViewer・view.monitors・playhead.prevEdit・playhead.nextEdit・
    // playhead.goto・tool.* はまだ空
    return false;
  }
  return true;
}
