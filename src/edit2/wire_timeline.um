// 配線: タイムライン（src/ui_timeline/）から出てくる出来事を受け取る所。担当はこのファイルだけを書く。
//
// res（TlResult）の中身（src/ui_timeline/tl_model.um）:
//   res.ops        ops.um の文（move / trim / split / set）。e2ApplyOps(mut ed, res.ops) で 1 つの操作として適用・保存する
//   res.command    帯のボタンのコマンドの ID（"edit.split" / "edit.lift" / "edit.rippleDelete" / "clip.speed" / "view.zoomFit"）。
//                  op の文にするのは timeline.um の tlSplitOps・tl_edit.um の tlLiftOps / tlRippleDeleteOps
//   res.seek       再生ヘッドを動かした（v.tl.playhead に新しい時刻）。e2PbRequest(mut ed, E2_PB_SEEK, v.tl.playhead)
//   res.selChanged 選択が変わった（v.tl.sel）。インスペクタは e2ViewSync が次のフレームで作り直す
//   res.trimming   トリム・ドラッグの最中。res.status を状態の帯に出す（edit2.um が出す）
// 書き換えてよいもの: ed（e2ApplyOps・e2PbRequest・e2SetStatus を通して）、v.tl。ほかの部品の状態は触らない。
// キー（wireTimelineKeys）は e2Frame の初め、モニターの monKeys より先に呼ぶ（S・Delete・Ctrl+Z などを先に取るため）。
import { UkCtx } from "../uikit/core.um";
import { UkRect } from "../uikit/base.um";
import { TlResult } from "../ui_timeline/tl_model.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";

// r はタイムラインの四角（tlGeo で、時刻と画面の位置を行き来するため）。
export function wireTimelineKeys(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, r: UkRect): void {
}

export function wireTimeline(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, res: TlResult, r: UkRect): void {
}
