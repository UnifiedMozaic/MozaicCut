// 配線: タイムライン（src/ui_timeline/）から出てくる出来事を受け取り、ops.um の操作にして .mzc に書く所。
//
// res（TlResult）の中身（src/ui_timeline/tl_model.um）:
//   res.ops        ops.um の文（move / trim / split / set）。ドラッグで動かす・端を引く・刃で切る・フェードのつまみ
//   res.command    帯のボタンのコマンドの ID（"edit.split" / "edit.lift" / "edit.rippleDelete" / "clip.speed" / "view.zoomFit"）
//   res.seek       ルーラーで再生ヘッドを動かした（v.tl.playhead に新しい時刻）
//   res.selChanged 選択が変わった（v.tl.sel）。インスペクタは e2ViewSync が次のフレームで作り直す
//   res.trimming   トリム・ドラッグの最中（状態の帯には edit2.um が res.status を出す）
// キー（wireTimelineKeys）は e2Frame の初め、モニターの monKeys より先に呼ぶ（S・Delete・Ctrl+Z などを先に取るため）:
//   S / Ctrl+B 分割、Delete / Backspace 削除（隙間を残す）、Shift+Delete 詰めて削除、N スナップ（ドラッグ中は逆にする）、
//   V / T / B ツール、Alt+← → 1 コマ動かす（Shift で 10 コマ）、= / + / - 拡大・縮小、Shift+Z 全体（タイムラインに
//   フォーカスがあるとき）、Ctrl+Z 取り消し、Ctrl+Shift+Z / Ctrl+Y やり直し。
// 素材の欄からのドラッグ（ui.dragKind == POOL_DRAG_MEDIA）をトラックの上で離すと、その位置に add する。
// 書き換えてよいもの: ed（e2ApplyOps・e2Undo / e2Redo・e2PbRequest・e2SetStatus を通して）、v.tl。ほかの部品の状態は読むだけ。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wireTimeline / wtl で始める。
import {
  UkCtx, UK_KEY_CHAR, UK_KEY_DELETE, UK_KEY_BACKSPACE, UK_KEY_LEFT, UK_KEY_RIGHT, UK_MOD_SHIFT, UK_MOD_CTRL, UK_MOD_ALT,
} from "../uikit/core.um";
import { UkRect, ukInside, ukFixed } from "../uikit/base.um";
import {
  TlResult, TlState, tlClipName, tlTc, tlQuant, tlOpTime, tlSelClear, TL_TOOL_SELECT, TL_TOOL_TRIM, TL_TOOL_BLADE, TL_DRAG_NONE,
  TL_DRAG_MOVE, TL_DRAG_TRIM, tlSecText,
} from "../ui_timeline/tl_model.um";
import { tlSplitOps, tlDragToggleSnap, tlZoomAround } from "../ui_timeline/timeline.um";
import { tlLiftOps, tlRippleDeleteOps, tlNudgeOps, tlCloseGapOps } from "../ui_timeline/tl_edit.um";
import { TlGeo, tlGeo, tlT, tlX, tlRowAt } from "../ui_timeline/tl_geo.um";
import { POOL_DRAG_MEDIA, poolDragMedia } from "../ui_pool/pool_panel.um";
import { POOL_K_AUDIO, POOL_K_IMAGE } from "../ui_pool/pool_tokens.um";
import { Project, Diag, findClip, parseProject } from "../project.um";
import { splitArgs, runOps } from "../ops.um";
import { parseNum, sub, nan, textStartsWith } from "../text.um";
import { E2, e2ApplyOps, e2ProbesWithImported, e2Undo, e2Redo, e2SetStatus, e2PbRequest, E2_PB_SEEK } from "./e2_state.um";
import { E2Kit, E2View, e2ViewSync } from "./e2_view.um";
import { wmoTimeline } from "./wire_motion.um";

// 比べる修飾キー（Shift・Ctrl・Alt・Meta）
const WTL_MODS: i32 = 15;

// ---- キーを取る（修飾キーがちょうど mods のときだけ） ----

// ukKeyTakeMods は修飾キーを見ずに取るので、S と Ctrl+S、Delete と Shift+Delete を分けるために自分で探す。
function wtlTake(ui: mut UkCtx, key: i32, mods: i32): bool {
  for (let i: usize = 0; i < ui.inp.keys.length; i++) {
    if (ui.inp.keys[i] == key && (ui.inp.keyMods[i] & WTL_MODS) == mods) {
      ui.inp.keys[i] = 0;
      return true;
    }
  }
  return false;
}

// 文字のキー（小文字の符号位置）。大文字で来たら Shift を押したものとして比べる。
function wtlTakeChar(ui: mut UkCtx, cp: i32, mods: i32): bool {
  for (let i: usize = 0; i < ui.inp.keys.length; i++) {
    const k = ui.inp.keys[i];
    let m = ui.inp.keyMods[i] & WTL_MODS;
    let hit = k == UK_KEY_CHAR + cp;
    if (!hit && cp >= 97 && cp <= 122 && k == UK_KEY_CHAR + cp - 32) {
      hit = true;
      m = m | UK_MOD_SHIFT;
    }
    if (hit && m == mods) {
      ui.inp.keys[i] = 0;
      return true;
    }
  }
  return false;
}

// ---- 操作の適用 ----

// 選んだものの名前と「を」（1 つなら「clip_a.mp4 を」、いくつかなら「クリップ 3 個を」）。
function wtlSelName(ed: E2, st: TlState): string {
  if (st.sel.length == 1) {
    const ci = st.sel[0];
    if (ci >= 0 && (ci as usize) < ed.project.clips.length) {
      return `${tlClipName(ed.project.clips[ci as usize])} を`;
    }
  }
  return `クリップ ${st.sel.length} 個を`;
}

// 「set <id> at=<秒>」だけの op なら、その秒（でなければ NaN）。
function wtlSetAtTime(op: string): f64 {
  const w = splitArgs(op);
  if (w.length != 3 || w[0] != "set" || w[2].length < 4) {
    return nan();
  }
  const a = w[2].clone();
  if (a[0] != 97 || a[1] != 116 || a[2] != 61) {
    return nan();
  }
  return parseNum(sub(a, 3, a.length));
}

function wtlCopyOps(ops: string[]): string[] {
  let out: string[] = [];
  for (const o of ops) {
    out.push(o.clone());
  }
  return out;
}

// ops のうち use[i] のものだけを当てた後の Project（当てられなければ null）。
function wtlTryOps(ed: E2, ops: string[], use: bool[]): Project | null {
  let words: string[][] = [];
  for (let i: usize = 0; i < ops.length; i++) {
    if (use[i]) {
      words.push(splitArgs(ops[i]));
    }
  }
  const res = runOps(ed.lines, e2ProbesWithImported(ed), words);
  if (!res.ok) {
    return null;
  }
  let bytes: u8[] = [];
  for (const l of res.lines) {
    for (const c of l) {
      bytes.push(c);
    }
    bytes.push(10);
  }
  let err: Diag[] = [];
  return parseProject(bytes, ed.probes, mut err);
}

// 何も変えない「set <id> at=<秒>」を落とす。部品（tl_edit の tlPlanFinish）は at= のない行の位置を「前の行の後ろ」と
// 比べるので、xfade= で前と重ねた行（demo.mzc の clip_b）を、動かしていないのに「位置がずれた」とみなして
// at=5.000000 を書き足してしまう。その op を除いて当てても、その行がもともとその秒に置かれるなら、書く意味がない。
// （Delete で前を消したときの「後ろを固定」の at= は、除くと位置が変わるので残る。）
function wtlPruneSetAt(ed: E2, ops: string[]): string[] {
  let use: bool[] = [];
  let cand = false;
  for (let i: usize = 0; i < ops.length; i++) {
    const t = wtlSetAtTime(ops[i]);
    // split のすぐ後ろの set at= は、後半の参照（at=<id>.end）を秒の数値にするもの（timeline.um の tlSplitPush）。
    // 位置は変わらないが、書く意味があるので除かない
    const afterSplit = i > 0 && textStartsWith(ops[i - 1], "split ");
    use.push(t != t || afterSplit);
    if (t == t && !afterSplit) {
      cand = true;
    }
  }
  if (!cand) {
    return wtlCopyOps(ops);
  }
  // 除いた結果で位置が合わないものを戻す。戻すと後ろの行が動くことがあるので、変わらなくなるまで数回
  for (let pass = 0; pass < 4; pass++) {
    const pr = wtlTryOps(ed, ops, use);
    if (pr == null) {
      return wtlCopyOps(ops);
    }
    let back = false;
    for (let i: usize = 0; i < ops.length; i++) {
      if (use[i]) {
        continue;
      }
      const w = splitArgs(ops[i]);
      const ci = findClip(pr, w[1]);
      const t = wtlSetAtTime(ops[i]);
      if (ci < 0 || Math.abs(pr.clips[ci as usize].at - t) > 0.0000005) {
        use[i] = true;
        back = true;
      }
    }
    if (!back) {
      let out: string[] = [];
      for (let i: usize = 0; i < ops.length; i++) {
        if (use[i]) {
          out.push(ops[i].clone());
        }
      }
      return out;
    }
  }
  return wtlCopyOps(ops);
}

// op の文をまとめて 1 つの操作として適用する。what が空でなく、op が 2 つ以上なら、状態の帯の 1 文を what にする
// （1 つなら ops.um の説明のほうが詳しい）。clearSel なら、適用したあと選択を外す（消したクリップの番号がずれるため）。
function wtlApply(ed: mut E2, v: mut E2View, opsIn: string[], what: string, clearSel: bool): bool {
  const ops = wtlPruneSetAt(ed, opsIn);
  if (ops.length == 0) {
    return true;
  }
  if (!e2ApplyOps(mut ed, ops)) {
    return false;
  }
  if (what.length > 0 && ops.length > 1) {
    e2SetStatus(mut ed, what, false);
  }
  if (clearSel) {
    tlSelClear(mut v.tl);
  }
  return true;
}

function wtlSplit(ed: mut E2, v: mut E2View): void {
  const ops = tlSplitOps(v.tl, ed.project);
  if (ops.length == 0) {
    if (v.tl.sel.length > 0) {
      e2SetStatus(mut ed, `再生ヘッド（${tlTc(v.tl, v.tl.playhead)}）が選んだクリップの中にないので、分けられません`, false);
    } else {
      e2SetStatus(mut ed, `再生ヘッド（${tlTc(v.tl, v.tl.playhead)}）の所に、分けられるクリップがありません（ターゲットのトラック）`, false);
    }
    return;
  }
  // ops には後半の at= を数値にする set も入るので、split の数を数える
  let n = 0;
  for (const o of ops) {
    if (textStartsWith(o, "split ")) {
      n++;
    }
  }
  wtlApply(mut ed, mut v, ops, `${n} 個のクリップを ${tlTc(v.tl, v.tl.playhead)} で分けました`, false);
}

function wtlCloseGap(ed: mut E2, v: mut E2View): void {
  const len = v.tl.gapE - v.tl.gapS;
  const ops = tlCloseGapOps(v.tl, ed.project);
  v.tl.gapRow = -1;
  if (ops.length == 0) {
    e2SetStatus(mut ed, "詰めるクリップがありません（ロックしたトラックか、隙間の後ろにクリップがありません）", false);
    return;
  }
  wtlApply(mut ed, mut v, ops, `隙間（${tlSecText(len)}）を詰めました`, false);
}

function wtlLift(ed: mut E2, v: mut E2View): void {
  if (v.tl.sel.length == 0) {
    e2SetStatus(mut ed, "消すクリップを選んでいません", false);
    return;
  }
  const name = wtlSelName(ed, v.tl);
  const ops = tlLiftOps(v.tl, ed.project);
  if (ops.length == 0) {
    e2SetStatus(mut ed, "選んだクリップはロックしたトラックにあるので、消せません", false);
    return;
  }
  wtlApply(mut ed, mut v, ops, `${name}消しました（隙間を残しました）`, true);
}

function wtlRippleDelete(ed: mut E2, v: mut E2View): void {
  if (v.tl.sel.length == 0) {
    e2SetStatus(mut ed, "消すクリップを選んでいません", false);
    return;
  }
  const name = wtlSelName(ed, v.tl);
  const ops = tlRippleDeleteOps(v.tl, ed.project);
  if (ops.length == 0) {
    e2SetStatus(mut ed, "選んだクリップはロックしたトラックにあるので、消せません", false);
    return;
  }
  wtlApply(mut ed, mut v, ops, `${name}消して後ろを詰めました（ほかに ${ops.length - 1} 個の行を書き換えました）`, true);
}

function wtlNudge(ed: mut E2, v: mut E2View, frames: i64): void {
  const name = wtlSelName(ed, v.tl);
  const ops = tlNudgeOps(v.tl, ed.project, frames);
  if (ops.length == 0) {
    e2SetStatus(mut ed, "選んだクリップは動かせません（ロックしたトラックにあります）", false);
    return;
  }
  let dir = "後ろ";
  let n = frames;
  if (frames < 0) {
    dir = "前";
    n = -frames;
  }
  wtlApply(mut ed, mut v, ops, `${name} ${n} コマ${dir}に動かしました`, false);
}

// 取り消し・やり直しのあと、クリップの数が変わったら選択を外す（番号が別のクリップを指すため）。
function wtlAfterHistory(ed: E2, v: mut E2View, n0: usize): void {
  if (ed.project.clips.length != n0) {
    tlSelClear(mut v.tl);
  }
}

// ---- 拡大・縮小 ----

function wtlGeo(ui: UkCtx, v: mut E2View, r: UkRect): TlGeo {
  return tlGeo(mut v.tl, r, ui.theme.scale);
}

// 再生ヘッドを中心に f 倍にする（再生ヘッドが見えていなければ真ん中）。
function wtlZoom(ui: UkCtx, ed: mut E2, v: mut E2View, r: UkRect, f: f64): void {
  const g = wtlGeo(ui, mut v, r);
  let ax = tlX(v.tl, g, v.tl.playhead);
  if (ax < g.lanes.x || ax > g.lanes.x + g.lanes.w) {
    ax = g.lanes.x + g.lanes.w / 2;
  }
  tlZoomAround(mut v.tl, g, v.tl.pps * f, ax);
  e2SetStatus(mut ed, `タイムラインを 1 秒 ${ukFixed(v.tl.pps / (ui.theme.scale as f64), 0)} px にしました`, false);
}

// ---- キー（e2Frame の初め、モニターより先に呼ぶ） ----

export function wireTimelineKeys(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, r: UkRect): void {
  // 文字の入力欄がキーを使っている間（検索の欄・インスペクタの値）は何もしない
  if (ui.wantText || r.h <= 0) {
    return;
  }
  const ver0 = ed.ver;
  wtlKeys(mut ui, mut ed, mut v, r);
  // ファイルを書き換えたら、このフレームの部品（タイムライン・インスペクタ）を描く前に中身を作り直す
  // （タイムラインの索引が前のプロジェクトのクリップの番号のままだと、消したクリップを指してしまう）
  if (ed.ver != ver0) {
    e2ViewSync(ed, mut kit, mut v);
  }
}

function wtlKeys(ui: mut UkCtx, ed: mut E2, v: mut E2View, r: UkRect): void {
  // 取り消し・やり直し（画面全体のキーの振り分けができるまで、ここで受ける。モニターの monKeys が Z を取る前に）
  if (wtlTakeChar(mut ui, 122, UK_MOD_CTRL)) {
    const n0 = ed.project.clips.length;
    e2Undo(mut ed);
    wtlAfterHistory(ed, mut v, n0);
  }
  if (wtlTakeChar(mut ui, 122, UK_MOD_CTRL | UK_MOD_SHIFT) || wtlTakeChar(mut ui, 121, UK_MOD_CTRL)) {
    const n0 = ed.project.clips.length;
    e2Redo(mut ed);
    wtlAfterHistory(ed, mut v, n0);
  }
  // ドラッグの最中: N（Premiere 互換は S）でこのドラッグの間だけスナップを逆にする
  if (v.tl.drag == TL_DRAG_MOVE || v.tl.drag == TL_DRAG_TRIM) {
    if (wtlTakeChar(mut ui, 110, 0) || wtlTakeChar(mut ui, 115, 0)) {
      tlDragToggleSnap(mut v.tl);
    }
    return;
  }
  if (v.tl.drag != TL_DRAG_NONE) {
    return;
  }
  // スナップ（マグネット）
  if (wtlTakeChar(mut ui, 110, 0)) {
    v.tl.snap = !v.tl.snap;
    if (v.tl.snap) {
      e2SetStatus(mut ed, "スナップ（マグネット）を入れました", false);
    } else {
      e2SetStatus(mut ed, "スナップ（マグネット）を切りました", false);
    }
  }
  // ツール
  if (wtlTakeChar(mut ui, 118, 0)) {
    v.tl.tool = TL_TOOL_SELECT;
    e2SetStatus(mut ed, "選択ツール（V）", false);
  }
  if (wtlTakeChar(mut ui, 116, 0)) {
    v.tl.tool = TL_TOOL_TRIM;
    e2SetStatus(mut ed, "トリムツール（T）: 端を引くと後ろが詰まる・押される。Enter で確定、Esc でやめる", false);
  }
  if (wtlTakeChar(mut ui, 98, 0)) {
    v.tl.tool = TL_TOOL_BLADE;
    e2SetStatus(mut ed, "刃のツール（B）: クリップを押した所で分けます", false);
  }
  // 分割
  if (wtlTakeChar(mut ui, 115, 0) || wtlTakeChar(mut ui, 98, UK_MOD_CTRL)) {
    wtlSplit(mut ed, mut v);
  }
  // 削除・1 コマ動かす。素材の欄で素材を選んでいて、フォーカスがタイムラインにないときは素材の欄に渡す
  if (v.tl.sel.length > 0 && (v.tl.lanesFocus || v.pool.sel.length == 0)) {
    if (wtlTake(mut ui, UK_KEY_DELETE, 0) || wtlTake(mut ui, UK_KEY_BACKSPACE, 0)) {
      wtlLift(mut ed, mut v);
    }
    if (wtlTake(mut ui, UK_KEY_DELETE, UK_MOD_SHIFT) || wtlTake(mut ui, UK_KEY_BACKSPACE, UK_MOD_SHIFT)) {
      wtlRippleDelete(mut ed, mut v);
    }
    // Alt+← →（モニターは Alt のついた矢印を使わない）
    if (wtlTake(mut ui, UK_KEY_LEFT, UK_MOD_ALT)) {
      wtlNudge(mut ed, mut v, -1);
    }
    if (wtlTake(mut ui, UK_KEY_RIGHT, UK_MOD_ALT)) {
      wtlNudge(mut ed, mut v, 1);
    }
    if (wtlTake(mut ui, UK_KEY_LEFT, UK_MOD_ALT | UK_MOD_SHIFT)) {
      wtlNudge(mut ed, mut v, -10);
    }
    if (wtlTake(mut ui, UK_KEY_RIGHT, UK_MOD_ALT | UK_MOD_SHIFT)) {
      wtlNudge(mut ed, mut v, 10);
    }
  } else if (v.tl.gapRow >= 0) {
    // 隙間を選んでいる: Delete（Shift+Delete も）で後ろを詰める
    if (wtlTake(mut ui, UK_KEY_DELETE, 0) || wtlTake(mut ui, UK_KEY_BACKSPACE, 0) || wtlTake(mut ui, UK_KEY_DELETE, UK_MOD_SHIFT) ||
      wtlTake(mut ui, UK_KEY_BACKSPACE, UK_MOD_SHIFT)) {
      wtlCloseGap(mut ed, mut v);
    }
  }
  // 拡大・縮小（= と +、-）。全体（Shift+Z）はタイムラインにフォーカスがあるときだけ（なければモニターの全体）
  if (wtlTakeChar(mut ui, 61, 0) || wtlTakeChar(mut ui, 61, UK_MOD_SHIFT) || wtlTakeChar(mut ui, 43, 0) ||
    wtlTakeChar(mut ui, 43, UK_MOD_SHIFT)) {
    wtlZoom(ui, mut ed, mut v, r, 1.5);
  }
  if (wtlTakeChar(mut ui, 45, 0)) {
    wtlZoom(ui, mut ed, mut v, r, 1.0 / 1.5);
  }
  if (v.tl.lanesFocus && wtlTakeChar(mut ui, 122, UK_MOD_SHIFT)) {
    v.tl.fit = true;
    e2SetStatus(mut ed, "タイムラインを全体に合わせました", false);
  }
}

// ---- 素材の欄からのドロップ ----

function wtlQuote(s: string): string {
  let out: u8[] = [34];
  for (const b of s) {
    if (b == 34 || b == 92) {
      out.push(92);
    }
    out.push(b);
  }
  out.push(34);
  return stringFromBytes(out);
}

// 素材の欄から運んできた素材を、離した位置（時刻とトラック）に足す。
function wtlDropMedia(ui: UkCtx, ed: mut E2, kit: E2Kit, v: mut E2View, g: TlGeo): void {
  const mi = poolDragMedia(kit.lib, v.pool, ui.dragData);
  if (mi < 0) {
    e2SetStatus(mut ed, "運んできた素材が、素材の欄に見つかりません", true);
    return;
  }
  const mk = kit.lib.media[mi as usize].kind;
  const path = kit.lib.media[mi as usize].path.clone();
  const mIn = kit.lib.media[mi as usize].inSec;
  const mOut = kit.lib.media[mi as usize].outSec;
  const mDur = kit.lib.media[mi as usize].durSec;
  const at = Math.max(tlQuant(v.tl, tlT(v.tl, g, ui.inp.mx)), 0.0);
  const audio = mk == POOL_K_AUDIO;
  // 離した行が同じ種類（映像 ／ 音）のトラックならそこ、違えば 1 番（V1 ／ A1）
  let track = 0;
  const row = tlRowAt(v.tl, g, ui.inp.my);
  if (row >= 0 && v.tl.tracks[row as usize].audio == audio) {
    track = v.tl.tracks[row as usize].index;
  }
  let op = "";
  if (mk == POOL_K_IMAGE) {
    op = `add image ${wtlQuote(path)} at=${tlOpTime(v.tl, at)} dur=5`;
  } else {
    let kindWord = "video";
    if (audio) {
      kindWord = "audio";
    }
    const inS = Math.max(mIn, 0.0);
    let dur = mDur - inS;
    if (mOut > inS) {
      dur = mOut - inS;
    }
    if (dur <= 0.0) {
      dur = 5.0;
    }
    op = `add ${kindWord} ${wtlQuote(path)} at=${tlOpTime(v.tl, at)} in=${tlOpTime(v.tl, inS)} dur=${tlOpTime(v.tl, dur)}`;
  }
  if (track != 0) {
    op = `${op} track=${track}`;
  }
  const ops: string[] = [op];
  wtlApply(mut ed, mut v, ops, "", false);
}

// ---- 部品の出来事 ----

export function wireTimeline(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, res: TlResult, r: UkRect): void {
  const ver0 = ed.ver;
  wmoTimeline(mut ui, mut ed, mut kit, mut v, r);
  let applied = false;
  // ドラッグで動かす・端を引く・刃・フェードのつまみ（離したとき。リップル・ロールのトリムは Enter のとき）
  if (res.ops.length > 0) {
    applied = true;
    wtlApply(mut ed, mut v, res.ops, res.opsNote, false);
  }
  // 帯のボタン
  if (res.command == "edit.split") {
    applied = true;
    wtlSplit(mut ed, mut v);
  } else if (res.command == "edit.lift") {
    applied = true;
    wtlLift(mut ed, mut v);
  } else if (res.command == "edit.rippleDelete") {
    applied = true;
    wtlRippleDelete(mut ed, mut v);
  } else if (res.command == "clip.speed") {
    e2SetStatus(mut ed, "速度はまだ変えられません", false);
  } else if (res.command == "view.zoomFit") {
    e2SetStatus(mut ed, "タイムラインを全体に合わせました", false);
  }
  // 再生ヘッド（ルーラーを押す・ドラッグ）
  if (res.seek) {
    e2PbRequest(mut ed, E2_PB_SEEK, v.tl.playhead);
  }
  // 素材の欄からのドロップ（トラックの上で離した）
  if (ui.dragKind == POOL_DRAG_MEDIA && (ui.inp.released & 1) != 0 && r.h > 0) {
    const g = wtlGeo(ui, mut v, r);
    if (ukInside(g.lanes, ui.inp.mx, ui.inp.my)) {
      applied = true;
      wtlDropMedia(ui, mut ed, kit, mut v, g);
    }
  }
  // 選択（状態の帯に何を選んだかを出す。操作を適用したフレームは、その結果の文を残す）
  if (res.selChanged && !applied) {
    if (v.tl.sel.length == 0) {
      e2SetStatus(mut ed, "選択を外しました", false);
    } else if (v.tl.sel.length == 1) {
      const ci = v.tl.sel[0] as usize;
      if (ci < ed.project.clips.length) {
        const name = tlClipName(ed.project.clips[ci]);
        const s0 = ed.project.clips[ci].at;
        const s1 = s0 + ed.project.clips[ci].dur;
        e2SetStatus(mut ed, `${name} を選びました（${tlTc(v.tl, s0)}〜${tlTc(v.tl, s1)}）`, false);
      }
    } else {
      e2SetStatus(mut ed, `クリップ ${v.tl.sel.length} 個を選んでいます`, false);
    }
  }
  // 部品の短い知らせ（「… はまだ書き方がありません」など。トリムの最中の文は edit2.um が出す）
  if (!res.trimming && res.status.length > 0 && res.status != ed.status) {
    e2SetStatus(mut ed, res.status, false);
  }
  // このフレームの後ろの部品（状態の帯など）も新しい中身で描く
  if (ed.ver != ver0) {
    e2ViewSync(ed, mut kit, mut v);
  }
}
