// レールの左の欄（効果・文字・音・問題・設定。rail_*.um）の状態。E2View.rl に入れる（rail_*.um だけが書き換える）。
// E2View から読むので、このファイルは e2_* を読まない。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wrl / Wrl / WRL で始める。

// レールの欄から運ぶもの（ui.dragKind）。ui.dragData は、それぞれの欄の項目の番号
export const WRL_DRAG_FX: i32 = 0x5246;     // 効果 → タイムラインのクリップ
export const WRL_DRAG_TEXT: i32 = 0x5254;   // 文字のひな形 → タイムライン
export const WRL_DRAG_AUDIO: i32 = 0x5241;  // 音の効果 → 音のトラック・音のクリップ

// 効果の見本の絵の大きさ（効果を掛ける画素の数。描くときは 1 画素を 2×2 の四角にする）
export const WRL_THUMB_W: i32 = 24;
export const WRL_THUMB_H: i32 = 14;

export struct WrlState {
  // ---- 効果 ----
  fxQuery: string;
  // 分類の札（rail_fx.um の RAIL_FX_CAT_*。0 はすべて）
  fxCat: i32;
  // 選んだ効果（効果の番号。-1 なし）
  fxSel: i32;
  // 効果ごとの見本の絵（WRL_THUMB_W × WRL_THUMB_H の 0xAARRGGBB。効果の番号の順に並べる）。最初に欄を開いたときに作る
  fxThumb: u32[];
  fxThumbN: i32;
  // ---- 文字 ----
  txSel: i32;
  // ---- 音 ----
  auSel: i32;
  // 付ける先の音のトラック（.mzc の track=。-1 なら、選んだクリップのトラック）
  auTrack: i32;
  // ---- 問題 ----
  prSel: i32;
  // 選んだときの診断の文（読み直して並びが変わっても、同じ診断を選び続けるため）
  prKey: string;
  // 素材の場所を選ぶダイアログを出したクリップ（ref）。"" なら出していない
  prRelink: string;
  // ---- 設定 ----
  keyQuery: string;
  // キーの割り当ての一覧（コマンドの名前・キーの札・分類。初めて欄を開いたときに作る。倍率を変えたら作り直す）
  keyNames: string[];
  keyCaps: string[];
  keyGroups: string[];
  // 表示の倍率を変える頼み（0 ならなし）。edit2.um の輪がフレームの外で部品を作り直す
  scaleReq: f32;
}

export function wrlStateNew(): WrlState {
  return {
    fxQuery: "", fxCat: 0, fxSel: -1, fxThumb: [], fxThumbN: 0, txSel: -1, auSel: -1, auTrack: -1, prSel: -1, prKey: "",
    prRelink: "", keyQuery: "", keyNames: [], keyCaps: [], keyGroups: [], scaleReq: 0.0,
  };
}
