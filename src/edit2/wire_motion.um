// M6 の操作の画面（src/ws_motion/。docs/design/motion.md）を新しい編集画面につなぐ所。docs/design/edit2.md の「M6 の操作の画面の配線」。
//
// - wmoTick（edit2.um が e2Frame の初め、タイムラインのキー wireTimelineKeys より前に呼ぶ）:
//   タイムラインのクリップの上のキーフレームの印（moKfOnClip）。
//   部品（tlTimeline）より先に押しを取るため、部品より前に呼び、上の層（WMO_LAYER）に描いて部品の上に重ねる。
//   選んだキーの Delete も、タイムラインの Delete（クリップを消す）より先に取る。
// - wmoTimeline・wmoInspector・wmoMonitor（各配線の関数の初めに 1 行ずつ）: 部品を描いた直後の口。
//
// 部品の出来事（MoEvent）の受け方（motion.md の「出来事」）:
//   MO_E_OP は e2ApplyOps（1 つの取り消し）、MO_E_PREVIEW は ed.lines に当てた写しで ed.project を入れ替えて描き直す
//   （保存も履歴もしない。離したときの MO_E_OP か、やめたときの MO_E_CANCEL で読み直す）、MO_E_SEEK は E2_PB_SEEK、
//   MO_E_SELECT は v.wmo.prop（グラフに出すキー）と、そのクリップの選択。
// 状態は v.wmo（wmo_state.um の WmoState）、テーマは kit.wmo.th（MoTheme）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wmo / Wmo で始める。
import { UkCtx, ukPushClip, ukPopClip, ukPushLayer, ukPopLayer, ukMouseIn, UK_MOD_ALT } from "../uikit/core.um";
import { UkRect, ukRect, ukIntersect, ukEmpty } from "../uikit/base.um";
import { MonAct, MON_PROGRAM } from "../ui_monitor/monitor.um";
import {
  InsEvent, insSetKf, INS_M_CLIP, INS_KF_NONE, INS_KF_OFF, INS_KF_ON, INS_E_SET, INS_E_PREVIEW, INS_E_KF_TOGGLE, INS_E_KF_PREV,
  INS_E_KF_NEXT, INS_E_KF_HERE,
} from "../ui_inspector/ins_model.um";
import { tlSyncSel } from "../ui_timeline/tl_model.um";
import { TlGeo, tlGeo, tlX, tlRowArea } from "../ui_timeline/tl_geo.um";
import { tlPx } from "../ui_timeline/tl_theme.um";
import { Project, Clip, Diag, parseProject, findClip, KIND_SHAPE } from "../project.um";
import { hasKey } from "../lineedit.um";
import { runOps, splitArgs } from "../ops.um";
import {
  MoEvent, MoView, moEv, moFps, moSnap, moNum, moRef, moIsVisual, moAnimIndex, moKeyAt, moValueText, moOpValue, MO_E_OP,
  MO_E_PREVIEW, MO_E_SEEK, MO_E_SELECT, MO_E_CANCEL,
} from "../ws_motion/mo_core.um";
import { moNeighborKey } from "../ws_motion/mo_keynav.um";
import { moKfStateNew, moKfOnClip } from "../ws_motion/mo_kflane.um";
import { moGizmo, moGizmoBusy } from "../ws_motion/mo_gizmo.um";
import { moPoints, moPointsBusy } from "../ws_motion/mo_points.um";
import { moClipAtPoint, moClipXf } from "../ws_motion/mo_geom.um";
import { E2, e2ApplyOps, e2Reparse, e2PbRequest, e2SetStatus, e2Bytes, E2_PB_SEEK } from "./e2_state.um";
import { E2Kit, E2View, e2ViewSync, E2_WS_EDIT } from "./e2_view.um";
import { WmoState } from "./wmo_state.um";

// 印を描く層（部品の地の層 0 より上、ドラッグの影 UK_L_FLOAT より下）。上の層は、ポップアップに覆われていなければ先に押しを取れる。
const WMO_LAYER: i32 = 1;

// ---- 出来事 ----

// 部品のどれかがドラッグの途中か。
function wmoBusy(s: WmoState): bool {
  return s.kf.dragKey != "" || s.graph.dragging || moGizmoBusy(s.giz) || moPointsBusy(s.pts);
}

function wmoJoin(lines: string[], crlf: bool): string {
  let out: u8[] = [];
  for (const l of lines) {
    for (const b of l) {
      out.push(b);
    }
    if (crlf) {
      out.push(13);
    }
    out.push(10);
  }
  return stringFromBytes(out);
}

// ops を ed.lines に当てた写しを ed.project に入れる（ドラッグの途中に見せるだけ。保存も履歴もしない）。
// 当てられない・誤りが出る・クリップの数が変わる（部品の索引がずれる）ときは見せない。
// mark なら M6 の部品のドラッグとして覚える（離したのに操作が来なければ wmoTick が読み直す）。インスペクタの値のドラッグは、
// インスペクタの配線と同じく覚えない（離したときの操作が読み直す）。
function wmoPreview(ed: mut E2, s: mut WmoState, ops: string[], mark: bool): void {
  if (ops.length == 0) {
    return;
  }
  let words: string[][] = [];
  for (const o of ops) {
    words.push(splitArgs(o));
  }
  const res = runOps(ed.lines, ed.probes, words);
  if (!res.ok) {
    return;
  }
  let err: Diag[] = [];
  const p = parseProject(e2Bytes(wmoJoin(res.lines, ed.crlf)), ed.probes, mut err);
  for (const d of err) {
    if (d.severity == "error" && d.code != "missing-source") {
      return;
    }
  }
  if (p.clips.length != ed.project.clips.length) {
    return;
  }
  ed.project = p;
  ed.pbStale = true;
  ed.previewDirty = true;
  if (mark) {
    s.preview = true;
  }
}

// 見せていた写しをやめて、ファイルの中身に戻す。
function wmoEndPreview(ed: mut E2, s: mut WmoState): void {
  if (s.preview) {
    s.preview = false;
    e2Reparse(mut ed);
  }
}

// クリップ ci だけを選ぶ（インスペクタは e2ViewSync が作り直す）。
function wmoSelectClip(v: mut E2View, ci: i32): void {
  if (v.tl.sel.length == 1 && v.tl.sel[0] == ci) {
    return;
  }
  v.tl.sel = [ci];
  tlSyncSel(mut v.tl);
}

// 部品の出来事を当てる。ci は出来事を出したクリップ（-1 なら分からない）。
function wmoHandle(ed: mut E2, v: mut E2View, evs: MoEvent[], ci: i32): void {
  for (const e of evs) {
    if (e.kind == MO_E_OP) {
      const ver0 = ed.ver;
      e2ApplyOps(mut ed, e.ops);
      // 当てられなかった・何も変わらなかったときは e2ApplyOps が読み直さないので、見せていた写しをここで捨てる
      if (ed.ver == ver0) {
        wmoEndPreview(mut ed, mut v.wmo);
      }
      v.wmo.preview = false;
    } else if (e.kind == MO_E_PREVIEW) {
      wmoPreview(mut ed, mut v.wmo, e.ops, true);
    } else if (e.kind == MO_E_CANCEL) {
      wmoEndPreview(mut ed, mut v.wmo);
    } else if (e.kind == MO_E_SEEK) {
      e2PbRequest(mut ed, E2_PB_SEEK, Math.max(e.t, 0.0));
    } else if (e.kind == MO_E_SELECT) {
      if (e.text != "") {
        v.wmo.prop = e.text.clone();
      }
      if (ci >= 0) {
        wmoSelectClip(mut v, ci);
      }
    }
  }
}

// ---- タイムラインのクリップの上のキーフレームの印 ----

function wmoTimelineMarks(ui: mut UkCtx, ed: mut E2, kit: E2Kit, v: mut E2View, g: TlGeo): void {
  // 選んだキーのクリップを、ほかのクリップに選び直したら、キーの選択を外す
  if (v.wmo.kfClip >= 0 && v.wmo.kf.dragKey == "") {
    let still = false;
    for (const i of v.tl.sel) {
      if (i == v.wmo.kfClip) {
        still = true;
      }
    }
    if (!still || (v.wmo.kfClip as usize) >= ed.project.clips.length) {
      v.wmo.kf = moKfStateNew();
      v.wmo.kfClip = -1;
    }
  }
  const fps = moFps(ed.project);
  const pps = v.tl.pps;
  const m = tlPx(g.sc, 2.0);
  let evs: MoEvent[] = [];
  let evClip: i32 = -1;
  ukPushLayer(mut ui, WMO_LAYER);
  for (let it: usize = 0; it < v.tl.items.length; it++) {
    const ci = v.tl.items[it].clip;
    if (v.tl.items[it].audioPart || ci < 0 || (ci as usize) >= ed.project.clips.length) {
      continue;
    }
    if (ed.project.clips[ci as usize].anims.length == 0) {
      continue;
    }
    const row = v.tl.items[it].row as usize;
    const area = ukIntersect(tlRowArea(v.tl, g, row), g.lanes);
    const x0 = tlX(v.tl, g, v.tl.items[it].s);
    const x1 = tlX(v.tl, g, v.tl.items[it].e);
    let y = g.rowY[row] + m;
    let h = g.rowH[row] - m * 2;
    const half = v.tl.items[it].half;
    if (half == 1) {
      h = h / 2;
    } else if (half == 2) {
      y = y + h / 2;
      h = h - h / 2;
    }
    const cr = ukRect(x0, y, Math.max(x1 - x0, 2), h);
    if (ukEmpty(ukIntersect(cr, area))) {
      continue;
    }
    ukPushClip(mut ui, area);
    let ke: MoEvent[] = [];
    if (v.wmo.kfClip == ci) {
      ke = moKfOnClip(mut ui, kit.wmo.th, ed.project.clips[ci as usize], cr, pps, fps, mut v.wmo.kf);
    } else {
      let tmp = moKfStateNew();
      ke = moKfOnClip(mut ui, kit.wmo.th, ed.project.clips[ci as usize], cr, pps, fps, mut tmp);
      // このクリップのキーを押した・選んだ: 状態をこのクリップのものにする
      if (tmp.dragKey != "" || tmp.selKey != "") {
        v.wmo.kf = tmp;
        v.wmo.kfClip = ci;
      }
    }
    ukPopClip(mut ui);
    for (const e of ke) {
      evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
      evClip = ci;
    }
  }
  ukPopLayer(mut ui);
  wmoHandle(mut ed, mut v, evs, evClip);
}

// ---- モニターの上の変形のギズモと点の編集 ----

// 選んだクリップ（1 つだけのとき）が、再生ヘッドの所で見えていれば、点の編集 → ギズモの順に描く（点は枠の中にあるので先に取る）。
// 何もない所・ほかのクリップを押したら、その点にあるクリップを選ぶ（押しはモニターにも渡す。ずらす・フォーカスを外す）。
function wmoMonitorMarks(ui: mut UkCtx, ed: mut E2, kit: E2Kit, v: mut E2View): void {
  if (v.mon.tab != MON_PROGRAM || v.mon.twoUp || ed.project.width <= 0) {
    return;
  }
  const pr = v.mon.picR;
  const vr = v.mon.viewR;
  if (pr.w <= 0 || pr.h <= 0 || vr.w <= 0 || vr.h <= 0) {
    return;
  }
  const view: MoView = { ox: pr.x as f64, oy: pr.y as f64, s: (pr.w as f64) / (ed.project.width as f64) };
  const fps = moFps(ed.project);
  const t = moSnap(ed.t, fps);
  let evs: MoEvent[] = [];
  let sel: i32 = -1;
  if (v.tl.sel.length == 1) {
    sel = v.tl.sel[0];
  }
  ukPushLayer(mut ui, WMO_LAYER);
  ukPushClip(mut ui, vr);
  if (sel >= 0 && (sel as usize) < ed.project.clips.length && moIsVisual(ed.project.clips[sel as usize].kind)) {
    const ci = sel as usize;
    const lt = t - ed.project.clips[ci].at;
    if (lt >= 0.0 && lt <= ed.project.clips[ci].dur) {
      const pe = moPoints(mut ui, kit.wmo.th, ed.project, ed.lines, ci, lt, view, mut v.wmo.pts);
      for (const e of pe) {
        evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
      }
      const ge = moGizmo(mut ui, kit.wmo.th, ed.project, ci, lt, view, vr, mut v.wmo.giz);
      for (const e of ge) {
        evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
      }
    }
  }
  // 点とギズモが取らなかった押し: その点のクリップを選ぶ
  if ((ui.inp.pressed & 1) != 0 && ui.active == 0 && ukMouseIn(ui, pr) && !moGizmoBusy(v.wmo.giz) && !moPointsBusy(v.wmo.pts)) {
    const cx = ((ui.inp.mx as f64) - view.ox) / view.s;
    const cy = ((ui.inp.my as f64) - view.oy) / view.s;
    const hit = moClipAtPoint(ed.project, t, cx, cy);
    if (hit >= 0) {
      wmoSelectClip(mut v, hit);
    }
  }
  ukPopClip(mut ui);
  ukPopLayer(mut ui);
  wmoHandle(mut ed, mut v, evs, sel);
}

// ---- インスペクタの ◇ ◀ ◆ ▶ ----
// インスペクタの部品（ui_inspector）は、行の右に ◇ と ◀ ◆ ▶ を自分で描き、押すと INS_E_KF_* を返す（行の四角は外に出さない）。
// そこで moKeyNav を重ねて描く代わりに、その出来事を moKeyNav と同じ操作にする。行の印（◇ か ◀ ◆ ▶ か、再生ヘッドにキーがあるか）は
// wmoInspectorPrep が毎フレーム描く前に insSetKf で入れる。

// インスペクタの行のキー → .mzc のキー。「位置」の行（key は x）は x と y の 2 つ（shape の pos= か pos のキーフレームなら pos）。
function wmoRowKeys(c: Clip, rowKey: string): string[] {
  if (rowKey == "x") {
    if (moAnimIndex(c, "pos") >= 0 || (c.kind == KIND_SHAPE && c.shape.posSet)) {
      return ["pos"];
    }
    return ["x", "y"];
  }
  return [rowKey.clone()];
}

// key add に渡す今の値。x / y を書いていない行（真ん中に置いたクリップなど）は、置いた箱の左上の画素（ギズモと同じ）。
function wmoKeyValue(p: Project, ci: usize, line: string, key: string, lt: f64): string {
  if ((key == "x" || key == "y") && moAnimIndex(p.clips[ci], key) < 0 && !hasKey(line, key)) {
    const xf = moClipXf(p, ci, lt);
    if (xf.ok && !xf.usePos) {
      if (key == "x") {
        return moNum(xf.left, 0);
      }
      return moNum(xf.top, 0);
    }
  }
  return moValueText(p.clips[ci], line, key, lt);
}

// インスペクタが 1 つのクリップを出しているなら、その番号（でなければ -1）。
function wmoInsClip(ed: E2, kit: E2Kit): i32 {
  if (kit.insModel.mode != INS_M_CLIP || kit.insModel.refs.length != 1) {
    return -1;
  }
  return findClip(ed.project, kit.insModel.refs[0]);
}

// wireInspectorPrep（インスペクタを描く前）が呼ぶ: キーフレームの行の印を、いまのクリップと再生ヘッドに合わせる。
export function wmoInspectorPrep(ed: E2, kit: mut E2Kit): void {
  const ci = wmoInsClip(ed, kit);
  if (ci < 0) {
    return;
  }
  const c = ci as usize;
  const fps = moFps(ed.project);
  const lt = moSnap(ed.t, fps) - ed.project.clips[c].at;
  const rows: string[] = ["x", "opacity", "volume"];
  for (const rk of rows) {
    let on = false;
    let at = false;
    for (const k of wmoRowKeys(ed.project.clips[c], rk)) {
      if (moAnimIndex(ed.project.clips[c], k) >= 0) {
        on = true;
        if (moKeyAt(ed.project.clips[c], k, lt, fps) >= 0) {
          at = true;
        }
      }
    }
    let st = INS_KF_OFF;
    if (on) {
      st = INS_KF_ON;
    }
    insSetKf(mut kit.insModel, rk, st, at);
  }
  // 幅・文字の大きさは .mzc でキーフレームにできない（ops の key add が断る）ので ◇ を出さない
  insSetKf(mut kit.insModel, "w", INS_KF_NONE, false);
  insSetKf(mut kit.insModel, "size", INS_KF_NONE, false);
}

// ◇ ◆ ◀ ▶ の 1 つの出来事を、ops か再生ヘッドの移動にする（moKeyNav と同じ）。
function wmoInsKf(ed: mut E2, kind: i32, rowKey: string, ci: usize, alt: bool): void {
  const fps = moFps(ed.project);
  const lt = moSnap(ed.t, fps) - ed.project.clips[ci].at;
  const keys = wmoRowKeys(ed.project.clips[ci], rowKey);
  const ref = moRef(ed.project.clips[ci]);
  if (kind == INS_E_KF_PREV || kind == INS_E_KF_NEXT) {
    let dir = 1;
    if (kind == INS_E_KF_PREV) {
      dir = -1;
    }
    let best = 0.0 / 0.0;
    for (const k of keys) {
      const t = moNeighborKey(ed.project.clips[ci], k, lt, fps, dir);
      if (t == t && (best != best || (dir < 0 && t > best) || (dir > 0 && t < best))) {
        best = t;
      }
    }
    if (best == best) {
      e2PbRequest(mut ed, E2_PB_SEEK, ed.project.clips[ci].at + best);
    }
    return;
  }
  if (lt < 0.0 || lt > ed.project.clips[ci].dur) {
    e2SetStatus(mut ed, "再生ヘッドがクリップの外にあるので、キーを打てません", false);
    return;
  }
  const line = ed.lines[(ed.project.clips[ci].line - 1) as usize].clone();
  let ops: string[] = [];
  let anyAt = false;
  for (const k of keys) {
    if (moKeyAt(ed.project.clips[ci], k, lt, fps) >= 0) {
      anyAt = true;
    }
  }
  for (const k of keys) {
    const ai = moAnimIndex(ed.project.clips[ci], k);
    if (ai >= 0 && alt) {
      // キーフレームをやめる（今の値をふつうの値で残す）
      ops.push(`key clear ${ref} ${k} ${moNum(lt, 4)}`);
    } else if (anyAt) {
      const kAt = moKeyAt(ed.project.clips[ci], k, lt, fps);
      if (kAt >= 0) {
        if (ed.project.clips[ci].anims[ai as usize].track.keys.length <= 1) {
          ops.push(`key clear ${ref} ${k}`);
        } else {
          ops.push(`key remove ${ref} ${k} #${kAt}`);
        }
      }
    } else {
      ops.push(`key add ${ref} ${k} ${moNum(lt, 4)} ${wmoKeyValue(ed.project, ci, line, k, lt)}`);
    }
  }
  if (ops.length > 0) {
    e2ApplyOps(mut ed, ops);
  }
}

// 空白・引用符・# を含む値は引用符で囲む（splitArgs で分けた語を op の文に戻す）。
function wmoQuoteArg(s: string): string {
  let need = false;
  for (const b of s) {
    if (b == 32 || b == 34 || b == 35) {
      need = true;
    }
  }
  if (!need) {
    return s.clone();
  }
  let out: u8[] = [34];
  for (const c of s) {
    if (c == 34 || c == 92) {
      out.push(92);
    }
    out.push(c);
  }
  out.push(34);
  return stringFromBytes(out);
}

// インスペクタの set の op のうち、キーフレームのあるキーの値を、再生ヘッドの時刻の key add にする（moOpValue）。
// 書き換えたものがなければ false（そのまま set でよい）。書き換えたら、残りのキーの set と key add を out に入れる。
function wmoInsSetToKeys(ed: E2, op: string, out: mut string[]): bool {
  const w = splitArgs(op);
  if (w.length < 3 || w[0] != "set") {
    return false;
  }
  const ci = findClip(ed.project, w[1]);
  if (ci < 0) {
    return false;
  }
  const c = ci as usize;
  const fps = moFps(ed.project);
  const lt = moSnap(ed.t, fps) - ed.project.clips[c].at;
  let keyOps: string[] = [];
  let rest: string[] = [];
  for (let i: usize = 2; i < w.length; i++) {
    let kb: u8[] = [];
    let vb: u8[] = [];
    let eq = false;
    for (const b of w[i]) {
      if (!eq && b == 61) {
        eq = true;
      } else if (eq) {
        vb.push(b);
      } else {
        kb.push(b);
      }
    }
    const k = stringFromBytes(kb);
    if (eq && kb.length > 0 && moAnimIndex(ed.project.clips[c], k) >= 0) {
      keyOps.push(moOpValue(ed.project.clips[c], k, lt, wmoQuoteArg(stringFromBytes(vb))));
    } else if (eq) {
      rest.push(`${k}=${wmoQuoteArg(stringFromBytes(vb))}`);
    } else {
      rest.push(wmoQuoteArg(w[i]));
    }
  }
  if (keyOps.length == 0) {
    return false;
  }
  if (rest.length > 0) {
    let s = `set ${w[1]}`;
    for (const r of rest) {
      s = `${s} ${r}`;
    }
    out.push(s);
  }
  for (const k of keyOps) {
    out.push(k.clone());
  }
  return true;
}

// ---- 口 ----

// e2Frame の初め（ワークスペースの Tick のあと、wireTimelineKeys の前）に毎フレーム呼ぶ。tl はタイムライン、mon はモニターの四角。
// モニターの絵の場所は前のフレームの v.mon.picR（monPanel が決める）。カット編集のワークスペースのときだけ描く。
export function wmoTick(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, tl: UkRect, mon: UkRect): void {
  const ver0 = ed.ver;
  if (v.workspace == E2_WS_EDIT && mon.w > 0 && mon.h > 0) {
    wmoMonitorMarks(mut ui, mut ed, kit, mut v);
  }
  if (tl.h > 0 && tl.w > 0) {
    const g = tlGeo(mut v.tl, tl, ui.theme.scale);
    wmoTimelineMarks(mut ui, mut ed, kit, mut v, g);
  }
  // 離したのに操作もやめるも来なかった（同じ値で離した）ときは、見せていた写しを捨てる
  if (v.wmo.preview && !wmoBusy(v.wmo)) {
    wmoEndPreview(mut ed, mut v.wmo);
  }
  // ファイルを書き換えたら、このフレームの部品を描く前に中身を作り直す
  if (ed.ver != ver0) {
    e2ViewSync(ed, mut kit, mut v);
  }
}

// タイムライン（tlTimeline を描いた直後。r はタイムラインの四角）。印は wmoTick が描くので、いまは何もしない。
export function wmoTimeline(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, r: UkRect): void {
}

// インスペクタ（insDraw を描いた直後。evs はインスペクタの出来事）。ここで扱った出来事に true を返し、wireInspector はそれを飛ばす:
// - INS_E_KF_*（◇ ◆ ◀ ▶）: moKeyNav と同じ操作（key add / remove / clear、Alt+◆ で key clear <今の時刻>、前後のキーへ）
// - INS_E_SET / INS_E_PREVIEW のうち、キーフレームのあるキーの値を変えるもの: set ではなく再生ヘッドの時刻の key add
//   （set で書くと、キーフレームの列が 1 つの値に置き換わってしまう）
export function wmoInspector(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, evs: InsEvent[]): bool[] {
  let taken: bool[] = [];
  const ci = wmoInsClip(ed, kit);
  const alt = (ui.inp.mods & UK_MOD_ALT) != 0;
  for (const e of evs) {
    let take = false;
    if (e.kind == INS_E_KF_TOGGLE || e.kind == INS_E_KF_HERE || e.kind == INS_E_KF_PREV || e.kind == INS_E_KF_NEXT) {
      take = true;
      if (ci >= 0) {
        wmoInsKf(mut ed, e.kind, e.key, ci as usize, alt);
      }
    } else if (e.kind == INS_E_SET || e.kind == INS_E_PREVIEW) {
      let ops: string[] = [];
      for (const o of e.ops) {
        if (wmoInsSetToKeys(ed, o, mut ops)) {
          take = true;
        } else {
          ops.push(o.clone());
        }
      }
      if (take) {
        if (e.kind == INS_E_SET) {
          e2ApplyOps(mut ed, ops);
        } else {
          wmoPreview(mut ed, mut v.wmo, ops, false);
        }
      }
    }
    taken.push(take);
  }
  return taken;
}

// モニター（monPanel と monKeys の直後。acts はモニターの出来事）: 変形のギズモ（moGizmo）と点の編集（moPoints）。
// 絵の場所は v.mon.picR（全画面のときも同じく呼ばれる）。
export function wmoMonitor(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, acts: MonAct[]): void {
}
