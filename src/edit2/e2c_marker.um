// コマンド（マーカーと印）: marker.*・mark.*（イン点・アウト点）・playhead.nextMarker / prevMarker / toIn / toOut。
// 表（e2_cmds.um の e2CmdTable）に並べたコマンドのうち、このファイルが受け持つものの中身。
//
// - e2cMarkerReady(id): つないだ（実行できる）コマンドなら true。true のものだけがメニュー・右クリック・コマンドの欄に出る。
// - e2cMarkerRun(...): 実行したら true。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は e2cMarker で始める。
import { UkCtx } from "../uikit/core.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";

export function e2cMarkerReady(id: string): bool {
  return false;
}

export function e2cMarkerRun(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, id: string): bool {
  // marker.add・marker.delete・marker.clearAll・playhead.nextMarker・playhead.prevMarker・
  // mark.in・mark.out・mark.clip・mark.clear*・playhead.toIn・playhead.toOut はまだ空
  return false;
}
