// ファイルのダイアログ（e2_dialog.um）の状態: 親の窓、出しているダイアログの要求の番号と頼んだもの、届いた結果、
// 試し用の --dialog-result の結果の列。E2View.dlg に入れる（e2_dialog.um だけが書き換える）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wdl / Wdl で始める。
export struct WdlState {
  // 親にする窓（edit2.um の main が入れる。0 なら親なし）
  win: i32;
  // 出しているダイアログの要求の番号（windowOpenFileDialog などが返したもの）。-1 は出していない、-2 は試しの結果を待たせている
  req: i32;
  // 頼んだもの（呼んだ側が決める名前。"file.open"、"media.import" など）。結果はこの名前で受け取る
  purpose: string;
  // 届いた結果（done なら purpose あての結果がある。paths が空なら取り消し、failed ならダイアログを出せなかった）
  done: bool;
  paths: string[];
  failed: bool;
  // 試し用の --dialog-result の結果（頼まれた順に 1 つずつ使う。"" は取り消し。パスは ; で区切ると複数）
  fake: string[];
  fakeOn: bool;
}

export function wdlStateNew(): WdlState {
  return { win: 0, req: -1, purpose: "", done: false, paths: [], failed: false, fake: [], fakeOn: false };
}
