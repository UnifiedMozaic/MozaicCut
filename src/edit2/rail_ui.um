// レールの左の欄（rail_fx / rail_text / rail_audio / rail_problems / rail_settings.um）で共通に使う小さな部品:
// 探す欄・分類の札・節の見出し・一覧の行・ボタン・折り返す文・運び始め（ドラッグ）と、クリップを選ぶ・指す名前。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は railUi で始める。
import {
  UkCtx, UkHit, ukId, ukIdInt, ukBehavior, ukDrawRect, ukDrawRound, ukDrawStroke, ukDrawTextIn, ukDrawTextInS, ukTextW,
  ukTextWS, ukFitTextS, UK_FONT_SEMIBOLD, UK_FONT_MONO,
} from "../uikit/core.um";
import { UkRect, ukRect, ukSub, ukNextChar } from "../uikit/base.um";
import { ukSetNext } from "../uikit/layout.um";
import { ukTextField, ukButton, ukButtonPrimary } from "../uikit/widgets.um";
import { ThTheme, thPx, TH_TS_XS, TH_TS_SM, TH_TS_MD } from "../gen/theme.um";
import { Clip } from "../project.um";
import { tlSyncSel } from "../ui_timeline/tl_model.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";

export function railUiTs(th: ThTheme, i: i32): f32 {
  return th.ts[i as usize];
}

// 欄の中身の左右の余白
export function railUiPad(kit: E2Kit): i32 {
  return kit.th.space[3];
}

// op でクリップを指す名前（id があれば id、なければ @行番号）。
export function railUiRef(c: Clip): string {
  if (c.id != "") {
    return c.id.clone();
  }
  return `@${c.line}`;
}

// op の値を引用符で囲む（" と \ は \ を前に付ける）。空白も引用符もなければそのまま。
export function railUiQuote(s: string): string {
  let plain = s.length > 0;
  for (const b of s) {
    if (b == 32 || b == 34 || b == 92 || b == 9) {
      plain = false;
    }
  }
  if (plain) {
    return s.clone();
  }
  let out: u8[] = [34];
  for (const b of s) {
    if (b == 34 || b == 92) {
      out.push(92);
    }
    out.push(b);
  }
  out.push(34);
  return stringFromBytes(out);
}

// 英字の大文字を小文字にする（日本語はそのまま）。
function railUiLower(s: string): string {
  let out: u8[] = [];
  for (const b of s) {
    out.push(b >= 65 && b <= 90 ? b + 32 : b);
  }
  return stringFromBytes(out);
}

// 探す語 q が s に含まれるか（英字の大文字・小文字は区別しない。q が空なら true）。
export function railUiMatch(q: string, s: string): bool {
  if (q.length == 0) {
    return true;
  }
  const a = railUiLower(s);
  const b = railUiLower(q);
  if (b.length > a.length) {
    return false;
  }
  for (let i: usize = 0; i + b.length <= a.length; i++) {
    let ok = true;
    for (let j: usize = 0; j < b.length; j++) {
      if (a[i + j] != b[j]) {
        ok = false;
        break;
      }
    }
    if (ok) {
      return true;
    }
  }
  return false;
}

// 選んでいるクリップ（ed.project.clips の番号。範囲の外は除く）。
export function railUiSel(ed: E2, v: E2View): i32[] {
  let out: i32[] = [];
  for (const s of v.tl.sel) {
    if (s >= 0 && (s as usize) < ed.project.clips.length) {
      out.push(s);
    }
  }
  return out;
}

// クリップを 1 つだけ選ぶ（インスペクタもそのクリップになる）。
export function railUiSelect(v: mut E2View, ci: i32): void {
  v.tl.sel = [ci];
  tlSyncSel(mut v.tl);
}

// 探す欄（空のときに hint を薄く出す）。id はほかの欄と重ならない名前。
export function railUiSearch(ui: mut UkCtx, r: UkRect, hint: string, id: string, text: string): string {
  ukSetNext(mut ui, r);
  return ukTextField(mut ui, `${hint}##${id}`, text);
}

// 分類の札の幅。
export function railUiChipW(ui: mut UkCtx, kit: E2Kit, label: string): i32 {
  return ukTextW(mut ui, label, railUiTs(kit.th, TH_TS_XS)) + thPx(kit.th, 16);
}

// 分類の札（押されたら true）。幅は文字に合わせ、使った幅を w[0] に返す。
export function railUiChip(ui: mut UkCtx, kit: E2Kit, x: i32, y: i32, label: string, on: bool, id: u32, w: mut i32[]): bool {
  const th = kit.th;
  const fs = railUiTs(th, TH_TS_XS);
  const cw = ukTextW(mut ui, label, fs) + thPx(th, 16);
  const r = ukRect(x, y, cw, thPx(th, 22));
  w[0] = cw;
  const h = ukBehavior(mut ui, id, r, true);
  if (on) {
    ukDrawRound(mut ui, r, r.h / 2, th.c.accentTint);
    ukDrawStroke(mut ui, r, r.h / 2, th.borderHairline, th.c.accent);
  } else {
    ukDrawRound(mut ui, r, r.h / 2, h.hover ? th.c.bg3 : th.c.bg2);
  }
  ukDrawTextIn(mut ui, r, label, fs, on ? th.c.text1 : th.c.text2, 1);
  return h.clicked;
}

// 節の見出し（小さな文字）。高さを返す。
export function railUiSection(ui: mut UkCtx, kit: E2Kit, r: UkRect, title: string): i32 {
  const th = kit.th;
  const h = thPx(th, 24);
  ukDrawTextInS(mut ui, ukRect(r.x, r.y, r.w, h), title, railUiTs(th, TH_TS_XS), th.c.text3, 0, UK_FONT_SEMIBOLD);
  return h;
}

// 一覧の行の地（選んだ行は選択の色、触れている行は少し明るく）と、ふるまい。
export function railUiRow(ui: mut UkCtx, kit: E2Kit, r: UkRect, id: u32, sel: bool): UkHit {
  const th = kit.th;
  const h = ukBehavior(mut ui, id, r, true);
  if (sel) {
    ukDrawRound(mut ui, r, th.radiusSm, th.c.selectionList);
  } else if (h.hover) {
    ukDrawRound(mut ui, r, th.radiusSm, th.c.bg2);
  }
  return h;
}

// 押したまま少し動かしたら、運び始める（kind は wrl_state.um の WRL_DRAG_*、label はマウスの横に出す札）。
export function railUiDrag(ui: mut UkCtx, kit: E2Kit, h: UkHit, kind: i32, data: i32, label: string): void {
  if (!h.held || ui.dragKind != 0) {
    return;
  }
  const dx = ui.inp.mx - ui.activeX;
  const dy = ui.inp.my - ui.activeY;
  const t = thPx(kit.th, 6);
  if (dx * dx + dy * dy > t * t) {
    ui.dragKind = kind;
    ui.dragData = data;
    ui.dragLabel = label.clone();
  }
}

// ボタン（四角を直に決める）。押されたら true。
export function railUiButton(ui: mut UkCtx, r: UkRect, label: string, primary: bool): bool {
  ukSetNext(mut ui, r);
  if (primary) {
    return ukButtonPrimary(mut ui, label);
  }
  return ukButton(mut ui, label);
}

// ボタンの自然な幅（文字と左右の余白）。
export function railUiButtonW(ui: mut UkCtx, label: string): i32 {
  return ukTextW(mut ui, label, ui.theme.fontSize) + ui.theme.pad * 2 + 2;
}

// 文を幅 maxW で折り返した行（改行の \n でも区切る）。
export function railUiWrap(ui: mut UkCtx, s: string, size: f32, maxW: i32): string[] {
  let out: string[] = [];
  let start: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    if (s[i] == 10) {
      out.push(ukSub(s, start, i));
      i++;
      start = i;
      continue;
    }
    const nx = ukNextChar(s, i);
    const w = ukTextW(mut ui, ukSub(s, start, nx), size);
    if (w > maxW && i > start) {
      out.push(ukSub(s, start, i));
      start = i;
    }
    i = nx;
  }
  if (start < s.length || out.length == 0) {
    out.push(ukSub(s, start, s.length));
  }
  return out;
}

// 折り返した文を描く。使った高さを返す。
export function railUiPara(ui: mut UkCtx, x: i32, y: i32, w: i32, s: string, size: f32, color: u32, lineH: i32): i32 {
  const lines = railUiWrap(mut ui, s, size, w);
  let yy = y;
  for (const l of lines) {
    ukDrawTextIn(mut ui, ukRect(x, yy, w, lineH), l, size, color, 0);
    yy = yy + lineH;
  }
  return yy - y;
}

// 折り返した文の高さ（描かない）。
export function railUiParaH(ui: mut UkCtx, w: i32, s: string, size: f32, lineH: i32): i32 {
  return (railUiWrap(mut ui, s, size, w).length as i32) * lineH;
}

// 等幅の小さな札（キーの割り当てなど）。幅を返す。右端を xr に揃える。
export function railUiKeyCap(ui: mut UkCtx, kit: E2Kit, xr: i32, y: i32, h: i32, s: string): i32 {
  const th = kit.th;
  const fs = railUiTs(th, TH_TS_XS);
  const w = ukTextWS(mut ui, s, fs, UK_FONT_MONO) + thPx(th, 10);
  const r = ukRect(xr - w, y, w, h);
  ukDrawStroke(mut ui, r, th.radiusSm, th.borderHairline, th.c.lineControl);
  ukDrawTextInS(mut ui, r, s, fs, th.c.text2, 1, UK_FONT_MONO);
  return w;
}

// 1 行の文を幅に収めて描く（はみ出す分は … にする）。
export function railUiText(ui: mut UkCtx, r: UkRect, s: string, size: f32, color: u32, style: i32): void {
  const t = ukFitTextS(mut ui, s, size, r.w, style);
  ukDrawTextInS(mut ui, r, t, size, color, 0, style);
}

// 文字の大きさの番号（TH_TS_SM・TH_TS_MD）の別名（ほかのファイルが gen/theme.um を読まずに済むように）。
export function railUiSm(kit: E2Kit): f32 {
  return railUiTs(kit.th, TH_TS_SM);
}

export function railUiXs(kit: E2Kit): f32 {
  return railUiTs(kit.th, TH_TS_XS);
}

export function railUiMd(kit: E2Kit): f32 {
  return railUiTs(kit.th, TH_TS_MD);
}

// 選んでいるものの番号から、一覧の id を作る。
export function railUiId(ui: UkCtx, s: string, n: i32): u32 {
  return ukIdInt(ui, s, n);
}

export function railUiIdS(ui: UkCtx, s: string): u32 {
  return ukId(ui, s);
}
