// 配線（モニター）の状態: 全画面・スクラブの前の速さ・再生中の描画の時間とコマ落ちの統計。
// E2View.wm に入れる（wire_monitor.um だけが書き換える）。E2View から読むので、このファイルは e2_* を読まない。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wm / Wm で始める。
export struct WmState {
  // 全画面（モニターだけを窓いっぱいに出し、窓も全画面にする）。F11 で切り替え、Esc で戻る
  full: bool;
  // スクラブを始めたときの速さ（再生中だったら、放したあと同じ速さで再生し直す。止まっていたら 0）
  resume: f64;
  // 再生中の 1 コマの描画（renderFrameFrom と縮小）の時間（秒）: 直前・合計・最大・数
  rLast: f64;
  rSum: f64;
  rMax: f64;
  rN: i64;
  // 再生中の 1 フレーム全体（入力から画面に出して先読みと合流するまで）の時間（秒）
  fSum: f64;
  fMax: f64;
  fN: i64;
  // 再生のエンジンの統計を写したもの（見せたコマ・飛ばしたコマ・うちコマ落ち）
  shown: i64;
  skipped: i64;
  dropped: i64;
}

export function wmStateNew(): WmState {
  return {
    full: false, resume: 0.0, rLast: 0.0, rSum: 0.0, rMax: 0.0, rN: 0, fSum: 0.0, fMax: 0.0, fN: 0, shown: 0, skipped: 0,
    dropped: 0,
  };
}
