// シーケンスの設定の小窓（e2_seqdlg.um）の状態。E2View.sq に入れる（e2_seqdlg.um だけが書き換える）。
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wsq / Wsq / WSQ で始める。

// 打つ欄（focus の値）
export const WSQ_F_W: i32 = 0;
export const WSQ_F_H: i32 = 1;
export const WSQ_F_FPS: i32 = 2;

export struct WsqState {
  open: bool;
  // 欄の文字（幅・高さ・フレームレート）。開いたときは今の project の値
  w: string;
  h: string;
  fps: string;
  // 文字を打つ欄（WSQ_F_*）
  focus: i32;
}

export function wsqStateNew(): WsqState {
  return { open: false, w: "", h: "", fps: "", focus: WSQ_F_W };
}
