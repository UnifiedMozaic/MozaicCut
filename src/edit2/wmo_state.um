// M6 の操作の画面のつなぎ口（wire_motion.um）の状態。E2View.wmo と E2Kit.wmo に入れる（wire_motion.um だけが書き換える。Kit は読むだけ）。
// E2View / E2Kit から読むので、このファイルは e2_* を読まない。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wmo / Wmo で始める。
import { MoTheme, moThemeFromTokens } from "../ws_motion/mo_core.um";
import { MoKfState, moKfStateNew } from "../ws_motion/mo_kflane.um";
import { MoGraphState, moGraphStateNew } from "../ws_motion/mo_graph.um";
import { MoGizmoState, moGizmoStateNew } from "../ws_motion/mo_gizmo.um";
import { MoPointsState, moPointsStateNew } from "../ws_motion/mo_points.um";

// 部品と配線が書き換える状態（選んでいるもの・ドラッグの途中・開いている欄など）。
export struct WmoState {
  // タイムラインのクリップの上のキーフレームの印。選んだキー・ドラッグ中のキーは 1 つのクリップにだけあるので、
  // そのクリップの番号（kfClip。-1 ならどれでもない）にだけこの状態を渡し、ほかのクリップには毎フレーム空の状態を渡す
  kf: MoKfState;
  kfClip: i32;
  // グラフエディタ（タイムラインの上に開く札）
  graph: MoGraphState;
  graphOpen: bool;
  // グラフに出すキー（"" なら、キーフレームのある最初のキー）
  prop: string;
  // モニターの上の変形のギズモと点の編集
  giz: MoGizmoState;
  pts: MoPointsState;
  // ドラッグの途中で、ed.project を ops を当てた写しに替えている（MO_E_PREVIEW）
  preview: bool;
}

// 読むだけのもの（tokens.json から作るテーマなど）。e2KitNew が 1 回だけ作る。
export struct WmoKit {
  // tokens.json を読めたか
  tokensOk: bool;
  scale: f32;
  // M6 の部品の色と大きさ（docs/design/motion.md の「見た目」）
  th: MoTheme;
}

export function wmoStateNew(): WmoState {
  return {
    kf: moKfStateNew(), kfClip: -1, graph: moGraphStateNew(), graphOpen: false, prop: "", giz: moGizmoStateNew(),
    pts: moPointsStateNew(), preview: false,
  };
}

// js は tokens.json の本文（読めなければ ""）、scale は画面の倍率。
export function wmoKitNew(js: string, scale: f32): WmoKit {
  return { tokensOk: js.length > 0, scale, th: moThemeFromTokens(js, scale) };
}
