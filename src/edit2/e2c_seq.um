// コマンド（シーケンス）: seq.*（トラックを足す・消す、シーケンスの設定の小窓を開く）。
// 表（e2_cmds.um の e2CmdTable）に並べたコマンドのうち、このファイルが受け持つものの中身。
//
// - e2cSeqReady(id): つないだ（実行できる）コマンドなら true。true のものだけがメニュー・右クリック・コマンドの欄に出る。
// - e2cSeqRun(...): 実行したら true。
//
// トラックは .mzc の track= から決まる（クリップのないトラックは書く所がない）。足したトラックは空のまま画面にだけあり
// （v.mn.minV / minA）、クリップを置くとそのトラックの track= が書かれる。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は e2cSeq で始める。
import { UkCtx } from "../uikit/core.um";
import { MAX_TRACKS } from "../project.um";
import { E2, e2SetStatus } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";
import { wsqOpen } from "./e2_seqdlg.um";
import { wmnTrackCount } from "./wmn_state.um";

export function e2cSeqReady(id: string): bool {
  return id == "seq.settings" || id == "seq.addVideoTrack" || id == "seq.addAudioTrack" || id == "seq.deleteTrack";
}

export function e2cSeqRun(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, id: string): bool {
  if (id == "seq.addVideoTrack" || id == "seq.addAudioTrack") {
    const audio = id == "seq.addAudioTrack";
    const n = wmnTrackCount(v.tl, audio);
    if (n >= MAX_TRACKS) {
      e2SetStatus(mut ed, `トラックは ${MAX_TRACKS} 本までです`, false);
      return true;
    }
    if (audio) {
      v.mn.minA = n + 1;
    } else {
      v.mn.minV = n + 1;
    }
    // トラックの並びを作り直す（e2ViewSync は版が変わったときだけ作るので、印を外す）
    kit.syncVer = -1;
    let name = `V${n + 1}`;
    if (audio) {
      name = `A${n + 1}`;
    }
    e2SetStatus(mut ed, `${name} を足しました（空のトラックは .mzc には書きません。クリップを置くとそのトラックに入ります）`, false);
  } else if (id == "seq.deleteTrack") {
    if (v.mn.minV == 0 && v.mn.minA == 0) {
      e2SetStatus(mut ed, "消せる空のトラックがありません（クリップのあるトラックは、クリップを消すと消えます）", false);
    } else {
      v.mn.minV = 0;
      v.mn.minA = 0;
      kit.syncVer = -1;
      e2SetStatus(mut ed, "足した空のトラックを消しました", false);
    }
  } else if (id == "seq.settings") {
    // 解像度とフレームレートを選ぶ小窓（e2_seqdlg.um）
    wsqOpen(ed, mut v);
  } else {
    return false;
  }
  return true;
}
