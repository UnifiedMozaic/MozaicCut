// 素材の欄の縮小画像を、素材の本物の最初のコマにする。
// 映像と画像の素材を 1 つずつ（1 フレームに 1 つまで）小さな大きさ（WPT_W × WPT_H）で描いて覚え、
// 覚えた素材は縮小画像の種類を POOL_TH_PIC にする。欄（pool_panel.um）はその四角に画像の命令を出して場所を
// PoolState の picIds / picRs に残すので、wptPaint がそこへ絵の画素を写す（画面と同じ大きさの 1 枚の画像 MonCanvas）。
// 音の素材は、これまでどおり波形の絵柄（POOL_TH_WAVE）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wpt / Wpt で始める。
import { UkRect } from "../uikit/base.um";
import { Diag, parseProject } from "../project.um";
import { loadMediaFor, releaseMedia, renderFrame, newRenderCache } from "../render.um";
import { MEDIA_OPEN_FAST } from "../media.um";
import { MonCanvas } from "../ui_monitor/monitor.um";
import { POOL_K_VIDEO, POOL_K_IMAGE } from "../ui_pool/pool_tokens.um";
import { POOL_TH_PIC } from "../ui_pool/pool_draw.um";
import { E2, e2Bytes, e2ProbesWithImported } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";
import { WptState } from "./wpt_state.um";

// 縮小画像の大きさ（16:9。欄の縮小画像の四角より少し大きく作り、写すときに縮める）
const WPT_W: i32 = 192;
const WPT_H: i32 = 108;

function wptFind(st: WptState, id: string): i32 {
  for (let k: usize = 0; k < st.pics.length; k++) {
    if (st.pics[k].id == id) {
      return k as i32;
    }
  }
  return -1;
}

function wptTried(st: WptState, id: string): bool {
  for (const t of st.tried) {
    if (t == id) {
      return true;
    }
  }
  return false;
}

function wptQuote(s: string): string {
  let out: u8[] = [34];
  for (const b of s) {
    if (b == 34 || b == 92) {
      out.push(92);
    }
    out.push(b);
  }
  out.push(34);
  return stringFromBytes(out);
}

function wptChan(x: f32): u32 {
  return (Math.min(Math.max(x * 255.0 + 0.5, 0.0), 255.0) as i32) as u32;
}

// 素材 path の最初のコマを描いて覚える。描けなければ false。
function wptMake(ed: E2, st: mut WptState, id: string, path: string, kind: i32): bool {
  let clip = `video ${wptQuote(path)} at=0 in=0 dur=1`;
  if (kind == POOL_K_IMAGE) {
    clip = `image ${wptQuote(path)} at=0 dur=1`;
  }
  const text = `project size=${WPT_W}x${WPT_H} fps=30 bg=000000\n${clip}\n`;
  let err: Diag[] = [];
  const p = parseProject(e2Bytes(text), e2ProbesWithImported(ed), mut err);
  if (p.clips.length == 0) {
    return false;
  }
  let media = loadMediaFor(p, ed.cache, MEDIA_OPEN_FAST);
  if (media.length == 0 || !media[0].ok) {
    releaseMedia(mut media);
    return false;
  }
  const n = (WPT_W * WPT_H) as u32;
  let cvs = new Buffer<vec4<f32>>(n);
  let rc = newRenderCache();
  renderFrame(p, media, ed.cache, 0.5 / 30.0, mut cvs, ed.pfont, mut rc);
  releaseMedia(mut media);
  let img = new Buffer<u32>(n);
  for (let i: u32 = 0; i < n; i++) {
    const c = cvs[i];
    img[i] = 0xff000000 | (wptChan(c.x) << 16) | (wptChan(c.y) << 8) | wptChan(c.z);
  }
  st.pics.push({ id: id.clone(), w: WPT_W, h: WPT_H, img });
  return true;
}

// 素材の欄を描く前に毎フレーム呼ぶ。まだ絵のない映像・画像の素材を 1 つ描き、絵のある素材を POOL_TH_PIC にする。
export function wptTick(ed: E2, kit: mut E2Kit, v: mut E2View): void {
  let made = false;
  for (let k: usize = 0; k < kit.lib.media.length; k++) {
    const id = kit.lib.media[k].id.clone();
    if (wptFind(v.pth, id) >= 0) {
      kit.lib.media[k].thumb = POOL_TH_PIC;
      continue;
    }
    const kind = kit.lib.media[k].kind;
    if (made || kit.lib.media[k].offline || (kind != POOL_K_VIDEO && kind != POOL_K_IMAGE) || wptTried(v.pth, id)) {
      continue;
    }
    v.pth.tried.push(id.clone());
    made = true;
    const path = kit.lib.media[k].path.clone();
    if (wptMake(ed, mut v.pth, id, path, kind)) {
      kit.lib.media[k].thumb = POOL_TH_PIC;
    }
  }
}

// 素材の欄を描いたあとに呼ぶ。欄が画像の命令を出した四角（v.pool.picRs）に、覚えた絵を写す（clip の中だけ）。
export function wptPaint(cv: mut MonCanvas, v: E2View, clip: UkRect): void {
  for (let j: usize = 0; j < v.pool.picIds.length; j++) {
    const k = wptFind(v.pth, v.pool.picIds[j]);
    if (k < 0) {
      continue;
    }
    const pic = k as usize;
    const pw = v.pth.pics[pic].w;
    const ph = v.pth.pics[pic].h;
    const rx = v.pool.picRs[j * 4];
    const ry = v.pool.picRs[j * 4 + 1];
    const rw = v.pool.picRs[j * 4 + 2];
    const rh = v.pool.picRs[j * 4 + 3];
    if (rw <= 0 || rh <= 0) {
      continue;
    }
    for (let yy: i32 = 0; yy < rh; yy++) {
      const y = ry + yy;
      if (y < clip.y || y >= clip.y + clip.h || y < 0 || y >= cv.h) {
        continue;
      }
      const sy = Math.min(((yy as f32 + 0.5) * (ph as f32) / (rh as f32)) as i32, ph - 1);
      for (let xx: i32 = 0; xx < rw; xx++) {
        const x = rx + xx;
        if (x < clip.x || x >= clip.x + clip.w || x < 0 || x >= cv.w) {
          continue;
        }
        const sx = Math.min(((xx as f32 + 0.5) * (pw as f32) / (rw as f32)) as i32, pw - 1);
        cv.img[(y * cv.w + x) as u32] = v.pth.pics[pic].img[(sy * pw + sx) as u32];
      }
    }
  }
}
