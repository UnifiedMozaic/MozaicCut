// レールの「テキスト」の欄（rail_source.um）へ飛ぶ口と、コマンド text.reveal（テキストで見る。Ctrl+E）。
// インスペクタの「テキストで開く」・行の札、問題の場所、コマンドの表から呼ぶ。描く所（rail_source.um）とは分けてある
// （rail_source.um は e2_chrome.um を読み、e2_chrome.um は e2_cmds.um を読むので、e2_cmds.um から読むとめぐるため）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wsrc で始める。
import { UkCtx } from "../uikit/core.um";
import { E2, e2SetStatus } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";

// レールの「テキスト」の番号（edit2.um の v.railSel）
export const WSRC_RAIL: i32 = 4;

// 左の欄に「テキスト」を開き、line 行目（1 から）・col 文字目（1 から。0 は行の頭）へカーソルを置いて見せる。
// line が 0 なら欄を開くだけ。
export function wsrcReveal(v: mut E2View, line: i32, col: i32): void {
  v.railSel = WSRC_RAIL;
  v.leftOpen = true;
  if (line > 0) {
    v.src.jumpLine = line;
    v.src.jumpCol = col;
  }
}

export function wsrcCmdReady(id: string): bool {
  return id == "text.reveal";
}

// text.reveal: 選んだクリップ（いくつかなら最初のもの）の行へ。選んでいなければ欄を開くだけ。
export function wsrcCmdRun(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, id: string): bool {
  if (id != "text.reveal") {
    return false;
  }
  let line = 0;
  let name = "";
  for (const i of v.tl.sel) {
    if (i >= 0 && (i as usize) < ed.project.clips.length && line == 0) {
      line = ed.project.clips[i as usize].line;
      name = ed.project.clips[i as usize].id.clone();
    }
  }
  wsrcReveal(mut v, line, 0);
  if (line > 0) {
    let who = "";
    if (name != "") {
      who = `（${name}）`;
    }
    e2SetStatus(mut ed, `テキストの ${line} 行目${who}を出しました`, false);
  }
  return true;
}
