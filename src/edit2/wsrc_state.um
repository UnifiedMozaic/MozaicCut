// レールの「テキスト」の欄（rail_source.um）の状態: 書き換え中の行、カーソルと選択、スクロール、検索、
// インスペクタなどから「この行へ」と頼まれた行。E2View.src に入れる（rail_source.um だけが書き換える。
// 飛ぶ頼みだけは、ほかのファイルが rail_source.um の railSourceReveal を通して入れる）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wsrc / Wsrc で始める。
export struct WsrcState {
  // 書き換え中の行（.mzc の本文を行に分けたもの。改行は含まない）。ed.ver が変わったら読み直す
  lines: string[];
  // 行を読んだときの E2.ver（-1 はまだ読んでいない）
  ver: i64;
  // カーソル（行の番号は 0 から、列は行の中のバイトの位置）と、選択のもう一方の端（同じなら選択なし）
  curL: i32;
  curC: i32;
  ancL: i32;
  ancC: i32;
  // 上下に動かすときに保つ x（画素。-1 なら今の列から測る）
  wantX: i32;
  // 表示の先頭の行と、横のずれ（画素）
  top: i32;
  scrollX: i32;
  // カーソルを見える所まで動かす（キーで動かしたとき・飛んだとき。マウスのスクロールでは動かさない）
  follow: bool;
  // 飛んだ行を、飛んだ直後に少しのあいだ光らせる（行の番号は 0 から。-1 は無し）と、その時刻
  flashL: i32;
  flashT: f64;
  // 飛ぶ頼み（行は 1 から、列は 1 から。0 は無し）。次に欄を描くときに使う
  jumpLine: i32;
  jumpCol: i32;
  // 最後に書き換えて保存した時刻と、そのときの取り消しの数（続けて打った分を取り消しの 1 つにまとめる）
  editAt: f64;
  editUndo: i64;
  // 検索の文字・検索の欄にフォーカスを移す頼み・今の一致の番号（-1 は無し）
  find: string;
  findFocus: bool;
  findCur: i32;
  // カーソルの点滅を始め直した時刻
  blinkT: f64;
  // 最後に描いた欄の高さ（行の数。PageUp / PageDown に使う）
  rows: i32;
}

export function wsrcStateNew(): WsrcState {
  return {
    lines: [], ver: -1, curL: 0, curC: 0, ancL: 0, ancC: 0, wantX: -1, top: 0, scrollX: 0, follow: false, flashL: -1, flashT: 0.0,
    jumpLine: 0, jumpCol: 0, editAt: -100.0, editUndo: -1, find: "", findFocus: false, findCur: -1, blinkT: 0.0, rows: 20,
  };
}
