// 配線: モニター（src/ui_monitor/）から出てくる出来事を受け取る所。担当はこのファイルだけを書く。
//
// acts（MonAct[]。src/ui_monitor/monitor.um の MON_A_*）は、再生の帯のボタンと、monKeys が取ったキー
// （Space・J / K / L・← →・Home / End・I / O など）から積まれる。monActCommand(a) でコマンドの ID も分かる。
// 再生の操作は、再生のエンジンへの頼みにする（e2_state.um の E2_PB_*。実行は e2_clock.um の e2ClockApply）:
//   MON_A_TOGGLE → e2PbRequest(mut ed, E2_PB_TOGGLE, 0.0)、MON_A_REVERSE / STOP / FORWARD → E2_PB_J / K / L、
//   MON_A_STEP（a.n コマ）→ E2_PB_STEP、MON_A_SEEK・SCRUB_*（a.n はコマ）→ E2_PB_SEEK（秒にして）、
//   MON_A_HOME / END → E2_PB_SEEK（0 / 終わり）。イン・アウト（MON_A_MARK_IN など）は v.tl.inPt / outPt に。
//   MON_A_TAB・TWO_UP・QUALITY・CLEAN は v.mon の表示の切り替え（monitor_demo.um の main の後半が見本）。
// 書き換えてよいもの: ed（e2PbRequest・e2SetStatus を通して）、v.mon、v.tl.inPt / outPt。
import { UkCtx } from "../uikit/core.um";
import { MonAct } from "../ui_monitor/monitor.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";

export function wireMonitor(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, acts: MonAct[]): void {
}
