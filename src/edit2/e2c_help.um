// コマンド（ヘルプ）: help.*・keymap.open（キーの割り当て）。
// 表（e2_cmds.um の e2CmdTable）に並べたコマンドのうち、このファイルが受け持つものの中身。
//
// - e2cHelpReady(id): つないだ（実行できる）コマンドなら true。true のものだけがメニュー・コマンドの欄に出る。
// - e2cHelpRun(...): 実行したら true。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は e2cHelp で始める。
import { UkCtx } from "../uikit/core.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";

export function e2cHelpReady(id: string): bool {
  return false;
}

export function e2cHelpRun(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, id: string): bool {
  // keymap.open・help.manual・help.about はまだ空
  return false;
}
