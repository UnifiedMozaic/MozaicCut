// 配線: 右の列（インスペクタ・履歴・AI のタブ）から出てくる出来事を受け取る所。担当はこのファイルだけを書く。
//
// wireInspector の evs（InsEvent[]。src/ui_inspector/ins_model.um の INS_E_*）:
//   INS_E_SET     値を確定した。e.ops（set / unset の文）を e2ApplyOps(mut ed, e.ops) で適用し、insFlash(mut v.ins, e.key, ui.now)
//   INS_E_PREVIEW ドラッグ中の値（まだ保存しない）。プレビューだけ変えるなら ed.previewDirty を立てる
//   そのほか（キーフレーム・効果の並べ替え・テキストで開く など）は ins_model.um の注釈を見る
// wireRightColumn の evs（AiEvent[]。src/ui_ai/ai_model.um の AI_EV_*）: 履歴のタブの AI_EV_UNDO / REDO / UNDO_TO / REDO_TO は
//   e2Undo / e2Redo を必要な回数呼ぶ。AI の提案（AI_EV_APPLY など）は AI がつながってから。
// 書き換えてよいもの: ed（e2ApplyOps・e2Undo・e2Redo・e2SetStatus を通して）、v.ins、kit.insModel、v.ai、v.rightTab。
import { UkCtx } from "../uikit/core.um";
import { InsEvent } from "../ui_inspector/ins_model.um";
import { AiEvent } from "../ui_ai/ai_model.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";

export function wireInspector(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, evs: InsEvent[]): void {
}

export function wireRightColumn(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, evs: AiEvent[]): void {
}
