// 「色」のワークスペース（ws_color.um）の状態。E2View.wcl と E2Kit.wcl に入れる（ws_color.um だけが書き換える。Kit は読むだけ）。
// E2View / E2Kit から読むので、このファイルは e2_* を読まない。
// 中身は src/ws_color/ の WscState（色のパネル・スコープ・モニターの絵）と、それを .mzc に合わせておくための印。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wcl / Wcl で始める。
import { UcpTheme, ucpThemeFrom } from "../ui_color/ucp_theme.um";
import { WscState, wscNew } from "../ws_color/wsc_ws.um";

// 部品と配線が書き換える状態（選んでいるもの・ドラッグの途中・開いている欄など）。
export struct WclState {
  ws: WscState;
  // 色のパネルを最後に .mzc から写したときの版（E2.ver）とクリップの番号（-2 はまだ写していない）
  syncVer: i64;
  syncClip: i32;
  // LUT の一覧（色のパネルの LUT のタブ）を作ったときのプロジェクトのファイル（変わったら作り直す）
  lutFor: string;
  // スコープに渡すコマ（プログラムの絵 E2Pic を信号の値に戻したもの。いつも 1 個）と、その元の絵の版。
  // 配列にしてあるのは、wscWorkspace に ws（mut）と一緒に渡すとき pop で取り出して、同じ v からの借用を避けるため
  frame: Buffer<vec4<f32>>[];
  fw: i32;
  fh: i32;
  fver: u32;
  picSerial: i64;
  // ドラッグの途中で、読んだ Project に値を入れたか（離したら .mzc に書くか読み直して、ファイルと揃える）
  liveDirty: bool;
  // 選んだクリップを映すために再生ヘッドを動かしたか見たクリップ（-2 は「色」の外にいた。入り直すと見直す）
  seekClip: i32;
}

// 読むだけのもの（tokens.json から作るテーマなど）。e2KitNew が 1 回だけ作る。
export struct WclKit {
  // tokens.json を読めたか
  tokensOk: bool;
  scale: f32;
  // 色のパネル・スコープ・モニターのテーマ（src/ui_color）
  th: UcpTheme;
}

export function wclStateNew(): WclState {
  return { ws: wscNew(), syncVer: -1, syncClip: -2, lutFor: "", frame: [new Buffer<vec4<f32>>(1)], fw: 0, fh: 0, fver: 0, picSerial: -1, liveDirty: false, seekClip: -2 };
}

// js は tokens.json の本文（読めなければ ""）、scale は画面の倍率。
export function wclKitNew(js: string, scale: f32): WclKit {
  return { tokensOk: js.length > 0, scale, th: ucpThemeFrom(js, scale) };
}
