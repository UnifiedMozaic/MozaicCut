// シーケンスの設定の小窓（画面の中に描く。OS のダイアログではない）。
// - 解像度: よく使う形の一覧と、幅 × 高さ の欄（縦横の比と、使えない数の 1 文をその場で出す）
// - フレームレート: よく使う数の一覧と、自分で決める欄
// - ［適用］（Enter）: project の行の size= と fps= を 1 回の操作として書き換える（取り消しは 1 回）
// 開くのは seq.settings（シーケンスのメニュー・コマンドパレット。e2c_seq.um）。
//
// 開いている間は、キーと文字をすべてここが取る（wsqKeys を部品より先に呼ぶ）。描くのは wsqDraw（部品をすべて描いたあと）。
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wsq / Wsq / WSQ で始める。
import {
  UkCtx, ukToast, ukBehavior, ukId, ukIdInt, ukDrawRect, ukDrawRound, ukDrawStroke, ukDrawText, ukDrawTextIn, ukDrawTextInS, ukLineH,
  ukTextTake, ukPushLayer, ukPopLayer, ukPushClipScreen, ukPopClip, ukBlock, ukDrawPopShadow,
  UK_L_MODAL, UK_FONT_SEMIBOLD, UK_KEY_ENTER, UK_KEY_ESC, UK_KEY_BACKSPACE, UK_KEY_TAB,
} from "../uikit/core.um";
import { UkRect, ukRect, ukInside } from "../uikit/base.um";
import { ThTheme, thPx, TH_TS_XS, TH_TS_SM, TH_TS_MD } from "../gen/theme.um";
import { setKey, removeKey } from "../lineedit.um";
import { sqSizeLabels, sqSizeW, sqSizeH, sqFpsLabels, sqFpsVals, sqAspect, sqDim, sqSizeError, sqFpsValue, sqFpsError, sqFpsText } from "../seqfmt.um";
import { E2, e2WriteLines, e2SetStatus, e2BaseName } from "./e2_state.um";
import { KIND_VIDEO } from "../project.um";
import { ffProbe } from "../ffmpeg.um";
import { E2Kit, E2View } from "./e2_view.um";
import { WSQ_F_W, WSQ_F_H, WSQ_F_FPS } from "./wsq_state.um";

// 小窓を開く（欄には今の project の値を入れる）。
export function wsqOpen(ed: E2, v: mut E2View): void {
  v.sq.open = true;
  v.sq.w = `${ed.project.width}`;
  v.sq.h = `${ed.project.height}`;
  v.sq.fps = sqFpsText(ed.project.fpsNum, ed.project.fpsDen);
  v.sq.focus = WSQ_F_W;
}

function wsqPop(s: string): string {
  if (s.length == 0) {
    return "";
  }
  let r: u8[] = [];
  for (let i: usize = 0; i + 1 < s.length; i++) {
    r.push(s[i]);
  }
  return stringFromBytes(r);
}

// 打った文字のうち、数の欄に使えるもの（数字・. ・/）だけを足す。
function wsqAppend(s: string, t: string, fps: bool): string {
  let r: u8[] = [];
  for (const b of s) {
    r.push(b);
  }
  for (const b of t) {
    if ((b >= 48 && b <= 57) || (fps && (b == 46 || b == 47))) {
      if (r.length < 16) {
        r.push(b);
      }
    }
  }
  return stringFromBytes(r);
}

// project の行（"project" で始まる行）の番号。なければ -1。
function wsqProjectLine(lines: string[]): i64 {
  for (let i: usize = 0; i < lines.length; i++) {
    const l = lines[i].clone();
    if (l.length >= 7 && l[0] == 112 && l[1] == 114 && l[2] == 111 && l[3] == 106 && l[4] == 101 && l[5] == 99 && l[6] == 116 &&
      (l.length == 7 || l[7] == 32 || l[7] == 9)) {
      return i as i64;
    }
  }
  return -1;
}

// project の行に size= と fps= を書いた行の並び（width= / height= は size= と食い違わないよう消す）。
export function wsqSetLines(lines: string[], size: string, fps: string): string[] {
  let out: string[] = [];
  for (const l of lines) {
    out.push(l.clone());
  }
  const at = wsqProjectLine(out);
  if (at < 0) {
    let res: string[] = [setKey(setKey("project", "size", size), "fps", fps)];
    for (const l of out) {
      res.push(l.clone());
    }
    return res;
  }
  let l = removeKey(removeKey(out[at as usize], "width"), "height");
  l = setKey(setKey(l, "size", size), "fps", fps);
  out[at as usize] = l;
  return out;
}

// ［適用］: 欄の値が使えれば、size= と fps= を 1 回の操作で書いて閉じる。使えなければ閉じない（誤りは窓に出ている）。
function wsqApply(ed: mut E2, v: mut E2View): void {
  if (sqSizeError(v.sq.w, v.sq.h) != "" || sqFpsError(v.sq.fps) != "") {
    e2SetStatus(mut ed, "シーケンスの設定に使えない値があります（小窓の赤い 1 文を見てください）", true);
    return;
  }
  const w = sqDim(v.sq.w);
  const h = sqDim(v.sq.h);
  const fps = sqFpsValue(v.sq.fps);
  const lines = wsqSetLines(ed.lines, `${w}x${h}`, fps);
  if (e2WriteLines(mut ed, lines, `シーケンスを ${w}×${h} · ${v.sq.fps} fps にしました`)) {
    v.sq.open = false;
  }
}

// 毎フレーム、部品より先に呼ぶ。小窓が開いていれば、キーと文字をすべて取る。
export function wsqKeys(ui: mut UkCtx, ed: mut E2, v: mut E2View): void {
  if (!v.sq.open) {
    return;
  }
  const t = ukTextTake(mut ui);
  if (t.length > 0) {
    if (v.sq.focus == WSQ_F_W) {
      v.sq.w = wsqAppend(v.sq.w, t, false);
    } else if (v.sq.focus == WSQ_F_H) {
      v.sq.h = wsqAppend(v.sq.h, t, false);
    } else {
      v.sq.fps = wsqAppend(v.sq.fps, t, true);
    }
  }
  for (let i: usize = 0; i < ui.inp.keys.length; i++) {
    const k = ui.inp.keys[i];
    ui.inp.keys[i] = 0;
    if (k == 0 || !v.sq.open) {
      continue;
    }
    if (k == UK_KEY_ESC) {
      v.sq.open = false;
    } else if (k == UK_KEY_ENTER) {
      wsqApply(mut ed, mut v);
    } else if (k == UK_KEY_TAB) {
      v.sq.focus = (v.sq.focus + 1) % 3;
    } else if (k == UK_KEY_BACKSPACE) {
      if (v.sq.focus == WSQ_F_W) {
        v.sq.w = wsqPop(v.sq.w);
      } else if (v.sq.focus == WSQ_F_H) {
        v.sq.h = wsqPop(v.sq.h);
      } else {
        v.sq.fps = wsqPop(v.sq.fps);
      }
    }
  }
}

// 一覧の 1 つ（押せる札）。押したら true。
function wsqChip(ui: mut UkCtx, th: ThTheme, r: UkRect, label: string, on: bool, idKey: string, n: i32): bool {
  const h = ukBehavior(mut ui, ukIdInt(ui, idKey, n), r, false);
  let bg = th.c.bg1;
  let line = th.c.lineControl;
  let tc = th.c.text1;
  if (on) {
    bg = th.c.accentTint;
    line = th.c.accent;
  } else if (h.hover) {
    line = th.c.text2;
  }
  ukDrawRound(mut ui, r, th.radiusSm, bg);
  ukDrawStroke(mut ui, r, th.radiusSm, th.borderHairline, line);
  ukDrawTextIn(mut ui, r, label, th.ts[TH_TS_SM as usize], tc, 1);
  return h.clicked;
}

// 打つ欄。押したらそこへ文字を打つようにする。
function wsqField(ui: mut UkCtx, th: ThTheme, v: mut E2View, r: UkRect, text: string, which: i32, bad: bool): void {
  const h = ukBehavior(mut ui, ukIdInt(ui, "##wsq-field", which), r, false);
  if (h.clicked) {
    v.sq.focus = which;
  }
  const focused = v.sq.focus == which;
  const fs = th.ts[TH_TS_MD as usize];
  ukDrawRound(mut ui, r, th.radiusSm, th.c.bg1);
  let line = th.c.lineControl;
  if (bad) {
    line = th.c.error;
  } else if (focused) {
    line = th.c.accent;
  }
  ukDrawStroke(mut ui, r, th.radiusSm, th.borderHairline, line);
  const lh = ukLineH(ui, fs);
  const tx = r.x + thPx(th, 8);
  const ty = r.y + (r.h - lh) / 2;
  const w = ukDrawText(mut ui, tx, ty, text, fs, th.c.text1);
  if (focused) {
    ukDrawRect(mut ui, ukRect(tx + w + 1, ty, thPx(th, 1) + 1, lh), th.c.accent);
  }
}

// 押せるボタン（［適用］［やめる］）。押したら true。
function wsqButton(ui: mut UkCtx, th: ThTheme, r: UkRect, label: string, primary: bool, idKey: string): bool {
  const h = ukBehavior(mut ui, ukId(ui, idKey), r, false);
  let bg = th.c.bg2;
  let tc = th.c.text1;
  if (primary) {
    bg = h.hover ? th.c.accentHover : th.c.accent;
    tc = th.c.textOnAccent;
  } else if (h.hover) {
    bg = th.c.bg3;
  }
  ukDrawRound(mut ui, r, th.radiusSm, bg);
  if (!primary) {
    ukDrawStroke(mut ui, r, th.radiusSm, th.borderHairline, th.c.lineControl);
  }
  ukDrawTextInS(mut ui, r, label, th.ts[TH_TS_SM as usize], tc, 1, UK_FONT_SEMIBOLD);
  return h.clicked;
}

// 部品をすべて描いたあとに呼ぶ。
export function wsqDraw(ui: mut UkCtx, ed: mut E2, kit: E2Kit, v: mut E2View): void {
  if (!v.sq.open) {
    return;
  }
  const th = kit.th;
  ukPushLayer(mut ui, UK_L_MODAL);
  ui.modalNext = Math.max(ui.modalNext, UK_L_MODAL);
  ukPushClipScreen(mut ui);
  const fsSm = th.ts[TH_TS_SM as usize];
  const fsXs = th.ts[TH_TS_XS as usize];
  const W = Math.min(thPx(th, 560), ui.W - thPx(th, 32));
  const H = Math.min(thPx(th, 430), ui.H - thPx(th, 32));
  const r = ukRect((ui.W - W) / 2, Math.max((ui.H - H) / 3, thPx(th, 16)), W, H);
  const scr = ukRect(0, 0, ui.W, ui.H);
  ukBlock(mut ui, scr);
  const bgHit = ukBehavior(mut ui, ukId(ui, "##wsq-outside"), scr, false);
  ukDrawPopShadow(mut ui, r, th.radiusLg, ui.theme.shadowBlur * 2, 2, ui.theme.shadow);
  ukDrawRound(mut ui, r, th.radiusLg, th.c.bgPopover);
  ukDrawStroke(mut ui, r, th.radiusLg, th.borderHairline, th.c.lineStrong);
  ukBehavior(mut ui, ukId(ui, "##wsq-body"), r, false);
  const hh = thPx(th, 40);
  const pad = thPx(th, 16);
  ukDrawTextInS(mut ui, ukRect(r.x + pad, r.y, r.w - pad * 2, hh), "シーケンスの設定", th.ts[TH_TS_MD as usize], th.c.text1, 0, UK_FONT_SEMIBOLD);
  ukDrawRect(mut ui, ukRect(r.x, r.y + hh - th.borderHairline, r.w, th.borderHairline), th.c.line);
  const x0 = r.x + pad;
  const iw = r.w - pad * 2;
  const gap = thPx(th, 6);
  const chipH = thPx(th, 28);
  const lineH = thPx(th, 22);
  let y = r.y + hh + thPx(th, 10);
  // ---- 解像度 ----
  ukDrawTextInS(mut ui, ukRect(x0, y, iw, lineH), "解像度", fsSm, th.c.text2, 0, UK_FONT_SEMIBOLD);
  y = y + lineH;
  const sl = sqSizeLabels();
  const sw = sqSizeW();
  const sh = sqSizeH();
  const cw = (iw - gap * 2) / 3;
  const curW = sqDim(v.sq.w);
  const curH = sqDim(v.sq.h);
  for (let i: usize = 0; i < sl.length; i++) {
    const cx = x0 + ((i % 3) as i32) * (cw + gap);
    const cy = y + ((i / 3) as i32) * (chipH + gap);
    if (wsqChip(mut ui, th, ukRect(cx, cy, cw, chipH), sl[i], curW == sw[i] && curH == sh[i], "##wsq-size", i as i32)) {
      v.sq.w = `${sw[i]}`;
      v.sq.h = `${sh[i]}`;
    }
  }
  y = y + 2 * (chipH + gap) + thPx(th, 4);
  // 自分で決める: 幅 × 高さ
  const fh = thPx(th, 30);
  const fw = thPx(th, 96);
  const lw = thPx(th, 96);
  ukDrawTextIn(mut ui, ukRect(x0, y, lw, fh), "自分で決める", fsSm, th.c.text2, 0);
  const sizeErr = sqSizeError(v.sq.w, v.sq.h);
  const fx = x0 + lw;
  const wText = v.sq.w.clone();
  const hText = v.sq.h.clone();
  wsqField(mut ui, th, mut v, ukRect(fx, y, fw, fh), wText, WSQ_F_W, sizeErr != "" && sqDim(wText) < 0);
  ukDrawTextIn(mut ui, ukRect(fx + fw, y, thPx(th, 24), fh), "×", fsSm, th.c.text2, 1);
  wsqField(mut ui, th, mut v, ukRect(fx + fw + thPx(th, 24), y, fw, fh), hText, WSQ_F_H, sizeErr != "" && sqDim(hText) < 0);
  const ax = fx + fw * 2 + thPx(th, 36);
  if (sizeErr == "") {
    ukDrawTextIn(mut ui, ukRect(ax, y, x0 + iw - ax, fh), `縦横の比 ${sqAspect(curW, curH)}`, fsSm, th.c.text2, 0);
  }
  y = y + fh + thPx(th, 2);
  if (sizeErr != "") {
    ukDrawTextIn(mut ui, ukRect(x0, y, iw, lineH), sizeErr, fsXs, th.c.error, 0);
  }
  y = y + lineH + thPx(th, 6);
  // ---- フレームレート ----
  ukDrawTextInS(mut ui, ukRect(x0, y, iw, lineH), "フレームレート", fsSm, th.c.text2, 0, UK_FONT_SEMIBOLD);
  y = y + lineH;
  const fl = sqFpsLabels();
  const fv = sqFpsVals();
  const curF = sqFpsValue(v.sq.fps);
  const fcw = (iw - gap * 3) / 4;
  for (let i: usize = 0; i < fl.length; i++) {
    const cx = x0 + ((i % 4) as i32) * (fcw + gap);
    const cy = y + ((i / 4) as i32) * (chipH + gap);
    if (wsqChip(mut ui, th, ukRect(cx, cy, fcw, chipH), fl[i], curF == fv[i], "##wsq-fps", i as i32)) {
      v.sq.fps = fl[i].clone();
    }
  }
  y = y + 2 * (chipH + gap) + thPx(th, 4);
  ukDrawTextIn(mut ui, ukRect(x0, y, lw, fh), "自分で決める", fsSm, th.c.text2, 0);
  const fpsErr = sqFpsError(v.sq.fps);
  const fText = v.sq.fps.clone();
  wsqField(mut ui, th, mut v, ukRect(fx, y, fw, fh), fText, WSQ_F_FPS, fpsErr != "");
  ukDrawTextIn(mut ui, ukRect(fx + fw + thPx(th, 8), y, thPx(th, 60), fh), "fps", fsSm, th.c.text2, 0);
  y = y + fh + thPx(th, 2);
  if (fpsErr != "") {
    ukDrawTextIn(mut ui, ukRect(x0, y, iw, lineH), fpsErr, fsXs, th.c.error, 0);
  }
  // ---- 下の段 ----
  const by = r.y + r.h - thPx(th, 48);
  ukDrawRect(mut ui, ukRect(r.x, by, r.w, th.borderHairline), th.c.line);
  const bw = thPx(th, 88);
  const bh = thPx(th, 30);
  const bty = by + (thPx(th, 48) - bh) / 2;
  ukDrawTextIn(mut ui, ukRect(x0, by, iw - bw * 2 - gap * 2, thPx(th, 48)), "Tab で欄を移る · Enter で適用 · Esc でやめる", fsXs, th.c.text3, 0);
  if (wsqButton(mut ui, th, ukRect(x0 + iw - bw * 2 - gap, bty, bw, bh), "やめる", false, "##wsq-cancel")) {
    v.sq.open = false;
  }
  if (wsqButton(mut ui, th, ukRect(x0 + iw - bw, bty, bw, bh), "適用", true, "##wsq-apply")) {
    wsqApply(mut ed, mut v);
  }
  if (bgHit.clicked && !ukInside(r, ui.inp.mx, ui.inp.my)) {
    v.sq.open = false;
  }
  ukPopClip(mut ui);
  ukPopLayer(mut ui);
}

// ---- 最初の素材に合わせる ----
// スタート画面で「最初の素材に合わせる」を選んで作ったプロジェクトは、project の行の下に WSQ_FIT_LINE の注釈の行を持つ。
// その行がある間、映像のクリップ（なければ素材の欄の映像）が入ったら、その素材の大きさとフレームレートを FFmpeg で調べ、
// project の行の size= と fps= を書き換えて注釈の行を消す（取り消しは 1 回）。合わせたことを 1 文で知らせる。

export const WSQ_FIT_LINE: string = "#fit-first-media（最初に入れた映像の大きさとフレームレートに合わせます。合わせたら消えます）";

function wsqIsFitLine(l: string): bool {
  const k = "#fit-first-media";
  if (l.length < k.length) {
    return false;
  }
  for (let i: usize = 0; i < k.length; i++) {
    if (l[i] != k[i]) {
      return false;
    }
  }
  return true;
}

// 偶数に切り下げ、16〜8192 に収める。
function wsqEvenDim(v: i32): i32 {
  return Math.max(Math.min(v - v % 2, 8192), 16);
}

// 毎フレーム呼ぶ（注釈の行がなければ何もしない）。
export function wsqFitTick(ui: mut UkCtx, ed: mut E2): void {
  let at: i64 = -1;
  for (let i: usize = 0; i < ed.lines.length; i++) {
    if (wsqIsFitLine(ed.lines[i])) {
      at = i as i64;
    }
  }
  if (at < 0) {
    return;
  }
  let file = "";
  for (const c of ed.project.clips) {
    if (file == "" && c.kind == KIND_VIDEO && c.file != "") {
      file = c.file.clone();
    }
  }
  for (const q of ed.imported) {
    if (file == "" && q.hasVideo && q.file != "") {
      file = q.file.clone();
    }
  }
  if (file == "") {
    return;
  }
  const info = ffProbe(file);
  let lines: string[] = [];
  for (let i: usize = 0; i < ed.lines.length; i++) {
    if ((i as i64) != at) {
      lines.push(ed.lines[i].clone());
    }
  }
  if (!info.ok || !info.hasVideo || info.width <= 0 || info.height <= 0) {
    // 調べられない素材なら合わせずに印だけ消す（毎フレーム調べ直さないため）
    e2WriteLines(mut ed, lines, `${e2BaseName(file)} の大きさが分からないので、シーケンスの形式はそのままにしました`);
    return;
  }
  let w = info.width;
  let h = info.height;
  if (info.rotation == 90 || info.rotation == 270 || info.rotation == -90) {
    w = info.height;
    h = info.width;
  }
  w = wsqEvenDim(w);
  h = wsqEvenDim(h);
  let fps = "";
  if (info.fpsNum > 0 && info.fpsDen > 0) {
    fps = sqFpsValue(`${info.fpsNum}/${info.fpsDen}`);
  }
  if (fps == "") {
    fps = `${ed.project.fpsNum}/${ed.project.fpsDen}`;
  }
  const label = sqFpsText(info.fpsNum, info.fpsDen);
  const msg = `最初の素材 ${e2BaseName(file)} に合わせて、シーケンスを ${w}×${h} · ${label} fps にしました`;
  if (e2WriteLines(mut ed, wsqSetLines(lines, `${w}x${h}`, fps), msg)) {
    ukToast(mut ui, msg, 0);
  }
}
