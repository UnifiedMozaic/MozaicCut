// 窓の外からのファイルのドロップを受ける所。
//
// stage-m1 を載せるときにつなぐ所（docs/design/edit2.md）: stage-m1 の editor.um の dropMedia（素材を調べて
// タイムラインの末尾に足す）を、e2DropFiles の中から呼ぶ形に移す。どこに落とされたか（where）で振り分ける:
//   E2_DROP_POOL      素材の欄: 素材として読み込む（タイムラインには置かない）
//   E2_DROP_TIMELINE  タイムライン: 落とした位置（x, y。画面の座標）に置く
//   E2_DROP_MONITOR   モニター: ソースのタブで開く
//   E2_DROP_OTHER     そのほか: タイムラインの末尾に足す（stage-m1 の今の動き）
import { UkCtx, ukDropTake, ukDropOver } from "../uikit/core.um";
import { UkRect } from "../uikit/base.um";
import { E2, e2SetStatus } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";
import { E2Lay } from "./e2_layout.um";

export const E2_DROP_POOL: i32 = 1;
export const E2_DROP_TIMELINE: i32 = 2;
export const E2_DROP_MONITOR: i32 = 3;
export const E2_DROP_OTHER: i32 = 4;

// 落とされたファイルを受け取る（いまは知らせるだけ）。
export function e2DropFiles(ed: mut E2, kit: mut E2Kit, v: mut E2View, files: string[], where: i32, x: i32, y: i32): void {
  if (files.length == 0) {
    return;
  }
  e2SetStatus(mut ed, `ファイルを ${files.length} 個受け取りました（素材の読み込みはまだつないでいません）`, false);
}

// 毎フレーム、部品を描いたあとに呼ぶ。引いている最中は素材の欄の受け口を光らせ、落とされたら e2DropFiles に渡す。
export function e2DropTake(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, L: E2Lay): void {
  v.pool.dropHover = ukDropOver(ui, L.left);
  const x = ui.dropX;
  const y = ui.dropY;
  const a = ukDropTake(mut ui, L.left);
  if (a.length > 0) {
    e2DropFiles(mut ed, mut kit, mut v, a, E2_DROP_POOL, x, y);
  }
  const b = ukDropTake(mut ui, L.tl);
  if (b.length > 0) {
    e2DropFiles(mut ed, mut kit, mut v, b, E2_DROP_TIMELINE, x, y);
  }
  const c = ukDropTake(mut ui, L.mon);
  if (c.length > 0) {
    e2DropFiles(mut ed, mut kit, mut v, c, E2_DROP_MONITOR, x, y);
  }
  const d = ukDropTake(mut ui, L.top);
  if (d.length > 0) {
    e2DropFiles(mut ed, mut kit, mut v, d, E2_DROP_OTHER, x, y);
  }
  const e = ukDropTake(mut ui, L.right);
  if (e.length > 0) {
    e2DropFiles(mut ed, mut kit, mut v, e, E2_DROP_OTHER, x, y);
  }
}
