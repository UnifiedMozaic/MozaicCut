// ダイアログで選んだパスを .mzc に書く形にする（区切りを / にし、.mzc のフォルダの下なら相対パスにする）。
// 書き出しの［場所を指定する］（ws_export.um）と色の LUT の［読み込む…］（ws_color.um）が使う。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wmisc で始める。
import { sub } from "../text.um";
import { e2DirOf } from "./e2_state.um";

// 区切りの \（92）を /（47）にする。
export function wmiscSlashes(s: string): string {
  let out: u8[] = [];
  for (const b of s) {
    if (b == 92) {
      out.push(47);
    } else {
      out.push(b);
    }
  }
  return stringFromBytes(out);
}

// path が dir の下なら dir からの相対パス、そうでなければそのまま（どちらも / 区切り。英字の大小は見ない）。
export function wmiscRelTo(dir: string, path: string): string {
  const n = dir.length;
  if (n == 0 || path.length <= n + 1 || path[n] != 47) {
    return path.clone();
  }
  for (let i: usize = 0; i < n; i++) {
    let a = dir[i];
    let b = path[i];
    if (a >= 65 && a <= 90) {
      a += 32;
    }
    if (b >= 65 && b <= 90) {
      b += 32;
    }
    if (a != b) {
      return path.clone();
    }
  }
  return sub(path, n + 1, path.length);
}

// 選んだパスを、プロジェクト mzc（.mzc のパス）から書く形にする。
export function wmiscMzcPath(mzc: string, picked: string): string {
  return wmiscRelTo(wmiscSlashes(absPath(e2DirOf(mzc))), wmiscSlashes(picked));
}
