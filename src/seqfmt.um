// シーケンスの形式（解像度とフレームレート）の選択肢と、打った数の確かめ。
// 編集画面のシーケンスの設定の小窓（edit2/e2_seqdlg.um）とスタート画面（edit2/start.um）が使う。
// 確かめの範囲は project.um の読み取り（size は 16〜8192 の偶数、fps は 1〜240）に合わせる。
// 名前の空間は全体で 1 つなので、型と関数は Sq / sq で始める。
import { parseNum, isNan, splitBy } from "./text.um";

// よく使う解像度（表示と幅・高さ）
export function sqSizeLabels(): string[] {
  return ["1280×720", "1920×1080", "2560×1440", "3840×2160", "1080×1920（縦）", "1080×1080（正方形）"];
}

export function sqSizeW(): i32[] {
  return [1280, 1920, 2560, 3840, 1080, 1080];
}

export function sqSizeH(): i32[] {
  return [720, 1080, 1440, 2160, 1920, 1080];
}

// よく使うフレームレート（表示と .mzc の fps= の値）
export function sqFpsLabels(): string[] {
  return ["23.976", "24", "25", "29.97", "30", "50", "59.94", "60"];
}

export function sqFpsVals(): string[] {
  return ["24000/1001", "24", "25", "30000/1001", "30", "50", "60000/1001", "60"];
}

function sqGcd(a0: i32, b0: i32): i32 {
  let a = a0;
  let b = b0;
  while (b != 0) {
    const t = a % b;
    a = b;
    b = t;
  }
  return a;
}

// 縦横の比（「16:9」）。0 があれば ""。
export function sqAspect(w: i32, h: i32): string {
  if (w <= 0 || h <= 0) {
    return "";
  }
  const g = sqGcd(w, h);
  return `${w / g}:${h / g}`;
}

// 幅か高さの欄の文字を数にする。使えなければ -1。
export function sqDim(s: string): i32 {
  const v = parseNum(s);
  if (isNan(v) || v != Math.floor(v) || v < 16 || v > 8192 || (v as i32) % 2 != 0) {
    return -1;
  }
  return v as i32;
}

// 幅と高さの欄の誤り（1 文）。使えれば ""。
export function sqSizeError(ws: string, hs: string): string {
  const names: string[] = ["幅", "高さ"];
  const vals: string[] = [ws.clone(), hs.clone()];
  for (let i: usize = 0; i < 2; i++) {
    const v = parseNum(vals[i]);
    if (vals[i] == "" || isNan(v) || v != Math.floor(v)) {
      return `${names[i]}を整数で入れてください。`;
    }
    if (v < 16) {
      return `${names[i]}が小さすぎます（16 以上にします）。`;
    }
    if (v > 8192) {
      return `${names[i]}が大きすぎます（8192 までにします）。`;
    }
    if ((v as i32) % 2 != 0) {
      return `${names[i]}は偶数にします（書き出しの形式が奇数を受け付けないため）。`;
    }
  }
  return "";
}

// フレームレートの欄の文字（30・29.97・30000/1001）を .mzc の fps= の値にする。使えなければ ""。
// 29.97・23.976・59.94 のような NTSC の数は分数にする（project.um の読み取りと同じ決め方）。
export function sqFpsValue(s: string): string {
  const parts = splitBy(s, 47);
  if (parts.length == 2) {
    const a = parseNum(parts[0]);
    const b = parseNum(parts[1]);
    if (isNan(a) || isNan(b) || a < 1 || b < 1 || a != Math.floor(a) || b != Math.floor(b) || a > 2147483647 || b > 2147483647 || a / b < 1 || a / b > 240) {
      return "";
    }
    if (b == 1) {
      return `${a as i64}`;
    }
    return `${a as i64}/${b as i64}`;
  }
  if (parts.length != 1) {
    return "";
  }
  const v = parseNum(s);
  if (isNan(v) || v < 1 || v > 240) {
    return "";
  }
  const r = Math.floor(v + 0.5);
  if (Math.abs(v - r) < 0.0001) {
    return `${r as i64}`;
  }
  if (Math.abs(v - r * 1000 / 1001) < 0.01) {
    return `${(r * 1000) as i64}/1001`;
  }
  return `${Math.floor(v * 1000 + 0.5) as i64}/1000`;
}

// フレームレートの欄の誤り（1 文）。使えれば ""。
export function sqFpsError(s: string): string {
  if (s == "") {
    return "フレームレートを入れてください。";
  }
  if (sqFpsValue(s) == "") {
    return "フレームレートは 1〜240 の数（30・29.97・30000/1001）で入れてください。";
  }
  return "";
}

// fpsNum / fpsDen を欄に出す文字にする（30・29.97・23.976・59.94、そのほかは分数）。
export function sqFpsText(num: i32, den: i32): string {
  if (den == 1) {
    return `${num}`;
  }
  const vals = sqFpsVals();
  const labels = sqFpsLabels();
  const v = `${num}/${den}`;
  for (let i: usize = 0; i < vals.length; i++) {
    if (vals[i] == v) {
      return labels[i].clone();
    }
  }
  return v;
}
