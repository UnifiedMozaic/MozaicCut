// MozaicCut: UnifiedMozaic で書いた動画編集エンジン（ウィンドウなし）。
// 人向けの出力は日本語、機械向けは --json（JSON）。使い方は usageLines() を見る。
//
//   mozcut check   <project.mzc> [cache] [--json]          誤りを調べる（誤りなし 0、誤りあり 1、使い方の誤り 2）
//   mozcut show    <project.mzc> [cache] [--width N]       タイムラインの図とクリップの一覧
//   mozcut op      <project.mzc> [cache] <操作...> [--dry-run] [--json]
//   mozcut op      <project.mzc> [cache] --file <ops.txt | -> [--dry-run] [--json]
//   mozcut schema  [--json]                                キーと効果の一覧
//   mozcut sources <project.mzc>                           素材のパスを並べる（mozcut.mjs が ffprobe で調べる）
//   mozcut plan    <project.mzc> <cache>                   素材の展開の仕事を並べる（mozcut.mjs が ffmpeg で行う）
//   mozcut render  <project.mzc> <cache> [from] [to] [--out out.mp4]
//                                                          --out があれば MP4（H.264 + AAC）を FFmpeg の組み込みで直接書く。
//                                                          なければ映像（Y4M）と音（PCM）を cache に書く（予備の経路）
//   mozcut preview <project.mzc> <cache> <time> <out.bmp>  1 コマを BMP に書く
//   mozcut motion  <project.mzc> <cache> <clip> <x,y> --to <clip> [--dry-run] [--json]  点を追って位置のキーフレームにする
//   mozcut caps                                            FFmpeg の組み込みの有無（ffmpeg\t1\t<版> か ffmpeg\t0）
//
// check / show / op の cache は省ける。省くと project の隣の <名前>.cache/ に probe.txt があればそれを使う。
import { parseTime, parseNum, isNan, fmtTime, sub, splitLines } from "./engine/text.um";
import {
  Project, Clip, Probe, Diag, parseProjectReg, readProbes, frameCount, frameTime,
  KIND_VIDEO, KIND_IMAGE, FIT_COVER, FIT_STRETCH, UNSET, clipSrcDur,
} from "./engine/project.um";
import {
  RenderCache, newRenderCache, loadMedia, checkMedia, renderFrameReg, canvasToYuv, writeBmp,
  videoCachePath, imageCachePath, audioCachePath,
} from "./engine/render.um";
import { gradeLutWarnings } from "./effects/color/gradelayer.um";
import { clipHasSound, mixAudio } from "./engine/audio.um";
import { encDefaults, encOpen, encStepReg, encFinish, encBitRate } from "./engine/encode.um";
import { Font, projectFont } from "./effects/text/ttf.um";
import { jsonStr, jsonNum, diagText, diagsJson, projectJsonReg, showTextReg, schemaTextReg, schemaJsonReg } from "./engine/report.um";
import { OpResult, Change, Moved, BatchResult, splitArgs, runOpsReg, isOpName } from "./engine/ops.um";
import { FxReg, fxRegDiscover } from "./gen/plugins.um";
import { cmdMotion } from "./effects/track/motion.um";
import { ffEnabled, ffVersion } from "./engine/ffmpeg.um";
import { mediaProbeSources } from "./engine/media.um";

const SHOW_WIDTH: i32 = 100;

function usageLines(): string[] {
  return [
    "使い方: mozcut <コマンド> ...",
    "",
    "  check   <project.mzc> [cache] [--json]",
    "      プロジェクトを読んで誤りを調べる。誤りがなければ終了コード 0、あれば 1。",
    "  show    <project.mzc> [cache] [--width N]",
    "      タイムラインの図とクリップの一覧を表示する（N は図の幅。既定 100）。",
    "  op      <project.mzc> [cache] <操作...> [--dry-run] [--json]",
    "  op      <project.mzc> [cache] --file <ops.txt | -> [--dry-run] [--json]",
    "      操作を適用して保存する。--file はファイル（- なら標準入力）の 1 行に 1 つの操作。",
    "      --dry-run は変更を表示するだけで保存しない。どれかが失敗したら何も書かない。",
    "  schema  [--json]",
    "      プロジェクトファイルで使えるキーと効果（プラグイン）の一覧。",
    "  sources <project.mzc>",
    "      素材のパスを並べる（tools/mozcut.mjs が ffprobe で調べる）。",
    "  plan    <project.mzc> <cache>",
    "      素材の展開の仕事を並べる（tools/mozcut.mjs が ffmpeg で行う）。",
    "  render  <project.mzc> <cache> [from] [to] [--out out.mp4]",
    "      --out があれば、動画（H.264 + AAC。ハードウェアの符号器があれば使う）を直接書く（FFmpeg の組み込みが要る）。",
    "      なければ映像（Y4M）と音（PCM）を cache に書く（tools/mozcut.mjs が ffmpeg で圧縮する予備の経路）。",
    "  preview <project.mzc> <cache> <time> <out.bmp>",
    "      1 コマを BMP に書く。",
    "  motion  <project.mzc> <cache> <追うクリップ> <x,y> --to <動かすクリップ> [--dry-run] [--json]",
    "      映像の中の点（画面の画素）を追い、動かすクリップの位置のキーフレーム（pos）にして書く。",
    "  caps",
    "      このエンジンでできること（FFmpeg の組み込みの有無と版）を 1 行ずつ出す（tools/mozcut.mjs が使う）。",
    "",
    "操作（クリップは ID、#番号（0 から）、@行番号 で指す）:",
    "  move <クリップ> <時刻か参照>          例: move clip_b 5.5 / move clip_b clip_a.end+1",
    "  trim <クリップ> start|end <時刻>      例: trim clip_a end 4.5",
    "  split <クリップ> <時刻>               例: split clip_a 3.5",
    "  delete <クリップ> [fix-refs]          行を # で注釈にする（fix-refs: 参照を秒に書き換えてから）",
    "  cut <開始> <終わり>                   範囲を全トラックから切り取って詰める。例: cut 0 3",
    "  set <クリップ> key=value ...          例: set clip_b sat=1.2 blur=3",
    "  unset <クリップ> key ...              例: unset clip_b blur",
    "  renamekey <クリップ> <古> <新>        キーの名前だけを変える。例: renamekey clip_b vignete vignette",
    "  add <種類> [<素材/文字/色>] key=value ... [after <クリップ>]   例: add text \"Hello\" at=2 dur=3",
    "      種類は video / image / audio / text / color / shape / particles / mask。",
    "      例: add shape star points=5 r=80 / add particles emit=point rate=200 / add mask ellipse to=pip ref=640x360 w=400 h=300",
    "  rename <クリップ> <新しい ID>",
    "  key add|remove|move|set|ease|shift|clear <クリップ> <キー> ...   キーフレームを書き換える",
    "      例: key add title x 1.5 400 ease / key remove title x 1.5 / key ease title opacity * easeout",
    "  （マスクの行は @行番号 で set / unset / delete する）",
    "",
    "check / show / op の cache は省ける（project の隣の <名前>.cache/probe.txt を使う）。",
    "素材の調査・展開・書き出しまでの一連の処理は node tools/mozcut.mjs から行う。操作の詳しい書き方は schema。",
  ];
}

function usage(): i32 {
  for (const l of usageLines()) {
    eprint(l);
  }
  return 2;
}

function usageError(msg: string): i32 {
  eprint(`mozcut: ${msg}`);
  eprint("使い方は node tools/mozcut.mjs help で表示します。");
  return 2;
}

// ---- 引数 ----

struct Cli {
  pos: string[];
  json: bool;
  dryRun: bool;
  hasFile: bool;
  file: string;
  width: i32;
  bad: string;
}

// a[from..] を読む。"--" より後ろはすべて位置の引数（操作の語）にする。
function parseCli(a: string[], from: usize): Cli {
  let c: Cli = { pos: [], json: false, dryRun: false, hasFile: false, file: "", width: SHOW_WIDTH, bad: "" };
  let rest = false;
  let i = from;
  while (i < a.length) {
    const s = a[i].clone();
    i++;
    if (rest) {
      c.pos.push(s);
      continue;
    }
    if (s == "--") {
      rest = true;
    } else if (s == "--json") {
      c.json = true;
    } else if (s == "--dry-run") {
      c.dryRun = true;
    } else if (s == "--file") {
      if (i >= a.length) {
        c.bad = "--file のあとにファイルの名前（標準入力なら -）を書きます";
        return c;
      }
      c.hasFile = true;
      c.file = a[i].clone();
      i++;
    } else if (s == "--width") {
      if (i >= a.length) {
        c.bad = "--width のあとに幅（文字数）を書きます";
        return c;
      }
      const v = parseNum(a[i]);
      if (isNan(v) || v < 1 || v > 100000 || Math.floor(v) != v) {
        c.bad = `--width の値 '${a[i]}' は 1 以上の整数で書きます`;
        return c;
      }
      c.width = v as i32;
      i++;
    } else if (s.length > 2 && s[0] == 45 && s[1] == 45) {
      c.bad = `'${s}' というオプションはありません`;
      return c;
    } else {
      c.pos.push(s);
    }
  }
  return c;
}


// project の隣の <名前>.cache/（probe.txt があるときだけ）。なければ ""。
function autoCache(path: string): string {
  let start: usize = 0;
  for (let i: usize = 0; i < path.length; i++) {
    if (path[i] == 47 || path[i] == 92) {
      start = i + 1;
    }
  }
  let dot = path.length;
  for (let i = start; i < path.length; i++) {
    if (path[i] == 46 && i > start) {
      dot = i;
    }
  }
  const cand = sub(path, 0, dot) + ".cache";
  if (fileSize(`${cand}/probe.txt`) != null) {
    return cand;
  }
  return "";
}

function baseName(path: string): string {
  let start: usize = 0;
  for (let i: usize = 0; i < path.length; i++) {
    if (path[i] == 47 || path[i] == 92) {
      start = i + 1;
    }
  }
  return sub(path, start, path.length);
}

// 素材の情報。FFmpeg の組み込みがあれば素材を自分で調べ（media.um の mediaProbeSources）、cache の probe.txt
// （mozcut.mjs が ffprobe で書いたもの）は予備にする。なければ probe.txt だけを使う。
function probesFor(path: string, text: u8[], cache: string): Probe[] {
  let fallback: Probe[] = [];
  if (cache != "") {
    fallback = readProbes(`${cache}/probe.txt`);
  }
  let known: Probe[] = [];
  return mediaProbeSources(text, path, fallback, mut known);
}

function errorCount(diags: Diag[]): i32 {
  let n = 0;
  for (const d of diags) {
    if (d.severity == "error") {
      n++;
    }
  }
  return n;
}

function printDiags(path: string, diags: Diag[], toStderr: bool): void {
  for (const d of diags) {
    if (toStderr) {
      eprint(diagText(path, d));
    } else {
      print(diagText(path, d));
    }
  }
}

function cannotRead(path: string, json: bool): i32 {
  if (json) {
    const msg = `'${path}' を読めません`;
    print(`{"ok":false,"error":${jsonStr(msg)}}`);
  }
  eprint(`mozcut: '${path}' を読めません`);
  return 1;
}

// ---- check / show / schema ----

function cmdCheck(a: string[], reg: FxReg): i32 {
  const c = parseCli(a, 1);
  if (c.bad != "") {
    return usageError(c.bad);
  }
  if (c.pos.length < 1 || c.pos.length > 2 || c.hasFile || c.dryRun) {
    return usageError("check <project.mzc> [cache] [--json] と書きます");
  }
  const path = c.pos[0].clone();
  let cache = "";
  if (c.pos.length == 2) {
    cache = c.pos[1].clone();
  } else {
    cache = autoCache(path);
  }
  const text = readFile(path);
  if (text == null) {
    return cannotRead(path, c.json);
  }
  let diags: Diag[] = [];
  const p = parseProjectReg(text, probesFor(path, text, cache), mut diags, reg);
  const nErr = errorCount(diags);
  if (c.json) {
    print(projectJsonReg(p, diags, reg));
  } else {
    printDiags(path, diags, false);
    if (nErr == 0) {
      print(`問題はありません（クリップ ${p.clips.length} 個、長さ ${fmtTime(Math.max(p.duration, 0.0))}）`);
    } else {
      const nWarn = (diags.length as i32) - nErr;
      if (nWarn > 0) {
        print(`エラー ${nErr} 個、警告 ${nWarn} 個`);
      } else {
        print(`エラー ${nErr} 個`);
      }
    }
  }
  if (nErr > 0) {
    return 1;
  }
  return 0;
}

function cmdShow(a: string[], reg: FxReg): i32 {
  const c = parseCli(a, 1);
  if (c.bad != "") {
    return usageError(c.bad);
  }
  if (c.pos.length < 1 || c.pos.length > 2 || c.hasFile || c.dryRun || c.json) {
    return usageError("show <project.mzc> [cache] [--width N] と書きます");
  }
  const path = c.pos[0].clone();
  let cache = "";
  if (c.pos.length == 2) {
    cache = c.pos[1].clone();
  } else {
    cache = autoCache(path);
  }
  const text = readFile(path);
  if (text == null) {
    return cannotRead(path, false);
  }
  let diags: Diag[] = [];
  const p = parseProjectReg(text, probesFor(path, text, cache), mut diags, reg);
  // 誤りは標準エラーに出し、図は分かる範囲で描く
  printDiags(path, diags, true);
  print(baseName(path));
  print(showTextReg(p, c.width, reg));
  if (errorCount(diags) > 0) {
    return 1;
  }
  return 0;
}

function cmdSchema(a: string[], reg: FxReg): i32 {
  const c = parseCli(a, 1);
  if (c.bad != "") {
    return usageError(c.bad);
  }
  if (c.pos.length > 0 || c.hasFile || c.dryRun) {
    return usageError("schema [--json] と書きます");
  }
  if (c.json) {
    print(schemaJsonReg(reg));
  } else {
    print(schemaTextReg(reg));
  }
  return 0;
}

// ---- op ----

function opWordsText(words: string[]): string {
  let s = "";
  for (let i: usize = 0; i < words.length; i++) {
    if (i > 0) {
      s = s + " ";
    }
    s = s + words[i];
  }
  return s;
}

function changesJson(chs: Change[]): string {
  let s = "[";
  for (let i: usize = 0; i < chs.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + `{"kind":${jsonStr(chs[i].kind)},"line":${chs[i].line},"before":${jsonStr(chs[i].before)},"after":${jsonStr(chs[i].after)}}`;
  }
  return s + "]";
}

function movedJson(ms: Moved[]): string {
  let s = "[";
  for (let i: usize = 0; i < ms.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    let id = "null";
    if (ms[i].id != "") {
      id = jsonStr(ms[i].id);
    }
    s = s + `{"id":${id},"line":${ms[i].line},"before":{"start":${jsonNum(ms[i].beforeStart)},"end":${jsonNum(ms[i].beforeEnd)}},"after":{"start":${jsonNum(ms[i].afterStart)},"end":${jsonNum(ms[i].afterEnd)}}}`;
  }
  return s + "]";
}

function resultJson(r: OpResult): string {
  return `{"op":${jsonStr(r.op)},"ok":${r.ok},"code":${jsonStr(r.code)},"desc":${jsonStr(r.desc)},"error":${jsonStr(r.error)},"hint":${jsonStr(r.hint)},"suggest":${jsonStr(r.suggest)},"newId":${jsonStr(r.newId)},"changes":${changesJson(r.changes)},"moved":${movedJson(r.moved)},"newDiagnostics":${diagsJson(r.newDiagnostics)}}`;
}

function batchJson(b: BatchResult, saved: bool): string {
  let s = `{"ok":${b.ok},"saved":${saved},"results":[`;
  for (let i: usize = 0; i < b.results.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + resultJson(b.results[i]);
  }
  return s + `],"diagnostics":${diagsJson(b.diags)}}`;
}

// 操作のファイル（"-" なら標準入力）の行。
function readOpLines(file: string, ok: mut bool): string[] {
  let out: string[] = [];
  ok = true;
  if (file == "-") {
    while (true) {
      const l = readLine();
      if (l == null) {
        break;
      }
      out.push(l.clone());
    }
    return out;
  }
  const bytes = readFile(file);
  if (bytes == null) {
    ok = false;
    return out;
  }
  return splitLines(bytes);
}

function hasCrlf(text: u8[]): bool {
  for (let i: usize = 0; i + 1 < text.length; i++) {
    if (text[i] == 13 && text[i + 1] == 10) {
      return true;
    }
  }
  return false;
}

// 行を書く。元のファイルが \r\n なら \r\n で書く。
function saveLines(path: string, lines: string[], crlf: bool): bool {
  let out: u8[] = [];
  for (const l of lines) {
    for (const b of l) {
      out.push(b);
    }
    if (crlf) {
      out.push(13);
    }
    out.push(10);
  }
  return writeFile(path, out);
}

// cache のフォルダらしい語か（/ か \ を含むか、.cache で終わる）。操作の名前と取り違えないため。
function looksLikePath(s: string): bool {
  for (const ch of s) {
    if (ch == 47 || ch == 92) {
      return true;
    }
  }
  return s.length > 6 && sub(s, s.length - 6, s.length) == ".cache";
}

function hasSpace(s: string): bool {
  for (const ch of s) {
    if (ch == 32 || ch == 9) {
      return true;
    }
  }
  return false;
}

function cmdOp(a: string[], reg: FxReg): i32 {
  const c = parseCli(a, 1);
  if (c.bad != "") {
    return usageError(c.bad);
  }
  if (c.pos.length < 1) {
    return usageError("op <project.mzc> [cache] <操作...> か op <project.mzc> [cache] --file <ops.txt> と書きます");
  }
  const path = c.pos[0].clone();
  // 2 番目の位置の引数は、操作の名前でなければ cache
  let cache = "";
  let k: usize = 1;
  if (c.pos.length >= 2 && !isOpName(c.pos[1]) && (c.hasFile || c.pos.length >= 3 || looksLikePath(c.pos[1]))) {
    cache = c.pos[1].clone();
    k = 2;
  } else {
    cache = autoCache(path);
  }
  let ops: string[][] = [];
  if (c.hasFile) {
    if (k < c.pos.length) {
      return usageError("--file を使うときは、コマンドラインに操作を書きません");
    }
    let readOk = true;
    const opLines = readOpLines(c.file, mut readOk);
    if (!readOk) {
      return cannotRead(c.file, c.json);
    }
    // 空の行と # で始まる行は飛ばす
    for (const l of opLines) {
      const words = splitArgs(l);
      if (words.length == 0 || (words[0].length > 0 && words[0][0] == 35)) {
        continue;
      }
      ops.push(words);
    }
    if (ops.length == 0) {
      return usageError(`'${c.file}' に操作がありません（1 行に 1 つの操作を書きます）`);
    }
  } else {
    if (k >= c.pos.length) {
      return usageError("操作を書きます（例: mozcut op demo.mzc move clip_b 5.5）");
    }
    let words: string[] = [];
    for (let i = k; i < c.pos.length; i++) {
      words.push(c.pos[i].clone());
    }
    // 1 つの引数にまとめて書いた操作（op p.mzc "move pip 2"）は分ける
    if (words.length == 1 && hasSpace(words[0])) {
      words = splitArgs(words[0]);
    }
    ops.push(words);
  }

  const text = readFile(path);
  if (text == null) {
    return cannotRead(path, c.json);
  }
  const crlf = hasCrlf(text);
  const lines = splitLines(text);
  const b = runOpsReg(lines, probesFor(path, text, cache), ops, reg);

  if (!b.ok) {
    if (c.json) {
      print(batchJson(b, false));
    }
    // 失敗した操作は最後の結果
    const n = b.results.length;
    if (n > 0) {
      let who = "";
      if (ops.length > 1) {
        who = `${n} 番目の操作（${opWordsText(ops[n - 1])}）: `;
      }
      eprint(`${who}エラー[${b.results[n - 1].code}]: ${b.results[n - 1].error}`);
      if (b.results[n - 1].hint != "") {
        eprint(`  ヒント: ${b.results[n - 1].hint}`);
      }
    }
    eprint("何も書き換えていません");
    return 1;
  }

  let saved = false;
  if (!c.dryRun) {
    if (!saveLines(path, b.lines, crlf)) {
      if (c.json) {
        const msg = `'${path}' に書けません`;
        print(`{"ok":false,"error":${jsonStr(msg)}}`);
      }
      eprint(`mozcut: '${path}' に書けません`);
      return 1;
    }
    saved = true;
  }

  if (c.json) {
    print(batchJson(b, saved));
    return 0;
  }
  for (const r of b.results) {
    print(r.desc);
    for (const ch of r.changes) {
      if (ch.kind != "insert") {
        print(`  - ${ch.line}: ${ch.before}`);
      }
      print(`  + ${ch.line}: ${ch.after}`);
    }
  }
  const nErr = errorCount(b.diags);
  if (nErr > 0) {
    print(`（このファイルには元からの誤りが ${nErr} 個あります。mozcut check で確かめられます）`);
  }
  if (saved) {
    print(`保存しました（${path}）`);
  } else {
    print("保存していません（--dry-run）");
  }
  return 0;
}

// ---- sources / plan / render / preview ----

// quiet なら誤りを表示せず ok も立てたままにする（sources は長さが分かる前に呼ばれるため）。
function load(path: string, cache: string, quiet: bool, ok: mut bool, reg: FxReg): Project {
  let err: Diag[] = [];
  const text = readFile(path);
  if (text == null) {
    eprint(`mozcut: '${path}' を読めません`);
    let empty: u8[] = [];
    let none: Probe[] = [];
    ok = false;
    return parseProjectReg(empty, none, mut err, reg);
  }
  const probes = probesFor(path, text, cache);
  const p = parseProjectReg(text, probes, mut err, reg);
  if (quiet) {
    ok = true;
    return p;
  }
  printDiags(path, err, true);
  ok = errorCount(err) == 0;
  return p;
}

function cmdSources(p: Project): i32 {
  let seen: string[] = [];
  for (const c of p.clips) {
    if (c.src == "") {
      continue;
    }
    let dup = false;
    for (const s of seen) {
      if (s == c.src) {
        dup = true;
      }
    }
    if (!dup) {
      seen.push(c.src.clone());
      print(`src\t${c.src}`);
    }
  }
  return 0;
}

function even(v: i32): i32 {
  return v + (v & 1);
}

// ffmpeg の scale フィルタ。video は偶数の大きさにする（YUV 4:2:0 のため）。
function scaleFilter(c: Clip, p: Project, isVideo: bool): string {
  let tw = c.w;
  let th = c.h;
  if (isVideo) {
    tw = even(tw);
    th = even(th);
  }
  let colors = "";
  let auto = "-1";
  if (isVideo) {
    colors = ":out_color_matrix=bt709:out_range=tv";
    auto = "-2";
  }
  if (tw <= 0 && th <= 0) {
    if (!isVideo) {
      return "-";
    }
    tw = p.width;
    th = p.height;
  } else if (tw <= 0) {
    return `scale=${auto}:${th}${colors}`;
  } else if (th <= 0) {
    return `scale=${tw}:${auto}${colors}`;
  }
  if (c.fit == FIT_COVER) {
    return `scale=${tw}:${th}:force_original_aspect_ratio=increase${colors},crop=${tw}:${th}`;
  }
  if (c.fit == FIT_STRETCH) {
    return `scale=${tw}:${th}${colors}`;
  }
  let div = "";
  if (isVideo) {
    div = ":force_divisible_by=2";
  }
  return `scale=${tw}:${th}:force_original_aspect_ratio=decrease${div}${colors}`;
}

function cmdPlan(p: Project, cache: string): i32 {
  const fpsText = `${p.fpsNum}/${p.fpsDen}`;
  const frame = (p.fpsDen as f64) / (p.fpsNum as f64);
  for (let i: usize = 0; i < p.clips.length; i++) {
    const kind = p.clips[i].kind;
    const src = p.clips[i].src.clone();
    let inPt = p.clips[i].inPt;
    // 最後のコマまで確実に出るよう、2 コマぶん長めに展開する
    let vdur = p.clips[i].dur + 2 * frame;
    if (p.clips[i].remapLo != UNSET) {
      // timeremap: 見せる素材の時刻の範囲を展開する
      inPt = p.clips[i].remapLo;
      vdur = p.clips[i].remapHi - p.clips[i].remapLo + 2 * frame;
    }
    print(`clip\t${i}\t${p.clips[i].at}\t${p.clips[i].at + p.clips[i].dur}`);
    if (kind == KIND_VIDEO) {
      print(`video\t${i}\t${src}\t${inPt}\t${vdur}\t${fpsText}\t${scaleFilter(p.clips[i], p, true)}\t${videoCachePath(cache, i)}`);
    } else if (kind == KIND_IMAGE) {
      print(`image\t${i}\t${src}\t${scaleFilter(p.clips[i], p, false)}\t${imageCachePath(cache, i)}`);
    }
    if (clipHasSound(p.clips[i])) {
      print(`audio\t${i}\t${src}\t${p.clips[i].inPt}\t${clipSrcDur(p.clips[i])}\t${p.rate}\t${audioCachePath(cache, i)}`);
    }
  }
  print(`encode\t${cache}/out.y4m\t${cache}/out.pcm\t${p.rate}\t${p.crf}\t${p.preset}\t${p.output}`);
  return 0;
}

function y4mHeader(p: Project): string {
  return `YUV4MPEG2 W${p.width} H${p.height} F${p.fpsNum}:${p.fpsDen} Ip A1:1 C420jpeg\n`;
}

function cmdRender(p: Project, font: Font, cache: string, fromSec: f64, toSec: f64, reg: FxReg): i32 {
  const media = loadMedia(p, cache);
  const missing = checkMedia(p, media, cache, fromSec, toSec);
  if (missing.length > 0) {
    for (const e of missing) {
      eprint(e);
    }
    return 1;
  }
  for (const w of gradeLutWarnings(p, cache, fromSec, toSec)) {
    eprint(`mozcut: 警告: ${w}`);
  }
  const outVideo = `${cache}/out.y4m`;
  const outAudio = `${cache}/out.pcm`;
  let header: u8[] = [];
  for (const b of y4mHeader(p)) {
    header.push(b);
  }
  if (!writeFile(outVideo, header)) {
    eprint(`mozcut: '${outVideo}' に書けません`);
    return 1;
  }
  const n = (p.width * p.height) as u32;
  let canvas = new Buffer<vec4<f32>>(n);
  let yuv = new Buffer<u8>(n * 3 / 2);
  let frameBytes: u8[] = [];
  const fps = (p.fpsNum as f64) / (p.fpsDen as f64);
  const total = frameCount(p);
  let f0 = Math.ceil(fromSec * fps - 0.000001) as i64;
  let f1 = Math.ceil(toSec * fps - 0.000001) as i64;
  f0 = Math.max(f0, 0 as i64);
  f1 = Math.min(f1, total);
  // 文字の画像などをフレームをまたいで使い回す
  let rc = newRenderCache();
  const t0 = clock();
  let lastReport = t0;
  for (let f = f0; f < f1; f++) {
    renderFrameReg(p, media, cache, frameTime(p, f), mut canvas, font, mut rc, reg);
    canvasToYuv(canvas, mut yuv, p.width, p.height);
    frameBytes.clear();
    frameBytes.push(70);
    frameBytes.push(82);
    frameBytes.push(65);
    frameBytes.push(77);
    frameBytes.push(69);
    frameBytes.push(10);
    for (let j: u32 = 0; j < yuv.length; j++) {
      frameBytes.push(yuv[j]);
    }
    if (!appendFile(outVideo, frameBytes)) {
      eprint(`mozcut: '${outVideo}' に書けません`);
      return 1;
    }
    const now = clock();
    if (now - lastReport > 1.0 || f + 1 == f1) {
      lastReport = now;
      const done = f + 1 - f0;
      const speed = (done as f64) / Math.max(now - t0, 0.001);
      eprint(`映像 ${done}/${f1 - f0} コマ（毎秒 ${Math.floor(speed * 10) / 10} コマ）`);
    }
  }
  const startT = (f0 as f64) / fps;
  const endT = (f1 as f64) / fps;
  if (!mixAudio(p, cache, outAudio, startT, endT)) {
    eprint(`mozcut: '${outAudio}' に書けません`);
    return 1;
  }
  eprint(`音を書きました（${fmtTime(endT - startT)}）`);
  return 0;
}

// ---- 書き出し（FFmpeg の組み込みで MP4 を直接書く） ----

// render --out: FFmpeg の組み込みで MP4 を直接書く（encode.um。プロジェクトのままの大きさ・コマの速さ・音）。
function cmdEncode(p: Project, cache: string, fromSec: f64, toSec: f64, out: string, reg: FxReg): i32 {
  if (!ffEnabled()) {
    eprint("mozcut: このエンジンは FFmpeg の組み込みなしでビルドしたので、--out で動画を書けません（node tools/mozcut.mjs render を使います）");
    return 1;
  }
  const o = encDefaults(p, out, fromSec, toSec);
  let j = encOpen(p, cache, o);
  if (!j.ok) {
    eprint(`mozcut: ${j.err}`);
    encFinish(mut j);
    return 1;
  }
  eprint(`符号器: 映像 ${j.vEnc}（${Math.floor((encBitRate(p) as f64) / 100000.0) / 10} Mbps）、音 ${j.aEnc}`);
  let lastReport = j.t0;
  while (!j.done) {
    encStepReg(mut j, p, clock() + 1.0, reg);
    const now = clock();
    if (now - lastReport > 1.0 || j.done) {
      lastReport = now;
      const done = j.f - j.f0;
      const speed = (done as f64) / Math.max(now - j.t0, 0.001);
      eprint(`映像 ${done}/${j.f1 - j.f0} コマ（毎秒 ${Math.floor(speed * 10) / 10} コマ）`);
    }
  }
  encFinish(mut j);
  if (!j.ok) {
    eprint(`mozcut: ${j.err}`);
    return 1;
  }
  const fps = (p.fpsNum as f64) / (p.fpsDen as f64);
  eprint(`${out} に書き出しました（${fmtTime(((j.f1 - j.f0) as f64) / fps)}、映像 ${j.f1 - j.f0} コマ、音 ${j.aLast - j.aFirst} 標本）`);
  return 0;
}

function cmdPreview(p: Project, font: Font, cache: string, t: f64, out: string, reg: FxReg): i32 {
  const media = loadMedia(p, cache);
  const missing = checkMedia(p, media, cache, t, t);
  if (missing.length > 0) {
    for (const e of missing) {
      eprint(e);
    }
    return 1;
  }
  for (const w of gradeLutWarnings(p, cache, t, t)) {
    eprint(`mozcut: 警告: ${w}`);
  }
  let canvas = new Buffer<vec4<f32>>((p.width * p.height) as u32);
  let rc = newRenderCache();
  renderFrameReg(p, media, cache, t, mut canvas, font, mut rc, reg);
  if (!writeBmp(out, canvas, p.width, p.height)) {
    eprint(`mozcut: '${out}' に書けません`);
    return 1;
  }
  eprint(`${out} を書きました（${fmtTime(t)}）`);
  return 0;
}

function timeArgOr(a: string[], k: usize, fallback: f64): f64 {
  if (k >= a.length) {
    return fallback;
  }
  const v = parseTime(a[k]);
  if (isNan(v)) {
    eprint(`mozcut: '${a[k]}' は時刻として読めません（3.5 や 1:02.5 のように書きます）`);
    return -1;
  }
  return v;
}

function cmdPipeline(all: string[], reg: FxReg): i32 {
  // render の --out <file> を抜き出す（残りは位置で読む）
  let a: string[] = [];
  let outFile = "";
  let i: usize = 0;
  while (i < all.length) {
    if (all[i] == "--out" && all[0] == "render") {
      if (i + 1 >= all.length) {
        return usageError("--out のあとに書き出すファイルを書きます");
      }
      outFile = all[i + 1].clone();
      i += 2;
      continue;
    }
    a.push(all[i].clone());
    i++;
  }
  if (a.length < 2) {
    return usage();
  }
  const cmd = a[0].clone();
  const path = a[1].clone();
  let cache = "";
  if (a.length >= 3) {
    cache = a[2].clone();
  }
  const needsCache = cmd == "plan" || cmd == "render" || cmd == "preview";
  if (needsCache && cache == "") {
    return usageError(`${cmd} には cache のフォルダを渡します`);
  }
  let ok = false;
  const p = load(path, cache, cmd == "sources", mut ok, reg);
  if (!ok) {
    return 1;
  }
  switch (cmd) {
    case "sources":
      return cmdSources(p);
    case "plan":
      return cmdPlan(p, cache);
    case "render": {
      const from = timeArgOr(a, 3, 0);
      const to = timeArgOr(a, 4, p.duration);
      if (from < 0 || to < 0) {
        return 2;
      }
      if (to <= from || from >= p.duration) {
        eprint(`mozcut: 範囲が空です（${fmtTime(from)}〜${fmtTime(to)}。全体の長さは ${fmtTime(p.duration)}）`);
        return 2;
      }
      // フォントはプロジェクトを読んだ後に 1 回だけ読む（毎コマ読むと遅い）
      const font = projectFont(p.fontPath, p.fontIndex);
      if (outFile != "") {
        return cmdEncode(p, cache, from, to, outFile, reg);
      }
      return cmdRender(p, font, cache, from, to, reg);
    }
    case "preview": {
      if (a.length < 5) {
        return usageError("preview <project.mzc> <cache> <time> <out.bmp> と書きます");
      }
      const t = timeArgOr(a, 3, 0);
      if (t < 0) {
        return 2;
      }
      if (t >= p.duration) {
        eprint(`mozcut: 警告: ${fmtTime(t)} は全体の長さ（${fmtTime(p.duration)}）より後ろです（背景だけが描かれます）`);
      }
      const font = projectFont(p.fontPath, p.fontIndex);
      return cmdPreview(p, font, cache, t, a[4], reg);
    }
  }
  return usage();
}

// このエンジンでできること。tools/mozcut.mjs が、素材を事前に展開するかを決めるのに使う。
//   ffmpeg\t1\t<FFmpeg のライブラリの版とライセンス>   素材をその場で展開できる（展開のキャッシュは要らない）
//   ffmpeg\t0                                         FFmpeg なしでビルドした（展開したキャッシュと probe.txt を使う）
function cmdCaps(): i32 {
  if (ffEnabled()) {
    print(`ffmpeg\t1\t${ffVersion()}`);
  } else {
    print("ffmpeg\t0");
  }
  return 0;
}

export function main(): i32 {
  // CPU と GPU を選べる計算は、GPU が使えるかぎり GPU で行う
  gpu.prefer(true);
  const raw = args();
  let a: string[] = [];
  let pluginExtra: string[] = [];
  for (let i: usize = 0; i < raw.length; i++) {
    if (raw[i] == "--plugins" && i + 1 < raw.length) {
      pluginExtra.push(raw[i + 1].clone());
      i++;
    } else {
      a.push(raw[i].clone());
    }
  }
  if (a.length < 1) {
    return usage();
  }
  const cmd = a[0].clone();
  if (cmd == "help" || cmd == "--help" || cmd == "-h") {
    for (const l of usageLines()) {
      print(l);
    }
    return 0;
  }
  if (cmd == "caps") {
    return cmdCaps();
  }
  const reg = fxRegDiscover(pluginExtra);
  switch (cmd) {
    case "check":
      return cmdCheck(a, reg);
    case "show":
      return cmdShow(a, reg);
    case "op":
      return cmdOp(a, reg);
    case "schema":
      return cmdSchema(a, reg);
    case "motion":
      return cmdMotion(a);
    case "sources":
    case "plan":
    case "render":
    case "preview":
      return cmdPipeline(a, reg);
  }
  return usageError(`'${cmd}' というコマンドはありません`);
}
