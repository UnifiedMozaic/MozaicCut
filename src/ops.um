// 操作（move / trim / split / delete / cut / set / unset / renamekey / add / rename）。
// ファイル（.mzc）・コマンド（mozcut op）・編集画面・AI 用のツールは、みなここを通して行を書き換える。
// 操作は行の文字列を書き換えるだけで、注釈やほかの値、行の並びはそのまま残す。
import { sub, parseNum, parseTime, isNan, textNearest } from "./text.um";
import { Project, Clip, Diag, Probe, parseProject, findClip, hintSuggest, KIND_VIDEO, KIND_IMAGE, KIND_TEXT, KIND_COLOR, KIND_AUDIO } from "./project.um";
import { hasKey, setKey, removeKey, renameKey, secText, keyValue, keyColumn, hasPositional, positionalValue, setPositional, hasFlag, addFlag, removeFlag, lineQuote } from "./lineedit.um";

// 行の変更。kind は "edit"（書き換え）/ "insert"（足した行）/ "comment"（注釈にした行）。line は変更後の行番号（1 から）。
export struct Change {
  kind: string;
  line: i32;
  before: string;
  after: string;
}

// 操作の結果、時刻が変わったほかのクリップ（操作で指したクリップと、足した行は含まない）。
// line は操作の後の行番号。時刻は秒。
export struct Moved {
  id: string;
  line: i32;
  beforeStart: f64;
  beforeEnd: f64;
  afterStart: f64;
  afterEnd: f64;
}

// 1 つの操作の結果。失敗なら code・error・hint（日本語）。desc は人向けの 1 文。newId は add / split / rename で付いた ID。
// suggest は hint で推した候補（キーや ID）。newDiagnostics は、誤りが増えたため止めたときのその診断（行は元のファイルの番号。
// 足すはずだった行なら 0）。moved は、時刻が変わったほかのクリップ。
export struct OpResult {
  ok: bool;
  op: string;
  code: string;
  desc: string;
  error: string;
  hint: string;
  newId: string;
  changes: Change[];
  suggest: string;
  newDiagnostics: Diag[];
  moved: Moved[];
}

// まとめて適用した結果。失敗なら ok=false で lines は元のまま。diags は lines を読んだときの診断。
// 失敗したときは、失敗した操作より前の結果も ok=false・code "not-applied"・changes は空にする（何も適用していないため）。
export struct BatchResult {
  ok: bool;
  results: OpResult[];
  lines: string[];
  diags: Diag[];
}

// ---- 操作の一覧（schema に載せる） ----

export struct OpInfo {
  name: string;
  usage: string;
  doc: string;
  example: string;
}

export function opInfos(): OpInfo[] {
  return [
    { name: "move", usage: "move <クリップ> <時刻か参照>", doc: "開始を動かす（at= を書き換える）。参照で書けば参照のまま", example: "move clip_b 5.5 / move pip clip_a.start+1 / move title after:intro" },
    { name: "trim", usage: "trim <クリップ> start|end <時刻>", doc: "タイムライン上の始まり・終わりの時刻を決める（素材の in / out / dur も合わせる）。時刻は素材の時刻ではなくタイムライン上の時刻", example: "trim clip_a end 4.5 / trim bgm start 3" },
    { name: "split", usage: "split <クリップ> <時刻>", doc: "タイムライン上の時刻で 2 つに分ける。後半は次の行で、ID は <id>_2", example: "split clip_a 3.5" },
    { name: "delete", usage: "delete <クリップ> [fix-refs]", doc: "行を # で注釈にする。at= のない後ろのクリップは前へ詰まる。ほかから参照されていたら止める（fix-refs なら参照を今の秒に書き換えてから消す）", example: "delete title / delete clip_a fix-refs" },
    { name: "cut", usage: "cut <開始> <終わり>", doc: "タイムライン上の範囲を全トラックから切り取り、後ろを詰める（リップル削除）。範囲の中のクリップは消し、かかるものは短くし、またぐ映像・音は分ける", example: "cut 0 3 / cut 1:00 1:05.5" },
    { name: "set", usage: "set <クリップ> key=value ...", doc: "値を決める（効果のキーも）。text= / src= / color= は位置で渡す値を変える。映像・音に dur= を書くと out= を消す（out= なら dur= を消す）。text= の \\n は改行", example: "set clip_b sat=1.2 blur=3 / set title text=\"1 行目\\n2 行目\"" },
    { name: "unset", usage: "unset <クリップ> key ...", doc: "キーを消す", example: "unset clip_b blur fadeout" },
    { name: "renamekey", usage: "renamekey <クリップ> <古いキー> <新しいキー>", doc: "キーの名前だけを同じ場所で変える（効果の掛ける順を保つ。書き間違いの直しに）", example: "renamekey clip_b vignete vignette" },
    { name: "add", usage: "add <種類> [<素材 / 文字 / 色>] key=value ... [after <クリップ>]", doc: "行を足す（既定はファイルの最後）。id がなければ <種類><n> を付け、newId に返す", example: "add text \"Hello\" at=2 dur=3 / add video media/a.mp4 in=1 out=4 after intro" },
    { name: "rename", usage: "rename <クリップ> <新しい ID>", doc: "ID を変える（at= の参照も書き換える）", example: "rename clip_a opening" },
  ];
}

// ---- 引数の分け方 ----

function opIsSp(c: u8): bool {
  return c == 32 || c == 9 || c == 13 || c == 10;
}

// 1 行を空白で分ける。"..." は 1 つの引数にまとめ（引用符は外す）、中の \" は "、\\ は \ にする。
// ほかの \x は \ を残す（"C:\My Videos\a.mp4" のような Windows のパスをそのまま渡せるように）。
// key="a b" のように語の途中から始まる引用も扱う。
export function splitArgs(line: string): string[] {
  let out: string[] = [];
  let i: usize = 0;
  const n = line.length;
  while (i < n) {
    if (opIsSp(line[i])) {
      i++;
      continue;
    }
    let bytes: u8[] = [];
    while (i < n && !opIsSp(line[i])) {
      if (line[i] == 34) {
        i++;
        while (i < n && line[i] != 34) {
          if (line[i] == 92 && i + 1 < n && (line[i + 1] == 34 || line[i + 1] == 92)) {
            bytes.push(line[i + 1]);
            i += 2;
            continue;
          }
          bytes.push(line[i]);
          i++;
        }
        if (i < n) {
          i++;
        }
        continue;
      }
      bytes.push(line[i]);
      i++;
    }
    out.push(stringFromBytes(bytes));
  }
  return out;
}

// ---- 小さな道具 ----

function opCopyLines(lines: string[]): string[] {
  let out: string[] = [];
  for (const l of lines) {
    out.push(l.clone());
  }
  return out;
}

function opParse(lines: string[], probes: Probe[], diags: mut Diag[]): Project {
  let bytes: u8[] = [];
  for (const l of lines) {
    for (const b of l) {
      bytes.push(b);
    }
    bytes.push(10);
  }
  return parseProject(bytes, probes, mut diags);
}

function opNewResult(op: string): OpResult {
  return { ok: true, op: op.clone(), code: "", desc: "", error: "", hint: "", newId: "", changes: [], suggest: "", newDiagnostics: [], moved: [] };
}

function opFail(r: mut OpResult, code: string, error: string, hint: string): void {
  r.ok = false;
  r.newId = "";
  r.code = code.clone();
  r.error = error.clone();
  r.hint = hint.clone();
  r.suggest = hintSuggest(hint);
}

// 操作の名前の並び（unknown-op の候補）。
const OP_NAMES: string = "move / trim / split / delete / cut / set / unset / renamekey / add / rename";

function opNameList(): string[] {
  return ["move", "trim", "split", "delete", "cut", "set", "unset", "renamekey", "add", "rename"];
}

// ASCII の大文字を小文字にする。
export function opLower(s: string): string {
  let b: u8[] = [];
  for (const c of s) {
    if (c >= 65 && c <= 90) {
      b.push(c + 32);
    } else {
      b.push(c);
    }
  }
  return stringFromBytes(b);
}

// 操作の名前か（大文字・小文字は区別しない）。
export function isOpName(s: string): bool {
  const l = opLower(s);
  for (const n of opNameList()) {
    if (n == l) {
      return true;
    }
  }
  return false;
}

function opKindWord(kind: i32): string {
  switch (kind) {
    case KIND_VIDEO:
      return "video";
    case KIND_IMAGE:
      return "image";
    case KIND_TEXT:
      return "text";
    case KIND_COLOR:
      return "color";
    case KIND_AUDIO:
      return "audio";
  }
  return "clip";
}

function opKindOf(word: string): i32 {
  switch (word) {
    case "video":
      return KIND_VIDEO;
    case "image":
      return KIND_IMAGE;
    case "text":
      return KIND_TEXT;
    case "color":
      return KIND_COLOR;
    case "audio":
      return KIND_AUDIO;
  }
  return 0;
}

function opIsMedia(kind: i32): bool {
  return kind == KIND_VIDEO || kind == KIND_AUDIO;
}

// 人向けのクリップの呼び名。ID があれば ID、なければ「7 行目の video」。
function opLabel(c: Clip): string {
  if (c.id != "") {
    return c.id.clone();
  }
  return `${c.line} 行目の ${opKindWord(c.kind)}`;
}

function opSec(v: f64): string {
  return `${secText(v)} 秒`;
}

function opFrame(p: Project): f64 {
  return (p.fpsDen as f64) / (p.fpsNum as f64);
}

function opIsIdStart(c: u8): bool {
  return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

// ID の形（英字・数字・_・-、先頭は英字か _）。
function opValidId(s: string): bool {
  if (s.length == 0 || !opIsIdStart(s[0])) {
    return false;
  }
  for (let i: usize = 1; i < s.length; i++) {
    const c = s[i];
    if (!(opIsIdStart(c) || (c >= 48 && c <= 57) || c == 45)) {
      return false;
    }
  }
  return true;
}

// キーの形（英字・数字・_・.・-、先頭は英字か _）。# や改行、引用符を含むキーは行を壊すので弾く。
function opValidKey(s: string): bool {
  if (s.length == 0 || !opIsIdStart(s[0])) {
    return false;
  }
  for (let i: usize = 1; i < s.length; i++) {
    const c = s[i];
    if (!(opIsIdStart(c) || (c >= 48 && c <= 57) || c == 45 || c == 46)) {
      return false;
    }
  }
  return true;
}

function opHasId(p: Project, id: string): bool {
  for (const c of p.clips) {
    if (c.id == id) {
      return true;
    }
  }
  return false;
}

// 見つからないクリップの hint。近い ID があれば先に「'x' のことですか？」、続けてある ID を並べる（多ければ打ち切って数を書く）。
function opClipHint(p: Project, ref: string): string {
  let all: string[] = [];
  for (const c of p.clips) {
    if (c.id != "") {
      all.push(c.id.clone());
    }
  }
  if (p.clips.length == 0) {
    return "クリップがまだありません。add で足します（例: add text \"Hello\" dur=3）";
  }
  let ids = "";
  const shown = Math.min(all.length, 12);
  for (let i: usize = 0; i < shown; i++) {
    if (i > 0) {
      ids = ids + ", ";
    }
    ids = ids + all[i];
  }
  if (all.length > shown) {
    ids = ids + ` …ほか ${all.length - shown} 個（show で一覧）`;
  }
  let h = "クリップは ID（intro）、#番号（#3。0 から数える）、@行番号（@7）で指します";
  if (all.length > 0) {
    h = h + `。ある ID: ${ids}`;
  } else {
    h = h + `（いまは ${p.clips.length} 個のクリップ。#0〜#${(p.clips.length as i32) - 1}）`;
  }
  const near = textNearest(ref, all);
  if (near != "") {
    h = `'${near}' のことですか？ ${h}`;
  }
  return h;
}

function opFindClip(p: Project, ref: string, r: mut OpResult): i32 {
  const i = findClip(p, ref);
  if (i < 0) {
    opFail(mut r, "unknown-clip", `'${ref}' というクリップはありません`, opClipHint(p, ref));
  }
  return i;
}

function opFindProbe(probes: Probe[], path: string): i32 {
  for (let i: usize = 0; i < probes.length; i++) {
    if (probes[i].path == path) {
      return i as i32;
    }
  }
  return -1;
}

// ---- at= の参照（intro.end、intro.start+1.5、intro.end-0.5、after:intro） ----

struct OpRef {
  ok: bool;
  id: string;
  after: bool;
  isEnd: bool;
  // id の後ろ（".end+1" など）。after: のときは ""。
  rest: string;
  off: f64;
}

function opNoRef(): OpRef {
  return { ok: false, id: "", after: false, isEnd: false, rest: "", off: 0 };
}

function opParseRef(v: string): OpRef {
  const n = v.length;
  if (n > 6 && sub(v, 0, 6) == "after:") {
    const id = sub(v, 6, n);
    if (!opValidId(id)) {
      return opNoRef();
    }
    return { ok: true, id, after: true, isEnd: true, rest: "", off: 0 };
  }
  let dot: usize = 0;
  let found = false;
  for (let i: usize = 0; i < n; i++) {
    if (v[i] == 46) {
      dot = i;
      found = true;
      break;
    }
  }
  if (!found) {
    return opNoRef();
  }
  const id = sub(v, 0, dot);
  if (!opValidId(id)) {
    return opNoRef();
  }
  let isEnd = false;
  let k = dot + 1;
  if (k + 3 <= n && sub(v, k, k + 3) == "end") {
    isEnd = true;
    k += 3;
  } else if (k + 5 <= n && sub(v, k, k + 5) == "start") {
    k += 5;
  } else {
    return opNoRef();
  }
  let off: f64 = 0;
  if (k < n) {
    if (v[k] != 43 && v[k] != 45) {
      return opNoRef();
    }
    const t = parseTime(sub(v, k + 1, n));
    if (isNan(t)) {
      return opNoRef();
    }
    off = t;
    if (v[k] == 45) {
      off = -t;
    }
  }
  return { ok: true, id, after: false, isEnd, rest: sub(v, dot, n), off };
}

function opRefText(r: OpRef, id: string): string {
  if (r.after) {
    return "after:" + id;
  }
  return id + r.rest;
}

// 参照の先の時刻（いまの配置で）。
function opRefTime(p: Project, r: OpRef): f64 {
  for (const c of p.clips) {
    if (c.id == r.id) {
      let t = c.at + r.off;
      if (r.isEnd) {
        t = t + c.dur;
      }
      return t;
    }
  }
  return 0;
}

// 行の at= を newAt にするときの値。at= が参照なら参照のまま、オフセットだけを直す（参照のつながりを保つ）。
function opAtValue(line: string, oldAt: f64, newAt: f64): string {
  if (hasKey(line, "at")) {
    const ref = opParseRef(keyValue(line, "at"));
    if (ref.ok) {
      const off = ref.off + (newAt - oldAt);
      if (ref.after && Math.abs(off) < 0.0005) {
        return "after:" + ref.id;
      }
      let base = ref.id + ".start";
      if (ref.isEnd) {
        base = ref.id + ".end";
      }
      if (Math.abs(off) < 0.0005) {
        return base;
      }
      if (off > 0) {
        return base + "+" + secText(off);
      }
      return base + "-" + secText(-off);
    }
  }
  return secText(newAt);
}

// ほかの行の at= で oldId を指すものを newId にする。onlyEnd なら終わりを指すもの（.end / after:）だけ。
// skip の行（0 から）は触らない。書き換えた数を返す。
function opRewriteRefs(lines: mut string[], r: mut OpResult, oldId: string, newId: string, onlyEnd: bool, skip: usize): i32 {
  let count = 0;
  for (let k: usize = 0; k < lines.length; k++) {
    if (k == skip || !hasKey(lines[k], "at")) {
      continue;
    }
    const v = keyValue(lines[k], "at");
    const ref = opParseRef(v);
    if (!ref.ok || ref.id != oldId || (onlyEnd && !ref.isEnd)) {
      continue;
    }
    const nl = setKey(lines[k], "at", opRefText(ref, newId));
    opEdit(mut lines, mut r, k, nl);
    count++;
  }
  return count;
}

// ---- 行の書き換え（変更を記録する） ----

function opEdit(lines: mut string[], r: mut OpResult, k: usize, text: string): void {
  if (lines[k] == text) {
    return;
  }
  const lineNo = (k as i32) + 1;
  for (let j: usize = 0; j < r.changes.length; j++) {
    if (r.changes[j].line == lineNo && r.changes[j].kind != "comment") {
      r.changes[j].after = text.clone();
      lines[k] = text.clone();
      return;
    }
  }
  const before = lines[k].clone();
  r.changes.push({ kind: "edit", line: lineNo, before, after: text.clone() });
  lines[k] = text.clone();
}

// k 番目（0 から）の位置に行を足す。それより後ろの変更の行番号はずらす。
function opInsert(lines: mut string[], r: mut OpResult, k: usize, text: string): void {
  lines.push("");
  let j = lines.length - 1;
  while (j > k) {
    lines[j] = lines[j - 1].clone();
    j--;
  }
  lines[k] = text.clone();
  const lineNo = (k as i32) + 1;
  for (let m: usize = 0; m < r.changes.length; m++) {
    if (r.changes[m].line >= lineNo) {
      r.changes[m].line = r.changes[m].line + 1;
    }
  }
  r.changes.push({ kind: "insert", line: lineNo, before: "", after: text.clone() });
}

// ---- 各操作 ----

const OP_USAGE_MOVE: string = "move <クリップ> <時刻か参照>（例: move clip_b 5.5、move clip_b 1:02.5、move clip_b intro.end+1、move clip_b after:intro）";
const OP_USAGE_TRIM: string = "trim <クリップ> start <時刻> / trim <クリップ> end <時刻>（時刻はタイムライン上。例: trim intro end 4.5）";
const OP_USAGE_SPLIT: string = "split <クリップ> <時刻>（時刻はタイムライン上。例: split intro 3.5）";
const OP_USAGE_DELETE: string = "delete <クリップ> [fix-refs]（行を # で注釈にする。fix-refs は、参照しているクリップの at= を今の秒に書き換えてから消す）";
const OP_USAGE_SET: string = "set <クリップ> key=value ...（例: set clip_b sat=1.2 blur=3、set title text=\"Hello world\"）";
const OP_USAGE_UNSET: string = "unset <クリップ> key ...（例: unset clip_b blur fadeout）";
const OP_USAGE_ADD: string = "add <種類> [<素材 / 文字 / 色>] key=value ... [after <クリップ>]（例: add text \"Hello\" at=2 dur=3、add video media/a.mp4 in=1 out=4 after intro）";
const OP_USAGE_RENAME: string = "rename <クリップ> <新しい ID>（ID は英字・数字・_・-、先頭は英字か _）";
const OP_USAGE_CUT: string = "cut <開始> <終わり>（タイムライン上の範囲を全トラックから切り取り、後ろを詰める。例: cut 0 3、cut 1:00 1:05.5）";
const OP_USAGE_RENAMEKEY: string = "renamekey <クリップ> <古いキー> <新しいキー>（同じ場所でキーの名前だけを変える。例: renamekey clip_b vignete vignette）";

// 時刻の上限（秒）。これより大きい値や無限大は out-of-range にする（secText が正しく書ける範囲に収める）。
const OP_MAX_TIME: f64 = 10000000.0;

// 先頭が - の、時刻としては読める文字か（0 秒より前を指している）。
function opIsNegTime(s: string): bool {
  return s.length > 1 && s[0] == 45 && !isNan(parseTime(sub(s, 1, s.length)));
}

// 時刻の引数を読む。読めない・0 秒より前・上限より後ろなら r を失敗にする。
function opTimeArg(s: string, what: string, usage: string, r: mut OpResult): f64 {
  const t = parseTime(s);
  if (isNan(t)) {
    if (opIsNegTime(s)) {
      opFail(mut r, "out-of-range", `${what} '${s}' は 0 秒より前です`, `0 秒以上の時刻にします。${usage}`);
      return t;
    }
    opFail(mut r, "bad-args", `${what} '${s}' は時刻として読めません`, `時刻は 12.5 や 1:02.5 のように書きます。${usage}`);
    return t;
  }
  if (t < 0 || t > OP_MAX_TIME) {
    opFail(mut r, "out-of-range", `${what} '${s}' は扱える範囲の外です`, `0〜${secText(OP_MAX_TIME)} 秒の時刻にします。${usage}`);
  }
  return t;
}

function opMove(lines: mut string[], p: Project, a: string[], r: mut OpResult): void {
  if (a.length != 3) {
    opFail(mut r, "bad-args", "move にはクリップと行き先の 2 つを渡します", OP_USAGE_MOVE);
    return;
  }
  const i = opFindClip(p, a[1], mut r);
  if (i < 0) {
    return;
  }
  const c = i as usize;
  const k = (p.clips[c].line - 1) as usize;
  const label = opLabel(p.clips[c]);
  const oldAt = p.clips[c].at;
  let val = "";
  let newAt: f64 = 0;
  let shown = "";
  if (!isNan(parseTime(a[2])) || opIsNegTime(a[2])) {
    const t = opTimeArg(a[2], "行き先", OP_USAGE_MOVE, mut r);
    if (!r.ok) {
      return;
    }
    val = secText(t);
    newAt = t;
    shown = opSec(t);
  } else {
    const ref = opParseRef(a[2]);
    if (!ref.ok) {
      opFail(mut r, "bad-args", `行き先 '${a[2]}' は時刻としても参照としても読めません`, OP_USAGE_MOVE);
      return;
    }
    if (!opHasId(p, ref.id)) {
      opFail(mut r, "unknown-ref", `参照の先 '${ref.id}' というクリップはありません`, opClipHint(p, ref.id));
      return;
    }
    if (ref.id == p.clips[c].id) {
      opFail(mut r, "ref-cycle", `${label} は自分自身を参照できません`, "ほかのクリップの ID を指します");
      return;
    }
    newAt = opRefTime(p, ref);
    if (newAt < 0) {
      opFail(mut r, "out-of-range", `行き先 '${a[2]}' は ${opSec(newAt)}で、0 秒より前です`,
        `オフセットを ${secText(ref.off - newAt)} 以上にします（行き先は 0 秒以降）`);
      return;
    }
    if (newAt > OP_MAX_TIME) {
      opFail(mut r, "out-of-range", `行き先 '${a[2]}' は扱える範囲の外です`, `0〜${secText(OP_MAX_TIME)} 秒になるようにオフセットを小さくします`);
      return;
    }
    val = a[2].clone();
    shown = `${a[2]}（${opSec(newAt)}）`;
  }
  const nl = setKey(lines[k], "at", val);
  opEdit(mut lines, mut r, k, nl);
  if (r.changes.length == 0) {
    r.desc = `${label} は ${shown}のままです（変わりませんでした）`;
    return;
  }
  if (Math.abs(newAt - oldAt) < 0.0005) {
    r.desc = `${label} の at= を ${shown}と書き換えました（時刻は変わりません）`;
    return;
  }
  r.desc = `${label} を ${opSec(oldAt)}から ${shown}に動かしました`;
}

function opTrim(lines: mut string[], p: Project, probes: Probe[], a: string[], r: mut OpResult): void {
  if (a.length != 4 || (a[2] != "start" && a[2] != "end")) {
    opFail(mut r, "bad-args", "trim にはクリップ、start か end、時刻を渡します", OP_USAGE_TRIM);
    return;
  }
  const i = opFindClip(p, a[1], mut r);
  if (i < 0) {
    return;
  }
  const t = opTimeArg(a[3], "時刻", OP_USAGE_TRIM, mut r);
  if (!r.ok) {
    return;
  }
  const c = i as usize;
  const k = (p.clips[c].line - 1) as usize;
  const label = opLabel(p.clips[c]);
  const kind = p.clips[c].kind;
  const at = p.clips[c].at;
  const inPt = p.clips[c].inPt;
  const dur = p.clips[c].dur;
  const fr = opFrame(p);
  const media = opIsMedia(kind);
  let line = lines[k].clone();
  const hasOut = hasKey(line, "out") && media;
  if (a[2] == "start") {
    let lo: f64 = 0;
    if (media) {
      // 素材の 0 秒より前には出られない
      lo = Math.max(at - inPt, 0.0);
    }
    const hi = at + dur - fr;
    if (t < lo - 0.0005 || t > hi + 0.0005) {
      let why = "長さは 1 コマ以上";
      if (media) {
        why = "長さは 1 コマ以上、素材の 0 秒より前には出られません";
      }
      opFail(mut r, "out-of-range", `${label} の始まりを ${opSec(t)}にはできません`, `${opSec(lo)}〜${opSec(hi)}の範囲で指定します（${why}）`);
      return;
    }
    const nt = Math.max(t, lo);
    if (Math.abs(nt - at) < 0.0005) {
      r.desc = `${label} の始まりは ${opSec(at)}のままです（変わりませんでした）`;
      return;
    }
    // at= が参照なら、参照のままオフセットを直す
    line = setKey(line, "at", opAtValue(line, at, nt));
    if (media) {
      line = setKey(line, "in", secText(inPt + (nt - at)));
    }
    if (!hasOut) {
      line = setKey(line, "dur", secText(at + dur - nt));
    }
    opEdit(mut lines, mut r, k, line);
    r.desc = `${label} の始まりを ${opSec(at)}から ${opSec(nt)}にしました（長さ ${opSec(at + dur - nt)}）`;
    return;
  }
  const lo = at + fr;
  let hi: f64 = OP_MAX_TIME;
  let probed = false;
  if (media) {
    const pi = opFindProbe(probes, p.clips[c].src);
    if (pi >= 0 && !isNan(probes[pi as usize].dur)) {
      hi = Math.min(at + probes[pi as usize].dur - inPt, OP_MAX_TIME);
      probed = true;
    }
  }
  if (t < lo - 0.0005 || t > hi + 0.0005) {
    let why = "長さは 1 コマ以上";
    if (probed) {
      why = "長さは 1 コマ以上、素材の終わりより後ろには出られません";
    }
    let range = `${opSec(lo)}〜${opSec(hi)}の範囲`;
    if (!probed) {
      range = `${opSec(lo)}以降`;
    }
    opFail(mut r, "out-of-range", `${label} の終わりを ${opSec(t)}にはできません`, `${range}で指定します（${why}）`);
    return;
  }
  const nd = Math.min(t, hi) - at;
  if (Math.abs(nd - dur) < 0.0005) {
    r.desc = `${label} の終わりは ${opSec(at + dur)}のままです（変わりませんでした）`;
    return;
  }
  if (hasOut) {
    line = setKey(line, "out", secText(inPt + nd));
  } else {
    line = setKey(line, "dur", secText(nd));
  }
  opEdit(mut lines, mut r, k, line);
  r.desc = `${label} の終わりを ${opSec(at + dur)}から ${opSec(at + nd)}にしました（長さ ${opSec(nd)}）`;
}

// copies には (足した行, 写した元の行) の行番号（1 から、操作の後の番号）を足す。
function opSplit(lines: mut string[], p: Project, a: string[], r: mut OpResult, copies: mut i32[]): void {
  if (a.length != 3) {
    opFail(mut r, "bad-args", "split にはクリップと時刻を渡します", OP_USAGE_SPLIT);
    return;
  }
  const i = opFindClip(p, a[1], mut r);
  if (i < 0) {
    return;
  }
  const t = opTimeArg(a[2], "時刻", OP_USAGE_SPLIT, mut r);
  if (!r.ok) {
    return;
  }
  const c = i as usize;
  const k = (p.clips[c].line - 1) as usize;
  const label = opLabel(p.clips[c]);
  const kind = p.clips[c].kind;
  const at = p.clips[c].at;
  const inPt = p.clips[c].inPt;
  const dur = p.clips[c].dur;
  const fr = opFrame(p);
  const off = t - at;
  if (off < fr - 0.0005 || off > dur - fr + 0.0005) {
    opFail(mut r, "out-of-range", `${opSec(t)}は ${label}（${opSec(at)}〜${opSec(at + dur)}）の中ではありません`, `${opSec(at + fr)}〜${opSec(at + dur - fr)}の時刻で分けます（どちらも 1 コマ以上残る所）`);
    return;
  }
  const media = opIsMedia(kind);
  let fa = lines[k].clone();
  let fb = lines[k].clone();
  const hasOut = hasKey(fa, "out") && media;
  if (hasOut) {
    fa = setKey(fa, "out", secText(inPt + off));
  } else {
    fa = setKey(fa, "dur", secText(off));
  }
  // fade= は前半の fadein と後半の fadeout に分ける。読み取りは後勝ちなので、
  // fade と fadein / fadeout のうち行の後ろにあるほう（効いている値）を使う。
  if (hasKey(fa, "fade")) {
    const fv = keyValue(fa, "fade");
    const fcol = keyColumn(fa, "fade");
    let inV = fv.clone();
    if (keyColumn(fa, "fadein") > fcol) {
      inV = keyValue(fa, "fadein");
    }
    let outV = fv.clone();
    if (keyColumn(fb, "fadeout") > keyColumn(fb, "fade")) {
      outV = keyValue(fb, "fadeout");
    }
    fa = removeKey(removeKey(fa, "fade"), "fadein");
    fa = setKey(fa, "fadein", inV);
    fb = removeKey(removeKey(fb, "fade"), "fadeout");
    fb = setKey(fb, "fadeout", outV);
  }
  fa = removeKey(fa, "fadeout");
  fa = removeKey(fa, "afadeout");
  // 後半の ID は <id>_2（重複すれば _3 …）
  const oldId = p.clips[c].id.clone();
  let newId = "";
  if (oldId != "") {
    let n = 2;
    newId = `${oldId}_${n}`;
    while (opHasId(p, newId)) {
      n++;
      newId = `${oldId}_${n}`;
    }
  }
  if (oldId != "") {
    // 後半は前半の終わりを参照する（前半の参照先が動いても、後半が取り残されない）
    fb = setKey(fb, "at", oldId + ".end");
  } else {
    fb = setKey(fb, "at", secText(at + off));
  }
  if (media) {
    fb = setKey(fb, "in", secText(inPt + off));
  }
  if (!hasOut) {
    fb = setKey(fb, "dur", secText(dur - off));
  }
  fb = removeKey(fb, "fadein");
  fb = removeKey(fb, "afadein");
  fb = removeKey(fb, "xfade");
  if (oldId != "") {
    fb = setKey(fb, "id", newId);
  }
  opEdit(mut lines, mut r, k, fa);
  opInsert(mut lines, mut r, k + 1, fb);
  // 後半の行は元の行の写し。元の行にあった誤りが後半にも写っても、増えたとは数えない
  copies.push((k as i32) + 2);
  copies.push((k as i32) + 1);
  let extra = "";
  if (oldId != "") {
    // 終わりを指していた参照（x.end / after:x）は後半の終わりを指すようにする
    const moved = opRewriteRefs(mut lines, mut r, oldId, newId, true, k + 1);
    if (moved > 0) {
      extra = `。${oldId} の終わりを指していた参照 ${moved} か所は ${newId} に向けました`;
    }
    r.newId = newId.clone();
    r.desc = `${label} を ${opSec(t)}で分けました（後半は ${newId}）${extra}`;
  } else {
    r.desc = `${label} を ${opSec(t)}で分けました（後半は次の行）`;
  }
}

function opDelete(lines: mut string[], p: Project, a: string[], r: mut OpResult): void {
  const fixRefs = a.length == 3 && a[2] == "fix-refs";
  if (a.length != 2 && !fixRefs) {
    opFail(mut r, "bad-args", "delete にはクリップを 1 つ渡します（参照を秒に書き換えて消すなら、後ろに fix-refs）", OP_USAGE_DELETE);
    return;
  }
  const i = opFindClip(p, a[1], mut r);
  if (i < 0) {
    return;
  }
  const c = i as usize;
  const k = (p.clips[c].line - 1) as usize;
  // ほかのクリップの at= から参照されているなら、そのままでは消さない（参照が切れて誤りになるため）
  const id = p.clips[c].id.clone();
  if (id != "") {
    let names = "";
    let refs: i32[] = [];
    for (let j: usize = 0; j < p.clips.length; j++) {
      if (j != c && p.clips[j].atRef == id) {
        if (names != "") {
          names = names + ", ";
        }
        names = names + opLabel(p.clips[j]);
        refs.push(j as i32);
      }
    }
    if (refs.length > 0 && !fixRefs) {
      opFail(mut r, "referenced", `${id} は ${names} の at= から参照されています`,
        `参照しているクリップの at= を今の秒に書き換えてから消すなら delete ${a[1]} fix-refs と書きます。参照しているクリップも消すなら、先にそれらを delete します（move <クリップ> <秒> で at= を秒にしてもよい）`);
      return;
    }
    for (const j of refs) {
      const rk = (p.clips[j as usize].line - 1) as usize;
      const nl = setKey(lines[rk], "at", secText(p.clips[j as usize].at));
      opEdit(mut lines, mut r, rk, nl);
    }
  }
  const before = lines[k].clone();
  const after = "# " + lines[k];
  lines[k] = after.clone();
  r.changes.push({ kind: "comment", line: (k as i32) + 1, before, after });
  r.desc = `${opLabel(p.clips[c])}（${opSec(p.clips[c].at)}〜${opSec(p.clips[c].at + p.clips[c].dur)}）を消しました（行を注釈にしました）`;
  if (fixRefs && r.changes.length > 1) {
    r.desc = r.desc + `。参照していた ${r.changes.length - 1} 個のクリップの at= は秒に書き換えました`;
  }
}

// cut <開始> <終わり>: タイムライン上の範囲を全トラックから切り取り、後ろを詰める。
// 1. 範囲の両端をまたぐ映像・音のクリップは終わりの時刻で分ける（中身が続くように）。
// 2. 各クリップの行き先（開始・終わり）を求め、範囲の中のものは消し、かかるものは短くし、後ろのものは前へずらす。
// 3. 読み直して、行き先と違うクリップ（参照や at= のない並びで動いたもの）の at= を秒で書く。合うまで繰り返す。
function opCut(lines: mut string[], probes: Probe[], a: string[], r: mut OpResult, copies: mut i32[]): void {
  if (a.length != 3) {
    opFail(mut r, "bad-args", "cut には開始と終わりの時刻を渡します", OP_USAGE_CUT);
    return;
  }
  const ta = opTimeArg(a[1], "開始", OP_USAGE_CUT, mut r);
  if (!r.ok) {
    return;
  }
  const tb = opTimeArg(a[2], "終わり", OP_USAGE_CUT, mut r);
  if (!r.ok) {
    return;
  }
  let d0: Diag[] = [];
  let p = opParse(lines, probes, mut d0);
  const fr = opFrame(p);
  if (tb - ta < fr - 0.0005) {
    opFail(mut r, "out-of-range", `範囲 ${opSec(ta)}〜${opSec(tb)}が空です`, `終わりは開始より 1 コマ（${secText(fr)} 秒）以上後ろにします。${OP_USAGE_CUT}`);
    return;
  }
  const d = tb - ta;
  const eps = 0.0005;
  // 1. 両端をまたぐ映像・音を分ける
  let nSplit = 0;
  let guard = p.clips.length + 1;
  while (guard > 0) {
    guard--;
    let found = -1;
    for (let i: usize = 0; i < p.clips.length; i++) {
      if (opIsMedia(p.clips[i].kind) && p.clips[i].at < ta - eps && p.clips[i].at + p.clips[i].dur > tb + fr - eps) {
        found = i as i32;
        break;
      }
    }
    if (found < 0) {
      break;
    }
    const keepDesc = r.desc.clone();
    const sa: string[] = ["split", `@${p.clips[found as usize].line}`, secText(tb)];
    opSplit(mut lines, p, sa, mut r, mut copies);
    if (!r.ok) {
      return;
    }
    r.desc = keepDesc;
    r.newId = "";
    nSplit++;
    let dd: Diag[] = [];
    p = opParse(lines, probes, mut dd);
  }
  // 2. 行き先を求めて書く。行の番号でクリップを引く（これより後は行を足さない）
  const n = p.clips.length;
  let tS: f64[] = [];
  let tE: f64[] = [];
  let del: bool[] = [];
  let headCut: bool[] = [];
  let nDel = 0;
  let nTrim = 0;
  for (let i: usize = 0; i < n; i++) {
    const s = p.clips[i].at;
    const e = s + p.clips[i].dur;
    let ns = s;
    let ne = e;
    let gone = false;
    let hc = false;
    if (e <= ta + eps) {
      // 範囲より前: そのまま
    } else if (s >= tb - eps) {
      ns = s - d;
      ne = e - d;
    } else if (s >= ta - eps && e <= tb + eps) {
      gone = true;
    } else if (s < ta && e > tb && !opIsMedia(p.clips[i].kind)) {
      ne = e - d;
    } else if (s < ta) {
      ne = ta;
    } else {
      // 始まりが範囲の中: 範囲の終わりまでを切る
      ns = ta;
      ne = e - d;
      hc = true;
    }
    tS.push(ns);
    tE.push(ne);
    del.push(gone);
    headCut.push(hc);
  }
  for (let i: usize = 0; i < n; i++) {
    const k = (p.clips[i].line - 1) as usize;
    if (del[i]) {
      const before = lines[k].clone();
      const after = "# " + lines[k];
      lines[k] = after.clone();
      r.changes.push({ kind: "comment", line: (k as i32) + 1, before, after });
      nDel++;
      continue;
    }
    const s = p.clips[i].at;
    const e = s + p.clips[i].dur;
    const media = opIsMedia(p.clips[i].kind);
    let line = lines[k].clone();
    const hasOut = media && hasKey(line, "out");
    const trimmedStart = headCut[i];
    const shortened = Math.abs((tE[i] - tS[i]) - (e - s)) > eps;
    if (shortened) {
      nTrim++;
      if (trimmedStart) {
        // 始まりを切った: 素材は切った分だけ先から使う
        if (media) {
          line = setKey(line, "in", secText(p.clips[i].inPt + (tb - s)));
        }
        if (!hasOut) {
          line = setKey(line, "dur", secText(tE[i] - tS[i]));
        }
      } else if (hasOut) {
        line = setKey(line, "out", secText(p.clips[i].inPt + (tE[i] - tS[i])));
      } else {
        line = setKey(line, "dur", secText(tE[i] - tS[i]));
      }
    }
    // 秒で書いた at= はここで書き直す。消すクリップを参照している at= も秒にする
    const ref = p.clips[i].atRef.clone();
    let refGone = false;
    if (ref != "") {
      for (let j: usize = 0; j < n; j++) {
        if (del[j] && p.clips[j].id == ref) {
          refGone = true;
        }
      }
    }
    if ((p.clips[i].atText != "" && ref == "" && Math.abs(tS[i] - s) > eps) || refGone) {
      line = setKey(line, "at", secText(tS[i]));
    }
    opEdit(mut lines, mut r, k, line);
  }
  // 3. 読み直して、行き先と違うクリップの at= を秒で書く
  let rounds = n + 2;
  while (rounds > 0) {
    rounds--;
    let dd: Diag[] = [];
    const q = opParse(lines, probes, mut dd);
    let fixed = 0;
    for (const qc of q.clips) {
      let i = -1;
      for (let j: usize = 0; j < n; j++) {
        if (p.clips[j].line == qc.line && !del[j]) {
          i = j as i32;
        }
      }
      if (i < 0) {
        continue;
      }
      const iu = i as usize;
      if (Math.abs(qc.at - tS[iu]) > eps) {
        const k = (qc.line - 1) as usize;
        const nl = setKey(lines[k], "at", secText(tS[iu]));
        opEdit(mut lines, mut r, k, nl);
        fixed++;
      }
    }
    if (fixed == 0) {
      break;
    }
  }
  if (r.changes.length == 0) {
    r.desc = `${opSec(ta)}〜${opSec(tb)}にクリップはないので、何も変わりませんでした`;
    return;
  }
  let what = `消した ${nDel} 個、短くした ${nTrim} 個`;
  if (nSplit > 0) {
    what = what + `、範囲をまたぐので分けた ${nSplit} 個`;
  }
  r.desc = `${opSec(ta)}〜${opSec(tb)}（${opSec(d)}）を切り取って後ろを詰めました（${what}）`;
}

// renamekey <クリップ> <古いキー> <新しいキー>: 同じ場所でキーの名前だけを変える（効果の掛ける順を保つ）。
function opRenameKey(lines: mut string[], p: Project, a: string[], r: mut OpResult): void {
  if (a.length != 4) {
    opFail(mut r, "bad-args", "renamekey にはクリップ、古いキー、新しいキーを渡します", OP_USAGE_RENAMEKEY);
    return;
  }
  const i = opFindClip(p, a[1], mut r);
  if (i < 0) {
    return;
  }
  const c = i as usize;
  const k = (p.clips[c].line - 1) as usize;
  const label = opLabel(p.clips[c]);
  if (!hasKey(lines[k], a[2])) {
    opFail(mut r, "bad-args", `${label} の行に ${a[2]} は書かれていません`, OP_USAGE_RENAMEKEY);
    return;
  }
  if (!opValidKey(a[3]) || a[3] == "id") {
    opFail(mut r, "bad-args", `'${a[3]}' はキーの名前に使えません`, `キーは英字・数字・_・.・- で、先頭は英字か _ にします。${OP_USAGE_RENAMEKEY}`);
    return;
  }
  if (a[3] != a[2] && hasKey(lines[k], a[3])) {
    opFail(mut r, "bad-args", `${label} の行には ${a[3]} がもうあります`, `先に unset ${a[1]} ${a[3]} で消します`);
    return;
  }
  const nl = renameKey(lines[k], a[2], a[3]);
  opEdit(mut lines, mut r, k, nl);
  if (r.changes.length == 0) {
    r.desc = `${label} は変わりませんでした`;
    return;
  }
  r.desc = `${label} のキー ${a[2]} を ${a[3]} に変えました（値と位置はそのまま）`;
}

// 文字の値の \n（2 文字）を改行にする（op のコマンドラインや操作のファイルから複数行の文字を書くため）。
function opTextNewlines(v: string): string {
  let b: u8[] = [];
  let i: usize = 0;
  while (i < v.length) {
    if (v[i] == 92 && i + 1 < v.length && v[i + 1] == 110) {
      b.push(10);
      i += 2;
      continue;
    }
    b.push(v[i]);
    i++;
  }
  return stringFromBytes(b);
}

// ID を付ける・変える。ほかの行の at= の参照も書き換える。成功なら desc の文を返す。
function opSetId(lines: mut string[], p: Project, c: usize, newId: string, r: mut OpResult): string {
  const k = (p.clips[c].line - 1) as usize;
  const oldId = p.clips[c].id.clone();
  if (!opValidId(newId)) {
    opFail(mut r, "bad-id", `'${newId}' は ID の形ではありません`, "ID は英字・数字・_・- で、先頭は英字か _ にします（例: intro、clip_b、scene-2）");
    return "";
  }
  if (newId == oldId) {
    opFail(mut r, "bad-args", `${oldId} はすでにその名前です`, OP_USAGE_RENAME);
    return "";
  }
  if (opHasId(p, newId)) {
    opFail(mut r, "duplicate-id", `ID '${newId}' はほかのクリップが使っています`, "使われていない名前にします");
    return "";
  }
  const nl = setKey(lines[k], "id", newId);
  opEdit(mut lines, mut r, k, nl);
  r.newId = newId.clone();
  if (oldId == "") {
    return `${opLabel(p.clips[c])} に ID ${newId} を付けました`;
  }
  const n = opRewriteRefs(mut lines, mut r, oldId, newId, false, k);
  if (n > 0) {
    return `${oldId} の名前を ${newId} に変えました（at= の参照 ${n} か所も書き換えました）`;
  }
  return `${oldId} の名前を ${newId} に変えました`;
}

function opRename(lines: mut string[], p: Project, a: string[], r: mut OpResult): void {
  if (a.length != 3) {
    opFail(mut r, "bad-args", "rename にはクリップと新しい ID を渡します", OP_USAGE_RENAME);
    return;
  }
  const i = opFindClip(p, a[1], mut r);
  if (i < 0) {
    return;
  }
  const d = opSetId(mut lines, p, i as usize, a[2], mut r);
  if (r.ok) {
    r.desc = d;
  }
}

// 位置で渡す値として書くキーか（text の文字、video / image / audio の素材、color の色）。
function opPositionalKey(kind: i32, key: string): bool {
  if (key == "text") {
    return kind == KIND_TEXT;
  }
  if (key == "src") {
    return kind == KIND_VIDEO || kind == KIND_IMAGE || kind == KIND_AUDIO;
  }
  if (key == "color") {
    return kind == KIND_COLOR;
  }
  return false;
}

function opSet(lines: mut string[], p: Project, a: string[], r: mut OpResult): void {
  if (a.length < 3) {
    opFail(mut r, "bad-args", "set にはクリップと key=value を 1 つ以上渡します", OP_USAGE_SET);
    return;
  }
  const i = opFindClip(p, a[1], mut r);
  if (i < 0) {
    return;
  }
  const c = i as usize;
  const k = (p.clips[c].line - 1) as usize;
  const kind = p.clips[c].kind;
  const label = opLabel(p.clips[c]);
  let parts = "";
  let idDesc = "";
  for (let j: usize = 2; j < a.length; j++) {
    const kv = a[j].clone();
    let eq: usize = 0;
    let found = false;
    for (let m: usize = 0; m < kv.length; m++) {
      if (kv[m] == 61) {
        eq = m;
        found = true;
        break;
      }
    }
    let piece = "";
    if (!found) {
      if (kv == "mute") {
        if (hasFlag(lines[k], "mute")) {
          continue;
        }
        const nl = addFlag(lines[k], "mute");
        opEdit(mut lines, mut r, k, nl);
        piece = "mute（新規）";
      } else {
        opFail(mut r, "bad-args", `'${kv}' は key=value の形ではありません`, OP_USAGE_SET);
        return;
      }
    } else {
      const key = sub(kv, 0, eq);
      let val = sub(kv, eq + 1, kv.length);
      if (key == "text" && kind == KIND_TEXT) {
        val = opTextNewlines(val);
      }
      if (key.length == 0) {
        opFail(mut r, "bad-args", `'${kv}' にキーがありません`, OP_USAGE_SET);
        return;
      }
      if (!opValidKey(key)) {
        opFail(mut r, "bad-args", `'${key}' はキーの形ではありません`, `キーは英字・数字・_・.・- で、先頭は英字か _ にします。${OP_USAGE_SET}`);
        return;
      }
      if (key == "id") {
        idDesc = opSetId(mut lines, p, c, val, mut r);
        if (!r.ok) {
          return;
        }
        continue;
      }
      if (opPositionalKey(kind, key) && (hasPositional(lines[k]) || key != "color")) {
        // 古い値は key= と位置で渡す値のどちらで書かれていても出す（key= は後に読まれるので優先）
        let old = positionalValue(lines[k]);
        if (hasKey(lines[k], key)) {
          old = keyValue(lines[k], key);
        }
        const had = hasPositional(lines[k]) || hasKey(lines[k], key);
        // 文字と素材は必ず "..." で囲む（色は囲まない）
        const nl = setPositional(removeKey(lines[k], key), val, key != "color");
        opEdit(mut lines, mut r, k, nl);
        if (had) {
          piece = `${key} ${lineQuote(old, key != "color")} → ${lineQuote(val, key != "color")}`;
        } else {
          piece = `${key} ${lineQuote(val, key != "color")}（新規）`;
        }
      } else {
        const had = hasKey(lines[k], key);
        const old = keyValue(lines[k], key);
        let nl = setKey(lines[k], key, val);
        // 映像・音の長さは out= と dur= のどちらか一方で決める（両方あると out= が勝ち、書いた dur= が効かない）
        let dropped = "";
        if (opIsMedia(kind) && key == "dur" && hasKey(nl, "out")) {
          dropped = `out=${keyValue(nl, "out")}`;
          nl = removeKey(nl, "out");
        } else if (opIsMedia(kind) && key == "out" && hasKey(nl, "dur")) {
          dropped = `dur=${keyValue(nl, "dur")}`;
          nl = removeKey(nl, "dur");
        }
        opEdit(mut lines, mut r, k, nl);
        if (had) {
          piece = `${key} ${lineQuote(old, false)} → ${lineQuote(val, false)}`;
        } else {
          piece = `${key} ${lineQuote(val, false)}（新規）`;
        }
        if (dropped != "") {
          piece = piece + `（長さが効くように ${dropped} を消しました）`;
        }
      }
    }
    if (parts != "") {
      parts = parts + "、";
    }
    parts = parts + piece;
  }
  if (parts == "" && idDesc == "") {
    r.desc = `${label} は変わりませんでした`;
  } else if (parts == "") {
    r.desc = idDesc;
  } else if (idDesc == "") {
    r.desc = `${label} の値を変えました: ${parts}`;
  } else {
    r.desc = `${label} の値を変えました: ${parts}。${idDesc}`;
  }
}

function opUnset(lines: mut string[], p: Project, a: string[], r: mut OpResult): void {
  if (a.length < 3) {
    opFail(mut r, "bad-args", "unset にはクリップとキーを 1 つ以上渡します", OP_USAGE_UNSET);
    return;
  }
  const i = opFindClip(p, a[1], mut r);
  if (i < 0) {
    return;
  }
  const c = i as usize;
  const k = (p.clips[c].line - 1) as usize;
  const label = opLabel(p.clips[c]);
  let parts = "";
  for (let j: usize = 2; j < a.length; j++) {
    const key = a[j].clone();
    let piece = "";
    if (key == "mute" && hasFlag(lines[k], "mute")) {
      const nl = removeKey(removeFlag(lines[k], "mute"), "mute");
      opEdit(mut lines, mut r, k, nl);
      piece = "mute";
    } else if (hasKey(lines[k], key)) {
      piece = `${key}=${lineQuote(keyValue(lines[k], key), false)}`;
      const nl = removeKey(lines[k], key);
      opEdit(mut lines, mut r, k, nl);
    } else if (opPositionalKey(p.clips[c].kind, key) && hasPositional(lines[k])) {
      opFail(mut r, "bad-args", `${key} は ${label} に欠かせない値なので消せません`, `値を変えるときは set を使います（例: set ${a[1]} ${key}=...）`);
      return;
    } else {
      opFail(mut r, "bad-args", `${label} の行に ${key} は書かれていません`, OP_USAGE_UNSET);
      return;
    }
    if (parts != "") {
      parts = parts + "、";
    }
    parts = parts + piece;
  }
  r.desc = `${label} から ${parts} を消しました`;
}

function opAdd(lines: mut string[], p: Project, probes: Probe[], a: string[], r: mut OpResult): void {
  if (a.length < 2) {
    opFail(mut r, "bad-args", "add には種類を渡します", OP_USAGE_ADD);
    return;
  }
  const kind = opKindOf(a[1]);
  if (kind == 0) {
    opFail(mut r, "bad-args", `'${a[1]}' という種類はありません`, `種類は video / image / text / color / audio のどれかです。${OP_USAGE_ADD}`);
    return;
  }
  // 末尾の after <クリップ>
  let last = a.length;
  let insertAt = lines.length;
  let where = "ファイルの最後";
  if (a.length >= 4 && a[a.length - 2] == "after") {
    const ai = opFindClip(p, a[a.length - 1], mut r);
    if (ai < 0) {
      return;
    }
    insertAt = p.clips[ai as usize].line as usize;
    where = ` ${opLabel(p.clips[ai as usize])} の次の行`;
    last = a.length - 2;
  }
  let pos = "";
  let hasPos = false;
  let id = "";
  let rest = "";
  for (let j: usize = 2; j < last; j++) {
    const w = a[j].clone();
    let eq: usize = 0;
    let found = false;
    for (let m: usize = 0; m < w.length; m++) {
      if (w[m] == 61) {
        eq = m;
        found = true;
        break;
      }
    }
    if (!found) {
      if (w == "mute") {
        rest = rest + " mute";
      } else if (j == 2) {
        pos = w.clone();
        hasPos = true;
      } else {
        opFail(mut r, "bad-args", `'${w}' は key=value の形ではありません`, OP_USAGE_ADD);
        return;
      }
      continue;
    }
    const key = sub(w, 0, eq);
    const val = sub(w, eq + 1, w.length);
    if (key.length == 0) {
      opFail(mut r, "bad-args", `'${w}' にキーがありません`, OP_USAGE_ADD);
      return;
    }
    if (!opValidKey(key)) {
      opFail(mut r, "bad-args", `'${key}' はキーの形ではありません`, `キーは英字・数字・_・.・- で、先頭は英字か _ にします。${OP_USAGE_ADD}`);
      return;
    }
    if (key == "id") {
      id = val.clone();
      continue;
    }
    if (!hasPos && opPositionalKey(kind, key)) {
      pos = val.clone();
      hasPos = true;
      continue;
    }
    rest = rest + " " + key + "=" + lineQuote(val, false);
  }
  if (!hasPos && kind != KIND_COLOR) {
    let what = "素材のファイル";
    if (kind == KIND_TEXT) {
      what = "文字";
    }
    opFail(mut r, "bad-args", `${a[1]} には${what}を渡します`, OP_USAGE_ADD);
    return;
  }
  if (id != "") {
    if (!opValidId(id)) {
      opFail(mut r, "bad-id", `'${id}' は ID の形ではありません`, "ID は英字・数字・_・- で、先頭は英字か _ にします（例: intro、clip_b、scene-2）");
      return;
    }
    if (opHasId(p, id)) {
      opFail(mut r, "duplicate-id", `ID '${id}' はほかのクリップが使っています`, "使われていない名前にするか、id= を省いて自動で付けます");
      return;
    }
  } else {
    let n = 1;
    id = `${a[1]}${n}`;
    while (opHasId(p, id)) {
      n++;
      id = `${a[1]}${n}`;
    }
  }
  let line = a[1].clone();
  if (kind == KIND_TEXT) {
    pos = opTextNewlines(pos);
  }
  if (hasPos) {
    line = line + " " + lineQuote(pos, kind != KIND_COLOR);
  }
  line = line + " id=" + id + rest;
  opInsert(mut lines, mut r, insertAt, line);
  r.newId = id.clone();
  // 置かれた所を読み直して desc に書く
  let d: Diag[] = [];
  const np = opParse(lines, probes, mut d);
  const ni = findClip(np, `@${insertAt + 1}`);
  if (ni >= 0) {
    const nc = ni as usize;
    let tk = "映像";
    if (kind == KIND_AUDIO) {
      tk = "音";
    }
    r.desc = `${id}（${a[1]}）を${where}に足しました（${opSec(np.clips[nc].at)}〜${opSec(np.clips[nc].at + np.clips[nc].dur)}、${tk}トラック ${np.clips[nc].track}）`;
  } else {
    r.desc = `${id}（${a[1]}）を${where}に足しました`;
  }
}

function opApply(lines: mut string[], p: Project, probes: Probe[], a: string[], r: mut OpResult, copies: mut i32[]): void {
  if (a.length == 0) {
    opFail(mut r, "unknown-op", "操作がありません", `操作は ${OP_NAMES} のどれかです（書き方: node tools/mozcut.mjs schema）`);
    return;
  }
  const name = opLower(a[0]);
  switch (name) {
    case "cut":
      opCut(mut lines, probes, a, mut r, mut copies);
      return;
    case "renamekey":
      opRenameKey(mut lines, p, a, mut r);
      return;
    case "move":
      opMove(mut lines, p, a, mut r);
      return;
    case "trim":
      opTrim(mut lines, p, probes, a, mut r);
      return;
    case "split":
      opSplit(mut lines, p, a, mut r, mut copies);
      return;
    case "delete":
      opDelete(mut lines, p, a, mut r);
      return;
    case "set":
      opSet(mut lines, p, a, mut r);
      return;
    case "unset":
      opUnset(mut lines, p, a, mut r);
      return;
    case "add":
      opAdd(mut lines, p, probes, a, mut r);
      return;
    case "rename":
      opRename(mut lines, p, a, mut r);
      return;
  }
  let hint = `操作は ${OP_NAMES} のどれかです（書き方: node tools/mozcut.mjs schema）`;
  const near = textNearest(name, opNameList());
  if (near != "") {
    hint = `'${near}' のことですか？ ${hint}`;
  }
  opFail(mut r, "unknown-op", `'${a[0]}' という操作はありません`, hint);
}

// ---- まとめて適用 ----

// 操作の前の診断の行番号を、操作で足した行の分だけずらす。
function opMapLine(line: i32, changes: Change[]): i32 {
  let l = line;
  if (l <= 0) {
    return l;
  }
  for (const ch of changes) {
    if (ch.kind == "insert" && l >= ch.line) {
      l++;
    }
  }
  return l;
}

// 行 line（操作の後の番号）にある、code の同じ操作の前の誤りを探す。consume なら使ったものに印を付け、
// 印の付いたものは選ばない。consume でなければ印を見ない（写した行を元の行の誤りと対にするとき）。
function opTakeDiag(head: i32[], next: i32[], used: mut bool[], before: Diag[], line: i32, code: string, consume: bool): bool {
  if (line < 0 || (line as usize) >= head.length) {
    return false;
  }
  let j = head[line as usize];
  while (j >= 0) {
    const ju = j as usize;
    if ((!consume || !used[ju]) && before[ju].code == code) {
      if (consume) {
        used[ju] = true;
      }
      return true;
    }
    j = next[ju];
  }
  return false;
}

// 新しく増えた誤り（code と行で比べる）の番号。なければ -1。
// 操作の前の誤りを（ずらした後の）行ごとのつながりにしておき、後の誤りを行で引くので、誤りの数に比例する時間で済む。
// copies は (足した行, 写した元の行) の並び。写した行の誤りは、元の行に同じ code の誤りがあれば増えたと数えない。
function opNewError(before: Diag[], after: Diag[], changes: Change[], copies: i32[]): i32 {
  let mapped: i32[] = [];
  let maxLine: i32 = 0;
  for (const d of before) {
    let l = opMapLine(d.line, changes);
    if (l < 0) {
      l = 0;
    }
    mapped.push(l);
    if (l > maxLine) {
      maxLine = l;
    }
  }
  let head: i32[] = [];
  for (let l: i32 = 0; l <= maxLine; l++) {
    head.push(-1);
  }
  let next: i32[] = [];
  let used: bool[] = [];
  for (let j: usize = 0; j < before.length; j++) {
    next.push(-1);
    used.push(false);
  }
  // 後ろから足して、つながりが前から順になるようにする
  let j = before.length;
  while (j > 0) {
    j--;
    if (before[j].severity != "error") {
      continue;
    }
    const l = mapped[j] as usize;
    next[j] = head[l];
    head[l] = j as i32;
  }
  for (let i: usize = 0; i < after.length; i++) {
    if (after[i].severity != "error") {
      continue;
    }
    let l = after[i].line;
    if (l < 0) {
      l = 0;
    }
    if (opTakeDiag(head, next, mut used, before, l, after[i].code, true)) {
      continue;
    }
    let src = -1;
    let q: usize = 0;
    while (q + 1 < copies.length) {
      if (copies[q] == l) {
        src = copies[q + 1];
      }
      q += 2;
    }
    if (src >= 0 && opTakeDiag(head, next, mut used, before, src, after[i].code, false)) {
      continue;
    }
    return i as i32;
  }
  return -1;
}

// 操作の後の行番号を、バッチの前（元の lines）の行番号に戻す。
// この操作で足した行なら -1、前の操作で足した行なら -2。
function opOrigLine(line: i32, changes: Change[], results: OpResult[]): i32 {
  let n = 0;
  for (const ch of changes) {
    if (ch.kind != "insert") {
      continue;
    }
    if (ch.line == line) {
      return -1;
    }
    if (ch.line < line) {
      n++;
    }
  }
  const l = line - n;
  let m = 0;
  for (const res of results) {
    for (const ch of res.changes) {
      if (ch.kind != "insert") {
        continue;
      }
      if (ch.line == l) {
        return -2;
      }
      if (ch.line < l) {
        m++;
      }
    }
  }
  return l - m;
}

// 操作で指したクリップの行（操作の前の番号）。指さない操作なら -1。
function opPrimaryLine(p: Project, a: string[]): i32 {
  if (a.length < 2) {
    return -1;
  }
  const n = opLower(a[0]);
  if (n == "add" || n == "cut") {
    return -1;
  }
  const i = findClip(p, a[1]);
  if (i < 0) {
    return -1;
  }
  return p.clips[i as usize].line;
}

// 操作の前（p）と後（np）で、時刻が変わったほかのクリップ。行は changes の足した行でずらして対応させる。
function opMovedClips(p: Project, np: Project, changes: Change[], skipLine: i32): Moved[] {
  let out: Moved[] = [];
  let maxLine: i32 = 0;
  for (const c of p.clips) {
    if (c.line > maxLine) {
      maxLine = c.line;
    }
  }
  let byLine: i32[] = [];
  for (let l: i32 = 0; l <= maxLine; l++) {
    byLine.push(-1);
  }
  for (let i: usize = 0; i < p.clips.length; i++) {
    byLine[p.clips[i].line as usize] = i as i32;
  }
  for (const nc of np.clips) {
    let inserted = false;
    let shift = 0;
    for (const ch of changes) {
      if (ch.kind != "insert") {
        continue;
      }
      if (ch.line == nc.line) {
        inserted = true;
      } else if (ch.line < nc.line) {
        shift++;
      }
    }
    if (inserted) {
      continue;
    }
    const ol = nc.line - shift;
    if (ol == skipLine || ol < 0 || ol > maxLine || byLine[ol as usize] < 0) {
      continue;
    }
    const oc = byLine[ol as usize] as usize;
    const bs = p.clips[oc].at;
    const be = bs + p.clips[oc].dur;
    const as_ = nc.at;
    const ae = as_ + nc.dur;
    if (Math.abs(bs - as_) > 0.0005 || Math.abs(be - ae) > 0.0005) {
      out.push({ id: nc.id.clone(), line: nc.line, beforeStart: bs, beforeEnd: be, afterStart: as_, afterEnd: ae });
    }
  }
  return out;
}

// moved を人向けの文にする（「ほかに 3 個のクリップの時刻が変わりました: clip_a 2→0 秒、…」）。
function opMovedText(moved: Moved[]): string {
  if (moved.length == 0) {
    return "";
  }
  let s = "";
  const shown = Math.min(moved.length, 6);
  for (let i: usize = 0; i < shown; i++) {
    let name = moved[i].id.clone();
    if (name == "") {
      name = `${moved[i].line} 行目`;
    }
    if (s != "") {
      s = s + "、";
    }
    if (Math.abs(moved[i].beforeStart - moved[i].afterStart) > 0.0005) {
      s = s + `${name} ${secText(moved[i].beforeStart)}→${secText(moved[i].afterStart)} 秒`;
    } else {
      s = s + `${name} の終わり ${secText(moved[i].beforeEnd)}→${secText(moved[i].afterEnd)} 秒`;
    }
  }
  if (moved.length > shown) {
    s = s + ` …ほか ${moved.length - shown} 個`;
  }
  return `ほかに ${moved.length} 個のクリップの時刻が変わりました: ${s}`;
}

// 操作を順に適用する。各操作の後に読み直し、誤りが増えたらそこで止める（ok=false、lines は元のまま）。
export function runOps(lines: string[], probes: Probe[], ops: string[][]): BatchResult {
  let cur = opCopyLines(lines);
  let diags: Diag[] = [];
  let p = opParse(cur, probes, mut diags);
  let results: OpResult[] = [];
  let failed = false;
  for (const a of ops) {
    let name = "";
    if (a.length > 0) {
      name = a[0].clone();
    }
    if (isOpName(name)) {
      name = opLower(name);
    }
    let r = opNewResult(name);
    let next = opCopyLines(cur);
    let copies: i32[] = [];
    opApply(mut next, p, probes, a, mut r, mut copies);
    if (r.ok) {
      let nd: Diag[] = [];
      const np = opParse(next, probes, mut nd);
      const bad = opNewError(diags, nd, r.changes, copies);
      if (bad >= 0) {
        const b = bad as usize;
        // 返す lines は元のままなので、行番号は元の lines の番号で書く
        let where = "ファイル全体";
        if (nd[b].line > 0) {
          const ol = opOrigLine(nd[b].line, r.changes, results);
          if (ol == -1) {
            where = "この操作で足すはずだった行";
          } else if (ol == -2) {
            where = "前の操作で足すはずだった行";
          } else {
            where = `${ol} 行目`;
          }
        }
        let hint = nd[b].hint.clone();
        if (hint == "") {
          hint = "値や参照を確かめてからやり直します";
        }
        if (nd[b].code == "unknown-ref") {
          // 参照が切れたのは操作のせいなので、別のクリップの名前を勧めない
          hint = "参照している行の at= を秒にするか（move <クリップ> <秒>）、参照先のクリップを残します";
        }
        opFail(mut r, nd[b].code, `この操作で誤りが増えるため、適用しませんでした（${where}: ${nd[b].msg}）`, hint);
        let nd1: Diag = { code: nd[b].code.clone(), severity: nd[b].severity.clone(), line: nd[b].line, col: nd[b].col, msg: nd[b].msg.clone(), hint: "", suggest: "" };
        nd1.hint = hint.clone();
        nd1.suggest = hintSuggest(hint);
        if (nd1.line > 0) {
          const ol = opOrigLine(nd1.line, r.changes, results);
          nd1.line = Math.max(ol, 0);
          if (ol <= 0) {
            nd1.col = 0;
          }
        }
        r.newDiagnostics.push(nd1);
        // lines は元のままなので、説明と変更は返さない
        r.desc = "";
        r.changes.clear();
      } else {
        r.moved = opMovedClips(p, np, r.changes, opPrimaryLine(p, a));
        const mt = opMovedText(r.moved);
        if (mt != "" && r.desc != "") {
          r.desc = r.desc + `。${mt}`;
        }
        // それまでの結果の行番号を、この操作で足した行の分だけずらす
        for (const ch of r.changes) {
          if (ch.kind != "insert") {
            continue;
          }
          for (let q: usize = 0; q < results.length; q++) {
            for (let m: usize = 0; m < results[q].changes.length; m++) {
              if (results[q].changes[m].line >= ch.line) {
                results[q].changes[m].line = results[q].changes[m].line + 1;
              }
            }
          }
        }
        results.push(r);
        cur = next;
        p = np;
        diags = nd;
        continue;
      }
    }
    results.push(r);
    failed = true;
    break;
  }
  if (failed) {
    // バッチは丸ごと適用しないので、失敗より前の結果も「適用していない」と分かるようにする
    // （ok=false、code "not-applied"、changes は空）。編集画面が取り消しの履歴に積まないように。
    const nf = results.length;
    const failName = results[nf - 1].op.clone();
    for (let q: usize = 0; q + 1 < nf; q++) {
      results[q].ok = false;
      results[q].code = "not-applied";
      results[q].error = `あとの ${nf} 番目の操作（${failName}）が失敗したので、この操作も適用しませんでした`;
      results[q].hint = "失敗した操作を直してから、まとめてやり直します";
      results[q].desc = "";
      results[q].newId = "";
      results[q].changes.clear();
      results[q].moved.clear();
    }
    let od: Diag[] = [];
    opParse(lines, probes, mut od);
    return { ok: false, results, lines: opCopyLines(lines), diags: od };
  }
  return { ok: true, results, lines: cur, diags };
}
