  tpScene("fountain",
    "emit=point x=320 y=330 rate=400 speed=330 speed.var=0.25 dir=-90 spread=22 gravity=420 life=2 life.var=0.3 size=7 size.end=2 color=ffd27a color.end=ff3a1a opacity.out=0.4 draw=soft blend=add seed=7",
    3.0, dir, 0);
  tpScene("burst",
    "emit=circle radius=30 emit.edge dir.mode=out spread=10 burst=1500 rate=0 speed=230 speed.var=0.5 drag=1.5 life=2.5 life.var=0.2 size=14 size.end=5 color=a0e0ff color.end=3050ff draw=star spin=180 rot.var=45 seed=3",
    1.2, dir, 0);
  tpScene("smoke",
    "emit=box x=320 y=345 emit.w=220 emit.h=16 rate=90 speed=60 dir=-90 spread=20 turb=160 turb.scale=110 turb.speed=0.4 life=4 life.var=0.25 size=26 size.end=110 color=a0a0a8c0 color.end=60606840 opacity.in=0.15 opacity.out=0.5 draw=soft blend=over wind=12 seed=11 prewarm=3",
    2.0, dir, 0);
  tpScene("snow",
    "emit=line x=0 y=0 x2=640 y2=0 rate=160 speed=35 dir=90 spread=30 gravity=15 drag=0.2 turb=60 turb.scale=70 life=9 size=3 size.var=0.6 draw=point color=ffffff opacity.out=0.1 prewarm=8 seed=5",
    1.0, dir, 0);
  tpScene("layer",
    "emit=layer layer=logo rate=6000 speed=25 spread=360 life=0.9 life.var=0.4 turb=500 turb.scale=30 turb.speed=1 size=3 size.end=1 color=66ffcc color.end=2060ff opacity.out=0.6 draw=soft blend=add seed=9 prewarm=1",
    1.0, dir, 1);
  tpScene("sprites",
    "emit=box x=320 y=180 emit.w=560 emit.h=300 rate=25 speed=40 spread=360 life=3 size=46 size.var=0.4 size.end=20 spin=90 spin.var=1 rot.var=180 color=ffffff opacity.in=0.2 opacity.out=0.4 draw=image sprite=diamond.png blend=over seed=21 prewarm=3",
