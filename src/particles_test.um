// パーティクル（src/m6_particles/particles.um）の試験と計測。tests/m6-particles/run.mjs が作って動かす。
//
//   particles_test scenes <出力フォルダ>   6 つの場面を描いて PNG に書き、検算値を出す
//   particles_test seek                    シークの道筋（頭から・1 コマずつ・戻ってから）で同じ状態になるか
//   particles_test diag                    設定の誤りの診断
//   particles_test fixes [<出力フォルダ>]   指摘を直したことの確かめ（trim・sprite・fps・prewarm・あふれ・加算の層・診断）
//   particles_test bigseek                 長いシークの時間と、まとめた dispatch の結果、区切りの予算
//   particles_test perf [<出力フォルダ>]    1920x1080 の 1 コマの時間
//
// 出力は 1 行に 1 件の「名前 key=value ...」。CPU（UM_GPU=0）と GPU（UM_GPU_THRESHOLD=1）で同じ行になることを run.mjs が確かめる。
import {
  PtSpec, PtSim, PtRender, PtDiag, ptParseLine, ptResolveSpec, ptNewSim, ptNewRender, ptSimSeek, ptSimStep, ptDraw,
  ptSimAlive, ptSimChecksum, ptAccChecksum, ptSimSetLayer, ptRenderSetSprite, ptDescribe, ptKeyInfos, ptDrawLayer,
  PtCache, ptNewCache, ptCacheFrame, ptCacheDraw, ptCacheChecksum, ptCacheStepsRun, ptCacheNeedsLayer, ptCacheSetLayer,
  ptCacheCap, ptCacheNeedsSprite, ptCacheSetSprite, ptAccAt, ptAddLayer, ptCheckClip, ptCacheCheckpointBytes,
} from "./m6_particles/particles.um";
import { ptWritePng } from "./m6_particles/ptpng.um";

kernel function tpFill(i: u32, out: mut Buffer<vec4<f32>>, c: vec4<f32>): void {
  out[i] = c;
}

// 背景: 上から下への暗い色の階調
kernel function tpBackdrop(i: u32, out: mut Buffer<vec4<f32>>, w: u32, h: u32, top: vec4<f32>, bottom: vec4<f32>): void {
  const t = ((i / w) as f32) / (h as f32);
  out[i] = vec4(top.x + (bottom.x - top.x) * t, top.y + (bottom.y - top.y) * t, top.z + (bottom.z - top.z) * t, 1.0);
}

// レイヤーの形の試験用: 「M」の字と輪（不透明な画素から粒が出る）
kernel function tpLogo(i: u32, out: mut Buffer<vec4<f32>>, w: u32, h: u32): void {
  const x = (i % w) as f32;
  const y = (i / w) as f32;
  let a: f32 = 0.0;
  // 輪（中心 (h/2, h/2)、半径 h*0.4、太さ 10）
  const cx = (h as f32) * 0.5;
  const cy = (h as f32) * 0.5;
  const r = Math.sqrt((x - cx) * (x - cx) + (y - cy) * (y - cy));
  if (Math.abs(r - (h as f32) * 0.4) < 6.0) {
    a = 1.0;
  }
  // M（右側）
  const mx = x - (h as f32) * 1.1;
  const top = (h as f32) * 0.15;
  const bot = (h as f32) * 0.85;
  const mw = (h as f32) * 0.9;
  if (y >= top && y <= bot && mx >= 0 && mx <= mw) {
    const u = mx / mw;
    const v = (y - top) / (bot - top);
    if (u < 0.12 || u > 0.88) {
      a = 1.0;
    }
    // 斜めの 2 本
    const d1 = Math.abs(v - u * 2.0 * 0.6);
    const d2 = Math.abs(v - (1.0 - u) * 2.0 * 0.6);
    if ((u <= 0.5 && d1 < 0.08) || (u >= 0.5 && d2 < 0.08)) {
      a = 1.0;
    }
  }
  out[i] = vec4(1.0, 1.0, 1.0, a);
}

// 画像の粒の試験用: 色のついたひし形
kernel function tpDiamond(i: u32, out: mut Buffer<vec4<f32>>, n: u32): void {
  const x = ((i % n) as f32 + 0.5) / (n as f32) * 2.0 - 1.0;
  const y = ((i / n) as f32 + 0.5) / (n as f32) * 2.0 - 1.0;
  const d = Math.abs(x) + Math.abs(y);
  let a: f32 = 0.0;
  if (d < 0.9) {
    a = 1.0;
  } else if (d < 1.0) {
    a = (1.0 - d) * 10.0;
  }
  out[i] = vec4(0.5 + x * 0.5, 0.6, 0.5 - y * 0.5, a);
}

function tpHex(v: u64): string {
  const digits = "0123456789abcdef";
  let b: u8[] = [];
  for (let k = 15; k >= 0; k--) {
    b.push(digits[((v >> ((k * 4) as u64)) & 15) as usize]);
  }
  return stringFromBytes(b);
}

function tpSpec(line: string, w: i32, h: i32): PtSpec {
  let diags: PtDiag[] = [];
  const s = ptParseLine(line, mut diags);
  for (const d of diags) {
    print(`spec-error ${d.code} ${d.key} ${d.msg}`);
  }
  return ptResolveSpec(s, w, h);
}

function tpScene(name: string, line: string, t: f64, dir: string, kind: i32): void {
  const w: u32 = 640;
  const h: u32 = 360;
  const s = tpSpec(line, w as i32, h as i32);
  let sim = ptNewSim(s, 10.0);
  let r = ptNewRender(w, h);
  let canvas = new Buffer<vec4<f32>>(w * h);
  dispatch(tpBackdrop, w * h, mut canvas, w, h, vec4(0.02, 0.02, 0.06, 1.0), vec4(0.08, 0.05, 0.12, 1.0));
  if (kind == 1) {
    // レイヤーの形から出す
    const lw: u32 = 400;
    const lh: u32 = 160;
    let logo = new Buffer<vec4<f32>>(lw * lh);
    dispatch(tpLogo, lw * lh, mut logo, lw, lh);
    ptSimSetLayer(mut sim, logo, lw, lh, 120, 100, 0.5);
  } else if (kind == 2) {
    const n: u32 = 48;
    let img = new Buffer<vec4<f32>>(n * n);
    dispatch(tpDiamond, n * n, mut img, n);
    ptRenderSetSprite(mut r, img, n, n);
  }
  ptSimSeek(mut sim, t);
  ptDraw(sim, mut r, mut canvas, 1.0);
  const alive = ptSimAlive(sim);
  print(`scene ${name} t=${t} cap=${sim.cap} alive=${alive} state=${tpHex(ptSimChecksum(sim))} acc=${tpHex(ptAccChecksum(r))}`);
  if (dir != "") {
    ptWritePng(`${dir}/${name}.png`, canvas, w, h);
  }
}

