// コアのキーの一覧（schema・候補の提示・説明書に使う）。project.um の読み取りはこの表で値の形と範囲を確かめるので、
// 表と読み取りは必ず一致する。効果（プラグイン）のキーはここには書かない（src/gen/plugins.um の登録表にある）。
//
// kinds: どの行で使えるか。"project"、"video,image,..."（コンマ区切り）、"*"（project 以外のすべての行）。
// type: "time" / "number" / "int" / "color" / "pos" / "vec2" / "string" / "enum:a|b" / "flag"。
// キーフレーム（値@時刻 の列）で動かせるキーは src/m6_anim/anim.um の許可の表（animTypeForKey）で決まる。
// def: 既定値（人向けの表記。"" は「なし」）。min / max: 範囲（"" は制限なし）。数・整数・時間のときだけ使う。

import { shapeKeyInfos } from "./m6_shape/shape_spec.um";
import { taKeyInfos } from "./m6_textanim/ta_spec.um";
import { ptKeyInfos } from "./m6_particles/particles.um";

export struct KeyInfo {
  name: string;
  kinds: string;
  type: string;
  def: string;
  min: string;
  max: string;
  doc: string;
}

function keysAdd(out: mut KeyInfo[], name: string, kinds: string, type: string, def: string, min: string, max: string, doc: string): void {
  out.push({
    name: name.clone(),
    kinds: kinds.clone(),
    type: type.clone(),
    def: def.clone(),
    min: min.clone(),
    max: max.clone(),
    doc: doc.clone(),
  });
}

export function coreKeys(): KeyInfo[] {
  let out: KeyInfo[] = [];
  const VIS = "video,image,text,color";
  // 見える行のうち shape（ベクターの図形）も含むもの（位置・不透明度・描画モード）
  const VISS = "video,image,text,color,shape";
  const AV = "video,audio";

  // project の行
  keysAdd(mut out, "size", "project", "string", "1280x720", "", "", "画面の大きさ（幅x高さ。どちらも 16〜8192 の偶数）");
  keysAdd(mut out, "width", "project", "int", "1280", "16", "8192", "画面の幅（偶数）");
  keysAdd(mut out, "height", "project", "int", "720", "16", "8192", "画面の高さ（偶数）");
  keysAdd(mut out, "fps", "project", "string", "30", "", "", "1 秒のコマ数（30、29.97、30000/1001 のように書く。1〜240）");
  keysAdd(mut out, "rate", "project", "int", "48000", "8000", "192000", "音の標本化周波数（Hz）");
  keysAdd(mut out, "bg", "project", "color", "000000", "", "", "背景色");
  keysAdd(mut out, "duration", "project", "time", "", "0", "", "全体の長さ（省くと最後のクリップの終わりまで）");
  keysAdd(mut out, "dur", "project", "time", "", "0", "", "duration の別名");
  keysAdd(mut out, "output", "project", "string", "out.mp4", "", "", "書き出すファイル");
  keysAdd(mut out, "out", "project", "string", "out.mp4", "", "", "output の別名");
  keysAdd(mut out, "crf", "project", "int", "20", "0", "51", "x264 の画質（小さいほど高画質）");
  keysAdd(mut out, "preset", "project", "enum:ultrafast|superfast|veryfast|faster|fast|medium|slow|slower|veryslow|placebo", "medium", "", "", "x264 の速さの設定");
  keysAdd(mut out, "font", "project", "string", "", "", "", "文字のフォント（TrueType / TTC のパス。省くと既定の候補を探す）");
  keysAdd(mut out, "fontindex", "project", "int", "0", "0", "255", "TTC の中のフォントの番号");

  // クリップの行: 名前と配置
  keysAdd(mut out, "id", "*", "string", "", "", "", "クリップの名前（英字・数字・_・-。先頭は英字か _）。at= の参照や操作で使う");
  keysAdd(mut out, "src", "video,image,audio", "string", "", "", "", "素材のファイル（行の 2 番目に \"...\" で書いてもよい）");
  keysAdd(mut out, "track", "*", "int", "0", "0", "63", "トラック番号（大きいほど上に描く。既定は video / color / audio が 0、image が 1、text と shape が 2）");
  keysAdd(mut out, "at", "*", "time", "", "0", "", "タイムライン上の開始時刻か参照（intro.end、intro.start+1.5、intro.end-0.5、after:intro）。省くと同じトラックの前の行の後ろ");
  keysAdd(mut out, "in", AV, "time", "0", "0", "", "素材の使い始め");
  keysAdd(mut out, "out", AV, "time", "", "0", "", "素材の使い終わり");
  keysAdd(mut out, "dur", "*", "time", "", "0", "", "長さ（out の代わり。image / text / color は既定 5 秒、video / audio は素材の終わりまで）");
  keysAdd(mut out, "xfade", "*", "time", "0", "0", "", "前のクリップと重ねてクロスフェードする秒数");
  keysAdd(mut out, "timeremap", "video", "time", "", "0", "", "見せる素材の時刻（秒）。キーフレームで速さ・静止・逆再生（timeremap=\"0@0 2@1:ease 2@3 0@4\"）。ふつうの値ならその時刻で止める");

  // 位置と見た目
  keysAdd(mut out, "x", VISS, "pos", "center", "", "", "左の位置（center か数。負の数は右端からの距離）");
  keysAdd(mut out, "y", VISS, "pos", "center", "", "", "上の位置（center か数。負の数は下端からの距離）");
  keysAdd(mut out, "pos", VIS, "vec2", "", "", "", "左上の位置 x,y（画素。負も可で、center や右端からの読み替えはしない）。キーフレームで経路を描くときに使う（pos=\"100,100@0 640,360@1:curve\"）");
  keysAdd(mut out, "w", "video,image,color", "int", "0", "0", "16384", "幅（0 は自動。片方だけなら縦横比を保つ）");
  keysAdd(mut out, "h", "video,image,color", "int", "0", "0", "16384", "高さ（0 は自動。片方だけなら縦横比を保つ）");
  keysAdd(mut out, "fit", "video,image", "enum:contain|cover|stretch", "contain", "", "", "w と h の枠への合わせ方（収める / 切り抜いて埋める / 引き伸ばす）");
  keysAdd(mut out, "opacity", VISS + ",particles", "number", "1", "0", "1", "不透明度");
  keysAdd(mut out, "fade", "*", "time", "0", "0", "", "フェードイン・アウトの秒数（映像と音の両方）");
  keysAdd(mut out, "fadein", "*", "time", "0", "0", "", "フェードインの秒数（映像と音の両方）");
  keysAdd(mut out, "fadeout", "*", "time", "0", "0", "", "フェードアウトの秒数（映像と音の両方）");
  keysAdd(mut out, "afadein", AV, "time", "0", "0", "", "音だけのフェードインの秒数");
  keysAdd(mut out, "afadeout", AV, "time", "0", "0", "", "音だけのフェードアウトの秒数");

  // 音
  keysAdd(mut out, "volume", AV, "number", "1", "0", "10", "音量");
  keysAdd(mut out, "vol", AV, "number", "1", "0", "10", "volume の別名");
  keysAdd(mut out, "mute", AV, "flag", "0", "", "", "音を使わない（mute とだけ書いてもよい）");

  // 文字と色
  keysAdd(mut out, "color", "text,color", "color", "ffffff", "", "", "文字の色（color の行では塗る色。行の 2 番目にも書ける）");
  keysAdd(mut out, "bg", "text", "color", "transparent", "", "", "文字の背景の箱の色");
  keysAdd(mut out, "pad", "text", "int", "0", "0", "1000", "背景の箱の余白（画素）");
  keysAdd(mut out, "shadow", "text", "color", "transparent", "", "", "影の色（ずらす量は size/16）");
  keysAdd(mut out, "size", "text", "int", "48", "4", "1000", "文字の大きさ（画素。フォントの em の大きさ）");
  keysAdd(mut out, "outline", "text", "color", "transparent", "", "", "縁取りの色");
  keysAdd(mut out, "outlinew", "text", "number", "size/14", "0", "200", "縁取りの太さ（画素）");
  keysAdd(mut out, "align", "text", "enum:left|center|right", "center", "", "", "複数行の揃え");

  // 描画モードとトラックマット（src/m6_blend/spec.um の mblCoreKeys と同じ。値は mblClipSpec / mblProjectSpec が
  // 別名や大文字も受けて確かめるので、型は string。tools/gen-plugins.mjs がこの keysAdd から名前を読むので、ここに書く）
  keysAdd(mut out, "blend", VISS, "string", "normal", "", "",
    "描画モード（normal / add / multiply / screen / overlay / softlight / hardlight / lighten / darken / difference / exclusion / hue / saturation / color / luminosity）");
  keysAdd(mut out, "blend.space", "project," + VISS, "string", "display", "", "",
    "描画モードを計算する値（display: 表示の値のまま。linear: blend.tf で線形の光に戻して混ぜる）。クリップの既定は project の値");
  keysAdd(mut out, "blend.tf", "project", "string", "bt1886", "", "",
    "線形の光に戻す伝達関数（bt1886: γ2.4、映像の既定 / srgb: 画像・Web の素材が中心のとき / bt709: カメラの OETF の逆）");
  keysAdd(mut out, "matte", VISS, "string", "", "", "", "トラックマットの元のクリップの ID（そのクリップは画面に描かず、マットにだけ使う）");
  keysAdd(mut out, "matte.type", VISS, "string", "alpha", "", "", "トラックマットの種類（alpha: 元のアルファ / luma: 元の輝度 × アルファ）");
  keysAdd(mut out, "matte.invert", VISS, "string", "0", "", "", "トラックマットを反転する（matte.invert とだけ書いてもよい。=1 / =0 も可）");

  // shape の行の形のキー（src/m6_shape/shape_spec.um の shapeKeyInfos。tools/gen-plugins.mjs は shKey(...) から名前を読む）
  for (const k of shapeKeyInfos()) {
    keysAdd(mut out, k.name, "shape", k.type, k.def, k.min, k.max, k.doc);
  }

  // text の行のテキストアニメーター（src/m6_textanim/ta_spec.um の taKeyInfos。anim / anim.<引数> / animout ...）
  for (const k of taKeyInfos()) {
    keysAdd(mut out, k.name, k.kinds, k.type, k.def, k.min, k.max, k.doc);
  }

  // particles の行のキー（src/m6_particles/particles.um の ptKeyInfos。x / y / color / size も発生源の位置・粒の色・大きさ）
  for (const k of ptKeyInfos()) {
    keysAdd(mut out, k.name, "particles", k.type, k.def, k.min, k.max, k.doc);
  }
  return out;
}
