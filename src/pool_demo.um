// メディアプール（素材の欄）とスタート画面の見本。モックアップ（docs/design/mockups/edit.html の左の欄、start.html）と同じ状態を出す。
//
//   node <UM>/src/cli.ts build src/pool_demo.um --target host -o build/pool-demo
//   build/pool-demo [--state pool|pool-list|pool-cols|pool-empty|pool-ai|pool-thumbs|pool-long|start|start-first|start-list]
//                   [--size 1440x900] [--scale 1.0] [--tokens docs/design/tokens.json]
//                   [--frames N] [--shot x.bmp]
//                   [--move x,y@F] [--click x,y@F] [--dbl x,y@F] [--rclick x,y@F] [--key 名前@F] [--type 文字@F] [--wheel d@F]
//                   （--key の名前: enter esc tab up down left right home end pgup pgdn delete space f1〜f12 と 1 文字。
//                     前に shift+ ctrl+ を付けられる。例: --key shift+f10@3）
//                   [--dragover x,y@F] [--drop 場所@F]      窓の外からのドロップのまね（SDL3 のドロップの組み込みの代わり）
//
// 起動するときは SDL_VIDEO_DRIVER=offscreen を付ける（試しで利用者の画面に窓を出さない）。
import {
  UkCtx, ukNew, ukBegin, ukEnd, ukWantsFrame, ukDrawRect, ukDrawTextIn, ukToast, ukEventMouseMove, ukEventMouseButton,
  ukEventKey, ukEventText, ukEventWheel, UK_KEY_TAB, UK_KEY_ENTER, UK_KEY_ESC, UK_KEY_BACKSPACE, UK_KEY_DELETE,
  UK_KEY_LEFT, UK_KEY_RIGHT, UK_KEY_UP, UK_KEY_DOWN, UK_KEY_HOME, UK_KEY_END, UK_KEY_SPACE, UK_KEY_CHAR, UK_MOD_SHIFT,
  UK_KEY_F, UK_KEY_PGUP, UK_KEY_PGDN,
  UK_MOD_CTRL, ukSetFont, ukSetFallbackFont, UK_FONT_SEMIBOLD, UK_FONT_MONO,
} from "./ui/kit/core.um";
import { UkRect, ukRect } from "./ui/kit/base.um";
import { ukThemeDefault, ukThemeFromTokens } from "./ui/kit/theme.um";
import { ukWinResNew, ukFeedWindowEvent } from "./ui/kit/window.um";
import { ukWriteBmp } from "./ui/kit/bmp.um";
import { uiFont, decodeUtf8, loadFont, Font } from "./effects/text/ttf.um";
import { PoolTk, poolTkDefault, poolTkFromTokens, POOL_K_VIDEO, POOL_K_AUDIO } from "./ui/pool/pool_tokens.um";
import {
  PoolLib, PoolState, PoolMedia, poolLibNew, poolStateNew, poolAddSmartBins, poolThumbsBegin, POOL_VIEW_LIST, POOL_COL_IMPORTED,
  POOL_COL_IN, POOL_COL_OUT, POOL_COL_LABEL,
} from "./ui/pool/pool_model.um";
import { PoolEv, poolPanel, POOL_DRAG_MEDIA } from "./ui/pool/pool_panel.um";
import {
  PoolDrag, poolDragNew, poolDropBegin, poolDropMove, poolDropAddPath, poolDropEnd, poolDropOver, poolDropPlan, poolDropNote,
  poolNewMedia,
} from "./ui/pool/pool_drop.um";
import {
  PoolStartState, PoolStartEv, PoolRecent, poolStartStateNew, poolStart, poolStartDropArea, poolStartDrop,
} from "./ui/pool/pool_start.um";
import {
  POOL_TH_SHOP, POOL_TH_HANDS, POOL_TH_STREET, POOL_TH_FACE, POOL_TH_STEAM, POOL_TH_NIGHT, POOL_TH_WAVE,
} from "./ui/pool/pool_draw.um";

// ---- 見本のデータ（モックアップと同じ素材） ----

function pdMedia(name: string, kind: i32, dur: f64, thumb: i32, used: f64, uses: i32, bin: i32, order: i64): PoolMedia {
  const isV = kind == POOL_K_VIDEO;
  let codec = "PCM";
  if (isV) {
    codec = "H.264";
  }
  return {
    id: `m${order}`, name: name.clone(), path: "media/" + name, kind, durSec: dur, fpsNum: isV ? 30 : 0, fpsDen: isV ? 1 : 0,
    w: isV ? 1920 : 0, h: isV ? 1080 : 0, codec, note: "", usedFrac: used, useCount: uses, offline: false,
    proxy: false, thumbReady: true, label: -1, importedAt: 1795200000 + order * 60, inSec: -1.0, outSec: -1.0, bin,
    aiPicked: false, aiWhy: "", aiAccepted: false, thumb,
  };
}

function pdLib(): PoolLib {
  let lib = poolLibNew();
  lib.bins.push({ name: "インタビュー", smart: 0 });
  lib.bins.push({ name: "Bロール", smart: 0 });
  lib.bins.push({ name: "音", smart: 0 });
  poolAddSmartBins(mut lib);
  lib.recentSince = 1795200000 + 100 * 60;
  lib.media.push(pdMedia("オープニング_店先.mp4", POOL_K_VIDEO, 12.0, POOL_TH_SHOP, 0.8, 1, 1, 0));
  lib.media.push(pdMedia("仕込み_手元.mp4", POOL_K_VIDEO, 41.0, POOL_TH_HANDS, 0.4, 1, 1, 1));
  lib.media.push(pdMedia("店主インタビュー_A.mp4", POOL_K_VIDEO, 362.0, POOL_TH_FACE, 0.15, 2, 0, 2));
  lib.media.push(pdMedia("店主インタビュー_B.mp4", POOL_K_VIDEO, 287.0, POOL_TH_FACE, 0.1, 1, 0, 3));
  lib.media.push(pdMedia("豆腐を切る_寄り.mp4", POOL_K_VIDEO, 18.0, POOL_TH_HANDS, 0.6, 1, 1, 4));
  lib.media.push(pdMedia("商店街_夕方.mp4", POOL_K_VIDEO, 33.0, POOL_TH_STREET, 0.3, 1, 1, 5));
  lib.media.push(pdMedia("湯気_スロー.mp4", POOL_K_VIDEO, 9.0, POOL_TH_STEAM, 0.9, 1, 1, 6));
  let oku = pdMedia("店の奥.mp4", POOL_K_VIDEO, 21.0, POOL_TH_SHOP, 0.0, 1, 1, 7);
  oku.offline = true;
  lib.media.push(oku);
  lib.media.push(pdMedia("大豆を洗う.mp4", POOL_K_VIDEO, 26.0, POOL_TH_HANDS, 0.0, 0, 1, 8));
  lib.media.push(pdMedia("常連さん.mp4", POOL_K_VIDEO, 75.0, POOL_TH_FACE, 0.0, 0, 0, 9));
  lib.media.push(pdMedia("商店街の音.wav", POOL_K_AUDIO, 95.0, POOL_TH_WAVE, 0.5, 1, 2, 10));
  lib.media.push(pdMedia("包丁の音.wav", POOL_K_AUDIO, 14.0, POOL_TH_WAVE, 0.7, 1, 2, 11));
  lib.media.push(pdMedia("夕方の雑踏.wav", POOL_K_AUDIO, 48.0, POOL_TH_WAVE, 0.0, 0, 2, 12));
  lib.media.push(pdMedia("朝の光（BGM）.wav", POOL_K_AUDIO, 184.0, POOL_TH_WAVE, 0.5, 1, 2, 13));
  return lib;
}

function pdRecent(title: string, sub: string, path: string, t: i64, w: i32, h: i32, fps: i32, dur: f64, thumb: i32): PoolRecent {
  return {
    title: title.clone(), sub: sub.clone(), path: path.clone(), modifiedAt: t, w, h, fpsNum: fps, fpsDen: 1, durSec: dur, thumb, kinds: [5.0, 9.0, 1.0, 0.0, 0.0],
    errors: 0, warns: 0, offline: 0, extChanged: false, aiPending: 0,
  };
}

