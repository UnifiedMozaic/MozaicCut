// モーショントラッキング（M6）: 追跡の結果（.trk のテキスト、JSON、人向けの要約）と、コマごとの変換。
//
// .trk は 1 行目が設定、2 行目から 1 行に 1 コマ。.mzc と同じ key=value の書き方なので、人も AI も読めて、手で直せる。
// .mzc の motion= と取り違えないよう、設定の行は motion で始める（.mzc の track= はトラック番号）。
//
//   # MozaicCut の追跡データ（M6 motion）
//   motion version=2 src="clip0.y4m" size=960x540 srcsize=1920x1080 fps=30/1 in=10 at=12.5 frames=3 points=2 names=p0,p1 srcpts="812,440;1210,460" feature=15 search=32 adapt=0.9 minconf=0.5 regrabs=0
//   f=0 p0=100,200,1,ok p1=300,200,1,ok
//   f=1 p0=101.25,200.5,0.9987,ok p1=301.25,200.5,0.9979,ok
//
// - size は追った映像（展開した Y4M）の大きさで、点の値はその画素の座標。srcsize は素材の大きさ（分からなければ 0x0）、
//   srcpts は .mzc の motion= に書いた点（素材の画素）。どちらも、今の行と比べて追い直すかを決める（trkDataStale）。
// - at は追い始めたコマの素材の時刻（秒）、in は追ったときの展開の始まり（素材の秒。render.um の Media.inPt、<cache>.in）。
//   展開を作り直して in が変わっても、at から今の展開のコマの番号を求めて使える（trkCacheFrame）。
// - f は追い始めたコマを 0 とする番号（at からのコマの数）。
// 点の値は「x,y,信頼度,状態」。状態は ok / low（模様を取り直した）/ lost（見失った）/ edge（探す範囲の端・広げて見つけた）/
// out（画面の外に出た。その後は止めた位置）。
import { sub, parseNum, splitBy, textNum } from "../text.um";
import { TrkTracker, TRK_OK, TRK_LOW, TRK_LOST, TRK_EDGE, TRK_OUT, trkUsable, trkWorkPerFrame, TRK_SLOW_WORK } from "./trk_point.um";
import {
  TRK_MODE_POSITION, TRK_MODE_SIMILARITY, TRK_MODE_PERSPECTIVE, TRK_MODE_CORNERPIN, TRK_PI,
  trkIdentity, trkTranslate, trkSimilarity2, trkHomography4, trkMatMul, trkApplyX, trkApplyY, trkLocalScale, trkLocalAngle,
} from "./trk_xform.um";

export const TRK_DATA_VERSION: i32 = 2;

export struct TrkData {
  ok: bool;
  // 読めなかったときの理由（日本語）と行
  err: string;
  errLine: i32;
  src: string;
  // 追った映像（展開した Y4M）の大きさ。点の値はこの画素の座標
  w: i32;
  h: i32;
  // 素材の大きさ（分からなければ 0）
  srcW: i32;
  srcH: i32;
  // .mzc の motion= に書いた点（素材の画素の座標、"x,y;x,y"）
  srcPts: string;
  fpsNum: i32;
  fpsDen: i32;
  // 追ったときの展開の始まり（素材の秒）と、追い始めたコマのその展開での番号
  cacheIn: f64;
  first: i64;
  frames: i64;
  n: u32;
  names: string[];
  feature: i32;
  search: i32;
  adapt: f64;
  minConf: f64;
  regrabs: i32;
  hx: f64[];
  hy: f64[];
  hc: f64[];
  hs: i32[];
}

export function trkEmptyData(): TrkData {
  return {
    ok: false, err: "", errLine: 0, src: "", w: 0, h: 0, srcW: 0, srcH: 0, srcPts: "", fpsNum: 30, fpsDen: 1,
    cacheIn: 0.0, first: 0, frames: 0, n: 0, names: [],
    feature: 15, search: 32, adapt: 0.9, minConf: 0.5, regrabs: 0, hx: [], hy: [], hc: [], hs: [],
  };
}

// 追跡 t から作る。cacheIn は展開の始まり（素材の秒。分からなければ 0）、srcW / srcH は素材の大きさ（分からなければ 0）、
// srcPts は .mzc の motion= の文字列（なければ ""）。
export function trkDataFrom(
  t: TrkTracker, src: string, fpsNum: i32, fpsDen: i32, cacheIn: f64, srcW: i32, srcH: i32, srcPts: string,
): TrkData {
  let d = trkEmptyData();
  d.ok = true;
  d.src = src.clone();
  d.w = t.w;
  d.h = t.h;
  d.srcW = srcW;
  d.srcH = srcH;
  d.srcPts = srcPts.clone();
  d.fpsNum = fpsNum;
  d.fpsDen = fpsDen;
  d.cacheIn = cacheIn;
  d.first = t.first;
  d.frames = t.frames;
  d.n = t.n;
  for (let p: u32 = 0; p < t.n; p++) {
    d.names.push(`p${p}`);
  }
  d.feature = t.o.feature;
  d.search = t.o.search;
  d.adapt = t.o.adapt;
  d.minConf = t.o.minConf;
  d.regrabs = t.regrabs;
  d.hx = t.hx.clone();
  d.hy = t.hy.clone();
  d.hc = t.hc.clone();
  d.hs = t.hs.clone();
  return d;
}

// ---- 時刻 ----

// 追い始めたコマの素材の時刻（秒）。
export function trkDataAt(d: TrkData): f64 {
  return d.cacheIn + (d.first as f64) * (d.fpsDen as f64) / (d.fpsNum as f64);
}

// 素材の時刻 at（秒）が、始まりが cacheIn（素材の秒）の展開の何コマ目か（いちばん近いコマ）。
export function trkFrameOfTime(at: f64, cacheIn: f64, fpsNum: i32, fpsDen: i32): i64 {
  return Math.floor((at - cacheIn) * (fpsNum as f64) / (fpsDen as f64) + 0.5) as i64;
}

// 追い始めたコマが、始まりが cacheIn の展開（今の展開）の何コマ目か。
export function trkCacheFrame(d: TrkData, cacheIn: f64): i64 {
  return trkFrameOfTime(trkDataAt(d), cacheIn, d.fpsNum, d.fpsDen);
}

// 描くときの追跡のコマ（f の番号）。render.um の drawVideo と同じ丸めで展開のコマ k を求め、追い始めたコマを引く。
//   lt: クリップの中の時刻（秒、t - c.at）、clipIn: クリップの in（c.inPt）、cacheIn: 今の展開の始まり（m.inPt。UNSET なら clipIn を渡す）。
// 小数のコマで補わない（映像のコマと同じコマの点を使う）。範囲の外は trkXformAtF が端のコマにする。
export function trkRenderFrame(d: TrkData, lt: f64, clipIn: f64, cacheIn: f64): f64 {
  const fps = (d.fpsNum as f64) / (d.fpsDen as f64);
  const k = Math.floor((lt + clipIn - cacheIn) * fps + 0.000001) as i64;
  return (k - trkCacheFrame(d, cacheIn)) as f64;
}

// ---- 名前 ----

export function trkStateName(s: i32): string {
  if (s == TRK_LOW) {
    return "low";
  }
  if (s == TRK_LOST) {
    return "lost";
  }
  if (s == TRK_EDGE) {
    return "edge";
  }
  if (s == TRK_OUT) {
    return "out";
  }
  return "ok";
}

function trkStateOf(s: string): i32 {
  if (s == "low") {
    return TRK_LOW;
  }
  if (s == "lost") {
    return TRK_LOST;
  }
  if (s == "edge") {
    return TRK_EDGE;
  }
  if (s == "out") {
    return TRK_OUT;
  }
  if (s == "ok") {
    return TRK_OK;
  }
  return -1;
}

export function trkModeName(mode: i32): string {
  if (mode == TRK_MODE_SIMILARITY) {
    return "similarity";
  }
  if (mode == TRK_MODE_PERSPECTIVE) {
    return "perspective";
  }
  if (mode == TRK_MODE_CORNERPIN) {
    return "cornerpin";
  }
  return "position";
}

// "position" / "similarity" / "perspective" / "cornerpin"（と短い別名）を読む。読めなければ -1。
// perspective は最初のコマでの置き方からの相対の動き、cornerpin は層の四隅を 4 点に貼る（After Effects のコーナーピン）。
export function trkModeOf(s: string): i32 {
  if (s == "position" || s == "pos" || s == "translate") {
    return TRK_MODE_POSITION;
  }
  if (s == "similarity" || s == "rotate" || s == "scale" || s == "all") {
    return TRK_MODE_SIMILARITY;
  }
  if (s == "perspective" || s == "planar") {
    return TRK_MODE_PERSPECTIVE;
  }
  if (s == "cornerpin" || s == "corner") {
    return TRK_MODE_CORNERPIN;
  }
  return -1;
}

// 点の数で決まる既定の変換（1 点: 位置、2〜3 点: 位置・拡大・回転、4 点以上: 平面）。
export function trkAutoMode(n: u32): i32 {
  if (n >= 4) {
    return TRK_MODE_PERSPECTIVE;
  }
  if (n >= 2) {
    return TRK_MODE_SIMILARITY;
  }
  return TRK_MODE_POSITION;
}

// 点の数で使えない変換は、使える中でいちばん近いものにする（cornerpin と perspective は 4 点から）。
export function trkFitMode(n: u32, mode: i32): i32 {
  if ((mode == TRK_MODE_PERSPECTIVE || mode == TRK_MODE_CORNERPIN) && n < 4) {
    return trkAutoMode(n);
  }
  if (mode == TRK_MODE_SIMILARITY && n < 2) {
    return TRK_MODE_POSITION;
  }
  return mode;
}

// 点の動きの変換の種類（cornerpin の点の動きは平面と同じ）。
function trkMotionMode(n: u32, mode: i32): i32 {
  const m = trkFitMode(n, mode);
  if (m == TRK_MODE_CORNERPIN) {
    return TRK_MODE_PERSPECTIVE;
  }
  return m;
}

function trkIdx(d: TrkData, k: i64, p: u32): usize {
  return (k as usize) * (d.n as usize) + (p as usize);
}

// ---- コマごとの変換 ----

// 点の位置 xs / ys（x0 / y0 と同じ並び、n 個）から、x0 → xs の変換を作る。
function trkXformFrom(n: u32, mode: i32, x0: f64[], y0: f64[], xs: f64[], ys: f64[]): f64[9] {
  const m = trkMotionMode(n, mode);
  if (n == 0) {
    return trkIdentity();
  }
  if (m == TRK_MODE_PERSPECTIVE) {
    let s: f64[8];
    let t: f64[8];
    for (let k: u32 = 0; k < 4; k++) {
      s[k * 2] = x0[k];
      s[k * 2 + 1] = y0[k];
      t[k * 2] = xs[k];
      t[k * 2 + 1] = ys[k];
    }
    const hm = trkHomography4(s, t);
    if (hm.ok) {
      return hm.m;
    }
    return trkSimilarity2(x0[0], y0[0], x0[1], y0[1], xs[0], ys[0], xs[1], ys[1]);
  }
  if (m == TRK_MODE_SIMILARITY) {
    return trkSimilarity2(x0[0], y0[0], x0[1], y0[1], xs[0], ys[0], xs[1], ys[1]);
  }
  // 位置: 点の重心の動き
  let dx: f64 = 0.0;
  let dy: f64 = 0.0;
  for (let p: u32 = 0; p < n; p++) {
    dx = dx + (xs[p] - x0[p]);
    dy = dy + (ys[p] - y0[p]);
  }
  return trkTranslate(dx / (n as f64), dy / (n as f64));
}

// コマ k のすべての点が使えるか（見失った・画面の外の点がない）。
function trkAllUsable(d: TrkData, k: i64): bool {
  for (let p: u32 = 0; p < d.n; p++) {
    if (!trkUsable(d.hs[trkIdx(d, k, p)])) {
      return false;
    }
  }
  return true;
}

// kf を 0..frames-1 に収めたもの。
function trkClampF(d: TrkData, kf: f64): f64 {
  return Math.min(Math.max(kf, 0.0), (d.frames - 1) as f64);
}

// コマ k0 以前で、すべての点が使える最後のコマ（なければ 0）。
function trkLastAllUsable(d: TrkData, k0: i64): i64 {
  let r = k0;
  while (r > 0 && !trkAllUsable(d, r)) {
    r--;
  }
  return r;
}

// 変換の本体。r は k0（kf の整数の部分）以前で、すべての点が使える最後のコマ。
// すべての点が使えるコマでは、最初のコマの点 → このコマの点で直接求める。
// 見失った・画面の外の点があるコマでは、T_r（コマ r までの変換）に、使える点だけで求めた「コマ r → このコマ」の変換 Δ を重ねる
// （T = Δ ∘ T_r）。使える点の数が足りなければ Δ の種類を下げる（平面 → 相似 → 位置）。1 点もなければ T_r を保つ。
// 使える点が変換に要る点そのものなら、直接求めたものと同じ行列になるので、点が外れても変換は飛ばない。
function trkXformWith(d: TrkData, mode: i32, kf: f64, r: i64): f64[9] {
  const f = trkClampF(d, kf);
  const k0 = Math.floor(f) as i64;
  let k1 = k0 + 1;
  if (k1 >= d.frames) {
    k1 = d.frames - 1;
  }
  const a = f - (k0 as f64);
  let x0: f64[] = [];
  let y0: f64[] = [];
  let xs: f64[] = [];
  let ys: f64[] = [];
  let good: bool[] = [];
  let all = true;
  for (let p: u32 = 0; p < d.n; p++) {
    x0.push(d.hx[trkIdx(d, 0, p)]);
    y0.push(d.hy[trkIdx(d, 0, p)]);
    const xa = d.hx[trkIdx(d, k0, p)];
    const ya = d.hy[trkIdx(d, k0, p)];
    xs.push(xa + (d.hx[trkIdx(d, k1, p)] - xa) * a);
    ys.push(ya + (d.hy[trkIdx(d, k1, p)] - ya) * a);
    const g = trkUsable(d.hs[trkIdx(d, k0, p)]) && trkUsable(d.hs[trkIdx(d, k1, p)]);
    good.push(g);
    if (!g) {
      all = false;
    }
  }
  if (all) {
    return trkXformFrom(d.n, mode, x0, y0, xs, ys);
  }
  let xr: f64[] = [];
  let yr: f64[] = [];
  for (let p: u32 = 0; p < d.n; p++) {
    xr.push(d.hx[trkIdx(d, r, p)]);
    yr.push(d.hy[trkIdx(d, r, p)]);
  }
  const tr = trkXformFrom(d.n, mode, x0, y0, xr, yr);
  let ux: f64[] = [];
  let uy: f64[] = [];
  let vx: f64[] = [];
  let vy: f64[] = [];
  for (let p: u32 = 0; p < d.n; p++) {
    if (good[p]) {
      ux.push(xr[p]);
      uy.push(yr[p]);
      vx.push(xs[p]);
      vy.push(ys[p]);
    }
  }
  const cnt = ux.length as u32;
  if (cnt == 0) {
    return tr;
  }
  const delta = trkXformFrom(cnt, trkMotionMode(d.n, mode), ux, uy, vx, vy);
  return trkMatMul(delta, tr);
}

// コマ k（first からの番号。範囲の外は端のコマ）の、最初のコマ → コマ k の変換。
export function trkXformAt(d: TrkData, mode: i32, k: i64): f64[9] {
  return trkXformAtF(d, mode, k as f64);
}

// コマの位置 kf（小数も可。前後のコマの点の位置を直線で補う）の変換。見失った・画面の外の点は使わない（trkXformWith）。
export function trkXformAtF(d: TrkData, mode: i32, kf: f64): f64[9] {
  if (d.frames <= 0 || d.n == 0) {
    return trkIdentity();
  }
  const k0 = Math.floor(trkClampF(d, kf)) as i64;
  return trkXformWith(d, mode, kf, trkLastAllUsable(d, k0));
}

// すべてのコマの変換（9 個ずつ並べる）。手ぶれ補正の smooth（trk_xform.um の trkSmooth）に渡す。
export function trkXformAll(d: TrkData, mode: i32): f64[] {
  let out: f64[] = [];
  let r: i64 = 0;
  for (let k: i64 = 0; k < d.frames; k++) {
    if (trkAllUsable(d, k)) {
      r = k;
    }
    const m = trkXformWith(d, mode, k as f64, r);
    for (let j = 0; j < 9; j++) {
      out.push(m[j]);
    }
  }
  return out;
}

// 付ける点（attach point）: 最初のコマの点の重心。JSON の dx / dy / scale / angle はこの点の動きとまわりの拡大・回転。
export function trkAttachX(d: TrkData): f64 {
  let s: f64 = 0.0;
  for (let p: u32 = 0; p < d.n; p++) {
    s = s + d.hx[p as usize];
  }
  return s / Math.max(d.n as f64, 1.0);
}

export function trkAttachY(d: TrkData): f64 {
  let s: f64 = 0.0;
  for (let p: u32 = 0; p < d.n; p++) {
    s = s + d.hy[p as usize];
  }
  return s / Math.max(d.n as f64, 1.0);
}

// 点 p のコマ kf の位置（前後のコマを直線で補う）。
export function trkPointX(d: TrkData, p: u32, kf: f64): f64 {
  const f = trkClampF(d, kf);
  const k0 = Math.floor(f) as i64;
  let k1 = k0 + 1;
  if (k1 >= d.frames) {
    k1 = d.frames - 1;
  }
  const a = d.hx[trkIdx(d, k0, p)];
  return a + (d.hx[trkIdx(d, k1, p)] - a) * (f - (k0 as f64));
}

export function trkPointY(d: TrkData, p: u32, kf: f64): f64 {
  const f = trkClampF(d, kf);
  const k0 = Math.floor(f) as i64;
  let k1 = k0 + 1;
  if (k1 >= d.frames) {
    k1 = d.frames - 1;
  }
  const a = d.hy[trkIdx(d, k0, p)];
  return a + (d.hy[trkIdx(d, k1, p)] - a) * (f - (k0 as f64));
}

// ---- 追い直すか ----

// .trk が今の .mzc の行・展開と合っているか。合っていなければ理由（日本語、警告 motion-stale の文）、合っていれば ""。
//   w / h: 今の展開の大きさ、srcW / srcH: 素材の大きさ（分からなければ 0）、srcPts: 今の motion= の文字列、
//   at: 今の motion.at（素材の秒）、feature / search / adapt / minConf: 今の設定、needFrames: 今のクリップで要るコマの数（at から out まで）。
export function trkDataStale(
  d: TrkData, w: i32, h: i32, srcW: i32, srcH: i32, srcPts: string, at: f64,
  feature: i32, search: i32, adapt: f64, minConf: f64, needFrames: i64,
): string {
  if (d.w != w || d.h != h) {
    return `追ったときの展開の大きさ ${d.w}x${d.h} と今の大きさ ${w}x${h} が違います`;
  }
  if (srcW > 0 && d.srcW > 0 && (d.srcW != srcW || d.srcH != srcH)) {
    return `追ったときの素材の大きさ ${d.srcW}x${d.srcH} と今の素材 ${srcW}x${srcH} が違います`;
  }
  if (d.srcPts != srcPts) {
    return `点（motion=）が追ったときの "${d.srcPts}" から変わりました`;
  }
  const half = 0.5 * (d.fpsDen as f64) / (d.fpsNum as f64);
  if (Math.abs(trkDataAt(d) - at) > half) {
    return `追い始めた時刻 ${textNum(trkDataAt(d))} 秒と今の motion.at ${textNum(at)} 秒が違います`;
  }
  if (d.feature != feature || d.search != search || Math.abs(d.adapt - adapt) > 1.0e-6 || Math.abs(d.minConf - minConf) > 1.0e-6) {
    return "追跡の設定（feature / search / adapt / minconf）が変わりました";
  }
  if (d.frames < needFrames) {
    return `追ったのは ${d.frames} コマで、今のクリップには ${needFrames} コマ要ります`;
  }
  return "";
}

// ---- .trk の書き出し ----

function trkPush(out: mut u8[], s: string): void {
  for (const b of s) {
    out.push(b);
  }
}

function trkQuote(s: string): string {
  let out: u8[] = [34];
  for (const b of s) {
    if (b == 34 || b == 92) {
      out.push(92);
    }
    out.push(b);
  }
  out.push(34);
  return stringFromBytes(out);
}

export function trkDataText(d: TrkData): u8[] {
  let out: u8[] = [];
  trkPush(mut out, "# MozaicCut の追跡データ（M6 motion）。1 行目が設定、2 行目から 1 行に 1 コマ（f は追い始めたコマからの番号）。点の値は x,y,信頼度,状態\n");
  let names = "";
  for (let p: u32 = 0; p < d.n; p++) {
    if (p > 0) {
      names = names + ",";
    }
    names = names + d.names[p];
  }
  trkPush(mut out, `motion version=${TRK_DATA_VERSION} src=${trkQuote(d.src)} size=${d.w}x${d.h} srcsize=${d.srcW}x${d.srcH} fps=${d.fpsNum}/${d.fpsDen}`);
  trkPush(mut out, ` in=${textNum(d.cacheIn)} at=${textNum(trkDataAt(d))} frames=${d.frames} points=${d.n} names=${names} srcpts=${trkQuote(d.srcPts)}`);
  trkPush(mut out, ` feature=${d.feature} search=${d.search} adapt=${textNum(d.adapt)} minconf=${textNum(d.minConf)} regrabs=${d.regrabs}\n`);
  for (let k: i64 = 0; k < d.frames; k++) {
    trkPush(mut out, `f=${k}`);
    for (let p: u32 = 0; p < d.n; p++) {
      const i = trkIdx(d, k, p);
      trkPush(mut out, ` ${d.names[p]}=${textNum(d.hx[i])},${textNum(d.hy[i])},${textNum(d.hc[i])},${trkStateName(d.hs[i])}`);
    }
    trkPush(mut out, "\n");
  }
  return out;
}

// ---- .trk の読み取り ----

// 空白で区切る（"..." の中の空白は区切らない。\" と \\ を戻す）。
function trkTokens(s: string): string[] {
  let out: string[] = [];
  let cur: u8[] = [];
  let inQ = false;
  let has = false;
  let i: usize = 0;
  while (i < s.length) {
    const b = s[i];
    if (inQ) {
      if (b == 92 && i + 1 < s.length) {
        cur.push(s[i + 1]);
        i += 2;
        continue;
      }
      if (b == 34) {
        inQ = false;
      } else {
        cur.push(b);
      }
    } else if (b == 34) {
      inQ = true;
      has = true;
    } else if (b == 32 || b == 9 || b == 13) {
      if (has || cur.length > 0) {
        out.push(stringFromBytes(cur));
        cur = [];
        has = false;
      }
    } else {
      cur.push(b);
    }
    i++;
  }
  if (has || cur.length > 0) {
    out.push(stringFromBytes(cur));
  }
  return out;
}

function trkEq(t: string): usize {
  for (let i: usize = 0; i < t.length; i++) {
    if (t[i] == 61) {
      return i;
    }
  }
  return t.length;
}

function trkFail(d: mut TrkData, line: i32, msg: string): void {
  if (d.err == "") {
    d.err = msg.clone();
    d.errLine = line;
  }
  d.ok = false;
}

// 有限の数か（NaN でも無限大でもない）。
function trkFinite(v: f64): bool {
  return v == v && v - v == 0.0;
}

// 点の名前に使えるか（英字・数字・_、1〜32 文字。f はコマの番号の key なので使えない）。
function trkNameOk(s: string): bool {
  if (s.length == 0 || s.length > 32 || s == "f") {
    return false;
  }
  for (const b of s) {
    const ok = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
    if (!ok) {
      return false;
    }
  }
  return true;
}

// 設定の行の数（有限でなければ失敗にする）。
function trkHeadNum(d: mut TrkData, line: i32, key: string, val: string): f64 {
  const v = parseNum(val);
  if (!trkFinite(v)) {
    trkFail(mut d, line, `${key}= の値 '${val}' が数として読めません`);
    return 0.0;
  }
  return v;
}

function trkJoin(a: string[]): string {
  let s = "";
  for (let i: usize = 0; i < a.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + a[i];
  }
  return s;
}

export function trkDataParse(bytes: u8[]): TrkData {
  let d = trkEmptyData();
  d.ok = true;
  let lineNo = 0;
  let start: usize = 0;
  let header = false;
  let gotNames = false;
  let at: f64 = 0.0;
  for (let i: usize = 0; i <= bytes.length; i++) {
    if (i < bytes.length && bytes[i] != 10) {
      continue;
    }
    lineNo++;
    let lb: u8[] = [];
    for (let j = start; j < i; j++) {
      lb.push(bytes[j]);
    }
    start = i + 1;
    const line = stringFromBytes(lb);
    const toks = trkTokens(line);
    if (toks.length == 0 || toks[0][0] == 35) {
      continue;
    }
    if (toks[0] == "motion") {
      if (header) {
        trkFail(mut d, lineNo, "motion の行が 2 つあります（設定の行は最初の 1 行だけです）");
        return d;
      }
      header = true;
      let version: i32 = 0;
      for (let k: usize = 1; k < toks.length; k++) {
        const e = trkEq(toks[k]);
        if (e >= toks[k].length) {
          trkFail(mut d, lineNo, `'${toks[k]}' は key=value の形ではありません`);
          return d;
        }
        const key = sub(toks[k], 0, e);
        const val = sub(toks[k], e + 1, toks[k].length);
        if (key == "version") {
          version = trkHeadNum(mut d, lineNo, key, val) as i32;
        } else if (key == "src") {
          d.src = val;
        } else if (key == "srcpts") {
          d.srcPts = val;
        } else if (key == "size" || key == "srcsize") {
          const wh = splitBy(val, 120);
          if (wh.length != 2) {
            trkFail(mut d, lineNo, `${key}= は 幅x高さ と書きます（'${val}'）`);
            return d;
          }
          const ww = trkHeadNum(mut d, lineNo, key, wh[0]) as i32;
          const hh = trkHeadNum(mut d, lineNo, key, wh[1]) as i32;
          if (key == "size") {
            d.w = ww;
            d.h = hh;
          } else {
            d.srcW = ww;
            d.srcH = hh;
          }
        } else if (key == "fps") {
          const nd = splitBy(val, 47);
          if (nd.length == 2) {
            d.fpsNum = trkHeadNum(mut d, lineNo, key, nd[0]) as i32;
            d.fpsDen = trkHeadNum(mut d, lineNo, key, nd[1]) as i32;
          } else {
            d.fpsNum = trkHeadNum(mut d, lineNo, key, val) as i32;
            d.fpsDen = 1;
          }
        } else if (key == "in") {
          d.cacheIn = trkHeadNum(mut d, lineNo, key, val);
        } else if (key == "at") {
          at = trkHeadNum(mut d, lineNo, key, val);
        } else if (key == "points") {
          d.n = trkHeadNum(mut d, lineNo, key, val) as u32;
        } else if (key == "names") {
          d.names = splitBy(val, 44);
          gotNames = true;
        } else if (key == "feature") {
          d.feature = trkHeadNum(mut d, lineNo, key, val) as i32;
        } else if (key == "search") {
          d.search = trkHeadNum(mut d, lineNo, key, val) as i32;
        } else if (key == "adapt") {
          d.adapt = trkHeadNum(mut d, lineNo, key, val);
        } else if (key == "minconf") {
          d.minConf = trkHeadNum(mut d, lineNo, key, val);
        } else if (key == "regrabs") {
          d.regrabs = trkHeadNum(mut d, lineNo, key, val) as i32;
        }
        // 知らない key は読み飛ばす（後の版で足した値）
        if (!d.ok) {
          return d;
        }
      }
      if (version != TRK_DATA_VERSION) {
        trkFail(mut d, lineNo, `version=${version} は読めません（この版は version=${TRK_DATA_VERSION}。mozcut motion で追い直します）`);
        return d;
      }
      if (d.w <= 0 || d.h <= 0) {
        trkFail(mut d, lineNo, "size= に追った映像の大きさ（幅x高さ）を書きます");
        return d;
      }
      if (d.fpsNum <= 0 || d.fpsDen <= 0) {
        trkFail(mut d, lineNo, "fps= は正の数で書きます（例: 30/1）");
        return d;
      }
      if (d.n == 0 || d.n > 16) {
        trkFail(mut d, lineNo, "points= は 1〜16 で書きます");
        return d;
      }
      if (gotNames) {
        if ((d.names.length as u32) != d.n) {
          trkFail(mut d, lineNo, `names= の名前の数 ${d.names.length} が points=${d.n} と合いません`);
          return d;
        }
        for (let p: u32 = 0; p < d.n; p++) {
          if (!trkNameOk(d.names[p])) {
            trkFail(mut d, lineNo, `点の名前 '${d.names[p]}' は使えません（英字・数字・_ で 1〜32 文字。f は使えません）`);
            return d;
          }
          for (let q: u32 = 0; q < p; q++) {
            if (d.names[q] == d.names[p]) {
              trkFail(mut d, lineNo, `点の名前 '${d.names[p]}' が 2 回あります`);
              return d;
            }
          }
        }
      } else {
        d.names = [];
        for (let p: u32 = 0; p < d.n; p++) {
          d.names.push(`p${p}`);
        }
      }
      d.first = trkFrameOfTime(at, d.cacheIn, d.fpsNum, d.fpsDen);
      continue;
    }
    if (toks[0] == "track") {
      trkFail(mut d, lineNo, "古い形式（track の行）の .trk です。mozcut motion で追い直します");
      return d;
    }
    if (!header) {
      trkFail(mut d, lineNo, "1 行目（注釈を除く）は motion の行でなければなりません");
      return d;
    }
    // コマの行: f=<番号> <名前>=x,y,c,状態 ...
    let gotF = false;
    let cnt: u32 = 0;
    let fx: f64[] = [];
    let fy: f64[] = [];
    let fc: f64[] = [];
    let fs: i32[] = [];
    let seen: bool[] = [];
    for (let p: u32 = 0; p < d.n; p++) {
      fx.push(0.0);
      fy.push(0.0);
      fc.push(0.0);
      fs.push(TRK_OK);
      seen.push(false);
    }
    for (const t of toks) {
      const e = trkEq(t);
      if (e >= t.length) {
        trkFail(mut d, lineNo, `'${t}' は key=value の形ではありません`);
        return d;
      }
      const key = sub(t, 0, e);
      const val = sub(t, e + 1, t.length);
      if (key == "f") {
        const f = parseNum(val);
        if (!trkFinite(f) || f != Math.floor(f) || (f as i64) != d.frames) {
          trkFail(mut d, lineNo, `コマの番号 f=${val} が続いていません（${d.frames} のはず）`);
          return d;
        }
        gotF = true;
        continue;
      }
      let pi: i32 = -1;
      for (let p: u32 = 0; p < d.n; p++) {
        if (d.names[p] == key) {
          pi = p as i32;
        }
      }
      if (pi < 0) {
        trkFail(mut d, lineNo, `'${key}' という点はありません（names= は ${trkJoin(d.names)}）`);
        return d;
      }
      if (seen[pi as usize]) {
        trkFail(mut d, lineNo, `点 ${key} が 2 回あります`);
        return d;
      }
      const parts = splitBy(val, 44);
      if (parts.length != 4) {
        trkFail(mut d, lineNo, `点 ${key} の値は x,y,信頼度,状態 の 4 つで書きます（'${val}'）`);
        return d;
      }
      const x = parseNum(parts[0]);
      const y = parseNum(parts[1]);
      const c = parseNum(parts[2]);
      if (!trkFinite(x) || !trkFinite(y)) {
        trkFail(mut d, lineNo, `点 ${key} の位置 '${parts[0]},${parts[1]}' が有限の数として読めません`);
        return d;
      }
      if (!trkFinite(c) || c < 0.0 || c > 1.0) {
        trkFail(mut d, lineNo, `点 ${key} の信頼度 '${parts[2]}' は 0〜1 の数で書きます`);
        return d;
      }
      const s = trkStateOf(parts[3]);
      if (s < 0) {
        trkFail(mut d, lineNo, `点 ${key} の状態 '${parts[3]}' は ok / low / lost / edge / out のどれかで書きます`);
        return d;
      }
      fx[pi as usize] = x;
      fy[pi as usize] = y;
      fc[pi as usize] = c;
      fs[pi as usize] = s;
      seen[pi as usize] = true;
      cnt++;
    }
    if (!gotF) {
      trkFail(mut d, lineNo, "コマの行に f= がありません");
      return d;
    }
    if (cnt != d.n) {
      trkFail(mut d, lineNo, "コマの行にすべての点の値がありません");
      return d;
    }
    for (let p: u32 = 0; p < d.n; p++) {
      d.hx.push(fx[p]);
      d.hy.push(fy[p]);
      d.hc.push(fc[p]);
      d.hs.push(fs[p]);
    }
    d.frames++;
  }
  if (!header) {
    trkFail(mut d, 0, "motion の行がありません");
  } else if (d.frames == 0) {
    trkFail(mut d, 0, "コマの行がありません");
  }
  return d;
}

export function trkDataLoad(path: string): TrkData {
  const b = readFile(path);
  if (b == null) {
    let d = trkEmptyData();
    d.err = `追跡データ ${path} を読めません`;
    return d;
  }
  return trkDataParse(b);
}

// ---- 要約（人向けの文と JSON） ----

export struct TrkSummary {
  meanConf: f64;
  minConf: f64;
  minPoint: u32;
  minFrame: i64;
  lowFrames: i32;
  lostFrames: i32;
  edgeFrames: i32;
  outFrames: i32;
}

// 信頼度の平均・最低は、追っている点（画面の外を除く）で数える。コマの番号は f（追い始めたコマが 0）。
export function trkSummarize(d: TrkData): TrkSummary {
  let s: TrkSummary = {
    meanConf: 0.0, minConf: 1.0, minPoint: 0, minFrame: 0, lowFrames: 0, lostFrames: 0, edgeFrames: 0, outFrames: 0,
  };
  let sum: f64 = 0.0;
  let cnt: f64 = 0.0;
  for (let k: i64 = 1; k < d.frames; k++) {
    let anyLow = false;
    let anyLost = false;
    let anyEdge = false;
    let anyOut = false;
    for (let p: u32 = 0; p < d.n; p++) {
      const i = trkIdx(d, k, p);
      if (d.hs[i] == TRK_OUT) {
        anyOut = true;
        continue;
      }
      sum = sum + d.hc[i];
      cnt = cnt + 1.0;
      if (d.hc[i] < s.minConf) {
        s.minConf = d.hc[i];
        s.minPoint = p;
        s.minFrame = k;
      }
      if (d.hs[i] == TRK_LOW) {
        anyLow = true;
      } else if (d.hs[i] == TRK_LOST) {
        anyLost = true;
      } else if (d.hs[i] == TRK_EDGE) {
        anyEdge = true;
      }
    }
    if (anyLow) {
      s.lowFrames++;
    }
    if (anyLost) {
      s.lostFrames++;
    }
    if (anyEdge) {
      s.edgeFrames++;
    }
    if (anyOut) {
      s.outFrames++;
    }
  }
  if (cnt > 0.0) {
    s.meanConf = sum / cnt;
  }
  return s;
}

// 見失ったコマの範囲を「p0 の 12〜15 コマ目」の形で並べる。all でなければ、fromStart が true なら f=1 から見失った範囲だけ、
// false ならそれ以外だけ。
function trkLostText(d: TrkData, json: bool, fromStart: bool, all: bool): string {
  let out = "";
  for (let p: u32 = 0; p < d.n; p++) {
    let k: i64 = 0;
    while (k < d.frames) {
      if (d.hs[trkIdx(d, k, p)] != TRK_LOST) {
        k++;
        continue;
      }
      const a = k;
      while (k < d.frames && d.hs[trkIdx(d, k, p)] == TRK_LOST) {
        k++;
      }
      if (!all && (a == 1) != fromStart) {
        continue;
      }
      if (out != "") {
        if (json) {
          out = out + ",";
        } else {
          out = out + "、";
        }
      }
      if (json) {
        out = out + `{"point":${trkJsonStr(d.names[p])},"from":${a},"to":${k - 1}}`;
      } else if (k - 1 == a) {
        out = out + `${d.names[p]} の ${a} コマ目`;
      } else {
        out = out + `${d.names[p]} の ${a}〜${k - 1} コマ目`;
      }
    }
  }
  return out;
}

// 画面の外に出た点を「p0（3 コマ目から）」の形で並べる。
function trkOutText(d: TrkData, json: bool): string {
  let out = "";
  for (let p: u32 = 0; p < d.n; p++) {
    for (let k: i64 = 0; k < d.frames; k++) {
      if (d.hs[trkIdx(d, k, p)] == TRK_OUT) {
        if (out != "") {
          if (json) {
            out = out + ",";
          } else {
            out = out + "、";
          }
        }
        if (json) {
          out = out + `{"point":${trkJsonStr(d.names[p])},"from":${k}}`;
        } else {
          out = out + `${d.names[p]}（${k} コマ目から）`;
        }
        break;
      }
    }
  }
  return out;
}

// 最初のコマで、模様（半径 feature）が画面からはみ出す点を並べる。
function trkNearEdgeText(d: TrkData, json: bool): string {
  let out = "";
  if (d.frames <= 0) {
    return out;
  }
  const r = d.feature as f64;
  for (let p: u32 = 0; p < d.n; p++) {
    const x = d.hx[p as usize];
    const y = d.hy[p as usize];
    if (x - r < 0.0 || y - r < 0.0 || x + r > (d.w - 1) as f64 || y + r > (d.h - 1) as f64) {
      if (out != "") {
        if (json) {
          out = out + ",";
        } else {
          out = out + "、";
        }
      }
      if (json) {
        out = out + trkJsonStr(d.names[p]);
      } else {
        out = out + d.names[p];
      }
    }
  }
  return out;
}

// 人向けの要約。警告は code 付き（警告[motion-lost] など。check の診断の code と同じ）。
export function trkSummaryText(d: TrkData, mode: i32): string {
  const s = trkSummarize(d);
  let t = `点 ${d.n} 個を ${d.frames} コマ追いました（${trkModeLabel(trkFitMode(d.n, mode))}）。`;
  t = t + `信頼度の平均 ${textNum(s.meanConf)}、最低 ${textNum(s.minConf)}（${d.names[s.minPoint]}、${s.minFrame} コマ目）。`;
  t = t + `模様の取り直し ${d.regrabs} 回。`;
  const early = trkLostText(d, false, true, false);
  if (early != "") {
    t = t + `\n警告[motion-lost]: 追い始めた次のコマから見失いました: ${early}`;
    t = t + `\n  ヒント: 動きが探す範囲（search、いま ${d.search}）よりずっと速いか、模様のはっきりしない所に点を置いています。search を大きくするか、点を置き直します`;
  }
  const later = trkLostText(d, false, false, false);
  if (later != "") {
    t = t + `\n警告[motion-lost]: 見失ったコマがあります: ${later}`;
    t = t + `\n  ヒント: 隠れた・ぼけたなら、そのコマは予測した位置です。動きが速いなら search（いま ${d.search}）を、模様が小さいなら feature（いま ${d.feature}）を大きくします`;
  }
  if (s.edgeFrames > 0) {
    t = t + `\n警告[motion-edge]: ${s.edgeFrames} コマで、いちばん合う位置が探す範囲の端か、探す範囲を広げて見つけた位置でした（動きが探す範囲より大きい）`;
    t = t + `\n  ヒント: 探す範囲（search）を大きくします（いま ${d.search}）`;
  }
  const outs = trkOutText(d, false);
  if (outs != "") {
    t = t + `\n警告[motion-out]: 画面の外に出た点があります: ${outs}。その後は止めた位置のままで、変換はほかの点で求めています`;
    t = t + `\n  ヒント: 画面に残る所にも点を置くと、変換が保てます`;
  }
  const near = trkNearEdgeText(d, false);
  if (near != "") {
    t = t + `\n警告[motion-near-edge]: ${near} は画面の端に近く、模様（半径 ${d.feature}）の一部が画面の外です。位置の誤差が大きくなります`;
    t = t + `\n  ヒント: 点を画面の内側へ ${d.feature} 画素以上離して置くか、feature を小さくします`;
  }
  const work = trkWorkPerFrame(d.n, d.feature, d.search);
  if (work > TRK_SLOW_WORK) {
    t = t + `\n警告[motion-slow]: 1 コマの探索が約 ${textNum(work / 1.0e9)} G 回の積和で重い設定です（CPU で 1 コマ約 ${textNum(work / 3.0e9)} 秒）`;
    t = t + `\n  ヒント: search と feature を小さくします（重さは点の数 × (2search+1)² × (2feature+1)²）`;
  }
  return t;
}

export function trkModeLabel(mode: i32): string {
  if (mode == TRK_MODE_SIMILARITY) {
    return "位置・拡大・回転";
  }
  if (mode == TRK_MODE_PERSPECTIVE) {
    return "平面";
  }
  if (mode == TRK_MODE_CORNERPIN) {
    return "コーナーピン";
  }
  return "位置";
}

function trkJsonStr(s: string): string {
  let out: u8[] = [34];
  for (const b of s) {
    if (b == 34 || b == 92) {
      out.push(92);
      out.push(b);
    } else if (b < 32) {
      trkPush(mut out, "\\u00");
      const hx = "0123456789abcdef";
      out.push(hx[(b >> 4) as usize]);
      out.push(hx[(b & 15) as usize]);
    } else {
      out.push(b);
    }
  }
  out.push(34);
  return stringFromBytes(out);
}

// JSON（AI 向け）。
// - "attach": 付ける点（最初のコマの点の重心。After Effects の attach point）。
// - track のコマごと: 点の値 "p"、付ける点の動き "dx" / "dy"（画素）、付ける点のまわりの拡大 "scale" と回転 "angle"（度、時計回りが正）、
//   最初のコマ → そのコマの 3x3 の変換 "matrix"（行の順。(x, y) は ((m0 x + m1 y + m2) / (m6 x + m7 y + m8), ...) に写る）。
//   matrix の m2 / m5 は画面の左上 (0, 0) の行き先なので、位置の動きには dx / dy を使う。
//   perspective / cornerpin の scale / angle は付ける点での局所の値（射影変換の傾き）。
export function trkDataJson(d: TrkData, mode: i32): u8[] {
  const m = trkFitMode(d.n, mode);
  const s = trkSummarize(d);
  const ax = trkAttachX(d);
  const ay = trkAttachY(d);
  let out: u8[] = [];
  let okText = "false";
  if (d.ok) {
    okText = "true";
  }
  trkPush(mut out, `{"version":${TRK_DATA_VERSION},"ok":${okText},"src":${trkJsonStr(d.src)},"width":${d.w},"height":${d.h},"srcWidth":${d.srcW},"srcHeight":${d.srcH},"fps":"${d.fpsNum}/${d.fpsDen}",`);
  trkPush(mut out, `"in":${textNum(d.cacheIn)},"at":${textNum(trkDataAt(d))},"frames":${d.frames},"mode":"${trkModeName(m)}","srcPoints":${trkJsonStr(d.srcPts)},`);
  trkPush(mut out, `"options":{"feature":${d.feature},"search":${d.search},"adapt":${textNum(d.adapt)},"minConf":${textNum(d.minConf)}},`);
  trkPush(mut out, `"attach":[${textNum(ax)},${textNum(ay)}],"points":[`);
  for (let p: u32 = 0; p < d.n; p++) {
    if (p > 0) {
      trkPush(mut out, ",");
    }
    trkPush(mut out, `{"name":${trkJsonStr(d.names[p])},"start":[${textNum(d.hx[p as usize])},${textNum(d.hy[p as usize])}]}`);
  }
  trkPush(mut out, `],"summary":{"meanConf":${textNum(s.meanConf)},"minConf":${textNum(s.minConf)},"minPoint":${trkJsonStr(d.names[s.minPoint])},"minFrame":${s.minFrame},`);
  trkPush(mut out, `"regrabs":${d.regrabs},"lowFrames":${s.lowFrames},"lostFrames":${s.lostFrames},"edgeFrames":${s.edgeFrames},"outFrames":${s.outFrames},`);
  trkPush(mut out, `"lost":[${trkLostText(d, true, false, true)}],"out":[${trkOutText(d, true)}],"nearEdge":[${trkNearEdgeText(d, true)}],`);
  trkPush(mut out, `"work":${trkWorkPerFrame(d.n, d.feature, d.search)}},`);
  trkPush(mut out, `"track":[`);
  const xs = trkXformAll(d, m);
  for (let k: i64 = 0; k < d.frames; k++) {
    if (k > 0) {
      trkPush(mut out, ",\n");
    }
    trkPush(mut out, `{"f":${k},"p":[`);
    for (let p: u32 = 0; p < d.n; p++) {
      const i = trkIdx(d, k, p);
      if (p > 0) {
        trkPush(mut out, ",");
      }
      trkPush(mut out, `[${textNum(d.hx[i])},${textNum(d.hy[i])},${textNum(d.hc[i])},"${trkStateName(d.hs[i])}"]`);
    }
    let x: f64[9];
    for (let j: usize = 0; j < 9; j++) {
      x[j] = xs[(k as usize) * 9 + j];
    }
    const dx = trkApplyX(x, ax, ay) - ax;
    const dy = trkApplyY(x, ax, ay) - ay;
    trkPush(mut out, `],"dx":${textNum(dx)},"dy":${textNum(dy)},"scale":${textNum(trkLocalScale(x, ax, ay))},"angle":${textNum(trkLocalAngle(x, ax, ay) * 180.0 / TRK_PI)}`);
    trkPush(mut out, `,"matrix":[`);
    for (let j = 0; j < 9; j++) {
      if (j > 0) {
        trkPush(mut out, ",");
      }
      trkPush(mut out, `${x[j]}`);
    }
    trkPush(mut out, "]}");
  }
  trkPush(mut out, "]}\n");
  return out;
}

// ---- .mzc の motion= の点 ----

export struct TrkPts {
  ok: bool;
  // 読めなかったときの理由（日本語。check の bad-motion の文）
  err: string;
  xs: f64[];
  ys: f64[];
}

// "x,y;x,y;..."（1〜16 点、有限の数）を読む。画面の範囲は呼ぶ側で確かめる（素材の大きさが要る）。
export function trkParsePoints(s: string): TrkPts {
  let r: TrkPts = { ok: false, err: "", xs: [], ys: [] };
  const parts = splitBy(s, 59);
  for (const one of parts) {
    const xy = splitBy(one, 44);
    if (xy.length != 2) {
      r.err = `motion= の点 '${one}' は x,y の形で書きます（例: motion="812,440;1210,460"）`;
      return r;
    }
    const x = parseNum(xy[0]);
    const y = parseNum(xy[1]);
    if (!trkFinite(x) || !trkFinite(y)) {
      r.err = `motion= の点 '${one}' が数として読めません`;
      return r;
    }
    r.xs.push(x);
    r.ys.push(y);
  }
  if (r.xs.length == 0 || r.xs.length > 16) {
    r.err = `motion= の点は 1〜16 個です（いま ${r.xs.length} 個）`;
    return r;
  }
  r.ok = true;
  return r;
}
