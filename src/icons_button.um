// アイコンだけのボタン（components.html の「ボタン」の節の「アイコン」の行）。
//
//   if (icnButton(mut ui, mut icons, skin, "元に戻す", ICN_UNDO, false, "")) { … }
//   icnButton(mut ui, mut icons, skin, "元に戻す", ICN_UNDO, false, "取り消せる操作がありません")   // 無効（理由をツールチップに）
//
// - label（名前）は必ず渡す。ID とツールチップに使う。空なら誤りの色の枠を描いて、付け忘れが画面で分かるようにする。
// - 無効にするときは、理由（disabledReason）を渡す。ツールチップで理由を言う（ui.md：無効のときはツールチップで理由を言う）。
// - 押せる範囲は max(size.iconButton.md, size.hitTargetMin) 四方（見た目が小さくても 24 以上）。
// - キーボードでフォーカスしたときだけ二重の輪（外は黒 4px、内は accent 2px を 1px 離す）。
// - 色: 通常 text.2、ホバー bg.3 の地と text.1、押下・オン bg.4 の地と text.1、無効 text.disabled。
//   ツールバーのオン（bar = true）は、下に text.2 の 2px の線を足す（モックアップの .tools .ibtn.on）。
import { UkCtx, ukId, ukBehavior, ukDrawRound, ukDrawStroke, ukDrawRect, ukDrawText, ukTextW, ukLineH, ukTooltip, ukDrawShadow } from "./uikit/core.um";
import { UkRect, ukRect, ukShrink } from "./uikit/base.um";
import { ukNext } from "./uikit/layout.um";
import { IcnCache, icnDrawIn, icnPx } from "./icons_draw.um";
import { IcnSkin } from "./icons_skin.um";

export const ICN_ST_NORMAL: i32 = 0;
export const ICN_ST_HOVER: i32 = 1;
export const ICN_ST_PRESS: i32 = 2;
export const ICN_ST_FOCUS: i32 = 3;
export const ICN_ST_OFF: i32 = 4;

// フォーカスの輪（モックアップの .ring: outline 2px accent、outline-offset 1px、box-shadow 0 0 0 4px 黒）。
export function icnFocusRing(ui: mut UkCtx, skin: IcnSkin, r: UkRect): void {
  const s = ui.theme.scale;
  const rad = ui.theme.radius;
  const ow = icnPx(skin.focusOuterW, s);
  ukDrawStroke(mut ui, ukShrink(r, -ow), rad + ow, ow, skin.focusOuter);
  const a0 = icnPx(skin.focusOff, s);
  const aw = icnPx(skin.focusW, s);
  ukDrawStroke(mut ui, ukShrink(r, -(a0 + aw)), rad + a0 + aw, aw, ui.theme.focus);
}

// 状態 state（ICN_ST_*）のアイコンのボタンを r に描く（ふるまいなし。見本や、自前で当たりを取る部品から使う）。
export function icnButtonDraw(ui: mut UkCtx, icons: mut IcnCache, skin: IcnSkin, r: UkRect, icon: i32, state: i32, on: bool, bar: bool): void {
  const th = ui.theme;
  let bg: u32 = 0;
  let fg = th.textDim;
  if (state == ICN_ST_OFF) {
    fg = th.textOff;
  } else if (state == ICN_ST_PRESS || on) {
    bg = th.raisedHover;
    fg = th.text;
  } else if (state == ICN_ST_HOVER) {
    bg = th.raised;
    fg = th.text;
  }
  if ((bg >> 24) != 0) {
    ukDrawRound(mut ui, r, th.radius, bg);
  }
  if (bar && on && state != ICN_ST_OFF) {
    const lw = icnPx(2, th.scale);
    ukDrawRect(mut ui, ukRect(r.x + th.radius / 2, r.y + r.h - lw, r.w - th.radius, lw), skin.onLine);
  }
  icnDrawIn(mut ui, mut icons, r, icon, skin.iconSm, fg);
  if (state == ICN_ST_FOCUS) {
    icnFocusRing(mut ui, skin, r);
  }
}

// ツールチップ（モックアップの .tooltip: bg.popover、line.strong の 1px の枠、radius.md、余白 6px 8px、font.size.sm）を
// 左上 (x, y) に描く。描いた四角を返す。見本で、マウスを置いた状態を固定して見せるのに使う。
export function icnTip(ui: mut UkCtx, skin: IcnSkin, x: i32, y: i32, text: string): UkRect {
  const th = ui.theme;
  const s = th.scale;
  const fs = th.fontSmall;
  const px = icnPx(skin.tipPadX, s);
  const py = icnPx(skin.tipPadY, s);
  const r = ukRect(x, y, ukTextW(mut ui, text, fs) + px * 2, ukLineH(ui, fs) + py * 2);
  const rad = icnPx(skin.tipRadius, s);
  ukDrawShadow(mut ui, r, rad, th.shadowBlur, th.shadow);
  ukDrawRound(mut ui, r, rad, th.tipBg);
  ukDrawStroke(mut ui, r, rad, icnPx(1, s), skin.tipBorder);
  ukDrawText(mut ui, x + px, y + py, text, fs, th.tipText);
  return r;
}

// アイコンだけのボタン。押されたら true（無効なら false）。今のレイアウトの次の場所に置く。
export function icnButton(ui: mut UkCtx, icons: mut IcnCache, skin: IcnSkin, label: string, icon: i32, on: bool, disabledReason: string): bool {
  const s = ui.theme.scale;
  const b = icnPx(Math.max(skin.btnMd, skin.hitMin), s);
  const r = ukNext(mut ui, b, b);
  return icnButtonAt(mut ui, mut icons, skin, r, label, icon, on, disabledReason, false);
}

// 四角 r に置くアイコンだけのボタン（r は押せる範囲。小さすぎれば size.hitTargetMin まで中央で広げる）。
export function icnButtonAt(
  ui: mut UkCtx, icons: mut IcnCache, skin: IcnSkin, r0: UkRect, label: string, icon: i32, on: bool, disabledReason: string, bar: bool,
): bool {
  const s = ui.theme.scale;
  const m = icnPx(skin.hitMin, s);
  let r = r0;
  if (r.w < m) {
    r = ukRect(r.x - (m - r.w) / 2, r.y, m, r.h);
  }
  if (r.h < m) {
    r = ukRect(r.x, r.y - (m - r.h) / 2, r.w, m);
  }
  const off = disabledReason.length > 0 || ui.disabled > 0;
  const id = ukId(ui, label);
  const h = ukBehavior(mut ui, id, r, !off);
  let st = ICN_ST_NORMAL;
  if (off) {
    st = ICN_ST_OFF;
  } else if (h.held) {
    st = ICN_ST_PRESS;
  } else if (h.hover) {
    st = ICN_ST_HOVER;
  }
  icnButtonDraw(mut ui, mut icons, skin, r, icon, st, on, bar);
  if (h.focused && ui.focusVisible && !off) {
    icnFocusRing(mut ui, skin, r);
  }
  if (label.length == 0) {
    // 名前の付け忘れ（ツールチップも読み上げも無いボタンになる）
    ukDrawStroke(mut ui, r, ui.theme.radius, icnPx(1, s), ui.theme.danger);
  }
  if (off && disabledReason.length > 0) {
    ukTooltip(mut ui, disabledReason);
  } else {
    ukTooltip(mut ui, label);
  }
  return h.clicked && !off;
}
