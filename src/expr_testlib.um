// エクスプレッションの試験の道具（BMP を書く、試しの絵）。expr_test.um と expr_gpu_test.um が使う。

function bmpPush32(out: mut u8[], v: u32): void {
  out.push((v & 255) as u8);
  out.push(((v >> 8) & 255) as u8);
  out.push(((v >> 16) & 255) as u8);
  out.push(((v >> 24) & 255) as u8);
}

function bmpByte(v: f32): u8 {
  return (Math.min(Math.max(v * 255.0 + 0.5, 0.0), 255.0) as i32) as u8;
}

export function writeBmpV4(path: string, img: Buffer<vec4<f32>>, w: i32, h: i32): bool {
  const rowBytes = ((w * 3 + 3) / 4) * 4;
  const dataBytes = (rowBytes * h) as u32;
  let out: u8[] = [66, 77];
  bmpPush32(mut out, 54 + dataBytes);
  bmpPush32(mut out, 0);
  bmpPush32(mut out, 54);
  bmpPush32(mut out, 40);
  bmpPush32(mut out, w as u32);
  bmpPush32(mut out, h as u32);
  out.push(1);
  out.push(0);
  out.push(24);
  out.push(0);
  bmpPush32(mut out, 0);
  bmpPush32(mut out, dataBytes);
  bmpPush32(mut out, 2835);
  bmpPush32(mut out, 2835);
  bmpPush32(mut out, 0);
  bmpPush32(mut out, 0);
  for (let y = h - 1; y >= 0; y--) {
    for (let x = 0; x < w; x++) {
      // 透明な所は市松模様の上に重ねて見せる
      const c = img[(y * w + x) as u32];
      let chk: f32 = 0.25;
      if ((x / 16 + y / 16) % 2 == 0) {
        chk = 0.35;
      }
      const a = c.w;
      out.push(bmpByte(c.z * a + chk * (1.0 - a)));
      out.push(bmpByte(c.y * a + chk * (1.0 - a)));
      out.push(bmpByte(c.x * a + chk * (1.0 - a)));
    }
    for (let k = w * 3; k < rowBytes; k++) {
      out.push(0);
    }
  }
  return writeFile(path, out);
}

export kernel function testPattern(i: u32, img: mut Buffer<vec4<f32>>, w: u32, h: u32): void {
  const x = ((i % w) as f32) / (w as f32);
  const y = ((i / w) as f32) / (h as f32);
  const cx = ((i % w) / 40) % 2;
  const cy = ((i / w) / 40) % 2;
  let v: f32 = 0.3;
  if (cx == cy) {
    v = 0.8;
  }
  img[i] = vec4(v * (0.6 + 0.4 * x), v * 0.7, v * (0.6 + 0.4 * y), 1.0);
}

