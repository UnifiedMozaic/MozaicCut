// 書き出しの画面（src/ui/export/）のテーマ: docs/design/tokens.json の値を、そのままの名前の道筋で読む。
//
// uikit の UkTheme は名前が少なく（bg / panel / raised …）、tokens.json の名前（color.dark.bg.0、font.size.sm.size …）と
// 合わないので、この部品では tokens.json を平たく読んで UeTheme に入れる。色や大きさを部品のコードに直接書かない。
// あわせて ueUkTheme で、uikit の部品（入力欄など）の色と大きさも tokens.json の値に合わせる。
// - 大きさは UI の倍率を掛けた画素（i32）。文字の大きさは f32。
// - tokens.json が読めない・名前がないときは uikit の既定のテーマから作った値のまま（missing に数える）。
//
// 名前の空間は全ファイルで 1 つなので、この部品の名前は ue / Ue / UE_ で始める。
import { UkTheme, ukThemeDefault, ukThemeSet, ukThemeScale, ukParseHex } from "../kit/theme.um";
import { ukAlpha } from "../kit/base.um";

export struct UeTheme {
  scale: f32;
  // ---- 色（0xAARRGGBB） ----
  bg0: u32;
  bg1: u32;
  bg2: u32;
  bg3: u32;
  bg4: u32;
  bgViewer: u32;
  bgPopover: u32;
  line: u32;
  lineStrong: u32;
  text1: u32;
  text2: u32;
  text3: u32;
  textDis: u32;
  textOnLight: u32;
  textOnDark: u32;
  // 主のボタン（地が accent）の文字と、エラーの札（地が error）の文字
  textOnAccent: u32;
  textOnError: u32;
  accent: u32;
  accentHover: u32;
  accentTint: u32;
  accentTintSolid: u32;
  ok: u32;
  warn: u32;
  error: u32;
  textSource: u32;
  focusOuter: u32;
  // 部品の輪郭（範囲をスクラブする帯の枠）と、再生ヘッド（1px の線と両側の黒い縁）
  lineControl: u32;
  playhead: u32;
  playheadEdge: u32;
  // 出力の枠の中で、シーケンスの絵の外（黒い帯）と、プレビューに重ねる札（.ovl）の地。
  // tokens にまだ名前がないので、color.dark.bg.letterbox / bg.overlay があればそれ、なければ viewerChoices.black
  // （札は不透明度 .55）。focusOuter とは意味が違うので分ける。
  letterbox: u32;
  overlayBg: u32;
  // 札（chip）の地の不透明度（accent.tint の不透明度をほかの意味の色にも使う。0..255）
  tintAlpha: i32;
  // 使えない部品の不透明度（opacity.disabledClip。0..255）
  disabledAlpha: i32;
  // ---- 文字（倍率を掛けた画素） ----
  fsXs: f32;
  fsSm: f32;
  fsMd: f32;
  fsLg: f32;
  fsCode: f32;
  fsCodeSm: f32;
  lhXs: i32;
  lhSm: i32;
  lhMd: i32;
  lhLg: i32;
  lhCode: i32;
  lhCodeSm: i32;
  // ---- 余白（space.1..6） ----
  s1: i32;
  s2: i32;
  s3: i32;
  s4: i32;
  s5: i32;
  s6: i32;
  // ---- 角（radius） ----
  rSm: i32;
  rMd: i32;
  rLg: i32;
  // ---- 寸法（size） ----
  topBar: i32;
  rail: i32;
  panelHeader: i32;
  statusBar: i32;
  btnSm: i32;
  btnMd: i32;
  btnLg: i32;
  field: i32;
  fieldDialog: i32;
  row: i32;
  iconSm: i32;
  iconMd: i32;
  scrollbar: i32;
  hairline: i32;
  selectionW: i32;
  focusW: i32;
  // フォーカスの輪と部品のあいだ（border.focusOffset）
  focusOffset: i32;
  // 書き出しの画面の左右の列の幅（size.export.left / right）
  leftW: i32;
  rightW: i32;
  // ファイル名・場所の名前の列の幅（モックアップの .fname の 90px。tokens にないので size.export.fieldLabel を読み、
  // なければ 90。デザインに足してもらう）
  fieldLabelW: i32;
  // 読めなかった名前の数
  missing: i32;
}

// ---- tokens.json を平たく読む ----

export struct UeTok {
  key: string;
  str: string;
  num: f64;
  isNum: bool;
}

function ueJsonWs(s: string, i0: usize): usize {
  let i = i0;
  while (i < s.length && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) {
    i++;
  }
  return i;
}

function ueJsonStr(s: string, i0: usize, end: mut usize[]): string {
  let out: u8[] = [];
  let i = i0 + 1;
  while (i < s.length && s[i] != 34) {
    if (s[i] == 92 && i + 1 < s.length) {
      i++;
    }
    out.push(s[i]);
    i++;
  }
  end[0] = i + 1;
  return stringFromBytes(out);
}

function ueJoin(path: string[]): string {
  let s = "";
  for (let i: usize = 0; i < path.length; i++) {
    if (i > 0) {
      s = s + ".";
    }
    s = s + path[i];
  }
  return s;
}

// JSON の葉（文字列と数）を "a.b.c" の名前で並べる。配列の要素は "[]"。読めなければ空。
export function ueTokParse(json: string): UeTok[] {
  let out: UeTok[] = [];
  let path: string[] = [];
  let isObj: bool[] = [];
  let pendingKey = false;
  let end: usize[] = [0];
  let i = ueJsonWs(json, 0);
  while (i < json.length) {
    const b = json[i];
    if (b == 123) {
      isObj.push(true);
      path.push("");
      pendingKey = true;
      i++;
    } else if (b == 125 || b == 93) {
      if (isObj.length == 0) {
        return [];
      }
      isObj.pop();
      path.pop();
      i++;
    } else if (b == 91) {
      isObj.push(false);
      path.push("[]");
      i++;
    } else if (b == 44) {
      if (isObj.length > 0 && isObj[isObj.length - 1]) {
        pendingKey = true;
      }
      i++;
    } else if (b == 58) {
      pendingKey = false;
      i++;
    } else if (b == 34) {
      const str = ueJsonStr(json, i, mut end);
      i = end[0];
      if (pendingKey && path.length > 0) {
        path[path.length - 1] = str;
        pendingKey = false;
      } else {
        out.push({ key: ueJoin(path), str, num: 0.0, isNum: false });
      }
    } else if ((b >= 48 && b <= 57) || b == 45) {
      let j = i;
      let v: f64 = 0.0;
      let neg = false;
      if (json[j] == 45) {
        neg = true;
        j++;
      }
      while (j < json.length && json[j] >= 48 && json[j] <= 57) {
        v = v * 10.0 + ((json[j] - 48) as f64);
        j++;
      }
      if (j < json.length && json[j] == 46) {
        j++;
        let f: f64 = 0.1;
        while (j < json.length && json[j] >= 48 && json[j] <= 57) {
          v = v + ((json[j] - 48) as f64) * f;
          f = f * 0.1;
          j++;
        }
      }
      if (neg) {
        v = -v;
      }
      out.push({ key: ueJoin(path), str: "", num: v, isNum: true });
      i = j;
    } else {
      i++;
    }
  }
  return out;
}

function ueTokFind(toks: UeTok[], key: string): i32 {
  for (let i: usize = 0; i < toks.length; i++) {
    if (toks[i].key == key) {
      return i as i32;
    }
  }
  return -1;
}

// 色を読む。なければ fallback のままで miss[0] を 1 つ増やす。
function ueTokColor(toks: UeTok[], key: string, fallback: u32, miss: mut i32[]): u32 {
  const k = ueTokFind(toks, key);
  if (k >= 0 && !toks[k as usize].isNum) {
    const v = ukParseHex(toks[k as usize].str);
    if (v >= 0) {
      return v as u32;
    }
  }
  miss[0] = miss[0] + 1;
  return fallback;
}

// あってもなくてもよい色（tokens.json にまだない名前）。
function ueTokColorOpt(toks: UeTok[], key: string, fallback: u32): u32 {
  const k = ueTokFind(toks, key);
  if (k >= 0 && !toks[k as usize].isNum) {
    const v = ukParseHex(toks[k as usize].str);
    if (v >= 0) {
      return v as u32;
    }
  }
  return fallback;
}

// 数を読む（倍率を掛ける前）。なければ fallback。
function ueTokNum(toks: UeTok[], key: string, fallback: f64, miss: mut i32[]): f64 {
  const k = ueTokFind(toks, key);
  if (k >= 0 && toks[k as usize].isNum) {
    return toks[k as usize].num;
  }
  miss[0] = miss[0] + 1;
  return fallback;
}

// あってもなくてもよい数（size.export.* のように、tokens.json にまだない名前）。
function ueTokOpt(toks: UeTok[], key: string, fallback: f64): f64 {
  const k = ueTokFind(toks, key);
  if (k >= 0 && toks[k as usize].isNum) {
    return toks[k as usize].num;
  }
  return fallback;
}

function ueSc(v: f64, s: f32): i32 {
  return Math.max(Math.floor(v * (s as f64) + 0.5) as i32, 1);
}

// tokens.json（の中身）からテーマを作る。json が "" なら uikit の既定のテーマから作る（missing が大きくなる）。
export function ueThemeFromTokens(json: string, scale: f32): UeTheme {
  const s = Math.min(Math.max(scale, 0.8), 2.0);
  const toks = ueTokParse(json);
  const u = ukThemeDefault(1.0);
  let m: i32[] = [0];
  const C = "color.dark.";
  const tint = ueTokColor(toks, C + "accent.tint", ukAlpha(u.accent, 40), mut m);
  const spaceUnit = ueTokNum(toks, "space.grid", 4.0, mut m);
  const sp1 = ueTokNum(toks, "space.1", spaceUnit, mut m);
  const sp5 = ueTokNum(toks, "space.5", spaceUnit * 6.0, mut m);
  const black = ueTokColor(toks, C + "viewerChoices.black", 0xff000000, mut m);
  const disabledOp = ueTokNum(toks, "opacity.disabledClip", 0.4, mut m);
  let t: UeTheme = {
    scale: s,
    bg0: ueTokColor(toks, C + "bg.0", u.bg, mut m),
    bg1: ueTokColor(toks, C + "bg.1", u.panel, mut m),
    bg2: ueTokColor(toks, C + "bg.2", u.panelAlt, mut m),
    bg3: ueTokColor(toks, C + "bg.3", u.raised, mut m),
    bg4: ueTokColor(toks, C + "bg.4", u.raisedHover, mut m),
    bgViewer: ueTokColor(toks, C + "bg.viewer", u.bg, mut m),
    bgPopover: ueTokColor(toks, C + "bg.popover", u.panel, mut m),
    line: ueTokColor(toks, C + "line.default", u.border, mut m),
    lineStrong: ueTokColor(toks, C + "line.strong", u.borderStrong, mut m),
    text1: ueTokColor(toks, C + "text.1", u.text, mut m),
    text2: ueTokColor(toks, C + "text.2", u.textDim, mut m),
    text3: ueTokColor(toks, C + "text.3", u.textDim, mut m),
    textDis: ueTokColor(toks, C + "text.disabled", u.textOff, mut m),
    textOnLight: ueTokColor(toks, C + "text.onLight", u.bg, mut m),
    textOnDark: ueTokColor(toks, C + "text.onDark", u.text, mut m),
    textOnAccent: ueTokColor(toks, C + "text.onAccent", u.bg, mut m),
    textOnError: ueTokColor(toks, C + "text.onError", u.bg, mut m),
    accent: ueTokColor(toks, C + "accent.default", u.accent, mut m),
    accentHover: ueTokColor(toks, C + "accent.hover", u.accentHover, mut m),
    accentTint: tint,
    accentTintSolid: ueTokColor(toks, C + "accent.tintSolid", u.selection, mut m),
    ok: ueTokColor(toks, C + "semantic.ok", u.success, mut m),
    warn: ueTokColor(toks, C + "semantic.warn", u.warning, mut m),
    error: ueTokColor(toks, C + "semantic.error", u.danger, mut m),
    textSource: ueTokColor(toks, C + "semantic.textSource", u.warning, mut m),
    focusOuter: ueTokColor(toks, C + "semantic.focusOuter", u.bg, mut m),
    lineControl: ueTokColor(toks, C + "line.control", u.borderStrong, mut m),
    playhead: ueTokColor(toks, C + "semantic.playhead", u.danger, mut m),
    playheadEdge: ueTokColor(toks, C + "semantic.playheadEdge", 0xff000000, mut m),
    letterbox: ueTokColorOpt(toks, C + "bg.letterbox", black),
    overlayBg: ueTokColorOpt(toks, C + "bg.overlay", ukAlpha(black, 140)),
    tintAlpha: ((tint >> 24) & 255) as i32,
    disabledAlpha: Math.floor(disabledOp * 255.0 + 0.5) as i32,
    fsXs: (ueTokNum(toks, "font.size.xs.size", 11.0, mut m) as f32) * s,
    fsSm: (ueTokNum(toks, "font.size.sm.size", 12.0, mut m) as f32) * s,
    fsMd: (ueTokNum(toks, "font.size.md.size", 13.0, mut m) as f32) * s,
    fsLg: (ueTokNum(toks, "font.size.lg.size", 15.0, mut m) as f32) * s,
    fsCode: (ueTokNum(toks, "font.size.code.size", 12.0, mut m) as f32) * s,
    fsCodeSm: (ueTokNum(toks, "font.size.codeSm.size", 11.0, mut m) as f32) * s,
    lhXs: ueSc(ueTokNum(toks, "font.size.xs.lineHeight", 14.0, mut m), s),
    lhSm: ueSc(ueTokNum(toks, "font.size.sm.lineHeight", 16.0, mut m), s),
    lhMd: ueSc(ueTokNum(toks, "font.size.md.lineHeight", 18.0, mut m), s),
    lhLg: ueSc(ueTokNum(toks, "font.size.lg.lineHeight", 20.0, mut m), s),
    lhCode: ueSc(ueTokNum(toks, "font.size.code.lineHeight", 18.0, mut m), s),
    lhCodeSm: ueSc(ueTokNum(toks, "font.size.codeSm.lineHeight", 16.0, mut m), s),
    s1: ueSc(sp1, s),
    s2: ueSc(ueTokNum(toks, "space.2", spaceUnit * 2.0, mut m), s),
    s3: ueSc(ueTokNum(toks, "space.3", spaceUnit * 3.0, mut m), s),
    s4: ueSc(ueTokNum(toks, "space.4", spaceUnit * 4.0, mut m), s),
    s5: ueSc(sp5, s),
    s6: ueSc(ueTokNum(toks, "space.6", spaceUnit * 8.0, mut m), s),
    rSm: ueSc(ueTokNum(toks, "radius.sm", 3.0, mut m), s),
    rMd: ueSc(ueTokNum(toks, "radius.md", 5.0, mut m), s),
    rLg: ueSc(ueTokNum(toks, "radius.lg", 8.0, mut m), s),
    topBar: ueSc(ueTokNum(toks, "size.topBar", 40.0, mut m), s),
    rail: ueSc(ueTokNum(toks, "size.rail", 56.0, mut m), s),
    panelHeader: ueSc(ueTokNum(toks, "size.panelHeader", 32.0, mut m), s),
    statusBar: ueSc(ueTokNum(toks, "size.statusBar", 24.0, mut m), s),
    btnSm: ueSc(ueTokNum(toks, "size.button.sm", 24.0, mut m), s),
    btnMd: ueSc(ueTokNum(toks, "size.button.md", 28.0, mut m), s),
    btnLg: ueSc(ueTokNum(toks, "size.button.lg", 36.0, mut m), s),
    field: ueSc(ueTokNum(toks, "size.field", 24.0, mut m), s),
    fieldDialog: ueSc(ueTokNum(toks, "size.fieldDialog", 32.0, mut m), s),
    row: ueSc(ueTokNum(toks, "size.propertyRow", 28.0, mut m), s),
    iconSm: ueSc(ueTokNum(toks, "size.icon.sm", 16.0, mut m), s),
    iconMd: ueSc(ueTokNum(toks, "size.icon.md", 20.0, mut m), s),
    scrollbar: ueSc(ueTokNum(toks, "size.scrollbar", 12.0, mut m), s),
    hairline: ueSc(ueTokNum(toks, "border.hairline", 1.0, mut m), s),
    selectionW: ueSc(ueTokNum(toks, "border.selection", 2.0, mut m), s),
    focusW: ueSc(ueTokNum(toks, "border.focus", 2.0, mut m), s),
    focusOffset: ueSc(ueTokNum(toks, "border.focusOffset", 1.0, mut m), s),
    leftW: ueSc(ueTokNum(toks, "size.export.left", 280.0, mut m), s),
    rightW: ueSc(ueTokNum(toks, "size.export.right", 320.0, mut m), s),
    fieldLabelW: ueSc(ueTokOpt(toks, "size.export.fieldLabel", 90.0), s),
    missing: 0,
  };
  t.missing = m[0];
  return t;
}

// uikit の部品（入力欄・ツールチップ・スクロールバー・通知）の UkTheme を tokens.json の値に合わせる。
// 名前の対応は docs/design/uikit.md の表（bg / panel / raised …）に、tokens.json の名前を当てたもの。
export function ueUkTheme(t: UeTheme): UkTheme {
  let u = ukThemeDefault(1.0);
  ukThemeSet(mut u, "color.bg", t.bg0, 0.0, true);
  ukThemeSet(mut u, "color.panel", t.bg1, 0.0, true);
  ukThemeSet(mut u, "color.panelAlt", t.bg2, 0.0, true);
  ukThemeSet(mut u, "color.raised", t.bg3, 0.0, true);
  ukThemeSet(mut u, "color.raisedHover", t.bg4, 0.0, true);
  ukThemeSet(mut u, "color.raisedActive", t.bg2, 0.0, true);
  ukThemeSet(mut u, "color.inputBg", t.bg0, 0.0, true);
  ukThemeSet(mut u, "color.border", t.line, 0.0, true);
  ukThemeSet(mut u, "color.borderStrong", t.lineStrong, 0.0, true);
  ukThemeSet(mut u, "color.text", t.text1, 0.0, true);
  ukThemeSet(mut u, "color.textDim", t.text2, 0.0, true);
  ukThemeSet(mut u, "color.textOff", t.textDis, 0.0, true);
  ukThemeSet(mut u, "color.accent", t.accent, 0.0, true);
  ukThemeSet(mut u, "color.accentHover", t.accentHover, 0.0, true);
  ukThemeSet(mut u, "color.accentActive", t.accent, 0.0, true);
  ukThemeSet(mut u, "color.onAccent", t.textOnAccent, 0.0, true);
  ukThemeSet(mut u, "color.danger", t.error, 0.0, true);
  ukThemeSet(mut u, "color.success", t.ok, 0.0, true);
  ukThemeSet(mut u, "color.warning", t.warn, 0.0, true);
  ukThemeSet(mut u, "color.focus", t.accent, 0.0, true);
  ukThemeSet(mut u, "color.selection", t.accentTintSolid, 0.0, true);
  ukThemeSet(mut u, "color.track", t.bg4, 0.0, true);
  ukThemeSet(mut u, "color.tipBg", t.bgPopover, 0.0, true);
  ukThemeSet(mut u, "color.tipText", t.text1, 0.0, true);
  const s = t.scale;
  ukThemeSet(mut u, "size.font", 0, t.fsMd / s, false);
  ukThemeSet(mut u, "size.fontSmall", 0, t.fsSm / s, false);
  ukThemeSet(mut u, "size.fontLarge", 0, t.fsLg / s, false);
  ukThemeSet(mut u, "size.ctrlH", 0, (t.btnMd as f32) / s, false);
  ukThemeSet(mut u, "size.rowH", 0, (t.row as f32) / s, false);
  ukThemeSet(mut u, "size.pad", 0, (t.s2 as f32) / s, false);
  ukThemeSet(mut u, "size.gap", 0, (t.s2 as f32) / s, false);
  ukThemeSet(mut u, "size.radius", 0, (t.rMd as f32) / s, false);
  ukThemeSet(mut u, "size.radiusSm", 0, (t.rSm as f32) / s, false);
  ukThemeSet(mut u, "size.icon", 0, (t.iconSm as f32) / s, false);
  ukThemeSet(mut u, "size.scrollW", 0, (t.scrollbar as f32) / s, false);
  ukThemeSet(mut u, "size.tabH", 0, (t.panelHeader as f32) / s, false);
  ukThemeScale(mut u, Math.max(s, 1.0));
  return u;
}
