// キーの割り当ての画面（docs/design/mockups/shortcuts.html、ui.md 5.3）。Ctrl+/（Premiere・Resolve 互換は Ctrl+Alt+K）で開く。
//
//   let st = kmsNew(cmds);
//   毎フレーム: const res = kmsFrame(mut ui, mut st, mut map, cmds, tr, th, 画面の四角);
//   res.close → 閉じる。res.changed → map が変わった（kmUserJson(map, cmds) を settings の keymap.json に保存する）。
//   res.exportReq / res.importReq → 呼ぶ側がファイルを選ぶ（kmExportJson / kmLoadUser を使う。読めなかった所は kmsLoadErrorText で文にする）。
//
// - 上: キーボードの絵（JIS / US、Mac の並び）。修飾キーを押すか、上のセグメントで選ぶと、その組み合わせの割り当てに切り替わる。
//   キーを押すとそのコマンドを選ぶ。選んだコマンドのキーは青の輪、重なりを確かめているキーは橙の輪。
//   絵は 1 つのフォーカスの止まり（Tab）で、矢印でキーを動き、Enter で選ぶ。窓が狭いときはキーを縮める。
// - 下の 3 列: 重なりの警告（［割り当てる（〜は外す）］［やめる］）／検索／コマンドの一覧。
//   一覧の行は Tab で止まり、↑↓ で動く。Enter かダブルクリックか［割り当てる］で次に押したキーを割り当てる（Esc でやめる）。
//   選んだ行には［割り当てる］［外す］［既定に戻す］が出る（Delete でも外せる）。
// - 一番下: すべてのコマンドの表（標準・Premiere Pro 互換・DaVinci Resolve 互換）。上の検索の欄で絞る。見えている行だけ描く。
//
// map・検索・配列・言語・修飾キーが変わったときだけ、キーの絵・一覧・表・重なりの数を作り直す（KmsState の覚え）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は kms / Kms で始める。
import { UkRect, ukRect, ukShrink, ukAlpha, ukMix, ukHashStr, ukHashI32 } from "../kit/base.um";
import {
  UkCtx, UkHit, ukBehavior, ukBehaviorEx, ukId, ukSt, ukDrawRect, ukDrawRound, ukDrawStroke, ukDrawText, ukDrawTextIn,
  ukTextW, ukLineH, ukFitText, ukPushClip, ukPopClip, ukPushId, ukPushIdInt, ukPopId, ukKeyTake, ukTooltip, ukFocus,
  UK_KEY_ESC, UK_KEY_ENTER, UK_KEY_SPACE, UK_KEY_DELETE, UK_KEY_BACKSPACE, UK_KEY_UP, UK_KEY_DOWN, UK_KEY_LEFT,
  UK_KEY_RIGHT,
} from "../kit/core.um";
import { ukNext, ukSetNext, ukBeginScroll, ukEndScroll } from "../kit/layout.um";
import { ukDropdown, ukIconButton, ukTextEdit } from "../kit/widgets.um";
import { ukIcon, UK_I_CLOSE, UK_I_SEARCH, UK_I_WARN } from "../kit/icons.um";
import { textWidthPx } from "../../effects/text/ttf.um";
import {
  KmMap, KmChord, KmCommand, kmMapNew, kmChord, kmChordEq, kmChordText, kmChordsFor, kmCommandOnKey, kmKeyCap,
  kmAssign, kmAssignVictims, kmUnassign, kmFindCommand, kmEventChord, kmEventMods, kmMatch, kmGroups, kmPresetId,
  kmConflicts, KM_MOD_CTRL, KM_MOD_SHIFT, KM_MOD_ALT, KM_MOD_META, KM_LAYOUT_JIS, KM_LAYOUT_US, KM_CAT_NONE,
  KM_CAT_PLAY, KM_CAT_MARK, KM_CAT_TOOL, KM_CAT_RIPPLE, KM_CAT_OVER, KM_CAT_VIEW,
} from "../../engine/keymap.um";
import { I18n, i18nT, i18nTL, i18nHas, i18nFmt, I18N_JA, I18N_EN } from "../../engine/i18n.um";
import { KmtTheme } from "./km_theme.um";

// 警告の箱の種類
const KMS_PEND_NONE: i32 = 0;
const KMS_PEND_CONFLICT: i32 = 1; // 割り当てると外れるものがある
const KMS_PEND_RESERVED: i32 = 2; // 画面の移動に使うキー
const KMS_PEND_PRESET: i32 = 3;   // プリセットを替えると、変えた割り当てが消える

// 一覧に出す最大の行の数
const KMS_MAX_ITEMS: i32 = 7;

// ---- 状態と結果 ----

// 表の 1 行（kind 0 は分類の見出し、1 はコマンドの行）
struct KmsRow {
  kind: i32;
  group: string;
  row: string;
  cmds: i32[];
}

export struct KmsState {
  layout: i32;
  mac: bool;
  // 修飾キーのセグメント（kmsModsOf の番号）
  modsSeg: i32;
  // 上の検索（表を絞る）と下の検索（一覧を絞る）
  query: string;
  listQuery: string;
  // 選んだコマンド
  sel: string;
  // 次に押したキーを sel に割り当てる。capRect はキーを待っている行（ほかの所を押したらやめる）
  capturing: bool;
  capRect: UkRect;
  // 警告の箱（KMS_PEND_*）
  pendKind: i32;
  pendCmd: string;
  pendChord: KmChord;
  pendPreset: i32;
  // 3 つのプリセットの割り当て（表と「どの配列でも同じ」に使う）と、いまのプリセットの既定（［既定に戻す］に使う）
  presets: KmMap[];
  defMap: KmMap;
  // キーボードの絵のフォーカス（kmsBoxes の番号）
  kbCur: i32;
  // 折り返しの覚え（ハッシュ・キー・結果。結果は行を "\n" でつないだもの）
  wrapH: u32[];
  wrapK: string[];
  wrapV: string[];
  // キーの絵の覚え（kmsBoxes の順。コマンド・分類・キーの上の名前の行）
  kbKey: string;
  kbCmd: string[];
  kbCat: i32[];
  kbName: string[];
  // 一覧・表・重なりの数の覚え
  listKey: string;
  items: i32[];
  tblKey: string;
  rows: KmsRow[];
  confSig: u32;
  confN: i32;
  confValid: bool;
}

export struct KmsResult {
  close: bool;
  changed: bool;
  exportReq: bool;
  importReq: bool;
}

export function kmsNew(cmds: KmCommand[]): KmsState {
  let ps: KmMap[] = [];
  for (let p = 0; p < 3; p++) {
    ps.push(kmMapNew(p, cmds));
  }
  return {
    layout: KM_LAYOUT_JIS, mac: false, modsSeg: 0, query: "", listQuery: "", sel: "", capturing: false,
    capRect: ukRect(0, 0, 0, 0), pendKind: KMS_PEND_NONE, pendCmd: "", pendChord: kmChord(0, ""), pendPreset: 0,
    presets: ps, defMap: kmMapNew(0, cmds), kbCur: -1, wrapH: [], wrapK: [], wrapV: [], kbKey: "", kbCmd: [],
    kbCat: [], kbName: [], listKey: "", items: [], tblKey: "", rows: [], confSig: 0, confN: 0, confValid: false,
  };
}

// 重なりの確かめを外から出す（見本の状態や、ほかの画面から割り当てを頼むとき）。
export function kmsPropose(st: mut KmsState, cmd: string, c: KmChord): void {
  st.pendKind = KMS_PEND_CONFLICT;
  st.pendCmd = cmd.clone();
  st.pendChord = kmChord(c.mods, c.key);
}

// kmLoadUser の errors の 1 つ（"原因\t引数…"）を、いまの言語の文にする。
export function kmsLoadErrorText(tr: I18n, e: string): string {
  let parts: string[] = [];
  let a: usize = 0;
  for (let i: usize = 0; i < e.length; i++) {
    if (e[i] == 9) {
      parts.push(kmsSub(e, a, i));
      a = i + 1;
    }
  }
  parts.push(kmsSub(e, a, e.length));
  let args: string[] = [];
  for (let i: usize = 1; i < parts.length; i++) {
    args.push(parts[i].clone());
  }
  return i18nFmt(tr, "keymap.err." + parts[0], args);
}

// ---- 小道具 ----

function kmsCmdName(tr: I18n, id: string): string {
  return i18nT(tr, "cmd." + id);
}

// キーの上の短い名前（keycap.*。なければ正式な名前）
function kmsCapName(tr: I18n, id: string): string {
  if (i18nHas(tr, "keycap." + id)) {
    return i18nT(tr, "keycap." + id);
  }
  return i18nT(tr, "cmd." + id);
}

// 文の中で呼ぶ短い名前（short.*。なければ正式な名前）
function kmsShortName(tr: I18n, id: string): string {
  if (i18nHas(tr, "short." + id)) {
    return i18nT(tr, "short." + id);
  }
  return i18nT(tr, "cmd." + id);
}

// 1 文字の終わり（UTF-8）
function kmsNextChar(s: string, i: usize): usize {
  const c = s[i];
  if (c < 128) {
    return i + 1;
  }
  if (c >= 240) {
    return Math.min(i + 4, s.length);
  }
  if (c >= 224) {
    return Math.min(i + 3, s.length);
  }
  return Math.min(i + 2, s.length);
}

// 1 文字前の始まり（a より前には戻らない）
function kmsPrevChar(s: string, i: usize, a: usize): usize {
  if (i <= a) {
    return a;
  }
  let p = i - 1;
  while (p > a && (s[p] & 192) == 128) {
    p--;
  }
  return p;
}

function kmsSub(s: string, a: usize, b: usize): string {
  let out: u8[] = [];
  for (let i = a; i < b && i < s.length; i++) {
    out.push(s[i]);
  }
  return stringFromBytes(out);
}

function kmsSplitLines(s: string): string[] {
  let out: string[] = [];
  if (s.length == 0) {
    return out;
  }
  let a: usize = 0;
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 10) {
      out.push(kmsSub(s, a, i));
      a = i + 1;
    }
  }
  out.push(kmsSub(s, a, s.length));
  return out;
}

function kmsJoinLines(lines: string[]): string {
  let s = "";
  for (let k: usize = 0; k < lines.length; k++) {
    if (k > 0) {
      s = s + "\n";
    }
    s = s + lines[k];
  }
  return s;
}

// 行の頭に置かない文字（閉じ括弧・句読点・長音・小書きのかな）
function kmsNoStart(ch: string): bool {
  if (ch.length == 1) {
    const c = ch[0];
    return c == 41 || c == 44 || c == 46 || c == 33 || c == 63 || c == 58 || c == 59 || c == 93 || c == 125;
  }
  const list: string[] = [
    "、", "。", "，", "．", "）", "」", "』", "】", "ー", "・", "！", "？", "：", "…", "〜", "ぁ", "ぃ", "ぅ", "ぇ", "ぉ",
    "っ", "ゃ", "ゅ", "ょ", "ゎ", "ァ", "ィ", "ゥ", "ェ", "ォ", "ッ", "ャ", "ュ", "ョ", "ヮ",
  ];
  for (const x of list) {
    if (x == ch) {
      return true;
    }
  }
  return false;
}

// 行の終わりに置かない文字（開き括弧）
function kmsNoEnd(ch: string): bool {
  if (ch.length == 1) {
    const c = ch[0];
    return c == 40 || c == 91 || c == 123;
  }
  return ch == "（" || ch == "「" || ch == "『" || ch == "【";
}

function kmsWrapHash(s: string, size: f32, maxW: i32): u32 {
  return ukHashI32(ukHashI32(ukHashStr(2166136261, s), maxW), Math.floor(size * 10.0) as i32);
}

// 幅 maxW で折り返す。uikit に足すべきもの（ukWrapText）。
// - 和文は 1 文字ごとに切れるが、行頭・行末の禁則を守る（「（」の前で切る。「。」「）」「ー」や小書きのかなを行頭に置かない）。
// - 英数字の語は切らない。1 語が幅に入らなければ、その語を … で縮める。
// - 最後の行が 1 文字だけ（句読点を除いて）になるときは、前の行の最後の 1 文字を送る（「1 コマ戻／る」→「1 コマ／戻る」、「外れま／す。」→「外れ／ます。」）。
// 結果は覚えておく（ハッシュで引く）。
function kmsWrap(ui: mut UkCtx, st: mut KmsState, s: string, size: f32, maxW: i32): string[] {
  const hsh = kmsWrapHash(s, size, maxW);
  const key = s + "|" + `${maxW}` + "|" + `${Math.floor(size * 10.0) as i32}`;
  for (let i: usize = 0; i < st.wrapH.length; i++) {
    if (st.wrapH[i] == hsh && st.wrapK[i] == key) {
      return kmsSplitLines(st.wrapV[i]);
    }
  }
  let lines: string[] = [];
  let a: usize = 0;
  let lastBreak: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    const j = kmsNextChar(s, i);
    const w = textWidthPx(ui.font, kmsSub(s, a, j), size);
    if (w > maxW && i > a) {
      let cut = i;
      const ascii = s[i] < 128 && s[i] != 32;
      if (ascii && lastBreak > a) {
        // 英数字の語の途中: 語の前で切る
        cut = lastBreak;
      } else if (ascii && s[i - 1] < 128 && s[i - 1] != 32) {
        // 1 語が幅に入らない: 語の終わりまでを … で縮めて 1 行にする
        let e = i;
        while (e < s.length && s[e] != 32 && s[e] < 128) {
          e++;
        }
        lines.push(ukFitText(mut ui, kmsSub(s, a, e), size, maxW));
        a = e;
        while (a < s.length && s[a] == 32) {
          a++;
        }
        lastBreak = a;
        i = a;
        continue;
      } else {
        // 禁則: 切る所の文字が行頭に置けないか、前の文字が行末に置けないなら、1 文字ずつ前へ（2 回まで）
        let steps = 0;
        while (steps < 2 && cut > a) {
          const p = kmsPrevChar(s, cut, a);
          if (p <= a) {
            break;
          }
          if (kmsNoStart(kmsSub(s, cut, kmsNextChar(s, cut))) || kmsNoEnd(kmsSub(s, p, cut))) {
            cut = p;
            steps++;
            continue;
          }
          break;
        }
      }
      lines.push(kmsSub(s, a, cut));
      a = cut;
      while (a < s.length && s[a] == 32) {
        a++;
      }
      lastBreak = a;
      i = a;
      continue;
    }
    // 切ってよい所: 空白の後、和文の文字の前後
    if (s[i] == 32 || s[i] >= 128 || (j < s.length && s[j] >= 128)) {
      lastBreak = j;
    }
    i = j;
  }
  if (a < s.length) {
    lines.push(kmsSub(s, a, s.length));
  }
  // 最後の行が和文の 1 文字だけなら、前の行の最後の 1 文字を送る
  const n = lines.length;
  if (n >= 2) {
    const last = lines[n - 1].clone();
    const prev = lines[n - 2].clone();
    // 句読点や閉じ括弧を除くと 1 文字だけの行（「す。」も）
    let core = 0;
    let q: usize = 0;
    while (q < last.length) {
      const qn = kmsNextChar(last, q);
      if (!kmsNoStart(kmsSub(last, q, qn))) {
        core++;
      }
      q = qn;
    }
    if (last.length > 0 && last[0] >= 128 && core <= 1 && prev.length > 0) {
      const p = kmsPrevChar(prev, prev.length, 0);
      if (p > 0 && prev[p] >= 128 && !kmsNoStart(kmsSub(prev, p, prev.length))) {
        lines[n - 2] = kmsSub(prev, 0, p);
        lines[n - 1] = kmsSub(prev, p, prev.length) + last;
      }
    }
  }
  if (st.wrapH.length >= 4096) {
    st.wrapH.clear();
    st.wrapK.clear();
    st.wrapV.clear();
  }
  st.wrapH.push(hsh);
  st.wrapK.push(key);
  st.wrapV.push(kmsJoinLines(lines));
  return lines;
}

// フォーカスの輪（ui.md 17: 外は focusOuter 1px、内は accent 2px、部品から focusOffset 離す）。uikit に足すべきもの（ukFocusRing の作り直し）。
function kmsFocusRing(ui: mut UkCtx, th: KmtTheme, r: UkRect, radius: i32): void {
  const o = th.focusOff + th.focusW + th.hairline;
  ukDrawStroke(mut ui, ukShrink(r, -o), radius + o, o, th.focusOuter);
  const i = th.focusOff + th.focusW;
  ukDrawStroke(mut ui, ukShrink(r, -i), radius + i, th.focusW, th.accent);
}

// キーの札（.kbd）の高さ
function kmsKbdH(th: KmtTheme): i32 {
  return th.lhXs + th.s1;
}

function kmsKbdW(ui: mut UkCtx, th: KmtTheme, s: string): i32 {
  return ukTextW(mut ui, s, th.fsXs) + (th.s1 + th.hairline) * 2;
}

// キーの札を (x, y) に描き、幅を返す。
function kmsKbd(ui: mut UkCtx, th: KmtTheme, x: i32, y: i32, s: string): i32 {
  const w = kmsKbdW(mut ui, th, s);
  const r = ukRect(x, y, w, kmsKbdH(th));
  ukDrawRound(mut ui, r, th.rSm, th.lineControl);
  ukDrawRound(mut ui, ukShrink(r, th.hairline), Math.max(th.rSm - th.hairline, 0), th.bg1);
  ukDrawTextIn(mut ui, ukRect(x, y, w, r.h), s, th.fsXs, th.text2, 1);
  return w;
}

// キーの札を並べる（間に「/」）。maxW に入らない分は「+n」にまとめる。描いた幅を返す（draw が false なら測るだけ）。
// chords が空なら "—"。
function kmsChips(
  ui: mut UkCtx, th: KmtTheme, st: KmsState, x0: i32, y: i32, chords: KmChord[], maxW: i32, draw: bool,
): i32 {
  const ty = y + (kmsKbdH(th) - ukLineH(ui, th.fsSm)) / 2;
  if (chords.length == 0) {
    if (draw) {
      ukDrawText(mut ui, x0, ty, "—", th.fsSm, th.text3);
    }
    return ukTextW(mut ui, "—", th.fsSm);
  }
  const sepW = th.s1 * 2 + ukTextW(mut ui, "/", th.fsSm);
  let ws: i32[] = [];
  let texts: string[] = [];
  let total = 0;
  for (let i: usize = 0; i < chords.length; i++) {
    const t = kmChordText(chords[i], st.mac, st.layout, " ");
    const w = kmsKbdW(mut ui, th, t);
    ws.push(w);
    texts.push(t);
    total = total + w;
    if (i > 0) {
      total = total + sepW;
    }
  }
  let count = chords.length;
  if (total > maxW) {
    // 入る数を求める（「+n」の幅を残す）
    count = 0;
    let acc = 0;
    for (let i: usize = 0; i < chords.length; i++) {
      let next = acc + ws[i];
      if (i > 0) {
        next = next + sepW;
      }
      const rest = (chords.length - i - 1) as i32;
      const plusW = th.s1 + ukTextW(mut ui, "+" + `${rest}`, th.fsXs);
      if (next + plusW > maxW && i > 0) {
        break;
      }
      acc = next;
      count = i + 1;
    }
  }
  let x = x0;
  for (let i: usize = 0; i < count; i++) {
    if (i > 0) {
      x = x + th.s1;
      if (draw) {
        ukDrawText(mut ui, x, ty, "/", th.fsSm, th.text3);
      }
      x = x + ukTextW(mut ui, "/", th.fsSm) + th.s1;
    }
    if (draw) {
      kmsKbd(mut ui, th, x, y, texts[i]);
    }
    x = x + ws[i];
  }
  if (count < chords.length) {
    const more = "+" + `${(chords.length - count) as i32}`;
    x = x + th.s1;
    if (draw) {
      ukDrawText(mut ui, x, y + (kmsKbdH(th) - ukLineH(ui, th.fsXs)) / 2, more, th.fsXs, th.text3);
    }
    x = x + ukTextW(mut ui, more, th.fsXs);
  }
  return x - x0;
}

// 小さなボタン（.btn.sm）。ghost は地と枠のない弱いボタン。押されたら true。uikit に「大きさ」と ghost の指定が来たら置き換える。
function kmsBtnW(ui: mut UkCtx, th: KmtTheme, label: string): i32 {
  return ukTextW(mut ui, label, th.fsSm) + th.s2 * 2;
}

function kmsBtn(ui: mut UkCtx, th: KmtTheme, label: string, idLabel: string, r: UkRect, ghost: bool): bool {
  const id = ukId(ui, idLabel);
  const h = ukBehavior(mut ui, id, r, true);
  if (!ghost) {
    let bg = th.bg3;
    if (h.held) {
      bg = th.bg2;
    } else if (h.hover) {
      bg = th.bg4;
    }
    ukDrawRound(mut ui, r, th.rMd, th.lineStrong);
    ukDrawRound(mut ui, ukShrink(r, th.hairline), Math.max(th.rMd - th.hairline, 0), bg);
    ukDrawTextIn(mut ui, r, label, th.fsSm, th.text1, 1);
  } else {
    if (h.hover) {
      ukDrawRound(mut ui, r, th.rMd, th.bg3);
    }
    ukDrawTextIn(mut ui, r, label, th.fsSm, th.text2, 1);
  }
  if (h.focused && ui.focusVisible) {
    kmsFocusRing(mut ui, th, r, th.rMd);
  }
  return h.clicked;
}

// 文字だけのボタン（.link）。押されたら true。
function kmsLink(ui: mut UkCtx, th: KmtTheme, label: string, idLabel: string, r: UkRect, align: i32): bool {
  const h = ukBehavior(mut ui, ukId(ui, idLabel), r, true);
  let c = th.accentHover;
  if (h.hover) {
    c = th.text1;
  }
  ukDrawTextIn(mut ui, r, label, th.fsXs, c, align);
  if (h.focused && ui.focusVisible) {
    kmsFocusRing(mut ui, th, r, th.rSm);
  }
  return h.clicked;
}

// セグメント（.seg）。names を並べ、選ばれている番号を返す。
function kmsSegW(ui: mut UkCtx, th: KmtTheme, names: string[]): i32 {
  let w = th.hairline * 2 + 2;
  for (const n of names) {
    w = w + ukTextW(mut ui, n, th.fsSm) + th.s3 * 2 + 2;
  }
  return w;
}

function kmsSeg(ui: mut UkCtx, th: KmtTheme, label: string, x: i32, y: i32, names: string[], cur: i32): i32 {
  const w = kmsSegW(mut ui, th, names);
  const h = th.btnSm + 2 + th.hairline * 2;
  const r = ukRect(x, y, w, h);
  ukDrawRound(mut ui, r, th.rMd, th.lineStrong);
  ukDrawRound(mut ui, ukShrink(r, th.hairline), Math.max(th.rMd - th.hairline, 0), th.bg1);
  let sel = cur;
  let cx = x + th.hairline + 2;
  ukPushId(mut ui, label);
  for (let i: usize = 0; i < names.length; i++) {
    const iw = ukTextW(mut ui, names[i], th.fsSm) + th.s3 * 2;
    const ir = ukRect(cx, y + th.hairline + 1, iw, th.btnSm);
    const hit = ukBehavior(mut ui, ukId(ui, `seg${i}`), ir, true);
    const on = (i as i32) == cur;
    if (on) {
      ukDrawRound(mut ui, ir, th.rSm, th.bg4);
    } else if (hit.hover) {
      ukDrawRound(mut ui, ir, th.rSm, th.bg3);
    }
    let tc = th.text2;
    if (on) {
      tc = th.text1;
    }
    ukDrawTextIn(mut ui, ir, names[i], th.fsSm, tc, 1);
    if (hit.focused && ui.focusVisible) {
      kmsFocusRing(mut ui, th, ir, th.rSm);
    }
    if (hit.clicked) {
      sel = i as i32;
    }
    cx = cx + iw + 2;
  }
  ukPopId(mut ui);
  return sel;
}

// 検索の欄（.search）: 枠・虫眼鏡・文字の編集。新しい文字を返す。
function kmsSearch(ui: mut UkCtx, th: KmtTheme, label: string, hint: string, r: UkRect, text: string): string {
  const id = ukId(ui, label);
  const h = ukBehaviorEx(mut ui, id, r, true, false);
  const si = ukSt(mut ui, id);
  const focused = ui.focus == id;
  let edge = th.lineControl;
  if (focused) {
    edge = th.accent;
  }
  ukDrawRound(mut ui, r, th.rMd, edge);
  ukDrawRound(mut ui, ukShrink(r, th.hairline), Math.max(th.rMd - th.hairline, 0), th.bg1);
  const pad = th.s2 + th.hairline * 2;
  ukIcon(mut ui, ukRect(r.x + pad, r.y + (r.h - th.icon) / 2, th.icon, th.icon), UK_I_SEARCH, th.text3);
  const ix = r.x + pad + th.icon + th.s2;
  const inner = ukRect(ix, r.y, r.x + r.w - pad - ix, r.h);
  const s = ukTextEdit(mut ui, id, si, inner, text, h, th.text1);
  if (s.length == 0) {
    ukDrawTextIn(mut ui, inner, hint, th.fsSm, th.text3, 0);
  }
  if (focused && ui.focusVisible) {
    kmsFocusRing(mut ui, th, r, th.rMd);
  }
  return s;
}

// キーボードの印（ヘッダーのアイコン）。uikit の icons.um に足すべきもの（UK_I_KEYBOARD）。
function kmsKeyboardIcon(ui: mut UkCtx, r: UkRect, c: u32, t: i32): void {
  const w = r.w * 13 / 16;
  const h = r.h * 8 / 16;
  const x = r.x + (r.w - w) / 2;
  const y = r.y + (r.h - h) / 2;
  ukDrawStroke(mut ui, ukRect(x, y, w, h), Math.max(r.w / 12, 1), t, c);
  const d = Math.max(r.w / 12, 1);
  for (let i = 0; i < 4; i++) {
    ukDrawRect(mut ui, ukRect(x + w * (2 + i * 3) / 13, y + h * 5 / 16, d, d), c);
  }
  ukDrawRect(mut ui, ukRect(x + w * 3 / 13, y + h * 11 / 16, w * 7 / 13, t), c);
}

// ---- キーボードの絵 ----

struct KmsKey {
  // US の位置の名前（"" は隙間、"#" で始まるものは修飾キーなど割り当てられないキー）
  key: string;
  // 幅（キーの幅の 10 倍）
  w10: i32;
}

// 描く位置のついたキー（row は見た目の段。右の部分は 2〜5 段目）
struct KmsBox {
  key: string;
  r: UkRect;
  row: i32;
}

function kmsK(row: mut KmsKey[], key: string, w10: i32): void {
  row.push({ key: key.clone(), w10 });
}

function kmsLetters(row: mut KmsKey[], s: string): void {
  for (let i: usize = 0; i < s.length; i++) {
    row.push({ key: stringFromBytes([s[i]]), w10: 10 });
  }
}

// 主の部分の 6 段（shortcuts.html と同じ並びと幅）。1 段の幅は w10 の合計だけで決まるので、Mac の下の段も合計を PC と同じにする。
function kmsMainRows(layout: i32, mac: bool): KmsKey[][] {
  let rows: KmsKey[][] = [];
  let r0: KmsKey[] = [];
  kmsK(mut r0, "Esc", 10);
  kmsK(mut r0, "", 4);
  for (let i = 1; i <= 12; i++) {
    kmsK(mut r0, "F" + `${i}`, 10);
    if (i == 4 || i == 8) {
      kmsK(mut r0, "", 4);
    }
  }
  rows.push(r0);
  let r1: KmsKey[] = [];
  kmsK(mut r1, "`", 10);
  kmsLetters(mut r1, "1234567890-=");
  if (layout == KM_LAYOUT_JIS) {
    kmsK(mut r1, "Yen", 10);
    kmsK(mut r1, "Backspace", 14);
  } else {
    kmsK(mut r1, "Backspace", 24);
  }
  rows.push(r1);
  let r2: KmsKey[] = [];
  kmsK(mut r2, "Tab", 14);
  kmsLetters(mut r2, "QWERTYUIOP[]");
  if (layout == KM_LAYOUT_JIS) {
    kmsK(mut r2, "Enter", 14);
  } else {
    kmsK(mut r2, "\\", 14);
  }
  rows.push(r2);
  let r3: KmsKey[] = [];
  if (layout == KM_LAYOUT_JIS) {
    kmsK(mut r3, "#英数", 17);
    kmsLetters(mut r3, "ASDFGHJKL;'\\");
    kmsK(mut r3, "", 11);
  } else {
    kmsK(mut r3, "#Caps", 17);
    kmsLetters(mut r3, "ASDFGHJKL;'");
    kmsK(mut r3, "Enter", 21);
  }
  rows.push(r3);
  let r4: KmsKey[] = [];
  kmsK(mut r4, "#Shift", 22);
  kmsLetters(mut r4, "ZXCVBNM,./");
  if (layout == KM_LAYOUT_JIS) {
    kmsK(mut r4, "Ro", 10);
    kmsK(mut r4, "#Shift", 16);
  } else {
    kmsK(mut r4, "#Shift", 26);
  }
  rows.push(r4);
  let r5: KmsKey[] = [];
  if (mac) {
    // Mac: Control・Option・Command（スペースの隣が Command）
    if (layout == KM_LAYOUT_JIS) {
      kmsK(mut r5, "#Ctrl", 13);
      kmsK(mut r5, "#Alt", 10);
      kmsK(mut r5, "#Win", 13);
      kmsK(mut r5, "Muhenkan", 12);
      kmsK(mut r5, "Space", 43);
      kmsK(mut r5, "Henkan", 12);
      kmsK(mut r5, "#Win", 13);
      kmsK(mut r5, "#Alt", 10);
    } else {
      kmsK(mut r5, "#Ctrl", 13);
      kmsK(mut r5, "#Alt", 13);
      kmsK(mut r5, "#Win", 16);
      kmsK(mut r5, "Space", 55);
      kmsK(mut r5, "#Win", 16);
      kmsK(mut r5, "#Alt", 13);
    }
  } else if (layout == KM_LAYOUT_JIS) {
    kmsK(mut r5, "#Ctrl", 13);
    kmsK(mut r5, "#Win", 10);
    kmsK(mut r5, "#Alt", 10);
    kmsK(mut r5, "Muhenkan", 12);
    kmsK(mut r5, "Space", 36);
    kmsK(mut r5, "Henkan", 12);
    kmsK(mut r5, "Kana", 10);
    kmsK(mut r5, "#Alt", 10);
    kmsK(mut r5, "#Ctrl", 13);
  } else {
    kmsK(mut r5, "#Ctrl", 13);
    kmsK(mut r5, "#Win", 13);
    kmsK(mut r5, "#Alt", 13);
    kmsK(mut r5, "Space", 48);
    kmsK(mut r5, "#Alt", 13);
    kmsK(mut r5, "#Win", 13);
    kmsK(mut r5, "#Ctrl", 13);
  }
  rows.push(r5);
  return rows;
}

// 右の部分（主の部分の 3 段目から 6 段目に並ぶ）
function kmsSideRows(): KmsKey[][] {
  let rows: KmsKey[][] = [];
  let a: KmsKey[] = [];
  kmsK(mut a, "Insert", 10);
  kmsK(mut a, "Home", 10);
  kmsK(mut a, "PageUp", 10);
  rows.push(a);
  let b: KmsKey[] = [];
  kmsK(mut b, "Delete", 10);
  kmsK(mut b, "End", 10);
  kmsK(mut b, "PageDown", 10);
  rows.push(b);
  let c: KmsKey[] = [];
  kmsK(mut c, "", 10);
  kmsK(mut c, "Up", 10);
  kmsK(mut c, "", 10);
  rows.push(c);
  let d: KmsKey[] = [];
  kmsK(mut d, "Left", 10);
  kmsK(mut d, "Down", 10);
  kmsK(mut d, "Right", 10);
  rows.push(d);
  return rows;
}

// キーの絵に出す刻印（長い名前は短く。Mac の修飾キーは Mac の名前）
function kmsCapText(key: string, layout: i32, mac: bool): string {
  if (key.length > 0 && key[0] == 35) {
    const n = kmsSub(key, 1, key.length);
    if (mac) {
      if (n == "Ctrl") {
        return "Control";
      }
      if (n == "Alt") {
        return "Option";
      }
      if (n == "Win") {
        return "Cmd";
      }
    }
    return n;
  }
  if (mac && layout == KM_LAYOUT_JIS) {
    if (key == "Muhenkan") {
      return "英数";
    }
    if (key == "Henkan") {
      return "かな";
    }
  }
  switch (key) {
    case "Backspace": return "BS";
    case "Delete": return "Del";
    case "Insert": return "Ins";
  }
  return kmKeyCap(key, layout);
}

// 修飾キーの絵が、いま見せている修飾キー mods で点くか
function kmsModLit(n: string, mods: i32, mac: bool): bool {
  if (n == "Shift") {
    return (mods & KM_MOD_SHIFT) != 0;
  }
  if (n == "Alt") {
    return (mods & KM_MOD_ALT) != 0;
  }
  if (n == "Ctrl") {
    // Mac の Control は META、PC の Ctrl は主の修飾キー
    return (mods & (mac ? KM_MOD_META : KM_MOD_CTRL)) != 0;
  }
  if (n == "Win") {
    // Mac の Command は主の修飾キー、PC の Win は META
    return (mods & (mac ? KM_MOD_CTRL : KM_MOD_META)) != 0;
  }
  return false;
}

function kmsKeyW(th: KmtTheme, ku: i32, w10: i32): i32 {
  // 幅 u のキーは u×単位 ＋ (u−1)×間
  return (w10 * ku + (w10 - 10) * th.s1) / 10;
}

function kmsSpacerW(ku: i32, w10: i32): i32 {
  return w10 * ku / 10;
}

function kmsRowW(th: KmtTheme, ku: i32, row: KmsKey[]): i32 {
  let w = 0;
  for (let i: usize = 0; i < row.length; i++) {
    if (i > 0) {
      w = w + th.s1;
    }
    if (row[i].key.length == 0) {
      w = w + kmsSpacerW(ku, row[i].w10);
    } else {
      w = w + kmsKeyW(th, ku, row[i].w10);
    }
  }
  return w;
}

function kmsMainW(th: KmtTheme, ku: i32, rows: KmsKey[][]): i32 {
  let w = 0;
  for (const row of rows) {
    w = Math.max(w, kmsRowW(th, ku, row));
  }
  return w;
}

// avail の幅に入るキーの単位（tokens の値から、下限 keyMinUnit まで縮める）
function kmsFitUnit(th: KmtTheme, layout: i32, mac: bool, avail: i32): i32 {
  const rows = kmsMainRows(layout, mac);
  const side = kmsSideRows();
  let u = th.keyUnit;
  while (u > th.keyMinUnit) {
    if (kmsMainW(th, u, rows) + th.colGap + kmsRowW(th, u, side[0]) <= avail) {
      break;
    }
    u--;
  }
  return u;
}

// キーの高さ（単位に合わせて縮める。刻印と名前の 2 行は入れる）
function kmsKeyH(th: KmtTheme, ku: i32): i32 {
  const minH = (th.s1 - th.hairline) * 2 + (th.lhSm - th.hairline) * 2 + th.hairline * 3;
  return Math.max(th.keyH * ku / th.keyUnit, minH);
}

function kmsBoxes(th: KmtTheme, layout: i32, mac: bool, ku: i32, kh: i32, x0: i32, y0: i32): KmsBox[] {
  let out: KmsBox[] = [];
  const rows = kmsMainRows(layout, mac);
  let y = y0;
  for (let ri: usize = 0; ri < rows.length; ri++) {
    let x = x0;
    for (const k of rows[ri]) {
      if (k.key.length == 0) {
        x = x + kmsSpacerW(ku, k.w10) + th.s1;
        continue;
      }
      const w = kmsKeyW(th, ku, k.w10);
      out.push({ key: k.key.clone(), r: ukRect(x, y, w, kh), row: ri as i32 });
      x = x + w + th.s1;
    }
    y = y + kh + th.s1;
  }
  const side = kmsSideRows();
  const sx = x0 + kmsMainW(th, ku, rows) + th.colGap;
  let sy = y0 + (kh + th.s1) * 2;
  for (let si: usize = 0; si < side.length; si++) {
    let x = sx;
    for (const k of side[si]) {
      const w = kmsKeyW(th, ku, k.w10);
      if (k.key.length > 0) {
        out.push({ key: k.key.clone(), r: ukRect(x, sy, w, kh), row: (si as i32) + 2 });
      }
      x = x + w + th.s1;
    }
    sy = sy + kh + th.s1;
  }
  return out;
}

function kmsCat(cmds: KmCommand[], id: string): i32 {
  const i = kmFindCommand(cmds, id);
  if (i < 0) {
    return KM_CAT_NONE;
  }
  return cmds[i as usize].cat;
}

// 名前の行の高さ（刻印と名前。mockup の line-height 15px）
function kmsKeyLh(th: KmtTheme): i32 {
  return th.lhSm - th.hairline;
}

// キーの上の名前を何行まで出せるか
function kmsKeyLines(th: KmtTheme, kh: i32): i32 {
  const padY = th.s1 - th.hairline;
  const avail = kh - padY * 2 - th.hairline * 3 - kmsKeyLh(th);
  return Math.max(avail / kmsKeyLh(th), 1);
}

// キーの絵の覚えを作り直す（map・配列・Mac・修飾キー・言語・大きさが変わったときだけ）
function kmsKbCache(
  ui: mut UkCtx, st: mut KmsState, map: KmMap, cmds: KmCommand[], tr: I18n, th: KmtTheme, boxes: KmsBox[], mods: i32,
  sig: u32,
): void {
  let bw = 0;
  let bh = 0;
  if (boxes.length > 0) {
    bw = boxes[0].r.w;
    bh = boxes[0].r.h;
  }
  const ck = `${sig}|${st.layout}|${st.mac}|${mods}|${tr.lang}|${boxes.length}|${bw}|${bh}`;
  if (ck == st.kbKey) {
    return;
  }
  st.kbKey = ck;
  st.kbCmd.clear();
  st.kbCat.clear();
  st.kbName.clear();
  const padX = th.s1 + th.hairline;
  for (const b of boxes) {
    let cmd = "";
    if (b.key[0] != 35) {
      cmd = kmCommandOnKey(map, mods, b.key);
    }
    let cat = KM_CAT_NONE;
    let name = "";
    if (cmd.length > 0) {
      cat = kmsCat(cmds, cmd);
      const maxL = kmsKeyLines(th, b.r.h) as usize;
      const ls = kmsWrap(mut ui, mut st, kmsCapName(tr, cmd), th.fsSm, b.r.w - padX * 2);
      let keep: string[] = [];
      for (let i: usize = 0; i < ls.length && i < maxL; i++) {
        keep.push(ls[i].clone());
      }
      if (ls.length > maxL && maxL > 0) {
        // 入らない分は … で縮める
        let rest = "";
        for (let i = maxL - 1; i < ls.length; i++) {
          rest = rest + ls[i];
        }
        keep[maxL - 1] = ukFitText(mut ui, rest, th.fsSm, b.r.w - padX * 2);
      }
      name = kmsJoinLines(keep);
    }
    st.kbCmd.push(cmd);
    st.kbCat.push(cat);
    st.kbName.push(name);
  }
}

// 1 つのキーを描く。押されたら true。
function kmsKey(
  ui: mut UkCtx, st: KmsState, tr: I18n, th: KmtTheme, b: KmsBox, idx: usize, mods: i32, selChords: KmChord[],
  focusIt: bool,
): bool {
  const fixed = b.key[0] == 35;
  const cmd = st.kbCmd[idx].clone();
  const cat = st.kbCat[idx];
  let face = th.catFace[cat as usize];
  let edge = th.catEdge[cat as usize];
  if (fixed && kmsModLit(kmsSub(b.key, 1, b.key.length), mods, st.mac)) {
    face = ukMix(th.bg3, th.accent, 60);
    edge = th.accent;
  }
  ukPushIdInt(mut ui, idx as i32);
  const id = ukId(ui, "key");
  ukPopId(mut ui);
  const r = b.r;
  const h = ukBehavior(mut ui, id, r, false);
  if (h.hover && cmd.length > 0) {
    ukTooltip(mut ui, kmsCmdName(tr, cmd) + "  " + kmChordText(kmChord(mods, b.key), st.mac, st.layout, "+"));
  }
  if (h.hover && !fixed) {
    face = ukMix(face, th.text1, 16);
  }
  // 縁（下は 2px）と面
  ukDrawRound(mut ui, r, th.rMd, edge);
  ukDrawRound(mut ui, ukRect(r.x + th.hairline, r.y + th.hairline, r.w - th.hairline * 2, r.h - th.hairline * 3), Math.max(th.rMd - th.hairline, 0), face);
  const padX = th.s1 + th.hairline;
  const padY = th.s1 - th.hairline;
  const lh = kmsKeyLh(th);
  ukPushClip(mut ui, ukShrink(r, th.hairline));
  // 刻印（割り当てのないキーも text.2。text.3 は bg.0〜bg.2 の上だけ）
  ukDrawText(mut ui, r.x + padX, r.y + th.hairline + padY + (lh - ukLineH(ui, th.fsSm)) / 2, kmsCapText(b.key, st.layout, st.mac), th.fsSm, th.text2);
  if (cmd.length > 0) {
    const lines = kmsSplitLines(st.kbName[idx]);
    const n = lines.length as i32;
    let y = r.y + r.h - th.hairline * 2 - padY - n * lh;
    for (let i: usize = 0; i < lines.length; i++) {
      ukDrawText(mut ui, r.x + padX, y + (lh - ukLineH(ui, th.fsSm)) / 2, lines[i], th.fsSm, th.text1);
      y = y + lh;
    }
  }
  ukPopClip(mut ui);
  // 選んだコマンドのキー（青）と、重なりを確かめているキー（橙）
  if (!fixed) {
    const ch = kmChord(mods, b.key);
    let ring: u32 = 0;
    for (const c of selChords) {
      if (kmChordEq(c, ch)) {
        ring = th.accent;
      }
    }
    if (st.pendKind == KMS_PEND_CONFLICT || st.pendKind == KMS_PEND_RESERVED) {
      if (kmChordEq(st.pendChord, ch)) {
        ring = th.warn;
      }
    }
    if (ring != 0) {
      ukDrawStroke(mut ui, ukShrink(r, -th.focusW), th.rMd + th.focusW, th.focusW, ring);
    }
  }
  if (focusIt) {
    kmsFocusRing(mut ui, th, r, th.rMd);
  }
  return h.clicked;
}

// 見た目の段 row の中で、x の中心がいちばん近いキー（無ければ -1）
function kmsNearest(boxes: KmsBox[], row: i32, cx: i32): i32 {
  let best = -1;
  let bd = 0;
  for (let i: usize = 0; i < boxes.length; i++) {
    if (boxes[i].row != row) {
      continue;
    }
    const d = Math.abs(boxes[i].r.x + boxes[i].r.w / 2 - cx);
    if (best < 0 || d < bd) {
      best = i as i32;
      bd = d;
    }
  }
  return best;
}

// 同じ段の左（dir −1）か右（+1）のキー
function kmsBeside(boxes: KmsBox[], cur: i32, dir: i32): i32 {
  const b = boxes[cur as usize].r;
  const row = boxes[cur as usize].row;
  let best = -1;
  let bd = 0;
  for (let i: usize = 0; i < boxes.length; i++) {
    if (boxes[i].row != row || (i as i32) == cur) {
      continue;
    }
    const d = (boxes[i].r.x - b.x) * dir;
    if (d > 0 && (best < 0 || d < bd)) {
      best = i as i32;
      bd = d;
    }
  }
  return best;
}

function kmsKeyboard(
  ui: mut UkCtx, st: mut KmsState, tr: I18n, th: KmtTheme, boxes: KmsBox[], area: UkRect, mods: i32,
  selChords: KmChord[],
): void {
  const kbId = ukId(ui, "##kmsKeyboard");
  const kbFocused = ui.focus == kbId;
  if (st.kbCur >= (boxes.length as i32)) {
    st.kbCur = -1;
  }
  for (let i: usize = 0; i < boxes.length; i++) {
    const focusIt = kbFocused && ui.focusVisible && (i as i32) == st.kbCur;
    if (kmsKey(mut ui, st, tr, th, boxes[i], i, mods, selChords, focusIt)) {
      st.kbCur = i as i32;
      ukFocus(mut ui, kbId, false);
      if (st.kbCmd[i].length > 0) {
        st.sel = st.kbCmd[i].clone();
      }
    }
  }
  // 絵の全体で 1 つのフォーカスの止まり。矢印でキーを動き、Enter / Space で選ぶ（キーの部品より後に呼んで、クリックを取らない）
  const h = ukBehaviorEx(mut ui, kbId, area, true, false);
  if (h.focused && boxes.length > 0) {
    if (st.kbCur < 0) {
      st.kbCur = 0;
    }
    const cur = st.kbCur;
    const cb = boxes[cur as usize].r;
    let nx = -1;
    if (ukKeyTake(mut ui, UK_KEY_LEFT)) {
      nx = kmsBeside(boxes, cur, -1);
    } else if (ukKeyTake(mut ui, UK_KEY_RIGHT)) {
      nx = kmsBeside(boxes, cur, 1);
    } else if (ukKeyTake(mut ui, UK_KEY_UP)) {
      nx = kmsNearest(boxes, boxes[cur as usize].row - 1, cb.x + cb.w / 2);
    } else if (ukKeyTake(mut ui, UK_KEY_DOWN)) {
      nx = kmsNearest(boxes, boxes[cur as usize].row + 1, cb.x + cb.w / 2);
    }
    if (nx >= 0) {
      st.kbCur = nx;
      ui.focusVisible = true;
    }
    if (ukKeyTake(mut ui, UK_KEY_ENTER) || ukKeyTake(mut ui, UK_KEY_SPACE)) {
      if (st.kbCmd[st.kbCur as usize].length > 0) {
        st.sel = st.kbCmd[st.kbCur as usize].clone();
      }
    }
    // フォーカスしたキーの正式な名前（ui.md 5.3: ホバーとフォーカスで出す）
    const fc = st.kbCmd[st.kbCur as usize].clone();
    if (ui.focusVisible && fc.length > 0) {
      const fr = boxes[st.kbCur as usize].r;
      ui.tipText = kmsCmdName(tr, fc) + "  " + kmChordText(kmChord(mods, boxes[st.kbCur as usize].key), st.mac, st.layout, "+");
      ui.tipX = fr.x;
      ui.tipY = fr.y + fr.h;
    }
  }
}

// ---- 下の一覧 ----

// 「どの配列でも同じ」: 標準の最初のキーが、3 つのプリセットのすべてにある（ui.md 5.2 の Delete・Shift+Delete の決まりなど）
function kmsSameAll(st: KmsState, id: string): bool {
  const a = kmChordsFor(st.presets[0], id);
  if (a.length == 0) {
    return false;
  }
  for (let p: usize = 1; p < st.presets.length; p++) {
    const b = kmChordsFor(st.presets[p], id);
    let found = false;
    for (const c of b) {
      if (kmChordEq(c, a[0])) {
        found = true;
      }
    }
    if (!found) {
      return false;
    }
  }
  return true;
}

function kmsChordsText(st: KmsState, cs: KmChord[]): string {
  let s = "";
  for (const c of cs) {
    // Mac でも PC の名前（Ctrl・Alt）で探せるようにする
    s = s + kmChordText(c, st.mac, KM_LAYOUT_US, "+") + " " + kmChordText(c, st.mac, st.layout, "+") + " ";
    if (st.mac) {
      s = s + kmChordText(c, false, KM_LAYOUT_US, "+") + " ";
    }
  }
  return s;
}

function kmsMapSig(m: KmMap): u32 {
  let h = ukHashI32(2166136261, m.preset);
  for (const b of m.binds) {
    h = ukHashStr(h, b.cmd);
    h = ukHashStr(h, b.chord.key);
    h = ukHashI32(h, b.chord.mods);
    h = ukHashStr(h, b.ctx);
  }
  return h;
}

// 一覧に出すコマンドの番号（名前・ID・キーで合うものが先、別名（alias.*）で合うものが後）。
// 表と同じく、1 つの行（row）からは最初に合った 1 つだけを出す。
function kmsListItems(st: KmsState, map: KmMap, cmds: KmCommand[], tr: I18n, q: string): i32[] {
  let first: i32[] = [];
  let later: i32[] = [];
  let seen: string[] = [];
  for (let i: usize = 0; i < cmds.length; i++) {
    const id = cmds[i].id.clone();
    const ja = i18nTL(tr, I18N_JA, "cmd." + id);
    const en = i18nTL(tr, I18N_EN, "cmd." + id);
    let hit = kmMatch(q, ja, en, id, "");
    if (!hit && q.length > 0) {
      hit = kmMatch(q, "", "", "", kmsChordsText(st, kmChordsFor(map, id)));
    }
    let alias = false;
    if (!hit && i18nHas(tr, "alias." + id)) {
      alias = kmMatch(q, i18nTL(tr, I18N_JA, "alias." + id), i18nTL(tr, I18N_EN, "alias." + id), "", "");
    }
    if (!hit && !alias) {
      continue;
    }
    let dup = false;
    for (const r of seen) {
      if (r == cmds[i].row) {
        dup = true;
      }
    }
    if (dup) {
      continue;
    }
    seen.push(cmds[i].row.clone());
    if (hit) {
      first.push(i as i32);
    } else {
      later.push(i as i32);
    }
  }
  for (const v of later) {
    first.push(v);
  }
  return first;
}

// 一覧の行の高さ（選んだ行は操作の段、edit.lift は Resolve との違いの注が増える）
function kmsItemH(ui: mut UkCtx, st: mut KmsState, tr: I18n, th: KmtTheme, id: string, w: i32): i32 {
  let h = (th.s2 - th.hairline) * 2 + kmsKbdH(th) + 2 + th.lhXs + 2;
  if (id == "edit.lift") {
    const ls = kmsWrap(mut ui, mut st, i18nT(tr, "keymap.note.liftResolve"), th.fsSm, w - th.s2 * 2);
    h = h + (ls.length as i32) * (th.lhSm + 2) + th.s1;
  }
  if (st.sel == id) {
    if (st.capturing) {
      const ls = kmsWrap(mut ui, mut st, i18nT(tr, "keymap.press"), th.fsSm, w - th.s2 * 2);
      h = h + (ls.length as i32) * (th.lhSm + 2) + th.s1;
    } else {
      h = h + th.btnSm + th.s1;
    }
  }
  return h;
}

// 2 つの割り当ての並びが同じか（順は問わない）
function kmsSameChords(a: KmChord[], b: KmChord[]): bool {
  if (a.length != b.length) {
    return false;
  }
  for (const x of a) {
    let found = false;
    for (const y of b) {
      if (kmChordEq(x, y)) {
        found = true;
      }
    }
    if (!found) {
      return false;
    }
  }
  return true;
}

// プリセットの既定と違うコマンドの数
function kmsDiffCount(map: KmMap, def: KmMap, cmds: KmCommand[]): i32 {
  let n = 0;
  for (const c of cmds) {
    if (!kmsSameChords(kmChordsFor(map, c.id), kmChordsFor(def, c.id))) {
      n++;
    }
  }
  return n;
}

// 画面の移動に使うキー（ui.md 17: Tab・F6・Enter）。割り当てるときは確かめる。
function kmsReserved(c: KmChord): bool {
  if (c.key == "Tab") {
    return true;
  }
  if (c.key == "F6" && (c.mods | KM_MOD_SHIFT) == KM_MOD_SHIFT) {
    return true;
  }
  return c.key == "Enter" && c.mods == 0;
}

// c を sel に割り当てる（移動に使うキーと、外れるものがあれば確かめる）
function kmsTryAssign(st: mut KmsState, map: mut KmMap, cmds: KmCommand[], cmd: string, c: KmChord, checkReserved: bool, res: mut KmsResult): void {
  if (checkReserved && kmsReserved(c)) {
    st.pendKind = KMS_PEND_RESERVED;
    st.pendCmd = cmd.clone();
    st.pendChord = kmChord(c.mods, c.key);
    return;
  }
  const victims = kmAssignVictims(map, cmds, cmd, c);
  if (victims.length > 0) {
    kmsPropose(mut st, cmd, c);
    return;
  }
  kmAssign(mut map, cmds, cmd, c, true);
  st.pendKind = KMS_PEND_NONE;
  res.changed = true;
}

function kmsStartCapture(st: mut KmsState, id: string, r: UkRect): void {
  st.sel = id.clone();
  st.capturing = true;
  st.capRect = r;
  if (st.pendKind != KMS_PEND_PRESET) {
    st.pendKind = KMS_PEND_NONE;
  }
}

function kmsRowId(ui: mut UkCtx, id: string): u32 {
  ukPushId(mut ui, id);
  const r = ukId(ui, "row");
  ukPopId(mut ui);
  return r;
}

// 一覧の 1 行。行を押すと選び、ダブルクリック・Enter・［割り当てる］でキーを待つ。
// 中のボタンを先に呼び、行のふるまいは最後に呼ぶ（行がボタンのクリックを取らないように）。
function kmsListItem(
  ui: mut UkCtx, st: mut KmsState, map: mut KmMap, cmds: KmCommand[], tr: I18n, th: KmtTheme, r: UkRect, ci: i32,
  res: mut KmsResult,
): void {
  const id = cmds[ci as usize].id.clone();
  const rowId = kmsRowId(mut ui, id);
  ukPushId(mut ui, id);
  const on = st.sel == id;
  const cap = st.capturing && on;
  const hover = ui.hot == rowId;
  if (on) {
    ukDrawRound(mut ui, r, th.rMd, th.accentTint);
  } else if (hover) {
    ukDrawRound(mut ui, r, th.rMd, ukAlpha(th.bg3, 160));
  }
  if (cap) {
    ukDrawStroke(mut ui, r, th.rMd, th.hairline, th.accent);
  }
  const pad = th.s2;
  const top = r.y + th.s2 - th.hairline;
  const chH = kmsKbdH(th);
  const cs = kmChordsFor(map, id);
  const right = r.x + r.w - pad;
  const inner = r.w - pad * 2;
  // 名前に最低 4 割を残し、キーの札は残りに入る分だけ（入らなければ「+n」）
  const chipsMax = inner - inner * 40 / 100 - th.s2;
  let chipsW = 0;
  if (cs.length > 0) {
    chipsW = kmsChips(mut ui, th, st, 0, top, cs, chipsMax, false);
    kmsChips(mut ui, th, st, right - chipsW, top, cs, chipsMax, true);
  } else {
    const t = i18nT(tr, "keymap.unassigned");
    chipsW = ukTextW(mut ui, t, th.fsXs);
    ukDrawTextIn(mut ui, ukRect(right - chipsW, top, chipsW, chH), t, th.fsXs, th.text3, 2);
  }
  const nameW = inner - chipsW - th.s2;
  ukDrawTextIn(mut ui, ukRect(r.x + pad, top, nameW, chH), kmsCmdName(tr, id), th.fsSm, th.text1, 0);
  let y = top + chH + 2;
  ukDrawTextIn(mut ui, ukRect(r.x + pad, y, inner / 2, th.lhXs + 2), id, th.fsXs, th.text3, 0);
  let assign = false;
  if (cs.length == 0 && !on) {
    const t = i18nT(tr, "keymap.assign");
    const tw = ukTextW(mut ui, t, th.fsXs);
    assign = kmsLink(mut ui, th, t, "##assign", ukRect(right - tw, y, tw, th.lhXs + 2), 2);
  } else if (cs.length > 0 && kmsSameAll(st, id)) {
    ukDrawTextIn(mut ui, ukRect(r.x + pad + inner / 2, y, inner / 2, th.lhXs + 2), i18nT(tr, "keymap.sameAll"), th.fsXs, th.text3, 2);
  }
  y = y + th.lhXs + 2;
  // Delete の行の注（ui.md 5.2: 割り当ての画面の Delete の行にも同じ 1 行を添える）
  if (id == "edit.lift") {
    y = y + th.s1;
    const ls = kmsWrap(mut ui, mut st, i18nT(tr, "keymap.note.liftResolve"), th.fsSm, inner);
    for (const l of ls) {
      ukDrawText(mut ui, r.x + pad, y + (th.lhSm + 2 - ukLineH(ui, th.fsSm)) / 2, l, th.fsSm, th.warn);
      y = y + th.lhSm + 2;
    }
  }
  // 選んだ行: キー待ちの案内か、操作のボタン
  if (on) {
    y = y + th.s1;
    if (cap) {
      const ls = kmsWrap(mut ui, mut st, i18nT(tr, "keymap.press"), th.fsSm, inner);
      for (const l of ls) {
        ukDrawText(mut ui, r.x + pad, y + (th.lhSm + 2 - ukLineH(ui, th.fsSm)) / 2, l, th.fsSm, th.accentHover);
        y = y + th.lhSm + 2;
      }
    } else {
      let bx = r.x + pad;
      const t1 = i18nT(tr, "keymap.assign");
      const w1 = kmsBtnW(mut ui, th, t1);
      if (kmsBtn(mut ui, th, t1, "##bAssign", ukRect(bx, y, w1, th.btnSm), false)) {
        assign = true;
      }
      bx = bx + w1 + th.s2;
      if (cs.length > 0) {
        const t2 = i18nT(tr, "keymap.unassign");
        const w2 = kmsBtnW(mut ui, th, t2);
        if (kmsBtn(mut ui, th, t2, "##bUnassign", ukRect(bx, y, w2, th.btnSm), true)) {
          kmUnassign(mut map, id);
          res.changed = true;
        }
        bx = bx + w2 + th.s2;
      }
      const def = kmChordsFor(st.defMap, id);
      if (!kmsSameChords(cs, def)) {
        const t3 = i18nT(tr, "keymap.resetOne");
        const w3 = kmsBtnW(mut ui, th, t3);
        if (kmsBtn(mut ui, th, t3, "##bReset", ukRect(bx, y, w3, th.btnSm), true)) {
          kmUnassign(mut map, id);
          res.changed = true;
          for (const c of def) {
            kmsTryAssign(mut st, mut map, cmds, id, c, false, mut res);
          }
        }
      }
    }
  }
  ukPopId(mut ui);
  const h = ukBehaviorEx(mut ui, rowId, r, true, false);
  if (h.focused && ui.focusVisible) {
    kmsFocusRing(mut ui, th, r, th.rMd);
  }
  if (h.clicked || h.pressed) {
    st.sel = id.clone();
  }
  if (h.dbl || assign) {
    kmsStartCapture(mut st, id, r);
  }
}

// 警告の箱。高さを返す（draw が false なら測るだけ）。何も出さないときは 0。
function kmsWarnBox(
  ui: mut UkCtx, st: mut KmsState, map: mut KmMap, cmds: KmCommand[], tr: I18n, th: KmtTheme, x: i32, y: i32, w: i32,
  draw: bool, res: mut KmsResult,
): i32 {
  const pad = th.s3 - th.hairline * 2;
  let body = "";
  let title = "";
  let okLabel = "";
  if (st.pendKind == KMS_PEND_CONFLICT) {
    const victims = kmAssignVictims(map, cmds, st.pendCmd, st.pendChord);
    let names = "";
    let plain = "";
    for (let i: usize = 0; i < victims.length; i++) {
      if (i > 0) {
        names = names + i18nT(tr, "keymap.conflict.join");
        plain = plain + i18nT(tr, "keymap.conflict.joinPlain");
      }
      names = names + kmsShortName(tr, victims[i]);
      plain = plain + kmsShortName(tr, victims[i]);
    }
    title = i18nT(tr, "keymap.conflict.title");
    body = i18nFmt(tr, "keymap.conflict.body", [kmChordText(st.pendChord, st.mac, st.layout, "+"), kmsShortName(tr, st.pendCmd), names]);
    okLabel = i18nFmt(tr, "keymap.conflict.replace", [plain]);
  } else if (st.pendKind == KMS_PEND_RESERVED) {
    title = i18nT(tr, "keymap.reserved.title");
    body = i18nFmt(tr, "keymap.reserved.body", [kmChordText(st.pendChord, st.mac, st.layout, "+"), kmsShortName(tr, st.pendCmd)]);
    okLabel = i18nT(tr, "keymap.reserved.assign");
  } else if (st.pendKind == KMS_PEND_PRESET) {
    title = i18nT(tr, "keymap.presetChange.title");
    const n = kmsDiffCount(map, st.defMap, cmds);
    body = i18nFmt(tr, "keymap.presetChange.body", [`${n}`, i18nT(tr, "keymap.preset." + kmPresetId(st.pendPreset))]);
    okLabel = i18nT(tr, "keymap.presetChange.ok");
  } else if (st.confN > 0) {
    title = i18nFmt(tr, "keymap.conflicts.count", [`${st.confN}`]);
  } else {
    return 0;
  }
  const lines = kmsWrap(mut ui, mut st, body, th.fsSm, w - pad * 2);
  const lh = th.lhMd;
  let h = pad + th.iconMd + th.s1;
  if (body.length > 0) {
    h = h + (lines.length as i32) * lh;
  }
  // ボタンは 1 段に入らなければ 2 段にする
  const cancel = i18nT(tr, "keymap.conflict.cancel");
  const w1 = Math.min(kmsBtnW(mut ui, th, okLabel), w - pad * 2);
  const w2 = kmsBtnW(mut ui, th, cancel);
  const twoRows = w1 + th.s2 + w2 > w - pad * 2;
  if (okLabel.length > 0) {
    h = h + th.s2 + th.btnSm;
    if (twoRows) {
      h = h + th.s1 + th.btnSm;
    }
  }
  h = h + pad;
  if (!draw) {
    return h;
  }
  const r = ukRect(x, y, w, h);
  ukDrawRound(mut ui, r, th.rMd, ukAlpha(th.warn, 128));
  ukDrawRound(mut ui, ukShrink(r, th.hairline), Math.max(th.rMd - th.hairline, 0), ukMix(th.bg1, th.warnTint | 0xff000000, 18));
  let cy = y + pad;
  ukIcon(mut ui, ukRect(x + pad, cy + (th.iconMd - th.icon) / 2, th.icon, th.icon), UK_I_WARN, th.warn);
  ukDrawTextIn(mut ui, ukRect(x + pad + th.icon + th.s2, cy, w - pad * 2 - th.icon - th.s2, th.iconMd), title, th.fsSm, th.text1, 0);
  cy = cy + th.iconMd + th.s1;
  if (body.length > 0) {
    for (const ln of lines) {
      ukDrawText(mut ui, x + pad, cy + (lh - ukLineH(ui, th.fsSm)) / 2, ln, th.fsSm, th.text1);
      cy = cy + lh;
    }
  }
  if (okLabel.length > 0) {
    cy = cy + th.s2;
    const ok = kmsBtn(mut ui, th, okLabel, "##kmsWarnOk", ukRect(x + pad, cy, w1, th.btnSm), false);
    let cx = x + pad + w1 + th.s2;
    if (twoRows) {
      cx = x + pad;
      cy = cy + th.btnSm + th.s1;
    }
    const no = kmsBtn(mut ui, th, cancel, "##kmsWarnCancel", ukRect(cx, cy, w2, th.btnSm), true);
    if (ok) {
      if (st.pendKind == KMS_PEND_CONFLICT) {
        kmAssign(mut map, cmds, st.pendCmd, st.pendChord, true);
        st.sel = st.pendCmd.clone();
        st.pendKind = KMS_PEND_NONE;
        res.changed = true;
      } else if (st.pendKind == KMS_PEND_RESERVED) {
        st.pendKind = KMS_PEND_NONE;
        const pc = st.pendCmd.clone();
        const ch = kmChord(st.pendChord.mods, st.pendChord.key);
        kmsTryAssign(mut st, mut map, cmds, pc, ch, false, mut res);
      } else if (st.pendKind == KMS_PEND_PRESET) {
        map = kmMapNew(st.pendPreset, cmds);
        st.pendKind = KMS_PEND_NONE;
        res.changed = true;
      }
    } else if (no) {
      st.pendKind = KMS_PEND_NONE;
    }
  }
  return h;
}

// ---- 表 ----

function kmsTableRows(st: KmsState, map: KmMap, cmds: KmCommand[], tr: I18n): KmsRow[] {
  let out: KmsRow[] = [];
  const groups = kmGroups();
  for (const g of groups) {
    let rows: KmsRow[] = [];
    for (let i: usize = 0; i < cmds.length; i++) {
      if (cmds[i].group != g) {
        continue;
      }
      const id = cmds[i].id.clone();
      // 3 つのプリセットのどれにも割り当てのないコマンド（0.x だけのもの、未割り当て）は、探していないときは出さない
      let any = false;
      for (const pm of st.presets) {
        if (kmChordsFor(pm, id).length > 0) {
          any = true;
        }
      }
      if (!any && st.query.length == 0) {
        continue;
      }
      if (st.query.length > 0) {
        let ok = kmMatch(st.query, i18nTL(tr, I18N_JA, "cmd." + id), i18nTL(tr, I18N_EN, "cmd." + id), id, "") ||
          kmMatch(st.query, i18nTL(tr, I18N_JA, "row." + cmds[i].row), i18nTL(tr, I18N_EN, "row." + cmds[i].row), "", "");
        if (!ok) {
          let keys = kmsChordsText(st, kmChordsFor(map, id));
          for (const pm of st.presets) {
            keys = keys + kmsChordsText(st, kmChordsFor(pm, id));
          }
          ok = kmMatch(st.query, "", "", "", keys);
        }
        if (!ok) {
          continue;
        }
      }
      let found = -1;
      for (let k: usize = 0; k < rows.length; k++) {
        if (rows[k].row == cmds[i].row) {
          found = k as i32;
        }
      }
      if (found >= 0) {
        rows[found as usize].cmds.push(i as i32);
      } else {
        rows.push({ kind: 1, group: g.clone(), row: cmds[i].row.clone(), cmds: [i as i32] });
      }
    }
    if (rows.length > 0) {
      out.push({ kind: 0, group: g.clone(), row: "", cmds: [] });
      for (const r of rows) {
        out.push({ kind: 1, group: r.group.clone(), row: r.row.clone(), cmds: r.cmds.clone() });
      }
    }
  }
  return out;
}

function kmsRowName(tr: I18n, cmds: KmCommand[], r: KmsRow): string {
  if (r.cmds.length == 1) {
    return kmsCmdName(tr, cmds[r.cmds[0] as usize].id);
  }
  if (i18nHas(tr, "row." + r.row)) {
    return i18nT(tr, "row." + r.row);
  }
  return kmsCmdName(tr, cmds[r.cmds[0] as usize].id);
}

// プリセット p の、行 r のキー（コマンドの順。割り当てのないコマンドは飛ばす）
function kmsRowChords(st: KmsState, cmds: KmCommand[], r: KmsRow, p: usize): KmChord[] {
  let out: KmChord[] = [];
  for (const ci of r.cmds) {
    const cs = kmChordsFor(st.presets[p], cmds[ci as usize].id);
    for (const c of cs) {
      out.push(kmChord(c.mods, c.key));
    }
  }
  return out;
}

function kmsGroupRowH(th: KmtTheme): i32 {
  return th.row + th.hairline * 2;
}

function kmsTableH(th: KmtTheme, rows: KmsRow[]): i32 {
  let h = th.panelHeader + th.hairline * 2;
  for (const r of rows) {
    if (r.kind == 0) {
      h = h + kmsGroupRowH(th);
    } else {
      h = h + th.row;
    }
  }
  return h;
}

// 配列ごとの補足（Premiere の 10 コマは 5 コマ、Resolve は 1 秒。Resolve と意味が違う Delete の行。Premiere のトリムは固定のモード）
function kmsCellNote(tr: I18n, row: string, p: usize, empty: bool): string {
  if (row == "playhead.step10" && p == 1) {
    return "（" + i18nT(tr, "keymap.note.premiere5") + "）";
  }
  if (row == "playhead.step10" && p == 2) {
    return "（" + i18nT(tr, "keymap.note.resolve1s") + "）";
  }
  if (row == "tool.trim" && p == 1 && empty) {
    return i18nT(tr, "keymap.note.premiereTrim");
  }
  return "";
}

function kmsCellWarn(tr: I18n, row: string, p: usize): string {
  if ((row == "edit.lift" || row == "edit.rippleDelete") && p == 2) {
    return i18nT(tr, "keymap.note.resolveDiff");
  }
  return "";
}

function kmsTable(
  ui: mut UkCtx, st: mut KmsState, cmds: KmCommand[], tr: I18n, th: KmtTheme, r: UkRect,
): void {
  ukDrawRound(mut ui, r, th.rLg, th.line);
  const inner = ukShrink(r, th.hairline);
  ukDrawRound(mut ui, inner, Math.max(th.rLg - th.hairline, 0), th.bg1);
  ukPushClip(mut ui, inner);
  const pad = th.s3 - th.hairline * 2;
  // 列の幅はモックアップの比（コマンド 27・ID 20・標準 16・Premiere 16・Resolve 21）
  const w0 = inner.w * 27 / 100;
  const w1 = inner.w * 20 / 100;
  const w2 = inner.w * 16 / 100;
  const w3 = inner.w * 16 / 100;
  const xs: i32[] = [inner.x, inner.x + w0, inner.x + w0 + w1, inner.x + w0 + w1 + w2, inner.x + w0 + w1 + w2 + w3];
  // 見出し（太字は uikit に SemiBold の口ができたら）
  const hh = th.panelHeader;
  ukDrawRect(mut ui, ukRect(inner.x, inner.y, inner.w, hh), th.bg2);
  ukDrawRect(mut ui, ukRect(inner.x, inner.y + hh, inner.w, th.hairline), th.lineStrong);
  let layoutName = i18nT(tr, "keymap.layout.us");
  if (st.layout == KM_LAYOUT_JIS) {
    layoutName = i18nT(tr, "keymap.layout.jis");
  }
  const heads: string[] = [
    i18nT(tr, "keymap.table.command"), i18nT(tr, "keymap.table.id"),
    i18nFmt(tr, "keymap.table.capsLayout", [i18nT(tr, "keymap.preset.standard"), layoutName]),
    i18nT(tr, "keymap.preset.premiere"), i18nT(tr, "keymap.preset.resolve"),
  ];
  for (let c: usize = 0; c < 5; c++) {
    ukDrawTextIn(mut ui, ukRect(xs[c] + pad, inner.y, (c < 4 ? xs[c + 1] - xs[c] : inner.x + inner.w - xs[c]) - pad * 2, hh), heads[c], th.fsSm, th.text2, 0);
  }
  let y = inner.y + hh + th.hairline;
  const chH = kmsKbdH(th);
  // 見えている行だけ描く
  const clipTop = ui.clip.y;
  const clipBot = ui.clip.y + ui.clip.h;
  for (let ri: usize = 0; ri < st.rows.length; ri++) {
    const kind = st.rows[ri].kind;
    const rh = kind == 0 ? kmsGroupRowH(th) : th.row;
    if (y + rh < clipTop || y > clipBot) {
      y = y + rh;
      continue;
    }
    const row = st.rows[ri].row.clone();
    if (kind == 0) {
      ukDrawRect(mut ui, ukRect(inner.x, y, inner.w, rh), th.bg0);
      ukDrawTextIn(mut ui, ukRect(inner.x + pad, y, inner.w - pad * 2, rh), i18nT(tr, "grp." + st.rows[ri].group), th.fsSm, th.text2, 0);
      ukDrawRect(mut ui, ukRect(inner.x, y + rh - th.hairline, inner.w, th.hairline), th.line);
      y = y + rh;
      continue;
    }
    const rcmds = st.rows[ri].cmds.clone();
    // 選んだコマンドの行
    let on = false;
    for (const ci of rcmds) {
      if (cmds[ci as usize].id == st.sel) {
        on = true;
      }
    }
    if (on) {
      ukDrawRect(mut ui, ukRect(inner.x, y, inner.w, rh - th.hairline), th.accentTint);
    }
    const rr: KmsRow = { kind: 1, group: "", row: row.clone(), cmds: rcmds.clone() };
    ukDrawTextIn(mut ui, ukRect(xs[0] + pad, y, xs[1] - xs[0] - pad * 2, rh), kmsRowName(tr, cmds, rr), th.fsSm, th.text1, 0);
    let ids = "";
    for (let k: usize = 0; k < rcmds.length; k++) {
      if (k > 0) {
        ids = ids + " / ";
      }
      ids = ids + cmds[rcmds[k] as usize].id;
    }
    ukDrawTextIn(mut ui, ukRect(xs[1] + pad, y, xs[2] - xs[1] - pad * 2, rh), ids, th.fsXs, th.text3, 0);
    for (let p: usize = 0; p < 3; p++) {
      const cx = xs[p + 2] + pad;
      let cr = inner.x + inner.w - pad;
      if (p < 2) {
        cr = xs[p + 3] - pad;
      }
      ukPushClip(mut ui, ukRect(cx, y, cr - cx, rh));
      const cs = kmsRowChords(st, cmds, rr, p);
      const w = kmsChips(mut ui, th, st, cx, y + (rh - chH) / 2, cs, cr - cx, true);
      let nx = cx + w + th.s1;
      const note = kmsCellNote(tr, row, p, cs.length == 0);
      if (note.length > 0) {
        nx = nx + ukDrawText(mut ui, nx, y + (rh - ukLineH(ui, th.fsSm)) / 2, note, th.fsSm, th.text3) + th.s1;
      }
      const wn = kmsCellWarn(tr, row, p);
      if (wn.length > 0) {
        ukDrawText(mut ui, nx, y + (rh - ukLineH(ui, th.fsSm)) / 2, wn, th.fsSm, th.warn);
      }
      ukPopClip(mut ui);
    }
    ukDrawRect(mut ui, ukRect(inner.x, y + rh - th.hairline, inner.w, th.hairline), th.line);
    const hit = ukBehavior(mut ui, ukId(ui, "##kmsrow" + row), ukRect(inner.x, y, inner.w, rh), false);
    if (hit.clicked) {
      st.sel = cmds[rcmds[0] as usize].id.clone();
    }
    y = y + rh;
  }
  ukPopClip(mut ui);
}

// ---- 画面 ----

// 修飾キーのセグメントの番号 → 論理の修飾キー（ui.md 5.3 の 7 つ。Mac は Control も）
function kmsModsOf(seg: i32): i32 {
  switch (seg) {
    case 1: return KM_MOD_CTRL;
    case 2: return KM_MOD_SHIFT;
    case 3: return KM_MOD_ALT;
    case 4: return KM_MOD_CTRL | KM_MOD_SHIFT;
    case 5: return KM_MOD_CTRL | KM_MOD_ALT;
    case 6: return KM_MOD_ALT | KM_MOD_SHIFT;
    case 7: return KM_MOD_META;
  }
  return 0;
}

function kmsModsNames(tr: I18n, mac: bool): string[] {
  if (mac) {
    return [i18nT(tr, "keymap.mods.none"), "Cmd", "Shift", "Option", "Cmd+Shift", "Cmd+Option", "Option+Shift", i18nT(tr, "keymap.mods.control")];
  }
  return [i18nT(tr, "keymap.mods.none"), "Ctrl", "Shift", "Alt", "Ctrl+Shift", "Ctrl+Alt", "Alt+Shift"];
}

// キーを待っている間: 押したキーを sel に割り当てる（移動のキーや、外れるものがあれば確かめる）。Esc でやめる。
function kmsCapture(ui: mut UkCtx, st: mut KmsState, map: mut KmMap, cmds: KmCommand[], res: mut KmsResult): void {
  for (let i: usize = 0; i < ui.inp.keys.length; i++) {
    const k = ui.inp.keys[i];
    if (k == 0) {
      continue;
    }
    const m = ui.inp.keyMods[i];
    ui.inp.keys[i] = 0;
    if (k == UK_KEY_ESC) {
      st.capturing = false;
      return;
    }
    const c = kmEventChord(k, m, st.mac, st.layout);
    if (c.key.length == 0) {
      continue;
    }
    st.capturing = false;
    const selId = st.sel.clone();
    kmsTryAssign(mut st, mut map, cmds, selId, c, true, mut res);
    return;
  }
}

export function kmsFrame(
  ui: mut UkCtx, st: mut KmsState, map: mut KmMap, cmds: KmCommand[], tr: I18n, th: KmtTheme, area: UkRect,
): KmsResult {
  let res: KmsResult = { close: false, changed: false, exportReq: false, importReq: false };
  // ---- キー待ちと Esc ----
  if (st.capturing) {
    const pressedOutside = (ui.inp.pressed & 1) != 0 && !(ui.inp.mx >= st.capRect.x && ui.inp.mx < st.capRect.x + st.capRect.w &&
      ui.inp.my >= st.capRect.y && ui.inp.my < st.capRect.y + st.capRect.h);
    // 文字の欄やポップアップがキーを使っているとき、ほかの所を押したときはやめる（クリックはそのまま部品に渡す）
    if (ui.wantText || ui.popups.length > 0 || pressedOutside || st.sel.length == 0) {
      st.capturing = false;
    } else {
      kmsCapture(mut ui, mut st, mut map, cmds, mut res);
    }
  } else if (ui.popups.length == 0 && !ui.wantText && ukKeyTake(mut ui, UK_KEY_ESC)) {
    if (st.pendKind != KMS_PEND_NONE) {
      st.pendKind = KMS_PEND_NONE;
    } else {
      res.close = true;
    }
  }
  // いまのプリセットの既定
  if (st.defMap.preset != map.preset || st.defMap.binds.length == 0) {
    st.defMap = kmMapNew(map.preset, cmds);
  }
  // 見せる修飾キー: 押していればそれ、なければセグメント
  let mods = kmsModsOf(st.modsSeg);
  const held = kmEventMods(ui.inp.mods, st.mac);
  if (held != 0 && !st.capturing && !ui.wantText) {
    mods = held;
  }
  const sig = kmsMapSig(map);
  if (!st.confValid || st.confSig != sig) {
    st.confN = kmConflicts(map).length as i32;
    st.confSig = sig;
    st.confValid = true;
  }

  // ---- 大きさを先に求める ----
  const pageP = th.s5;
  const winW = area.w - pageP * 2;
  const headH = th.btnLg + th.s2;
  const innerW = winW - th.hairline * 2;
  const kbAreaW = innerW - th.s4 * 2;
  const ku = kmsFitUnit(th, st.layout, st.mac, kbAreaW);
  const kh = kmsKeyH(th, ku);
  const notes: string[] = [i18nT(tr, "keymap.note.scancode"), i18nT(tr, "keymap.note.layout"), i18nT(tr, "keymap.note.keycap")];
  let noteLines: string[] = [];
  for (const n of notes) {
    const ls = kmsWrap(mut ui, mut st, n, th.fsSm, kbAreaW);
    for (const l of ls) {
      noteLines.push(l.clone());
    }
  }
  const noteLh = th.lhSm + th.s1;
  const legendH = th.lhSm;
  const modsH = th.btnSm + 2 + th.hairline * 2;
  const kbPicH = kh * 6 + th.s1 * 5;
  const topH = th.s4 + modsH + th.s3 + kbPicH + th.s3 + legendH + th.s3 + (noteLines.length as i32) * noteLh + th.s4;
  // 下の 3 列（警告 ／ 検索 ／ 一覧）
  const colW = (kbAreaW - th.colGap * 2) / 3;
  const warnH = kmsWarnBox(mut ui, mut st, mut map, cmds, tr, th, 0, 0, colW, false, mut res);
  const lk = `${sig}|${st.listQuery}|${st.layout}|${st.mac}|${tr.lang}`;
  if (lk != st.listKey) {
    st.listKey = lk;
    st.items = kmsListItems(st, map, cmds, tr, st.listQuery);
  }
  const shown = Math.min(st.items.length as i32, KMS_MAX_ITEMS);
  let listH = 0;
  for (let i = 0; i < shown; i++) {
    listH = listH + kmsItemH(mut ui, mut st, tr, th, cmds[st.items[i as usize] as usize].id, colW);
  }
  if (st.items.length as i32 > KMS_MAX_ITEMS) {
    listH = listH + th.lhSm + th.s1;
  }
  if (st.items.length == 0) {
    listH = th.lhSm;
  }
  const idsNote = kmsWrap(mut ui, mut st, i18nT(tr, "keymap.note.ids"), th.fsSm, colW);
  const rowH = Math.max(Math.max(warnH, th.btnMd), listH);
  const botH = th.s4 + rowH + th.s3 + (idsNote.length as i32) * noteLh + th.s4;
  const winH = th.hairline * 2 + headH + topH + th.hairline + botH;
  const tk = `${sig}|${st.query}|${st.layout}|${st.mac}|${tr.lang}`;
  if (tk != st.tblKey) {
    st.tblKey = tk;
    st.rows = kmsTableRows(st, map, cmds, tr);
  }
  const tableH = kmsTableH(th, st.rows);
  const totalH = pageP + winH + pageP + tableH + pageP;

  ukDrawRect(mut ui, area, th.bg0);
  ukBeginScroll(mut ui, "##kmsPage", area);
  const base = ukNext(mut ui, area.w, totalH);
  const wx = base.x + pageP;
  const wy = base.y + pageP;
  // 窓（.win）
  const win = ukRect(wx, wy, winW, winH);
  ukDrawRound(mut ui, win, th.rLg, th.lineStrong);
  const wi = ukShrink(win, th.hairline);
  ukDrawRound(mut ui, wi, Math.max(th.rLg - th.hairline, 0), th.bg1);
  ukPushClip(mut ui, wi);
  // ---- 見出しの帯（.whead） ----
  ukDrawRect(mut ui, ukRect(wi.x, wi.y, wi.w, headH), th.bg2);
  ukDrawRect(mut ui, ukRect(wi.x, wi.y + headH - th.hairline, wi.w, th.hairline), th.line);
  let hx = wi.x + th.s4;
  const hy = wi.y;
  kmsKeyboardIcon(mut ui, ukRect(hx, hy + (headH - th.iconMd) / 2, th.iconMd, th.iconMd), th.text1, th.hairline + 1);
  hx = hx + th.iconMd + th.s3;
  const title = i18nT(tr, "keymap.title");
  hx = hx + ukDrawText(mut ui, hx, hy + (headH - ukLineH(ui, th.fsLg)) / 2, title, th.fsLg, th.text1) + th.s3;
  // プリセット（.sel2 は sm の文字。uikit のドロップダウンに大きさの指定が無いので、呼ぶ間だけ文字の大きさを替える）
  let presetNames: string[] = [];
  for (let p = 0; p < 4; p++) {
    presetNames.push(i18nT(tr, "keymap.preset." + kmPresetId(p)));
  }
  let ddW = 0;
  for (const n of presetNames) {
    ddW = Math.max(ddW, ukTextW(mut ui, n, th.fsSm));
  }
  ddW = ddW + ui.theme.pad * 3 + ui.theme.icon;
  const fs0 = ui.theme.fontSize;
  ui.theme.fontSize = th.fsSm;
  ukSetNext(mut ui, ukRect(hx, hy + (headH - th.btnMd) / 2, ddW, th.btnMd));
  const np = ukDropdown(mut ui, "##kmsPreset", presetNames, map.preset);
  ui.theme.fontSize = fs0;
  if (np != map.preset) {
    st.capturing = false;
    if (kmsDiffCount(map, st.defMap, cmds) > 0) {
      // 変えた割り当てがあるときは確かめる
      st.pendKind = KMS_PEND_PRESET;
      st.pendPreset = np;
    } else {
      map = kmMapNew(np, cmds);
      st.pendKind = KMS_PEND_NONE;
      res.changed = true;
    }
  }
  hx = hx + ddW + th.s3;
  const lay: string[] = [i18nT(tr, "keymap.layout.jis"), i18nT(tr, "keymap.layout.us")];
  const segH = th.btnSm + 2 + th.hairline * 2;
  st.layout = kmsSeg(mut ui, th, "##kmsLayout", hx, hy + (headH - segH) / 2, lay, st.layout);
  hx = hx + kmsSegW(mut ui, th, lay) + th.s3;
  // 右から: ×、読み込む、保存する、検索
  let rx = wi.x + wi.w - th.s4;
  ukSetNext(mut ui, ukRect(rx - th.btnMd, hy + (headH - th.btnMd) / 2, th.btnMd, th.btnMd));
  if (ukIconButton(mut ui, i18nT(tr, "keymap.close") + "##kmsClose", UK_I_CLOSE, false)) {
    res.close = true;
  }
  rx = rx - th.btnMd - th.s3;
  const tImp = i18nT(tr, "keymap.import");
  const wImp = kmsBtnW(mut ui, th, tImp);
  if (kmsBtn(mut ui, th, tImp, "##kmsImport", ukRect(rx - wImp, hy + (headH - th.btnSm) / 2, wImp, th.btnSm), false)) {
    res.importReq = true;
  }
  rx = rx - wImp - th.s2;
  const tExp = i18nT(tr, "keymap.export");
  const wExp = kmsBtnW(mut ui, th, tExp);
  if (kmsBtn(mut ui, th, tExp, "##kmsExport", ukRect(rx - wExp, hy + (headH - th.btnSm) / 2, wExp, th.btnSm), false)) {
    res.exportReq = true;
  }
  rx = rx - wExp - th.s3;
  const sw = Math.min(th.keyUnit * 13 / 3, rx - hx);
  if (sw > th.btnMd * 2) {
    st.query = kmsSearch(mut ui, th, "##kmsQuery", i18nT(tr, "keymap.search"), ukRect(rx - sw, hy + (headH - th.btnMd) / 2, sw, th.btnMd), st.query);
  }

  // ---- 上: 修飾キーとキーボード ----
  const by = wi.y + headH;
  const kx = wi.x + th.s4;
  let ky = by + th.s4;
  const ml = i18nT(tr, "keymap.mods");
  const mlw = ukDrawText(mut ui, kx, ky + (modsH - ukLineH(ui, th.fsSm)) / 2, ml, th.fsSm, th.text2);
  const segNames = kmsModsNames(tr, st.mac);
  let segCur = -1;
  for (let i = 0; i < (segNames.length as i32); i++) {
    if (kmsModsOf(i) == mods) {
      segCur = i;
    }
  }
  const mx = kx + mlw + th.s2;
  const ns = kmsSeg(mut ui, th, "##kmsMods", mx, ky, segNames, segCur);
  if (ns != segCur) {
    st.modsSeg = ns;
  }
  const hintX = mx + kmsSegW(mut ui, th, segNames) + th.s2;
  if (hintX < kx + kbAreaW) {
    ukDrawTextIn(mut ui, ukRect(hintX, ky, kx + kbAreaW - hintX, modsH), i18nT(tr, "keymap.mods.hint"), th.fsSm, th.text3, 0);
  }
  ky = ky + modsH + th.s3;
  const boxes = kmsBoxes(th, st.layout, st.mac, ku, kh, kx, ky);
  kmsKbCache(mut ui, mut st, map, cmds, tr, th, boxes, mods, sig);
  let selChords: KmChord[] = [];
  if (st.sel.length > 0) {
    selChords = kmChordsFor(map, st.sel);
  }
  kmsKeyboard(mut ui, mut st, tr, th, boxes, ukRect(kx, ky, kbAreaW, kbPicH), mods, selChords);
  ky = ky + kbPicH + th.s3;
  // 凡例
  const legIds: string[] = ["play", "mark", "tool", "ripple", "over", "view", "none"];
  const legCats: i32[] = [KM_CAT_PLAY, KM_CAT_MARK, KM_CAT_TOOL, KM_CAT_RIPPLE, KM_CAT_OVER, KM_CAT_VIEW, KM_CAT_NONE];
  let lx = kx;
  const sq = th.s3;
  for (let i: usize = 0; i < 7; i++) {
    const sr = ukRect(lx, ky + (legendH - sq) / 2, sq, sq);
    ukDrawRound(mut ui, sr, th.rSm, th.lineStrong);
    ukDrawRound(mut ui, ukShrink(sr, th.hairline), Math.max(th.rSm - th.hairline, 0), th.catFace[legCats[i] as usize]);
    lx = lx + sq + th.s1;
    lx = lx + ukDrawText(mut ui, lx, ky + (legendH - ukLineH(ui, th.fsSm)) / 2, i18nT(tr, "keymap.legend." + legIds[i].clone()), th.fsSm, th.text2);
    lx = lx + th.s3 + th.s1 / 2;
  }
  ky = ky + legendH + th.s3;
  for (const l of noteLines) {
    ukDrawText(mut ui, kx, ky + (noteLh - ukLineH(ui, th.fsSm)) / 2, l, th.fsSm, th.text2);
    ky = ky + noteLh;
  }
  const lineY = by + topH;
  ukDrawRect(mut ui, ukRect(wi.x, lineY, wi.w, th.hairline), th.line);

  // ---- 下: 警告 ／ 検索 ／ 一覧（shortcuts.html の .side は 3 列の grid） ----
  const sy = lineY + th.hairline + th.s4;
  const c1 = kx;
  const c2 = kx + colW + th.colGap;
  const c3 = c2 + colW + th.colGap;
  kmsWarnBox(mut ui, mut st, mut map, cmds, tr, th, c1, sy, colW, true, mut res);
  st.listQuery = kmsSearch(mut ui, th, "##kmsList", i18nT(tr, "keymap.search"), ukRect(c2, sy, colW, th.btnMd), st.listQuery);
  let iy = sy;
  let focusedAt = -1;
  for (let i = 0; i < shown; i++) {
    const ci = st.items[i as usize];
    const ih = kmsItemH(mut ui, mut st, tr, th, cmds[ci as usize].id, colW);
    const ir = ukRect(c3, iy, colW, ih);
    kmsListItem(mut ui, mut st, mut map, cmds, tr, th, ir, ci, mut res);
    if (ui.focus == kmsRowId(mut ui, cmds[ci as usize].id)) {
      focusedAt = i;
    }
    iy = iy + ih;
  }
  // 一覧の行のキー操作: ↑↓ で動く、Enter でキー待ち、Space で選ぶ、Delete で外す
  if (focusedAt >= 0) {
    const fid = cmds[st.items[focusedAt as usize] as usize].id.clone();
    if (ukKeyTake(mut ui, UK_KEY_UP) && focusedAt > 0) {
      const nid = cmds[st.items[(focusedAt - 1) as usize] as usize].id.clone();
      ukFocus(mut ui, kmsRowId(mut ui, nid), true);
      st.sel = nid;
    } else if (ukKeyTake(mut ui, UK_KEY_DOWN) && focusedAt + 1 < shown) {
      const nid = cmds[st.items[(focusedAt + 1) as usize] as usize].id.clone();
      ukFocus(mut ui, kmsRowId(mut ui, nid), true);
      st.sel = nid;
    } else if (ukKeyTake(mut ui, UK_KEY_ENTER)) {
      kmsStartCapture(mut st, fid, ukRect(c3, sy, colW, iy - sy));
    } else if (ukKeyTake(mut ui, UK_KEY_SPACE)) {
      st.sel = fid;
    } else if (ukKeyTake(mut ui, UK_KEY_DELETE) || ukKeyTake(mut ui, UK_KEY_BACKSPACE)) {
      kmUnassign(mut map, fid);
      res.changed = true;
    }
  }
  if (st.items.length as i32 > KMS_MAX_ITEMS) {
    const more = i18nFmt(tr, "keymap.more", [`${(st.items.length as i32) - KMS_MAX_ITEMS}`]);
    ukDrawTextIn(mut ui, ukRect(c3 + th.s2, iy, colW, th.lhSm), more, th.fsSm, th.text3, 0);
  }
  if (st.items.length == 0 && st.listQuery.length > 0) {
    ukDrawTextIn(mut ui, ukRect(c3 + th.s2, iy, colW, th.lhSm), i18nFmt(tr, "keymap.noResult", [st.listQuery.clone()]), th.fsSm, th.text3, 0);
  }
  let ny = sy + rowH + th.s3;
  for (const l of idsNote) {
    ukDrawText(mut ui, c1, ny + (noteLh - ukLineH(ui, th.fsSm)) / 2, l, th.fsSm, th.text2);
    ny = ny + noteLh;
  }
  ukPopClip(mut ui);

  // ---- 表 ----
  kmsTable(mut ui, mut st, cmds, tr, th, ukRect(wx, wy + winH + pageP, winW, tableH));
  ukEndScroll(mut ui);
  return res;
}
