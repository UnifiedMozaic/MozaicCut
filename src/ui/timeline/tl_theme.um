// タイムラインのテーマ: tokens.json の値（src/gen/tl_tokens.um。tools/gen-tl-tokens.mjs が作る）を、UI の倍率と合わせて使う。
// 実行中に tokens.json を読み直すときは tlTokFromJson（キーの道筋をそのまま tlTokSet に渡す）。
import { TlTok, tlTokDefault, tlTokSet } from "../../gen/tl_tokens.um";
import { ukParseHex } from "../kit/theme.um";

// 倍率 1.0 の論理 px を、いまの UI の倍率の画素にする（1 以上。0 は 0）。
export function tlPx(scale: f32, v: f32): i32 {
  if (v <= 0.0) {
    return 0;
  }
  return Math.max(Math.floor(v * scale + 0.5) as i32, 1);
}

function tlJsonWs(s: string, i0: usize): usize {
  let i = i0;
  while (i < s.length && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) {
    i++;
  }
  return i;
}

function tlJsonStr(s: string, i0: usize, end: mut usize[]): string {
  let out: u8[] = [];
  let i = i0 + 1;
  while (i < s.length && s[i] != 34) {
    if (s[i] == 92 && i + 1 < s.length) {
      i++;
    }
    out.push(s[i]);
    i++;
  }
  end[0] = i + 1;
  return stringFromBytes(out);
}

function tlJoinPath(path: string[]): string {
  let out = "";
  for (let i: usize = 0; i < path.length; i++) {
    if (i > 0) {
      out = out + ".";
    }
    out = out + path[i];
  }
  return out;
}

// tokens.json の中身を読んで t に当てる。戻り値は当てた値の数（読めない JSON なら -1）。
export function tlTokFromJson(t: mut TlTok, json: string): i32 {
  let path: string[] = [];
  let isObj: bool[] = [];
  let n = 0;
  let i = tlJsonWs(json, 0);
  let pendingKey = false;
  let end: usize[] = [0];
  while (i < json.length) {
    const b = json[i];
    if (b == 123) {
      isObj.push(true);
      path.push("");
      pendingKey = true;
      i++;
    } else if (b == 125 || b == 93) {
      if (isObj.length == 0) {
        return -1;
      }
      isObj.pop();
      path.pop();
      i++;
    } else if (b == 91) {
      isObj.push(false);
      path.push("[]");
      i++;
    } else if (b == 44) {
      if (isObj.length > 0 && isObj[isObj.length - 1]) {
        pendingKey = true;
      }
      i++;
    } else if (b == 58) {
      pendingKey = false;
      i++;
    } else if (b == 34) {
      const str = tlJsonStr(json, i, mut end);
      i = end[0];
      if (pendingKey && path.length > 0) {
        path[path.length - 1] = str;
        pendingKey = false;
      } else {
        const c = ukParseHex(str);
        if (c >= 0 && tlTokSet(mut t, tlJoinPath(path), c as u32, 0.0, true)) {
          n++;
        }
      }
    } else if ((b >= 48 && b <= 57) || b == 45) {
      let j = i;
      let v: f64 = 0.0;
      let neg = false;
      if (json[j] == 45) {
        neg = true;
        j++;
      }
      while (j < json.length && json[j] >= 48 && json[j] <= 57) {
        v = v * 10.0 + ((json[j] - 48) as f64);
        j++;
      }
      if (j < json.length && json[j] == 46) {
        j++;
        let f: f64 = 0.1;
        while (j < json.length && json[j] >= 48 && json[j] <= 57) {
          v = v + ((json[j] - 48) as f64) * f;
          f = f * 0.1;
          j++;
        }
      }
      if (neg) {
        v = -v;
      }
      if (tlTokSet(mut t, tlJoinPath(path), 0, v as f32, false)) {
        n++;
      }
      i = j;
    } else {
      i++;
    }
  }
  return n;
}

// 既定値（生成した定数）に、tokens.json があれば上書きしたもの。
export function tlTokLoad(path: string): TlTok {
  let t = tlTokDefault();
  if (path.length > 0) {
    const data = readFile(path);
    if (data != null) {
      tlTokFromJson(mut t, stringFromBytes(data));
    }
  }
  return t;
}
