// 色のパネル（ucp）の数: 三角関数（UM の Math にないので多項式で）、ホイールの位置と RGB の変換、カーブのスプライン。
//
// ホイールの向きはベクトルスコープと同じにする（右が Cb＋、上が Cr＋。BT.709）。
// 玉を赤の方へ動かすと、ベクトルスコープの点も赤の目標の方へ動く。
//
// カーブの評価は m4-color の src/effects/color/grade.um の colSplineSlopes / colSplineEval と同じ式（単調な 3 次スプライン。
// Fritsch–Butland）。つなぐときは、こちらを消して src/effects/color の関数を使う。

export const UCP_PI: f64 = 3.141592653589793;

// 角度を −π..π に。
function ucpWrap(a: f64): f64 {
  let x = a;
  const tp = 2.0 * UCP_PI;
  x = x - Math.floor((x + UCP_PI) / tp) * tp;
  return x;
}

export function ucpSin(a0: f64): f64 {
  // −π..π を −π/2..π/2 に折り、テイラー展開（誤差 1e-7 ほど）
  let a = ucpWrap(a0);
  if (a > UCP_PI * 0.5) {
    a = UCP_PI - a;
  } else if (a < -UCP_PI * 0.5) {
    a = -UCP_PI - a;
  }
  const a2 = a * a;
  return a * (1.0 - a2 / 6.0 * (1.0 - a2 / 20.0 * (1.0 - a2 / 42.0 * (1.0 - a2 / 72.0 * (1.0 - a2 / 110.0)))));
}

export function ucpCos(a: f64): f64 {
  return ucpSin(a + UCP_PI * 0.5);
}

// atan（|x| <= 1 で多項式、外は π/2 − atan(1/x)）。
function ucpAtan(x: f64): f64 {
  const ax = Math.abs(x);
  let inv = false;
  let t = ax;
  if (ax > 1.0) {
    t = 1.0 / ax;
    inv = true;
  }
  // t を tan(π/12) 以下に縮めてから級数
  let add: f64 = 0.0;
  const k = 0.2679491924311228;   // tan(π/12)
  if (t > k) {
    t = (t - k) / (1.0 + t * k);
    add = UCP_PI / 12.0;
  }
  const t2 = t * t;
  let r = t * (1.0 - t2 * (1.0 / 3.0 - t2 * (1.0 / 5.0 - t2 * (1.0 / 7.0 - t2 / 9.0)))) + add;
  if (inv) {
    r = UCP_PI * 0.5 - r;
  }
  return x < 0.0 ? -r : r;
}

export function ucpAtan2(y: f64, x: f64): f64 {
  if (x > 0.0) {
    return ucpAtan(y / x);
  }
  if (x < 0.0) {
    return y >= 0.0 ? ucpAtan(y / x) + UCP_PI : ucpAtan(y / x) - UCP_PI;
  }
  if (y > 0.0) {
    return UCP_PI * 0.5;
  }
  if (y < 0.0) {
    return -UCP_PI * 0.5;
  }
  return 0.0;
}

// ---- ホイール ----

// BT.709 の輝度の係数
const UCP_KR: f64 = 0.2126;
const UCP_KB: f64 = 0.0722;

// RGB の差（輝度を除いた分）→ ホイールの位置（x = Cb、y = Cr。右と上が正）。
export function ucpRgbToWheel(r: f64, g: f64, b: f64): f64[2] {
  const y = UCP_KR * r + (1.0 - (UCP_KR + UCP_KB)) * g + UCP_KB * b;
  const cb = (b - y) / (2.0 * (1.0 - UCP_KB));
  const cr = (r - y) / (2.0 * (1.0 - UCP_KR));
  return [cb, cr];
}

// ホイールの位置（Cb, Cr）→ 輝度の変わらない RGB の差。
export function ucpWheelToRgb(cb: f64, cr: f64): f64[3] {
  const r = 2.0 * (1.0 - UCP_KR) * cr;
  const b = 2.0 * (1.0 - UCP_KB) * cb;
  const g = -(UCP_KR * r + UCP_KB * b) / (1.0 - (UCP_KR + UCP_KB));
  return [r, g, b];
}

// 輝度 y、Cb、Cr → RGB（0..1 に収める）。ホイールの縁の色に使う。
export function ucpYccToRgb(y: f64, cb: f64, cr: f64): f64[3] {
  const d = ucpWheelToRgb(cb, cr);
  return [Math.min(Math.max(y + d[0], 0.0), 1.0), Math.min(Math.max(y + d[1], 0.0), 1.0), Math.min(Math.max(y + d[2], 0.0), 1.0)];
}

// ---- カーブ（単調な 3 次スプライン。src/effects/color/grade.um と同じ式） ----

export function ucpSplineSlopes(xs: f64[], ys: f64[]): f64[] {
  const n = xs.length;
  let m: f64[] = [];
  if (n == 0) {
    return m;
  }
  if (n == 1) {
    m.push(0.0);
    return m;
  }
  let d: f64[] = [];
  let h: f64[] = [];
  for (let k: usize = 0; k + 1 < n; k++) {
    h.push(xs[k + 1] - xs[k]);
    d.push((ys[k + 1] - ys[k]) / (xs[k + 1] - xs[k]));
  }
  for (let k: usize = 0; k < n; k++) {
    if (k == 0) {
      m.push(d[0]);
    } else if (k == n - 1) {
      m.push(d[n - 2]);
    } else {
      const d0 = d[k - 1];
      const d1 = d[k];
      if (d0 * d1 <= 0.0) {
        m.push(0.0);
      } else {
        const h0 = h[k - 1];
        const h1 = h[k];
        m.push(3.0 * (h0 + h1) / ((2.0 * h1 + h0) / d0 + (h1 + 2.0 * h0) / d1));
      }
    }
  }
  if (d[0] == 0.0 || m[0] * d[0] < 0.0) {
    m[0] = 0.0;
  } else if (Math.abs(m[0]) > 3.0 * Math.abs(d[0])) {
    m[0] = 3.0 * d[0];
  }
  if (d[n - 2] == 0.0 || m[n - 1] * d[n - 2] < 0.0) {
    m[n - 1] = 0.0;
  } else if (Math.abs(m[n - 1]) > 3.0 * Math.abs(d[n - 2])) {
    m[n - 1] = 3.0 * d[n - 2];
  }
  return m;
}

export function ucpSplineEval(xs: f64[], ys: f64[], m: f64[], x: f64): f64 {
  const n = xs.length;
  if (n == 0) {
    return x;
  }
  if (n == 1) {
    return ys[0];
  }
  if (x <= xs[0]) {
    return ys[0] + m[0] * (x - xs[0]);
  }
  if (x >= xs[n - 1]) {
    return ys[n - 1] + m[n - 1] * (x - xs[n - 1]);
  }
  let lo: usize = 0;
  let hi: usize = n - 1;
  while (hi - lo > 1) {
    const mid = (lo + hi) / 2;
    if (xs[mid] <= x) {
      lo = mid;
    } else {
      hi = mid;
    }
  }
  const h = xs[hi] - xs[lo];
  const t = (x - xs[lo]) / h;
  const t2 = t * t;
  const t3 = t2 * t;
  const h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
  const h10 = t3 - 2.0 * t2 + t;
  const h01 = -2.0 * t3 + 3.0 * t2;
  const h11 = t3 - t2;
  return h00 * ys[lo] + h10 * h * m[lo] + h01 * ys[hi] + h11 * h * m[hi];
}

// ---- 数の文字列（op の値に使う。末尾の 0 を落とす） ----

export function ucpNum(v: f64, d: i32): string {
  let p: f64 = 1.0;
  for (let k = 0; k < d; k++) {
    p = p * 10.0;
  }
  let neg = v < 0.0;
  let iv = Math.floor(Math.abs(v) * p + 0.5) as i64;
  if (iv == 0) {
    neg = false;
  }
  const ip = iv / (p as i64);
  let fp = iv - ip * (p as i64);
  let s = `${ip}`;
  if (d > 0 && fp > 0) {
    let digits: u8[] = [];
    for (let k = 0; k < d; k++) {
      digits.push(48);
    }
    let k = d - 1;
    while (k >= 0) {
      digits[k as usize] = (48 + (fp % 10)) as u8;
      fp = fp / 10;
      k--;
    }
    while (digits.length > 0 && digits[digits.length - 1] == 48) {
      digits.pop();
    }
    s = s + "." + stringFromBytes(digits);
  }
  if (neg) {
    return "-" + s;
  }
  return s;
}

// 表示用（桁を固定。負は「-」、正は sign なら「+」）。和文のフォントの「−」（U+2212）は全角の幅なので使わない。
export function ucpFixed(v: f64, d: i32, sign: bool): string {
  let p: f64 = 1.0;
  for (let k = 0; k < d; k++) {
    p = p * 10.0;
  }
  const iv = Math.floor(Math.abs(v) * p + 0.5) as i64;
  const ip = iv / (p as i64);
  let fp = iv - ip * (p as i64);
  let s = `${ip}`;
  if (d > 0) {
    let digits: u8[] = [];
    for (let k = 0; k < d; k++) {
      digits.push(48);
    }
    let k = d - 1;
    while (k >= 0) {
      digits[k as usize] = (48 + (fp % 10)) as u8;
      fp = fp / 10;
      k--;
    }
    s = s + "." + stringFromBytes(digits);
  }
  if (iv == 0) {
    return s;
  }
  if (v < 0.0) {
    return "-" + s;
  }
  if (sign) {
    return "+" + s;
  }
  return s;
}
