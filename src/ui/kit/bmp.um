// 画面（0xAARRGGBB の Buffer<u32>）を 32 ビットの BMP（上から下）で書く。見た目の確かめと試しに使う。
export function ukWriteBmp(path: string, px: Buffer<u32>, W: i32, H: i32): bool {
  const n = (W * H) as usize;
  let out = new Array<u8>(54 + n * 4);
  const size = 54 + W * H * 4;
  const hdr: i32[] = [0, size, 0, 54, 40, W, -H, 1 + 32 * 65536, 0, W * H * 4, 2835, 2835, 0, 0];
  out[0] = 66;
  out[1] = 77;
  let o: usize = 2;
  for (let i: usize = 1; i < hdr.length; i++) {
    const v = hdr[i] as u32;
    out[o] = (v & 255) as u8;
    out[o + 1] = ((v >> 8) & 255) as u8;
    out[o + 2] = ((v >> 16) & 255) as u8;
    out[o + 3] = ((v >> 24) & 255) as u8;
    o += 4;
  }
  for (let i: usize = 0; i < n; i++) {
    const p = px[i as u32];
    out[o] = (p & 255) as u8;
    out[o + 1] = ((p >> 8) & 255) as u8;
    out[o + 2] = ((p >> 16) & 255) as u8;
    out[o + 3] = 255;
    o += 4;
  }
  return writeFile(path, out);
}

// 画素の並びのハッシュ（試しで、描いた結果が同じかを比べる）。
export function ukPixelHash(px: Buffer<u32>, n: u32): u32 {
  let h: u32 = 2166136261;
  for (let i: u32 = 0; i < n; i++) {
    h = (h ^ px[i]) * 16777619;
  }
  return h;
}
