// uikit のアイコン: 線と三角と円で描く（画像を持たないので、どの倍率でもにじまない）。
// ukIcon(ui, r, UK_I_*, 色) で四角 r の中央に描く。大きさは r の短い辺に合わせる。
import { UkRect } from "./base.um";
import { UkCtx, ukDrawLine, ukDrawTri, ukDrawCircle, ukDrawRect, ukDrawRound } from "./core.um";

export const UK_I_NONE: i32 = 0;
export const UK_I_PLAY: i32 = 1;
export const UK_I_PAUSE: i32 = 2;
export const UK_I_STOP: i32 = 3;
export const UK_I_PLUS: i32 = 4;
export const UK_I_MINUS: i32 = 5;
export const UK_I_CLOSE: i32 = 6;
export const UK_I_CHECK: i32 = 7;
export const UK_I_DOWN: i32 = 8;     // 下向きの山形（ドロップダウン）
export const UK_I_RIGHT: i32 = 9;    // 右向きの山形（サブメニュー）
export const UK_I_LEFT: i32 = 10;
export const UK_I_UP: i32 = 11;
export const UK_I_SEARCH: i32 = 12;
export const UK_I_CUT: i32 = 13;     // はさみ（分割）
export const UK_I_PREV: i32 = 14;    // 前のコマへ
export const UK_I_NEXT: i32 = 15;    // 次のコマへ
export const UK_I_MENU: i32 = 16;    // 三本線
export const UK_I_DOT: i32 = 17;     // ラジオの点
export const UK_I_INFO: i32 = 18;
export const UK_I_WARN: i32 = 19;
export const UK_I_EYE: i32 = 20;
export const UK_I_LOCK: i32 = 21;
export const UK_I_COUNT: i32 = 22;

export function ukIconName(i: i32): string {
  switch (i) {
    case 1: return "play";
    case 2: return "pause";
    case 3: return "stop";
    case 4: return "plus";
    case 5: return "minus";
    case 6: return "close";
    case 7: return "check";
    case 8: return "down";
    case 9: return "right";
    case 10: return "left";
    case 11: return "up";
    case 12: return "search";
    case 13: return "cut";
    case 14: return "prev";
    case 15: return "next";
    case 16: return "menu";
    case 17: return "dot";
    case 18: return "info";
    case 19: return "warn";
    case 20: return "eye";
    case 21: return "lock";
  }
  return "";
}

export function ukIcon(ui: mut UkCtx, r: UkRect, icon: i32, c: u32): void {
  const s = (Math.min(r.w, r.h) as f32);
  const cx = (r.x as f32) + (r.w as f32) * 0.5;
  const cy = (r.y as f32) + (r.h as f32) * 0.5;
  const h = s * 0.5;
  const t = Math.max(s * 0.11, 1.2);
  if (icon == UK_I_PLAY) {
    ukDrawTri(mut ui, cx - h * 0.55, cy - h * 0.75, cx - h * 0.55, cy + h * 0.75, cx + h * 0.8, cy, c);
  } else if (icon == UK_I_PAUSE) {
    const bw = h * 0.42;
    ukDrawLine(mut ui, cx - bw, cy - h * 0.7, cx - bw, cy + h * 0.7, bw * 0.9, c);
    ukDrawLine(mut ui, cx + bw, cy - h * 0.7, cx + bw, cy + h * 0.7, bw * 0.9, c);
  } else if (icon == UK_I_STOP) {
    const q = Math.floor(h * 1.2) as i32;
    ukDrawRound(mut ui, { x: (cx as i32) - q / 2, y: (cy as i32) - q / 2, w: q, h: q }, Math.max(q / 6, 1), c);
  } else if (icon == UK_I_PLUS) {
    ukDrawLine(mut ui, cx - h * 0.7, cy, cx + h * 0.7, cy, t, c);
    ukDrawLine(mut ui, cx, cy - h * 0.7, cx, cy + h * 0.7, t, c);
  } else if (icon == UK_I_MINUS) {
    ukDrawLine(mut ui, cx - h * 0.7, cy, cx + h * 0.7, cy, t, c);
  } else if (icon == UK_I_CLOSE) {
    ukDrawLine(mut ui, cx - h * 0.55, cy - h * 0.55, cx + h * 0.55, cy + h * 0.55, t, c);
    ukDrawLine(mut ui, cx - h * 0.55, cy + h * 0.55, cx + h * 0.55, cy - h * 0.55, t, c);
  } else if (icon == UK_I_CHECK) {
    ukDrawLine(mut ui, cx - h * 0.62, cy + h * 0.02, cx - h * 0.18, cy + h * 0.48, t * 1.2, c);
    ukDrawLine(mut ui, cx - h * 0.18, cy + h * 0.48, cx + h * 0.66, cy - h * 0.46, t * 1.2, c);
  } else if (icon == UK_I_DOWN) {
    ukDrawLine(mut ui, cx - h * 0.5, cy - h * 0.22, cx, cy + h * 0.28, t, c);
    ukDrawLine(mut ui, cx, cy + h * 0.28, cx + h * 0.5, cy - h * 0.22, t, c);
  } else if (icon == UK_I_UP) {
    ukDrawLine(mut ui, cx - h * 0.5, cy + h * 0.22, cx, cy - h * 0.28, t, c);
    ukDrawLine(mut ui, cx, cy - h * 0.28, cx + h * 0.5, cy + h * 0.22, t, c);
  } else if (icon == UK_I_RIGHT) {
    ukDrawLine(mut ui, cx - h * 0.22, cy - h * 0.5, cx + h * 0.28, cy, t, c);
    ukDrawLine(mut ui, cx + h * 0.28, cy, cx - h * 0.22, cy + h * 0.5, t, c);
  } else if (icon == UK_I_LEFT) {
    ukDrawLine(mut ui, cx + h * 0.22, cy - h * 0.5, cx - h * 0.28, cy, t, c);
    ukDrawLine(mut ui, cx - h * 0.28, cy, cx + h * 0.22, cy + h * 0.5, t, c);
  } else if (icon == UK_I_SEARCH) {
    ukDrawCircle(mut ui, cx - h * 0.15, cy - h * 0.15, h * 0.5, t, c);
    ukDrawLine(mut ui, cx + h * 0.22, cy + h * 0.22, cx + h * 0.7, cy + h * 0.7, t * 1.3, c);
  } else if (icon == UK_I_CUT) {
    ukDrawCircle(mut ui, cx - h * 0.4, cy + h * 0.5, h * 0.26, t, c);
    ukDrawCircle(mut ui, cx + h * 0.4, cy + h * 0.5, h * 0.26, t, c);
    ukDrawLine(mut ui, cx - h * 0.25, cy + h * 0.3, cx + h * 0.45, cy - h * 0.75, t, c);
    ukDrawLine(mut ui, cx + h * 0.25, cy + h * 0.3, cx - h * 0.45, cy - h * 0.75, t, c);
  } else if (icon == UK_I_PREV) {
    ukDrawLine(mut ui, cx - h * 0.6, cy - h * 0.6, cx - h * 0.6, cy + h * 0.6, t, c);
    ukDrawTri(mut ui, cx + h * 0.6, cy - h * 0.6, cx + h * 0.6, cy + h * 0.6, cx - h * 0.4, cy, c);
  } else if (icon == UK_I_NEXT) {
    ukDrawLine(mut ui, cx + h * 0.6, cy - h * 0.6, cx + h * 0.6, cy + h * 0.6, t, c);
    ukDrawTri(mut ui, cx - h * 0.6, cy - h * 0.6, cx - h * 0.6, cy + h * 0.6, cx + h * 0.4, cy, c);
  } else if (icon == UK_I_MENU) {
    ukDrawLine(mut ui, cx - h * 0.65, cy - h * 0.5, cx + h * 0.65, cy - h * 0.5, t, c);
    ukDrawLine(mut ui, cx - h * 0.65, cy, cx + h * 0.65, cy, t, c);
    ukDrawLine(mut ui, cx - h * 0.65, cy + h * 0.5, cx + h * 0.65, cy + h * 0.5, t, c);
  } else if (icon == UK_I_DOT) {
    ukDrawCircle(mut ui, cx, cy, h * 0.42, 0.0, c);
  } else if (icon == UK_I_INFO) {
    ukDrawCircle(mut ui, cx, cy, h * 0.85, t, c);
    ukDrawLine(mut ui, cx, cy - h * 0.05, cx, cy + h * 0.45, t * 1.1, c);
    ukDrawCircle(mut ui, cx, cy - h * 0.4, t * 0.7, 0.0, c);
  } else if (icon == UK_I_WARN) {
    ukDrawTri(mut ui, cx, cy - h * 0.85, cx - h * 0.9, cy + h * 0.7, cx + h * 0.9, cy + h * 0.7, c);
  } else if (icon == UK_I_EYE) {
    ukDrawCircle(mut ui, cx, cy, h * 0.28, 0.0, c);
    ukDrawLine(mut ui, cx - h * 0.85, cy, cx, cy - h * 0.5, t, c);
    ukDrawLine(mut ui, cx, cy - h * 0.5, cx + h * 0.85, cy, t, c);
    ukDrawLine(mut ui, cx - h * 0.85, cy, cx, cy + h * 0.5, t, c);
    ukDrawLine(mut ui, cx, cy + h * 0.5, cx + h * 0.85, cy, t, c);
  } else if (icon == UK_I_LOCK) {
    const bw = Math.floor(h * 1.3) as i32;
    const bh = Math.floor(h * 0.95) as i32;
    ukDrawRound(mut ui, { x: (cx as i32) - bw / 2, y: (cy as i32) - bh / 4, w: bw, h: bh }, 2, c);
    ukDrawCircle(mut ui, cx, cy - h * 0.3, h * 0.4, t, c);
  }
}
