// uikit とウィンドウ（UM の組み込み。中身は SDL3）のつなぎ: WindowEvent を uikit の入力に変える。画面を BMP に書く。
// 毎フレーム ukEnd の後に ukWindowSync(ui, ウィンドウ) を呼ぶと、uikit の状態（コピーした文字など）を OS に渡す。
// ウィンドウを使うプログラムだけがこのファイルを import する（uikit のほかのファイルはウィンドウなしで動き、試しに使える）。
import {
  UkCtx, ukEventMouseMove, ukEventMouseButton, ukEventWheelFine, ukEventKey, ukEventMods, ukEventText,
  ukEventImeComposition, UK_CURSOR_TEXT, UK_CURSOR_POINTER, UK_CURSOR_RESIZE_EW, UK_CURSOR_RESIZE_NS, UK_CURSOR_MOVE,
  UK_CURSOR_CROSSHAIR, UK_CURSOR_NOT_ALLOWED, UK_CURSOR_WAIT, ukEventDropBegin, ukEventDropMove, ukEventDropFile,
  ukEventDropComplete,
  UK_KEY_TAB, UK_KEY_ENTER, UK_KEY_ESC, UK_KEY_BACKSPACE, UK_KEY_DELETE, UK_KEY_LEFT, UK_KEY_RIGHT, UK_KEY_UP,
  UK_KEY_DOWN, UK_KEY_HOME, UK_KEY_END, UK_KEY_PGUP, UK_KEY_PGDN, UK_KEY_SPACE, UK_KEY_F, UK_KEY_CHAR,
  UK_MOD_SHIFT, UK_MOD_CTRL, UK_MOD_ALT, UK_MOD_META,
} from "./core.um";

function ukModsBits(m: Mods): i32 {
  let b = 0;
  if (m.shift) {
    b = b | UK_MOD_SHIFT;
  }
  if (m.ctrl) {
    b = b | UK_MOD_CTRL;
  }
  if (m.alt) {
    b = b | UK_MOD_ALT;
  }
  if (m.meta) {
    b = b | UK_MOD_META;
  }
  return b;
}

function ukKeyCode(k: Key): i32 {
  match (k) {
    Key.Tab => { return UK_KEY_TAB; }
    Key.Enter => { return UK_KEY_ENTER; }
    Key.Escape => { return UK_KEY_ESC; }
    Key.Backspace => { return UK_KEY_BACKSPACE; }
    Key.Delete => { return UK_KEY_DELETE; }
    Key.Left => { return UK_KEY_LEFT; }
    Key.Right => { return UK_KEY_RIGHT; }
    Key.Up => { return UK_KEY_UP; }
    Key.Down => { return UK_KEY_DOWN; }
    Key.Home => { return UK_KEY_HOME; }
    Key.End => { return UK_KEY_END; }
    Key.PageUp => { return UK_KEY_PGUP; }
    Key.PageDown => { return UK_KEY_PGDN; }
    Key.Space => { return UK_KEY_SPACE; }
    Key.F(n) => { return UK_KEY_F + (n as i32); }
    Key.Char(cp) => { return UK_KEY_CHAR + (cp as i32); }
    _ => { return 0; }
  }
  return 0;
}

// ウィンドウのイベントの結果。
export struct UkWinRes {
  // 閉じる・終わるの要求
  quit: bool;
  // 大きさが変わった（新しい大きさ）
  resized: bool;
  w: i32;
  h: i32;
}

// ウィンドウの座標を、uikit が描く画素の座標にする（ui.winDensity 倍。1 ならそのまま）。
export function ukWinToPx(ui: UkCtx, v: i32): i32 {
  if (ui.winDensity == 1.0) {
    return v;
  }
  return Math.floor((v as f64) * ui.winDensity + 0.5) as i32;
}

// 画素の座標を、OS に渡すウィンドウの座標にする（ukWinToPx の逆）。
export function ukPxToWin(ui: UkCtx, v: i32): i32 {
  if (ui.winDensity == 1.0 || ui.winDensity <= 0.0) {
    return v;
  }
  return Math.floor((v as f64) / ui.winDensity + 0.5) as i32;
}

// ウィンドウのイベントを 1 つ uikit に渡す。マウスとドロップの位置は、ウィンドウの座標から画素の座標にする。
// 大きさの変わり（res.w・res.h）はウィンドウの座標のまま返す。
export function ukFeedWindowEvent(ui: mut UkCtx, e: WindowEvent, res: mut UkWinRes): void {
  match (e) {
    WindowEvent.Close(w) => { res.quit = true; }
    WindowEvent.Quit => { res.quit = true; }
    WindowEvent.Resize(w, nw, nh) => {
      if (nw > 0 && nh > 0) {
        res.resized = true;
        res.w = nw;
        res.h = nh;
      }
    }
    WindowEvent.MouseMove(w, x, y) => { ukEventMouseMove(mut ui, ukWinToPx(ui, x), ukWinToPx(ui, y)); }
    WindowEvent.MouseDown(w, x, y, b) => { ukEventMouseButton(mut ui, ukWinToPx(ui, x), ukWinToPx(ui, y), b, true); }
    WindowEvent.MouseUp(w, x, y, b) => { ukEventMouseButton(mut ui, ukWinToPx(ui, x), ukWinToPx(ui, y), b, false); }
    WindowEvent.Wheel(w, dx, dy, fx, fy) => { ukEventWheelFine(mut ui, dx, dy, fx, fy); }
    WindowEvent.KeyDown(w, key, mods, rep) => {
      const k = ukKeyCode(key);
      // 貼り付け（Ctrl+V / Cmd+V）: OS のクリップボードの文字を読んでから、キーを部品に渡す
      if (k == UK_KEY_CHAR + 118 && (mods.ctrl || mods.meta) && clipboardHasText()) {
        ui.clipboard = clipboardText();
      }
      if (k != 0) {
        ukEventKey(mut ui, k, ukModsBits(mods));
      } else {
        ukEventMods(mut ui, ukModsBits(mods));
      }
    }
    WindowEvent.KeyUp(w, key, mods) => { ukEventMods(mut ui, ukModsBits(mods)); }
    WindowEvent.Text(w, cp) => { ukEventText(mut ui, cp); }
    // IME の変換中の文字列（windowImeComposition(true) を windowOpen の前に呼んだときだけ届く。空なら変換の終わり）
    WindowEvent.TextEditing(w, text, start, len) => { ukEventImeComposition(mut ui, text); }
    // 窓の外からのドロップ（ui.dropActive・ukDropOver・ukDropTake で見る）
    WindowEvent.DropBegin(w) => { ukEventDropBegin(mut ui); }
    WindowEvent.DropPosition(w, x, y) => { ukEventDropMove(mut ui, ukWinToPx(ui, x), ukWinToPx(ui, y)); }
    WindowEvent.DropFile(w, path, x, y) => { ukEventDropFile(mut ui, path); }
    WindowEvent.DropComplete(w, x, y) => { ukEventDropComplete(mut ui, ukWinToPx(ui, x), ukWinToPx(ui, y)); }
    _ => {}
  }
}

// uikit のカーソルの形を OS の形にする。
function ukCursorShape(c: i32): CursorShape {
  if (c == UK_CURSOR_TEXT) {
    return CursorShape.Text;
  } else if (c == UK_CURSOR_POINTER) {
    return CursorShape.Pointer;
  } else if (c == UK_CURSOR_RESIZE_EW) {
    return CursorShape.ResizeEW;
  } else if (c == UK_CURSOR_RESIZE_NS) {
    return CursorShape.ResizeNS;
  } else if (c == UK_CURSOR_MOVE) {
    return CursorShape.Move;
  } else if (c == UK_CURSOR_CROSSHAIR) {
    return CursorShape.Crosshair;
  } else if (c == UK_CURSOR_NOT_ALLOWED) {
    return CursorShape.NotAllowed;
  } else if (c == UK_CURSOR_WAIT) {
    return CursorShape.Wait;
  }
  return CursorShape.Default;
}

// フレームの後に、uikit の状態を OS に渡す（ukEnd の後に毎フレーム呼ぶ）。
// - 部品がコピー・切り取りした文字（ui.clipboardOut）を OS のクリップボードに書く
// - 文字の入力欄にフォーカスがある間だけ OS の文字の入力を入れる（ない間は止めて、1 文字のショートカットが
//   IME の変換に吸われないようにする。ui.md 21.5）。入力中は欄の場所を（ウィンドウの座標にして）知らせ、
//   IME の候補の一覧をその近くに出す
// - 部品が決めたマウスのカーソルの形（ui.cursor）を、変わったときだけ OS に知らせる
export function ukWindowSync(ui: mut UkCtx, window: i32): void {
  if (ui.clipboardOut) {
    clipboardSetText(ui.clipboard);
    ui.clipboardOut = false;
  }
  if (ui.cursor != ui.osCursor) {
    windowSetCursor(ukCursorShape(ui.cursor));
    ui.osCursor = ui.cursor;
  }
  const on = ui.textActive ? 1 : 0;
  if (on != ui.osTextInput) {
    if (on == 1) {
      windowStartTextInput(window);
    } else {
      windowStopTextInput(window);
      ui.imeText = "";
    }
    ui.osTextInput = on;
    ui.osImeArea[4] = -1;
  }
  if (on == 1) {
    let same = ui.osImeDensity == ui.winDensity;
    for (let i: usize = 0; i < 5; i++) {
      if (ui.imeArea[i] != ui.osImeArea[i]) {
        same = false;
      }
    }
    if (!same) {
      // uikit の欄の場所は画素の座標なので、ウィンドウの座標にして渡す
      windowSetTextInputArea(
        window, ukPxToWin(ui, ui.imeArea[0]), ukPxToWin(ui, ui.imeArea[1]), ukPxToWin(ui, ui.imeArea[2]),
        ukPxToWin(ui, ui.imeArea[3]), ukPxToWin(ui, ui.imeArea[4]),
      );
      ui.osImeArea = ui.imeArea.clone();
      ui.osImeDensity = ui.winDensity;
    }
  }
}

export function ukWinResNew(): UkWinRes {
  return { quit: false, resized: false, w: 0, h: 0 };
}
