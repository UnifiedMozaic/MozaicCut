// インスペクタ（右の列のタブの中身）。docs/design/ui.md の 7 章、mockups/inspector.html。
//
//   let st = insStateNew();
//   ... 毎フレーム:
//   const evs = insDraw(mut ui, th, model, mut st, rect);   // rect はタブの帯の下の領域
//   for (const e of evs) { if (e.kind == INS_E_SET) { runOps(lines, probes, [e.ops を splitArgs したもの]) ... } }
//
// 中身（InsModel）は ins_model.um の insFromClip / insFromClips / insFromProject で作る。
// 値はここでは書き換えない。変更は ops.um の set / unset の文字列を InsEvent で返す（INS_E_SET は 1 つのバッチ）。
// ドラッグ中は INS_E_PREVIEW（履歴に残さずに見せる）、離したら INS_E_SET。
import { UkRect, ukRect, ukShrink, ukInside, ukAlpha, ukMix, ukNextChar, ukSub } from "../kit/base.um";
import {
  UkCtx, UkHit, ukBehavior, ukBehaviorEx, ukId, ukSt, ukPushId, ukPopId, ukPushIdInt, ukPushClip, ukPopClip, ukMouseIn,
  ukKeyTake, ukKeyTakeMods, ukFocus, ukDrawRect, ukDrawRound, ukDrawStroke, ukDrawText, ukDrawTextIn, ukDrawLine,
  ukDrawCircle, ukTextW, ukLineH, ukTooltip, UK_KEY_ENTER, UK_KEY_ESC, UK_KEY_UP, UK_KEY_DOWN, UK_KEY_LEFT, UK_KEY_RIGHT,
  UK_KEY_SPACE, UK_MOD_SHIFT, UK_MOD_ALT, UK_MOD_CTRL, ukDensPx, ukDensDrag,
} from "../kit/core.um";
import { ukNext } from "../kit/layout.um";
import {
  ukTextEdit, ukParseF64, ukParseTimecode, ukOpenPopup, ukClosePopups, ukPopupIsOpen, ukBeginPopup, ukEndPopup,
  ukTextField,
} from "../kit/widgets.um";
import { InsTheme, insParseHex } from "./ins_theme.um";
import {
  InsModel, InsRow, InsSection, InsFx, InsEvent, insEvent, insValueText, insMzcValue, insSetOps, insUnsetOps, insFps,
  insFxParamJa, insFxStep, insFxDecimals, insFxTokens, insFxReorderOps, insFxCatalogFor, insFxJa, insNumText,
  insModelEmpty, insModelMini, insRowCopy, insRowSetOps, insRowSetKv, insRowUnsetOps, insFxResetOps, insFxModified, insRow,
  INS_R_NUM, INS_R_TC, INS_R_SLIDER, INS_R_COLOR, INS_R_ENUM, INS_R_SEG, INS_R_TOGGLE, INS_R_TEXT, INS_R_REF, INS_R_INFO,
  INS_C_SEC, INS_M_NONE, INS_M_CLIP, INS_M_MULTI, INS_KF_NONE, INS_KF_OFF, INS_KF_ON,
  INS_E_SET, INS_E_PREVIEW, INS_E_KF_TOGGLE, INS_E_KF_PREV, INS_E_KF_NEXT, INS_E_KF_HERE, INS_E_COPY_ID, INS_E_OPEN_LINE,
  INS_E_FX_ENABLE, INS_E_CHOOSE, INS_E_PICK_COLOR, INS_E_PROJECT, INS_E_REF_MODE, INS_E_ADD_ID, INS_E_JUMP_CLIP, INS_E_FX_MOVE, INS_E_AUDIO_FX,
  INS_IC_MEDIA, INS_IC_TEXT, INS_IC_AUDIO, INS_IC_IMAGE, INS_IC_COLOR, INS_IC_GRID, INS_IC_FILE,
} from "./ins_model.um";
import {
  insIcon, INS_I_MEDIA, INS_I_TEXT, INS_I_AUDIO, INS_I_GRID, INS_I_FILE, INS_I_COPY, INS_I_CHEV_D, INS_I_CHEV_R,
  INS_I_CHEV_L, INS_I_KF, INS_I_KF_ON, INS_I_RESET, INS_I_PLUS, INS_I_LINK, INS_I_LOCK, INS_I_SELECT, INS_I_IMAGE,
  INS_I_COLOR, INS_I_SEARCH,
} from "./ins_icons.um";
import { fxParamCount, fxParamName, fxParamDefault, fxParamMin, fxParamMax, fxFindKey } from "../../gen/plugins.um";
import { KIND_VIDEO, KIND_AUDIO, KIND_TEXT, KIND_IMAGE, KIND_COLOR } from "../../engine/project.um";

// フレームをまたいで覚えておくこと（ホストが持つ）。
export struct InsState {
  // 値の欄にホバー・フォーカスしているキー（テキストで見るのトークンを光らせる）
  hoverKey: string;
  // テキストで見るのトークンにホバーしているキー（前のフレーム。値の欄を光らせる）
  tokKey: string;
  tokKeyNext: string;
  // いま変えたキー（緑に光らせる）と時刻
  flashKey: string;
  flashT: f64;
  // 効果のつまみで並べ替え中の効果（-1 なし）と、前のフレームの効果の見出しの y
  dragFx: i32;
  fxY: i32[];
  fxYNext: i32[];
  // 効果を足すの検索の文字
  addFilter: string;
  // 効果を足すの一覧: キーで選んでいる番号、スクロール、開いたときに検索の欄へフォーカスを移す
  addSel: i32;
  addScroll: i32;
  addFocus: bool;
  // 次のフレームでキーボードのフォーカスを移す値の欄のキー（insFocusKey）
  focusReq: string;
  // 打ち込み中の欄（0 なし）。始めたときの宛先と行を覚えておき、選択が変わったらそれで確定する
  editId: u32;
  editSeen: bool;
  editSig: string;
  editModel: InsModel;
  editRow: InsRow;
  // フォーカスした部品の矩形（中身の座標。見えない所ならスクロールして見せる）
  focusRect: UkRect;
  focusHas: bool;
  focusShown: u32;
  // スクロールバーのドラッグ（始めの位置）
  barY0: i32;
  barS0: f32;
  // 右の列の下の端（効果を足すの一覧の高さの上限）
  panelBottom: i32;
  // 折り返しと幅の覚え（文字・大きさ・幅ごと。model が変わったときだけ計り直す）
  wrapKey: string[];
  wrapOut: string[];
  tokLine: string;
  tokW: i32[];
}

export function insStateNew(): InsState {
  return {
    hoverKey: "", tokKey: "", tokKeyNext: "", flashKey: "", flashT: -100.0, dragFx: -1, fxY: [], fxYNext: [], addFilter: "",
    addSel: 0, addScroll: 0, addFocus: false, focusReq: "", editId: 0, editSeen: false, editSig: "",
    editModel: insModelEmpty(), editRow: insRow(0, "", ""), focusRect: ukRect(0, 0, 0, 0), focusHas: false, focusShown: 0,
    barY0: 0, barS0: 0.0, panelBottom: 100000, wrapKey: [], wrapOut: [], tokLine: "", tokW: [],
  };
}

// model の宛先の印（選択が変わったかを見る）。
function insSig(m: InsModel): string {
  let s = `${m.mode}`;
  for (const r of m.refs) {
    s = s + "|" + r;
  }
  return s;
}

// ふるまい（ukBehaviorEx）に、フォーカスしたときの矩形の記録を足したもの。
function insB(ui: mut UkCtx, st: mut InsState, id: u32, r: UkRect, focusable: bool, keys: bool): UkHit {
  const h = ukBehaviorEx(mut ui, id, r, focusable, keys);
  if (h.focused && focusable) {
    st.focusRect = r;
    st.focusHas = true;
  }
  return h;
}

// key の値の欄へキーボードのフォーカスを移す（次に描くとき。輪も見せる）。
export function insFocusKey(st: mut InsState, key: string): void {
  st.focusReq = key.clone();
}

// 値を変えたトークンを光らせる（ホストが外から変えたときにも呼べる）。
export function insFlash(st: mut InsState, key: string, now: f64): void {
  st.flashKey = key.clone();
  st.flashT = now;
}

// ---- 描く道具 ----

function insTextAt(ui: mut UkCtx, x: i32, yMid: i32, s: string, size: f32, c: u32): i32 {
  const h = ukLineH(ui, size);
  return ukDrawText(mut ui, x, yMid - h / 2, s, size, c);
}

// 太字（600）の代わり: 1 画素ずらして 2 度描く。uikit に太字のフォントが入ったら置き換える。
function insBoldAt(ui: mut UkCtx, x: i32, yMid: i32, s: string, size: f32, c: u32): i32 {
  const h = ukLineH(ui, size);
  ukDrawText(mut ui, x + 1, yMid - h / 2, s, size, c);
  return ukDrawText(mut ui, x, yMid - h / 2, s, size, c) + 1;
}

function insIconAt(ui: mut UkCtx, x: i32, yMid: i32, size: i32, icon: i32, c: u32): void {
  insIcon(mut ui, ukRect(x, yMid - size / 2, size, size), icon, c);
}

function insHLine(ui: mut UkCtx, th: InsTheme, x: i32, y: i32, w: i32): void {
  ukDrawRect(mut ui, ukRect(x, y, w, th.hair), th.line);
}

// 文字を幅 maxW で折り返す（文字ごと。日本語の文向け）。幅は 1 文字ずつ足していく（先頭から測り直さない）。
// 結果は st に覚え、同じ文字・大きさ・幅なら計り直さない（覚えは 64 件まで。あふれたら捨てる）。
function insWrap(ui: mut UkCtx, st: mut InsState, s: string, size: f32, maxW: i32): string[] {
  const key = `${maxW}|${size}|` + s;
  for (let i: usize = 0; i < st.wrapKey.length; i++) {
    if (st.wrapKey[i] == key) {
      return insSplitNl(st.wrapOut[i]);
    }
  }
  let out: string[] = [];
  let a: usize = 0;
  let i: usize = 0;
  let w = 0;
  while (i < s.length) {
    const j = ukNextChar(s, i);
    const cw = ukTextW(mut ui, ukSub(s, i, j), size);
    if (s[i] == 10) {
      out.push(ukSub(s, a, i));
      a = j;
      w = 0;
    } else if (w + cw > maxW && i > a) {
      out.push(ukSub(s, a, i));
      a = i;
      w = cw;
    } else {
      w = w + cw;
    }
    i = j;
  }
  if (s.length > a || out.length == 0) {
    out.push(ukSub(s, a, s.length));
  }
  if (st.wrapKey.length >= 64) {
    st.wrapKey.clear();
    st.wrapOut.clear();
  }
  let joined = "";
  for (let k: usize = 0; k < out.length; k++) {
    if (k > 0) {
      joined = joined + "\n";
    }
    joined = joined + out[k];
  }
  st.wrapKey.push(key);
  st.wrapOut.push(joined);
  return out;
}

function insSplitNl(s: string): string[] {
  let out: string[] = [];
  let a: usize = 0;
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 10) {
      out.push(ukSub(s, a, i));
      a = i + 1;
    }
  }
  out.push(ukSub(s, a, s.length));
  return out;
}

// フォーカスの輪（ui.md 19: 部品から 1px 離して内に accent 2px、外に黒 1px）。キーボードで動かしたときだけ。
function insFocusRing(ui: mut UkCtx, th: InsTheme, r: UkRect): void {
  const o = th.focusOff + th.focusW;
  ukDrawStroke(mut ui, ukShrink(r, -(o + th.hair)), th.rSm + o + th.hair, th.hair, th.focusOuter);
  ukDrawStroke(mut ui, ukShrink(r, -o), th.rSm + o, th.focusW, th.accent);
}

// 小さなアイコンのボタン（地はホバーで bg-3）。Tab で選べ、Enter / Space で押せる。押されたら true。
function insIconBtn(ui: mut UkCtx, th: InsTheme, st: mut InsState, label: string, r: UkRect, icon: i32, isz: i32, c: u32, tip: string): bool {
  const id = ukId(ui, label);
  const h = insB(mut ui, mut st, id, r, true, true);
  if (h.hover) {
    ukDrawRound(mut ui, r, th.rSm, th.bg3);
  }
  insIconAt(mut ui, r.x + (r.w - isz) / 2, r.y + r.h / 2, isz, icon, h.hover ? th.text1 : c);
  if (h.focused && ui.focusVisible) {
    insFocusRing(mut ui, th, r);
  }
  if (tip != "" && h.hover) {
    ukTooltip(mut ui, tip);
  }
  return h.clicked;
}

function insPushSet(evs: mut InsEvent[], kind: i32, key: string, ops: string[]): void {
  let e = insEvent(kind, key, "");
  for (const o of ops) {
    e.ops.push(o.clone());
  }
  evs.push(e);
}

function insClamp(v: f64, lo: f64, hi: f64): f64 {
  return Math.min(Math.max(v, lo), hi);
}

function insSnap(v: f64, step: f64): f64 {
  if (step <= 0.0) {
    return v;
  }
  return Math.floor(v / step + 0.5) * step;
}

// ---- 値の変更を作る ----

function insEmitValue(ui: mut UkCtx, th: InsTheme, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], v: f64, preview: bool): void {
  if (r.readOnly || r.key == "") {
    return;
  }
  const val = insMzcValue(m, r, v);
  if (m.mode == INS_M_NONE) {
    let e = insEvent(INS_E_PROJECT, r.key, r.key + "=" + val);
    e.n = preview ? 1 : 0;
    evs.push(e);
    return;
  }
  insPushSet(mut evs, preview ? INS_E_PREVIEW : INS_E_SET, r.key, insRowSetOps(m, r, val));
  if (!preview) {
    insFlash(mut st, r.key, ui.now);
  }
}

// 文字の値（色の #RRGGBB・文字の内容・project の値）を書く。key は r.key か m.textKey。
function insEmitText(ui: mut UkCtx, m: InsModel, r: InsRow, key: string, val: string, st: mut InsState, evs: mut InsEvent[]): void {
  if (m.mode == INS_M_NONE) {
    evs.push(insEvent(INS_E_PROJECT, key, key + "=" + val));
    return;
  }
  let rr = insRowCopy(r);
  rr.key = key.clone();
  if (key != r.key) {
    rr.perRef.clear();
  }
  insPushSet(mut evs, INS_E_SET, key, insRowSetOps(m, rr, val));
  insFlash(mut st, key, ui.now);
}

// 文字の値を .mzc の値に（いつも "..." で囲む。" と \ は前に \）。
function insQuote(s: string): string {
  let out: u8[] = [34];
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 34 || s[i] == 92) {
      out.push(92);
    }
    if (s[i] == 10) {
      out.push(92);
      out.push(110);
    } else {
      out.push(s[i]);
    }
  }
  out.push(34);
  return stringFromBytes(out);
}

// ---- 値の欄（ドラッグ・打ち込み・↑↓）----
//
// 覚えておく値（欄の ID）: i[3] 打ち込み中、s 打ち込み中の文字。
// （ラベルの ID）: f[0] ドラッグ中、d[0] 始めの値、d[1] いまの値。
// 打ち込みを始めたときに、宛先（model の refs）と行を st に写す（insBeginEdit）。選択が変わったフレームや、欄が描かれなく
// なったフレームでは、写した宛先と行で確定する（新しく選んだクリップには書かない）。

function insParseInput(m: InsModel, r: InsRow, txt: string, cur: f64, out: mut f64[]): bool {
  if (r.kind == INS_R_TC) {
    const p = ukParseTimecode(txt, insFps(m), Math.floor(cur + 0.5) as i64);
    if (p < 0) {
      return false;
    }
    out[0] = p as f64;
    return true;
  }
  // 「−」（U+2212）を「-」に
  let b: u8[] = [];
  let i: usize = 0;
  while (i < txt.length) {
    if (i + 2 < txt.length && txt[i] == 0xe2 && txt[i + 1] == 0x88 && txt[i + 2] == 0x92) {
      b.push(45);
      i += 3;
    } else {
      b.push(txt[i]);
      i++;
    }
  }
  return ukParseF64(stringFromBytes(b), mut out);
}

function insBeginEdit(ui: mut UkCtx, st: mut InsState, m: InsModel, r: InsRow, id: u32, si: usize, txt: string): void {
  ui.st[si].i[3] = 1;
  ui.st[si].s = txt.clone();
  ui.st[si].i[0] = txt.length as i32;
  ui.st[si].i[1] = 0;
  ui.st[si].i[2] = 0;
  ukFocus(mut ui, id, ui.focusVisible);
  st.editId = id;
  st.editSeen = true;
  st.editSig = insSig(m);
  st.editModel = insModelMini(m);
  st.editRow = insRowCopy(r);
}

// 写しておいた宛先と行で、打ち込みを確定する（選択が変わった・欄が描かれなくなった・ほかの欄で打ち始めた）。
function insFlushEdit(ui: mut UkCtx, th: InsTheme, st: mut InsState, evs: mut InsEvent[]): void {
  if (st.editId == 0) {
    return;
  }
  const si = ukSt(mut ui, st.editId);
  const s = ui.st[si].s.clone();
  const was = ui.st[si].i[3] != 0;
  ui.st[si].i[3] = 0;
  st.editId = 0;
  if (!was) {
    return;
  }
  const em = insModelMini(st.editModel);
  const er = insRowCopy(st.editRow);
  insCommitInput(mut ui, th, em, er, mut st, mut evs, s, er.v);
}

// 「1920x1080」「1920 × 1080」「１９２０ｘ１０８０」を読む。読めなければ false。
function insParseSize(s: string, out: mut i32[]): bool {
  let nums: i32[] = [];
  let cur: i32 = -1;
  let i: usize = 0;
  while (i < s.length) {
    let d: i32 = -1;
    let n: usize = 1;
    if (s[i] >= 48 && s[i] <= 57) {
      d = (s[i] - 48) as i32;
    } else if (i + 2 < s.length && s[i] == 0xef && s[i + 1] == 0xbc && s[i + 2] >= 0x90 && s[i + 2] <= 0x99) {
      // 全角の数字（U+FF10〜FF19）
      d = (s[i + 2] - 0x90) as i32;
      n = 3;
    }
    if (d >= 0) {
      cur = (cur < 0 ? 0 : cur) * 10 + d;
      if (cur > 100000) {
        return false;
      }
    } else {
      if (cur >= 0) {
        nums.push(cur);
        cur = -1;
      }
      // 区切り: 空白・x・X・*・×（U+00D7）・ｘ（U+FF58）・全角の空白は読み飛ばす。ほかの文字は誤り
      const c = s[i];
      const sep = c == 32 || c == 120 || c == 88 || c == 42;
      const times = i + 1 < s.length && c == 0xc3 && s[i + 1] == 0x97;
      const fx = i + 2 < s.length && c == 0xef && s[i + 1] == 0xbd && s[i + 2] == 0x98;
      const fsp = i + 2 < s.length && c == 0xe3 && s[i + 1] == 0x80 && s[i + 2] == 0x80;
      if (times) {
        n = 2;
      } else if (fx || fsp) {
        n = 3;
      } else if (!sep) {
        return false;
      }
    }
    i += n;
  }
  if (cur >= 0) {
    nums.push(cur);
  }
  if (nums.length != 2 || nums[0] < 16 || nums[1] < 16) {
    return false;
  }
  out[0] = nums[0];
  out[1] = nums[1];
  return true;
}

// 値の欄を描き、押されたら打ち込みを始める。
function insField(ui: mut UkCtx, th: InsTheme, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], fr: UkRect, v: f64, mixed: bool, linked: bool): void {
  const fid = ukId(ui, "field");
  const editable = !r.readOnly && (r.kind == INS_R_NUM || r.kind == INS_R_TC || r.kind == INS_R_SLIDER || r.kind == INS_R_COLOR || r.kind == INS_R_INFO && r.key == "size");
  if (st.focusReq != "" && st.focusReq == r.key) {
    ukFocus(mut ui, fid, true);
    st.focusReq = "";
  }
  const ym = fr.y + fr.h / 2;
  // 色の見本は欄より先に当たりを取る（欄が先だと、押したときに欄が active を取ってしまう）。Tab で選べ、Enter で色の窓
  let swr = ukRect(0, 0, 0, 0);
  if (r.kind == INS_R_COLOR) {
    const sw = th.iconSm;
    swr = ukRect(fr.x + th.s2, ym - sw / 2, sw, sw);
    const sid = ukId(ui, "swatch");
    const sh = insB(mut ui, mut st, sid, ukShrink(swr, -2), true, true);
    if (sh.clicked) {
      evs.push(insEvent(INS_E_PICK_COLOR, r.colorKey, r.text));
    }
    if (sh.hover) {
      ukTooltip(mut ui, "色を選ぶ");
    }
    if (sh.focused && ui.focusVisible) {
      insFocusRing(mut ui, th, swr);
    }
  }
  const h = insB(mut ui, mut st, fid, fr, editable, false);
  const si = ukSt(mut ui, fid);
  if (h.hover || h.focused) {
    st.hoverKey = r.key.clone();
  }
  if (r.tip != "" && h.hover) {
    ukTooltip(mut ui, r.tip);
  }
  const fsC = th.fsCode;
  const inner = ukRect(fr.x + th.s2, fr.y, fr.w - th.s2 * 2, fr.h);
  // 打ち込み中
  if (ui.st[si].i[3] != 0) {
    if (st.editId == fid) {
      st.editSeen = true;
    }
    if (ukKeyTake(mut ui, UK_KEY_ESC)) {
      ui.st[si].i[3] = 0;
      if (st.editId == fid) {
        st.editId = 0;
      }
    } else {
      ukDrawRound(mut ui, fr, th.rSm, th.bg3);
      ukDrawStroke(mut ui, fr, th.rSm, th.hair, th.accent);
      const s0 = ui.st[si].s.clone();
      const s = ukTextEdit(mut ui, fid, si, inner, s0, h, th.text1);
      ui.st[si].s = s.clone();
      if (ui.lastSubmit || ui.focus != fid) {
        ui.st[si].i[3] = 0;
        ui.lastSubmit = false;
        if (st.editId == fid) {
          st.editId = 0;
        }
        insCommitInput(mut ui, th, m, r, mut st, mut evs, s, v);
      }
      return;
    }
  }
  if (editable && ((h.clicked && !h.held) || (h.focused && ukKeyTake(mut ui, UK_KEY_ENTER)))) {
    // 打ち込みを始める（今の値を全部選んだ形）。混在なら空から
    let txt = "";
    if (mixed) {
      txt = "";
    } else if (r.kind == INS_R_COLOR && r.colorKey == r.key) {
      txt = ukSub(r.text, 1, r.text.length);
    } else if (r.kind == INS_R_INFO) {
      // 解像度: .mzc と同じ「1920x1080」の形で打つ
      let wh: i32[] = [0, 0];
      if (insParseSize(r.text, mut wh)) {
        txt = `${wh[0]}x${wh[1]}`;
      } else {
        txt = r.text.clone();
      }
    } else if (r.kind == INS_R_TC) {
      txt = insValueText(m, r, v);
    } else {
      txt = insNumText(v, r.decimals);
    }
    insFlushEdit(mut ui, th, mut st, mut evs);
    insBeginEdit(mut ui, mut st, m, r, fid, si, txt);
  }
  // ↑↓ で増減（Shift で 10 倍）。混在のときは効かない（1 つ目の値を基にして全部に書いてしまうため）
  if (h.focused && editable && !mixed && (r.kind == INS_R_NUM || r.kind == INS_R_TC || r.kind == INS_R_SLIDER)) {
    const mu = ukKeyTakeMods(mut ui, UK_KEY_UP);
    const md = ukKeyTakeMods(mut ui, UK_KEY_DOWN);
    let d: f64 = 0.0;
    if (mu >= 0) {
      d = (mu & UK_MOD_SHIFT) != 0 ? 10.0 : 1.0;
    } else if (md >= 0) {
      d = (md & UK_MOD_SHIFT) != 0 ? -10.0 : -1.0;
    }
    if (d != 0.0) {
      const nv = insClamp(insSnap(v + d * r.step, r.step), r.lo, r.hi);
      insEmitValue(mut ui, th, m, r, mut st, mut evs, nv, false);
    }
  }
  // ふだんの見た目（輪郭は line.control。ホバーと、テキストで見るのトークンから光らせたときは accent）
  ukDrawRound(mut ui, fr, th.rSm, th.bg3);
  ukDrawStroke(mut ui, fr, th.rSm, th.hair, linked || (h.hover && editable) ? th.accent : th.lineControl);
  if (h.focused && ui.focusVisible) {
    insFocusRing(mut ui, th, fr);
  }
  let tc = r.modified ? th.accentHover : th.text1;
  if (r.dim) {
    tc = th.text2;
  }
  if (mixed) {
    // 狭い欄（スライダーの右の欄）では「—」だけ
    if (ukTextW(mut ui, "—（混在）", th.fsMd) > inner.w) {
      ukDrawTextIn(mut ui, inner, "—", th.fsMd, th.text2, 0);
    } else {
      ukDrawTextIn(mut ui, inner, "—（混在）", th.fsMd, th.text2, 0);
    }
    return;
  }
  let x = inner.x;
  if (r.kind == INS_R_COLOR) {
    ukDrawRound(mut ui, swr, th.rSm, r.color | 0xff000000);
    ukDrawStroke(mut ui, swr, th.rSm, th.hair, ukMouseIn(ui, swr) ? th.text2 : th.lineControl);
    x = x + swr.w + th.s2 - 2;
    if (r.colorKey == r.key) {
      insTextAt(mut ui, x, ym, r.text, fsC, tc);
      return;
    }
  }
  if (r.kind == INS_R_INFO) {
    ukDrawTextIn(mut ui, ukRect(x, fr.y, inner.x + inner.w - x, fr.h), r.text, fsC, tc, 0);
    return;
  }
  insTextAt(mut ui, x, ym, insValueText(m, r, v), fsC, tc);
  if (r.unit != "") {
    const uw = ukTextW(mut ui, r.unit, th.fsSm);
    insTextAt(mut ui, inner.x + inner.w - uw, ym, r.unit, th.fsSm, th.text2);
  }
}

function insCommitInput(ui: mut UkCtx, th: InsTheme, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], s: string, v: f64): void {
  if (r.kind == INS_R_TEXT) {
    if (s != r.text) {
      insEmitText(mut ui, m, r, m.textKey, insQuote(s), mut st, mut evs);
    }
    return;
  }
  if (r.kind == INS_R_COLOR && r.colorKey == r.key) {
    const c = insParseHex(s);
    if (c >= 0) {
      let hx = s.clone();
      if (hx.length > 0 && hx[0] == 35) {
        hx = ukSub(hx, 1, hx.length);
      }
      if ("#" + hx != r.text || r.mixed) {
        insEmitText(mut ui, m, r, r.key, hx, mut st, mut evs);
      }
    }
    return;
  }
  if (r.kind == INS_R_INFO) {
    // 解像度: 「数 x 数」だけを受け付け、size=WxH に直す。前と同じなら何も出さない
    let wh: i32[] = [0, 0];
    let old: i32[] = [0, 0];
    if (insParseSize(s, mut wh)) {
      const same = insParseSize(r.text, mut old) && old[0] == wh[0] && old[1] == wh[1];
      if (!same) {
        insEmitText(mut ui, m, r, r.key, `${wh[0]}x${wh[1]}`, mut st, mut evs);
      }
    }
    return;
  }
  if (s == "") {
    return;
  }
  let out: f64[] = [0.0];
  if (insParseInput(m, r, s, v, mut out)) {
    const nv = insClamp(out[0], r.lo, r.hi);
    if (nv != v || r.mixed) {
      insEmitValue(mut ui, th, m, r, mut st, mut evs, nv, false);
    }
  }
}

// ラベル（左右のドラッグで値。Shift で 10 倍、Ctrl で 1/10（ui.md 7.3）。モックアップの説明の Alt でも 1/10）。
// 戻り値は表示する値。混在の行ではドラッグしない（1 つ目の値を基にして全部に書いてしまうため）。
function insLabel(ui: mut UkCtx, th: InsTheme, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], lr: UkRect): f64 {
  const ym = lr.y + lr.h / 2;
  let x = lr.x;
  if (r.modified) {
    const d = Math.max(th.s1 + 1, 3);
    ukDrawCircle(mut ui, (x + d / 2) as f32, ym as f32, (d as f32) / 2.0, 0.0, th.accent);
    x = x + d + th.s1 + 1;
  }
  const lid = ukId(ui, "label");
  const draggable = !r.readOnly && !r.mixed && r.key != "" && (r.kind == INS_R_NUM || r.kind == INS_R_TC || r.kind == INS_R_SLIDER || r.kind == INS_R_COLOR && r.colorKey != r.key);
  ukDrawTextIn(mut ui, ukRect(x, lr.y, lr.x + lr.w - x, lr.h), r.label, th.fsSm, th.text2, 0);
  if (!draggable) {
    return r.v;
  }
  const h = ukBehaviorEx(mut ui, lid, lr, false, false);
  const si = ukSt(mut ui, lid);
  if (h.pressed) {
    ui.st[si].d[0] = r.v;
    ui.st[si].d[1] = r.v;
    ui.st[si].f[0] = 0.0;
  } else if (h.held) {
    const dx = ui.inp.mx - ui.activeX;
    if (Math.abs(dx) > ukDensPx(ui, 2)) {
      ui.st[si].f[0] = 1.0;
    }
    if (ui.st[si].f[0] > 0.0) {
      let mul: f64 = 1.0;
      if ((ui.inp.mods & UK_MOD_SHIFT) != 0) {
        mul = 10.0;
      } else if ((ui.inp.mods & (UK_MOD_CTRL | UK_MOD_ALT)) != 0) {
        mul = 0.1;
      }
      const stp = r.step * (mul < 1.0 ? 0.1 : 1.0);
      const nv = insClamp(insSnap(ui.st[si].d[0] + ukDensDrag(ui, dx) * r.step * mul, stp), r.lo, r.hi);
      if (nv != ui.st[si].d[1]) {
        ui.st[si].d[1] = nv;
        insEmitValue(mut ui, th, m, r, mut st, mut evs, nv, true);
      }
    }
  } else if (ui.st[si].f[0] > 0.0) {
    // 離した: 1 つの変更として確定
    ui.st[si].f[0] = 0.0;
    insEmitValue(mut ui, th, m, r, mut st, mut evs, ui.st[si].d[1], false);
    return ui.st[si].d[1];
  }
  if (h.hover || h.held) {
    st.hoverKey = r.key.clone();
  }
  if (ui.st[si].f[0] > 0.0) {
    return ui.st[si].d[1];
  }
  return r.v;
}

// キーフレームの ◇ か ◀ ◆ ▶。キーのない行（パンなど .mzc にまだ書けないもの）には出さない。
function insKfCell(ui: mut UkCtx, th: InsTheme, r: InsRow, st: mut InsState, evs: mut InsEvent[], cr: UkRect): void {
  if (r.key == "") {
    return;
  }
  const isz = th.iconSm * 3 / 4;
  if (r.kf == INS_KF_OFF) {
    if (insIconBtn(mut ui, th, mut st, "kf", ukRect(cr.x, cr.y + (cr.h - th.s5 + 4) / 2, cr.w, th.s5 - 4), INS_I_KF, isz, th.text3, "アニメーションを有効にする")) {
      evs.push(insEvent(INS_E_KF_TOGGLE, r.key, ""));
    }
  } else if (r.kf == INS_KF_ON) {
    const cw = cr.w / 3;
    const by = cr.y + (cr.h - th.s5 + 4) / 2;
    const bh = th.s5 - 4;
    if (insIconBtn(mut ui, th, mut st, "kfprev", ukRect(cr.x, by, cw, bh), INS_I_CHEV_L, isz, th.accent, "前のキーフレームへ")) {
      evs.push(insEvent(INS_E_KF_PREV, r.key, ""));
    }
    if (insIconBtn(mut ui, th, mut st, "kfhere", ukRect(cr.x + cw, by, cw, bh), r.kfAtHead ? INS_I_KF_ON : INS_I_KF, isz, th.accent, "ここにキーフレームを足す・消す")) {
      evs.push(insEvent(INS_E_KF_HERE, r.key, ""));
    }
    if (insIconBtn(mut ui, th, mut st, "kfnext", ukRect(cr.x + cw * 2, by, cr.w - cw * 2, bh), INS_I_CHEV_R, isz, th.accent, "次のキーフレームへ")) {
      evs.push(insEvent(INS_E_KF_NEXT, r.key, ""));
    }
  }
}

function insResetCell(ui: mut UkCtx, th: InsTheme, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], cr: UkRect): void {
  if (!r.modified || r.readOnly) {
    return;
  }
  const isz = th.iconSm * 3 / 4;
  if (insIconBtn(mut ui, th, mut st, "reset", ukRect(cr.x, cr.y + (cr.h - th.s5 + 4) / 2, cr.w, th.s5 - 4), INS_I_RESET, isz, th.text3, "既定に戻す")) {
    const ops = insRowUnsetOps(m, r);
    if (ops.length > 0) {
      insPushSet(mut evs, INS_E_SET, r.key, ops);
      insFlash(mut st, r.key, ui.now);
    }
  }
}

// ---- ポップアップとメニューの項目（デザインの bg-popover・line-strong。uikit の見た目が直るまでの仮）----

function insBeginPop(ui: mut UkCtx, th: InsTheme, id: u32, minW: i32): bool {
  const r0 = ui.theme.raised;
  const b0 = ui.theme.border;
  ui.theme.raised = th.bgPopover;
  ui.theme.border = th.lineStrong;
  const open = ukBeginPopup(mut ui, id, minW);
  ui.theme.raised = r0;
  ui.theme.border = b0;
  return open;
}

// メニューの 1 項目（高さ 28、ホバーとキーで選んでいる項目は accent.tint の地）。押されたらポップアップを閉じる。
function insMenuItem(ui: mut UkCtx, th: InsTheme, label: string, text: string, shortcut: string, checked: bool, hi: bool, w: i32): UkHit {
  const id = ukId(ui, label);
  const r = ukNext(mut ui, w, th.row);
  let h = ukBehavior(mut ui, id, r, false);
  if (ui.popupFrame == ui.frame) {
    h.clicked = false;
  }
  if (h.hover || hi) {
    ukDrawRound(mut ui, r, th.rSm, th.accentTint);
  }
  const ym = r.y + r.h / 2;
  if (checked) {
    const cx = (r.x + th.s2) as f32;
    const cy = ym as f32;
    ukDrawLine(mut ui, cx, cy, cx + 3.0, cy + 3.0, 1.5, th.text1);
    ukDrawLine(mut ui, cx + 3.0, cy + 3.0, cx + 9.0, cy - 3.0, 1.5, th.text1);
  }
  const tx = r.x + th.s2 + th.iconSm;
  let sw = 0;
  if (shortcut != "") {
    sw = ukTextW(mut ui, shortcut, th.fsXs) + th.s2;
    insTextAt(mut ui, r.x + r.w - sw, ym, shortcut, th.fsXs, th.text3);
  }
  ukDrawTextIn(mut ui, ukRect(tx, r.y, r.x + r.w - sw - tx - th.s1, r.h), text, th.fsMd, th.text1, 0);
  if (h.clicked) {
    ukClosePopups(mut ui);
  }
  return h;
}

function insMenuSep(ui: mut UkCtx, th: InsTheme, w: i32): void {
  const r = ukNext(mut ui, w, th.s2 + th.hair);
  ukDrawRect(mut ui, ukRect(r.x, r.y + th.s1, r.w, th.hair), th.line);
}

// ---- 1 行 ----

function insRowH(ui: mut UkCtx, th: InsTheme, st: mut InsState, r: InsRow, w: i32): i32 {
  if (r.kind == INS_R_TEXT) {
    const lines = insWrap(mut ui, mut st, r.text, th.fsMd, w - th.s3 - th.s2 - th.s2 * 2);
    const n = Math.max(lines.length as i32, 1);
    return Math.max(th.s5 * 2 + th.s1, n * (th.lhMd + 2) + th.s2 + th.s1) + th.s2 - 2;
  }
  if (r.kind == INS_R_REF) {
    return th.s1 + 22 * th.lhSm / 16 + th.s1 + th.lhSm + th.s2 - 2;
  }
  return th.row;
}

function insDrawRow(ui: mut UkCtx, th: InsTheme, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], x: i32, y: i32, w: i32): i32 {
  const h = insRowH(mut ui, th, mut st, r, w);
  const lx = x + th.s3;
  const right = x + w - th.s2;
  const gap = th.s2 - 2;
  const cell = th.s5 - 4;
  if (r.kind == INS_R_TEXT) {
    // 内容（複数行の文字。打ち込みは 1 行の欄。複数行の入力欄は uikit に足すもの）
    const tr = ukRect(lx, y, right - lx, h - (th.s2 - 2));
    const tid = ukId(ui, "ta");
    const hh = insB(mut ui, mut st, tid, tr, true, false);
    const si = ukSt(mut ui, tid);
    if (hh.hover || hh.focused) {
      st.hoverKey = m.textKey.clone();
    }
    ukDrawRound(mut ui, tr, th.rSm, th.bg3);
    if (ui.st[si].i[3] != 0) {
      if (st.editId == tid) {
        st.editSeen = true;
      }
      if (ukKeyTake(mut ui, UK_KEY_ESC)) {
        ui.st[si].i[3] = 0;
        if (st.editId == tid) {
          st.editId = 0;
        }
      } else {
        ukDrawStroke(mut ui, tr, th.rSm, th.hair, th.accent);
        const s0 = ui.st[si].s.clone();
        const s = ukTextEdit(mut ui, tid, si, ukRect(tr.x + th.s2, tr.y + th.s1 + 2, tr.w - th.s2 * 2, th.lhMd + 2), s0, hh, th.text1);
        ui.st[si].s = s.clone();
        if (ui.lastSubmit || ui.focus != tid) {
          ui.st[si].i[3] = 0;
          ui.lastSubmit = false;
          if (st.editId == tid) {
            st.editId = 0;
          }
          insCommitInput(mut ui, th, m, r, mut st, mut evs, s, 0.0);
        }
        return h;
      }
    }
    if (hh.clicked || (hh.focused && ukKeyTake(mut ui, UK_KEY_ENTER))) {
      insFlushEdit(mut ui, th, mut st, mut evs);
      insBeginEdit(mut ui, mut st, m, r, tid, si, r.text);
    }
    if (hh.focused && ui.focusVisible) {
      insFocusRing(mut ui, th, tr);
    }
    const lines = insWrap(mut ui, mut st, r.text, th.fsMd, tr.w - th.s2 * 2);
    let ly = tr.y + th.s1 + 2;
    for (const ln of lines) {
      insTextAt(mut ui, tr.x + th.s2, ly + (th.lhMd + 2) / 2, ln, th.fsMd, th.text1);
      ly = ly + th.lhMd + 2;
    }
    return h;
  }
  const lr = ukRect(lx, y, th.labelW, th.row);
  let fx = lx + th.labelW + gap;
  if (r.kind == INS_R_REF) {
    insTextAt(mut ui, lx, y + th.s1 + 11 * th.lhSm / 16, r.label, th.fsSm, th.text2);
    // 札
    const fs = th.fsSm;
    const isz = th.iconSm * 3 / 4;
    const cw = th.s2 + isz + 5 + ukTextW(mut ui, r.text, fs) + th.s2;
    const chH = 22 * th.lhSm / 16;
    const cr = ukRect(fx, y + th.s1, cw, chH);
    const cid = ukId(ui, "refchip");
    const hh = insB(mut ui, mut st, cid, cr, true, true);
    if (hh.hover) {
      st.hoverKey = r.key.clone();
    }
    ukDrawRound(mut ui, cr, th.rSm, th.referenceTint);
    if (hh.hover) {
      ukDrawRound(mut ui, cr, th.rSm, th.referenceTint);
    }
    ukDrawStroke(mut ui, cr, th.rSm, th.hair, ukAlpha(th.reference, 77));
    insIconAt(mut ui, cr.x + th.s2, cr.y + chH / 2, isz, INS_I_LINK, th.reference);
    insTextAt(mut ui, cr.x + th.s2 + isz + 5, cr.y + chH / 2, r.text, fs, th.reference);
    if (hh.focused && ui.focusVisible) {
      insFocusRing(mut ui, th, cr);
    }
    const pid = ukId(ui, "refpop");
    if (hh.clicked) {
      ukOpenPopup(mut ui, pid, cr.x, cr.y + cr.h + 2);
    }
    if (insBeginPop(mut ui, th, pid, cr.w)) {
      const pw = th.s5 * 7;
      const a = insMenuItem(mut ui, th, "ref", "参照で置く", "", true, false, pw);
      const b = insMenuItem(mut ui, th, "sec", "秒で置く", "", false, false, pw);
      insMenuSep(mut ui, th, pw);
      const c = insMenuItem(mut ui, th, "jump", `${r.refId} へ`, "", false, false, pw);
      if (b.clicked) {
        insRefToSec(mut ui, m, r, mut st, mut evs);
      }
      if (c.clicked) {
        evs.push(insEvent(INS_E_JUMP_CLIP, r.key, r.refId));
      }
      const _a = a.clicked;
      ukEndPopup(mut ui);
    }
    // = 00:00:19:00　秒で置く
    const sy = cr.y + chH + th.s1 + th.lhSm / 2;
    const sw = insTextAt(mut ui, fx, sy, r.sub, th.fsXs, th.text3);
    const lk = "秒で置く";
    const lkx = fx + sw + th.s3;
    const lkw = ukTextW(mut ui, lk, th.fsXs);
    const lkr = ukRect(lkx, sy - th.lhSm / 2, lkw, th.lhSm);
    const lid = ukId(ui, "tosec");
    const lh = insB(mut ui, mut st, lid, lkr, true, true);
    insTextAt(mut ui, lkx, sy, lk, th.fsXs, lh.hover ? th.text1 : th.accentHover);
    if (lh.focused && ui.focusVisible) {
      insFocusRing(mut ui, th, lkr);
    }
    if (lh.clicked) {
      insRefToSec(mut ui, m, r, mut st, mut evs);
    }
    return h;
  }
  if (r.kind == INS_R_SEG) {
    insTextAt(mut ui, lx, y + th.row / 2, r.label, th.fsSm, th.text2);
    insSeg(mut ui, th, m, r, mut st, mut evs, fx, y + th.row / 2);
    return h;
  }
  // 右の 2 つの欄（キーフレームと既定に戻す）
  const kfW = r.kf == INS_KF_ON ? th.s5 * 2 + th.s2 : cell;
  const resetX = right - cell;
  const kfX = resetX - gap - kfW;
  const fw = kfX - gap - fx;
  const fr = ukRect(fx, y + (th.row - th.field) / 2, fw, th.field);
  const linked = st.tokKey != "" && st.tokKey == r.key;
  const v = insLabel(mut ui, th, m, r, mut st, mut evs, lr);
  if (r.kind == INS_R_ENUM) {
    insEnum(mut ui, th, m, r, mut st, mut evs, fr);
  } else if (r.kind == INS_R_TOGGLE) {
    insToggle(mut ui, th, m, r, mut st, mut evs, fr);
  } else if (r.kind == INS_R_SLIDER) {
    const vw = th.s5 * 2 + th.s2;
    const sr = ukRect(fx, y, kfX + kfW - vw - th.s2 - fx, th.row);
    const nv = insSlider(mut ui, th, m, r, mut st, mut evs, sr, v);
    insField(mut ui, th, m, r, mut st, mut evs, ukRect(kfX + kfW - vw, fr.y, vw, fr.h), nv, r.mixed, linked);
  } else {
    insField(mut ui, th, m, r, mut st, mut evs, fr, v, r.mixed, linked);
  }
  if (r.kind != INS_R_SLIDER) {
    insKfCell(mut ui, th, r, mut st, mut evs, ukRect(kfX, y, kfW, th.row));
  }
  insResetCell(mut ui, th, m, r, mut st, mut evs, ukRect(resetX, y, cell, th.row));
  return h;
}

function insRefToSec(ui: mut UkCtx, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[]): void {
  let e = insEvent(INS_E_REF_MODE, r.key, r.refId);
  e.n = 0;
  for (const o of insRowSetOps(m, r, insMzcValue(m, r, r.v))) {
    e.ops.push(o.clone());
  }
  evs.push(e);
  insFlash(mut st, r.key, ui.now);
}

// 選択肢を選んだ: key=value があれば op、なければ INS_E_CHOOSE（key は r.key。フォントは仮のキー "font"）。
function insChoose(ui: mut UkCtx, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], i: usize): void {
  const kv = r.optVals[i].clone();
  if (kv == "") {
    let e = insEvent(INS_E_CHOOSE, r.key, r.options[i]);
    e.n = i as i32;
    evs.push(e);
    return;
  }
  insPushSet(mut evs, INS_E_SET, r.key, insRowSetKv(m, r, kv));
  insFlash(mut st, r.key, ui.now);
}

// セグメント（選択肢を横に並べる）。地は bg-1、枠は line-strong（モックアップの .seg）。←→ でも選べる。
function insSeg(ui: mut UkCtx, th: InsTheme, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], x: i32, ym: i32): void {
  const pad = 2;
  const ih = th.field;
  const fs = th.fsSm;
  let ws: i32[] = [];
  let total = pad;
  for (const o of r.options) {
    const w = ukTextW(mut ui, o, fs) + th.s3 * 2;
    ws.push(w);
    total = total + w + pad;
  }
  const br = ukRect(x, ym - ih / 2 - pad - th.hair, total + th.hair * 2, ih + (pad + th.hair) * 2);
  ukDrawRound(mut ui, br, th.rMd, th.bg1);
  ukDrawStroke(mut ui, br, th.rMd, th.hair, th.lineStrong);
  let cx = x + th.hair + pad;
  for (let i: usize = 0; i < r.options.length; i++) {
    const ir = ukRect(cx, ym - ih / 2, ws[i], ih);
    ukPushIdInt(mut ui, i as i32);
    const id = ukId(ui, "seg");
    const h = insB(mut ui, mut st, id, ir, true, true);
    ukPopId(mut ui);
    const on = (i as i32) == r.sel;
    if (on) {
      ukDrawRound(mut ui, ir, th.rSm, th.bg4);
    } else if (h.hover) {
      ukDrawRound(mut ui, ir, th.rSm, th.bg3);
    }
    if (h.hover) {
      st.hoverKey = r.key.clone();
    }
    if (h.focused && ui.focusVisible) {
      insFocusRing(mut ui, th, ir);
    }
    ukDrawTextIn(mut ui, ir, r.options[i], fs, on ? th.text1 : th.text2, 1);
    if (h.clicked && !on && !r.readOnly) {
      insChoose(mut ui, m, r, mut st, mut evs, i);
    }
    cx = cx + ws[i] + pad;
  }
}

// ドロップダウン（選択肢）。
function insEnum(ui: mut UkCtx, th: InsTheme, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], fr: UkRect): void {
  const id = ukId(ui, "enum");
  const h = insB(mut ui, mut st, id, fr, true, true);
  const pid = ukId(ui, "enumpop");
  const open = ukPopupIsOpen(ui, pid);
  if (h.clicked) {
    if (open) {
      ukClosePopups(mut ui);
    } else {
      ukOpenPopup(mut ui, pid, fr.x, fr.y + fr.h + 2);
    }
  }
  ukDrawRound(mut ui, fr, th.rSm, th.bg3);
  ukDrawStroke(mut ui, fr, th.rSm, th.hair, open || h.hover ? th.accent : th.lineControl);
  if (h.focused && ui.focusVisible) {
    insFocusRing(mut ui, th, fr);
  }
  const isz = th.iconSm * 3 / 4;
  ukDrawTextIn(mut ui, ukRect(fr.x + th.s2, fr.y, fr.w - th.s2 * 2 - isz, fr.h), r.text, th.fsSm, th.text1, 0);
  insIconAt(mut ui, fr.x + fr.w - th.s2 - isz, fr.y + fr.h / 2, isz, INS_I_CHEV_D, th.text3);
  if (insBeginPop(mut ui, th, pid, fr.w)) {
    for (let i: usize = 0; i < r.options.length; i++) {
      ukPushIdInt(mut ui, i as i32);
      const ih = insMenuItem(mut ui, th, "opt", r.options[i], "", (i as i32) == r.sel, false, fr.w - th.s2);
      ukPopId(mut ui);
      if (ih.clicked && (i as i32) != r.sel) {
        insChoose(mut ui, m, r, mut st, mut evs, i);
      }
    }
    ukEndPopup(mut ui);
  }
}

// トグル（幅 28、高さ 16 の丸い溝）。オフは bg-1 の地に line-control の内側の輪（モックアップの .toggle）。
function insToggle(ui: mut UkCtx, th: InsTheme, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], fr: UkRect): void {
  const tw = th.s5 + th.s1;
  const tht = th.s4;
  const tr = ukRect(fr.x, fr.y + (fr.h - tht) / 2, tw, tht);
  const id = ukId(ui, "toggle");
  const h = insB(mut ui, mut st, id, ukRect(fr.x, fr.y, tw + th.s2 + ukTextW(mut ui, r.text, th.fsSm), fr.h), true, true);
  if (r.on) {
    ukDrawRound(mut ui, tr, tht / 2, th.accent);
  } else {
    ukDrawRound(mut ui, tr, tht / 2, th.bg1);
    ukDrawStroke(mut ui, tr, tht / 2, th.hair, th.lineControl);
  }
  const kd = tht - 4;
  const kx = r.on ? tr.x + tw - 2 - kd : tr.x + 2;
  ukDrawCircle(mut ui, (kx + kd / 2) as f32, (tr.y + tht / 2) as f32, (kd as f32) / 2.0, 0.0, r.on ? th.textOnDark : th.text2);
  if (r.text != "") {
    insTextAt(mut ui, tr.x + tw + th.s2, fr.y + fr.h / 2, r.text, th.fsSm, th.text2);
  }
  if (h.focused && ui.focusVisible) {
    insFocusRing(mut ui, th, tr);
  }
  if (h.hover) {
    st.hoverKey = r.key.clone();
  }
  if (h.clicked && !r.readOnly && r.key != "") {
    let kv = r.key + "=1";
    if (r.on) {
      kv = r.key + "=0";
    }
    if (r.optVals.length == 2) {
      kv = r.optVals[r.on ? 0 : 1].clone();
    }
    insPushSet(mut evs, INS_E_SET, r.key, insRowSetKv(m, r, kv));
    insFlash(mut st, r.key, ui.now);
  }
}

// スライダー（溝の高さ 4、つまみ 14）。溝は bg-1 に line-control の輪（モックアップの .slider）。戻り値は表示する値。
// フォーカス中は ←→ で 1 刻み（Shift で 10 刻み）。読み取りだけ（無効の効果）のときは当たりを持たず、text.disabled で描く。
// 混在のときはつまみを出さない（押すと全部に同じ値を書く）。
function insSlider(ui: mut UkCtx, th: InsTheme, m: InsModel, r: InsRow, st: mut InsState, evs: mut InsEvent[], sr: UkRect, v: f64): f64 {
  const kr = 7 * th.s1 / 4;
  const x0 = sr.x + kr;
  const x1 = sr.x + sr.w - kr;
  const span = r.hi - r.lo;
  let nv = v;
  let focused = false;
  if (!r.readOnly) {
    const id = ukId(ui, "slider");
    const h = insB(mut ui, mut st, id, sr, true, false);
    const si = ukSt(mut ui, id);
    focused = h.focused;
    if ((h.pressed || h.held) && span > 0.0 && x1 > x0) {
      const t = ((ui.inp.mx - x0) as f64) / ((x1 - x0) as f64);
      nv = insClamp(insSnap(r.lo + t * span, r.step), r.lo, r.hi);
      ui.st[si].f[0] = 1.0;
      if (nv != ui.st[si].d[1] || h.pressed) {
        ui.st[si].d[1] = nv;
        insEmitValue(mut ui, th, m, r, mut st, mut evs, nv, true);
      }
    } else if (ui.st[si].f[0] > 0.0) {
      ui.st[si].f[0] = 0.0;
      nv = ui.st[si].d[1];
      insEmitValue(mut ui, th, m, r, mut st, mut evs, nv, false);
    }
    if (h.focused && !r.mixed) {
      const ml = ukKeyTakeMods(mut ui, UK_KEY_LEFT);
      const mr = ukKeyTakeMods(mut ui, UK_KEY_RIGHT);
      let d: f64 = 0.0;
      if (ml >= 0) {
        d = (ml & UK_MOD_SHIFT) != 0 ? -10.0 : -1.0;
      } else if (mr >= 0) {
        d = (mr & UK_MOD_SHIFT) != 0 ? 10.0 : 1.0;
      }
      if (d != 0.0) {
        nv = insClamp(insSnap(v + d * r.step, r.step), r.lo, r.hi);
        insEmitValue(mut ui, th, m, r, mut st, mut evs, nv, false);
      }
    }
    if (h.hover || h.held) {
      st.hoverKey = r.key.clone();
    }
  }
  const t = span > 0.0 ? insClamp((nv - r.lo) / span, 0.0, 1.0) : 0.0;
  const kx = x0 + (Math.floor(t * ((x1 - x0) as f64) + 0.5) as i32);
  const ym = sr.y + sr.h / 2;
  const tt = th.s1;
  const track = ukRect(sr.x, ym - tt / 2, sr.w, tt);
  ukDrawRound(mut ui, ukShrink(track, -th.hair), tt / 2 + th.hair, th.lineControl);
  ukDrawRound(mut ui, track, tt / 2, th.bg1);
  if (r.mixed) {
    return nv;
  }
  ukDrawRound(mut ui, ukRect(sr.x, ym - tt / 2, kx - sr.x, tt), tt / 2, r.readOnly ? th.textDis : th.accent);
  ukDrawCircle(mut ui, kx as f32, ym as f32, (kr as f32) + 1.0, 0.0, th.focusOuter);
  ukDrawCircle(mut ui, kx as f32, ym as f32, kr as f32, 0.0, r.readOnly ? th.textDis : th.text1);
  if (focused && ui.focusVisible) {
    ukDrawCircle(mut ui, kx as f32, ym as f32, (kr as f32) + 3.0, 2.0, th.accent);
  }
  return nv;
}

// ---- 見出し ----

function insHeadIcon(m: InsModel): i32 {
  if (m.icon == INS_IC_MEDIA) {
    return INS_I_MEDIA;
  }
  if (m.icon == INS_IC_TEXT) {
    return INS_I_TEXT;
  }
  if (m.icon == INS_IC_AUDIO) {
    return INS_I_AUDIO;
  }
  if (m.icon == INS_IC_IMAGE) {
    return INS_I_IMAGE;
  }
  if (m.icon == INS_IC_COLOR) {
    return INS_I_COLOR;
  }
  if (m.icon == INS_IC_GRID) {
    return INS_I_GRID;
  }
  return INS_I_FILE;
}

function insKindColor(th: InsTheme, kind: i32): u32 {
  if (kind == KIND_VIDEO) {
    return th.kVideo;
  }
  if (kind == KIND_AUDIO) {
    return th.kAudio;
  }
  if (kind == KIND_TEXT) {
    return th.kText;
  }
  if (kind == KIND_IMAGE) {
    return th.kImage;
  }
  return th.kColor;
}

function insChip(ui: mut UkCtx, th: InsTheme, st: mut InsState, label: string, x: i32, y: i32, mono: bool, act: bool): UkHit {
  const fs = mono ? th.fsXs : th.fsSm;
  const w = ukTextW(mut ui, label, fs) + (th.s2 - 1) * 2;
  const r = ukRect(x, y, w, th.s5 - th.s1);
  const id = ukId(ui, label);
  const h = insB(mut ui, mut st, id, r, act, true);
  ukDrawRound(mut ui, r, th.rSm, act && h.hover ? th.bg4 : th.bg3);
  insTextAt(mut ui, r.x + th.s2 - 1, r.y + r.h / 2, label, fs, th.text2);
  if (act && h.focused && ui.focusVisible) {
    insFocusRing(mut ui, th, r);
  }
  return h;
}

function insDrawHead(ui: mut UkCtx, th: InsTheme, m: InsModel, st: mut InsState, evs: mut InsEvent[], x: i32, y0: i32, w: i32): i32 {
  let y = y0 + th.s3;
  const lx = x + th.s3;
  const isz = th.iconSm;
  const ym = y + th.lhLg / 2;
  const ic = m.iconColor == 1 ? insKindColor(th, m.kind) : th.text2;
  insIconAt(mut ui, lx, ym, isz, insHeadIcon(m), ic);
  const tx = lx + isz + th.s2;
  let tw = x + w - th.s3 - tx;
  if (m.copyId) {
    const bs = th.btnSm;
    const br = ukRect(x + w - th.s3 - bs + th.s1, ym - bs / 2, bs, bs);
    if (insIconBtn(mut ui, th, mut st, "copyid", br, INS_I_COPY, isz, th.text2, "ID をコピー")) {
      let e = insEvent(INS_E_COPY_ID, "id", ukSub(m.refs[0], 0, m.refs[0].length));
      evs.push(e);
    }
    tw = br.x - th.s2 - tx;
  }
  const fitted = insFit(mut ui, m.title, th.fsLg, tw);
  insBoldAt(mut ui, tx, ym, fitted, th.fsLg, th.text1);
  y = y + th.lhLg;
  if (m.sub != "") {
    y = y + 2;
    insTextAt(mut ui, lx, y + th.lhSm / 2, m.sub, th.fsSm, th.text2);
    y = y + th.lhSm;
  }
  if (m.chips.length > 0) {
    y = y + th.s2;
    let cx = lx;
    let cy = y;
    const ch = th.s5 - th.s1;
    for (let i: usize = 0; i < m.chips.length; i++) {
      const fs = m.chipMono[i] ? th.fsXs : th.fsSm;
      const cw = ukTextW(mut ui, m.chips[i], fs) + (th.s2 - 1) * 2;
      if (cx + cw > x + w - th.s3 && cx > lx) {
        cx = lx;
        cy = cy + ch + th.s1;
      }
      const act = m.chipAct[i];
      const h = insChip(mut ui, th, mut st, m.chips[i], cx, cy, m.chipMono[i], act != 0);
      if (h.clicked && act != 0) {
        let e = insEvent(act, "", m.chips[i]);
        if (act == INS_E_COPY_ID) {
          e.text = m.refs[0].clone();
        }
        e.line = m.line;
        evs.push(e);
      }
      if (h.hover && i < m.chipTip.length && m.chipTip[i] != "") {
        ukTooltip(mut ui, m.chipTip[i]);
      }
      cx = cx + cw + th.s1;
    }
    y = cy + ch;
  }
  y = y + th.s2;
  insHLine(mut ui, th, x, y, w);
  return y + th.hair - y0;
}

function insFit(ui: mut UkCtx, s: string, size: f32, maxW: i32): string {
  if (ukTextW(mut ui, s, size) <= maxW) {
    return s.clone();
  }
  const ell = "…";
  const ew = ukTextW(mut ui, ell, size);
  let i: usize = 0;
  let best: usize = 0;
  let w = 0;
  while (i < s.length) {
    const j = ukNextChar(s, i);
    w = w + ukTextW(mut ui, ukSub(s, i, j), size);
    if (w + ew > maxW) {
      break;
    }
    best = j;
    i = j;
  }
  return ukSub(s, 0, best) + ell;
}

// 節の見出し（高さ 30。▾ と名前）。開閉の状態は、呼ぶ側が積んだ ID（節の名前）に付く。戻り値は開いているか。
function insSecHead(ui: mut UkCtx, th: InsTheme, st: mut InsState, title: string, x: i32, y: i32, w: i32, badge: i32): bool {
  const hh = th.s5 + th.s1 + 2;
  const id = ukId(ui, "sechead");
  const si = ukSt(mut ui, id);
  const hr = ukRect(x, y, Math.min(w / 2, th.labelW + th.s5 * 2), hh);
  const h = insB(mut ui, mut st, id, hr, true, true);
  if (h.clicked) {
    ui.st[si].i[0] = ui.st[si].i[0] == 0 ? 1 : 0;
  }
  const open = ui.st[si].i[0] == 0;
  const isz = th.iconSm * 3 / 4;
  const ym = y + hh / 2;
  insIconAt(mut ui, x + th.s3, ym, isz, open ? INS_I_CHEV_D : INS_I_CHEV_R, th.text1);
  const tx = x + th.s3 + isz + th.s2 - 2;
  const tw = insBoldAt(mut ui, tx, ym, title, th.fsSm, th.text1);
  if (badge > 0) {
    const bs = `${badge}`;
    const bw = Math.max(ukTextW(mut ui, bs, th.fsXs) + th.s1 * 2, th.s4);
    const br = ukRect(tx + tw + th.s2 - 2, ym - th.s4 / 2, bw, th.s4);
    ukDrawRound(mut ui, br, th.s4 / 2, th.bg4);
    ukDrawTextIn(mut ui, br, bs, th.fsXs, th.text1, 1);
  }
  if (h.focused && ui.focusVisible) {
    insFocusRing(mut ui, th, ukRect(x + th.s2, y + 3, tw + isz + th.s3, hh - 6));
  }
  return open;
}

// 「参照される」の行: このクリップを参照しているクリップの札（押すとそのクリップへ。ui.md 7.3）。
function insDrawRefBy(ui: mut UkCtx, th: InsTheme, m: InsModel, st: mut InsState, evs: mut InsEvent[], x: i32, y0: i32, w: i32): i32 {
  const lx = x + th.s3;
  const fx = lx + th.labelW + th.s2 - 2;
  const ch = 22 * th.lhSm / 16;
  insTextAt(mut ui, lx, y0 + th.row / 2, "参照される", th.fsSm, th.text2);
  let cx = fx;
  let cy = y0 + (th.row - ch) / 2;
  const isz = th.iconSm * 3 / 4;
  ukPushId(mut ui, "refby");
  for (const id of m.refBy) {
    const cw = th.s2 + isz + 5 + ukTextW(mut ui, id, th.fsSm) + th.s2;
    if (cx + cw > x + w - th.s2 && cx > fx) {
      cx = fx;
      cy = cy + ch + th.s1;
    }
    const cr = ukRect(cx, cy, cw, ch);
    const h = insB(mut ui, mut st, ukId(ui, id), cr, true, true);
    ukDrawRound(mut ui, cr, th.rSm, th.referenceTint);
    ukDrawStroke(mut ui, cr, th.rSm, th.hair, h.hover ? th.reference : ukAlpha(th.reference, 77));
    insIconAt(mut ui, cr.x + th.s2, cr.y + ch / 2, isz, INS_I_LINK, th.reference);
    insTextAt(mut ui, cr.x + th.s2 + isz + 5, cr.y + ch / 2, id, th.fsSm, th.reference);
    if (h.focused && ui.focusVisible) {
      insFocusRing(mut ui, th, cr);
    }
    if (h.hover) {
      ukTooltip(mut ui, `${id} へ移る（このクリップを参照しています）`);
    }
    if (h.clicked) {
      evs.push(insEvent(INS_E_JUMP_CLIP, "at", id));
    }
    cx = cx + cw + th.s1;
  }
  ukPopId(mut ui);
  return Math.max(cy + ch + (th.row - ch) / 2 - y0, th.row);
}

// ---- 効果 ----

function insFxOpenId(ui: mut UkCtx, name: string): u32 {
  ukPushId(mut ui, name);
  const id = ukId(ui, "fxopen");
  ukPopId(mut ui);
  return id;
}

function insFxIsOpen(ui: mut UkCtx, f: InsFx, i: usize): bool {
  const si = ukSt(mut ui, insFxOpenId(mut ui, f.name));
  if (ui.st[si].i[0] == 0) {
    return i == 0 && f.enabled;
  }
  return ui.st[si].i[0] == 1;
}

function insFxToggleOpen(ui: mut UkCtx, f: InsFx, open: bool): void {
  const si = ukSt(mut ui, insFxOpenId(mut ui, f.name));
  ui.st[si].i[0] = open ? 2 : 1;
}

// 効果の引数の行（スライダー）を作る。キーは行に書いてあるもの（別名なら別名）を使い、複数の選択では宛先ごとに持つ。
function insFxRow(m: InsModel, f: InsFx, k: i32): InsRow {
  const e = f.effect;
  const pn = fxParamName(e, k);
  let key = f.name.clone();
  if (k > 0) {
    key = f.name + "." + pn;
  }
  const n = fxParamCount(e) as usize;
  const ku = k as usize;
  if (f.pkeys[ku] != "") {
    key = f.pkeys[ku].clone();
  }
  let r = insRow(INS_R_SLIDER, insFxParamJa(pn), key);
  r.v = f.params[ku];
  r.def = fxParamDefault(e, k) as f64;
  r.hasDef = true;
  r.lo = fxParamMin(e, k) as f64;
  r.hi = fxParamMax(e, k) as f64;
  r.step = insFxStep(e, k);
  r.decimals = insFxDecimals(e, k);
  r.readOnly = !f.enabled;
  r.mixed = f.mixed[ku];
  if (f.rpkeys.length > 0) {
    for (let j: usize = 0; j < m.refs.length; j++) {
      const at = j * n + ku;
      if (at < f.rpkeys.length) {
        r.perRef.push(f.rpkeys[at].clone());
      } else {
        r.perRef.push("");
      }
    }
  }
  r.modified = r.mixed || Math.abs(r.v - r.def) > 0.00001;
  return r;
}

// チェック（14px）。枠は line-control（モックアップの .chk）。
function insChk(ui: mut UkCtx, th: InsTheme, r: UkRect, on: bool, hover: bool): void {
  if (on) {
    ukDrawRound(mut ui, r, th.rSm, th.accent);
    const cx = r.x as f32;
    const cy = r.y as f32;
    const s = r.w as f32;
    ukDrawLine(mut ui, cx + s * 0.25, cy + s * 0.5, cx + s * 0.43, cy + s * 0.68, 2.0, th.bg0);
    ukDrawLine(mut ui, cx + s * 0.43, cy + s * 0.68, cx + s * 0.76, cy + s * 0.33, 2.0, th.bg0);
  } else {
    ukDrawRound(mut ui, r, th.rSm, th.bg0);
    ukDrawStroke(mut ui, r, th.rSm, th.hair, hover ? th.text2 : th.lineControl);
  }
}

function insDrawFx(ui: mut UkCtx, th: InsTheme, m: InsModel, st: mut InsState, evs: mut InsEvent[], x: i32, y0: i32, w: i32, last: bool): i32 {
  let y = y0;
  const hh = th.s5 + th.s1 + 2;
  ukPushId(mut ui, "fx");
  // 見出し
  let nOn = 0;
  for (const f of m.fx) {
    if (f.enabled) {
      nOn++;
    }
  }
  const open = insSecHead(mut ui, th, mut st, m.fxTitle, x, y, w, m.mode == INS_M_CLIP && !m.fxAudio ? nOn : 0);
  // ［効果を足す］
  insAddFxButton(mut ui, th, m, mut st, mut evs, x + w - th.s2, y + hh / 2);
  y = y + hh;
  if (!open) {
    ukPopId(mut ui);
    if (!last) {
      insHLine(mut ui, th, x, y, w);
      return y + th.hair - y0;
    }
    return y - y0;
  }
  if (m.fx.length == 0) {
    if (m.mode == INS_M_MULTI) {
      const lines = insWrap(mut ui, mut st, m.fxEmpty, th.fsSm, w - th.s3 - th.s2);
      for (const ln of lines) {
        insTextAt(mut ui, x + th.s3, y + th.row / 2, ln, th.fsSm, th.text2);
        y = y + th.row;
      }
    } else {
      const ey = y + th.s2 + 2;
      ukDrawTextIn(mut ui, ukRect(x, ey, w, th.lhSm), m.fxEmpty, th.fsSm, th.text2, 1);
      y = ey + th.lhSm + th.s2 + 2;
    }
  }
  st.fxYNext.clear();
  for (let i: usize = 0; i < m.fx.length; i++) {
    ukPushId(mut ui, m.fx[i].name);
    st.fxYNext.push(y);
    y = y + insDrawOneFx(mut ui, th, m, i, mut st, mut evs, x, y, w);
    ukPopId(mut ui);
  }
  st.fxYNext.push(y);
  // 並べ替えの線
  if (st.dragFx >= 0 && st.fxY.length == m.fx.length + 1) {
    const to = insFxDropIndex(ui, st);
    const ly = st.fxY[to];
    ukDrawRect(mut ui, ukRect(x + th.s2, ly - 1, w - th.s2 * 2, 2), th.accent);
  }
  ukPopId(mut ui);
  if (!last) {
    insHLine(mut ui, th, x, y, w);
    y = y + th.hair;
  }
  return y - y0;
}

function insFxDropIndex(ui: UkCtx, st: InsState): usize {
  const n = st.fxY.length - 1;
  let best: usize = 0;
  for (let i: usize = 0; i <= n; i++) {
    if (ui.inp.my >= st.fxY[i] - (i < n ? 0 : 1000000)) {
      best = i;
    }
  }
  // 見出しの中ほどより下なら次の位置
  for (let i: usize = 0; i < n; i++) {
    const mid = (st.fxY[i] + st.fxY[i + 1]) / 2;
    if (ui.inp.my < mid) {
      return i;
    }
  }
  return Math.min(best, n);
}

function insDrawOneFx(ui: mut UkCtx, th: InsTheme, m: InsModel, i: usize, st: mut InsState, evs: mut InsEvent[], x: i32, y0: i32, w: i32): i32 {
  return insDrawOneFxF(mut ui, th, m, m.fx[i], i, mut st, mut evs, x, y0, w);
}

// 効果の並べ替え（from 番目を to 番目へ）と、有効・無効・既定に戻すのイベント。
function insFxMove(m: InsModel, f: InsFx, from: usize, to: usize, evs: mut InsEvent[]): void {
  if (to == from || to >= m.fx.length) {
    return;
  }
  insPushSet(mut evs, INS_E_FX_MOVE, f.name, insFxReorderOps(m, from, to));
  evs[evs.length - 1].n = to as i32;
}

function insFxEnable(m: InsModel, f: InsFx, evs: mut InsEvent[]): void {
  let e = insEvent(INS_E_FX_ENABLE, f.name, "");
  e.n = f.enabled ? 0 : 1;
  if (f.enabled) {
    for (const o of insUnsetOps(m, f.keys)) {
      e.ops.push(o.clone());
    }
  } else {
    for (const rf of m.refs) {
      let s = `set ${rf}`;
      for (const t of insFxTokens(f)) {
        s = s + " " + t;
      }
      e.ops.push(s);
    }
  }
  evs.push(e);
}

function insFxReset(ui: mut UkCtx, m: InsModel, f: InsFx, st: mut InsState, evs: mut InsEvent[]): void {
  const ops = insFxResetOps(m, f);
  if (ops.length > 0) {
    insPushSet(mut evs, INS_E_SET, f.name, ops);
    insFlash(mut st, f.name, ui.now);
  }
}

function insDrawOneFxF(ui: mut UkCtx, th: InsTheme, m: InsModel, f: InsFx, i: usize, st: mut InsState, evs: mut InsEvent[], x: i32, y0: i32, w: i32): i32 {
  let y = y0;
  const hh = th.s5 + th.s1 + 2;
  insHLine(mut ui, th, x, y, w);
  const open = insFxIsOpen(mut ui, f, i);
  const en = f.enabled;
  // 無効の効果は、名前・「無効」を text-2、キーを text-3 で（ui.md 7.4。まだ押せるので不透明度は下げない）
  const nameC = en ? th.text1 : th.text2;
  const ym = y + hh / 2;
  let cx = x + th.s3;
  // 並べ替えと有効・無効は、1 つのクリップのときだけ（複数の選択はクリップごとの書き直しが入るまで出さない）
  const canEdit = !m.fxLocked;
  if (canEdit) {
    // つまみ
    const gw = th.s3;
    const gr = ukRect(cx - 2, y, gw + 4, hh);
    const gid = ukId(ui, "grip");
    const gh = ukBehaviorEx(mut ui, gid, gr, false, false);
    for (let gx = 0; gx < 2; gx++) {
      for (let gy = 0; gy < 3; gy++) {
        ukDrawCircle(mut ui, (cx + 2 + gx * 4) as f32, (ym - 4 + gy * 4) as f32, 1.0, 0.0, gh.hover || gh.held ? th.text1 : th.text3);
      }
    }
    if (gh.hover) {
      ukTooltip(mut ui, "ドラッグで並べ替え（上から順に掛かります。キーは見出しで Alt+↑↓）");
    }
    if (gh.pressed) {
      st.dragFx = i as i32;
    }
    if (st.dragFx == (i as i32) && !gh.held && !gh.pressed) {
      // 離した
      if (st.fxY.length == m.fx.length + 1) {
        let to = insFxDropIndex(ui, st);
        if (to > i) {
          to = to - 1;
        }
        insFxMove(m, f, i, to, mut evs);
      }
      st.dragFx = -1;
    }
    cx = cx + gw + th.s2 - 2;
    // 有効・無効
    const cs = th.s4 - 2;
    const cr = ukRect(cx, ym - cs / 2, cs, cs);
    const cid = ukId(ui, "chk");
    const ch = insB(mut ui, mut st, cid, ukShrink(cr, -3), true, true);
    insChk(mut ui, th, cr, en, ch.hover);
    if (ch.focused && ui.focusVisible) {
      insFocusRing(mut ui, th, cr);
    }
    if (ch.hover) {
      if (en) {
        ukTooltip(mut ui, "無効にする");
      } else {
        ukTooltip(mut ui, "有効にする");
      }
    }
    if (ch.clicked) {
      insFxEnable(m, f, mut evs);
    }
    cx = cx + cs + th.s2;
  }
  // 右: ▾ / ▸ と ↺
  const isz = th.iconSm * 3 / 4;
  const chx = x + w - th.s2 - isz - 2;
  let rx = chx - th.s2;
  const modified = en && insFxModified(f);
  if (modified) {
    const cell = th.s5 - 4;
    const rr = ukRect(rx - cell + th.s1, y + (hh - cell) / 2, cell, cell);
    if (insIconBtn(mut ui, th, mut st, "fxreset", rr, INS_I_RESET, isz, th.text3, "この効果を既定に戻す")) {
      insFxReset(mut ui, m, f, mut st, mut evs);
    }
    rx = rr.x - th.s1;
  }
  // 名前（番号つき）と .mzc のキー。見出しは Tab で選べ、Enter で開閉、Alt+↑↓ で並べ替え、右クリックでメニュー
  const nm = `${i + 1} ${f.ja}`;
  const hdr = ukRect(cx, y, rx - cx, hh);
  const hid = ukId(ui, "fxhead");
  const hh2 = insB(mut ui, mut st, hid, hdr, true, false);
  if (hh2.focused) {
    if (ukKeyTake(mut ui, UK_KEY_ENTER) || ukKeyTake(mut ui, UK_KEY_SPACE)) {
      insFxToggleOpen(mut ui, f, open);
    }
    if (canEdit) {
      const mu = ukKeyTakeMods(mut ui, UK_KEY_UP);
      const md = ukKeyTakeMods(mut ui, UK_KEY_DOWN);
      if (mu >= 0 && (mu & UK_MOD_ALT) != 0 && i > 0) {
        insFxMove(m, f, i, i - 1, mut evs);
      } else if (md >= 0 && (md & UK_MOD_ALT) != 0) {
        insFxMove(m, f, i, i + 1, mut evs);
      }
    }
  }
  if (hh2.clicked) {
    insFxToggleOpen(mut ui, f, open);
  }
  if (hh2.hover) {
    st.hoverKey = f.name.clone();
  }
  if (hh2.focused && ui.focusVisible) {
    insFocusRing(mut ui, th, ukRect(hdr.x - th.s1, hdr.y + 3, hdr.w + th.s1, hdr.h - 6));
  }
  const pid = ukId(ui, "fxmenu");
  if (hh2.rclicked) {
    ukOpenPopup(mut ui, pid, ui.inp.mx, ui.inp.my);
  }
  if (insBeginPop(mut ui, th, pid, th.s5 * 8)) {
    const pw = th.s5 * 8;
    const n = m.fx.length;
    let ot = "開く";
    if (open) {
      ot = "閉じる";
    }
    let et = "有効にする";
    if (en) {
      et = "無効にする";
    }
    const a = insMenuItem(mut ui, th, "open", ot, "Enter", false, false, pw);
    if (a.clicked) {
      insFxToggleOpen(mut ui, f, open);
    }
    if (canEdit) {
      insMenuSep(mut ui, th, pw);
      const up = insMenuItem(mut ui, th, "up", "上へ", "Alt+↑", false, false, pw);
      const dn = insMenuItem(mut ui, th, "down", "下へ", "Alt+↓", false, false, pw);
      const ed = insMenuItem(mut ui, th, "enable", et, "", false, false, pw);
      if (up.clicked && i > 0) {
        insFxMove(m, f, i, i - 1, mut evs);
      }
      if (dn.clicked && i + 1 < n) {
        insFxMove(m, f, i, i + 1, mut evs);
      }
      if (ed.clicked) {
        insFxEnable(m, f, mut evs);
      }
    }
    if (modified) {
      const rs = insMenuItem(mut ui, th, "reset", "既定に戻す", "", false, false, pw);
      if (rs.clicked) {
        insFxReset(mut ui, m, f, mut st, mut evs);
      }
    }
    ukEndPopup(mut ui);
  }
  let nw = 0;
  if (en) {
    nw = insBoldAt(mut ui, cx, ym, nm, th.fsSm, nameC);
  } else {
    nw = insTextAt(mut ui, cx, ym, nm, th.fsSm, nameC);
  }
  cx = cx + nw + th.s2;
  const kw = insTextAt(mut ui, cx, ym, f.name, th.fsXs, th.text3);
  cx = cx + kw;
  insIconAt(mut ui, chx, ym, isz, open ? INS_I_CHEV_D : INS_I_CHEV_R, th.text3);
  if (!en) {
    const tw = ukTextW(mut ui, "無効", th.fsXs);
    insTextAt(mut ui, rx - tw, ym, "無効", th.fsXs, th.text2);
  } else if (open) {
    if (f.origin != "") {
      const ow = ukTextW(mut ui, f.origin, th.fsXs) + th.s2 * 2 - 2;
      const orr = ukRect(rx - ow, ym - (th.s4 + 2) / 2, ow, th.s4 + 2);
      if (orr.x > cx + th.s2) {
        ukDrawRound(mut ui, orr, th.rSm, th.bg3);
        ukDrawTextIn(mut ui, orr, f.origin, th.fsXs, th.text2, 1);
      }
    }
  } else if (fxParamCount(f.effect) > 0) {
    const r0 = insFxRow(m, f, 0);
    let vs = "—";
    if (!r0.mixed) {
      vs = insValueText(m, r0, r0.v);
    }
    const tw = ukTextW(mut ui, vs, th.fsXs);
    insTextAt(mut ui, rx - tw, ym, vs, th.fsXs, r0.modified && !r0.mixed ? th.accentHover : th.text2);
  }
  y = y + hh;
  if (open) {
    for (let k = 0; k < fxParamCount(f.effect); k++) {
      ukPushId(mut ui, fxParamName(f.effect, k));
      const r = insFxRow(m, f, k);
      y = y + insDrawRow(mut ui, th, m, r, mut st, mut evs, x, y, w);
      ukPopId(mut ui);
    }
  }
  return y - y0;
}

// ［効果を足す］と、効果の一覧（検索の欄つき）。xr は右端、ym は縦の中央。
// 開くと検索の欄にフォーカスが入り、↑↓ で選び Enter で足す。Esc で閉じてボタンに戻る。
// 一覧の高さは右の列（insDraw の r）の下の端までに収め、あふれた分はスクロールする。
function insAddFxButton(ui: mut UkCtx, th: InsTheme, m: InsModel, st: mut InsState, evs: mut InsEvent[], xr: i32, ym: i32): void {
  const label = "効果を足す";
  const isz = th.iconSm * 3 / 4;
  const bw = th.s2 + isz + th.s1 + 2 + ukTextW(mut ui, label, th.fsSm) + th.s2;
  const br = ukRect(xr - bw, ym - th.btnSm / 2, bw, th.btnSm);
  const id = ukId(ui, "addfx");
  const h = insB(mut ui, mut st, id, br, true, true);
  if (h.hover) {
    ukDrawRound(mut ui, br, th.rMd, th.bg3);
  }
  const c = h.hover ? th.text1 : th.text2;
  insIconAt(mut ui, br.x + th.s2, ym, isz, INS_I_PLUS, c);
  insTextAt(mut ui, br.x + th.s2 + isz + th.s1 + 2, ym, label, th.fsSm, c);
  if (h.focused && ui.focusVisible) {
    insFocusRing(mut ui, th, br);
  }
  const pid = ukId(ui, "addfxpop");
  const pw = th.s5 * 9;
  const py = br.y + br.h + 2;
  if (h.clicked && m.fxAudio && m.mode != INS_M_MULTI) {
    // 音のクリップ: 音の効果は、呼ぶ側の音の効果の一覧（編集画面の左の欄の「音」）から足す
    evs.push(insEvent(INS_E_AUDIO_FX, "", ""));
  } else if (h.clicked) {
    st.addFilter = "";
    st.addSel = 0;
    st.addScroll = 0;
    st.addFocus = true;
    ukOpenPopup(mut ui, pid, br.x + br.w - pw, py);
  }
  if (!insBeginPop(mut ui, th, pid, pw)) {
    return;
  }
  const iw = pw - th.s2;
  // 一覧に出す効果
  let names: string[] = [];
  let have: bool[] = [];
  for (const nm of insFxCatalogFor(m)) {
    const ja = insFxJa(nm);
    if (st.addFilter != "" && !insContains(nm, st.addFilter) && !insContains(ja, st.addFilter)) {
      continue;
    }
    let hv = false;
    for (const f of m.fx) {
      if (f.name == nm) {
        hv = true;
      }
    }
    names.push(nm.clone());
    have.push(hv);
  }
  const n = names.length as i32;
  // 検索の欄（開いたときにフォーカスを入れる）。↑↓・Enter・Esc は欄より先に取る
  const sfid = ukId(ui, "効果を探す##fxsearch");
  if (st.addFocus) {
    ukFocus(mut ui, sfid, true);
    st.addFocus = false;
  }
  let pick: i32 = -1;
  if (ui.focus == sfid) {
    if (ukKeyTake(mut ui, UK_KEY_ESC)) {
      ukClosePopups(mut ui);
      ukFocus(mut ui, id, true);
    }
    if (ukKeyTake(mut ui, UK_KEY_DOWN)) {
      st.addSel = Math.min(st.addSel + 1, Math.max(n - 1, 0));
    }
    if (ukKeyTake(mut ui, UK_KEY_UP)) {
      st.addSel = Math.max(st.addSel - 1, 0);
    }
  }
  if (!m.fxAudio) {
    const before = st.addFilter.clone();
    st.addFilter = ukTextField(mut ui, "効果を探す##fxsearch", before);
    const submitted = ui.lastSubmit;
    if (st.addFilter != before) {
      st.addSel = 0;
      st.addScroll = 0;
    }
    if (submitted && st.addSel >= 0 && st.addSel < n) {
      pick = st.addSel;
    }
  } else if (ukKeyTake(mut ui, UK_KEY_ESC)) {
    ukClosePopups(mut ui);
    ukFocus(mut ui, id, true);
  }
  if (m.fxAudio) {
    const r = ukNext(mut ui, iw, th.row);
    let msg = "音の効果は、音のクリップだけを選んで足します";
    if (m.mode == INS_M_MULTI) {
      msg = "音のクリップには映像の効果を足せません";
    }
    ukDrawTextIn(mut ui, ukRect(r.x + th.s2, r.y, r.w - th.s2, r.h), msg, th.fsSm, th.text2, 0);
  } else if (n == 0) {
    const r = ukNext(mut ui, iw, th.row);
    ukDrawTextIn(mut ui, ukRect(r.x + th.s2, r.y, r.w - th.s2, r.h), "見つかりません", th.fsSm, th.text2, 0);
  } else {
    // 一覧（高さは右の列の下の端まで）
    const itemH = th.row;
    const top = py + th.s1 + th.row + th.s2;
    const avail = st.panelBottom - top - th.s2;
    const rows = Math.min(Math.max(avail / itemH, 3), n);
    const lr = ukNext(mut ui, iw, rows * itemH);
    const maxS = Math.max(n * itemH - lr.h, 0);
    if (ukMouseIn(ui, lr) && ui.inp.wheelY != 0) {
      st.addScroll = st.addScroll - ui.inp.wheelY * itemH;
    }
    // キーで選んだ項目が見えるように
    const sy0 = st.addSel * itemH;
    if (sy0 < st.addScroll) {
      st.addScroll = sy0;
    } else if (sy0 + itemH > st.addScroll + lr.h) {
      st.addScroll = sy0 + itemH - lr.h;
    }
    st.addScroll = Math.min(Math.max(st.addScroll, 0), maxS);
    ukPushClip(mut ui, lr);
    for (let i: i32 = 0; i < n; i++) {
      const iy = lr.y + i * itemH - st.addScroll;
      if (iy + itemH <= lr.y || iy >= lr.y + lr.h) {
        continue;
      }
      const ir = ukRect(lr.x, iy, lr.w, itemH);
      const nm = names[i as usize].clone();
      ukPushId(mut ui, nm);
      const iid = ukId(ui, "add");
      ukPopId(mut ui);
      let ih = ukBehavior(mut ui, iid, ir, false);
      if (ui.popupFrame == ui.frame) {
        ih.clicked = false;
      }
      if (i == st.addSel || ih.hover) {
        ukDrawRound(mut ui, ir, th.rSm, th.accentTint);
      }
      const ja = insFxJa(nm);
      const hv = have[i as usize];
      const tc = hv ? th.textDis : th.text1;
      const tx = ir.x + th.s2;
      const jw = insTextAt(mut ui, tx, ir.y + itemH / 2, ja, th.fsMd, tc);
      insTextAt(mut ui, tx + jw + th.s2, ir.y + itemH / 2, nm, th.fsXs, hv ? th.textDis : th.text3);
      if (hv) {
        const uw = ukTextW(mut ui, "使用中", th.fsXs);
        insTextAt(mut ui, ir.x + ir.w - th.s2 - uw, ir.y + itemH / 2, "使用中", th.fsXs, th.text2);
      }
      if (ih.clicked) {
        pick = i;
      }
    }
    ukPopClip(mut ui);
    if (maxS > 0) {
      const bh = Math.max(lr.h * lr.h / (n * itemH), th.s4);
      const by = lr.y + (lr.h - bh) * st.addScroll / maxS;
      ukDrawRound(mut ui, ukRect(lr.x + lr.w - 3, by, 3, bh), 1, th.bg4);
    }
  }
  if (pick >= 0 && pick < n && !have[pick as usize]) {
    const nm = names[pick as usize].clone();
    const fk = fxFindKey(nm);
    const dv = insNumText(fxParamDefault(fk.effect, 0) as f64, 4);
    insPushSet(mut evs, INS_E_SET, nm, insSetOps(m, nm, dv));
    insFlash(mut st, nm, ui.now);
    ukClosePopups(mut ui);
    ukFocus(mut ui, id, ui.focusVisible);
  }
  ukEndPopup(mut ui);
}

function insContains(s: string, q: string): bool {
  if (q.length == 0) {
    return true;
  }
  if (q.length > s.length) {
    return false;
  }
  for (let i: usize = 0; i + q.length <= s.length; i++) {
    let ok = true;
    for (let j: usize = 0; j < q.length; j++) {
      if (s[i + j] != q[j]) {
        ok = false;
        break;
      }
    }
    if (ok) {
      return true;
    }
  }
  return false;
}

// ---- テキストで見る（.mzc の行をトークンごとに） ----

export struct InsMzcTok {
  text: string;
  // 0 語（行の頭・フラグ）、1 文字列、2 key=value、3 注釈
  kind: i32;
  key: string;
}

// 行をトークンに分ける（空白で区切る。"..." の中の空白と、# から後ろの注釈はひとまとまり）。
export function insMzcTokens(line: string): InsMzcTok[] {
  let out: InsMzcTok[] = [];
  let i: usize = 0;
  while (i < line.length) {
    while (i < line.length && (line[i] == 32 || line[i] == 9)) {
      i++;
    }
    if (i >= line.length) {
      break;
    }
    const a = i;
    if (line[i] == 35) {
      out.push({ text: ukSub(line, a, line.length), kind: 3, key: "" });
      break;
    }
    let inQ = false;
    let eq: i32 = -1;
    while (i < line.length) {
      const c = line[i];
      if (c == 34) {
        inQ = !inQ;
      } else if (c == 92 && inQ) {
        i++;
      } else if (!inQ && (c == 32 || c == 9)) {
        break;
      } else if (!inQ && c == 61 && eq < 0) {
        eq = (i - a) as i32;
      }
      i++;
    }
    const tok = ukSub(line, a, Math.min(i, line.length));
    if (tok.length > 0 && tok[0] == 34) {
      out.push({ text: tok, kind: 1, key: "" });
    } else if (eq > 0) {
      out.push({ text: tok.clone(), kind: 2, key: ukSub(tok, 0, eq as usize) });
    } else {
      out.push({ text: tok.clone(), kind: 0, key: tok.clone() });
    }
  }
  return out;
}

// トークンのキーと、値の欄のキーが同じものか（効果の key と key.param、x と y の組も）。
function insKeyMatch(tokKey: string, rowKey: string): bool {
  if (rowKey == "" || tokKey == "") {
    return false;
  }
  if (tokKey == rowKey) {
    return true;
  }
  if (rowKey == "outlinew" && tokKey == "outline") {
    return true;
  }
  // 効果の別名（saturation= と sat、sat.amount）
  const a = fxFindKey(tokKey);
  if (a.effect >= 0) {
    const b = fxFindKey(rowKey);
    return b.effect == a.effect && b.param == a.param;
  }
  return false;
}

function insTokCopy(t: InsMzcTok): InsMzcTok {
  return { text: t.text.clone(), kind: t.kind, key: t.key.clone() };
}

// 表示だけ: 「−」（U+2212）を半角の「-」に（和文のフォントで全角になって間が空くため。.mzc の文字は変えない）。
function insShowMinus(s: string): string {
  let b: u8[] = [];
  let i: usize = 0;
  let any = false;
  while (i < s.length) {
    if (i + 2 < s.length && s[i] == 0xe2 && s[i + 1] == 0x88 && s[i + 2] == 0x92) {
      b.push(45);
      i += 3;
      any = true;
    } else {
      b.push(s[i]);
      i++;
    }
  }
  if (!any) {
    return s.clone();
  }
  return stringFromBytes(b);
}

function insDrawMzc(ui: mut UkCtx, th: InsTheme, m: InsModel, st: mut InsState, evs: mut InsEvent[], x: i32, y0: i32, w: i32, border: bool): i32 {
  let y = y0;
  if (border) {
    insHLine(mut ui, th, x, y, w);
  }
  y = y + 10 * th.s1 / 4;
  const lx = x + th.s3;
  const rw = w - th.s3 * 2;
  if (m.mzcHead) {
    const hm = y + th.lhSm / 2;
    insBoldAt(mut ui, lx, hm, "テキストで見る", th.fsSm, th.text1);
    const lk = "テキストで開く Ctrl+E";
    const lw = ukTextW(mut ui, lk, th.fsXs);
    const lr = ukRect(lx + rw - lw, y, lw, th.lhSm);
    const id = ukId(ui, "opensrc");
    const h = insB(mut ui, mut st, id, lr, true, true);
    insTextAt(mut ui, lr.x, hm, lk, th.fsXs, h.hover ? th.text1 : th.accentHover);
    if (h.focused && ui.focusVisible) {
      insFocusRing(mut ui, th, lr);
    }
    if (h.clicked) {
      let e = insEvent(INS_E_OPEN_LINE, "", "");
      e.line = m.line;
      evs.push(e);
    }
    y = y + th.lhSm + th.s1 + 2;
  }
  // 箱（等幅 12px の code。ui.md 7.5・tokens の font.size.code）
  const pad = th.s2;
  const fs = th.fsCode;
  const lh = th.lhCode;
  const toks = insMzcTokens(m.mzc);
  // トークンの幅は行と大きさが変わったときだけ測り直す
  const tkey = `${fs}|` + m.mzc;
  if (st.tokLine != tkey) {
    st.tokLine = tkey;
    st.tokW.clear();
    for (const t of toks) {
      st.tokW.push(ukTextW(mut ui, insShowMinus(t.text), fs));
    }
    st.tokW.push(Math.max(ukTextW(mut ui, "a a", fs) - ukTextW(mut ui, "aa", fs), 3));
  }
  const sp = st.tokW[toks.length];
  // 1 回目: 行の数を数える
  let lines = 1;
  let cx = 0;
  const innerW = rw - pad * 2 - th.hair * 2;
  for (let k: usize = 0; k < toks.length; k++) {
    const tw = st.tokW[k];
    if (cx > 0 && cx + tw > innerW) {
      lines++;
      cx = 0;
    }
    cx = cx + tw + sp;
  }
  const bh = lines * lh + pad * 2;
  const br = ukRect(lx, y, rw, bh);
  ukDrawRound(mut ui, br, th.rSm, th.bg0);
  ukDrawStroke(mut ui, br, th.rSm, th.hair, th.line);
  const flashOn = st.flashKey != "" && ui.now - st.flashT < th.changeHighlight;
  if (flashOn) {
    ui.wantFrame = true;
  }
  let tx = br.x + pad + th.hair;
  let ty = br.y + pad;
  cx = 0;
  for (let i: usize = 0; i < toks.length; i++) {
    const t = insTokCopy(toks[i]);
    const tw = st.tokW[i];
    if (cx > 0 && cx + tw > innerW) {
      cx = 0;
      ty = ty + lh;
    }
    const px = tx + cx;
    const tr = ukRect(px, ty, tw, lh);
    // トークンにホバー → 同じキーの値の欄を光らせる（次のフレーム）
    if (t.kind == 2 && ukMouseIn(ui, tr)) {
      st.tokKeyNext = t.key.clone();
    }
    const hl = t.kind == 2 && (insKeyMatch(t.key, st.hoverKey) || st.tokKey == t.key) || t.kind == 0 && i > 0 && insKeyMatch(t.key, st.hoverKey);
    const fl = flashOn && (t.kind == 2 || t.kind == 0) && insKeyMatch(t.key, st.flashKey);
    if (fl) {
      ukDrawRect(mut ui, ukRect(px - 1, ty, tw + 2, lh), ukAlpha(th.ok, 46));
    } else if (hl) {
      ukDrawRect(mut ui, ukRect(px - 1, ty, tw + 2, lh), th.accentTint);
      ukDrawRect(mut ui, ukRect(px, ty + lh - 3, tw, th.hair), th.text1);
    }
    const ym = ty + lh / 2;
    const shown = insShowMinus(t.text);
    if (t.kind == 3) {
      insTextAt(mut ui, px, ym, shown, fs, th.text3);
    } else if (t.kind == 1) {
      insTextAt(mut ui, px, ym, shown, fs, th.textSource);
    } else if (t.kind == 2) {
      const kc = fl ? th.ok : th.accentHover;
      const vc = fl ? th.ok : (hl ? th.text1 : th.text2);
      const kw = ukTextW(mut ui, t.key, fs);
      insTextAt(mut ui, px, ym, t.key, fs, kc);
      insTextAt(mut ui, px + kw, ym, ukSub(shown, t.key.length, shown.length), fs, vc);
    } else {
      insTextAt(mut ui, px, ym, shown, fs, fl ? th.ok : th.accentHover);
    }
    cx = cx + tw + sp;
  }
  y = br.y + bh;
  if (m.mzcNote != "") {
    y = y + th.s1 + 2;
    insTextAt(mut ui, lx, y + th.lhSm / 2, m.mzcNote, th.fsXs, th.text2);
    y = y + th.lhSm;
  }
  y = y + th.s3;
  return y - y0;
}

// 囲みの知らせ（ロック中など）と、複数を選んだときの知らせ。
function insNote(ui: mut UkCtx, th: InsTheme, st: mut InsState, text: string, x: i32, y: i32, w: i32, bg: u32, tc: u32, icon: i32): i32 {
  const isz = th.iconSm * 3 / 4;
  const padX = icon != 0 ? th.s2 : 10 * th.s1 / 4;
  const padY = icon != 0 ? th.s1 + 2 : th.s2;
  const lhh = icon != 0 ? th.lhSm : th.lhMd;
  const tx = x + padX + (icon != 0 ? isz + th.s1 + 2 : 0);
  const lines = insWrap(mut ui, mut st, text, th.fsSm, x + w - padX - tx);
  const h = (lines.length as i32) * lhh + padY * 2;
  ukDrawRound(mut ui, ukRect(x, y, w, h), th.rMd, bg);
  if (icon != 0) {
    insIconAt(mut ui, x + padX, y + padY + lhh / 2, isz, icon, tc);
  }
  let ly = y + padY;
  for (const ln of lines) {
    insTextAt(mut ui, tx, ly + lhh / 2, ln, th.fsSm, tc);
    ly = ly + lhh;
  }
  return h;
}

// ---- 全体 ----

// インスペクタを r に描き、このフレームのイベントを返す。
export function insDraw(ui: mut UkCtx, th: InsTheme, m: InsModel, st: mut InsState, r: UkRect): InsEvent[] {
  let evs: InsEvent[] = [];
  // 選択が変わった: 打ち込み中の値は、打ち始めたときの宛先で確定する（新しく選んだクリップには書かない）
  if (st.editId != 0 && insSig(m) != st.editSig) {
    insFlushEdit(mut ui, th, mut st, mut evs);
  }
  st.editSeen = false;
  st.focusHas = false;
  st.panelBottom = r.y + r.h;
  st.hoverKey = "";
  st.tokKey = st.tokKeyNext.clone();
  st.tokKeyNext = "";
  st.fxY.clear();
  for (const v of st.fxYNext) {
    st.fxY.push(v);
  }
  ukDrawRect(mut ui, r, th.bg1);
  ukPushId(mut ui, "inspector");
  // スクロール
  const sid = ukId(ui, "scroll");
  const ssi = ukSt(mut ui, sid);
  if (ukMouseIn(ui, r) && ui.inp.wheelY != 0) {
    ui.st[ssi].f[0] = ui.st[ssi].f[0] - (ui.inp.wheelY * th.row * 2) as f32;
  }
  const maxS = Math.max(ui.st[ssi].i[0] - r.h, 0);
  ui.st[ssi].f[0] = Math.min(Math.max(ui.st[ssi].f[0], 0.0), maxS as f32);
  const sy = Math.floor(ui.st[ssi].f[0]) as i32;
  ukPushClip(mut ui, r);
  const x = r.x;
  const w = r.w;
  let y = r.y - sy;
  y = y + insDrawHead(mut ui, th, m, mut st, mut evs, x, y, w);
  if (m.notice != "") {
    y = y + th.s2;
    y = y + insNote(mut ui, th, mut st, m.notice, x + th.s3, y, w - th.s3 * 2, th.bg2, th.text2, m.noticeLock ? INS_I_LOCK : 0);
    y = y + th.s2;
  }
  const nsec = m.sections.length;
  for (let s: usize = 0; s < nsec; s++) {
    // 節の ID は名前で（開閉の状態が、選んだものの種類によって別の節へ移らないように）
    ukPushId(mut ui, m.sections[s].title);
    const isLast = s + 1 == nsec && !m.fxShow && m.mzc == "" && m.emptyHint == "" && m.multiNote == "";
    const hh = th.s5 + th.s1 + 2;
    const open = insSecHead(mut ui, th, mut st, m.sections[s].title, x, y, w, 0);
    if (m.sections[s].reset) {
      const isz = th.iconSm * 3 / 4;
      let any = false;
      let keys: string[] = [];
      for (const rw of m.sections[s].rows) {
        if (rw.key != "" && !rw.readOnly) {
          keys.push(rw.key.clone());
        }
        any = any || rw.modified;
      }
      const ops = insUnsetOps(m, keys);
      const br = ukRect(x + w - th.s2 - th.s5 + 4, y + 3, th.s5 - 4, hh - 6);
      if (insIconBtn(mut ui, th, mut st, "secreset", br, INS_I_RESET, isz, th.text3, "この節を既定に戻す") && (any || ops.length > 0)) {
        if (ops.length > 0) {
          insPushSet(mut evs, INS_E_SET, "", ops);
        }
      }
    }
    y = y + hh;
    if (open) {
      for (let k: usize = 0; k < m.sections[s].rows.length; k++) {
        // 行の ID はキーと名前で（節の中の位置が変わっても、別の行の状態を引き継がない）
        ukPushId(mut ui, m.sections[s].rows[k].key + "|" + m.sections[s].rows[k].label);
        y = y + insDrawRow(mut ui, th, m, m.sections[s].rows[k], mut st, mut evs, x, y, w);
        ukPopId(mut ui);
      }
      if (m.sections[s].title == "クリップ" && m.refBy.length > 0) {
        y = y + insDrawRefBy(mut ui, th, m, mut st, mut evs, x, y, w);
      }
      y = y + 2;
    }
    if (!isLast) {
      insHLine(mut ui, th, x, y, w);
      y = y + th.hair;
    }
    ukPopId(mut ui);
  }
  if (m.fxShow) {
    const lastFx = m.multiNote == "";
    y = y + insDrawFx(mut ui, th, m, mut st, mut evs, x, y, w, lastFx || m.mzc != "");
  }
  if (m.multiNote != "") {
    y = y + 10 * th.s1 / 4;
    y = y + insNote(mut ui, th, mut st, m.multiNote, x + th.s3, y, w - th.s3 * 2, th.accentTint, th.text1, 0);
    y = y + 10 * th.s1 / 4;
  }
  if (m.mzc != "" && m.mzcShow) {
    y = y + insDrawMzc(mut ui, th, m, mut st, mut evs, x, y, w, m.fxShow || m.mode == INS_M_CLIP && m.kind != KIND_TEXT);
  }
  if (m.emptyHint != "") {
    const ih = th.iconSm + th.s1;
    const ty = y + 28 * th.s1 / 4;
    insIconAt(mut ui, x + w / 2 - ih / 2, ty + ih / 2, ih, INS_I_SELECT, th.text3);
    const ly = ty + ih + th.s2;
    ukDrawTextIn(mut ui, ukRect(x + th.s4, ly, w - th.s4 * 2, th.lhMd), m.emptyHint, th.fsMd, th.text2, 1);
    y = ly + th.lhMd + 28 * th.s1 / 4;
  }
  ukPopClip(mut ui);
  // 打ち込み中の欄が描かれなかった（節を畳んだ・行が消えた）: 打ち始めたときの宛先で確定する
  if (st.editId != 0 && !st.editSeen) {
    insFlushEdit(mut ui, th, mut st, mut evs);
  }
  const ch = y + sy - r.y;
  if (ui.st[ssi].i[0] != ch) {
    ui.wantFrame = true;
  }
  ui.st[ssi].i[0] = ch;
  // キーボードでフォーカスを移した部品が見えない所にあれば、見える所までスクロールする（次のフレーム）
  if (st.focusHas && ui.focus != st.focusShown) {
    st.focusShown = ui.focus;
    if (ui.focusVisible) {
      const fr = st.focusRect;
      const mg = th.s2;
      if (fr.y < r.y + mg) {
        ui.st[ssi].f[0] = ui.st[ssi].f[0] - ((r.y + mg - fr.y) as f32);
        ui.wantFrame = true;
      } else if (fr.y + fr.h > r.y + r.h - mg) {
        ui.st[ssi].f[0] = ui.st[ssi].f[0] + ((fr.y + fr.h - (r.y + r.h - mg)) as f32);
        ui.wantFrame = true;
      }
    }
  }
  // スクロールバー（中身があふれるときだけ）。つまみをドラッグでき、溝を押すとそこへ
  if (ch > r.h) {
    const bw = th.s1 + 2;
    const bh = Math.max(r.h * r.h / ch, th.s5);
    const by = r.y + (r.h - bh) * sy / Math.max(ch - r.h, 1);
    const track = ukRect(r.x + r.w - bw - 4, r.y, bw + 4, r.h);
    const bid = ukId(ui, "scrollbar");
    const bh2 = ukBehavior(mut ui, bid, track, false);
    const range = Math.max(ch - r.h, 1);
    const travel = Math.max(r.h - bh, 1);
    if (bh2.pressed) {
      if (ui.inp.my < by || ui.inp.my >= by + bh) {
        // 溝を押した: つまみの真ん中をそこへ
        const ns = ((ui.inp.my - r.y - bh / 2) * range / travel) as f32;
        ui.st[ssi].f[0] = Math.min(Math.max(ns, 0.0), range as f32);
      }
      st.barY0 = ui.inp.my;
      st.barS0 = ui.st[ssi].f[0];
      ui.wantFrame = true;
    } else if (bh2.held) {
      const ns = st.barS0 + (((ui.inp.my - st.barY0) * range / travel) as f32);
      ui.st[ssi].f[0] = Math.min(Math.max(ns, 0.0), range as f32);
      ui.wantFrame = true;
    }
    const hot = bh2.hover || bh2.held;
    ukDrawRound(mut ui, ukRect(r.x + r.w - bw - 2, by, bw, bh), bw / 2, hot ? th.text3 : th.bg4);
  }
  ukPopId(mut ui);
  return evs;
}

// 中身の高さ（前のフレームに描いたもの）。ホストがパネルの大きさを決めるときに使う。
export function insContentH(ui: mut UkCtx): i32 {
  ukPushId(mut ui, "inspector");
  const sid = ukId(ui, "scroll");
  ukPopId(mut ui);
  const si = ukSt(mut ui, sid);
  return ui.st[si].i[0];
}
