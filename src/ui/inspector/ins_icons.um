// インスペクタで使うアイコン（モックアップの SVG の symbol と同じ 16×16 の線の絵）。
// uikit の icons.um に同じものが入ったら置き換える（アイコンのフォントの作業）。
import { UkRect } from "../kit/base.um";
import { UkCtx, ukDrawLine, ukDrawTri, ukDrawCircle, ukDrawStroke, ukDrawRound } from "../kit/core.um";

export const INS_I_MEDIA: i32 = 1;
export const INS_I_TEXT: i32 = 2;
export const INS_I_AUDIO: i32 = 3;
export const INS_I_GRID: i32 = 4;
export const INS_I_FILE: i32 = 5;
export const INS_I_COPY: i32 = 6;
export const INS_I_CHEV_D: i32 = 7;
export const INS_I_CHEV_R: i32 = 8;
export const INS_I_CHEV_L: i32 = 9;
export const INS_I_KF: i32 = 10;
export const INS_I_KF_ON: i32 = 11;
export const INS_I_RESET: i32 = 12;
export const INS_I_PLUS: i32 = 13;
export const INS_I_LINK: i32 = 14;
export const INS_I_LOCK: i32 = 15;
export const INS_I_SELECT: i32 = 16;
export const INS_I_IMAGE: i32 = 17;
export const INS_I_COLOR: i32 = 18;
export const INS_I_SEARCH: i32 = 19;

// 16 の格子の (x, y) を四角の中の画素へ。
function insIX(r: UkRect, x: f32): f32 {
  return (r.x as f32) + x * (r.w as f32) / 16.0;
}

function insIY(r: UkRect, y: f32): f32 {
  return (r.y as f32) + y * (r.h as f32) / 16.0;
}

function insL(ui: mut UkCtx, r: UkRect, ax: f32, ay: f32, bx: f32, by: f32, t: f32, c: u32): void {
  ukDrawLine(mut ui, insIX(r, ax), insIY(r, ay), insIX(r, bx), insIY(r, by), t, c);
}

// 折れ線（xs, ys の点を順につなぐ）。
function insPoly(ui: mut UkCtx, r: UkRect, pts: f32[], t: f32, c: u32): void {
  let i: usize = 0;
  while (i + 3 < pts.length) {
    insL(mut ui, r, pts[i], pts[i + 1], pts[i + 2], pts[i + 3], t, c);
    i += 2;
  }
}

// 円弧（中心 cx, cy、半径 rr、角度 a0〜a1 は度。時計回り＝画面の y 下向き）。
function insArc(ui: mut UkCtx, r: UkRect, cx: f32, cy: f32, rr: f32, a0: f32, a1: f32, t: f32, c: u32): void {
  const n = 14;
  let px: f32 = 0.0;
  let py: f32 = 0.0;
  for (let i = 0; i <= n; i++) {
    const a = (a0 + (a1 - a0) * (i as f32) / (n as f32)) * 0.017453292;
    // sin / cos が無いので多項式で近似する
    const x = cx + rr * insCos(a);
    const y = cy + rr * insSin(a);
    if (i > 0) {
      insL(mut ui, r, px, py, x, y, t, c);
    }
    px = x;
    py = y;
  }
}

function insAngWrap(a0: f32): f32 {
  let a = a0;
  const TAU: f32 = 6.2831853;
  while (a > 3.1415927) {
    a = a - TAU;
  }
  while (a < -3.1415927) {
    a = a + TAU;
  }
  return a;
}

function insSin(a0: f32): f32 {
  const a = insAngWrap(a0);
  const a2 = a * a;
  return a * (1.0 - a2 / 6.0 * (1.0 - a2 / 20.0 * (1.0 - a2 / 42.0 * (1.0 - a2 / 72.0))));
}

function insCos(a: f32): f32 {
  return insSin(a + 1.5707963);
}

// アイコンを四角 r（正方形）に描く。
export function insIcon(ui: mut UkCtx, r: UkRect, icon: i32, c: u32): void {
  const t = Math.max((r.w as f32) * 0.085, 1.15);
  if (icon == INS_I_MEDIA) {
    ukDrawStroke(mut ui, { x: insIX(r, 2.0) as i32, y: insIY(r, 3.0) as i32, w: (r.w * 12) / 16, h: (r.h * 10) / 16 }, 2, Math.max(t as i32, 1), c);
    ukDrawTri(mut ui, insIX(r, 7.0), insIY(r, 6.0), insIX(r, 7.0), insIY(r, 10.0), insIX(r, 10.4), insIY(r, 8.0), c);
  } else if (icon == INS_I_TEXT) {
    insPoly(mut ui, r, [3.0, 4.0, 3.0, 2.8, 13.0, 2.8, 13.0, 4.0], t, c);
    insL(mut ui, r, 8.0, 2.8, 8.0, 13.2, t, c);
    insL(mut ui, r, 6.0, 13.2, 10.0, 13.2, t, c);
  } else if (icon == INS_I_AUDIO) {
    insL(mut ui, r, 2.5, 6.5, 2.5, 9.5, t, c);
    insL(mut ui, r, 5.0, 4.5, 5.0, 11.5, t, c);
    insL(mut ui, r, 7.5, 2.5, 7.5, 13.5, t, c);
    insL(mut ui, r, 10.0, 5.0, 10.0, 11.0, t, c);
    insL(mut ui, r, 12.5, 7.0, 12.5, 9.0, t, c);
  } else if (icon == INS_I_GRID) {
    const q = (r.w * 5) / 16;
    const ti = Math.max(t as i32, 1);
    ukDrawStroke(mut ui, { x: insIX(r, 2.5) as i32, y: insIY(r, 2.5) as i32, w: q, h: q }, 1, ti, c);
    ukDrawStroke(mut ui, { x: insIX(r, 9.0) as i32, y: insIY(r, 2.5) as i32, w: q, h: q }, 1, ti, c);
    ukDrawStroke(mut ui, { x: insIX(r, 2.5) as i32, y: insIY(r, 9.0) as i32, w: q, h: q }, 1, ti, c);
    ukDrawStroke(mut ui, { x: insIX(r, 9.0) as i32, y: insIY(r, 9.0) as i32, w: q, h: q }, 1, ti, c);
  } else if (icon == INS_I_FILE) {
    insPoly(mut ui, r, [4.0, 1.8, 9.0, 1.8, 12.0, 4.8, 12.0, 14.2, 4.0, 14.2, 4.0, 1.8], t, c);
    insPoly(mut ui, r, [9.0, 1.8, 9.0, 4.8, 12.0, 4.8], t, c);
  } else if (icon == INS_I_COPY) {
    ukDrawStroke(mut ui, { x: insIX(r, 5.0) as i32, y: insIY(r, 5.0) as i32, w: (r.w * 9) / 16, h: (r.h * 9) / 16 }, 1, Math.max(t as i32, 1), c);
    insPoly(mut ui, r, [3.0, 10.5, 3.0, 2.5, 10.5, 2.5], t, c);
  } else if (icon == INS_I_CHEV_D) {
    insPoly(mut ui, r, [4.5, 6.0, 8.0, 9.5, 11.5, 6.0], t, c);
  } else if (icon == INS_I_CHEV_R) {
    insPoly(mut ui, r, [6.0, 4.5, 9.5, 8.0, 6.0, 11.5], t, c);
  } else if (icon == INS_I_CHEV_L) {
    insPoly(mut ui, r, [10.0, 4.0, 6.0, 8.0, 10.0, 12.0], t, c);
  } else if (icon == INS_I_KF) {
    insPoly(mut ui, r, [8.0, 3.5, 12.5, 8.0, 8.0, 12.5, 3.5, 8.0, 8.0, 3.5], t, c);
  } else if (icon == INS_I_KF_ON) {
    ukDrawTri(mut ui, insIX(r, 8.0), insIY(r, 3.2), insIX(r, 12.8), insIY(r, 8.0), insIX(r, 3.2), insIY(r, 8.0), c);
    ukDrawTri(mut ui, insIX(r, 3.2), insIY(r, 8.0), insIX(r, 12.8), insIY(r, 8.0), insIX(r, 8.0), insIY(r, 12.8), c);
  } else if (icon == INS_I_RESET) {
    insArc(mut ui, r, 8.0, 8.0, 5.0, 180.0, 495.0, t, c);
    insPoly(mut ui, r, [3.0, 2.5, 3.0, 5.0, 5.5, 5.0], t, c);
  } else if (icon == INS_I_PLUS) {
    insL(mut ui, r, 8.0, 3.0, 8.0, 13.0, t, c);
    insL(mut ui, r, 3.0, 8.0, 13.0, 8.0, t, c);
  } else if (icon == INS_I_LINK) {
    insL(mut ui, r, 6.5, 9.5, 9.5, 6.5, t, c);
    insArc(mut ui, r, 10.4, 5.6, 2.4, 135.0, 405.0, t, c);
    insArc(mut ui, r, 5.6, 10.4, 2.4, -45.0, 225.0, t, c);
  } else if (icon == INS_I_LOCK) {
    ukDrawStroke(mut ui, { x: insIX(r, 3.5) as i32, y: insIY(r, 7.0) as i32, w: (r.w * 9) / 16, h: (r.h * 13) / 32 }, 1, Math.max(t as i32, 1), c);
    insArc(mut ui, r, 8.0, 5.0, 2.5, 180.0, 360.0, t, c);
    insL(mut ui, r, 5.5, 5.0, 5.5, 7.0, t, c);
    insL(mut ui, r, 10.5, 5.0, 10.5, 7.0, t, c);
  } else if (icon == INS_I_SELECT) {
    insPoly(mut ui, r, [4.0, 2.5, 12.0, 8.0, 8.4, 8.8, 10.6, 13.0, 9.1, 13.7, 7.0, 9.5, 4.0, 12.0, 4.0, 2.5], t, c);
  } else if (icon == INS_I_IMAGE) {
    ukDrawStroke(mut ui, { x: insIX(r, 2.0) as i32, y: insIY(r, 3.0) as i32, w: (r.w * 12) / 16, h: (r.h * 10) / 16 }, 2, Math.max(t as i32, 1), c);
    insPoly(mut ui, r, [2.5, 12.0, 6.5, 8.0, 9.5, 11.0, 11.5, 9.0, 14.0, 11.5], t, c);
    ukDrawCircle(mut ui, insIX(r, 6.0), insIY(r, 6.5), (r.w as f32) * 1.2 / 16.0, t, c);
  } else if (icon == INS_I_COLOR) {
    ukDrawRound(mut ui, { x: insIX(r, 2.5) as i32, y: insIY(r, 2.5) as i32, w: (r.w * 11) / 16, h: (r.h * 11) / 16 }, 2, c);
  } else if (icon == INS_I_SEARCH) {
    ukDrawCircle(mut ui, insIX(r, 7.0), insIY(r, 7.0), (r.w as f32) * 4.0 / 16.0, t, c);
    insL(mut ui, r, 10.0, 10.0, 13.5, 13.5, t, c);
  }
}
