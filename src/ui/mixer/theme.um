// ミキサーのテーマ: docs/design/tokens.json の値（色・文字・余白・寸法）を、ミキサーが使う形にまとめる。
// 色や大きさをコードに直接書かない。tokens.json の道筋（"color.dark.meter.low" など）で引き、
// 読めない値は uikit のテーマ（UkTheme）の近い値で代わりにする。
// uikit の ukThemeFromTokens は tokens.json の名前（bg.0 など）をまだ読めないので、ここで仮に読む（uikit に足すべきもの）。
import { UkTheme, ukParseHex } from "../kit/theme.um";

// tokens.json を平らにした 1 つの値（道筋は "." でつなぐ。配列の要素は "[]"）。
export struct MxTok {
  path: string;
  val: string;
  isStr: bool;
}

export struct MxTheme {
  scale: f32;
  // ---- 色（0xAARRGGBB） ----
  bg0: u32;
  bg1: u32;
  bg2: u32;
  bg3: u32;
  bg4: u32;
  line: u32;
  lineStrong: u32;
  lineControl: u32;   // 操作できる部品の縁・目盛りの短い線（line.control）
  text1: u32;
  text2: u32;
  text3: u32;
  textOff: u32;
  onLight: u32;
  onDark: u32;
  accent: u32;
  accentHover: u32;
  accentTint: u32;
  accentTintSolid: u32;
  ripple: u32;
  ok: u32;
  warn: u32;
  error: u32;
  focusOuter: u32;
  meterLow: u32;
  meterMid: u32;
  meterHigh: u32;
  audioMark: u32;
  audioFace: u32;
  // ---- 文字の大きさ（倍率を掛けた画素） ----
  fsXs: f32;
  fsSm: f32;
  fsMd: f32;
  fsLg: f32;
  fsTcM: f32;
  fsTcXL: f32;
  fsCode: f32;
  // ---- 寸法（倍率を掛けた画素） ----
  s1: i32;
  s2: i32;
  s3: i32;
  s4: i32;
  s5: i32;
  s6: i32;
  panelHeader: i32;
  row: i32;
  field: i32;
  btnSm: i32;
  iconSm: i32;
  hitMin: i32;
  meterW: i32;
  scrollW: i32;
  rightW: i32;      // 右の列の既定の幅（size.panelDefault.right。ラウドネスと詳しい表示の列に使う）
  rSm: i32;
  rMd: i32;
  rLg: i32;
  hair: i32;
  focusW: i32;
  // メーターの目盛り（dBFS。tokens の meter.ticksDb）。色の境目は ticks[1]（low→mid）と ticks[2]（mid→high）
  ticks: f64[];
  // 小さなメーター（タイムラインの右・音のワークスペース）の下の端（tokens の meter.floorDb）。縦の位置は floorDb〜0 で dB に比例
  floorDb: f64;
}

// ---- tokens.json を平らにする ----

function mxWs(s: string, i0: usize): usize {
  let i = i0;
  while (i < s.length && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) {
    i++;
  }
  return i;
}

function mxStr(s: string, i0: usize, end: mut usize[]): string {
  let out: u8[] = [];
  let i = i0 + 1;
  while (i < s.length && s[i] != 34) {
    if (s[i] == 92 && i + 1 < s.length) {
      i++;
    }
    out.push(s[i]);
    i++;
  }
  end[0] = i + 1;
  return stringFromBytes(out);
}

function mxJoin(path: string[]): string {
  let out = "";
  for (let i: usize = 0; i < path.length; i++) {
    if (i > 0) {
      out = out + ".";
    }
    out = out + path[i];
  }
  return out;
}

// JSON を (道筋, 値) の並びにする。読めなければ空。
export function mixerTokParse(json: string): MxTok[] {
  let toks: MxTok[] = [];
  let path: string[] = [];
  let isObj: bool[] = [];
  let pendingKey = false;
  let end: usize[] = [0];
  let i = mxWs(json, 0);
  while (i < json.length) {
    const b = json[i];
    if (b == 123) {
      isObj.push(true);
      path.push("");
      pendingKey = true;
      i++;
    } else if (b == 125 || b == 93) {
      if (isObj.length == 0) {
        return [];
      }
      isObj.pop();
      path.pop();
      i++;
    } else if (b == 91) {
      isObj.push(false);
      path.push("[]");
      i++;
    } else if (b == 44) {
      if (isObj.length > 0 && isObj[isObj.length - 1]) {
        pendingKey = true;
      }
      i++;
    } else if (b == 58) {
      pendingKey = false;
      i++;
    } else if (b == 34) {
      const str = mxStr(json, i, mut end);
      i = end[0];
      if (pendingKey && path.length > 0) {
        path[path.length - 1] = str;
        pendingKey = false;
      } else {
        toks.push({ path: mxJoin(path), val: str, isStr: true });
      }
    } else if ((b >= 48 && b <= 57) || b == 45) {
      let j = i;
      let out: u8[] = [];
      while (j < json.length && ((json[j] >= 48 && json[j] <= 57) || json[j] == 45 || json[j] == 46 || json[j] == 101 || json[j] == 69 || json[j] == 43)) {
        out.push(json[j]);
        j++;
      }
      toks.push({ path: mxJoin(path), val: stringFromBytes(out), isStr: false });
      i = j;
    } else {
      i++;
    }
  }
  return toks;
}

function mxFind(toks: MxTok[], path: string): i32 {
  for (let i: usize = 0; i < toks.length; i++) {
    if (toks[i].path == path) {
      return i as i32;
    }
  }
  return -1;
}

// 色を引く。なければ fallback。
export function mixerTokColor(toks: MxTok[], path: string, fallback: u32): u32 {
  const k = mxFind(toks, path);
  if (k < 0 || !toks[k as usize].isStr) {
    return fallback;
  }
  const c = ukParseHex(toks[k as usize].val);
  if (c < 0) {
    return fallback;
  }
  return c as u32;
}

function mxNum(s: string): f64 {
  let v: f64 = 0.0;
  let neg = false;
  let i: usize = 0;
  if (i < s.length && s[i] == 45) {
    neg = true;
    i++;
  }
  while (i < s.length && s[i] >= 48 && s[i] <= 57) {
    v = v * 10.0 + ((s[i] - 48) as f64);
    i++;
  }
  if (i < s.length && s[i] == 46) {
    i++;
    let f: f64 = 0.1;
    while (i < s.length && s[i] >= 48 && s[i] <= 57) {
      v = v + ((s[i] - 48) as f64) * f;
      f = f * 0.1;
      i++;
    }
  }
  return neg ? -v : v;
}

// 数を引く（倍率を掛ける前）。なければ fallback。
export function mixerTokNum(toks: MxTok[], path: string, fallback: f64): f64 {
  const k = mxFind(toks, path);
  if (k < 0 || toks[k as usize].isStr) {
    return fallback;
  }
  return mxNum(toks[k as usize].val);
}

// 配列の数を全部引く（"color.dark.meter.ticksDb" → [-60, -18, -6, 0]）。
export function mixerTokNums(toks: MxTok[], path: string): f64[] {
  let out: f64[] = [];
  const p = path + ".[]";
  for (const t of toks) {
    if (t.path == p && !t.isStr) {
      out.push(mxNum(t.val));
    }
  }
  return out;
}

function mxPx(v: f64, s: f32): i32 {
  return Math.max(Math.floor(v * (s as f64) + 0.5) as i32, 1);
}

// tokens.json（平らにしたもの）と uikit のテーマから、ミキサーのテーマを作る。
// scale は UI の倍率。線（hair）は round(倍率) の整数の画素にする（ui.md 20 章）。
export function mixerThemeFrom(toks: MxTok[], u: UkTheme, scale: f32): MxTheme {
  const c = "color.dark.";
  const s = scale;
  let ticks = mixerTokNums(toks, c + "meter.ticksDb");
  if (ticks.length < 4) {
    // tokens がないとき: uikit のテーマには目盛りがないので、ui.md 3.12 の 4 つを使う
    ticks = [-60.0, -18.0, -6.0, 0.0];
  }
  const fs = "font.size.";
  const sz = "size.";
  let t: MxTheme = {
    scale: s,
    bg0: mixerTokColor(toks, c + "bg.0", u.bg),
    bg1: mixerTokColor(toks, c + "bg.1", u.panel),
    bg2: mixerTokColor(toks, c + "bg.2", u.panelAlt),
    bg3: mixerTokColor(toks, c + "bg.3", u.raised),
    bg4: mixerTokColor(toks, c + "bg.4", u.raisedHover),
    line: mixerTokColor(toks, c + "line.default", u.border),
    lineStrong: mixerTokColor(toks, c + "line.strong", u.borderStrong),
    lineControl: mixerTokColor(toks, c + "line.control", u.borderStrong),
    text1: mixerTokColor(toks, c + "text.1", u.text),
    text2: mixerTokColor(toks, c + "text.2", u.textDim),
    text3: mixerTokColor(toks, c + "text.3", u.textDim),
    textOff: mixerTokColor(toks, c + "text.disabled", u.textOff),
    onLight: mixerTokColor(toks, c + "text.onLight", u.tipText),
    onDark: mixerTokColor(toks, c + "text.onDark", u.text),
    accent: mixerTokColor(toks, c + "accent.default", u.accent),
    accentHover: mixerTokColor(toks, c + "accent.hover", u.accentHover),
    accentTint: mixerTokColor(toks, c + "accent.tint", u.selection),
    accentTintSolid: mixerTokColor(toks, c + "accent.tintSolid", u.selection),
    ripple: mixerTokColor(toks, c + "semantic.ripple", u.warning),
    ok: mixerTokColor(toks, c + "semantic.ok", u.success),
    warn: mixerTokColor(toks, c + "semantic.warn", u.warning),
    error: mixerTokColor(toks, c + "semantic.error", u.danger),
    focusOuter: mixerTokColor(toks, c + "semantic.focusOuter", u.shadow),
    meterLow: mixerTokColor(toks, c + "meter.low", u.success),
    meterMid: mixerTokColor(toks, c + "meter.mid", u.warning),
    meterHigh: mixerTokColor(toks, c + "meter.high", u.danger),
    audioMark: mixerTokColor(toks, c + "clip.audio.mark", u.success),
    audioFace: mixerTokColor(toks, c + "clip.audio.face", u.raised),
    fsXs: (mixerTokNum(toks, fs + "xs.size", u.base[1] as f64) as f32) * s,
    fsSm: (mixerTokNum(toks, fs + "sm.size", u.base[0] as f64) as f32) * s,
    fsMd: (mixerTokNum(toks, fs + "md.size", u.base[0] as f64) as f32) * s,
    fsLg: (mixerTokNum(toks, fs + "lg.size", u.base[2] as f64) as f32) * s,
    fsTcM: (mixerTokNum(toks, fs + "tcM.size", u.base[2] as f64) as f32) * s,
    fsTcXL: (mixerTokNum(toks, fs + "tcXL.size", u.base[2] as f64) as f32) * s,
    fsCode: (mixerTokNum(toks, fs + "code.size", u.base[0] as f64) as f32) * s,
    s1: mxPx(mixerTokNum(toks, "space.1", u.base[6] as f64 * 0.5), s),
    s2: mxPx(mixerTokNum(toks, "space.2", u.base[6] as f64), s),
    s3: mxPx(mixerTokNum(toks, "space.3", u.base[5] as f64 * 1.5), s),
    s4: mxPx(mixerTokNum(toks, "space.4", u.base[5] as f64 * 2.0), s),
    s5: mxPx(mixerTokNum(toks, "space.5", u.base[5] as f64 * 3.0), s),
    s6: mxPx(mixerTokNum(toks, "space.6", u.base[5] as f64 * 4.0), s),
    panelHeader: mxPx(mixerTokNum(toks, sz + "panelHeader", u.base[12] as f64), s),
    row: mxPx(mixerTokNum(toks, sz + "propertyRow", u.base[12] as f64), s),
    field: mxPx(mixerTokNum(toks, sz + "field", u.base[4] as f64), s),
    btnSm: mxPx(mixerTokNum(toks, sz + "button.sm", u.base[13] as f64), s),
    iconSm: mxPx(mixerTokNum(toks, sz + "icon.sm", u.base[10] as f64), s),
    hitMin: mxPx(mixerTokNum(toks, sz + "hitTargetMin", u.base[13] as f64), s),
    meterW: mxPx(mixerTokNum(toks, sz + "meter", u.base[3] as f64), s),
    scrollW: mxPx(mixerTokNum(toks, sz + "scrollbar", u.base[11] as f64), s),
    rightW: mxPx(mixerTokNum(toks, sz + "panelDefault.right", u.base[3] as f64 * 12.0), s),
    rSm: mxPx(mixerTokNum(toks, "radius.sm", u.base[8] as f64), s),
    rMd: mxPx(mixerTokNum(toks, "radius.md", u.base[7] as f64), s),
    rLg: mxPx(mixerTokNum(toks, "radius.lg", u.base[7] as f64 * 1.6), s),
    hair: Math.max(Math.floor((mixerTokNum(toks, "border.hairline", 1.0) as f32) * s + 0.5) as i32, 1),
    focusW: mxPx(mixerTokNum(toks, "border.focus", 2.0), s),
    floorDb: mixerTokNum(toks, c + "meter.floorDb", ticks[0]),
    ticks,
  };
  return t;
}

// tokens.json の本文から（読めなければ uikit のテーマの値だけで）作る。
export function mixerThemeFromJson(json: string, u: UkTheme, scale: f32): MxTheme {
  const toks = mixerTokParse(json);
  return mixerThemeFrom(toks, u, scale);
}
