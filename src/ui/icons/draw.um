// アイコンを描く: src/gen/icons.um（tools/gen-icons.mjs が SVG から作る形）を、欲しい大きさの
// アンチエイリアスつきの被覆率の画像にして描く。倍率が変わったら、その大きさでラスタライズし直す（拡大した画像は使わない）。
//
//   let icons = icnCacheNew();                                       画像の置き場（ui の隣に 1 つ持ち、捨てない）
//   icnDraw(ui, icons, x, y, ICN_PLAY, sizePx, color)                uikit の文脈に描く（左上 (x, y)、sizePx 四方の画素）
//   icnDrawIn(ui, icons, r, ICN_PLAY, logical, color)                四角 r の中央に、論理 px × テーマの倍率で描く
//   icnDrawScaled(ui, icons, x, y, ICN_PLAY, logical, color, scale)  論理の大きさと倍率を別に渡す
//   icnDrawBuf(icons, px, W, H, x, y, id, sizePx, color)             uikit を使わずに Buffer<u32> へ直接描く
//   icnRaster(id, sizePx, weight, hint)                              被覆率の画像（0..255）を作るだけ
//
// 色は呼ぶ側がテーマから渡す（ui.theme.text・textDim・accent など）。大きさは論理の px（IcnSkin の iconSm など）。
// 描く場所では番号の定数 ICN_* を使う（icnId は文字列を比べるので、起動時や設定の読み込みのときだけ）。
//
// 線の描き方: 線 = 「太さの円をなぞった形」（端と角が丸の SVG の線と同じ形）。塗り = nonzero ／ evenodd。
// 1 画素を 4×4 点で調べ、各点では境までの距離で 1/4 画素の幅のなだらかな縁にする（16 段より細かい階調になる）。
// 線は塗りの上に重ね、要素どうしは「上に重ねる」で合わせる（1 色なので被覆率 1 枚で表せる）。
//
// 吸着（hint = true。ui.md §17.5「線 1.5（100% で 1px か 2px に吸着）」、§19「線は round(倍率) px」）:
// 線の太さを画素の整数 max(1, round(1.5 × S/16 × weight)) に丸め、水平・垂直の線は、太さが奇数なら画素の中心、
// 偶数なら画素の境に寄せる。塗りの水平・垂直の辺は画素の境に寄せる。寄せた座標のあいだの点は直線で補う
// （TrueType の IUP と同じ考え。曲線は形を保ったまま少し伸び縮みする）。アイコンごとの手の調整はしない。
// 既定（icnCacheNew）は weight ICN_HINT_WEIGHT（0.67）で、16 の格子のアイコンの線が §19 の round(倍率) px になる
// （100% 1px、125% 1px、150% 2px、200% 2px）。weight 1.0 なら round(1.5 × 倍率)（100% で 2px）。どちらにするかはデザインと決める。
import { icnGeom, ICN_NONE, ICN_PLAY, ICN_PAUSE, ICN_PLUS, ICN_MINUS, ICN_CLOSE, ICN_CHECK, ICN_CHEV_D, ICN_CHEV_R, ICN_CHEV_L, ICN_CHEV_U, ICN_SEARCH, ICN_BLADE, ICN_STEPB, ICN_STEPF, ICN_WARN, ICN_EYE, ICN_LOCK } from "../../gen/icons.um";
import { UkCtx, ukAlphaSet, ukAlphaHas, ukDrawAlpha } from "../kit/core.um";
import { UkRect, ukRect } from "../kit/base.um";
import { ukBlitAlpha } from "../kit/draw.um";

const ICN_SS: i32 = 4;

// 被覆率の画像（w × h、0..255）。
export struct IcnImg {
  w: i32;
  h: i32;
  a: u8[];
}

// 1 つの要素を画素の座標にしたもの（吸着の前）。
struct IcnRaw {
  fill: f32;
  // 線の太さ（画素。0 = 線なし）
  wpx: f32;
  sop: f32;
  rule: i32;
  // 点 [x, y, …]、部分ごとの始まり（点の番号）・点の数・閉じているか
  pts: f32[];
  starts: i32[];
  counts: i32[];
  closed: bool[];
}

// 描くための要素。線の区間と、塗りの区間（開いた部分も閉じて数える）。
struct IcnEl {
  fill: f32;
  hw: f32;
  // これより内側なら線の被覆は 1（距離の計算を打ち切る）
  inner: f32;
  sop: f32;
  rule: i32;
  // 区間 [ax, ay, bx, by] の並び
  ss: f32[];
  // 塗りの区間（内外の判定に使う、すべての辺）
  fs: f32[];
  // 塗りの境の区間（内外が変わる辺だけ。なだらかな縁はこの距離で付ける）
  fb: f32[];
  // 外形（線の太さと縁の分を足したもの）
  x0: f32;
  y0: f32;
  x1: f32;
  y1: f32;
}

function icnClamp01(v: f32): f32 {
  if (v < 0.0) {
    return 0.0;
  }
  if (v > 1.0) {
    return 1.0;
  }
  return v;
}

function icnAbs(v: f32): f32 {
  if (v < 0.0) {
    return -v;
  }
  return v;
}

function icnRound(v: f32): f32 {
  return Math.floor(v + 0.5);
}

function icnDistSeg(px: f32, py: f32, ax: f32, ay: f32, bx: f32, by: f32): f32 {
  const dx = bx - ax;
  const dy = by - ay;
  const l = dx * dx + dy * dy;
  let t: f32 = 0.0;
  if (l > 0.0) {
    t = icnClamp01(((px - ax) * dx + (py - ay) * dy) / l);
  }
  const ex = ax + dx * t - px;
  const ey = ay + dy * t - py;
  return Math.sqrt(ex * ex + ey * ey);
}

// 塗りの区間 fs で、点 (x, y) が内側か（rule 0 nonzero ／ 1 evenodd）。
function icnInside(fs: f32[], rule: i32, x: f32, y: f32): bool {
  let wn: i32 = 0;
  let cross: i32 = 0;
  let i: usize = 0;
  while (i < fs.length) {
    const ax = fs[i];
    const ay = fs[i + 1];
    const bx = fs[i + 2];
    const by = fs[i + 3];
    const side = (bx - ax) * (y - ay) - (x - ax) * (by - ay);
    if (ay <= y) {
      if (by > y && side > 0.0) {
        wn += 1;
        cross += 1;
      }
    } else if (by <= y && side < 0.0) {
      wn -= 1;
      cross += 1;
    }
    i += 4;
  }
  if (rule == 1) {
    return (cross % 2) == 1;
  }
  return wn != 0;
}

// ---- 吸着 ----

// 吸着の対応点（src → dst）を足す。同じ src（0.001 以内）がすでにあれば先のものを使う。
function icnAnchorAdd(src: mut f32[], dst: mut f32[], s: f32, d: f32): void {
  for (let i: usize = 0; i < src.length; i++) {
    if (icnAbs(src[i] - s) < 0.001) {
      return;
    }
  }
  src.push(s);
  dst.push(d);
}

// src の小さい順に並べる（dst も一緒に）。
function icnAnchorSort(src: mut f32[], dst: mut f32[]): void {
  for (let i: usize = 1; i < src.length; i++) {
    let j = i;
    while (j > 0 && src[j - 1] > src[j]) {
      const ts = src[j - 1];
      src[j - 1] = src[j];
      src[j] = ts;
      const td = dst[j - 1];
      dst[j - 1] = dst[j];
      dst[j] = td;
      j -= 1;
    }
  }
}

// 対応点のあいだを直線で補って、座標 v を写す（外側は端の対応点と同じだけずらす）。
function icnRemap(src: f32[], dst: f32[], v: f32): f32 {
  const n = src.length;
  if (n == 0) {
    return v;
  }
  if (v <= src[0]) {
    return v + dst[0] - src[0];
  }
  if (v >= src[n - 1]) {
    return v + dst[n - 1] - src[n - 1];
  }
  for (let i: usize = 1; i < n; i++) {
    if (v <= src[i]) {
      const t = (v - src[i - 1]) / (src[i] - src[i - 1]);
      return dst[i - 1] + (dst[i] - dst[i - 1]) * t;
    }
  }
  return v;
}

// 太さ w（整数の画素）の線の中心 c を寄せる先: 奇数なら画素の中心、偶数なら画素の境。
function icnSnapLine(c: f32, w: f32): f32 {
  const wi = Math.floor(w + 0.5) as i32;
  if ((wi % 2) == 1) {
    return Math.floor(c) + 0.5;
  }
  return icnRound(c);
}

// ---- 形を作る ----

// 形の並び（icnGeom）を、大きさ S 画素の要素の並びにする。weight は線の太さの倍率（1.0 で設計どおり）。
function icnBuild(id: i32, S: i32, weight: f32, hint: bool): IcnEl[] {
  const d = icnGeom(id);
  let els: IcnEl[] = [];
  if (d.length == 0) {
    return els;
  }
  const k = (S as f32) / 16.0;
  // 1. 画素の座標の要素にする
  let raws: IcnRaw[] = [];
  let p: usize = 0;
  const ne = d[p] as i32;
  p += 1;
  for (let e: i32 = 0; e < ne; e++) {
    const fill = d[p];
    const sw = d[p + 1];
    const sop = d[p + 2];
    const rule = d[p + 3] as i32;
    const nsub = d[p + 4] as i32;
    p += 5;
    let wpx = sw * k * weight;
    if (hint && sw > 0.0) {
      wpx = Math.max(icnRound(wpx), 1.0);
    }
    let pts: f32[] = [];
    let starts: i32[] = [];
    let counts: i32[] = [];
    let closed: bool[] = [];
    for (let s: i32 = 0; s < nsub; s++) {
      const cl = d[p] > 0.5;
      const n = d[p + 1] as usize;
      p += 2;
      starts.push((pts.length / 2) as i32);
      counts.push(n as i32);
      closed.push(cl);
      for (let i: usize = 0; i < n * 2; i++) {
        pts.push(d[p + i] * k);
      }
      p += n * 2;
    }
    raws.push({ fill, wpx, sop, rule, pts, starts, counts, closed });
  }
  // 2. 吸着: 水平・垂直の線と塗りの辺から、寄せる先を決める
  let axs: f32[] = [];
  let axd: f32[] = [];
  let ays: f32[] = [];
  let ayd: f32[] = [];
  if (hint) {
    for (let e: usize = 0; e < raws.length; e++) {
      const isLine = raws[e].wpx > 0.0;
      const isFill = raws[e].fill > 0.0;
      for (let s: usize = 0; s < raws[e].starts.length; s++) {
        const q = raws[e].starts[s] as usize;
        const n = raws[e].counts[s] as usize;
        if (n < 2) {
          continue;
        }
        let m = n - 1;
        if (raws[e].closed[s] || (isFill && !isLine)) {
          m = n;
        }
        for (let i: usize = 0; i < m; i++) {
          const j = (i + 1) % n;
          const ax = raws[e].pts[(q + i) * 2];
          const ay = raws[e].pts[(q + i) * 2 + 1];
          const bx = raws[e].pts[(q + j) * 2];
          const by = raws[e].pts[(q + j) * 2 + 1];
          const vert = icnAbs(ax - bx) < 0.0001 && icnAbs(ay - by) > 0.0001;
          const horz = icnAbs(ay - by) < 0.0001 && icnAbs(ax - bx) > 0.0001;
          if (vert) {
            if (isLine) {
              icnAnchorAdd(mut axs, mut axd, ax, icnSnapLine(ax, raws[e].wpx));
            } else {
              icnAnchorAdd(mut axs, mut axd, ax, icnRound(ax));
            }
          } else if (horz) {
            if (isLine) {
              icnAnchorAdd(mut ays, mut ayd, ay, icnSnapLine(ay, raws[e].wpx));
            } else {
              icnAnchorAdd(mut ays, mut ayd, ay, icnRound(ay));
            }
          }
        }
      }
    }
    icnAnchorSort(mut axs, mut axd);
    icnAnchorSort(mut ays, mut ayd);
  }
  // 3. 描くための区間にする
  for (let e: usize = 0; e < raws.length; e++) {
    const fill = raws[e].fill;
    const hw = raws[e].wpx * 0.5;
    let ss: f32[] = [];
    let fs: f32[] = [];
    let x0: f32 = 1.0e9;
    let y0: f32 = 1.0e9;
    let x1: f32 = -1.0e9;
    let y1: f32 = -1.0e9;
    for (let s: usize = 0; s < raws[e].starts.length; s++) {
      const q = raws[e].starts[s] as usize;
      const n = raws[e].counts[s] as usize;
      if (n == 0) {
        continue;
      }
      let xs: f32[] = [];
      let ys: f32[] = [];
      for (let i: usize = 0; i < n; i++) {
        const x = icnRemap(axs, axd, raws[e].pts[(q + i) * 2]);
        const y = icnRemap(ays, ayd, raws[e].pts[(q + i) * 2 + 1]);
        xs.push(x);
        ys.push(y);
        x0 = Math.min(x0, x);
        y0 = Math.min(y0, y);
        x1 = Math.max(x1, x);
        y1 = Math.max(y1, y);
      }
      // 線の区間（1 点だけなら長さ 0 の区間 = 丸い点）
      if (hw > 0.0) {
        if (n == 1) {
          ss.push(xs[0]);
          ss.push(ys[0]);
          ss.push(xs[0]);
          ss.push(ys[0]);
        }
        let m = n - 1;
        if (raws[e].closed[s]) {
          m = n;
        }
        for (let i: usize = 0; i < m; i++) {
          const j = (i + 1) % n;
          ss.push(xs[i]);
          ss.push(ys[i]);
          ss.push(xs[j]);
          ss.push(ys[j]);
        }
      }
      // 塗りの区間（いつも閉じる）
      if (fill > 0.0 && n >= 2) {
        for (let i: usize = 0; i < n; i++) {
          const j = (i + 1) % n;
          fs.push(xs[i]);
          fs.push(ys[i]);
          fs.push(xs[j]);
          fs.push(ys[j]);
        }
      }
    }
    // 塗りの境の辺: 辺の両側（1/4・1/2・3/4 の所で、法線の向きに少し離した点）の内外が違う辺だけ。
    // 1 つの要素の中の部分どうしが重なると、内側に入った辺は境でなくなる（そこに縁を付けると薄い筋になる）。
    let fb: f32[] = [];
    let i: usize = 0;
    while (i < fs.length) {
      const ax = fs[i];
      const ay = fs[i + 1];
      const bx = fs[i + 2];
      const by = fs[i + 3];
      const len = Math.sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay));
      if (len > 0.00001) {
        const nx = -(by - ay) / len * 0.02;
        const ny = (bx - ax) / len * 0.02;
        let edge = false;
        for (let t: i32 = 1; t <= 3; t++) {
          const f = (t as f32) * 0.25;
          const mx = ax + (bx - ax) * f;
          const my = ay + (by - ay) * f;
          if (icnInside(fs, raws[e].rule, mx + nx, my + ny) != icnInside(fs, raws[e].rule, mx - nx, my - ny)) {
            edge = true;
          }
        }
        if (edge) {
          fb.push(ax);
          fb.push(ay);
          fb.push(bx);
          fb.push(by);
        }
      }
      i += 4;
    }
    let grow: f32 = 1.0;
    if (hw > 0.0) {
      grow = hw + 1.0;
    }
    els.push({
      fill, hw, inner: hw - 0.5 / (ICN_SS as f32), sop: raws[e].sop, rule: raws[e].rule, ss, fs, fb,
      x0: x0 - grow, y0: y0 - grow, x1: x1 + grow, y1: y1 + grow,
    });
  }
  return els;
}

// 点 (x, y) の要素 e の被覆率（0..1）。edge は縁のなだらかさ（1 / 縁の幅の画素）。
function icnSampleEl(e: IcnEl, x: f32, y: f32, edge: f32): f32 {
  if (x < e.x0 || x > e.x1 || y < e.y0 || y > e.y1) {
    return 0.0;
  }
  let s: f32 = 0.0;
  if (e.ss.length > 0) {
    let dm: f32 = 1.0e9;
    let i: usize = 0;
    while (i < e.ss.length) {
      dm = Math.min(dm, icnDistSeg(x, y, e.ss[i], e.ss[i + 1], e.ss[i + 2], e.ss[i + 3]));
      if (dm <= e.inner) {
        break;
      }
      i += 4;
    }
    s = icnClamp01((e.hw - dm) * edge + 0.5) * e.sop;
    if (s >= 1.0) {
      return 1.0;
    }
  }
  let f: f32 = 0.0;
  if (e.fs.length > 0) {
    // 内外はすべての辺で、縁までの距離は境の辺だけで決める
    let dm: f32 = 1.0e9;
    let i: usize = 0;
    while (i < e.fb.length) {
      dm = Math.min(dm, icnDistSeg(x, y, e.fb[i], e.fb[i + 1], e.fb[i + 2], e.fb[i + 3]));
      i += 4;
    }
    let sd = -dm;
    if (icnInside(e.fs, e.rule, x, y)) {
      sd = dm;
    }
    f = icnClamp01(sd * edge + 0.5) * e.fill;
  }
  return s + f * (1.0 - s);
}

// アイコン id を S × S 画素の被覆率の画像にする。weight は線の太さの倍率（1.0 で設計どおり）、hint は吸着。
export function icnRaster(id: i32, S: i32, weight: f32, hint: bool): IcnImg {
  const n = Math.max(S, 0);
  let a = new Array<u8>((n * n) as usize);
  a.fill(0);
  const els = icnBuild(id, n, weight, hint);
  if (els.length == 0 || n == 0) {
    return { w: n, h: n, a };
  }
  // すべての要素の外形（この外の画素は調べない）
  let ux0: f32 = 1.0e9;
  let uy0: f32 = 1.0e9;
  let ux1: f32 = -1.0e9;
  let uy1: f32 = -1.0e9;
  for (let k: usize = 0; k < els.length; k++) {
    ux0 = Math.min(ux0, els[k].x0);
    uy0 = Math.min(uy0, els[k].y0);
    ux1 = Math.max(ux1, els[k].x1);
    uy1 = Math.max(uy1, els[k].y1);
  }
  const ss = ICN_SS;
  const inv = 1.0 / (ss as f32);
  const edge = ss as f32;
  for (let j: i32 = 0; j < n; j++) {
    if (((j + 1) as f32) < uy0 || (j as f32) > uy1) {
      continue;
    }
    for (let i: i32 = 0; i < n; i++) {
      if (((i + 1) as f32) < ux0 || (i as f32) > ux1) {
        continue;
      }
      let acc: f32 = 0.0;
      for (let sy: i32 = 0; sy < ss; sy++) {
        const y = (j as f32) + ((sy as f32) + 0.5) * inv;
        for (let sx: i32 = 0; sx < ss; sx++) {
          const x = (i as f32) + ((sx as f32) + 0.5) * inv;
          let A: f32 = 0.0;
          for (let k: usize = 0; k < els.length; k++) {
            const c = icnSampleEl(els[k], x, y, edge);
            A = A + c * (1.0 - A);
          }
          acc += A;
        }
      }
      const v = acc * inv * inv;
      a[(j * n + i) as usize] = (Math.floor(v * 255.0 + 0.5) as i32) as u8;
    }
  }
  return { w: n, h: n, a };
}

// 論理の大きさ × 倍率 → 画素（整数に丸め、最低 1）。
export function icnPx(logical: i32, scale: f32): i32 {
  return Math.max(Math.floor((logical as f32) * scale + 0.5) as i32, 1);
}

// ---- 画像の置き場 ----
//
// アイコンのラスタライズは文字より重いので、画像はこの置き場に持ち、捨てない（id × 大きさ。アイコン 74 個 ×
// 使う大きさの数だけなので小さい）。uikit に描くときは、ここから uikit の被覆率の画像の置き場（ukAlphaSet）へ
// 1 回だけ写す（ラスタライズし直さない）。

struct IcnEnt {
  key: i32;
  // uikit の被覆率の画像の置き場の鍵（番号・大きさ・吸着・太さを混ぜる。吸着の違う置き場から同じ ui に描いても重ならない）
  ukKey: u32;
  img: IcnImg;
}

export struct IcnCache {
  hint: bool;
  weight: f32;
  slots: i32[];
  ents: IcnEnt[];
  // ラスタライズした数（確かめ用）
  misses: i32;
}

const ICN_SLOTS: usize = 2048;
const ICN_ENT_MAX: usize = 1200;

// 吸着の既定の太さの倍率: 1.5 × 0.67 ≒ 1.0 なので、16 の格子では線が round(倍率) px（ui.md §19）になる。
export const ICN_HINT_WEIGHT: f32 = 0.67;

// 吸着あり・既定の太さの置き場。
export function icnCacheNew(): IcnCache {
  return icnCacheNewEx(true, ICN_HINT_WEIGHT);
}

// 吸着と線の太さの倍率を決めた置き場（見本の格子は吸着なしで元の SVG と比べる）。
export function icnCacheNewEx(hint: bool, weight: f32): IcnCache {
  let slots = new Array<i32>(ICN_SLOTS);
  slots.fill(-1);
  return { hint, weight, slots, ents: [], misses: 0 };
}

// 置き場の番号（無ければラスタライズして入れる）。
export function icnCacheGet(cache: mut IcnCache, id: i32, sizePx: i32): usize {
  const key = id * 4096 + sizePx;
  const mask = ICN_SLOTS - 1;
  let p = ((id * 131 + sizePx * 7) as usize) & mask;
  while (true) {
    const k = cache.slots[p];
    if (k < 0) {
      break;
    }
    if (cache.ents[k as usize].key == key) {
      return k as usize;
    }
    p = (p + 1) & mask;
  }
  if (cache.ents.length >= ICN_ENT_MAX) {
    // 大きさを何百種類も使ったときだけ（ふつうは起きない）
    cache.ents.clear();
    cache.slots.fill(-1);
    return icnCacheGet(mut cache, id, sizePx);
  }
  let h = 0;
  if (cache.hint) {
    h = 1;
  }
  const wq = Math.floor(cache.weight * 100.0 + 0.5) as i32;
  const ukKey = (key as u32) * 256 + ((h * 128 + (wq & 127)) as u32);
  cache.ents.push({ key, ukKey, img: icnRaster(id, sizePx, cache.weight, cache.hint) });
  cache.misses += 1;
  const idx = cache.ents.length - 1;
  cache.slots[p] = idx as i32;
  return idx;
}

// ---- uikit の文脈に描く ----

// uikit の被覆率の画像の命令（ukDrawAlpha）で描く。画像は最初に描くときだけ uikit の置き場に写す。
export function icnDraw(ui: mut UkCtx, cache: mut IcnCache, x: i32, y: i32, id: i32, sizePx: i32, color: u32): void {
  if (id < 0 || sizePx <= 0 || (color >> 24) == 0) {
    return;
  }
  const e = icnCacheGet(mut cache, id, sizePx);
  if (cache.ents[e].img.a.length == 0) {
    return;
  }
  const k = cache.ents[e].ukKey;
  if (!ukAlphaHas(ui, k)) {
    ukAlphaSet(mut ui, k, cache.ents[e].img.w, cache.ents[e].img.h, cache.ents[e].img.a);
  }
  ukDrawAlpha(mut ui, x, y, k, color);
}

// 論理の大きさ logical と倍率 scale で、左上 (x, y) に描く。
export function icnDrawScaled(ui: mut UkCtx, cache: mut IcnCache, x: i32, y: i32, id: i32, logical: i32, color: u32, scale: f32): void {
  icnDraw(mut ui, mut cache, x, y, id, icnPx(logical, scale), color);
}

// 四角 r の中央に、論理の大きさ logical × テーマの倍率で描く。
export function icnDrawIn(ui: mut UkCtx, cache: mut IcnCache, r: UkRect, id: i32, logical: i32, color: u32): void {
  const s = icnPx(logical, ui.theme.scale);
  icnDraw(mut ui, mut cache, r.x + (r.w - s) / 2, r.y + (r.h - s) / 2, id, s, color);
}

// ---- uikit を使わずに描く ----

// px（W × H、0xAARRGGBB）の左上 (x, y) に、sizePx 四方で描く。
export function icnDrawBuf(cache: mut IcnCache, px: mut Buffer<u32>, W: i32, H: i32, x: i32, y: i32, id: i32, sizePx: i32, color: u32): void {
  if (id < 0 || sizePx <= 0) {
    return;
  }
  const k = icnCacheGet(mut cache, id, sizePx);
  ukBlitAlpha(mut px, W, ukRect(0, 0, W, H), x, y, cache.ents[k].img.a, cache.ents[k].img.w, cache.ents[k].img.h, color);
}

// uikit の今のアイコンの番号（UK_I_*）から、デザインのアイコンの番号へ（対応がなければ ICN_NONE）。
// stop・menu・dot・info はデザインのアイコンにないので ICN_NONE（uikit の線の絵のまま描く）。
export function icnFromUk(i: i32): i32 {
  switch (i) {
    case 1: return ICN_PLAY;
    case 2: return ICN_PAUSE;
    case 4: return ICN_PLUS;
    case 5: return ICN_MINUS;
    case 6: return ICN_CLOSE;
    case 7: return ICN_CHECK;
    case 8: return ICN_CHEV_D;
    case 9: return ICN_CHEV_R;
    case 10: return ICN_CHEV_L;
    case 11: return ICN_CHEV_U;
    case 12: return ICN_SEARCH;
    case 13: return ICN_BLADE;
    case 14: return ICN_STEPB;
    case 15: return ICN_STEPF;
    case 19: return ICN_WARN;
    case 20: return ICN_EYE;
    case 21: return ICN_LOCK;
  }
  return ICN_NONE;
}
