// mozcut motion: 映像の中の 1 点を追い（src/m6_track/）、その動きを別のクリップの位置のキーフレーム（pos="x,y@t ..."）
// にして書く。追跡の結果をキーフレームにするので、あとは key の操作・グラフエディタ・ふつうの .mzc の編集で直せる。
//
//   mozcut motion <project.mzc> <cache> <追うクリップ> <x,y> --to <動かすクリップ> [--dry-run] [--json]
//
// - <x,y> は画面（キャンバス）の画素で、追うクリップの始まり（in）のコマの位置。
// - 動かすクリップの今の左上の位置を保ったまま、点と同じだけ動かす（最初のキーは今の位置）。キーは 1 コマに 1 つ。
// - 見失ったコマ（信頼度が低い・画面の外）は、追跡の部品と同じく最後の位置に止める。キーには信頼度を書かない。
// - 書き換えは op の set と同じ道（runOps）を通すので、誤りが増えるなら書かない。
import { parseNum, isNan, splitBy, textNum, splitLines } from "./text.um";
import { Project, Diag, Probe, parseProject, readProbes, findClip, clipPos, KIND_VIDEO, KIND_IMAGE, KIND_TEXT, KIND_COLOR, UNSET } from "./project.um";
import { Media, loadMedia, videoCachePath } from "./render.um";
import { textClipRect, newTextLayerCache } from "./textlayer.um";
import { projectFont } from "./ttf.um";
import { BatchResult, runOps } from "./ops.um";
import { jsonStr } from "./report.um";
import { trkOpenY4m } from "./m6_track/trk_y4m.um";
import { trkTrackVideo } from "./m6_track/trk_run.um";
import { trkDefaultOpts } from "./m6_track/trk_point.um";

struct MotionRect {
  ok: bool;
  x: i32;
  y: i32;
  w: i32;
  h: i32;
}

// クリップの層の左上と大きさ（キーフレームのない今の値で）。video / image は展開した素材、color は w / h、text は文字の箱。
function motionRect(p: Project, media: Media[], j: usize): MotionRect {
  const kind = p.clips[j].kind;
  const x = p.clips[j].x;
  const y = p.clips[j].y;
  const xa = p.clips[j].xAbs;
  const ya = p.clips[j].yAbs;
  if (kind == KIND_VIDEO || kind == KIND_IMAGE) {
    if (!media[j].ok) {
      return { ok: false, x: 0, y: 0, w: 0, h: 0 };
    }
    return { ok: true, x: clipPos(x, xa, media[j].w, p.width), y: clipPos(y, ya, media[j].h, p.height), w: media[j].w, h: media[j].h };
  }
  if (kind == KIND_COLOR) {
    let w = p.clips[j].w;
    let h = p.clips[j].h;
    if (w <= 0) {
      w = p.width;
    }
    if (h <= 0) {
      h = p.height;
    }
    return { ok: true, x: clipPos(x, xa, w, p.width), y: clipPos(y, ya, h, p.height), w, h };
  }
  if (kind == KIND_TEXT) {
    const font = projectFont(p.fontPath, p.fontIndex);
    let tc = newTextLayerCache();
    const r = textClipRect(p.clips[j], p, font, mut tc);
    return { ok: r.w > 0 && r.h > 0, x: r.x, y: r.y, w: r.w, h: r.h };
  }
  return { ok: false, x: 0, y: 0, w: 0, h: 0 };
}

function motionNum(v: f64): string {
  return textNum(Math.floor(v * 100 + 0.5) / 100);
}

function motionFail(json: bool, msg: string, hint: string, code: i32): i32 {
  if (json) {
    print(`{"ok":false,"error":${jsonStr(msg)},"hint":${jsonStr(hint)}}`);
  }
  eprint(`mozcut: ${msg}`);
  if (hint != "") {
    eprint(`  ヒント: ${hint}`);
  }
  return code;
}

// a = ["motion", project, cache, clip, "x,y", ...オプション]
export function cmdMotion(a: string[]): i32 {
  let json = false;
  let dry = false;
  let to = "";
  let words: string[] = [];
  let i: usize = 1;
  while (i < a.length) {
    if (a[i] == "--json") {
      json = true;
    } else if (a[i] == "--dry-run") {
      dry = true;
    } else if (a[i] == "--to" && i + 1 < a.length) {
      to = a[i + 1].clone();
      i++;
    } else {
      words.push(a[i].clone());
    }
    i++;
  }
  const usage = "motion <project.mzc> <cache> <追うクリップ> <x,y> --to <動かすクリップ> [--dry-run] [--json]（x,y は画面の画素）";
  if (words.length != 4 || to == "") {
    return motionFail(json, "motion には、プロジェクト・cache・追うクリップ・点（x,y）と --to <動かすクリップ> を渡します", usage, 2);
  }
  const path = words[0].clone();
  const cache = words[1].clone();
  const text = readFile(path);
  if (text == null) {
    return motionFail(json, `'${path}' を読めません`, "", 1);
  }
  const probes = readProbes(`${cache}/probe.txt`);
  let diags: Diag[] = [];
  const p = parseProject(text, probes, mut diags);
  const si = findClip(p, words[2]);
  if (si < 0 || p.clips[si as usize].kind != KIND_VIDEO) {
    return motionFail(json, `'${words[2]}' という映像のクリップはありません`, "追うのは video の行のクリップです（ID、#番号、@行番号で指す）", 1);
  }
  const ti = findClip(p, to);
  if (ti < 0) {
    return motionFail(json, `'${to}' というクリップはありません`, "--to には動かすクリップの ID、#番号、@行番号を書きます", 1);
  }
  const xy = splitBy(words[3], 44);
  if (xy.length != 2 || isNan(parseNum(xy[0])) || isNan(parseNum(xy[1]))) {
    return motionFail(json, `点 '${words[3]}' は x,y として読めません`, usage, 2);
  }
  const px = parseNum(xy[0]);
  const py = parseNum(xy[1]);
  const media = loadMedia(p, cache);
  const s = si as usize;
  const sr = motionRect(p, media, s);
  if (!sr.ok) {
    return motionFail(json, `追う映像 '${words[2]}' の展開した素材がありません`, "node tools/mozcut.mjs から実行すると、先に素材を展開します", 1);
  }
  const tr = motionRect(p, media, ti as usize);
  if (!tr.ok) {
    return motionFail(json, `動かすクリップ '${to}' の大きさが分かりません`, "video / image / color / text のクリップを指します（素材の展開が要ることもあります）", 1);
  }
  // 画面の点 → 展開した映像の画素
  const cx = px - (sr.x as f64);
  const cy = py - (sr.y as f64);
  const fps = (p.fpsNum as f64) / (p.fpsDen as f64);
  let base = p.clips[s].inPt;
  if (media[s].inPt != UNSET) {
    base = media[s].inPt;
  }
  const k0 = Math.max(Math.floor((p.clips[s].inPt - base) * fps + 0.000001), 0.0) as i64;
  const nf = Math.max(Math.floor(p.clips[s].dur * fps + 0.5), 1.0) as i64;
  const v = trkOpenY4m(videoCachePath(cache, s));
  const run = trkTrackVideo(v, [cx], [cy], trkDefaultOpts(), k0, k0 + nf - 1);
  if (!run.ok) {
    return motionFail(json, `追えません: ${run.err}`, "点は追う映像の中（その映像の始まりのコマ）に置きます", 1);
  }
  // 動かすクリップの左上 = 今の左上 + (点の位置 − 最初の点の位置)。時刻は動かすクリップの始まりからの秒
  const ox = (tr.x as f64) - px;
  const oy = (tr.y as f64) - py;
  let keys = "";
  let lost = 0;
  for (let f: i64 = 0; f < run.t.frames; f++) {
    const x = run.t.hx[f as usize] + (sr.x as f64) + ox;
    const y = run.t.hy[f as usize] + (sr.y as f64) + oy;
    if (run.t.hc[f as usize] < 0.5) {
      lost++;
    }
    const tt = p.clips[s].at + (f as f64) / fps - p.clips[ti as usize].at;
    if (keys != "") {
      keys = keys + " ";
    }
    keys = keys + `${motionNum(x)},${motionNum(y)}@${textNum(Math.floor(tt * 1000 + 0.5) / 1000)}`;
  }
  let lines = splitLines(text);
  let ops: string[][] = [];
  ops.push(["set", to.clone(), `pos=${keys}`]);
  const b = runOps(lines, probes, ops);
  let desc = `${to} の位置（pos）に、${words[2]} の点 (${motionNum(px)}, ${motionNum(py)}) を追った ${run.t.frames} コマのキーフレームを書きました`;
  if (lost > 0) {
    desc = desc + `（信頼度の低いコマが ${lost} 個あります。そのコマは最後の位置に止めています）`;
  }
  if (!b.ok) {
    let err = "";
    let hint = "";
    for (const r of b.results) {
      if (!r.ok && r.error != "") {
        err = r.error.clone();
        hint = r.hint.clone();
      }
    }
    return motionFail(json, `書けません: ${err}`, hint, 1);
  }
  let saved = false;
  if (!dry) {
    // 元のファイルが CRLF なら CRLF で書く（op と同じ）
    let crlf = false;
    for (let k: usize = 0; k + 1 < text.length; k++) {
      if (text[k] == 13 && text[k + 1] == 10) {
        crlf = true;
      }
    }
    let out: u8[] = [];
    for (const l of b.lines) {
      for (const c of l) {
        out.push(c);
      }
      if (crlf) {
        out.push(13);
      }
      out.push(10);
    }
    saved = writeFile(path, out);
  }
  if (json) {
    print(`{"ok":true,"saved":${saved},"frames":${run.t.frames},"lost":${lost},"desc":${jsonStr(desc)}}`);
  } else {
    print(desc);
    if (dry) {
      print("保存していません（--dry-run）");
    } else {
      print(`保存しました（${path}）`);
    }
  }
  return 0;
}
