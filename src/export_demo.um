// 書き出しの画面（src/ui_export/）の見本。mockups/export.html と同じ状態を、ダミーのデータで出す。
//
//   build/export-demo [--size 1440x900] [--scale 1.0] [--tokens docs/design/tokens.json] [--state 1|2]
//                     [--frames N] [--shot x.bmp] [--move x,y@F] [--click x,y@F] [--key K@F] [--name 名前]
//
// --key K@F: F コマ目にキー K（uikit の UK_KEY_* の番号。1 = Tab、6〜9 = 左右上下）を送る（キーボードの確かめ）
//
// --state 1: モックアップのとおり（YouTube 1080p、素材がないエラーと警告、待ち行列に実行中・待ち・完了）
// --state 2: SNS 縦を選んだ（プロジェクトとの食い違いの警告）、詳細を開いた、待ち行列に失敗と取りやめを含む
//
// 上の帯・レール・状態の帯は、見比べるための仮のもの（本物はほかの部品が描く）。
// そのため export.html の上の帯にある［✦ AI］の札・全画面のボタン・［書き出す…］のアイコン・プロジェクト名の省略と ▾ は
// 描いていない。編集画面と共通の上の帯の部品を作る段で、そちらに入れる。
import { UkCtx, ukNew, ukBegin, ukEnd, ukEventMouseMove, ukEventMouseButton, ukEventKey, ukToast, ukDrawRect, ukDrawRound, ukDrawTri, ukTextW, ukDrawTextIn } from "./uikit/core.um";
import { ukFormatTimecode, ukFpsInt } from "./uikit/widgets.um";
import { UkRect, ukRect, ukMix, ukShrink, ukAlpha } from "./uikit/base.um";
import { ukWinResNew, ukFeedWindowEvent } from "./uikit/window.um";
import { ukWriteBmp } from "./uikit/bmp.um";
import { uiFont } from "./ttf.um";
import { UeTheme, ueThemeFromTokens, ueUkTheme } from "./ui_export/theme.um";
import {
  UeState, UeEvent, UePreset, UeSeq, UeCheck, UeJob,
  UE_G_RECENT, UE_G_SHARE, UE_G_KEEP, UE_G_MINE, UE_PI_VIDEO, UE_PI_FILE, UE_PI_AUDIO, UE_PI_IMAGE,
  UE_R_ALL, UE_SUB_BURN, UE_J_WAIT, UE_J_RUN, UE_J_DONE, UE_J_FAIL, UE_J_CANCEL, UE_C_ERROR, UE_C_WARN,
  UE_EV_PRESET, UE_EV_EXPORT, UE_EV_ENQUEUE, UE_EV_JOB_CANCEL, UE_EV_JOB_RETRY, UE_EV_CHECK_ACTION, UE_EV_PICK_FOLDER,
  UE_EV_JOB_OPEN, UE_EV_JOB_PLAY, UE_EV_JOB_GOTO, UE_EV_JOB_COPY, UE_EV_SAVE_PRESET,
  ueStatusText, ueStatusName, ueStrsCopy, ueErrorCount, ueWarnCount, ueExt, ueSizeText, ueFpsText, ueKhzText,
} from "./ui_export/model.um";
import { UeLayout, ueLayout, ueWorkspace } from "./ui_export/panel.um";
import {
  UeCache, ueCacheNew, ueIconAt, ueText, ueTextR, ueSeg, ueSegW, ueSegH, ueBadge, ueButton, ueButtonW, UE_B_PRIMARY,
  UE_I_EXPORT, UE_I_WARN, UE_I_GEAR, UE_I_SEARCH, UE_I_UNDO, UE_I_REDO, UE_I_ERROR, UE_I_GPU,
} from "./ui_export/draw.um";

struct DemoEv {
  frame: i64;
  kind: i32;
  x: i32;
  y: i32;
}

function demoFind(s: string, b: u8): i32 {
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == b) {
      return i as i32;
    }
  }
  return -1;
}

function demoInt(s: string, a: usize, b: usize): i64 {
  let v: i64 = 0;
  for (let i = a; i < b && i < s.length; i++) {
    if (s[i] >= 48 && s[i] <= 57) {
      v = v * 10 + ((s[i] - 48) as i64);
    }
  }
  return v;
}

// "x,y@F"
function demoParseEv(opt: string, val: string, evs: mut DemoEv[]): bool {
  let kind = 0;
  if (opt == "--move") {
    kind = 1;
  } else if (opt == "--click") {
    kind = 2;
  } else if (opt == "--key") {
    const at0 = demoFind(val, 64);
    if (at0 < 0) {
      return false;
    }
    evs.push({ frame: demoInt(val, (at0 as usize) + 1, val.length), kind: 3, x: demoInt(val, 0, at0 as usize) as i32, y: 0 });
    return true;
  } else {
    return false;
  }
  const c = demoFind(val, 44);
  const at = demoFind(val, 64);
  if (c < 0 || at < 0) {
    return false;
  }
  evs.push({
    frame: demoInt(val, (at as usize) + 1, val.length), kind,
    x: demoInt(val, 0, c as usize) as i32, y: demoInt(val, (c as usize) + 1, at as usize) as i32,
  });
  return true;
}

// ---- ダミーのデータ ----

function demoPreset(id: string, name: string, detail: string, group: i32, icon: i32, ext: string, format: string,
                    w: i32, h: i32, fps: f64, vcodec: string, vrate: string, audio: string, kbps: i32, args: string): UePreset {
  return {
    id: id.clone(), name: name.clone(), detail: detail.clone(), group, icon, ext: ext.clone(), format: format.clone(),
    hasVideo: vcodec.length > 0, width: w, height: h, fps, videoCodec: vcodec.clone(), videoRate: vrate.clone(),
    audio: audio.clone(), color: "Rec.709（SDR）", totalKbps: kbps, projectArgs: args.clone(),
  };
}

function demoPresets(): UePreset[] {
  let out: UePreset[] = [];
  out.push(demoPreset("youtube-1080p", "YouTube 1080p", "H.264 · 1920×1080 · 30p", UE_G_RECENT, UE_PI_VIDEO, "mp4",
    "MP4 · H.264 · AAC", 1920, 1080, 60.0, "H.264 High", "12 Mbps", "AAC 320 kbps", 12320, "crf=18 preset=slow"));
  out.push(demoPreset("youtube-4k", "YouTube 4K", "H.264 · 3840×2160", UE_G_SHARE, UE_PI_VIDEO, "mp4",
    "MP4 · H.264 · AAC", 3840, 2160, 60.0, "H.264 High", "45 Mbps", "AAC 384 kbps", 45384, "crf=18 preset=slow"));
  out.push(demoPreset("sns-vertical", "SNS 縦", "H.264 · 1080×1920", UE_G_SHARE, UE_PI_VIDEO, "mp4",
    "MP4 · H.264 · AAC", 1080, 1920, 30.0, "H.264 High", "10 Mbps", "AAC 192 kbps", 10192, "crf=20"));
  out.push(demoPreset("prores-hq", "高画質のマスター", "ProRes 422 HQ", UE_G_KEEP, UE_PI_FILE, "mov",
    "MOV · ProRes 422 HQ · PCM", 0, 0, 0.0, "ProRes 422 HQ", "符号器が決める", "PCM 24 ビット", 0, ""));
  out.push(demoPreset("audio-wav", "音声だけ", "WAV · 48kHz · 24bit", UE_G_KEEP, UE_PI_AUDIO, "wav",
    "WAV · PCM 24 ビット", 0, 0, 0.0, "", "", "PCM 24 ビット", 2304, ""));
  out.push(demoPreset("still-png", "静止画（いまのコマ）", "PNG", UE_G_KEEP, UE_PI_IMAGE, "png",
    "PNG", 0, 0, 0.0, "PNG", "1 コマ", "", 0, ""));
  out.push(demoPreset("my-screening", "商店街の上映会用", "H.264 · 20 Mbps", UE_G_MINE, UE_PI_FILE, "mp4",
    "MP4 · H.264 · AAC", 1920, 1080, 30.0, "H.264 High", "20 Mbps", "AAC 320 kbps", 20320, "crf=16"));
  return out;
}

function demoSeq(): UeSeq {
  return {
    project: "谷中の豆腐店", name: "本編 v3", mzc: "本編_v3.mzc", width: 1920, height: 1080, fpsNum: 30, fpsDen: 1,
    audioRate: 48000, frames: 92 * 30, inFrame: 300, outFrame: 1199, selFrom: -1, selTo: -1, playhead: 55 * 30 + 10,
    hasSubtitles: true,
  };
}

function demoCheck(sev: i32, code: string, msg: string, loc: string, line: i32, actions: string[], ids: string[]): UeCheck {
  return { severity: sev, code: code.clone(), msg: msg.clone(), loc: loc.clone(), line, actions: ueStrsCopy(actions), actionIds: ueStrsCopy(ids) };
}

function demoJob(id: i32, name: string, state: i32, frac: f64, eta: string, info: string): UeJob {
  return {
    id, name: name.clone(), state, frac, eta: eta.clone(), info: info.clone(), failWhat: "", failWhere: "", failAt: "", failDetail: "",
  };
}

// 選んだプリセットとシーケンスの食い違い（presets.um の exportPresetCheck の文と同じ形。本物は link_m5.um で写す）
function demoMismatch(st: UeState, out: mut UeCheck[]): void {
  if (st.sel < 0) {
    return;
  }
  const k = st.sel as usize;
  if (!st.presets[k].hasVideo || st.presets[k].width <= 0) {
    return;
  }
  const pw = st.seq.width;
  const ph = st.seq.height;
  const w = st.presets[k].width;
  const h = st.presets[k].height;
  if (pw > ph && h > w) {
    // link_m5.um の ueCheckFromDiag と同じボタン（シーケンスの設定を開く・勧めるプリセットにする）
    out.push(demoCheck(UE_C_WARN, "preset-orientation",
      `プロジェクトは横の画面（${pw}x${ph}）ですが、'${st.presets[k].name}' は縦の画面（${w}x${h}）です。上下に大きな黒い帯が付きます`,
      "", 0, ["シーケンスの設定を開く", "YouTube 1080p にする"], ["open-sequence", "preset:youtube-1080p"]));
  } else if (w > pw + 1) {
    out.push(demoCheck(UE_C_WARN, "preset-upscale",
      `プロジェクト（${pw}x${ph}）を ${w}x${h} に拡大して書き出します。細かさは増えません`, "", 0, [], []));
  }
}

function demoChecks(st: UeState, missing: bool): UeCheck[] {
  let out: UeCheck[] = [];
  if (missing) {
    out.push(demoCheck(UE_C_ERROR, "missing-source",
      "店の奥.mp4 がありません。この素材を使う V2 のクリップ（00:01:04:00）を書き出せません。", "本編_v3.mzc:27", 27,
      ["場所を指定する", "そのクリップへ移る"], ["relink", "goto"]));
  }
  demoMismatch(st, mut out);
  out.push(demoCheck(UE_C_WARN, "bad-escape", "31 行目の文字に使えない記号 \\q があります。そのまま「\\q」と表示して書き出せます。", "本編_v3.mzc:31:22", 31, [], []));
  return out;
}

function demoState(which: i32): UeState {
  let st: UeState = {
    presets: demoPresets(), sel: 0, seq: demoSeq(), range: UE_R_ALL, fileName: "谷中の豆腐店_本編",
    folder: "D:\\映像\\谷中の豆腐店\\書き出し\\", baseDir: "D:\\映像\\谷中の豆腐店", subtitles: UE_SUB_BURN, detailsOpen: false, checks: [], checkSec: 0.08,
    checking: false, jobs: [], estSize: "", estTime: "約 1 分 10 秒", sideH: 0, leftH: 0,
  };
  if (which == 2) {
    st.sel = 2;
    st.detailsOpen = true;
    st.fileName = "谷中の豆腐店_15秒版";
    st.estTime = "約 25 秒";
    st.checks = demoChecks(st, false);
    st.jobs.push(demoJob(4, "谷中の豆腐店_本編.mp4", UE_J_RUN, 0.78, "0:21", "1920×1080 · YouTube 1080p"));
    let f = demoJob(3, "谷中の豆腐店_本編_マスター.mov", UE_J_FAIL, 0.0, "", "");
    f.failWhat = "00:00:48:12 まで書き出しました。";
    f.failWhere = "V2 のクリップ（00:01:04:00）で止まりました: 素材を読めません。";
    f.failAt = "00:01:04:00";
    f.failDetail = "{\"code\":\"render-failed\",\"clip\":\"v2_store\",\"at\":\"00:01:04:00\"}";
    st.jobs.push(f);
    st.jobs.push(demoJob(5, "谷中の豆腐店_予告_縦.mp4", UE_J_WAIT, 0.0, "", "1080×1920 · SNS 縦"));
    st.jobs.push(demoJob(2, "谷中の豆腐店_予告.mp4", UE_J_DONE, 1.0, "", "14:05 に終わりました · 0:30 · 48 MB"));
    st.jobs.push(demoJob(1, "谷中の豆腐店_試写.mp4", UE_J_CANCEL, 0.0, "", "13:52 に取りやめました · 12% まで"));
  } else {
    st.checks = demoChecks(st, true);
    st.jobs.push(demoJob(3, "谷中の豆腐店_15秒版.mp4", UE_J_RUN, 0.42, "0:12", "1080×1920 · SNS 縦"));
    st.jobs.push(demoJob(4, "谷中の豆腐店_本編_マスター.mov", UE_J_WAIT, 0.0, "", "ProRes 422 HQ"));
    st.jobs.push(demoJob(2, "谷中の豆腐店_予告.mp4", UE_J_DONE, 1.0, "", "14:05 に終わりました · 0:30 · 48 MB"));
  }
  return st;
}

// ---- 仮の上の帯・レール・状態の帯（本物はほかの部品） ----

// 見本の中だけで使う、倍率を掛けた画素（部品の外の仮の帯なので、モックアップの値をそのまま倍率で伸ばす）
function demoPx(t: UeTheme, v: i32): i32 {
  return Math.max(Math.floor((v as f32) * t.scale + 0.5) as i32, 1);
}

function demoTopBar(ui: mut UkCtx, t: UeTheme, W: i32): void {
  const h = t.topBar;
  ukDrawRect(mut ui, ukRect(0, 0, W, h - t.hairline), t.bg2);
  ukDrawRect(mut ui, ukRect(0, h - t.hairline, W, t.hairline), t.line);
  let x = t.s3;
  const lg = t.iconMd;
  ukDrawRound(mut ui, ukRect(x, (h - lg) / 2, lg, lg), t.rMd, t.accent);
  ukDrawRound(mut ui, ukShrink(ukRect(x, (h - lg) / 2, lg, lg), t.rMd), t.hairline * 2, t.bg2);
  x += lg + t.s2;
  const menu: string[] = ["ファイル", "編集", "クリップ", "シーケンス", "マーカー", "表示", "ヘルプ"];
  for (const m of menu) {
    x += t.s1 + t.s1 / 2;
    x += ueText(mut ui, x, 0, h, m, t.fsMd, t.text2) + t.s1 + t.s1 / 2;
  }
  x += t.s2;
  ukDrawRect(mut ui, ukRect(x, (h - t.iconMd) / 2, t.hairline, t.iconMd), t.lineStrong);
  x += t.s2 + t.s2;
  x += ueText(mut ui, x, 0, h, "谷中の豆腐店", t.fsMd, t.text1) + t.s1 + t.s1 / 2;
  x += ueText(mut ui, x, 0, h, "/", t.fsMd, t.text3) + t.s1 + t.s1 / 2;
  x += ueText(mut ui, x, 0, h, "本編 v3", t.fsMd, t.text1) + t.s2;
  const dot = demoPx(t, 7);
  ukDrawRound(mut ui, ukRect(x, (h - dot) / 2, dot, dot), dot / 2, t.ok);
  x += dot + t.s1 + t.s1 / 2;
  x += ueText(mut ui, x, 0, h, "保存済み 14:32", t.fsSm, t.text2) + t.s4;
  // ワークスペースの切り替え（いまのモックアップの名前）
  const items: string[] = ["カット編集", "色", "音", "出力"];
  const nodis: bool[] = [];
  const notips: string[] = [];
  ueSeg(mut ui, t, "demo.ws", x, (h - ueSegH(t)) / 2, items, 3, nodis, notips);
  // 右から: ［書き出す…］（いまは出力にいるので使えない）・やり直す・取り消す・探す
  let xr = W - t.s3;
  const bl = "書き出す…";
  const bw = ueButtonW(mut ui, t, bl, t.btnMd);
  ueButton(mut ui, t, "demo.export", bl, ukRect(xr - bw, (h - t.btnMd) / 2, bw, t.btnMd), UE_B_PRIMARY, true, "いま出力のワークスペースにいます");
  xr -= bw + t.s3;
  const ib = t.btnMd;
  ueIconAt(mut ui, xr - ib + (ib - t.iconSm) / 2, (h - t.iconSm) / 2, t.iconSm, UE_I_REDO, t.text2);
  xr -= ib + t.s1;
  ueIconAt(mut ui, xr - ib + (ib - t.iconSm) / 2, (h - t.iconSm) / 2, t.iconSm, UE_I_UNDO, t.text2);
  xr -= ib + t.s2;
  // 探す欄: アイコン・文・キーの札が重ならない幅にする
  const ph = "コマンドを探す…";
  const kl = "Ctrl K";
  const kw = ukTextW(mut ui, kl, t.fsXs) + t.s2 + t.s1;
  const kh = t.lhXs + t.s1;
  const sw = t.s3 + t.iconSm + t.s2 + ukTextW(mut ui, ph, t.fsSm) + t.s3 + kw + t.s2;
  const sr = ukRect(xr - sw, (h - t.btnMd) / 2, sw, t.btnMd);
  ukDrawRound(mut ui, sr, t.rMd, t.lineControl);
  ukDrawRound(mut ui, ukShrink(sr, t.hairline), t.rMd - t.hairline, t.bg1);
  ueIconAt(mut ui, sr.x + t.s3, sr.y + (sr.h - t.iconSm) / 2, t.iconSm, UE_I_SEARCH, t.text3);
  ueText(mut ui, sr.x + t.s3 + t.iconSm + t.s2, sr.y, sr.h, ph, t.fsSm, t.text3);
  const kr = ukRect(sr.x + sr.w - t.s2 - kw, sr.y + (sr.h - kh) / 2, kw, kh);
  ukDrawRound(mut ui, kr, t.rSm, t.lineControl);
  ukDrawRound(mut ui, ukShrink(kr, t.hairline), t.rSm - t.hairline, t.bg1);
  ukDrawTextIn(mut ui, kr, kl, t.fsXs, t.text2, 1);
}

// 左のレール（.rail .ri: 幅 rail、項目の高さ 48、ラベルは 11/13）
function demoRail(ui: mut UkCtx, t: UeTheme, y: i32, h: i32, nprob: i32, nerr: i32): void {
  const w = t.rail;
  ukDrawRect(mut ui, ukRect(0, y, w - t.hairline, h), t.bg2);
  ukDrawRect(mut ui, ukRect(w - t.hairline, y, t.hairline, h), t.line);
  const ih = w - t.s2;
  const lab = t.lhXs - t.hairline;
  const gap = demoPx(t, 3);
  const top = (ih - t.iconMd - gap - lab) / 2;
  let yy = y + t.s1 + t.s1 / 2;
  // 書き出し（選んでいる）
  ukDrawRect(mut ui, ukRect(0, yy + t.s2, t.selectionW, ih - t.s2 * 2), t.accent);
  ueIconAt(mut ui, (w - t.iconMd) / 2, yy + top, t.iconMd, UE_I_EXPORT, t.text1);
  const l1 = ukTextW(mut ui, "書き出し", t.fsXs);
  ueText(mut ui, (w - l1) / 2, yy + top + t.iconMd + gap, lab, "書き出し", t.fsXs, t.text1);
  yy += ih + t.s1 / 2;
  // 問題（札はエラーと警告の合計。エラーがあれば error の地）
  ueIconAt(mut ui, (w - t.iconMd) / 2, yy + top, t.iconMd, UE_I_ERROR, t.text3);
  const l2 = ukTextW(mut ui, "問題", t.fsXs);
  ueText(mut ui, (w - l2) / 2, yy + top + t.iconMd + gap, lab, "問題", t.fsXs, t.text3);
  if (nprob > 0) {
    let bg = t.warn;
    if (nerr > 0) {
      bg = t.error;
    }
    ueBadge(mut ui, t, w - demoPx(t, 9) - t.lhSm, yy + t.s1, `${nprob}`, bg, t.textOnError);
  }
  const yb = y + h - t.s1 - t.s1 / 2 - ih;
  ueIconAt(mut ui, (w - t.iconMd) / 2, yb + top, t.iconMd, UE_I_GEAR, t.text3);
  const l3 = ukTextW(mut ui, "設定", t.fsXs);
  ueText(mut ui, (w - l3) / 2, yb + top + t.iconMd + gap, lab, "設定", t.fsXs, t.text3);
}

function demoStatus(ui: mut UkCtx, t: UeTheme, st: UeState, W: i32, H: i32): void {
  const h = t.statusBar;
  const y = H - h;
  ukDrawRect(mut ui, ukRect(0, y, W, t.hairline), t.line);
  ukDrawRect(mut ui, ukRect(0, y + t.hairline, W, h - t.hairline), t.bg2);
  let x = t.s3;
  const msg = ueStatusText(st);
  if (msg.length > 0) {
    x += ueText(mut ui, x, y, h, msg, t.fsSm, t.text1) + t.s2;
    ueText(mut ui, x, y, h, ueStatusName(st), t.fsSm, t.text3);
  }
  let xr = W - t.s3;
  xr -= ueTextR(mut ui, xr, y, h, `${ueSizeText(st.seq.width, st.seq.height)} · ${ueFpsText(st.seq.fpsNum, st.seq.fpsDen)} · ${ueKhzText(st.seq.audioRate)}`, t.fsSm, t.text2) + t.s3;
  xr -= ueTextR(mut ui, xr, y, h, "GPU（wgpu）", t.fsSm, t.text2) + t.s1;
  const isz = t.iconSm * 3 / 4;
  ueIconAt(mut ui, xr - isz, y + (h - isz) / 2, isz, UE_I_GPU, t.text2);
  xr -= isz + t.s3;
  const ne = ueErrorCount(st);
  const nw = ueWarnCount(st);
  if (ne + nw > 0) {
    xr -= ueTextR(mut ui, xr, y, h, `エラー ${ne} · 警告 ${nw}`, t.fsSm, t.text2) + t.s1;
    // エラーがあれば丸に ×、警告だけなら三角
    if (ne > 0) {
      ueIconAt(mut ui, xr - isz, y + (h - isz) / 2, isz, UE_I_ERROR, t.error);
    } else {
      ueIconAt(mut ui, xr - isz, y + (h - isz) / 2, isz, UE_I_WARN, t.warn);
    }
  }
}

// プレビューの絵（ダミーの素材: 夕方の商店街）。本物は合成した画面（Buffer）を貼る（uikit に画像の命令が要る）。
function demoPicture(ui: mut UkCtx, r: UkRect): void {
  const top: u32 = 0xfff2b880;
  const midc: u32 = 0xffb98a7a;
  const bot: u32 = 0xff4d3d3d;
  const bands = 48;
  for (let i = 0; i < bands; i++) {
    const y0 = r.y + r.h * i / bands;
    const y1 = r.y + r.h * (i + 1) / bands;
    const f = (i * 1000 / bands);
    let c = top;
    if (f < 600) {
      c = ukMix(top, midc, f * 256 / 600);
    } else {
      c = ukMix(midc, bot, (f - 600) * 256 / 400);
    }
    ukDrawRect(mut ui, ukRect(r.x, y0, r.w, y1 - y0), c);
  }
  const sx = (r.w as f32) / 640.0;
  const sy = (r.h as f32) / 360.0;
  const ox = r.x as f32;
  const oy = r.y as f32;
  ukDrawTri(mut ui, ox, oy + 360.0 * sy, ox + 250.0 * sx, oy + 190.0 * sy, ox + 640.0 * sx, oy + 360.0 * sy, 0xff6b5a52);
  ukDrawTri(mut ui, ox + 250.0 * sx, oy + 190.0 * sy, ox + 390.0 * sx, oy + 190.0 * sy, ox + 640.0 * sx, oy + 360.0 * sy, 0xff6b5a52);
  demoBox(mut ui, r, 0, 80, 220, 200, 0xff3b2f2c);
  demoBox(mut ui, r, 420, 60, 220, 230, 0xff33292a);
  demoBox(mut ui, r, 20, 110, 70, 40, ukAlpha(0xfff7d58c, 204));
  demoBox(mut ui, r, 120, 120, 60, 30, ukAlpha(0xffe9a35c, 178));
  demoBox(mut ui, r, 450, 100, 80, 44, ukAlpha(0xfff7d58c, 190));
  demoBox(mut ui, r, 560, 140, 60, 30, ukAlpha(0xffe9a35c, 178));
  ukDrawRound(mut ui, ukRect(r.x + (300.0 * sx) as i32, r.y + (170.0 * sy) as i32, (40.0 * sx) as i32, (36.0 * sy) as i32), 8, 0xff2a2a2e);
  ukDrawRound(mut ui, ukRect(r.x + (308.0 * sx) as i32, r.y + (148.0 * sy) as i32, (24.0 * sx) as i32, (24.0 * sy) as i32), 12, 0xff2a2a2e);
}

function demoBox(ui: mut UkCtx, r: UkRect, x: i32, y: i32, w: i32, h: i32, c: u32): void {
  const sx = (r.w as f32) / 640.0;
  const sy = (r.h as f32) / 360.0;
  ukDrawRect(mut ui, ukRect(r.x + ((x as f32) * sx) as i32, r.y + ((y as f32) * sy) as i32, ((w as f32) * sx) as i32, ((h as f32) * sy) as i32), c);
}

// 見本の中で、押されたものに応える（本物は編集の画面が renderqueue.um などにつなぐ）
function demoHandle(ui: mut UkCtx, st: mut UeState, ev: UeEvent[], nextId: mut i32[]): void {
  for (const e of ev) {
    if (e.kind == UE_EV_CHECK_ACTION && e.s.length > 7 && demoFind(e.s, 58) == 6) {
      // "preset:<id>": 勧めるプリセットにする
      for (let i: usize = 0; i < st.presets.length; i++) {
        if ("preset:" + st.presets[i].id == e.s) {
          st.sel = i as i32;
        }
      }
      const missing = ueErrorCount(st) > 0;
      st.checks = demoChecks(st, missing);
    } else if (e.kind == UE_EV_PRESET) {
      const missing = ueErrorCount(st) > 0;
      st.checks = demoChecks(st, missing);
    } else if (e.kind == UE_EV_EXPORT || e.kind == UE_EV_ENQUEUE) {
      let state = UE_J_WAIT;
      if (e.kind == UE_EV_EXPORT) {
        state = UE_J_RUN;
      }
      const nm = st.fileName + ueExt(st);
      st.jobs.push(demoJob(nextId[0], nm, state, 0.0, "", st.presets[st.sel as usize].name.clone()));
      nextId[0] = nextId[0] + 1;
      ukToast(mut ui, `${nm} を待ち行列に足しました`, 0);
    } else if (e.kind == UE_EV_JOB_CANCEL) {
      for (let i: usize = 0; i < st.jobs.length; i++) {
        if (st.jobs[i].id == e.a) {
          st.jobs[i].state = UE_J_CANCEL;
          st.jobs[i].info = "取りやめました";
        }
      }
    } else if (e.kind == UE_EV_JOB_RETRY) {
      for (let i: usize = 0; i < st.jobs.length; i++) {
        if (st.jobs[i].id == e.a) {
          st.jobs[i].state = UE_J_WAIT;
        }
      }
    } else if (e.kind == UE_EV_CHECK_ACTION || e.kind == UE_EV_PICK_FOLDER || e.kind == UE_EV_JOB_OPEN ||
               e.kind == UE_EV_JOB_PLAY || e.kind == UE_EV_JOB_GOTO || e.kind == UE_EV_JOB_COPY || e.kind == UE_EV_SAVE_PRESET) {
      // 見本ではダイアログやフォルダを開かず、知らせるだけ
      ukToast(mut ui, `（見本）${e.kind}: ${e.s}`, 0);
    }
  }
}

export function main(): i32 {
  const a = args();
  let W: i32 = 1440;
  let H: i32 = 900;
  let scale: f32 = 1.0;
  let maxFrames: i64 = -1;
  let shot = "";
  let tokens = "docs/design/tokens.json";
  let which = 1;
  let name = "";
  let evs: DemoEv[] = [];
  let i: usize = 0;
  while (i < a.length) {
    const opt = a[i].clone();
    let val = "";
    if (i + 1 < a.length) {
      val = a[i + 1].clone();
    }
    if (opt == "--size") {
      const x = demoFind(val, 120);
      if (x > 0) {
        W = demoInt(val, 0, x as usize) as i32;
        H = demoInt(val, (x as usize) + 1, val.length) as i32;
      }
    } else if (opt == "--scale") {
      const dot = demoFind(val, 46);
      if (dot >= 0) {
        const ip = demoInt(val, 0, dot as usize) as f32;
        const fp = demoInt(val, (dot as usize) + 1, val.length) as f32;
        let d: f32 = 1.0;
        for (let k = (dot as usize) + 1; k < val.length; k++) {
          d = d * 10.0;
        }
        scale = ip + fp / d;
      } else {
        scale = demoInt(val, 0, val.length) as f32;
      }
    } else if (opt == "--frames") {
      maxFrames = demoInt(val, 0, val.length);
    } else if (opt == "--shot") {
      shot = val;
    } else if (opt == "--tokens") {
      tokens = val;
    } else if (opt == "--name") {
      name = val;
    } else if (opt == "--state") {
      which = demoInt(val, 0, val.length) as i32;
    } else if (!demoParseEv(opt, val, mut evs)) {
      eprint(`warning: unknown option '${opt}'`);
    }
    i += 2;
  }
  let json = "";
  const tj = readFile(tokens);
  if (tj != null) {
    json = stringFromBytes(tj);
  } else {
    eprint(`warning: cannot read '${tokens}'（uikit の既定の値で描きます）`);
  }
  const t = ueThemeFromTokens(json, scale);
  if (t.missing > 0) {
    eprint(`warning: tokens に ${t.missing} 個の名前がありません`);
  }
  let ui = ukNew(ueUkTheme(t), own uiFont());
  const opened = windowOpen("書き出しの見本", W, H);
  if (opened == null) {
    eprint("error: could not open a window");
    return 1;
  }
  const win = opened;
  let px = new Buffer<u32>((W * H) as u32);
  let st = demoState(which);
  if (name.length > 0) {
    st.fileName = name;
  }
  let cache = ueCacheNew();
  let nextId: i32[] = [10];
  let running = true;
  let frames: i64 = 0;
  const fixedTime = maxFrames >= 0;
  while (running) {
    let res = ukWinResNew();
    while (true) {
      const e = pollWindowEvent(fixedTime ? 0 : 16);
      if (e == null) {
        break;
      }
      ukFeedWindowEvent(mut ui, e, mut res);
    }
    for (const ev of evs) {
      if (ev.frame == frames) {
        if (ev.kind == 1) {
          ukEventMouseMove(mut ui, ev.x, ev.y);
        } else if (ev.kind == 2) {
          ukEventMouseMove(mut ui, ev.x, ev.y);
          ukEventMouseButton(mut ui, ev.x, ev.y, 1, true);
          ukEventMouseButton(mut ui, ev.x, ev.y, 1, false);
        } else if (ev.kind == 3) {
          ukEventKey(mut ui, ev.x, 0);
        }
      }
    }
    if (res.quit) {
      running = false;
    }
    if (res.resized && (res.w != W || res.h != H)) {
      W = res.w;
      H = res.h;
      px = new Buffer<u32>((W * H) as u32);
    }
    let now = clock();
    if (fixedTime) {
      now = (frames as f64) / 60.0;
    }
    ukBegin(mut ui, W, H, now);
    ukDrawRect(mut ui, ukRect(0, 0, W, H), t.bg0);
    demoTopBar(mut ui, t, W);
    const bodyY = t.topBar;
    const bodyH = H - t.topBar - t.statusBar;
    demoRail(mut ui, t, bodyY, bodyH, ueErrorCount(st) + ueWarnCount(st), ueErrorCount(st));
    const body = ukRect(t.rail, bodyY, W - t.rail, bodyH);
    const lay = ueLayout(t, st, body);
    demoPicture(mut ui, lay.content);
    let ev: UeEvent[] = [];
    const tc = ukFormatTimecode(st.seq.playhead, ukFpsInt(st.seq.fpsNum, st.seq.fpsDen));
    ueWorkspace(mut ui, t, mut st, mut cache, lay, tc, mut ev);
    demoStatus(mut ui, t, st, W, H);
    ukEnd(mut ui, mut px);
    demoHandle(mut ui, mut st, ev, mut nextId);
    windowPresent(win, px, W, H);
    frames++;
    if (maxFrames >= 0 && frames >= maxFrames) {
      running = false;
    }
  }
  if (maxFrames >= 0) {
    // 折り返し・省略・コードの箱を作り直した回数（中身が変わらなければ、コマ数が増えても増えない）
    eprint(`cache builds ${cache.builds} (${frames} frames)`);
  }
  if (shot.length > 0) {
    if (!ukWriteBmp(shot, px, W, H)) {
      eprint(`error: cannot write '${shot}'`);
    }
  }
  windowClose(win);
  return 0;
}
