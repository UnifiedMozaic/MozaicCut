// 音のミックス。各クリップの音を media.um の読み手（mediaReadSound）で 1 秒ずつ読んで足し合わせる。
// 値は s16 の大きさ（-32768..32767）で足す（展開したキャッシュの s16le と同じ値になる）。
import { Project, Clip, KIND_VIDEO, KIND_AUDIO } from "./project.um";
import { audioEnvelope } from "./render.um";
import { MediaSource, MEDIA_OPEN_FAST, MEDIA_OPEN_BEST, mediaOpenClip, mediaNone, mediaReadSound, mediaRelease } from "./media.um";
import { WsaBlock, wsaBlockNew, wsaBlockPrepare, wsaZeros, wsaMixActive, wsaTrackProcess, wsaAudible, wsaMasterProcess, wsaPrerollFrames } from "./ws_audio/chain.um";
import { wsaSetCopy } from "./ws_audio/mzc.um";
import { animEvalNum, animClamp } from "./m6_anim/anim.um";

export function clipHasSound(c: Clip): bool {
  if (c.kind == KIND_AUDIO) {
    return true;
  }
  return c.kind == KIND_VIDEO && c.hasAudio && !c.mute;
}

// クリップごとの音の読み手（音のないクリップは mediaNone()）。使い終えたら releaseSounds で閉じる。
export function openSounds(p: Project, cache: string, mode: i32): MediaSource[] {
  let out: MediaSource[] = [];
  for (let i: usize = 0; i < p.clips.length; i++) {
    if (clipHasSound(p.clips[i])) {
      out.push(mediaOpenClip(p, cache, i, KIND_AUDIO, mode));
    } else {
      out.push(mediaNone());
    }
  }
  return out;
}

export function releaseSounds(srcs: mut MediaSource[]): void {
  for (let i: usize = 0; i < srcs.length; i++) {
    mediaRelease(mut srcs[i]);
  }
}

// 音量のキーフレーム（volume / vol）の番号。なければ -1。
function volumeAnim(c: Clip): i32 {
  for (let i: usize = 0; i < c.anims.length; i++) {
    if (c.anims[i].key == "volume" || c.anims[i].key == "vol") {
      return i as i32;
    }
  }
  return -1;
}

// 音量のキーフレームを、クリップの始まりからの標本 n の位置で評価する（0〜10 に丸める）。
function volumeAt(c: Clip, vi: i32, n: i64, rate: i64): f64 {
  return animClamp(animEvalNum(c.anims[vi as usize].track, (n as f64) / (rate as f64)), 0, 10);
}

const VOL_BLOCK: i64 = 256;

// クリップ c の音を、タイムラインの標本 start から len 個分（ステレオの組）だけ mix に足す。buf は作業用。
function mixClip(mix: mut f32[], c: Clip, src: mut MediaSource, rate: i64, start: i64, len: i64, buf: mut f32[]): void {
  const a0 = Math.floor(c.at * (rate as f64) + 0.5) as i64;
  const a1 = a0 + (Math.floor(c.dur * (rate as f64) + 0.5) as i64);
  const s0 = Math.max(start, a0);
  const s1 = Math.min(start + len, a1);
  if (s0 >= s1 || !src.ok) {
    return;
  }
  const got = mediaReadSound(mut src, s0 - a0, s1 - s0, mut buf);
  if (got <= 0) {
    return;
  }
  const frames = got as usize;
  // 音量のキーフレームは 256 標本のブロックの両端で評価し、ブロックの中は直線で補う
  // （標本ごとに評価すると重く、ブロックごとに段にするとジッパー音が出るため）
  const vi = volumeAnim(c);
  let blk: i64 = -1;
  let v0: f64 = 0;
  let v1: f64 = 0;
  for (let j: usize = 0; j < frames; j++) {
    const pos = s0 + (j as i64);
    const t = ((pos - a0) as f64) / (rate as f64);
    let vol = c.volume;
    if (vi >= 0) {
      const rel = pos - a0;
      const b = rel - rel % VOL_BLOCK;
      if (b != blk) {
        blk = b;
        v0 = volumeAt(c, vi, b, rate);
        v1 = volumeAt(c, vi, b + VOL_BLOCK, rate);
      }
      vol = (v0 + (v1 - v0) * ((rel - b) as f64) / (VOL_BLOCK as f64)) as f32;
    }
    const g = (audioEnvelope(c, t) as f32) * vol;
    const o = ((pos - start) * 2) as usize;
    const q = j * 2;
    mix[o] = mix[o] + buf[q] * 32768.0 * g;
    mix[o + 1] = mix[o + 1] + buf[q + 1] * 32768.0 * g;
  }
}

// タイムラインの標本 start から len 個分（ステレオの組）の音を混ぜて mix（長さ len * 2 以上）に書く（s16 の大きさ）。
// トラックの処理（track の行）は掛けない（掛けるなら mixTracksBlockFrom）。
// srcs は openSounds で開いたもの。buf は作業用（中身は何でもよい）。
export function mixRange(p: Project, srcs: mut MediaSource[], start: i64, len: i64, mix: mut f32[], buf: mut f32[]): void {
  mix.fill(0);
  const rate = p.rate as i64;
  for (let i: usize = 0; i < p.clips.length && i < srcs.length; i++) {
    if (clipHasSound(p.clips[i])) {
      mixClip(mut mix, p.clips[i], mut srcs[i], rate, start, len, mut buf);
    }
  }
}

function clampSample(v: f32): i32 {
  return Math.min(Math.max(Math.floor(v + 0.5) as i32, -32768), 32767);
}

// 音のトラックごとに混ぜ、トラックの処理（EQ・コンプ・音量・パン。track の行）を掛けてから足し、マスターの音量を掛ける。
// タイムラインの標本 start から len 個分（ステレオの組）を blk.mix（s16 の大きさ）に書く。blk は区切りをまたいで使い続ける。
// 処理の後の各トラックの音（0 dBFS = 1.0）は blk.bufs（blk.wm.tracks と同じ並び）に残る（音のワークスペースのメーターが測る）。
// cache から音の読み手をその都度開いて閉じる（何度も呼ぶなら、openSounds で開いて mixTracksBlockFrom を使う）。
export function mixTracksBlock(p: Project, cache: string, blk: mut WsaBlock, start: i64, len: i64): void {
  let srcs = openSounds(p, cache, MEDIA_OPEN_FAST);
  let tmp: f32[] = [];
  mixTracksBlockFrom(p, mut srcs, mut blk, start, len, mut tmp);
  releaseSounds(mut srcs);
}

// mixTracksBlock の、開いた読み手（openSounds）から混ぜる版。tmp は作業用（中身は何でもよい）。
export function mixTracksBlockFrom(p: Project, srcs: mut MediaSource[], blk: mut WsaBlock, start: i64, len: i64, tmp: mut f32[]): void {
  const rate = p.rate as i64;
  const n = len as usize;
  wsaBlockPrepare(mut blk, n);
  for (let k: usize = 0; k < blk.wm.tracks.length; k++) {
    const tr = blk.wm.tracks[k];
    let buf = wsaZeros(n);
    for (let i: usize = 0; i < p.clips.length && i < srcs.length; i++) {
      if (clipHasSound(p.clips[i]) && p.clips[i].track == tr) {
        mixClip(mut buf, p.clips[i], mut srcs[i], rate, start, len, mut tmp);
      }
    }
    for (let j: usize = 0; j < n * 2; j++) {
      buf[j] = buf[j] / 32768.0;
    }
    wsaTrackProcess(mut blk.wm, k, mut buf, n);
    if (wsaAudible(blk.wm, k)) {
      for (let j: usize = 0; j < n * 2; j++) {
        blk.mix[j] = blk.mix[j] + buf[j] * 32768.0;
      }
    }
    blk.bufs[k] = buf;
  }
  const ms = wsaSetCopy(blk.wm.master);
  wsaMasterProcess(ms, mut blk.mix, n);
}

// track の行があるときの mixAudio。途中から書き出すときは、処理の状態をそろえるため手前から助走して捨てる。
function mixAudioTracks(p: Project, cache: string, outPath: string, first: i64, last: i64): bool {
  const rate = p.rate as i64;
  let blk = wsaBlockNew(p);
  let srcs = openSounds(p, cache, MEDIA_OPEN_BEST);
  let tmp: f32[] = [];
  let ok = true;
  let out: u8[] = [];
  let start = Math.max(first - wsaPrerollFrames(blk.wm), 0);
  while (start < last) {
    let len = Math.min(rate, last - start);
    if (start < first) {
      len = Math.min(len, first - start);
    }
    mixTracksBlockFrom(p, mut srcs, mut blk, start, len, mut tmp);
    if (start >= first) {
      out.clear();
      for (let j: usize = 0; j < (len * 2) as usize; j++) {
        const v = clampSample(blk.mix[j]);
        out.push((v & 255) as u8);
        out.push(((v >> 8) & 255) as u8);
      }
      if (!appendFile(outPath, out)) {
        ok = false;
        break;
      }
    }
    start += len;
  }
  releaseSounds(mut srcs);
  return ok;
}

// 全体の音を outPath に s16le ステレオで書く。
export function mixAudio(p: Project, cache: string, outPath: string, fromSec: f64, toSec: f64): bool {
  const rate = p.rate as i64;
  const first = Math.floor(fromSec * (rate as f64) + 0.5) as i64;
  const last = Math.floor(toSec * (rate as f64) + 0.5) as i64;
  const empty: u8[] = [];
  if (!writeFile(outPath, empty)) {
    return false;
  }
  if (wsaMixActive(p)) {
    return mixAudioTracks(p, cache, outPath, first, last);
  }
  let srcs = openSounds(p, cache, MEDIA_OPEN_BEST);
  let mix: f32[] = [];
  for (let i: i64 = 0; i < rate * 2; i++) {
    mix.push(0);
  }
  let buf: f32[] = [];
  let out: u8[] = [];
  let start = first;
  let ok = true;
  while (start < last) {
    const len = Math.min(rate, last - start);
    mixRange(p, mut srcs, start, len, mut mix, mut buf);
    out.clear();
    for (let j: usize = 0; j < (len * 2) as usize; j++) {
      const v = clampSample(mix[j]);
      out.push((v & 255) as u8);
      out.push(((v >> 8) & 255) as u8);
    }
    if (!appendFile(outPath, out)) {
      ok = false;
      break;
    }
    start += len;
  }
  releaseSounds(mut srcs);
  return ok;
}

// ---- 続けて混ぜる口（MP4 の書き出しと、編集画面の音の再生） ----
//
// 区切りごとに、タイムラインの標本の位置と長さを頼んで混ぜる。track の行があれば（wsaMixActive）、書き出し（mixAudio）と
// 同じくトラックの処理（EQ・コンプ・音量・パン）とマスターを掛ける。トラックの処理は前の区切りの状態を引き継ぐので、
// 続きでない位置を頼まれたら（再生のシークなど）、状態を作り直して手前から助走する（mixAudioTracks と同じ）。
// 処理の後の各トラックの音（0 dBFS = 1.0）は blks[0].bufs（blks[0].wm.tracks と同じ並び）に、マスターは blks[0].mix に残る
// （tracks が false のときは使わない）。
export struct AudioMix {
  srcs: MediaSource[];
  tracks: bool;
  // track の行がなくてもトラックごとに混ぜる（編集画面の再生。トラックのメーターに、鳴らしている音の値を出すため。
  // 処理が平らなら値は mixRange と同じ）
  always: bool;
  // トラックの処理の状態（いつも 1 つ。同じ呼び出しに am の欄を 2 つ mut で渡せないので、配列から取り出して使う）
  blks: WsaBlock[];
  // 次に続けて混ぜる標本の位置（-1 はまだ混ぜていない）
  next: i64;
}

// プロジェクトの音の読み手を開く（mode は media.um の MEDIA_OPEN_*）。使い終えたら audioMixClose で閉じる。
export function audioMixOpen(p: Project, cache: string, mode: i32): AudioMix {
  return { srcs: openSounds(p, cache, mode), tracks: wsaMixActive(p), always: false, blks: [wsaBlockNew(p)], next: -1 };
}

// 編集画面の再生用: track の行がなくても、いつもトラックごとに混ぜる（blks[0].bufs にトラックごとの音が残る）。
export function audioMixOpenTracks(p: Project, cache: string, mode: i32): AudioMix {
  return { srcs: openSounds(p, cache, mode), tracks: true, always: true, blks: [wsaBlockNew(p)], next: -1 };
}

// プロジェクトを書き換えたときに、読み手とトラックの設定を開き直す。
export function audioMixReload(am: mut AudioMix, p: Project, cache: string, mode: i32): void {
  releaseSounds(mut am.srcs);
  am.srcs = openSounds(p, cache, mode);
  am.tracks = am.always || wsaMixActive(p);
  am.blks.clear();
  am.blks.push(wsaBlockNew(p));
  am.next = -1;
}

// タイムラインの標本 start から len 個分（ステレオの組）を混ぜて mix に書く（s16 の大きさ。mix は len * 2 より短ければ伸ばす）。
export function audioMixRead(am: mut AudioMix, p: Project, start: i64, len: i64, mix: mut f32[]): void {
  // 足りなければ伸ばす（空の配列を渡してよい）
  while (mix.length < (len * 2) as usize) {
    mix.push(0.0 as f32);
  }
  if (!am.tracks) {
    let buf: f32[] = [];
    mixRange(p, mut am.srcs, start, len, mut mix, mut buf);
  } else {
    let tmp: f32[] = [];
    const rate = p.rate as i64;
    let blk = am.blks.pop();
    if (start != am.next) {
      blk = wsaBlockNew(p);
      let pre = Math.max(start - wsaPrerollFrames(blk.wm), 0 as i64);
      while (pre < start) {
        const l = Math.min(rate, start - pre);
        mixTracksBlockFrom(p, mut am.srcs, mut blk, pre, l, mut tmp);
        pre += l;
      }
    }
    mixTracksBlockFrom(p, mut am.srcs, mut blk, start, len, mut tmp);
    for (let j: usize = 0; j < (len * 2) as usize; j++) {
      mix[j] = blk.mix[j];
    }
    am.blks.push(blk);
  }
  am.next = start + len;
}

export function audioMixClose(am: mut AudioMix): void {
  releaseSounds(mut am.srcs);
}
