// モニターの部品のテーマ: 色と大きさを docs/design/tokens.json の名前で持つ。
// 既定の値は theme_gen.um（tokens.json から gen_theme.mjs で生成）の monThemeTokens。
// 実行時に tokens.json を読み直すときは monThemeFromTokens（道筋の対応は生成した monThemeSetPath）。
// 大きさは倍率を掛ける前の論理 px で持ち、使う所で monS(t, v) で画素にする（線は monLine）。
//
// uikit の UkTheme に「bg.viewer・再生ヘッド・詰める／詰めない・種類の色・タイムコードの文字」が入ったら、
// この構造体は UkTheme から作るだけの薄いものにする（報告の「uikit に足すべきもの」）。

export struct MonTheme {
  scale: f32;
  // ---- 色（0xAARRGGBB） ----
  bg1: u32;
  bg2: u32;
  bg3: u32;
  bg4: u32;
  bgViewer: u32;
  bgPopover: u32;
  viewerBlack: u32;
  viewerMidGray: u32;
  viewerUi: u32;
  line: u32;
  lineStrong: u32;
  lineControl: u32;
  text1: u32;
  text2: u32;
  text3: u32;
  textDis: u32;
  textOnDark: u32;
  textOnRipple: u32;
  textOnOverwrite: u32;
  accent: u32;
  accentHover: u32;
  playhead: u32;
  playheadEdge: u32;
  ripple: u32;
  rippleTint: u32;
  overwrite: u32;
  overwriteTint: u32;
  ok: u32;
  warn: u32;
  error: u32;
  inOut: u32;
  focusOuter: u32;
  kVideo: u32;
  kAudio: u32;
  kText: u32;
  kImage: u32;
  kColor: u32;
  ovlBg: u32;
  guide: u32;
  kbdEdgeBtn: u32;
  // ---- 大きさ（論理 px） ----
  panelHeader: f32;
  btnSm: f32;
  iconBtnSm: f32;
  iconBtnMd: f32;
  iconSm: f32;
  hitMin: f32;
  sp1: f32;
  sp2: f32;
  sp3: f32;
  sp4: f32;
  radiusSm: f32;
  radiusMd: f32;
  hairline: f32;
  focusW: f32;
  fsXs: f32;
  fsSm: f32;
  fsMd: f32;
  fsTcM: f32;
  transportH: f32;
  scrubH: f32;
  iconXs: f32;
  chipH: f32;
  kbdH: f32;
  tcW: f32;
  sepH: f32;
  ovlPadX: f32;
  ovlPadY: f32;
  tabMaxW: f32;
  menuW: f32;
  chipPadX: f32;
  kbdPadX: f32;
  kbdGap: f32;
  kbdOpacity: f32;
  headerPadR: f32;
  popupGap: f32;
}

// UI の倍率の範囲。倍率は OS の倍率 × 利用者の倍率（80〜200%。ui.md 20 章）なので、
// 上限は OS の倍率の上限（2×）× 2.0 = 4.0 にする（Retina で 150% なら 3.0）。
export function monClampScale(s: f32): f32 {
  if (!(s >= 0.8)) {
    return 0.8;
  }
  return Math.min(s, 4.0);
}

// 色に不透明度 k（0〜1）を掛ける。
export function monAlpha(c: u32, k: f32): u32 {
  const a = Math.floor((((c >> 24) & 255) as f32) * k + 0.5) as u32;
  return (Math.min(a, 255) << 24) | (c & 0xffffff);
}

// 論理 px を画素に（四捨五入）。
export function monS(t: MonTheme, v: f32): i32 {
  return Math.floor(v * t.scale + 0.5) as i32;
}

// 文字の大きさ（画素、小数のまま）。
export function monF(t: MonTheme, v: f32): f32 {
  return v * t.scale;
}

// 1px の線の太さ（倍率を掛けて整数の画素に吸着。ui.md 20 章）。
export function monLine(t: MonTheme): i32 {
  return Math.max(Math.floor(t.hairline * t.scale + 0.5) as i32, 1);
}

// ---- tokens.json の読み直し ----

function monJsonWs(s: string, i0: usize): usize {
  let i = i0;
  while (i < s.length && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) {
    i++;
  }
  return i;
}

function monJsonStr(s: string, i0: usize, end: mut usize[]): string {
  let out: u8[] = [];
  let i = i0 + 1;
  while (i < s.length && s[i] != 34) {
    if (s[i] == 92 && i + 1 < s.length) {
      i++;
    }
    out.push(s[i]);
    i++;
  }
  end[0] = i + 1;
  return stringFromBytes(out);
}

function monHexVal(b: u8): i64 {
  if (b >= 48 && b <= 57) {
    return (b as i64) - 48;
  }
  if (b >= 97 && b <= 102) {
    return (b as i64) - 87;
  }
  if (b >= 65 && b <= 70) {
    return (b as i64) - 55;
  }
  return -1;
}

// "#RRGGBB" / "#RRGGBBAA" を 0xAARRGGBB に。読めなければ -1。
export function monParseHex(s: string): i64 {
  if ((s.length != 7 && s.length != 9) || s[0] != 35) {
    return -1;
  }
  let v: i64 = 0;
  for (let i: usize = 1; i < s.length; i++) {
    const h = monHexVal(s[i]);
    if (h < 0) {
      return -1;
    }
    v = v * 16 + h;
  }
  if (s.length == 7) {
    return v | 0xff000000;
  }
  return ((v & 255) << 24) | (v >> 8);
}

function monJoinPath(path: string[]): string {
  let s = "";
  for (let i: usize = 0; i < path.length; i++) {
    if (i > 0) {
      s = s + ".";
    }
    s = s + path[i];
  }
  return s;
}

// tokens.json を読み、モニターが使う値を t に入れる。setter は生成した monThemeSetPath を渡す代わりに、
// 道筋と値の組を返す（UM には関数の値がないので、呼ぶ側で monThemeSetPath に渡す。theme_load.um）。
export struct MonTokVal {
  path: string;
  color: u32;
  num: f32;
  isColor: bool;
}

export function monTokensFlatten(json: string): MonTokVal[] {
  let out: MonTokVal[] = [];
  let path: string[] = [];
  let isObj: bool[] = [];
  let i = monJsonWs(json, 0);
  let pendingKey = false;
  let end: usize[] = [0];
  while (i < json.length) {
    const b = json[i];
    if (b == 123) {
      isObj.push(true);
      path.push("");
      pendingKey = true;
      i++;
    } else if (b == 125 || b == 93) {
      if (isObj.length == 0) {
        return out;
      }
      isObj.pop();
      path.pop();
      i++;
    } else if (b == 91) {
      isObj.push(false);
      path.push("[]");
      i++;
    } else if (b == 44) {
      if (isObj.length > 0 && isObj[isObj.length - 1]) {
        pendingKey = true;
      }
      i++;
    } else if (b == 58) {
      pendingKey = false;
      i++;
    } else if (b == 34) {
      const str = monJsonStr(json, i, mut end);
      i = end[0];
      if (pendingKey && path.length > 0) {
        path[path.length - 1] = str;
        pendingKey = false;
      } else {
        const c = monParseHex(str);
        if (c >= 0) {
          out.push({ path: monJoinPath(path), color: c as u32, num: 0.0, isColor: true });
        }
      }
    } else if ((b >= 48 && b <= 57) || b == 45) {
      let j = i;
      let v: f64 = 0.0;
      let neg = false;
      if (json[j] == 45) {
        neg = true;
        j++;
      }
      while (j < json.length && json[j] >= 48 && json[j] <= 57) {
        v = v * 10.0 + ((json[j] - 48) as f64);
        j++;
      }
      if (j < json.length && json[j] == 46) {
        j++;
        let f: f64 = 0.1;
        while (j < json.length && json[j] >= 48 && json[j] <= 57) {
          v = v + ((json[j] - 48) as f64) * f;
          f = f * 0.1;
          j++;
        }
      }
      if (neg) {
        v = -v;
      }
      out.push({ path: monJoinPath(path), color: 0, num: v as f32, isColor: false });
      i = j;
    } else {
      i++;
    }
  }
  return out;
}
