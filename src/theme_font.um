// テーマのフォント: tokens.json の font.family（同梱する前提のファミリーとファイル名）から、
// 役（本文・太字・等幅・等幅の中太・予備・アイコン）ごとにフォントを探して読む。
//
// 探す順（役ごと。最初に ok になったものを使う）:
//   1. 同梱の場所: 呼び手が渡すフォルダ（例: 実行ファイルの横の fonts/）、"fonts"、"assets/fonts"（今の作業フォルダから）
//      に tokens.json のファイル名（IBMPlexSansJP-Regular.ttf など）
//   2. OS に入っている同じファミリー（Windows・macOS・Linux のフォントのフォルダ）
//   3. 予備のファミリー: 和文は Noto Sans JP → BIZ UDPゴシック → Yu Gothic UI → メイリオ → ttf.um の defaultFont()、
//      等幅は Cascadia Mono → Consolas → Menlo → DejaVu Sans Mono → 本文のフォント
// 設定「読みやすさ優先の文字」（legible）では、本文と太字の 1 番目を BIZ UDPゴシックにする。
// ttf.um は glyf（TrueType の輪郭）だけを読む。CFF の .otf や読めないファイルは ok=false なので、次の候補へ進む。
import { Font, loadFont, defaultFont } from "./ttf.um";
import {
  TH_FONT_SANS_NAME, TH_FONT_SANS_FILE_0, TH_FONT_SANS_FILE_1, TH_FONT_MONO_NAME, TH_FONT_MONO_FILE_0, TH_FONT_MONO_FILE_1,
  TH_FONT_FALLBACK_NAME, TH_FONT_LEGIBLE_NAME, TH_FONT_ICONS_NAME, TH_TS_WEIGHT, TH_TS_FAMILY, TH_FAMILY_MONO, TH_WEIGHT_SEMIBOLD,
  TH_WEIGHT_MEDIUM,
} from "./gen/theme.um";

// 役
export const TH_ROLE_SANS: i32 = 0;           // 本文（400）
export const TH_ROLE_SANS_SEMIBOLD: i32 = 1;  // 見出し（600）
export const TH_ROLE_MONO: i32 = 2;           // 等幅（400）
export const TH_ROLE_MONO_MEDIUM: i32 = 3;    // 時刻（500）
export const TH_ROLE_FALLBACK: i32 = 4;       // 本文にない字（素材名・字幕）
export const TH_ROLE_ICONS: i32 = 5;          // アイコンのフォント（U+E000〜）
export const TH_ROLE_COUNT: i32 = 6;

// 探す候補の 1 つ
export struct ThFontCand {
  path: string;
  index: i32;      // TTC の中の番号
  family: string;  // 表示用の名前
  bundled: bool;   // 同梱の場所で見つけたもの
}

// 読んだフォント（役ごと）。字の形は ThFonts.u[slot] にある（同じファイルを役ごとに読み直さないため）
export struct ThFont {
  slot: usize;      // ThFonts.u の番号
  ok: bool;
  path: string;     // 読めたファイル（なければ ""）
  index: i32;
  family: string;   // 読めたファミリーの名前（defaultFont のときは "既定"）
  bundled: bool;
  wanted: string;   // tokens.json の名前（これと family が違えば予備を使っている）
}

export struct ThFonts {
  f: ThFont[];      // TH_ROLE_* の順
  u: Font[];        // 読んだフォント（道筋と TTC の番号ごとに 1 つ）。役からは thFontSlot で引く
  uPath: string[];  // u と同じ並びの道筋（"" は defaultFont、"-" は読めなかったアイコンのフォント）
  uIndex: i32[];
  legible: bool;
}

// 同梱のファイル名から、同梱の場所の候補を足す。
function thFontAddBundled(out: mut ThFontCand[], dirs: string[], file: string, family: string): void {
  if (file.length == 0) {
    return;
  }
  for (const d of dirs) {
    out.push({ path: d + "/" + file, index: 0, family: family.clone(), bundled: true });
  }
  out.push({ path: "fonts/" + file, index: 0, family: family.clone(), bundled: true });
  out.push({ path: "assets/fonts/" + file, index: 0, family: family.clone(), bundled: true });
}

// OS のフォントのフォルダにある同じファイル名。
function thFontAddSystem(out: mut ThFontCand[], file: string, family: string): void {
  const dirs: string[] = [
    "C:/Windows/Fonts",
    "/Library/Fonts",
    "/System/Library/Fonts",
    "/usr/share/fonts/truetype",
    "/usr/share/fonts/truetype/ibm-plex",
    "/usr/share/fonts/TTF",
    "/usr/local/share/fonts",
  ];
  for (const d of dirs) {
    out.push({ path: d + "/" + file, index: 0, family: family.clone(), bundled: false });
  }
}

function thCand(out: mut ThFontCand[], path: string, index: i32, family: string, bundled: bool): void {
  out.push({ path: path.clone(), index, family: family.clone(), bundled });
}

function thFontAddLegible(out: mut ThFontCand[], dirs: string[], bold: bool): void {
  const fam = TH_FONT_LEGIBLE_NAME;
  if (bold) {
    thFontAddBundled(mut out, dirs, "BIZUDPGothic-Bold.ttf", fam);
    thCand(mut out, "C:/Windows/Fonts/BIZ-UDGothicB.ttc", 1, fam, false);
  } else {
    thFontAddBundled(mut out, dirs, "BIZUDPGothic-Regular.ttf", fam);
    thCand(mut out, "C:/Windows/Fonts/BIZ-UDGothicR.ttc", 1, fam, false);
  }
  if (bold) {
    thFontAddSystem(mut out, "BIZUDPGothic-Bold.ttf", fam);
  } else {
    thFontAddSystem(mut out, "BIZUDPGothic-Regular.ttf", fam);
  }
}

// OS に入っている Noto Sans JP（静的な Regular だけ。Windows 11 の NotoSansJP-VF.ttf のような可変フォントは、
// ttf.um が gvar を当てないので既定の実体（Thin）で細く描かれてしまう。可変フォントは候補に入れない）。
function thFontAddNotoSystem(out: mut ThFontCand[]): void {
  const fb = TH_FONT_FALLBACK_NAME;
  thCand(mut out, "/usr/share/fonts/truetype/noto/NotoSansJP-Regular.ttf", 0, fb, false);
  thCand(mut out, "/Library/Fonts/NotoSansJP-Regular.ttf", 0, fb, false);
}

// 和文の予備（tokens.json の fallback → 読みやすさの書体 → OS の UI の書体）。
function thFontAddJaFallback(out: mut ThFontCand[], dirs: string[], bold: bool): void {
  const fb = TH_FONT_FALLBACK_NAME;
  thFontAddBundled(mut out, dirs, "NotoSansJP-Regular.ttf", fb);
  thFontAddNotoSystem(mut out);
  thFontAddLegible(mut out, dirs, bold);
  if (bold) {
    thCand(mut out, "C:/Windows/Fonts/YuGothB.ttc", 1, "Yu Gothic UI", false);
    thCand(mut out, "C:/Windows/Fonts/meiryob.ttc", 2, "Meiryo UI", false);
  }
  thCand(mut out, "C:/Windows/Fonts/YuGothM.ttc", 1, "Yu Gothic UI", false);
  thCand(mut out, "C:/Windows/Fonts/meiryo.ttc", 2, "Meiryo UI", false);
  thCand(mut out, "/System/Library/Fonts/Supplemental/Arial Unicode.ttf", 0, "Arial Unicode MS", false);
  thCand(mut out, "/usr/share/fonts/opentype/ipaexfont-gothic/ipaexg.ttf", 0, "IPAexGothic", false);
  thCand(mut out, "/usr/share/fonts/truetype/fonts-japanese-gothic.ttf", 0, "Japanese Gothic", false);
}

// 役の候補を、探す順に並べる。dirs は同梱のフォントのフォルダ（呼び手が決める。空でもよい）。
export function thFontCandidates(role: i32, legible: bool, dirs: string[]): ThFontCand[] {
  let out: ThFontCand[] = [];
  if (role == TH_ROLE_SANS || role == TH_ROLE_SANS_SEMIBOLD) {
    const bold = role == TH_ROLE_SANS_SEMIBOLD;
    if (legible) {
      thFontAddLegible(mut out, dirs, bold);
    }
    let file = TH_FONT_SANS_FILE_0;
    if (bold) {
      file = TH_FONT_SANS_FILE_1;
    }
    thFontAddBundled(mut out, dirs, file, TH_FONT_SANS_NAME);
    thFontAddSystem(mut out, file, TH_FONT_SANS_NAME);
    thFontAddJaFallback(mut out, dirs, bold);
  } else if (role == TH_ROLE_MONO || role == TH_ROLE_MONO_MEDIUM) {
    let file = TH_FONT_MONO_FILE_0;
    if (role == TH_ROLE_MONO_MEDIUM) {
      file = TH_FONT_MONO_FILE_1;
    }
    thFontAddBundled(mut out, dirs, file, TH_FONT_MONO_NAME);
    thFontAddSystem(mut out, file, TH_FONT_MONO_NAME);
    if (role == TH_ROLE_MONO_MEDIUM) {
      // 中太がなければ同じファミリーの Regular
      thFontAddBundled(mut out, dirs, TH_FONT_MONO_FILE_0, TH_FONT_MONO_NAME);
      thFontAddSystem(mut out, TH_FONT_MONO_FILE_0, TH_FONT_MONO_NAME);
    }
    // CascadiaMono.ttf は可変フォントだが、既定の実体が Regular なのでそのまま使える
    thCand(mut out, "C:/Windows/Fonts/CascadiaMono.ttf", 0, "Cascadia Mono", false);
    thCand(mut out, "C:/Windows/Fonts/consola.ttf", 0, "Consolas", false);
    thCand(mut out, "/System/Library/Fonts/Menlo.ttc", 0, "Menlo", false);
    thCand(mut out, "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf", 0, "DejaVu Sans Mono", false);
    // 最後は本文の書体
    for (const c of thFontCandidates(TH_ROLE_SANS, legible, dirs)) {
      out.push({ path: c.path.clone(), index: c.index, family: c.family.clone(), bundled: c.bundled });
    }
  } else if (role == TH_ROLE_FALLBACK) {
    thFontAddBundled(mut out, dirs, "NotoSansJP-Regular.ttf", TH_FONT_FALLBACK_NAME);
    thFontAddSystem(mut out, "NotoSansJP-Regular.ttf", TH_FONT_FALLBACK_NAME);
    thFontAddJaFallback(mut out, dirs, false);
  } else if (role == TH_ROLE_ICONS) {
    // ファイル名はまだ決まっていない（tokens.json に files がない）。決まったら tokens.json の font.family.icons.files に書く
    thFontAddBundled(mut out, dirs, "MozaicCutIcons.ttf", TH_FONT_ICONS_NAME);
  }
  return out;
}

// tokens.json で決めたファミリーの名前（役ごと）。
export function thFontWanted(role: i32, legible: bool): string {
  if (legible && (role == TH_ROLE_SANS || role == TH_ROLE_SANS_SEMIBOLD)) {
    return TH_FONT_LEGIBLE_NAME;
  }
  if (role == TH_ROLE_SANS || role == TH_ROLE_SANS_SEMIBOLD) {
    return TH_FONT_SANS_NAME;
  }
  if (role == TH_ROLE_MONO || role == TH_ROLE_MONO_MEDIUM) {
    return TH_FONT_MONO_NAME;
  }
  if (role == TH_ROLE_FALLBACK) {
    return TH_FONT_FALLBACK_NAME;
  }
  return TH_FONT_ICONS_NAME;
}

// 読んだフォントの置き場で、道筋と番号が同じものを探す。なければ読んで足す。読めなければ -1。
function thFontSlotOf(fs: mut ThFonts, path: string, index: i32): i32 {
  for (let i: usize = 0; i < fs.uPath.length; i++) {
    if (fs.uIndex[i] == index && fs.uPath[i] == path) {
      return i as i32;
    }
  }
  const f = loadFont(path, index);
  if (!f.ok) {
    return -1;
  }
  fs.u.push(f);
  fs.uPath.push(path.clone());
  fs.uIndex.push(index);
  return (fs.u.length - 1) as i32;
}

// 道筋が key（"" か "-"）の置き場を探す。なければ f を足す。
function thFontSlotSpecial(fs: mut ThFonts, key: string, f: own Font): usize {
  for (let i: usize = 0; i < fs.uPath.length; i++) {
    if (fs.uPath[i] == key) {
      return i;
    }
  }
  fs.u.push(f);
  fs.uPath.push(key.clone());
  fs.uIndex.push(0);
  return fs.u.length - 1;
}

// 役のフォントを探して読み、fs に足す。どれもなければ（アイコン以外は）ttf.um の defaultFont()。
function thFontFindInto(fs: mut ThFonts, role: i32, legible: bool, dirs: string[]): ThFont {
  for (const c of thFontCandidates(role, legible, dirs)) {
    const k = thFontSlotOf(mut fs, c.path, c.index);
    if (k >= 0) {
      return {
        slot: k as usize, ok: true, path: c.path.clone(), index: c.index, family: c.family.clone(), bundled: c.bundled,
        wanted: thFontWanted(role, legible),
      };
    }
  }
  if (role == TH_ROLE_ICONS) {
    const k = thFontSlotSpecial(mut fs, "-", own loadFont("", 0));
    return { slot: k, ok: false, path: "", index: 0, family: "", bundled: false, wanted: thFontWanted(role, legible) };
  }
  const k = thFontSlotSpecial(mut fs, "", own defaultFont());
  const ok = fs.u[k].ok;
  return { slot: k, ok, path: "", index: 0, family: "既定", bundled: false, wanted: thFontWanted(role, legible) };
}

// 全部の役のフォントを読む。同じファイル（例: 本文と予備と等幅の最後の候補が同じ BIZ UDPゴシック）は 1 回だけ読む。
export function thFontsLoad(dirs: string[], legible: bool): ThFonts {
  let fs: ThFonts = { f: [], u: [], uPath: [], uIndex: [], legible };
  for (let r = 0; r < TH_ROLE_COUNT; r++) {
    const f = thFontFindInto(mut fs, r, legible, dirs);
    fs.f.push(f);
  }
  return fs;
}

// 役のフォントの置き場の番号（fonts.u[thFontSlot(fonts, TH_ROLE_SANS)] で Font を借りる）。
export function thFontSlot(fs: ThFonts, role: i32): usize {
  return fs.f[role as usize].slot;
}

// 文字の段階（TH_TS_*）に使う役。
export function thTsRole(ts: i32): i32 {
  const i = ts as usize;
  if (TH_TS_FAMILY[i] == TH_FAMILY_MONO) {
    if (TH_TS_WEIGHT[i] >= TH_WEIGHT_MEDIUM) {
      return TH_ROLE_MONO_MEDIUM;
    }
    return TH_ROLE_MONO;
  }
  if (TH_TS_WEIGHT[i] >= TH_WEIGHT_SEMIBOLD) {
    return TH_ROLE_SANS_SEMIBOLD;
  }
  return TH_ROLE_SANS;
}

// 同じフォントをもう 1 つ読む（uikit の ukNew は Font を own で受け取り、Font には複製の口がないため。
// uikit が Font を借りて受け取れるようになれば要らない。報告の「uikit に足すべきもの」）。
export function thFontReload(f: ThFont): Font {
  if (f.path.length > 0) {
    const g = loadFont(f.path, f.index);
    if (g.ok) {
      return g;
    }
  }
  return defaultFont();
}

// 予備を使っているか（tokens.json のファミリーが見つからなかった）。
export function thFontIsSubstitute(f: ThFont): bool {
  return f.family != f.wanted;
}
