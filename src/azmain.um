// 解析の部品（src/effects/analyze/）を単独で試すための入口。mozcut analyze ... の代わりに
//   node <UM>/src/cli.ts build src/azmain.um --target host -o build/mozcut-analyze
//   build/mozcut-analyze video demo.y4m --json
// のように使う。本体へ組み込んだ後は main.um の analyze から azRun を呼ぶので、このファイルは試験用。
import { azRun } from "./effects/analyze/cli.um";

export function main(): i32 {
  // args() はプログラムの名前を含まない（main.um と同じ）
  return azRun(args());
}
