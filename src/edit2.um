// MozaicCut の新しい編集画面（v0.2）。docs/design/mockups/edit.html の配置で、画面の部品（src/uikit/ と src/ui_*/）を並べる。
// 中身はプロジェクト（.mzc）を読んで作り、モニターには render.um で描いたコマを出す。
// 部品から出てくる出来事は src/edit2/wire_*.um が受ける（docs/design/edit2.md）。古い編集画面は src/editor.um。
//
//   mozcut-edit <project.mzc> [<cache>] [--managed] [--home <dir>]     node tools/mozcut.mjs edit <project.mzc> か、
//                                  エクスプローラーで .mzc を exe に落とす・「プログラムから開く」で選ぶ
//   mozcut-edit [--home <dir>]     プロジェクトなしならスタート画面（src/edit2/start.um）を出し、選んだものを同じ窓で開く
//   --home は最近の一覧（<home>/mozcut-recent.txt）の置き場所。省くと %APPDATA%/MozaicCut（e2GuessHome）
//   試し用: --frames N（N フレームで終わる）--shot x.bmp（終わるときの画面）--size 1440x900 --scale 1.0
//           --seek <時刻> --select <クリップの ID / @行番号>（「,」で区切ると複数）--play <速さ>
//           --down x,y@F / --move x,y@F / --up x,y@F / --click x,y@F / --rclick x,y@F（F フレーム目にマウスの入力を入れる。境目のドラッグの試しなど）
//           --key <キー>@F（ctrl+k・enter・esc・down・f1・a など。F フレーム目にキーを押す）--text <文字>@F（文字を打つ）
//           --wheel <段>@F（いまのマウスの位置でホイール。上が正）--mods <s・c・a の組み>@F（押したままの修飾キー。"-" で放す）
//           --drop <file>（何度でも。編集画面の 2 フレーム目に、窓の外からそのファイルを落としたことにする）
//           --drop-at <x>,<y>（落とした位置。既定は 10,20 で上の帯 → タイムラインの末尾に足す）
//           --stats（終わるときに再生の統計 playback: {...}、音の再生 audio: {...}（apStatsJson。鳴らした標本の数 played など）、
//           モニターの描画の時間とコマ落ち monitor: {...} を標準エラーに出す）
//   ウィンドウを出さずに試すときは SDL_VIDEO_DRIVER=offscreen（音は SDL_AUDIO_DRIVER=dummy）を付ける。
import { parseNum, parseTime, isNan, textStartsWith, splitBy } from "./text.um";
import { findClip } from "./project.um";
import {
  UkCtx, ukNew, ukBegin, ukEnd, ukInvalidate, ukEventMouseMove, ukEventMouseButton, ukEventKey, ukEventText, ukEventWheel, ukEventMods, ukEndImage, ukWantsFrame, ukDrawRect, ukSetFont, ukSetFallbackFont, UK_FONT_SEMIBOLD,
  UK_FONT_MONO, UK_FONT_MONO_MEDIUM, ukEventDropBegin, ukEventDropFile, ukEventDropComplete,
} from "./uikit/core.um";
import { UkRect, ukRect } from "./uikit/base.um";
import { ukWinResNew, ukFeedWindowEvent } from "./uikit/window.um";
import { ukWriteBmp } from "./uikit/bmp.um";
import { uiFont, loadFont, Font, decodeUtf8 } from "./ttf.um";
import { PrefetchWorker, newPrefetchWorker, pbWorkerSync, pbPrefetchRun, pbWorkerBudget, pbShown, pbStatsJson } from "./playback.um";
import { PoolEv, poolPanel } from "./ui_pool/pool_panel.um";
import { tlTimeline } from "./ui_timeline/timeline.um";
import { TlResult } from "./ui_timeline/tl_model.um";
import {
  MonAct, MonMedia, MonCanvas, monMediaEmpty, monPanel, monKeys, monCanvasNew, monCanvasBegin, monWantPicSize, MON_PROGRAM,
} from "./ui_monitor/monitor.um";
import { InsEvent } from "./ui_inspector/ins_model.um";
import { insDraw } from "./ui_inspector/inspector.um";
import { AiEvent } from "./ui_ai/ai_model.um";
import { aiTabBar, aiTabHistory, aiTabAi } from "./ui_ai/ai_panel.um";
import { E2, e2New, e2Poll, e2Undo, e2Redo, e2SetStatus, e2PbRequest, e2BaseName, e2CacheFor, e2ReadText, E2_PB_SEEK, E2_PB_PLAY } from "./edit2/e2_state.um";
import { FrameCache, Playback } from "./playback.um";
import { RenderCache, newRenderCache } from "./render.um";
import {
  E2Canvas, E2Pic, e2PlaybackNew, e2FrameCacheNew, e2CanvasNew, e2PicNew, e2ClockTick, e2PreviewRender,
} from "./edit2/e2_clock.um";
import { E2Kit, E2View, e2KitNew, e2ViewNew, e2ViewSync, E2_TAB_INSPECTOR, E2_TAB_HISTORY, E2_TAB_AI, E2_WS_EDIT, E2_WS_COLOR, E2_WS_AUDIO, E2_WS_OUTPUT } from "./edit2/e2_view.um";
import { E2Lay, e2Layout } from "./edit2/e2_layout.um";
