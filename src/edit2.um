// MozaicCut の新しい編集画面（v0.2）。docs/design/mockups/edit.html の配置で、画面の部品（src/uikit/ と src/ui_*/）を並べる。
// 中身はプロジェクト（.mzc）を読んで作り、モニターには render.um で描いたコマを出す。
// 部品から出てくる出来事は src/edit2/wire_*.um が受ける（docs/design/edit2.md）。古い編集画面は src/editor.um。
//
//   mozcut-edit <project.mzc> [<cache>] [--managed] [--home <dir>]     ふつうは node tools/mozcut.mjs edit <project.mzc> から
//   試し用: --frames N（N フレームで終わる）--shot x.bmp（終わるときの画面）--size 1440x900 --scale 1.0
//           --seek <時刻> --select <クリップの ID / @行番号>（「,」で区切ると複数）--play <速さ>
//           --down x,y@F / --move x,y@F / --up x,y@F / --click x,y@F（F フレーム目にマウスの入力を入れる。境目のドラッグの試しなど）
//           --key <キー>@F（ctrl+k・enter・esc・down・f1・a など。F フレーム目にキーを押す）--text <文字>@F（文字を打つ）
//           --wheel <段>@F（いまのマウスの位置でホイール。上が正）--mods <s・c・a の組み>@F（押したままの修飾キー。"-" で放す）
//           --stats（終わるときに再生の統計 playback: {...} と、モニターの描画の時間とコマ落ち monitor: {...} を標準エラーに出す）
//   ウィンドウを出さずに試すときは SDL_VIDEO_DRIVER=offscreen（音は SDL_AUDIO_DRIVER=dummy）を付ける。
import { parseNum, parseTime, isNan, textStartsWith } from "./text.um";
import { findClip } from "./project.um";
import {
  UkCtx, ukNew, ukBegin, ukEventMouseMove, ukEventMouseButton, ukEventKey, ukEventText, ukEventWheel, ukEventMods, ukEndImage, ukWantsFrame, ukDrawRect, ukSetFont, ukSetFallbackFont, ukToast, UK_FONT_SEMIBOLD,
  UK_FONT_MONO, UK_FONT_MONO_MEDIUM,
} from "./uikit/core.um";
import { UkRect, ukRect } from "./uikit/base.um";
import { ukWinResNew, ukFeedWindowEvent } from "./uikit/window.um";
import { ukWriteBmp } from "./uikit/bmp.um";
import { uiFont, loadFont, Font, decodeUtf8 } from "./ttf.um";
import { PrefetchWorker, newPrefetchWorker, pbPrefetchRun, pbWorkerBudget, pbShown, pbStatsJson } from "./playback.um";
import { PoolEv, poolPanel } from "./ui_pool/pool_panel.um";
import { tlTimeline } from "./ui_timeline/timeline.um";
import { TlResult } from "./ui_timeline/tl_model.um";
import {
  MonAct, MonMedia, MonCanvas, monMediaEmpty, monPanel, monKeys, monCanvasNew, monCanvasBegin, monWantPicSize, MON_PROGRAM,
} from "./ui_monitor/monitor.um";
import { InsEvent } from "./ui_inspector/ins_model.um";
import { insDraw } from "./ui_inspector/inspector.um";
import { AiEvent } from "./ui_ai/ai_model.um";
import { aiTabBar, aiTabHistory, aiTabAi } from "./ui_ai/ai_panel.um";
import { E2, e2New, e2Poll, e2Undo, e2Redo, e2SetStatus, e2PbRequest, e2BaseName, e2CacheFor, e2ReadText, E2_PB_SEEK, E2_PB_PLAY } from "./edit2/e2_state.um";
import { FrameCache, Playback } from "./playback.um";
import { RenderCache, newRenderCache } from "./render.um";
import {
  E2Canvas, E2Pic, e2PlaybackNew, e2FrameCacheNew, e2CanvasNew, e2PicNew, e2ClockTick, e2PreviewRender,
} from "./edit2/e2_clock.um";
import { E2Kit, E2View, e2KitNew, e2ViewNew, e2ViewSync, E2_TAB_INSPECTOR, E2_TAB_HISTORY, E2_TAB_AI, E2_WS_EDIT, E2_WS_COLOR, E2_WS_AUDIO, E2_WS_OUTPUT } from "./edit2/e2_view.um";
import { E2Lay, e2Layout } from "./edit2/e2_layout.um";
import { e2TopBar, e2Rail, e2Meter, e2StatusBar, e2EmptyPanel } from "./edit2/e2_chrome.um";
import { e2DropTake } from "./edit2/e2_drop.um";
import { e2ScriptKey, e2ScriptMods } from "./edit2/e2_script.um";
import { wireTimeline, wireTimelineKeys } from "./edit2/wire_timeline.um";
import { wireMonitor, wireMonMedia, wireMonPicSize, wireMonAudioClock, wireMonStats, wireMonStatsJson } from "./edit2/wire_monitor.um";
import { wireInspector, wireRightColumn, wireInspectorPrep } from "./edit2/wire_inspector.um";
import { wirePool, wirePoolDropPreview } from "./edit2/wire_pool.um";

// 上の帯・レール・状態の帯から来たコマンドを実行する（部品の配線ではなく、画面の枠のもの）。
function e2RunCommand(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, cmd: string): void {
  if (cmd == "") {
    return;
  }
  if (cmd == "undo") {
    e2Undo(mut ed);
  } else if (cmd == "redo") {
    e2Redo(mut ed);
  } else if (cmd == "app.quit") {
    ed.quit = true;
  } else if (cmd == "file.save") {
    e2SetStatus(mut ed, "操作のたびに保存しています（保存済み）", false);
  } else if (cmd == "workspace.edit") {
    v.workspace = E2_WS_EDIT;
  } else if (cmd == "workspace.color" || cmd == "workspace.audio" || cmd == "workspace.export") {
    ukToast(mut ui, "このワークスペースはまだつないでいません（カット編集だけ）", 0);
  } else if (cmd == "view.rightColumn") {
    v.rightOpen = !v.rightOpen;
  } else if (cmd == "view.focusMode") {
    const open = !(v.leftOpen || v.rightOpen);
    v.leftOpen = open;
    v.rightOpen = open;
  } else if (cmd == "view.resetLayout") {
    v.leftW = 260;
    v.rightW = 320;
    v.tlFrac = 0.44;
    v.leftOpen = true;
    v.rightOpen = true;
  } else if (cmd == "palette.open") {
    ukToast(mut ui, "コマンドパレットはまだありません", 0);
  } else if (cmd == "panel.problems") {
    v.leftOpen = true;
    v.railSel = 5;
  }
}

// 1 フレーム: 配置を決め、部品を並べ、出来事を配線のファイルに渡す。
function e2Frame(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, cv: mut MonCanvas, pic: E2Pic, W: i32, H: i32): void {
  ukDrawRect(mut ui, ukRect(0, 0, W, H), kit.th.c.bg0);
  // 全画面（F11。wire_monitor.um の v.wm.full）: モニターだけを窓いっぱいに描く
  if (v.wm.full) {
    let facts: MonAct[] = [];
    const fm = wireMonMedia(ed, v);
    monPanel(mut ui, mut v.mon, mut cv, kit.monTh, ukRect(0, 0, W, H), fm, pic.img, pic.w, pic.h, pic.serial, mut facts);
    monKeys(mut ui, mut v.mon, fm, mut facts);
    wireMonitor(mut ui, mut ed, mut kit, mut v, facts);
    return;
  }
  const L = e2Layout(mut ui, kit, mut v, W, H);
  // タイムラインの編集のキー（S・Delete・Ctrl+Z など）は、モニターのキー（monKeys）より先に取る
  wireTimelineKeys(mut ui, mut ed, mut kit, mut v, L.tl);
  let cmds: string[] = [];
  // 上の帯
  cmds.push(e2TopBar(mut ui, ed, kit, mut v, L.top));
  // レールと左の欄
  const rs = e2Rail(mut ui, ed, kit, mut v, L.rail);
  if (rs == -1) {
    v.leftOpen = false;
  } else if (rs >= 0) {
    v.railSel = rs;
    v.leftOpen = true;
  }
  if (L.left.w > 0) {
    if (v.railSel == 0) {
      const pev = poolPanel(mut ui, kit.poolTk, kit.lib, mut v.pool, L.left);
      wirePool(mut ui, mut ed, mut kit, mut v, pev);
    } else {
      const names: string[] = ["素材", "効果", "文字", "音", "テキスト", "問題", "設定"];
      e2EmptyPanel(mut ui, kit, L.left, names[v.railSel as usize], "まだつないでいません");
    }
  }
  // モニター（プログラム）
  if (L.mon.w > 0 && L.mon.h > 0) {
    let acts: MonAct[] = [];
    const m = wireMonMedia(ed, v);
    monPanel(mut ui, mut v.mon, mut cv, kit.monTh, L.mon, m, pic.img, pic.w, pic.h, pic.serial, mut acts);
    monKeys(mut ui, mut v.mon, m, mut acts);
    wireMonitor(mut ui, mut ed, mut kit, mut v, acts);
  }
  // 右の列（インスペクタ ／ 履歴 ／ AI）
  if (L.right.w > 0) {
    const tabH = kit.aiTh.tabBar;
    const names: string[] = ["インスペクタ", "履歴", "AI"];
    v.rightTab = aiTabBar(mut ui, kit.aiTh, ukRect(L.right.x, L.right.y, L.right.w, tabH), names, v.rightTab, 2, 0);
    const body = ukRect(L.right.x, L.right.y + tabH, L.right.w, Math.max(L.right.h - tabH, 0));
    if (v.rightTab == E2_TAB_INSPECTOR) {
      ukDrawRect(mut ui, body, kit.th.c.bg1);
      wireInspectorPrep(ed, mut kit);
      const ievs = insDraw(mut ui, kit.insTh, kit.insModel, mut v.ins, body);
      wireInspector(mut ui, mut ed, mut kit, mut v, ievs);
    } else {
      let aevs: AiEvent[] = [];
      if (v.rightTab == E2_TAB_HISTORY) {
        aiTabHistory(mut ui, kit.aiTh, mut v.ai, body, mut aevs);
      } else {
        aiTabAi(mut ui, kit.aiTh, mut v.ai, body, mut aevs);
      }
      wireRightColumn(mut ui, mut ed, mut kit, mut v, aevs);
    }
  }
  // タイムラインとメーター
  let trimNote = "";
  if (L.tl.h > 0) {
    const res = tlTimeline(mut ui, mut v.tl, ed.project, L.tl);
    const sc = kit.scale;
    const tk = v.tl.tok;
    const bar = Math.floor(tk.sizeTimelineToolbar * sc + 0.5) as i32;
    const mw = Math.floor(tk.sizeMeter * sc + 0.5) as i32;
    const hs = Math.floor(tk.sizeScrollbar * sc + 0.5) as i32;
    e2Meter(mut ui, kit, ukRect(L.tl.x + L.tl.w - mw, L.tl.y + bar, mw, Math.max(L.tl.h - bar - hs, 0)));
    if (res.trimming) {
      trimNote = res.status.clone();
    }
    wireTimeline(mut ui, mut ed, mut kit, mut v, res, L.tl);
    // 素材の欄から運んできた素材の、落とす先の影（落としたときの add は wireTimeline）
    wirePoolDropPreview(mut ui, ed, kit, mut v, L.tl);
  }
  // 状態の帯
  cmds.push(e2StatusBar(mut ui, ed, kit, mut v, L.status, trimNote));
  // 窓の外からのドロップ
  e2DropTake(mut ui, mut ed, mut kit, mut v, L);
  for (const c of cmds) {
    e2RunCommand(mut ui, mut ed, mut kit, mut v, c);
  }
}

// 試し用のマウスの入力（--down / --move / --up / --click x,y@F）。
struct E2Ev {
  frame: i64;
  kind: i32;
  x: i32;
  y: i32;
  // --key のキー（UK_KEY_*）と修飾キー、--text の文字
  key: i32;
  mods: i32;
  text: string;
}

function e2ParseEv(opt: string, val: string, out: mut E2Ev[]): bool {
  let kind = 0;
  if (opt == "--down") {
    kind = 1;
  } else if (opt == "--move") {
    kind = 2;
  } else if (opt == "--up") {
    kind = 3;
  } else if (opt == "--click") {
    kind = 4;
  } else if (opt == "--key" || opt == "--text" || opt == "--wheel" || opt == "--mods") {
    return e2ParseKeyEv(opt, val, mut out);
  } else {
    return false;
  }
  const at = e2FindB(val, 64);
  const comma = e2FindB(val, 44);
  if (at < 0 || comma < 0 || comma > at) {
    eprint(`warning: ${opt} は x,y@F の形で書きます（'${val}'）`);
    return true;
  }
  let xs: u8[] = [];
  let ys: u8[] = [];
  let fs: u8[] = [];
  for (let k: usize = 0; k < val.length; k++) {
    const kk = k as i64;
    if (kk < comma) {
      xs.push(val[k]);
    } else if (kk > comma && kk < at) {
      ys.push(val[k]);
    } else if (kk > at) {
      fs.push(val[k]);
    }
  }
  out.push({
    frame: parseNum(stringFromBytes(fs)) as i64, kind, x: parseNum(stringFromBytes(xs)) as i32, y: parseNum(stringFromBytes(ys)) as i32,
    key: 0, mods: 0, text: "",
  });
  return true;
}

// --key <キー>@F と --text <文字>@F（区切りは最後の @）。
function e2ParseKeyEv(opt: string, val: string, out: mut E2Ev[]): bool {
  let at: i64 = -1;
  for (let k: usize = 0; k < val.length; k++) {
    if (val[k] == 64) {
      at = k as i64;
    }
  }
  if (at < 0) {
    eprint(`warning: ${opt} は <値>@F の形で書きます（'${val}'）`);
    return true;
  }
  let vs: u8[] = [];
  let fs: u8[] = [];
  for (let k: usize = 0; k < val.length; k++) {
    if ((k as i64) < at) {
      vs.push(val[k]);
    } else if ((k as i64) > at) {
      fs.push(val[k]);
    }
  }
  const body = stringFromBytes(vs);
  const frame = parseNum(stringFromBytes(fs)) as i64;
  if (opt == "--text") {
    out.push({ frame, kind: 6, x: 0, y: 0, key: 0, mods: 0, text: body });
    return true;
  }
  if (opt == "--wheel") {
    out.push({ frame, kind: 7, x: 0, y: parseNum(body) as i32, key: 0, mods: 0, text: "" });
    return true;
  }
  if (opt == "--mods") {
    let m = 0;
    for (const c of body) {
      if (c == 115) {
        m = m | 1;
      } else if (c == 99) {
        m = m | 2;
      } else if (c == 97) {
        m = m | 4;
      }
    }
    out.push({ frame, kind: 8, x: 0, y: 0, key: 0, mods: m, text: "" });
    return true;
  }
  const key = e2ScriptKey(body);
  if (key == 0) {
    eprint(`warning: --key の '${body}' というキーは知りません`);
    return true;
  }
  out.push({ frame, kind: 5, x: 0, y: 0, key, mods: e2ScriptMods(body), text: "" });
  return true;
}

function e2ApplyEv(ui: mut UkCtx, e: E2Ev): void {
  if (e.kind == 5) {
    ukEventKey(mut ui, e.key, e.mods);
    return;
  }
  if (e.kind == 6) {
    for (const cp of decodeUtf8(e.text)) {
      ukEventText(mut ui, cp as u32);
    }
    return;
  }
  if (e.kind == 7) {
    ukEventWheel(mut ui, 0, e.y);
    return;
  }
  if (e.kind == 8) {
    ukEventMods(mut ui, e.mods);
    return;
  }
  ukEventMouseMove(mut ui, e.x, e.y);
  if (e.kind == 1 || e.kind == 4) {
    ukEventMouseButton(mut ui, e.x, e.y, 1, true);
  }
  if (e.kind == 3 || e.kind == 4) {
    ukEventMouseButton(mut ui, e.x, e.y, 1, false);
  }
}

function e2MonoFont(): Font {
  const f = loadFont("C:/Windows/Fonts/CascadiaMono.ttf", 0);
  if (f.ok) {
    return f;
  }
  return loadFont("C:/Windows/Fonts/consola.ttf", 0);
}

function e2FindB(s: string, b: u8): i64 {
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == b) {
      return i as i64;
    }
  }
  return -1;
}

// 実行ファイルのフォルダ（--home がないとき。tokens.json と最近の一覧の基準）。
function e2GuessHome(): string {
  const d = exeDir();
  if (d.length == 0) {
    return ".";
  }
  return d;
}

export function main(): i32 {
  const a = args();
  let pos: string[] = [];
  let managed = false;
  let home = "";
  let maxFrames: i64 = -1;
  let shot = "";
  let W: i32 = 1440;
  let H: i32 = 900;
  let scale: f32 = 1.0;
  let seek = "";
  let select = "";
  let play: f64 = 0.0;
  let stats = false;
  let evs: E2Ev[] = [];
  let i: usize = 0;
  while (i < a.length) {
    const opt = a[i].clone();
    if (!textStartsWith(opt, "--")) {
      pos.push(opt);
      i++;
      continue;
    }
    if (opt == "--managed") {
      managed = true;
      i++;
      continue;
    }
    if (opt == "--stats") {
      stats = true;
      i++;
      continue;
    }
    if (i + 1 >= a.length) {
      eprint(`error: ${opt} には値が要ります`);
      return 2;
    }
    const val = a[i + 1].clone();
    if (opt == "--home") {
      home = val;
    } else if (opt == "--frames") {
      const n = parseNum(val);
      if (!isNan(n)) {
        maxFrames = n as i64;
      }
    } else if (opt == "--shot") {
      shot = val;
    } else if (opt == "--size") {
      const x = e2FindB(val, 120);
      if (x > 0) {
        let wb: u8[] = [];
        let hb: u8[] = [];
        for (let k: usize = 0; k < val.length; k++) {
          if ((k as i64) < x) {
            wb.push(val[k]);
          } else if ((k as i64) > x) {
            hb.push(val[k]);
          }
        }
        W = parseNum(stringFromBytes(wb)) as i32;
        H = parseNum(stringFromBytes(hb)) as i32;
      }
    } else if (opt == "--scale") {
      const n = parseNum(val);
      if (!isNan(n)) {
        scale = n as f32;
      }
    } else if (opt == "--seek") {
      seek = val;
    } else if (opt == "--select") {
      select = val;
    } else if (opt == "--play") {
      const n = parseNum(val);
      if (!isNan(n)) {
        play = n;
      }
    } else if (!e2ParseEv(opt, val, mut evs)) {
      eprint(`warning: unknown option '${opt}'`);
    }
    i += 2;
  }
  if (pos.length == 0 || pos.length > 2) {
    eprint("usage: mozcut-edit <project.mzc> [<cache>] [--managed] [--home <dir>]   (normally started by: node tools/mozcut.mjs edit <project.mzc>)");
    return 2;
  }
  const path = pos[0].clone();
  if (e2ReadText(path) == "") {
    eprint(`error: cannot read '${path}'`);
    return 1;
  }
  let cache = e2CacheFor(path);
  if (pos.length == 2) {
    cache = pos[1].clone();
    managed = true;
  }
  if (home == "") {
    home = e2GuessHome();
  }
  let ed = e2New(path, cache, home, managed);
  let kit = e2KitNew(home, scale);
  let v = e2ViewNew(home);
  e2ViewSync(ed, mut kit, mut v);
  if (select != "") {
    // 「,」で区切ると複数を選ぶ（インスペクタの「（混在）」の試しなど）
    let sel: i32[] = [];
    let part: u8[] = [];
    for (let k: usize = 0; k <= select.length; k++) {
      if (k == select.length || select[k] == 44) {
        const ci = findClip(ed.project, stringFromBytes(part));
        if (ci >= 0) {
          sel.push(ci);
        }
        part = [];
      } else {
        part.push(select[k]);
      }
    }
    v.tl.sel = sel;
  }
  if (seek != "") {
    const t = parseTime(seek);
    if (!isNan(t)) {
      e2PbRequest(mut ed, E2_PB_SEEK, t);
    }
  }
  if (play != 0.0) {
    e2PbRequest(mut ed, E2_PB_PLAY, play);
  }
  let ui = ukNew(kit.uk, own uiFont());
  ukSetFont(mut ui, UK_FONT_SEMIBOLD, own loadFont("C:/Windows/Fonts/YuGothB.ttc", 1));
  ukSetFont(mut ui, UK_FONT_MONO, own e2MonoFont());
  ukSetFont(mut ui, UK_FONT_MONO_MEDIUM, own e2MonoFont());
  ukSetFallbackFont(mut ui, own uiFont());
  const opened = windowOpen(`MozaicCut - ${e2BaseName(path)}`, W, H);
  if (opened == null) {
    eprint("error: could not open a window");
    return 1;
  }
  const win = opened;
  let px = new Buffer<u32>((W * H) as u32);
  let fc = e2FrameCacheNew(ed);
  let pb = e2PlaybackNew(mut ed, fc);
  let rc = newRenderCache();
  let cvs = e2CanvasNew(ed);
  let pic = e2PicNew();
  let cv = monCanvasNew();
  let wk = newPrefetchWorker(ed.cache);
  let frames: i64 = 0;
  const fixedTime = maxFrames >= 0;
  let running = true;
  let isFull = false;
  while (running) {
    let res = ukWinResNew();
    let first = true;
    while (true) {
      let to: i32 = 0;
      if (first && !fixedTime && !ukWantsFrame(ui) && !ed.playing) {
        to = 30;
      }
      first = false;
      const e = pollWindowEvent(to);
      if (e == null) {
        break;
      }
      ukFeedWindowEvent(mut ui, e, mut res);
    }
    for (const ev of evs) {
      if (ev.frame == frames) {
        e2ApplyEv(mut ui, ev);
      }
    }
    if (res.quit) {
      running = false;
    }
    if (res.resized && (res.w != W || res.h != H)) {
      W = res.w;
      H = res.h;
      px = new Buffer<u32>((W * H) as u32);
    }
    e2Poll(mut ed, clock());
    const frameT0 = clock();
    wireMonAudioClock(mut pb, frameT0);
    const changed = e2ClockTick(mut ed, mut pb, mut fc, mut cvs, clock());
    e2ViewSync(ed, mut kit, mut v);
    // プレビューは、モニターの絵の場所の大きさで描く（前のフレームの配置。最初はプロジェクトの大きさ）
    // （拡大して見るときもプロジェクトの大きさまで。画質 1/2・1/4 で小さく。wire_monitor.um の wireMonPicSize）
    const want = wireMonPicSize(ed, v);
    const renderT0 = clock();
    const drew = e2PreviewRender(mut ed, pb, fc, mut rc, mut cvs, mut pic, changed, want.w, want.h);
    const renderSec = clock() - renderT0;
    // 先読みのスレッドは、部品を描いて画面に出すあいだ走らせ、最後に合流する
    const h = thread.spawn(pbPrefetchRun, own wk, fc, clock() + pbWorkerBudget(pb));
    let now = clock();
    if (fixedTime) {
      now = (frames as f64) / 60.0;
    }
    ukBegin(mut ui, W, H, now);
    monCanvasBegin(mut cv, W, H);
    e2Frame(mut ui, mut ed, mut kit, mut v, mut cv, pic, W, H);
    ukEndImage(mut ui, mut px, cv.img, cv.w, cv.h);
    windowPresent(win, px, W, H);
    pbShown(mut pb, clock());
    wk = thread.join(h);
    wireMonStats(mut v, pb, ed.playing, drew, renderSec, clock() - frameT0);
    // 全画面の切り替え（F11 / Esc。窓の大きさが変わると次のフレームで res.resized が来る）
    if (v.wm.full != isFull) {
      windowSetFullscreen(win, v.wm.full);
      isFull = v.wm.full;
    }
    if (ed.quit) {
      running = false;
    }
    frames++;
    if (maxFrames >= 0 && frames >= maxFrames) {
      running = false;
    }
  }
  if (shot.length > 0) {
    if (!ukWriteBmp(shot, px, W, H)) {
      eprint(`error: cannot write '${shot}'`);
    }
  }
  if (stats) {
    eprint(`playback: ${pbStatsJson(pb, fc)}`);
    eprint(`monitor: ${wireMonStatsJson(ed, v)}`);
  }
  windowClose(win);
  return 0;
}
