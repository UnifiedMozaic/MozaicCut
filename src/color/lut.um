// 色の処理: LUT（.cube の読み取りと、1D / 3D の LUT を掛ける kernel）。
//
// .cube（Adobe Cube LUT 1.0 と DaVinci Resolve の書き方）:
//   TITLE "名前"
//   LUT_1D_SIZE N（2..65536） / LUT_3D_SIZE N（2..256）
//   DOMAIN_MIN r g b / DOMAIN_MAX r g b（既定 0 0 0 / 1 1 1）
//   LUT_1D_INPUT_RANGE min max / LUT_3D_INPUT_RANGE min max（Resolve の書き方）
//   # で始まる行は注釈。キーワードはデータより前に書く。
//   データは 1 行に 3 つの数（R G B）。3D は R が最も速く変わる（index = r + g N + b N²）。
//   1D と 3D の両方があれば（Resolve のシェーパー付き）、1D のデータが先で、1D → 3D の順に掛ける。
// 壊れたファイルは、原因コード・行・列・直し方つきの診断（ColDiag。project.um の Diag と同じフィールド）にする。
//
// 掛ける（colApplyLutIn）: ふつうの .cube は符号化した 0..1 の信号を入力に作られているので、線形の層には LUT の入力の
// 空間（tf。colLutSpaceFind）を指定し、「tf で符号化 → 1D → 3D → 元の色と強さで混ぜる → 復号」を 1 つの kernel で行う。
// 強さは 1D にも効き、混ぜる相手は 1D を通す前の色。
//
// 診断のコード:
//   cube-bad-number    数として読めない
//   cube-data-columns  データの行の数が 3 つでない
//   cube-unknown-keyword（warning）知らないキーワード（その行は無視する）
//   cube-duplicate     同じキーワードが 2 回ある
//   cube-late-keyword  キーワードがデータの後にある
//   cube-bad-size      LUT_1D_SIZE / LUT_3D_SIZE が範囲の外か整数でない
//   cube-no-size       LUT_1D_SIZE も LUT_3D_SIZE もない
//   cube-count         データの行の数が大きさと合わない
//   cube-bad-domain    範囲の最小が最大以上
//   cube-unreadable    ファイルを読めない（colLoadCube）

import {
  COL_TF_LINEAR, COL_TF_SRGB, COL_TF_BT1886, COL_TF_PQ, COL_TF_HLG, COL_TF_COUNT, colClamp, colEncodeRgbTab, colDecodeRgbTab,
  colTfTabNew, colTfCheck,
} from "./transfer.um";

export struct ColDiag {
  code: string;
  severity: string;   // "error" / "warning"
  line: i32;          // 1 から（0 はファイル全体）
  col: i32;           // 1 から数えた文字の位置（0 は行全体）
  msg: string;
  hint: string;
  suggest: string;    // hint が「'x' のことですか？」なら x
}

export const COL_LUT_TRILINEAR: u32 = 0;
export const COL_LUT_TETRAHEDRAL: u32 = 1;

export struct ColLut {
  ok: bool;                   // error の診断が 0 個
  title: string;
  size1: u32;                 // 1D の大きさ（なければ 0）
  size3: u32;                 // 3D の大きさ（なければ 0）
  min1: vec4<f32>;            // 1D の入力の範囲
  max1: vec4<f32>;
  min3: vec4<f32>;            // 3D の入力の範囲
  max3: vec4<f32>;
  lut1: Buffer<vec4<f32>>;    // size1 個（なければ長さ 1）
  lut3: Buffer<vec4<f32>>;    // size3³ 個（なければ長さ 1）
}

function colDiagMake(code: string, sev: string, line: i32, col: i32, msg: string, hint: string): ColDiag {
  let suggest = "";
  // 「'x' のことですか？」の x
  if (hint.length > 2 && hint[0] == 39) {
    let k: usize = 1;
    while (k < hint.length && hint[k] != 39) {
      k++;
    }
    let bytes: u8[] = [];
    for (let j: usize = 1; j < k; j++) {
      bytes.push(hint[j]);
    }
    const rest = colSubStr(hint, k + 1, hint.length);
    if (colStartsWith(rest, " のことですか")) {
      suggest = stringFromBytes(bytes);
    }
  }
  return { code: code.clone(), severity: sev.clone(), line: line, col: col, msg: msg.clone(), hint: hint.clone(), suggest: suggest };
}

// 条件で 2 つの文字列から選ぶ（`? :` は文字列を選べないため）。
function colPick(c: bool, a: string, b: string): string {
  if (c) {
    return a.clone();
  }
  return b.clone();
}

function colSubStr(s: string, a: usize, b: usize): string {
  let bytes: u8[] = [];
  for (let k = a; k < b && k < s.length; k++) {
    bytes.push(s[k]);
  }
  return stringFromBytes(bytes);
}

function colStartsWith(s: string, p: string): bool {
  if (s.length < p.length) {
    return false;
  }
  for (let k: usize = 0; k < p.length; k++) {
    if (s[k] != p[k]) {
      return false;
    }
  }
  return true;
}

function colBytesStr(t: u8[], a: usize, b: usize): string {
  let bytes: u8[] = [];
  for (let k = a; k < b; k++) {
    bytes.push(t[k]);
  }
  return stringFromBytes(bytes);
}

function colUpper(s: string): string {
  let bytes: u8[] = [];
  for (let k: usize = 0; k < s.length; k++) {
    const c = s[k];
    bytes.push(c >= 97 && c <= 122 ? c - 32 : c);
  }
  return stringFromBytes(bytes);
}

// 小数の読み取り（[+-]digits[.digits][(e|E)[+-]digits]）。読めなければ null。
export function colParseNumber(s: string): f64 | null {
  const n = s.length;
  let k: usize = 0;
  let neg = false;
  if (k < n && (s[k] == 43 || s[k] == 45)) {
    neg = s[k] == 45;
    k++;
  }
  let mant: f64 = 0;
  let digits = 0;
  let sig = 0;
  let exp10: i32 = 0;
  while (k < n && s[k] >= 48 && s[k] <= 57) {
    if (sig < 18) {
      mant = mant * 10 + ((s[k] - 48) as f64);
      if (mant != 0) {
        sig++;
      }
    } else {
      exp10++;
    }
    digits++;
    k++;
  }
  if (k < n && s[k] == 46) {
    k++;
    while (k < n && s[k] >= 48 && s[k] <= 57) {
      if (sig < 18) {
        mant = mant * 10 + ((s[k] - 48) as f64);
        exp10--;
        if (mant != 0) {
          sig++;
        }
      }
      digits++;
      k++;
    }
  }
  if (digits == 0) {
    return null;
  }
  if (k < n && (s[k] == 101 || s[k] == 69)) {
    k++;
    let eneg = false;
    if (k < n && (s[k] == 43 || s[k] == 45)) {
      eneg = s[k] == 45;
      k++;
    }
    let e: i32 = 0;
    let ed = 0;
    while (k < n && s[k] >= 48 && s[k] <= 57) {
      if (e < 10000) {
        e = e * 10 + ((s[k] - 48) as i32);
      }
      ed++;
      k++;
    }
    if (ed == 0) {
      return null;
    }
    exp10 += eneg ? -e : e;
  }
  if (k != n) {
    return null;
  }
  let v = mant;
  if (v != 0) {
    let p: f64 = 1;
    let b: f64 = 10;
    let q = exp10 < 0 ? -exp10 : exp10;
    if (q > 400) {
      q = 400;
    }
    while (q > 0) {
      if ((q & 1) != 0) {
        p = p * b;
      }
      b = b * b;
      q = q >> 1;
    }
    v = exp10 < 0 ? v / p : v * p;
  }
  // f32 に収まらない値は数として扱わない（無限大になるため）。
  if (v > 3.4e38 || v != v) {
    return null;
  }
  return neg ? -v : v;
}

struct ColTok {
  start: usize;
  end: usize;
  col: i32;
}

// UTF-8 の文字の位置（1 から）。
function colCharCol(t: u8[], lineStart: usize, pos: usize): i32 {
  let c: i32 = 1;
  for (let k = lineStart; k < pos; k++) {
    if ((t[k] & 0xC0) != 0x80) {
      c++;
    }
  }
  return c;
}

const COL_CUBE_KEYS: i32 = 7;

function colCubeKey(k: i32): string {
  switch (k) {
    case 0: return "TITLE";
    case 1: return "LUT_1D_SIZE";
    case 2: return "LUT_3D_SIZE";
    case 3: return "DOMAIN_MIN";
    case 4: return "DOMAIN_MAX";
    case 5: return "LUT_1D_INPUT_RANGE";
    case 6: return "LUT_3D_INPUT_RANGE";
  }
  return "";
}

// 編集距離（近いキーワードを hint に出す）。
function colEditDistance(a: string, b: string): i32 {
  let prev: i32[] = [];
  for (let j: usize = 0; j <= b.length; j++) {
    prev.push(j as i32);
  }
  for (let i: usize = 1; i <= a.length; i++) {
    let cur: i32[] = [i as i32];
    for (let j: usize = 1; j <= b.length; j++) {
      const cost = a[i - 1] == b[j - 1] ? 0 : 1;
      cur.push(Math.min(Math.min(prev[j] + 1, cur[j - 1] + 1), prev[j - 1] + cost));
    }
    prev = cur;
  }
  return prev[b.length];
}

function colCubeNearest(w: string): string {
  let best = "";
  let bestD: i32 = 1000;
  for (let k = 0; k < COL_CUBE_KEYS; k++) {
    const d = colEditDistance(w, colCubeKey(k));
    if (d < bestD) {
      bestD = d;
      best = colCubeKey(k);
    }
  }
  if (bestD <= 3) {
    return best;
  }
  return "";
}

function colEmptyLut(): ColLut {
  return {
    ok: false, title: "", size1: 0, size3: 0,
    min1: vec4(0.0, 0.0, 0.0, 0.0), max1: vec4(1.0, 1.0, 1.0, 0.0),
    min3: vec4(0.0, 0.0, 0.0, 0.0), max3: vec4(1.0, 1.0, 1.0, 0.0),
    lut1: new Buffer<vec4<f32>>(1), lut3: new Buffer<vec4<f32>>(1),
  };
}

function colErrCount(diags: ColDiag[], from: usize): i32 {
  let n = 0;
  for (let k = from; k < diags.length; k++) {
    if (diags[k].severity == "error") {
      n++;
    }
  }
  return n;
}

// .cube を読む。診断は diags に足す。返り値の ok は、この呼び出しで error が出なかったか。
export function colParseCube(text: u8[], diags: mut ColDiag[]): ColLut {
  let lut = colEmptyLut();
  const first = diags.length;
  const n = text.length;
  let pos: usize = 0;
  if (n >= 3 && text[0] == 0xEF && text[1] == 0xBB && text[2] == 0xBF) {
    pos = 3;
  }
  let line: i32 = 0;
  let seen: i32[] = [0, 0, 0, 0, 0, 0, 0];   // キーワードの行（0 は未出）
  let size1: i64 = 0;
  let size3: i64 = 0;
  let sizeLine1: i32 = 0;
  let sizeLine3: i32 = 0;
  let dmin: f64[3] = [0, 0, 0];
  let dmax: f64[3] = [1, 1, 1];
  let r1min: f64 = 0;
  let r1max: f64 = 1;
  let r3min: f64 = 0;
  let r3max: f64 = 1;
  let data: f32[] = [];
  let dataRows: i64 = 0;
  let firstDataLine: i32 = 0;
  let lastDataLine: i32 = 0;
  let dataBad = false;
  while (pos < n) {
    line++;
    const ls = pos;
    while (pos < n && text[pos] != 10) {
      pos++;
    }
    let le = pos;
    if (le > ls && text[le - 1] == 13) {
      le--;
    }
    pos++;   // 改行を飛ばす
    // 語に分ける（# から後ろは注釈）
    let toks: ColTok[] = [];
    let k = ls;
    while (k < le) {
      while (k < le && (text[k] == 32 || text[k] == 9)) {
        k++;
      }
      if (k >= le || text[k] == 35) {
        break;
      }
      const s = k;
      if (text[k] == 34) {
        // "..." は 1 つの語（TITLE）
        k++;
        while (k < le && text[k] != 34) {
          k++;
        }
        if (k < le) {
          k++;
        }
      } else {
        while (k < le && text[k] != 32 && text[k] != 9) {
          k++;
        }
      }
      toks.push({ start: s, end: k, col: colCharCol(text, ls, s) });
    }
    if (toks.length == 0) {
      continue;
    }
    const c0 = text[toks[0].start];
    const isKey = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95;
    if (isKey) {
      const word = colUpper(colBytesStr(text, toks[0].start, toks[0].end));
      let key: i32 = -1;
      for (let q = 0; q < COL_CUBE_KEYS; q++) {
        if (word == colCubeKey(q)) {
          key = q;
        }
      }
      if (key < 0) {
        const near = colCubeNearest(word);
        let nh = "使えるのは TITLE / LUT_1D_SIZE / LUT_3D_SIZE / DOMAIN_MIN / DOMAIN_MAX / LUT_1D_INPUT_RANGE / LUT_3D_INPUT_RANGE です";
        if (near != "") {
          nh = `'${near}' のことですか？`;
        }
        diags.push(colDiagMake("cube-unknown-keyword", "warning", line, toks[0].col,
          `'${colBytesStr(text, toks[0].start, toks[0].end)}' というキーワードは知らないので、この行を無視します`,
          nh));
        continue;
      }
      if (dataRows > 0) {
        diags.push(colDiagMake("cube-late-keyword", "error", line, toks[0].col,
          `${colCubeKey(key)} がデータの後にあります`,
          `キーワードはデータ（${firstDataLine} 行目から）より前に書きます`));
        continue;
      }
      if (seen[key] != 0) {
        diags.push(colDiagMake("cube-duplicate", "error", line, toks[0].col,
          `${colCubeKey(key)} が 2 回あります（前は ${seen[key]} 行目）`, "どちらか 1 つを消してください"));
        continue;
      }
      seen[key] = line;
      if (key == 0) {
        if (toks.length >= 2) {
          let a = toks[1].start;
          let b = le;
          // 行の残り全体。引用符があれば外す
          while (b > a && (text[b - 1] == 32 || text[b - 1] == 9)) {
            b--;
          }
          if (b > a + 1 && text[a] == 34 && text[b - 1] == 34) {
            a++;
            b--;
          }
          lut.title = colBytesStr(text, a, b);
        }
        continue;
      }
      // 数を読む
      let want: usize = 1;
      if (key == 3 || key == 4) {
        want = 3;
      } else if (key == 5 || key == 6) {
        want = 2;
      }
      if (toks.length != want + 1) {
        let ex = `${colCubeKey(key)} 0.0 0.0 0.0`;
        if (want == 1) {
          ex = `${colCubeKey(key)} 33`;
        } else if (want == 2) {
          ex = `${colCubeKey(key)} 0.0 1.0`;
        }
        diags.push(colDiagMake("cube-data-columns", "error", line, toks.length > want + 1 ? toks[want + 1].col : 0,
          `${colCubeKey(key)} には数が ${want} つ要ります（${toks.length - 1} つあります）`, `${ex} のように書きます`));
        continue;
      }
      let vals: f64[3] = [0, 0, 0];
      let bad = false;
      for (let q: usize = 0; q < want; q++) {
        const v = colParseNumber(colBytesStr(text, toks[q + 1].start, toks[q + 1].end));
        if (v != null) {
          vals[q] = v;
        } else {
          diags.push(colDiagMake("cube-bad-number", "error", line, toks[q + 1].col,
            `'${colBytesStr(text, toks[q + 1].start, toks[q + 1].end)}' は数として読めません`, "0.5 や 1e-3 のように書きます"));
          bad = true;
        }
      }
      if (bad) {
        continue;
      }
      if (key == 1 || key == 2) {
        const mx: f64 = key == 1 ? 65536 : 256;
        const v = vals[0];
        if (v != Math.floor(v) || v < 2 || v > mx) {
          diags.push(colDiagMake("cube-bad-size", "error", line, toks[1].col,
            `${colCubeKey(key)} の ${colBytesStr(text, toks[1].start, toks[1].end)} は使えません`,
            `2 から ${mx} までの整数にします（よく使うのは ${colPick(key == 1, "1024 や 4096", "17 / 33 / 65")}）`));
          continue;
        }
        if (key == 1) {
          size1 = v as i64;
          sizeLine1 = line;
        } else {
          size3 = v as i64;
          sizeLine3 = line;
        }
      } else if (key == 3) {
        dmin = vals;
      } else if (key == 4) {
        dmax = vals;
      } else if (key == 5) {
        r1min = vals[0];
        r1max = vals[1];
      } else {
        r3min = vals[0];
        r3max = vals[1];
      }
      continue;
    }
    // データの行
    if (dataRows == 0) {
      firstDataLine = line;
    }
    lastDataLine = line;
    dataRows++;
    if (toks.length != 3) {
      diags.push(colDiagMake("cube-data-columns", "error", line, toks.length > 3 ? toks[3].col : 0,
        `データの行には数が 3 つ（R G B）要ります（${toks.length} つあります）`, "0.25 0.5 1.0 のように書きます"));
      dataBad = true;
      data.push(0);
      data.push(0);
      data.push(0);
      continue;
    }
    for (let q: usize = 0; q < 3; q++) {
      const v = colParseNumber(colBytesStr(text, toks[q].start, toks[q].end));
      if (v != null) {
        data.push(v as f32);
      } else {
        diags.push(colDiagMake("cube-bad-number", "error", line, toks[q].col,
          `'${colBytesStr(text, toks[q].start, toks[q].end)}' は数として読めません`, "0.5 や 1e-3 のように書きます"));
        dataBad = true;
        data.push(0);
      }
    }
  }
  // 全体の確かめ
  if (size1 == 0 && size3 == 0) {
    if (seen[1] == 0 && seen[2] == 0) {
      diags.push(colDiagMake("cube-no-size", "error", 0, 0, "LUT_1D_SIZE も LUT_3D_SIZE もありません",
        "データより前に LUT_3D_SIZE 33 のように大きさを書きます"));
    }
    lut.ok = false;
    return lut;
  }
  for (let q = 0; q < 3; q++) {
    if (!(dmin[q] < dmax[q])) {
      diags.push(colDiagMake("cube-bad-domain", "error", seen[4] != 0 ? seen[4] : seen[3], 0,
        `DOMAIN_MIN が DOMAIN_MAX 以上です（${colPick(q == 0, "R", colPick(q == 1, "G", "B"))} が${dmin[q]} と ${dmax[q]}）`,
        "DOMAIN_MIN 0.0 0.0 0.0 と DOMAIN_MAX 1.0 1.0 1.0 のように、最小を最大より小さくします"));
      break;
    }
  }
  if (!(r1min < r1max) && seen[5] != 0) {
    diags.push(colDiagMake("cube-bad-domain", "error", seen[5], 0,
      `LUT_1D_INPUT_RANGE の最小 ${r1min} が最大 ${r1max} 以上です`, "LUT_1D_INPUT_RANGE 0.0 1.0 のように書きます"));
  }
  if (!(r3min < r3max) && seen[6] != 0) {
    diags.push(colDiagMake("cube-bad-domain", "error", seen[6], 0,
      `LUT_3D_INPUT_RANGE の最小 ${r3min} が最大 ${r3max} 以上です`, "LUT_3D_INPUT_RANGE 0.0 1.0 のように書きます"));
  }
  const need = size1 + size3 * size3 * size3;
  if (dataRows != need) {
    let what = "";
    if (size1 > 0 && size3 > 0) {
      what = `LUT_1D_SIZE ${size1} と LUT_3D_SIZE ${size3} には ${need} 行（${size1} + ${size3}×${size3}×${size3}）`;
    } else if (size3 > 0) {
      what = `LUT_3D_SIZE ${size3} には ${need} 行（${size3}×${size3}×${size3}）`;
    } else {
      what = `LUT_1D_SIZE ${size1} には ${need} 行`;
    }
    const at = dataRows > need ? colNthDataLine(text, need + 1) : (lastDataLine != 0 ? lastDataLine : (sizeLine3 != 0 ? sizeLine3 : sizeLine1));
    diags.push(colDiagMake("cube-count", "error", at, 0,
      `データが ${dataRows} 行あります。${what}が要ります`,
      colPick(dataRows > need, "余分な行を消すか、大きさを直してください", "足りない行を足すか、大きさを直してください（ファイルが途中で切れていないか確かめてください）")));
  }
  if (colErrCount(diags, first) > 0 || dataBad) {
    lut.ok = false;
    return lut;
  }
  // 範囲: DOMAIN_* があればそれ、なければ *_INPUT_RANGE
  const hasDomain = seen[3] != 0 || seen[4] != 0;
  if (size1 > 0) {
    lut.size1 = size1 as u32;
    if (hasDomain) {
      lut.min1 = vec4(dmin[0] as f32, dmin[1] as f32, dmin[2] as f32, 0.0);
      lut.max1 = vec4(dmax[0] as f32, dmax[1] as f32, dmax[2] as f32, 0.0);
    } else {
      lut.min1 = vec4(r1min as f32, r1min as f32, r1min as f32, 0.0);
      lut.max1 = vec4(r1max as f32, r1max as f32, r1max as f32, 0.0);
    }
    let b = new Buffer<vec4<f32>>(lut.size1);
    for (let q: u32 = 0; q < lut.size1; q++) {
      const o = (q * 3) as usize;
      b[q] = vec4(data[o], data[o + 1], data[o + 2], 1.0);
    }
    lut.lut1 = b;
  }
  if (size3 > 0) {
    lut.size3 = size3 as u32;
    // シェーパーの後の 3D の範囲は、1D の出力（ふつう 0..1）。DOMAIN_* は 1D だけのとき 1D に、3D だけのとき 3D に掛かる。
    if (hasDomain && size1 == 0) {
      lut.min3 = vec4(dmin[0] as f32, dmin[1] as f32, dmin[2] as f32, 0.0);
      lut.max3 = vec4(dmax[0] as f32, dmax[1] as f32, dmax[2] as f32, 0.0);
    } else {
      lut.min3 = vec4(r3min as f32, r3min as f32, r3min as f32, 0.0);
      lut.max3 = vec4(r3max as f32, r3max as f32, r3max as f32, 0.0);
    }
    const cnt = (size3 * size3 * size3) as u32;
    let b = new Buffer<vec4<f32>>(cnt);
    const off = (size1 * 3) as usize;
    for (let q: u32 = 0; q < cnt; q++) {
      const o = off + (q * 3) as usize;
      b[q] = vec4(data[o], data[o + 1], data[o + 2], 1.0);
    }
    lut.lut3 = b;
  }
  lut.ok = true;
  return lut;
}

// m 番目（1 から）のデータの行の行番号。
function colNthDataLine(text: u8[], m: i64): i32 {
  let line: i32 = 0;
  let cnt: i64 = 0;
  let pos: usize = 0;
  const n = text.length;
  while (pos < n) {
    line++;
    let k = pos;
    while (k < n && (text[k] == 32 || text[k] == 9 || text[k] == 0xEF || text[k] == 0xBB || text[k] == 0xBF)) {
      k++;
    }
    if (k < n) {
      const c = text[k];
      const isData = c == 43 || c == 45 || c == 46 || (c >= 48 && c <= 57);
      if (isData) {
        cnt++;
        if (cnt == m) {
          return line;
        }
      }
    }
    while (pos < n && text[pos] != 10) {
      pos++;
    }
    pos++;
  }
  return 0;
}

// ファイルから読む。読めなければ cube-unreadable。
export function colLoadCube(path: string, diags: mut ColDiag[]): ColLut {
  const t = readFile(path);
  if (t != null) {
    return colParseCube(t, mut diags);
  }
  diags.push(colDiagMake("cube-unreadable", "error", 0, 0, `'${path}' を読めません`, "ファイルの場所と名前を確かめてください"));
  return colEmptyLut();
}

// 恒等の 3D LUT（大きさ n）の .cube の文。試しと、LUT を作る道具の雛形に使う。
// 文字列を 1 行ずつつなぐと時間が行の数の 2 乗になるので、u8[] に足してから最後に文字列にする（65 でも 1 秒かからない）。
export function colIdentityCube(n: i32): string {
  let out: u8[] = [];
  colPushStr(mut out, `TITLE "identity ${n}"\nLUT_3D_SIZE ${n}\n`);
  const d = (n - 1) as f64;
  for (let b = 0; b < n; b++) {
    for (let g = 0; g < n; g++) {
      for (let r = 0; r < n; r++) {
        colPushStr(mut out, `${(r as f64) / d} ${(g as f64) / d} ${(b as f64) / d}\n`);
      }
    }
  }
  return stringFromBytes(out);
}

// 文字列のバイトを足す（文を組み立てる道具）。
export function colPushStr(out: mut u8[], s: string): void {
  for (let k: usize = 0; k < s.length; k++) {
    out.push(s[k]);
  }
}

// ---- 診断の出力（report.um の diagText / diagsJson と同じ形） ----

function colJsonStr(s: string): string {
  let out: u8[] = [34];
  for (let k: usize = 0; k < s.length; k++) {
    const c = s[k];
    if (c == 34 || c == 92) {
      out.push(92);
      out.push(c);
    } else if (c == 10) {
      out.push(92);
      out.push(110);
    } else if (c == 13) {
      out.push(92);
      out.push(114);
    } else if (c == 9) {
      out.push(92);
      out.push(116);
    } else if (c < 32) {
      const hex = "0123456789abcdef";
      out.push(92);
      out.push(117);
      out.push(48);
      out.push(48);
      out.push(hex[(c >> 4) as usize]);
      out.push(hex[(c & 15) as usize]);
    } else {
      out.push(c);
    }
  }
  out.push(34);
  return stringFromBytes(out);
}

// "a.cube:7:12: エラー[cube-bad-number]: ..." と、hint があれば次の行に "  ヒント: ..."。
export function colDiagText(path: string, d: ColDiag): string {
  let loc = path.clone();
  if (d.line > 0) {
    loc = loc + `:${d.line}`;
    if (d.col > 0) {
      loc = loc + `:${d.col}`;
    }
  }
  let sev = "エラー";
  if (d.severity == "warning") {
    sev = "警告";
  }
  let s = `${loc}: ${sev}[${d.code}]: ${d.msg}`;
  if (d.hint != "") {
    s = s + `\n  ヒント: ${d.hint}`;
  }
  return s;
}

export function colDiagJson(d: ColDiag): string {
  let sug = "null";
  if (d.suggest != "") {
    sug = colJsonStr(d.suggest);
  }
  return `{"code":${colJsonStr(d.code)},"severity":${colJsonStr(d.severity)},"line":${d.line},"col":${d.col},"message":${colJsonStr(d.msg)},"hint":${colJsonStr(d.hint)},"suggest":${sug}}`;
}

export function colDiagsJson(diags: ColDiag[]): string {
  let s = "[";
  for (let k: usize = 0; k < diags.length; k++) {
    if (k > 0) {
      s = s + ",";
    }
    s = s + colDiagJson(diags[k]);
  }
  return s + "]";
}

// LUT の要約（JSON）。{"ok":..,"title":..,"size1d":..,"size3d":..,"domain1d":{min,max},"domain3d":{min,max}}
export function colLutJson(l: ColLut): string {
  return `{"ok":${l.ok},"title":${colJsonStr(l.title)},"size1d":${l.size1},"size3d":${l.size3},`
    + `"domain1d":{"min":[${l.min1.x},${l.min1.y},${l.min1.z}],"max":[${l.max1.x},${l.max1.y},${l.max1.z}]},`
    + `"domain3d":{"min":[${l.min3.x},${l.min3.y},${l.min3.z}],"max":[${l.max3.x},${l.max3.y},${l.max3.z}]}}`;
}

// ---- 掛ける（kernel） ----

export kernel function colLutCoord(v: f32, mn: f32, mx: f32, n: u32): f32 {
  const t = colClamp((v - mn) / (mx - mn), 0.0, 1.0);
  return t * ((n - 1) as f32);
}

// 1D: チャンネルごとに線形補間。
export kernel function colLut1Sample(lut: Buffer<vec4<f32>>, n: u32, c: vec3<f32>, mn: vec4<f32>, mx: vec4<f32>): vec3<f32> {
  const tr = colLutCoord(c.x, mn.x, mx.x, n);
  const tg = colLutCoord(c.y, mn.y, mx.y, n);
  const tb = colLutCoord(c.z, mn.z, mx.z, n);
  const ir = Math.min(tr as u32, n - 2);
  const ig = Math.min(tg as u32, n - 2);
  const ib = Math.min(tb as u32, n - 2);
  const fr = tr - (ir as f32);
  const fg = tg - (ig as f32);
  const fb = tb - (ib as f32);
  const r = lut[ir].x + (lut[ir + 1].x - lut[ir].x) * fr;
  const g = lut[ig].y + (lut[ig + 1].y - lut[ig].y) * fg;
  const b = lut[ib].z + (lut[ib + 1].z - lut[ib].z) * fb;
  return vec3(r, g, b);
}

// 3D: 三線形補間（mode 0）か四面体補間（mode 1）。
export kernel function colLut3Sample(
  lut: Buffer<vec4<f32>>, n: u32, c: vec3<f32>, mn: vec4<f32>, mx: vec4<f32>, mode: u32,
): vec3<f32> {
  const tr = colLutCoord(c.x, mn.x, mx.x, n);
  const tg = colLutCoord(c.y, mn.y, mx.y, n);
  const tb = colLutCoord(c.z, mn.z, mx.z, n);
  const ir = Math.min(tr as u32, n - 2);
  const ig = Math.min(tg as u32, n - 2);
  const ib = Math.min(tb as u32, n - 2);
  const fx = tr - (ir as f32);
  const fy = tg - (ig as f32);
  const fz = tb - (ib as f32);
  const nn = n * n;
  const base = ir + ig * n + ib * nn;
  const c000 = lut[base];
  const c100 = lut[base + 1];
  const c010 = lut[base + n];
  const c110 = lut[base + n + 1];
  const c001 = lut[base + nn];
  const c101 = lut[base + nn + 1];
  const c011 = lut[base + nn + n];
  const c111 = lut[base + nn + n + 1];
  let o = c000;
  if (mode == COL_LUT_TETRAHEDRAL) {
    if (fx > fy) {
      if (fy > fz) {
        o = c000 + fx * (c100 - c000) + fy * (c110 - c100) + fz * (c111 - c110);
      } else if (fx > fz) {
        o = c000 + fx * (c100 - c000) + fz * (c101 - c100) + fy * (c111 - c101);
      } else {
        o = c000 + fz * (c001 - c000) + fx * (c101 - c001) + fy * (c111 - c101);
      }
    } else {
      if (fz > fy) {
        o = c000 + fz * (c001 - c000) + fy * (c011 - c001) + fx * (c111 - c011);
      } else if (fz > fx) {
        o = c000 + fy * (c010 - c000) + fz * (c011 - c010) + fx * (c111 - c011);
      } else {
        o = c000 + fy * (c010 - c000) + fx * (c110 - c010) + fz * (c111 - c110);
      }
    }
  } else {
    const x00 = c000 + fx * (c100 - c000);
    const x10 = c010 + fx * (c110 - c010);
    const x01 = c001 + fx * (c101 - c001);
    const x11 = c011 + fx * (c111 - c011);
    const y0 = x00 + fy * (x10 - x00);
    const y1 = x01 + fy * (x11 - x01);
    o = y0 + fz * (y1 - y0);
  }
  return vec3(o.x, o.y, o.z);
}

export kernel function colLut1Kernel(
  i: u32, px: mut Buffer<vec4<f32>>, lut: Buffer<vec4<f32>>, n: u32, mn: vec4<f32>, mx: vec4<f32>,
): void {
  const c = px[i];
  const o = colLut1Sample(lut, n, vec3(c.x, c.y, c.z), mn, mx);
  px[i] = vec4(o.x, o.y, o.z, c.w);
}

export kernel function colLut3Kernel(
  i: u32, px: mut Buffer<vec4<f32>>, lut: Buffer<vec4<f32>>, n: u32, mn: vec4<f32>, mx: vec4<f32>, mode: u32,
): void {
  const c = px[i];
  const o = colLut3Sample(lut, n, vec3(c.x, c.y, c.z), mn, mx, mode);
  px[i] = vec4(o.x, o.y, o.z, c.w);
}

// LUT の全部を 1 回で: （tf で符号化）→ 1D（n1 >= 2 なら）→ 3D（n3 >= 2 なら）→ 元の色と amount で混ぜる →（tf で復号）。
// tf が COL_TF_LINEAR なら符号化も復号もしない（層の値をそのまま LUT に入れる）。
// 混ぜるのは LUT の入力の空間（符号化した信号）で行う。混ぜる相手は 1D を通す前の元の色。
export kernel function colLutFullKernel(
  i: u32, px: mut Buffer<vec4<f32>>,
  lut1: Buffer<vec4<f32>>, n1: u32, min1: vec4<f32>, max1: vec4<f32>,
  lut3: Buffer<vec4<f32>>, n3: u32, min3: vec4<f32>, max3: vec4<f32>,
  mode: u32, amount: f32, tf: u32, refNits: f32, enc: Buffer<f32>, dec: Buffer<f32>,
): void {
  const c = px[i];
  let v = vec3(c.x, c.y, c.z);
  if (tf != COL_TF_LINEAR) {
    v = colEncodeRgbTab(v, tf, refNits, enc);
  }
  let o = v;
  if (n1 >= 2) {
    o = colLut1Sample(lut1, n1, o, min1, max1);
  }
  if (n3 >= 2) {
    o = colLut3Sample(lut3, n3, o, min3, max3, mode);
  }
  if (amount < 1.0) {
    o = vec3(v.x + (o.x - v.x) * amount, v.y + (o.y - v.y) * amount, v.z + (o.z - v.z) * amount);
  }
  if (tf != COL_TF_LINEAR) {
    o = colDecodeRgbTab(o, tf, refNits, dec);
  }
  px[i] = vec4(o.x, o.y, o.z, c.w);
}

// LUT を掛ける空間の名前 → 伝達関数（クリップの lutspace=...）。知らなければ COL_TF_COUNT。
//   bt1886（既定。"rec709" / "bt709" / "gamma24" も同じ）: ふつうの見た目の LUT（Rec.709 の表示の信号を入力にするもの）
//   srgb: sRGB の画像用の LUT / pq: HDR10（PQ）用の LUT / hlg: HLG 用の LUT（BT.2020 の原色の層に）
//   linear: 層の値をそのまま入れる（線形の光を入力にする LUT か、すでに信号の値の層）
// カメラの Log（S-Log3、LogC など）用の LUT は、その Log の伝達関数をまだ持たないので扱えない。
export function colLutSpaceFind(name: string): u32 {
  if (name == "" || name == "bt1886" || name == "rec709" || name == "bt709" || name == "gamma24") { return COL_TF_BT1886; }
  if (name == "srgb") { return COL_TF_SRGB; }
  if (name == "pq" || name == "st2084") { return COL_TF_PQ; }
  if (name == "hlg") { return COL_TF_HLG; }
  if (name == "linear") { return COL_TF_LINEAR; }
  return COL_TF_COUNT;
}

// 層（n 個の画素。線形の光）に、tf の空間で LUT を掛ける。ふつうの .cube は符号化した 0..1 の信号を入力に作られて
// いるので、線形の層には tf = COL_TF_BT1886（SDR の見た目の LUT）や COL_TF_PQ（HDR の LUT）を指定する。
// 範囲（DOMAIN）の外の入力は端に収まる（SDR の LUT では基準の白より明るい値は 1.0 になる。LUT の性質）。
// amount（0..1）は 1D と 3D の両方に効く。amount <= 0 と、読めなかった LUT（ok = false）は何もしない。
// 成功なら ""、tf が正しくなければ理由（日本語）。
export function colApplyLutIn(px: mut Buffer<vec4<f32>>, n: u32, l: ColLut, tf: u32, refNits: f32, mode: u32, amount: f32): string {
  const e = colTfCheck(tf);
  if (e != "") {
    return e;
  }
  if (!l.ok || n == 0 || !(amount > 0.0) || (l.size1 < 2 && l.size3 < 2)) {
    return "";
  }
  const t = colTfTabNew(tf, refNits);
  dispatch(colLutFullKernel, n, mut px, l.lut1, l.size1, l.min1, l.max1, l.lut3, l.size3, l.min3, l.max3,
    mode, Math.min(amount, 1.0), tf, refNits, t.enc, t.dec);
  return "";
}

// 層の値をそのまま LUT に入れる形（colApplyLutIn の tf = COL_TF_LINEAR）。層がすでに LUT の入力の信号のときに。
export function colApplyLut(px: mut Buffer<vec4<f32>>, n: u32, l: ColLut, mode: u32, amount: f32): void {
  colApplyLutIn(mut px, n, l, COL_TF_LINEAR, 203.0, mode, amount);
}
