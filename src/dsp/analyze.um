// ファイル（s16le のステレオ。src/audio.um の mixAudio や ffmpeg の展開が書く形）を
// 1 秒ずつ読んで、ラウドネス・話し声の区間・波形を求める。結果は JSON と日本語の文で出せる。
import { dspFmt } from "./math.um";
import { DspLoudness, DspLoudnessResult, dspLoudnessNew, dspLoudnessProcess, dspLoudnessResult } from "./loudness.um";
import { DspSpeech, DspSegments, dspSpeechNew, dspSpeechProcess, dspSpeechSegments } from "./speech.um";

// s16le のバイト列を f32（-1..1）のステレオに直す。out は frames * 2 個にそろえる。
export function dspS16ToF32(bytes: u8[], out: mut f32[]): usize {
  const frames = bytes.length / 4;
  out.clear();
  for (let i: usize = 0; i < frames * 2; i++) {
    let v = (bytes[i * 2] as i32) | ((bytes[i * 2 + 1] as i32) << 8);
    if (v >= 32768) {
      v -= 65536;
    }
    out.push((v as f32) * (1.0 / 32768.0));
  }
  return frames;
}

// f32 のステレオを s16le に（丸めて -32768..32767 に収める）。
export function dspF32ToS16(buf: f32[], out: mut u8[]): void {
  out.clear();
  for (let i: usize = 0; i < buf.length; i++) {
    let v = Math.floor((buf[i] as f64) * 32768.0 + 0.5) as i32;
    v = Math.min(Math.max(v, -32768), 32767);
    out.push((v & 255) as u8);
    out.push(((v >> 8) & 255) as u8);
  }
}

// ファイルのラウドネス。読めなければ null。
export function dspLoudnessOfS16File(path: string, rate: f64): DspLoudnessResult | null {
  const size = fileSize(path);
  if (size == null) {
    return null;
  }
  let m = dspLoudnessNew(rate, 2);
  let buf: f32[] = [];
  const chunk = (Math.floor(rate + 0.5) as i64) * 4;
  let off: i64 = 0;
  while (off < size) {
    const bytes = readFileRange(path, off, chunk);
    if (bytes == null) {
      return null;
    }
    if (bytes.length == 0) {
      break;
    }
    const frames = dspS16ToF32(bytes, mut buf);
    dspLoudnessProcess(mut m, buf, 0, frames);
    off += bytes.length as i64;
  }
  return dspLoudnessResult(m);
}

// ファイルの話し声の区間。読めなければ null。
export function dspSpeechOfS16File(path: string, rate: f64): DspSegments | null {
  const size = fileSize(path);
  if (size == null) {
    return null;
  }
  let s = dspSpeechNew(rate);
  let buf: f32[] = [];
  const chunk = (Math.floor(rate + 0.5) as i64) * 4;
  let off: i64 = 0;
  while (off < size) {
    const bytes = readFileRange(path, off, chunk);
    if (bytes == null) {
      return null;
    }
    if (bytes.length == 0) {
      break;
    }
    const frames = dspS16ToF32(bytes, mut buf);
    dspSpeechProcess(mut s, buf, 0, frames);
    off += bytes.length as i64;
  }
  return dspSpeechSegments(s);
}
