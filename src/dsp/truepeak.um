// 真のピーク（標本と標本の間の山）の検出。4 倍のオーバーサンプリング（12 タップ × 4 相の多相 FIR）。
// ITU-R BS.1770-4 の附属書 2 と同じ考え方（係数は窓つき sinc をこの場で設計する）。
// 1 標本を入れるごとに、6 標本前の標本 x[n-6] と、そこから x[n-5] までの間の 3 点（1/4、2/4、3/4）の
// 絶対値の最大を、チャンネルごとに outL / outR に返す（遅れは 6 標本）。
import { DSP_PI, dspSin, dspCos } from "./math.um";

export const DSP_TP_TAPS: i32 = 12;
// 検出の遅れ（標本）
export const DSP_TP_DELAY: i32 = 6;

export struct DspTruePeak {
  // 相 1〜3 の係数（相ごとに 12 個）
  coef: f64[36];
  // 直近 12 標本の履歴（同じものを 2 回書いて、読むときに折り返さない）
  hl: f64[24];
  hr: f64[24];
  pos: i32;
  outL: f64;
  outR: f64;
}

function dspTpSinc(t: f64): f64 {
  if (Math.abs(t) < 1.0e-12) {
    return 1.0;
  }
  return dspSin(DSP_PI * t) / (DSP_PI * t);
}

export function dspTruePeakNew(): DspTruePeak {
  let coef: f64[36];
  let hl: f64[24];
  let hr: f64[24];
  let tp: DspTruePeak = { coef: coef, hl: hl, hr: hr, pos: 0, outL: 0.0, outR: 0.0 };
  // 相 p（1..3）、タップ j（0..11。j 標本前）: 時刻 n-6+p/4 の値を x[n-j] から作る。
  for (let p: i32 = 1; p <= 3; p++) {
    let sum: f64 = 0.0;
    for (let j: i32 = 0; j < DSP_TP_TAPS; j++) {
      const t = 6.0 - (j as f64) - (p as f64) * 0.25;
      // Blackman の窓（半幅 6.5）
      const w = 0.42 + 0.5 * dspCos(DSP_PI * t / 6.5) + 0.08 * dspCos(2.0 * DSP_PI * t / 6.5);
      const c = dspTpSinc(t) * w;
      tp.coef[((p - 1) * DSP_TP_TAPS + j) as usize] = c;
      sum += c;
    }
    // 直流の利得を 1 にそろえる
    for (let j: i32 = 0; j < DSP_TP_TAPS; j++) {
      const k = ((p - 1) * DSP_TP_TAPS + j) as usize;
      tp.coef[k] = tp.coef[k] / sum;
    }
  }
  return tp;
}

export function dspTruePeakReset(tp: mut DspTruePeak): void {
  for (let i: usize = 0; i < 24; i++) {
    tp.hl[i] = 0.0;
    tp.hr[i] = 0.0;
  }
  tp.pos = 0;
  tp.outL = 0.0;
  tp.outR = 0.0;
}

// 1 フレーム（L, R）を入れる。結果は tp.outL / tp.outR。
export function dspTruePeakStep(tp: mut DspTruePeak, xl: f64, xr: f64): void {
  // pos は次に書く場所。h[pos] と h[pos+12] に書き、新しい順に h[pos], h[pos+11], ... と読めるよう、
  // 書く位置は 1 つずつ下がっていく。
  let pos = tp.pos - 1;
  if (pos < 0) {
    pos = DSP_TP_TAPS - 1;
  }
  const p0 = pos as usize;
  tp.hl[p0] = xl;
  tp.hl[p0 + 12] = xl;
  tp.hr[p0] = xr;
  tp.hr[p0 + 12] = xr;
  tp.pos = pos;
  // x[n-j] = h[p0 + j]
  let ml = Math.abs(tp.hl[p0 + 6]);
  let mr = Math.abs(tp.hr[p0 + 6]);
  for (let p: usize = 0; p < 3; p++) {
    let al: f64 = 0.0;
    let ar: f64 = 0.0;
    for (let j: usize = 0; j < 12; j++) {
      const c = tp.coef[p * 12 + j];
      al += c * tp.hl[p0 + j];
      ar += c * tp.hr[p0 + j];
    }
    ml = Math.max(ml, Math.abs(al));
    mr = Math.max(mr, Math.abs(ar));
  }
  tp.outL = ml;
  tp.outR = mr;
}
