// 話し声の区間の検出（エネルギーとスペクトルの簡単な方法）と、自動ダッキングの音量の曲線。
//
// 検出（10 ms ごとの枠）:
// - 話し声の帯域（250 Hz〜3.5 kHz。高域通過 + 低域通過のバイクアッド）の電力 B と、全帯域の電力 F を求める。
// - 背景の雑音の床（B の dB）を追う: 下がるときはすぐ、上がるときは 1 秒に 0.5 dB だけ。
// - 候補の枠: B が -55 dBFS より大きい、B が床より 10 dB 以上大きい、B と F の差が -10 dB より大きい
//   （話し声は電力の大半がこの帯域にある。低音の強い音楽や高域の雑音は落ちる）。
// - 区間: 候補が 3 枠（30 ms）続いたら始まり、候補が途切れてから 250 ms で終わる。200 ms 未満の区間は捨てる。
// 特徴の計算は標本の順に 1 つずつ行うので、何標本ずつ渡しても同じ結果になる。
//
// ダッキング: 話し声の区間の少し前（先読み）から BGM を duckDb まで下げ、区間の後 hold だけ待って戻す。
// 区間どうしが近ければつなげる（間で音量が上下しないように）。結果は音量のキーフレーム（時刻と dB）。
import { dspPowerToDb, dspDbToGain, dspFmt } from "./math.um";
import { DspBiquad, dspBiquadNew, DSP_BQ_HIGHPASS, DSP_BQ_LOWPASS } from "./biquad.um";

export struct DspSpeech {
  rate: f64;
  hop: i64;
  hp: DspBiquad;
  lp: DspBiquad;
  count: i64;
  eBand: f64;
  eFull: f64;
  floorDb: f64;
  started: bool;
  // 枠ごとの値
  bandDb: f32[];
  fullDb: f32[];
  cand: u8[];
}

export function dspSpeechNew(rate: f64): DspSpeech {
  return {
    rate: rate, hop: Math.floor(rate / 100.0 + 0.5) as i64,
    hp: dspBiquadNew(DSP_BQ_HIGHPASS, 250.0, 0.7071067811865476, 0.0, rate),
    lp: dspBiquadNew(DSP_BQ_LOWPASS, 3500.0, 0.7071067811865476, 0.0, rate),
    count: 0, eBand: 0.0, eFull: 0.0, floorDb: -60.0, started: false,
    bandDb: [], fullDb: [], cand: [],
  };
}

// ステレオ（L, R 交互）の buf の frame0 から frames フレームを入れる（L と R の平均で調べる）。
export function dspSpeechProcess(s: mut DspSpeech, buf: f32[], frame0: usize, frames: usize): void {
  const hb0 = s.hp.b0;
  const hb1 = s.hp.b1;
  const hb2 = s.hp.b2;
  const ha1 = s.hp.a1;
  const ha2 = s.hp.a2;
  const lb0 = s.lp.b0;
  const lb1 = s.lp.b1;
  const lb2 = s.lp.b2;
  const la1 = s.lp.a1;
  const la2 = s.lp.a2;
  for (let f = frame0; f < frame0 + frames; f++) {
    const x = ((buf[f * 2] as f64) + (buf[f * 2 + 1] as f64)) * 0.5;
    const y1 = hb0 * x + s.hp.zl1;
    const h1 = hb1 * x - ha1 * y1 + s.hp.zl2;
    const h2 = hb2 * x - ha2 * y1;
    s.hp.zl1 = Math.abs(h1) < 1.0e-200 ? 0.0 : h1;
    s.hp.zl2 = Math.abs(h2) < 1.0e-200 ? 0.0 : h2;
    const y2 = lb0 * y1 + s.lp.zl1;
    const l1 = lb1 * y1 - la1 * y2 + s.lp.zl2;
    const l2 = lb2 * y1 - la2 * y2;
    s.lp.zl1 = Math.abs(l1) < 1.0e-200 ? 0.0 : l1;
    s.lp.zl2 = Math.abs(l2) < 1.0e-200 ? 0.0 : l2;
    s.eBand += y2 * y2;
    s.eFull += x * x;
    s.count += 1;
    if (s.count == s.hop) {
      dspsCloseFrame(mut s);
    }
  }
}

function dspsCloseFrame(s: mut DspSpeech): void {
  const n = s.hop as f64;
  const b = dspPowerToDb(s.eBand / n);
  const fu = dspPowerToDb(s.eFull / n);
  s.eBand = 0.0;
  s.eFull = 0.0;
  s.count = 0;
  if (!s.started) {
    s.floorDb = Math.min(b, -60.0);
    s.started = true;
  }
  // 床: 下がるときはすぐ、上がるときは 1 秒に 0.5 dB
  if (b < s.floorDb) {
    s.floorDb = b;
  } else {
    s.floorDb = s.floorDb + 0.005;
  }
  let c: u8 = 0;
  if (b > -55.0 && b > s.floorDb + 10.0 && b - fu > -10.0) {
    c = 1;
  }
  s.bandDb.push(b as f32);
  s.fullDb.push(fu as f32);
  s.cand.push(c);
}

// 検出した区間（秒）。starts[i] から ends[i] まで。
export struct DspSegments {
  starts: f64[];
  ends: f64[];
}

// 枠の候補から区間を決める。minOnFrames 枠続いたら開始、hangFrames 枠途切れたら終わり、minLenFrames 枠未満は捨てる。
export function dspSpeechSegmentsWith(s: DspSpeech, minOnFrames: i64, hangFrames: i64, minLenFrames: i64): DspSegments {
  let segs: DspSegments = { starts: [], ends: [] };
  const n = s.cand.length as i64;
  const sec = (s.hop as f64) / s.rate;
  let active = false;
  let run: i64 = 0;
  let runStart: i64 = 0;
  let segStart: i64 = 0;
  let lastOn: i64 = 0;
  for (let i: i64 = 0; i < n; i++) {
    const c = s.cand[i as usize] == 1;
    if (c) {
      if (run == 0) {
        runStart = i;
      }
      run += 1;
      lastOn = i;
      if (!active && run >= minOnFrames) {
        active = true;
        segStart = runStart;
      }
    } else {
      run = 0;
      if (active && i - lastOn > hangFrames) {
        active = false;
        const segEnd = lastOn + 1;
        if (segEnd - segStart >= minLenFrames) {
          segs.starts.push((segStart as f64) * sec);
          segs.ends.push((segEnd as f64) * sec);
        }
      }
    }
  }
  if (active) {
    const segEnd = lastOn + 1;
    if (segEnd - segStart >= minLenFrames) {
      segs.starts.push((segStart as f64) * sec);
      segs.ends.push((segEnd as f64) * sec);
    }
  }
  return segs;
}

// 既定の設定（30 ms で開始、250 ms で終わり、200 ms 未満は捨てる）。
export function dspSpeechSegments(s: DspSpeech): DspSegments {
  return dspSpeechSegmentsWith(s, 3, 25, 20);
}

// 区間の合計の長さ（秒）
export function dspSegmentsTotal(segs: DspSegments): f64 {
  let t: f64 = 0.0;
  for (let i: usize = 0; i < segs.starts.length; i++) {
    t += segs.ends[i] - segs.starts[i];
  }
  return t;
}

// 機械向け: [{"start":1.23,"end":2.5}, ...]
export function dspSegmentsToJson(segs: DspSegments): string {
  let s = "[";
  for (let i: usize = 0; i < segs.starts.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + `{"start":${dspFmt(segs.starts[i], 3)},"end":${dspFmt(segs.ends[i], 3)}}`;
  }
  return s + "]";
}

// 人向け
export function dspSegmentsDescribe(segs: DspSegments): string {
  let s = `話し声の区間: ${segs.starts.length} 個（合計 ${dspFmt(dspSegmentsTotal(segs), 2)} 秒）`;
  for (let i: usize = 0; i < segs.starts.length; i++) {
    s = s + `\n  ${i + 1}: ${dspFmt(segs.starts[i], 2)} 〜 ${dspFmt(segs.ends[i], 2)} 秒`;
  }
  return s;
}

// ---------------------------------------------------------------- ダッキング

// 音量のキーフレーム（時刻は秒、値は dB。間は dB で直線につなぐ）。
export struct DspDuckKeys {
  times: f64[];
  dbs: f64[];
}

export struct DspDuckParams {
  duckDb: f64; // 下げる量（例: -12）
  attackMs: f64; // 下げきるまで（例: 250）
  releaseMs: f64; // 戻しきるまで（例: 600）
  lookaheadMs: f64; // 話し声の何 ms 前に下げきるか（例: 100）
  holdMs: f64; // 話し声の後、戻し始めるまで（例: 200）
}

export function dspDuckDefaults(): DspDuckParams {
  return { duckDb: -12.0, attackMs: 250.0, releaseMs: 600.0, lookaheadMs: 100.0, holdMs: 200.0 };
}

function dspdPush(keys: mut DspDuckKeys, t: f64, db: f64): void {
  const n = keys.times.length;
  const tt = Math.max(t, 0.0);
  if (n > 0 && tt <= keys.times[n - 1]) {
    // 時刻が戻る（0 で切った）ときは、同じ時刻の値を置き換える
    if (tt < keys.times[n - 1]) {
      return;
    }
    keys.dbs[n - 1] = db;
    return;
  }
  keys.times.push(tt);
  keys.dbs.push(db);
}

// 区間からキーフレームを作る。
export function dspDuckKeysFromSegments(segs: DspSegments, p: DspDuckParams): DspDuckKeys {
  let keys: DspDuckKeys = { times: [], dbs: [] };
  const att = p.attackMs / 1000.0;
  const rel = p.releaseMs / 1000.0;
  const la = p.lookaheadMs / 1000.0;
  const hold = p.holdMs / 1000.0;
  const n = segs.starts.length;
  let i: usize = 0;
  while (i < n) {
    const a = segs.starts[i] - la;
    let b = segs.ends[i] + hold;
    // 近い区間をつなげる（戻しきって下げ直す時間がないなら、下げたまま）
    let j = i + 1;
    while (j < n && segs.starts[j] - la - att <= b + rel) {
      b = Math.max(b, segs.ends[j] + hold);
      j += 1;
    }
    if (a - att <= 0.0) {
      // 頭から下げる: 0 秒の時点の値を、下げ始めからの直線の上で求める
      const v = a <= 0.0 ? p.duckDb : p.duckDb * (1.0 - a / att);
      dspdPush(mut keys, 0.0, v);
    } else {
      dspdPush(mut keys, a - att, 0.0);
    }
    dspdPush(mut keys, a, p.duckDb);
    dspdPush(mut keys, b, p.duckDb);
    dspdPush(mut keys, b + rel, 0.0);
    i = j;
  }
  return keys;
}

// 時刻 t（秒）の音量（dB）。キーがなければ 0。
export function dspDuckDbAt(keys: DspDuckKeys, t: f64): f64 {
  const n = keys.times.length;
  if (n == 0) {
    return 0.0;
  }
  if (t <= keys.times[0]) {
    return keys.dbs[0];
  }
  if (t >= keys.times[n - 1]) {
    return keys.dbs[n - 1];
  }
  // 二分探索
  let lo: usize = 0;
  let hi: usize = n - 1;
  while (hi - lo > 1) {
    const mid = (lo + hi) / 2;
    if (keys.times[mid] <= t) {
      lo = mid;
    } else {
      hi = mid;
    }
  }
  const t0 = keys.times[lo];
  const t1 = keys.times[hi];
  if (t1 <= t0) {
    return keys.dbs[hi];
  }
  const u = (t - t0) / (t1 - t0);
  return keys.dbs[lo] + (keys.dbs[hi] - keys.dbs[lo]) * u;
}

// BGM（ステレオ）にキーフレームの音量を掛ける。pos0 は buf の frame0 のフレーム番号（タイムラインの先頭から）。
export function dspApplyDuck(buf: mut f32[], frame0: usize, frames: usize, pos0: i64, rate: f64, keys: DspDuckKeys): void {
  const n = keys.times.length;
  if (n == 0) {
    return;
  }
  // キーの区間を前から順に進める（二分探索を標本ごとにしない）
  let seg: usize = 0;
  let lastDb: f64 = 0.0;
  let lastG: f64 = 1.0;
  for (let j: usize = 0; j < frames; j++) {
    const t = ((pos0 + (j as i64)) as f64) / rate;
    let db: f64 = 0.0;
    if (t <= keys.times[0]) {
      db = keys.dbs[0];
    } else if (t >= keys.times[n - 1]) {
      db = keys.dbs[n - 1];
    } else {
      while (seg + 1 < n && keys.times[seg + 1] <= t) {
        seg += 1;
      }
      const t0 = keys.times[seg];
      const t1 = keys.times[seg + 1];
      db = t1 <= t0 ? keys.dbs[seg + 1] : keys.dbs[seg] + (keys.dbs[seg + 1] - keys.dbs[seg]) * ((t - t0) / (t1 - t0));
    }
    if (db != 0.0) {
      // 同じ dB が続くとき（下げたままの間）は、倍率を求め直さない
      if (db != lastDb) {
        lastDb = db;
        lastG = dspDbToGain(db);
      }
      const g = lastG;
      const k = (frame0 + j) * 2;
      buf[k] = ((buf[k] as f64) * g) as f32;
      buf[k + 1] = ((buf[k + 1] as f64) * g) as f32;
    }
  }
}

// 機械向け: [{"t":0.85,"db":0},{"t":1.1,"db":-12},...]
export function dspDuckKeysToJson(keys: DspDuckKeys): string {
  let s = "[";
  for (let i: usize = 0; i < keys.times.length; i++) {
    if (i > 0) {
      s = s + ",";
    }
    s = s + `{"t":${dspFmt(keys.times[i], 3)},"db":${dspFmt(keys.dbs[i], 2)}}`;
  }
  return s + "]";
}

export function dspDuckKeysDescribe(keys: DspDuckKeys): string {
  let s = `ダッキングの音量のキーフレーム: ${keys.times.length} 個`;
  for (let i: usize = 0; i < keys.times.length; i++) {
    s = s + `\n  ${dspFmt(keys.times[i], 2)} 秒: ${dspFmt(keys.dbs[i], 1)} dB`;
  }
  return s;
}
