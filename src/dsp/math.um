// 音の処理（src/dsp/）で使う数学の関数。
// UM の Math には sqrt / floor / ceil / abs / min / max しかないので、指数・対数・三角関数をここで書く。
// どれも f64 の決まった順の計算（多項式）なので、どのマシンでも同じ結果になる（C の libm に頼らない）。
// 精度は、音で使う範囲（|x| < 1e6 程度）で相対誤差 1e-15 前後。

export const DSP_PI: f64 = 3.141592653589793;
export const DSP_TWO_PI: f64 = 6.283185307179586;
export const DSP_HALF_PI: f64 = 1.5707963267948966;
export const DSP_LN2: f64 = 0.6931471805599453;
export const DSP_LN10: f64 = 2.302585092994046;
export const DSP_SQRT2: f64 = 1.4142135623730951;
export const DSP_SQRT1_2: f64 = 0.7071067811865476;
// 無音の dB（log の 0 の代わり）。これより小さい dB は使わない。
export const DSP_DB_FLOOR: f64 = -200.0;

const DSPM_LN2_HI: f64 = 0.6931471803691238;
const DSPM_LN2_LO: f64 = 1.9082149292705877e-10;
const DSPM_PIO2_HI: f64 = 1.5707963267341256;
const DSPM_PIO2_LO: f64 = 6.077100506506192e-11;

// 2 の k 乗（k は -1022..1023 の範囲で正確。範囲外は 0 か無限大）。
export function dspPow2i(k: i64): f64 {
  if (k > 1023) {
    return 1.0 / 0.0;
  }
  if (k < -1022) {
    return 0.0;
  }
  let n = k < 0 ? -k : k;
  let b: f64 = k < 0 ? 0.5 : 2.0;
  let p: f64 = 1.0;
  while (n > 0) {
    if ((n & 1) != 0) {
      p = p * b;
    }
    n = n >> 1;
    if (n > 0) {
      b = b * b;
    }
  }
  return p;
}

// e の x 乗。
export function dspExp(x: f64): f64 {
  if (x != x) {
    return x;
  }
  if (x > 709.78) {
    return 1.0 / 0.0;
  }
  if (x < -745.0) {
    return 0.0;
  }
  const kf = Math.floor(x / DSP_LN2 + 0.5);
  const r = (x - kf * DSPM_LN2_HI) - kf * DSPM_LN2_LO;
  // |r| <= ln2/2。テイラー展開を 13 次まで（打ち切り誤差 < 1e-17）。
  let p: f64 = 1.0 / 6227020800.0;
  p = p * r + 1.0 / 479001600.0;
  p = p * r + 1.0 / 39916800.0;
  p = p * r + 1.0 / 3628800.0;
  p = p * r + 1.0 / 362880.0;
  p = p * r + 1.0 / 40320.0;
  p = p * r + 1.0 / 5040.0;
  p = p * r + 1.0 / 720.0;
  p = p * r + 1.0 / 120.0;
  p = p * r + 1.0 / 24.0;
  p = p * r + 1.0 / 6.0;
  p = p * r + 0.5;
  p = p * r + 1.0;
  p = p * r + 1.0;
  const k = kf as i64;
  if (k < -1022) {
    // 非正規数の手前。2 回に分けて掛ける。
    return p * dspPow2i(k + 60) * dspPow2i(-60);
  }
  return p * dspPow2i(k);
}

// 自然対数。x <= 0 は -無限大（NaN は NaN）。
export function dspLn(x: f64): f64 {
  if (x != x) {
    return x;
  }
  if (x <= 0.0) {
    return -1.0 / 0.0;
  }
  if (x > 1.7976931348623157e308) {
    return x;
  }
  // x = m * 2^e、m は [1, 2) に寄せる（2 の累乗を掛けるだけなので正確）。
  let m = x;
  let e: i64 = 0;
  while (m >= 18446744073709551616.0) {
    m = m * 5.421010862427522e-20;
    e += 64;
  }
  while (m < 5.421010862427522e-20) {
    m = m * 18446744073709551616.0;
    e -= 64;
  }
  if (m >= 4294967296.0) { m = m * 2.3283064365386963e-10; e += 32; }
  if (m >= 65536.0) { m = m * 1.52587890625e-5; e += 16; }
  if (m >= 256.0) { m = m * 0.00390625; e += 8; }
  if (m >= 16.0) { m = m * 0.0625; e += 4; }
  if (m >= 4.0) { m = m * 0.25; e += 2; }
  if (m >= 2.0) { m = m * 0.5; e += 1; }
  if (m < 4.656612873077393e-10) { m = m * 4294967296.0; e -= 32; }
  if (m < 3.0517578125e-5) { m = m * 65536.0; e -= 16; }
  if (m < 0.0078125) { m = m * 256.0; e -= 8; }
  if (m < 0.125) { m = m * 16.0; e -= 4; }
  if (m < 0.5) { m = m * 4.0; e -= 2; }
  if (m < 1.0) { m = m * 2.0; e -= 1; }
  // m を [sqrt(1/2), sqrt(2)) にする。
  if (m > DSP_SQRT2) {
    m = m * 0.5;
    e += 1;
  }
  // ln(m) = 2 atanh(s)、s = (m-1)/(m+1)、|s| < 0.1716。
  const s = (m - 1.0) / (m + 1.0);
  const s2 = s * s;
  let q: f64 = 1.0 / 23.0;
  q = q * s2 + 1.0 / 21.0;
  q = q * s2 + 1.0 / 19.0;
  q = q * s2 + 1.0 / 17.0;
  q = q * s2 + 1.0 / 15.0;
  q = q * s2 + 1.0 / 13.0;
  q = q * s2 + 1.0 / 11.0;
  q = q * s2 + 1.0 / 9.0;
  q = q * s2 + 1.0 / 7.0;
  q = q * s2 + 1.0 / 5.0;
  q = q * s2 + 1.0 / 3.0;
  q = q * s2 + 1.0;
  const ef = e as f64;
  return ef * DSPM_LN2_HI + (2.0 * s * q + ef * DSPM_LN2_LO);
}

export function dspLog10(x: f64): f64 {
  return dspLn(x) * (1.0 / DSP_LN10);
}

export function dspLog2(x: f64): f64 {
  return dspLn(x) * (1.0 / DSP_LN2);
}

// b の e 乗（b > 0。b == 0 なら 0、b < 0 は NaN）。
export function dspPow(b: f64, e: f64): f64 {
  if (b == 0.0) {
    return e > 0.0 ? 0.0 : 1.0;
  }
  if (b < 0.0) {
    return 0.0 / 0.0;
  }
  return dspExp(e * dspLn(b));
}

// dB を倍率に（20 log10 の逆）。
export function dspDbToGain(db: f64): f64 {
  return dspExp(db * (DSP_LN10 / 20.0));
}

// 倍率を dB に。0 以下と DSP_DB_FLOOR 未満は DSP_DB_FLOOR。
export function dspGainToDb(g: f64): f64 {
  if (g <= 1.0e-10) {
    return DSP_DB_FLOOR;
  }
  return Math.max(20.0 * dspLog10(g), DSP_DB_FLOOR);
}

// 電力（2 乗の平均）を dB に（10 log10）。
export function dspPowerToDb(p: f64): f64 {
  if (p <= 1.0e-20) {
    return DSP_DB_FLOOR;
  }
  return Math.max(10.0 * dspLog10(p), DSP_DB_FLOOR);
}

function dspmSinPoly(r: f64): f64 {
  const r2 = r * r;
  let p: f64 = 1.0 / 355687428096000.0;
  p = p * r2 - 1.0 / 1307674368000.0;
  p = p * r2 + 1.0 / 6227020800.0;
  p = p * r2 - 1.0 / 39916800.0;
  p = p * r2 + 1.0 / 362880.0;
  p = p * r2 - 1.0 / 5040.0;
  p = p * r2 + 1.0 / 120.0;
  p = p * r2 - 1.0 / 6.0;
  return r + r * r2 * p;
}

function dspmCosPoly(r: f64): f64 {
  const r2 = r * r;
  let p: f64 = 1.0 / 6402373705728000.0;
  p = p * r2 - 1.0 / 20922789888000.0;
  p = p * r2 + 1.0 / 87178291200.0;
  p = p * r2 - 1.0 / 479001600.0;
  p = p * r2 + 1.0 / 3628800.0;
  p = p * r2 - 1.0 / 40320.0;
  p = p * r2 + 1.0 / 720.0;
  p = p * r2 - 1.0 / 24.0;
  p = p * r2 + 0.5;
  return 1.0 - r2 * p;
}

// sin と cos の共通部分。quarter は 0 なら sin、1 なら cos。
function dspmSinCos(x: f64, quarter: i64): f64 {
  if (x != x || Math.abs(x) > 1.0e15) {
    return 0.0 / 0.0;
  }
  const kf = Math.floor(x / DSP_HALF_PI + 0.5);
  const r = (x - kf * DSPM_PIO2_HI) - kf * DSPM_PIO2_LO;
  const q = ((kf as i64) + quarter) & 3;
  if (q == 0) {
    return dspmSinPoly(r);
  }
  if (q == 1) {
    return dspmCosPoly(r);
  }
  if (q == 2) {
    return -dspmSinPoly(r);
  }
  return -dspmCosPoly(r);
}

export function dspSin(x: f64): f64 {
  return dspmSinCos(x, 0);
}

export function dspCos(x: f64): f64 {
  return dspmSinCos(x, 1);
}

export function dspTan(x: f64): f64 {
  return dspSin(x) / dspCos(x);
}

// 0..1 に収める。
export function dspClamp01(x: f64): f64 {
  return Math.min(Math.max(x, 0.0), 1.0);
}

// 小数を決まった桁で丸めた文字列（JSON と人向けの表示用）。-1e9 未満（無音の印）は "null"。
export function dspFmt(x: f64, digits: i32): string {
  if (x != x || x < -1.0e9) {
    return "null";
  }
  if (x > 1.0e15) {
    return "null";
  }
  let s: f64 = 1.0;
  for (let i: i32 = 0; i < digits; i++) {
    s = s * 10.0;
  }
  const v = Math.floor(x * s + 0.5) / s;
  if (v == 0.0) {
    return "0";
  }
  return String(v);
}

// 人向けの表示: 無音の印は "-inf"。
export function dspFmtDb(x: f64, digits: i32): string {
  if (x <= DSP_DB_FLOOR + 1.0e-9 || x < -1.0e9) {
    return "-inf";
  }
  return dspFmt(x, digits);
}

// 昇順に並べる（ヒープソート。決まった順の比較だけ）。
export function dspSortF64(xs: mut f64[]): void {
  const n = xs.length;
  if (n < 2) {
    return;
  }
  let start = n / 2;
  while (start > 0) {
    start -= 1;
    dspmSiftDown(mut xs, start, n);
  }
  let end = n;
  while (end > 1) {
    end -= 1;
    const t = xs[0];
    xs[0] = xs[end];
    xs[end] = t;
    dspmSiftDown(mut xs, 0, end);
  }
}

function dspmSiftDown(xs: mut f64[], start: usize, end: usize): void {
  let root = start;
  while (root * 2 + 1 < end) {
    let child = root * 2 + 1;
    if (child + 1 < end && xs[child] < xs[child + 1]) {
      child += 1;
    }
    if (xs[root] < xs[child]) {
      const t = xs[root];
      xs[root] = xs[child];
      xs[child] = t;
      root = child;
    } else {
      return;
    }
  }
}
