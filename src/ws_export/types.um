// 書き出しのワークスペース（src/ws_export/）の型。job.um と state.um の両方が使うので、ここにまとめる。
// 名前の空間は全ファイルで 1 つなので、公開する名前は wsx / Wsx で始める。
import { Project, Diag } from "../project.um";
import { RenderQueue } from "../renderqueue.um";
import { UeState, UeEvent } from "../ui_export/model.um";
import { EncJob } from "../encode.um";

// 走らせている（走らせた）仕事の 1 回ぶん
export struct WsxRun {
  id: i32;
  attempt: i32;
  // 依頼のファイルの名前（拡張子なし。<cache>/wsx/job-<id>-<回>）
  base: string;
  // ログの次に読む位置と、前に見た大きさ
  logPos: usize;
  logSize: i64;
}

// FFmpeg の組み込みで直接書いている仕事の 1 回ぶん（job.um の wsxStartExport。MP4（H.264）のプリセット）。
// 書き出しは enc.o.out（<cache>/wsx/job-<id>-<回>.mp4）に書き、書き終えたら output に写す（途中で止めても、
// output の前のファイルを壊さないため。UM にファイルの名前を変える・消す組み込みがないので写す）。
export struct WsxEnc {
  id: i32;
  attempt: i32;
  output: string;
  enc: EncJob;
}

// 開くときの値（wsxOpenArgs で既定の値を作り、要るものだけ書き換える）
export struct WsxOpen {
  // .mzc とキャッシュのフォルダ（絶対パスにして持つ）
  mzc: string;
  cache: string;
  // イン・アウト・選んだクリップの範囲（コマ。なければ -1）と再生ヘッド
  inFrame: i64;
  outFrame: i64;
  selFrom: i64;
  selTo: i64;
  playhead: i64;
  // 書き出す場所とファイル名（拡張子なし）。"" なら .mzc のフォルダと名前
  folder: string;
  name: string;
  // はじめに選ぶプリセットの id。"" ならプロジェクトに合うもの（exportPresetSuggest）
  presetId: string;
  // 最近使ったプリセットの id（左の列の「最近の設定」）
  recent: string[];
}

// 画面に出す知らせ（kind は ukToast の 0 情報、1 成功、2 注意、3 誤り）
export struct WsxNotice {
  text: string;
  kind: i32;
}

export struct WsxState {
  mzc: string;
  cache: string;
  project: Project;
  // .mzc を読んだときの診断（誤りと警告）。読めなければ read-failed の 1 つ
  diags: Diag[];
  // 読んだときの .mzc の中身（書き換えられたかを比べる）、読み直した回数（プレビューが作り直すのに使う）、
  // 前に比べた時刻
  mzcText: string;
  projectVer: i32;
  mzcCheckAt: f64;
  ui: UeState;
  queue: RenderQueue;
  runs: WsxRun[];
  // FFmpeg の組み込みで直接書いている仕事（ふつうは 0 か 1 つ）
  encs: WsxEnc[];
  // 待ち行列を動かしているか（「書き出す」で true、走るものも待つものもなくなれば false）
  autoRun: bool;
  // 前の書き出しの速さ（プロジェクトのコマ/秒。合成と圧縮を通した値。0 は未知）
  speed: f64;
  // 前のフレームに見た仕事の状態（終わったときを見つけるため。queue.jobs と同じ並び）
  seenIds: i32[];
  seenStates: i32[];
  // 場所を文字で入れる欄を開いているか、その中の文字
  folderEdit: bool;
  folderText: string;
  // wsxUpdate が見つけた知らせ（書き出しが終わった・失敗した）。wsxFrame がトーストに出して空にする
  notices: WsxNotice[];
  // 呼ぶ側（編集画面）の仕事になる出来事（フォルダのダイアログ・終わった仕事の場所のコピーと再生・失敗した所へ移る・
  // 失敗の詳細のコピー・確認の項目の「そのクリップへ移る」など）。wsxHandle が足し、呼ぶ側が受けて空にする
  asks: UeEvent[];
}
