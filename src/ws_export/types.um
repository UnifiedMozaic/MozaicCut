// 書き出しのワークスペース（src/ws_export/）の型。job.um と state.um の両方が使うので、ここにまとめる。
// 名前の空間は全ファイルで 1 つなので、公開する名前は wsx / Wsx で始める。
import { Project, Diag } from "../project.um";
import { RenderQueue } from "../renderqueue.um";
import { UeState } from "../ui_export/model.um";

// 走らせている（走らせた）仕事の 1 回ぶん
export struct WsxRun {
  id: i32;
  attempt: i32;
  // 依頼のファイルの名前（拡張子なし。<cache>/wsx/job-<id>-<回>）
  base: string;
  // ログの次に読む位置と、前に見た大きさ
  logPos: usize;
  logSize: i64;
}

// 開くときの値（wsxOpenArgs で既定の値を作り、要るものだけ書き換える）
export struct WsxOpen {
  // .mzc とキャッシュのフォルダ（絶対パスにして持つ）
  mzc: string;
  cache: string;
  // イン・アウト・選んだクリップの範囲（コマ。なければ -1）と再生ヘッド
  inFrame: i64;
  outFrame: i64;
  selFrom: i64;
  selTo: i64;
  playhead: i64;
  // 書き出す場所とファイル名（拡張子なし）。"" なら .mzc のフォルダと名前
  folder: string;
  name: string;
  // はじめに選ぶプリセットの id。"" ならプロジェクトに合うもの（exportPresetSuggest）
  presetId: string;
  // 最近使ったプリセットの id（左の列の「最近の設定」）
  recent: string[];
}

// 画面に出す知らせ（kind は ukToast の 0 情報、1 成功、2 注意、3 誤り）
export struct WsxNotice {
  text: string;
  kind: i32;
}

export struct WsxState {
  mzc: string;
  cache: string;
  project: Project;
  // .mzc を読んだときの診断（誤りと警告）。読めなければ read-failed の 1 つ
  diags: Diag[];
  ui: UeState;
  queue: RenderQueue;
  runs: WsxRun[];
  // 待ち行列を動かしているか（「書き出す」で true、走るものも待つものもなくなれば false）
  autoRun: bool;
  // 前の書き出しの速さ（プロジェクトのコマ/秒。合成と圧縮を通した値。0 は未知）
  speed: f64;
  // 前のフレームに見た仕事の状態（終わったときを見つけるため。queue.jobs と同じ並び）
  seenIds: i32[];
  seenStates: i32[];
  // 場所を文字で入れる欄を開いているか、その中の文字
  folderEdit: bool;
  folderText: string;
}
