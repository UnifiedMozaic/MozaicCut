// 書き出しのワークスペースの中身: 本物のプロジェクト・プリセット（presets.um）・書き出しの予約（renderqueue.um）・
// 書き出しの前の確認（check の診断）を持ち、画面（src/ui_export/ の UeState）に写す。
//
// 使い方（1 フレーム。描くのは workspace.um の wsxFrame がまとめてする）:
//   let st = wsxOpen(wsxOpenArgs(".../demo.mzc", ".../demo.cache"));   // 1 度だけ
//   … ueWorkspace(mut ui, t, mut st.ui, …, mut ev) …                     // 画面（ui_export）
//   const notes = wsxHandle(mut st, ev, now);                            // 押されたものに応える
//   wsxUpdate(mut st, now);                                              // ログを読み、待ちの仕事を始め、画面に写す
//
// - 「書き出す」は仕事を待ち行列の最後に足して、待ち行列を動かす（autoRun）。前の仕事が走っていれば、その後に走る。
// - 「待ち行列に足す」は足すだけ。次に「書き出す」かやり直しを押したときに、並びの順に走る。
// - 要約の推定: 大きさはプリセットのビットレート（品質の固定で上限がなければ、画素あたり 0.1 ビットの目安）× 長さ、
//   時間は前に書き出した速さ（なければ画素の数からの目安）で出す。
//
// 名前の空間は全ファイルで 1 つなので、公開する名前は wsx / Wsx で始める。
import { sub } from "../text.um";
import { Project, Diag, Probe, parseProject, readProbes, warnDiag, diag } from "../project.um";
import {
  ExportPreset, exportPresetCopy, exportPresetList, exportPresetFind, exportPresetCheck, exportPresetSuggest, exportPresetResolve,
} from "../presets.um";
import {
  RenderQueue, RenderJob, RqResult, rqNew, rqAdd, rqTick, rqFind, rqRetry, rqElapsed, rqDurationText, rqWaitingCount,
  rqRunningCount, RQ_WAITING, RQ_RUNNING, RQ_DONE, RQ_FAILED, RQ_CANCELED,
} from "../renderqueue.um";
import {
  UeState, UeEvent, UeJob, UE_R_ALL, UE_SUB_NONE,
  UE_EV_PRESET, UE_EV_RANGE, UE_EV_NAME, UE_EV_PICK_FOLDER, UE_EV_SAVE_PRESET, UE_EV_EXPORT, UE_EV_ENQUEUE,
  UE_EV_CHECK_ACTION, UE_EV_JOB_CANCEL, UE_EV_JOB_OPEN, UE_EV_JOB_PLAY, UE_EV_JOB_RETRY, UE_EV_JOB_GOTO, UE_EV_JOB_COPY,
  uePresetCopy, ueRangeFrom, ueRangeTo, ueRangeHas, ueExt, ueNameProblem, ueBytesText, ueClock, ueOutW, ueOutH, ueOutFps, ueSizeText, ueErrorCount,
} from "../ui_export/model.um";
import { uePresetsFrom, ueSeqFrom, ueChecksFrom, ueJobFrom } from "../ui_export/link_m5.um";
import { WsxRun, WsxOpen, WsxNotice, WsxState } from "./types.um";
import { wsxStartExport, wsxPollJobs, wsxCancelJob, wsxDirOf, wsxBaseName } from "./job.um";

export function wsxOpenArgs(mzc: string, cache: string): WsxOpen {
  let recent: string[] = [];
  return {
    mzc: mzc.clone(), cache: cache.clone(), inFrame: -1, outFrame: -1, selFrom: -1, selTo: -1, playhead: 0,
    folder: "", name: "", presetId: "", recent,
  };
}

function wsxStem(name: string): string {
  let dot = name.length;
  for (let i: usize = 0; i < name.length; i++) {
    if (name[i] == 46) {
      dot = i;
    }
  }
  if (dot == 0) {
    return name.clone();
  }
  return sub(name, 0, dot);
}

// .mzc を読んで Project と診断を作る（素材の情報は <cache>/probe.txt。なければ素材の長さを書いた行だけ並ぶ）
function wsxLoad(mzc: string, cache: string, diags: mut Diag[]): Project {
  const probes = readProbes(`${cache}/probe.txt`);
  const text = readFile(mzc);
  if (text == null) {
    let empty: u8[] = [];
    let ignore: Diag[] = [];
    diags.push(diag("read-failed", 0, 0, `'${mzc}' を読めません`, "ファイルがあるか、読めるかを確かめます"));
    return parseProject(empty, probes, mut ignore);
  }
  return parseProject(text, probes, mut diags);
}

function wsxPresetIndex(st: UeState, id: string): i32 {
  for (let i: usize = 0; i < st.presets.length; i++) {
    if (st.presets[i].id == id) {
      return i as i32;
    }
  }
  return -1;
}

export function wsxOpen(o: WsxOpen): WsxState {
  const mzc = absPath(o.mzc);
  const cache = absPath(o.cache);
  let diags: Diag[] = [];
  const p = wsxLoad(mzc, cache, mut diags);
  let none: ExportPreset[] = [];
  const presets = uePresetsFrom(p, o.recent, none);
  const mzcName = wsxBaseName(mzc);
  const seq = ueSeqFrom(p, wsxStem(mzcName), "本編", mzcName, o.inFrame, o.outFrame, o.selFrom, o.selTo, o.playhead, false);
  let folder = o.folder.clone();
  if (folder.length == 0) {
    folder = wsxDirOf(mzc);
  } else {
    folder = absPath(folder);
  }
  let name = o.name.clone();
  if (name.length == 0) {
    name = wsxStem(wsxBaseName(p.output));
    if (name.length == 0) {
      name = wsxStem(mzcName);
    }
  }
  let jobs: UeJob[] = [];
  let ui: UeState = {
    presets, sel: 0, seq, range: UE_R_ALL, fileName: name, folder, subtitles: UE_SUB_NONE, detailsOpen: false,
    checks: [], checkSec: 0.0, checking: false, jobs, estSize: "", estTime: "", sideH: 0, leftH: 0,
  };
  let want = o.presetId.clone();
  if (want.length == 0) {
    want = exportPresetSuggest(p);
  }
  // 「最近の設定」に同じ id があっても、配る・保存の組の方を選ぶ（最近の組は上に重ねて出すだけ）
  let sel: i32 = -1;
  for (let i: usize = 0; i < ui.presets.length; i++) {
    if (ui.presets[i].id == want && ui.presets[i].group != 0) {
      sel = i as i32;
    }
  }
  if (sel < 0) {
    sel = wsxPresetIndex(ui, want);
  }
  if (sel >= 0) {
    ui.sel = sel;
  }
  let runs: WsxRun[] = [];
  let st: WsxState = {
    mzc, cache, project: p, diags, ui, queue: rqNew(1), runs, autoRun: false, speed: 0.0, seenIds: [], seenStates: [],
    folderEdit: false, folderText: "",
  };
  wsxRecheck(mut st);
  return st;
}

// いま選んでいるプリセット（presets.um の本物）。見つからなければ標準の表の最初
export function wsxPreset(st: WsxState): ExportPreset {
  const list = exportPresetList();
  let k: i32 = 0;
  if (st.ui.sel >= 0 && (st.ui.sel as usize) < st.ui.presets.length) {
    k = exportPresetFind(st.ui.presets[st.ui.sel as usize].id);
  }
  if (k < 0) {
    k = 0;
  }
  return exportPresetCopy(list[k as usize]);
}

function wsxPresetById(id: string): ExportPreset {
  const list = exportPresetList();
  let k = exportPresetFind(id);
  if (k < 0) {
    k = 0;
  }
  return exportPresetCopy(list[k as usize]);
}

// 書き出すファイルの場所（場所 / ファイル名 + プリセットの拡張子）
export function wsxOutputPath(st: WsxState): string {
  return wsxJoin(st.ui.folder, st.ui.fileName + ueExt(st.ui));
}

// フォルダと名前をつなぐ。区切りはフォルダの中で使っているもの（Windows の absPath は \）に合わせる
export function wsxJoin(folder: string, name: string): string {
  let sep = "/";
  for (const b of folder) {
    if (b == 92) {
      sep = "\\";
    }
  }
  if (folder.length > 0 && (folder[folder.length - 1] == 47 || folder[folder.length - 1] == 92)) {
    return folder + name;
  }
  return folder + sep + name;
}

// 範囲の秒（[from, to)）
export function wsxRangeFromSec(st: WsxState): f64 {
  return (ueRangeFrom(st.ui.seq, st.ui.range) as f64) * (st.ui.seq.fpsDen as f64) / (st.ui.seq.fpsNum as f64);
}

export function wsxRangeToSec(st: WsxState): f64 {
  return (ueRangeTo(st.ui.seq, st.ui.range) as f64) * (st.ui.seq.fpsDen as f64) / (st.ui.seq.fpsNum as f64);
}

// 書き出しの前の確認を作り直す: .mzc の診断 + プリセットとプロジェクトの食い違い（exportPresetCheck）+ 出力の場所。
export function wsxRecheck(st: mut WsxState): void {
  let ds: Diag[] = [];
  for (const d of st.diags) {
    ds.push({ code: d.code.clone(), severity: d.severity.clone(), line: d.line, col: d.col, msg: d.msg.clone(),
              hint: d.hint.clone(), suggest: d.suggest.clone() });
  }
  const preset = wsxPreset(st);
  for (const d of exportPresetCheck(st.project, preset)) {
    ds.push({ code: d.code.clone(), severity: d.severity.clone(), line: d.line, col: d.col, msg: d.msg.clone(),
              hint: d.hint.clone(), suggest: d.suggest.clone() });
  }
  if (ueRangeTo(st.ui.seq, st.ui.range) <= ueRangeFrom(st.ui.seq, st.ui.range)) {
    ds.push(diag("range-empty", 0, 0, "書き出す範囲が空です", "範囲を「シーケンス全体」にするか、イン・アウトを付け直します"));
  }
  if (ueNameProblem(st.ui.fileName).length == 0) {
    const out = wsxOutputPath(st);
    if (!isDir(st.ui.folder)) {
      ds.push(warnDiag("output-folder-missing", 0, 0, `フォルダ「${st.ui.folder}」はまだありません`,
                       "書き出すときに作ります。違う場所なら「変える…」で直します"));
    } else if (fileSize(out) != null) {
      ds.push(warnDiag("output-exists", 0, 0, `「${wsxBaseName(out)}」はもうあります。書き出すと置き換えます`,
                       "残すなら、ファイル名か場所を変えます"));
    }
  }
  st.ui.checks = ueChecksFrom(ds, wsxBaseName(st.mzc), st.ui.presets);
  wsxEstimate(mut st);
}

// 要約の推定（大きさと時間）を決める。
export function wsxEstimate(st: mut WsxState): void {
  st.ui.estSize = "";
  st.ui.estTime = "";
  if (st.ui.sel < 0 || (st.ui.sel as usize) >= st.ui.presets.length) {
    return;
  }
  const up = uePresetCopy(st.ui.presets[st.ui.sel as usize]);
  const preset = wsxPreset(st);
  const frames = ueRangeTo(st.ui.seq, st.ui.range) - ueRangeFrom(st.ui.seq, st.ui.range);
  const fpsSeq = (st.ui.seq.fpsNum as f64) / Math.max(st.ui.seq.fpsDen as f64, 1.0);
  const sec = (frames as f64) / Math.max(fpsSeq, 0.001);
  if (up.totalKbps <= 0 && up.hasVideo) {
    // 品質の固定で上限がない: 画素あたり 0.1 ビットを目安にする（実際は絵の動きで 2〜3 倍は変わる）
    const w = ueOutW(up, st.ui.seq) as f64;
    const h = ueOutH(up, st.ui.seq) as f64;
    const fps = ueOutFps(up, st.ui.seq);
    const kbps = w * h * fps * 0.1 / 1000.0 + (preset.audioKbps as f64);
    st.ui.estSize = "約 " + ueBytesText(kbps * 1000.0 / 8.0 * sec) + "（目安）";
  }
  if (frames <= 0) {
    st.ui.estTime = "—";
    return;
  }
  if (st.speed > 0.0) {
    st.ui.estTime = rqDurationText((frames as f64) / st.speed);
  } else {
    // まだ書き出していなければ、画素の数から目安を出す（合成と圧縮を通して毎秒 2000 万画素くらい）
    const px = Math.max((st.ui.seq.width as f64) * (st.ui.seq.height as f64), 1.0);
    const fps = Math.min(Math.max(20000000.0 / px, 1.0), 240.0);
    st.ui.estTime = rqDurationText((frames as f64) / fps) + "（目安）";
  }
}

// 仕事を待ち行列の最後に足す。start なら待ち行列を動かす。
export function wsxEnqueue(st: mut WsxState, now: f64, start: bool): RqResult {
  const out = wsxOutputPath(st);
  // 画面では［書き出す］が押せなくなっている（ueExportBlockTip）が、台本やほかの部品から呼ばれても止める
  if (ueErrorCount(st.ui) > 0) {
    return { ok: false, code: "check-errors", msg: `書き出しの前の確認にエラーが ${ueErrorCount(st.ui)} 件あります`,
             hint: "確認の欄の直し方に沿って直してから書き出します" };
  }
  const prob = ueNameProblem(st.ui.fileName);
  if (prob.length > 0) {
    return { ok: false, code: "bad-name", msg: prob, hint: "ファイル名を直します" };
  }
  const f0 = ueRangeFrom(st.ui.seq, st.ui.range);
  const f1 = ueRangeTo(st.ui.seq, st.ui.range);
  if (f1 <= f0) {
    return { ok: false, code: "range-empty", msg: "書き出す範囲が空です", hint: "範囲を選び直します" };
  }
  const id = st.ui.presets[st.ui.sel as usize].id.clone();
  const fps = (st.ui.seq.fpsNum as f64) / Math.max(st.ui.seq.fpsDen as f64, 1.0);
  // 範囲の端は、コマの境目ではなく半コマ前の時刻で渡す。依頼の JSON は秒を小数 6 桁に丸め、render は
  // ceil(秒 × fps − 0.000001) でコマに戻すので、境目ちょうど（149 / 30 = 4.966667 など）だと丸めで 1 コマ増えたり
  // 減ったりする。半コマ前なら、丸めがあっても同じコマに戻る。
  let toSec = ((f1 as f64) - 0.5) / fps;
  if (f1 >= st.ui.seq.frames) {
    // 最後まで: 秒の丸めで最後のコマが落ちないよう、プロジェクトの長さ（-1 = 最後まで）にする
    toSec = -1.0;
  }
  let fromSec = 0.0;
  if (f0 > 0) {
    fromSec = ((f0 as f64) - 0.5) / fps;
  }
  const mzc = st.mzc.clone();
  const jid = rqAdd(mut st.queue, "", mzc, out, id, fromSec, toSec, f1 - f0, fps, now);
  if (start) {
    st.autoRun = true;
  }
  return { ok: true, code: "", msg: `#${jid}（${wsxBaseName(out)}）を待ち行列に足しました`, hint: "" };
}

// 画面から来た知らせに応える。画面に出す知らせ（トースト）を返す。
export function wsxHandle(st: mut WsxState, ev: UeEvent[], now: f64): WsxNotice[] {
  let notes: WsxNotice[] = [];
  let recheck = false;
  for (const e of ev) {
    if (e.kind == UE_EV_PRESET || e.kind == UE_EV_RANGE || e.kind == UE_EV_NAME) {
      recheck = true;
    } else if (e.kind == UE_EV_PICK_FOLDER) {
      // ダイアログはまだつながない（folder.um の wsxPickFolderDialog）。文字で入れる欄を開く
      st.folderEdit = true;
      st.folderText = st.ui.folder.clone();
    } else if (e.kind == UE_EV_EXPORT || e.kind == UE_EV_ENQUEUE) {
      const r = wsxEnqueue(mut st, now, e.kind == UE_EV_EXPORT);
      let kind = 0;
      if (!r.ok) {
        kind = 3;
      }
      let text = r.msg.clone();
      if (r.ok && e.kind == UE_EV_ENQUEUE && !st.autoRun) {
        text = text + "（「書き出す」で始まります）";
      }
      notes.push({ text, kind });
    } else if (e.kind == UE_EV_JOB_CANCEL) {
      const r = wsxCancelJob(mut st, e.a, now);
      let kind = 0;
      if (!r.ok) {
        kind = 3;
      }
      notes.push({ text: r.msg.clone(), kind });
    } else if (e.kind == UE_EV_JOB_RETRY) {
      const r = rqRetry(mut st.queue, e.a, now);
      if (r.ok) {
        st.autoRun = true;
      }
      let kind = 0;
      if (!r.ok) {
        kind = 3;
      }
      notes.push({ text: r.msg.clone(), kind });
    } else if (e.kind == UE_EV_CHECK_ACTION) {
      if (e.s.length > 7 && sub(e.s, 0, 7) == "preset:") {
        const k = wsxPresetIndex(st.ui, sub(e.s, 7, e.s.length));
        if (k >= 0) {
          st.ui.sel = k;
          recheck = true;
          notes.push({ text: `${st.ui.presets[k as usize].name} にしました`, kind: 1 });
        }
      } else {
        // relink / goto / open-sequence / line は編集画面の仕事（ここでは知らせるだけ）
        notes.push({ text: `編集画面で行います（${e.s}）`, kind: 0 });
      }
    } else if (e.kind == UE_EV_JOB_OPEN || e.kind == UE_EV_JOB_PLAY || e.kind == UE_EV_JOB_GOTO ||
               e.kind == UE_EV_JOB_COPY || e.kind == UE_EV_SAVE_PRESET) {
      // フォルダを開く・再生・クリップへ移る・コピー・プリセットの保存は、OS や編集画面につなぐ口（まだつながない）
      notes.push({ text: `まだつないでいません（${e.kind}）`, kind: 0 });
    }
  }
  if (recheck) {
    wsxRecheck(mut st);
  }
  return notes;
}

// 場所を変える（文字の欄やダイアログから）。
export function wsxSetFolder(st: mut WsxState, folder: string): void {
  st.ui.folder = absPath(folder);
  wsxRecheck(mut st);
}

function wsxPresetLabel(st: WsxState, id: string): string {
  for (const p of st.ui.presets) {
    if (p.id == id) {
      return p.name.clone();
    }
  }
  return id.clone();
}

// 毎フレーム: ログを読み、待ちの仕事を始め、画面の待ち行列を作り直す。何か変わったら true。
export function wsxUpdate(st: mut WsxState, now: f64): bool {
  let changed = wsxPollJobs(mut st, now);
  if (st.autoRun) {
    const started = rqTick(mut st.queue, now);
    for (const id of started) {
      const k = rqFind(st.queue, id);
      const preset = wsxPresetById(st.queue.jobs[k as usize].presetId);
      wsxStartExport(mut st, id, preset);
      changed = true;
    }
    if (rqRunningCount(st.queue) == 0 && rqWaitingCount(st.queue) == 0) {
      st.autoRun = false;
    }
  }
  // 終わった仕事を見つけて速さを測る
  let ids: i32[] = [];
  let states: i32[] = [];
  let finished = false;
  for (const j of st.queue.jobs) {
    let before: i32 = -1;
    for (let i: usize = 0; i < st.seenIds.length; i++) {
      if (st.seenIds[i] == j.id) {
        before = st.seenStates[i];
      }
    }
    if (before != j.state) {
      changed = true;
      if (j.state == RQ_DONE || j.state == RQ_FAILED || j.state == RQ_CANCELED) {
        finished = true;
      }
      if (j.state == RQ_DONE) {
        const el = rqElapsed(j, now);
        if (el > 0.0 && j.totalFrames > 0) {
          st.speed = (j.totalFrames as f64) / el;
        }
      }
    }
    ids.push(j.id);
    states.push(j.state);
  }
  st.seenIds = ids;
  st.seenStates = states;
  if (finished) {
    // 出力ができたので「もうあります」の警告と時間の見込みを作り直す
    wsxRecheck(mut st);
  }
  let jobs: UeJob[] = [];
  for (const j of st.queue.jobs) {
    let info = "";
    if (j.state == RQ_DONE) {
      info = "終わりました · " + ueClock(rqElapsed(j, now));
      const sz = fileSize(j.output);
      if (sz != null) {
        info = info + " · " + ueBytesText(sz as f64);
      }
    } else if (j.state == RQ_RUNNING || j.state == RQ_WAITING) {
      const plan = exportPresetResolve(st.project, wsxPresetById(j.presetId));
      info = `${ueSizeText(plan.width, plan.height)} · ${wsxPresetLabel(st, j.presetId)}`;
    } else if (j.state == RQ_CANCELED) {
      info = "取りやめました";
    }
    jobs.push(ueJobFrom(j, now, info));
  }
  st.ui.jobs = jobs;
  return changed;
}

// 走っている・待っている仕事があるか（呼ぶ側が、終わるまで描き続けるかを決めるのに使う）
export function wsxBusy(st: WsxState): bool {
  return rqRunningCount(st.queue) > 0 || (st.autoRun && rqWaitingCount(st.queue) > 0);
}
