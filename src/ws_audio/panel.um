// 音のワークスペースの画面（1 つの関数で描き、出来事を返す）。編集画面に組み込むときは、毎フレーム
//
//   let evs: WsaEvent[] = [];
//   wsaPanel(mut ui, th, mut ws, r, mut evs);
//   for (const e of evs) {
//     if (e.kind == WSA_EV_OP) { runOps(lines, probes, [e.op]) で .mzc を書き換え、読み直して wsaWsSync(mut ws, p)。
//                                断られたり書けなかったりしたら、元の p で wsaWsSync(mut ws, p) を呼んで影の値を捨てる }
//     if (e.kind == WSA_EV_PLAY) { 再生・一時停止（ws.playing はもう切り替えてある。編集画面の再生と合わせるならここで） }
//     if (e.kind == WSA_EV_SEEK) { 頭へ戻した（e.value は秒） }
//   }
//
// 上に帯（高さ panelHeader: 再生・頭へのボタン、時刻、マスターの統合ラウドネスの 1 文）、その下にミキサー（ui_mixer の mixerPanel）。
// 値の変化は wsaWsEvent でその場で音に効かせ（影の値）、確定したものだけを op（mix ...）にして返す（ui.md 原則 7）。
import {
  UkCtx, ukBehavior, ukId, ukDrawRect, ukDrawRound, ukDrawStroke, ukDrawTextIn, ukTextW, ukTooltip, ukKeyTake, UK_KEY_SPACE,
} from "../uikit/core.um";
import { UkRect, ukRect, ukShade } from "../uikit/base.um";
import { ukIcon, UK_I_PLAY, UK_I_PAUSE, UK_I_PREV } from "../uikit/icons.um";
import { fmtTime } from "../text.um";
import { MxTheme } from "../ui_mixer/theme.um";
import { MixerEvent } from "../ui_mixer/parts.um";
import { mixerPanel } from "../ui_mixer/panel.um";
import { WsaWs, wsaWsEvent, wsaWsSeek } from "./model.um";

export const WSA_EV_OP: i32 = 1;      // op = .mzc に書く操作の引数（["mix", "0", "vol=-6"]）
export const WSA_EV_PLAY: i32 = 2;    // on = 再生を始めた（false は止めた）
export const WSA_EV_SEEK: i32 = 3;    // value = 移った位置（秒）
export const WSA_EV_MIXER: i32 = 4;   // mixer = ミキサーの部品の出来事（確定していないものも。選択・目標の変更など）

export struct WsaEvent {
  kind: i32;
  op: string[];
  on: bool;
  value: f64;
  mixer: MixerEvent;
}

// 文字列の配列の写し（string[] の .clone() はまだないため）
export function wsaStrsCopy(xs: string[]): string[] {
  let out: string[] = [];
  for (const x of xs) {
    out.push(x.clone());
  }
  return out;
}

function wsaEv(kind: i32, op: string[], on: bool, value: f64, m: MixerEvent): WsaEvent {
  return { kind, op: wsaStrsCopy(op), on, value, mixer: { kind: m.kind, track: m.track, value: m.value, on: m.on, commit: m.commit } };
}

function wsaNoMixer(): MixerEvent {
  return { kind: 0, track: -2, value: 0.0, on: false, commit: false };
}

// 帯の小さなアイコンのボタン。押したら true
function wsaIconBtn(ui: mut UkCtx, th: MxTheme, id: u32, r: UkRect, icon: i32, on: bool): bool {
  const h = ukBehavior(mut ui, id, r, true);
  let bg = th.bg3;
  if (h.held || on) {
    bg = th.bg4;
  } else if (h.hover) {
    bg = ukShade(th.bg3, 10);
  }
  ukDrawRound(mut ui, r, th.rMd, bg);
  ukDrawStroke(mut ui, r, th.rMd, th.hair, th.lineStrong);
  const is = th.iconSm;
  ukIcon(mut ui, ukRect(r.x + (r.w - is) / 2, r.y + (r.h - is) / 2, is, is), icon, th.text1);
  return h.clicked;
}

// 再生と一時停止を切り替える（終わりにいれば頭から）
function wsaTogglePlay(ws: mut WsaWs, out: mut WsaEvent[]): void {
  const none: string[] = [];
  ws.playing = !ws.playing;
  if (ws.playing && ws.pos >= ws.end) {
    wsaWsSeek(mut ws, 0.0);
  }
  out.push(wsaEv(WSA_EV_PLAY, none, ws.playing, 0.0, wsaNoMixer()));
}

// 音のワークスペースを r に描く。出来事は out に足す。
// Space は、ミキサーの部品（フォーカスのあるボタンなど）が取らなかったときだけ再生と一時停止に使う。
export function wsaPanel(ui: mut UkCtx, th: MxTheme, ws: mut WsaWs, r: UkRect, out: mut WsaEvent[]): void {
  const none: string[] = [];
  // ---- 上の帯 ----
  const hh = th.panelHeader;
  const hr = ukRect(r.x, r.y, r.w, hh);
  ukDrawRect(mut ui, hr, th.bg2);
  ukDrawRect(mut ui, ukRect(r.x, hr.y + hh - th.hair, r.w, th.hair), th.line);
  let x = r.x + th.s3;
  const title = "音";
  const tw = ukTextW(mut ui, title, th.fsLg);
  ukDrawTextIn(mut ui, ukRect(x, hr.y, tw, hh), title, th.fsLg, th.text1, 0);
  x += tw + th.s4;
  const bs = th.btnSm;
  const by = hr.y + (hh - bs) / 2;
  if (wsaIconBtn(mut ui, th, ukId(ui, "wsa.home"), ukRect(x, by, bs, bs), UK_I_PREV, false)) {
    wsaWsSeek(mut ws, 0.0);
    out.push(wsaEv(WSA_EV_SEEK, none, false, 0.0, wsaNoMixer()));
  }
  ukTooltip(mut ui, "頭へ戻ります");
  x += bs + th.s1;
  let icon = UK_I_PLAY;
  if (ws.playing) {
    icon = UK_I_PAUSE;
  }
  if (wsaIconBtn(mut ui, th, ukId(ui, "wsa.play"), ukRect(x, by, bs, bs), icon, ws.playing)) {
    wsaTogglePlay(mut ws, mut out);
  }
  if (ws.playing) {
    ukTooltip(mut ui, "止めます（Space）");
  } else {
    ukTooltip(mut ui, "再生します（Space）");
  }
  x += bs + th.s3;
  const t = (ws.pos as f64) / ws.rate;
  const total = (ws.end as f64) / ws.rate;
  const ts = `${fmtTime(t)} / ${fmtTime(total)}`;
  const tsw = ukTextW(mut ui, ts, th.fsSm);
  ukDrawTextIn(mut ui, ukRect(x, hr.y, tsw, hh), ts, th.fsSm, th.text1, 0);
  x += tsw + th.s4;
  let st = "止まっています";
  if (ws.playing) {
    st = "再生中";
  }
  st = st + "（メーターは書き出しと同じ処理を通した音）";
  ukDrawTextIn(mut ui, ukRect(x, hr.y, r.x + r.w - x - th.s3, hh), st, th.fsSm, th.text2, 0);
  // ---- ミキサー ----
  let evs: MixerEvent[] = [];
  mixerPanel(mut ui, th, mut ws.md, ukRect(r.x, r.y + hh, r.w, r.h - hh), mut evs);
  for (const e of evs) {
    out.push(wsaEv(WSA_EV_MIXER, none, e.on, e.value, e));
    const op = wsaWsEvent(mut ws, e);
    if (op.length > 0) {
      out.push(wsaEv(WSA_EV_OP, op, e.on, e.value, e));
    }
  }
  if (ukKeyTake(mut ui, UK_KEY_SPACE)) {
    wsaTogglePlay(mut ws, mut out);
  }
}
