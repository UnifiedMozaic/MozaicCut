// アプリへのつなぎ（host.um）が使う、IR から WGSL / wasm を出す関数の口。
//
// WGSL は wgsl.um の fxsWgsl、wasm は wasm.um の fxsWasmBytesEx（fxs_alloc / fxs_main と、mzplug なら
// umAlloc / umFree / mzfx_apply を export する）につないである。host.um はこの 2 つの関数だけを呼ぶ。
// 3 通りの実行（UM 本体・WGSL・wasm）が画素まで一致することは test_three.um で確かめる。
//
// ■ 出力が守る約束（host.um がこの形で読み込んで呼ぶ。言語の芯の IR の説明（ir.um の先頭）の「意味の約束」も守る）
//
// ● WGSL（GPU。gpu.loadKernel / gpu.runKernel。UnifiedMozaic の docs/wgpu.ja.md の「束縛の並び」）
//   入口の関数の引数の並びにかかわらず、束縛はいつもこの並びにする（UM の kernel
//   `kernel function k(i: u32, out: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, src2: Buffer<vec4<f32>>,
//                      w: u32, h: u32, time: f32, p: f32[8])` を --emit-wgsl したものと同じ形）:
//     struct UmParams { count: u32, row: u32, len_out: u32, len_src: u32, len_src2: u32,
//                       p_w: u32, p_h: u32, p_time: f32, p_p: array<f32, 8> }
//     @group(0) @binding(0) var<storage, read> um_params: UmParams;
//     @group(0) @binding(1) var<storage, read_write> b_out: array<vec4 の struct>;   // 書く層（実行の前に入力の層が入っている）
//     @group(0) @binding(2) var<storage, read> b_src: array<…>;                       // 入力の層の写し（使わなければ長さ 1 の 0）
//     @group(0) @binding(3) var<storage, read> b_src2: array<…>;                      // 2 つ目の入力（なければ長さ 1 の 0 = 透明）
//     @compute @workgroup_size(64) fn um_main(@builtin(global_invocation_id) gid: vec3<u32>)
//       添字は gid.y * um_params.row + gid.x、count 以上なら何もしない。
//   使わない束縛も宣言だけはしておく（束縛の配置はランタイムが明示するので、使わなくてもずれない）。
//   ホストの呼び方: gpu.runKernel(k, w * h, mut out, src, src2, w, h, time, p)
//
// ● wasm（CPU。wasmtime。UnifiedMozaic の docs/wasm.ja.md）
//   import を持たない。export するもの:
//     memory                                       線形メモリ
//     fxs_alloc(bytes: i32) -> i32                 16 バイト境界の領域を確保して位置を返す（足りなければ memory.grow。
//                                                  できなければ 0）。解放はしない（ホストは大きさが変わったらインスタンスを作り直す）
//     fxs_main(outAt, outLen, srcAt, srcLen, src2At, src2Len, w, h, i0, i1: i32, time: f32, p0..p7: f32)  戻り値なし
//       添字 i0 <= i < i1 について入口を実行する（ホストは層を横の帯に分け、帯ごとのインスタンスで並列に呼ぶ）。
//       層は (バイトの位置, 要素の数)。要素は vec4<f32>（16 バイト、x y z w の順、リトルエンディアン）。
//       out の領域は w*h 要素ぶんあるが、ホストが中身を入れるのは [i0, i1) だけ（入口が out から読むのは out[i] だけなので足りる）。
//       src / src2 を使わないとき・2 つ目の入力がないときは、長さ 1 の 0 の領域を渡す（範囲外の添字の切り詰めで 0 = 透明を読む）。
//       トラップしない（ゼロ除算・i32 の最小値 / -1 は分岐で包む。範囲外の添字は切り詰め）。
//   mzplug = true のとき（.mzplug への書き出し。host.um の fxsExportMzplug）は、さらに MozaicCut の .mzplug の形（abi 1。
//   MozaicCut の src/wasmfx.um の wfCheckExports）の export を足す:
//     umAlloc(bytes: i32) -> i32、umFree(at: i32)   （umFree は何もしなくてよい）
//     mzfx_apply(layerAt, layerLen, tmpAt, tmpLen, w, h: i32, p0..p7: f32)
//       = 入口が src を使うなら layer を tmp に写してから fxs_main(layerAt, layerLen, tmpAt, tmpLen, ゼロの領域, 1, w, h, 0, layerLen,
//         0.0, p0..p7)。src2 と time を使う入口は .mzplug にできない（host.um が先に断るので、ここには来ない）。

import { FxsDiag, FxsIr } from "./ir.um";
import { fxsWgsl } from "./wgsl.um";
import { fxsWasmBytesEx } from "./wasm.um";

// 出力の結果。ok が true なら wgsl（WGSL の出力）か wasm（wasm の出力）に中身がある。
export struct FxsGenOut {
  ok: bool;
  wgsl: string;
  wasm: u8[];
  diags: FxsDiag[];
}

function fxsHostDiagsCopy(src: FxsDiag[]): FxsDiag[] {
  let d: FxsDiag[] = [];
  for (let k: usize = 0; k < src.length; k++) {
    d.push({
      code: src[k].code.clone(), severity: src[k].severity.clone(), line: src[k].line, col: src[k].col, msg: src[k].msg.clone(),
      hint: src[k].hint.clone(), suggest: src[k].suggest.clone(),
    });
  }
  return d;
}

// IR から WGSL を出す（wgsl.um）。
export function fxsHostGenWgsl(ir: FxsIr): FxsGenOut {
  const g = fxsWgsl(ir, "");
  return { ok: g.ok, wgsl: g.source.clone(), wasm: [], diags: fxsHostDiagsCopy(g.diags) };
}

// IR から wasm を出す（wasm.um）。mzplug なら .mzplug の export も足す。
export function fxsHostGenWasm(ir: FxsIr, mzplug: bool): FxsGenOut {
  return { ok: true, wgsl: "", wasm: fxsWasmBytesEx(ir, mzplug), diags: [] };
}
