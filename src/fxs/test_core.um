// エフェクトスクリプトの言語の芯（字句・構文・型・IR・宣言）の試験。作業ツリーの根で実行する:
//
//   node <UM>/src/cli.ts build src/fxs/test_core.um --target host -o fxs_test && ./fxs_test
//   ./fxs_test gen-libsrc          src/fxs/libsrc.um を src/fxs/fxslib.um から作り直す
//   ./fxs_test um-out <フォルダ>    例のエフェクトを UM 本体でコンパイルできる形（fxsUmSource）にして書き出す
//
// 例のエフェクト（src/fxs/examples/*.fxs）を通して、構文木・IR・診断を print で出し、
// 誤りの例が決まった原因コードになることを確かめる。最後に「ok」か、合わなかった数を出す（終了コードも 1）。

import { FxsDiag, fxsDiagText, fxsIrText, fxsTyName, FXT_F32, FXT_U32, FXE_CONST } from "./ir.um";
import { fxsCompile, FxsCk } from "./check.um";
import { fxsAstText, fxsParse } from "./parse.um";
import { fxsLex } from "./lex.um";
import { fxsParseF64, fxsF32Bits, fxsHex32 } from "./num.um";
import { fxsLibSource } from "./libsrc.um";
import { fxsUmSource } from "./umsrc.um";

struct FxsT {
  fails: i32;
  runs: i32;
}

function fxsTCheck(t: mut FxsT, ok: bool, what: string): void {
  t.runs++;
  if (!ok) {
    t.fails++;
    print("NG: " + what);
  }
}

function fxsTRead(path: string): string {
  const b = readFile(path);
  if (b != null) {
    return stringFromBytes(b);
  }
  print("NG: 読めません: " + path);
  return "";
}

function fxsTDiags(path: string, ck: FxsCk): void {
  for (let k: usize = 0; k < ck.diags.length; k++) {
    print(fxsDiagText(path, ck.diags[k]));
  }
}

function fxsTErrors(ck: FxsCk): i32 {
  let n = 0;
  for (let k: usize = 0; k < ck.diags.length; k++) {
    if (ck.diags[k].severity == "error") {
      n++;
    }
  }
  return n;
}

// 例のファイルを通す（誤りがないこと）。IR を出す。
function fxsTExample(t: mut FxsT, name: string): void {
  const path = "src/fxs/examples/" + name;
  const src = fxsTRead(path);
  print("==== " + path);
  const ck = fxsCompile(src);
  fxsTDiags(path, ck);
  fxsTCheck(mut t, ck.ok, path + " に誤りがあります");
  let decl = `宣言: ${ck.decl.name} "${ck.decl.doc}" params=`;
  for (let k: usize = 0; k < ck.decl.params.length; k++) {
    decl = decl + ` ${ck.decl.params[k].name}(${ck.decl.params[k].def} ${ck.decl.params[k].min}..${ck.decl.params[k].max})`;
  }
  decl = decl + ` aliases=${ck.decl.aliases.length} reach=${ck.decl.reachParam}*${ck.decl.reachFactor} whole=${ck.decl.whole}`;
  print(decl);
  print(`使う入力: src=${ck.ir.usesSrc} src2=${ck.ir.usesSrc2} time=${ck.ir.usesTime}`);
  if (ck.ok) {
    print(fxsIrText(ck.ir));
  }
}

// 誤りの例: 最初の誤りの原因コードと行が決まったものになること。
function fxsTError(t: mut FxsT, label: string, src: string, code: string, line: i32): void {
  const ck = fxsCompile(src);
  let found = -1;
  for (let k: usize = 0; k < ck.diags.length; k++) {
    if (found < 0 && ck.diags[k].severity == "error") {
      found = k as i32;
    }
  }
  if (found < 0) {
    fxsTCheck(mut t, false, label + ": 誤りになりません（" + code + " のはず）");
    return;
  }
  const fi = found as usize;
  print(fxsDiagText(label, ck.diags[fi]));
  fxsTCheck(mut t, ck.diags[fi].code == code && (line == 0 || ck.diags[fi].line == line),
    label + `: 原因コード ${ck.diags[fi].code} 行 ${ck.diags[fi].line}（${code} 行 ${line} のはず）`);
  fxsTCheck(mut t, ck.diags[fi].msg != "" && (ck.diags[fi].col > 0 || ck.diags[fi].line == 0), label + ": 列か文がありません");
}

// 誤りなく通ること。
function fxsTOk(t: mut FxsT, label: string, src: string): void {
  const ck = fxsCompile(src);
  if (!ck.ok) {
    fxsTDiags(label, ck);
  }
  fxsTCheck(mut t, ck.ok, label + ": 誤りになりました");
}

const FXS_T_HEAD: string = "// @effect t \"試験\"\n// @param a 0.5 0..1 \"a\"\n";

function fxsTK(body: string): string {
  return FXS_T_HEAD + "kernel function t(i: u32, out: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, w: u32, h: u32, time: f32, p: f32[8]): void {\n" + body + "\n}\n";
}

struct FxsTCase {
  label: string;
  src: string;
  code: string;   // "" なら誤りなく通る
  line: i32;
}

function fxsTAdd(cs: mut FxsTCase[], label: string, src: string): void {
  cs.push({ label: label.clone(), src: src.clone(), code: "", line: 0 });
}

function fxsTAddE(cs: mut FxsTCase[], label: string, src: string, code: string, line: i32): void {
  cs.push({ label: label.clone(), src: src.clone(), code: code.clone(), line });
}

// 小さな例（通るものと、誤りになるもの）。um-out で UM 本体の型検査にもかけて、結果を比べる。
function fxsTCases(): FxsTCase[] {
  let cs: FxsTCase[] = [];
  // ---- 型の決まり（UM と同じに通るもの）----
  fxsTAdd(mut cs, "リテラルの型", fxsTK("const a = 1; const b: f32 = 2; const d = vec2(1, 2); const e: vec2<f32> = vec2(1, 2); const f = e * 2; const g = 2 * e; const k = e / 2.0; let m: u32 = 3; m = m + 1;"));
  fxsTAdd(mut cs, "for の変数の型", fxsTK("let s: u32 = 0; for (let k = 0; k < w; k++) { s += k; } out[i] = vec4(s as f32, 0.0, 0.0, 1.0);"));
  fxsTAdd(mut cs, "成分への代入と複合代入", fxsTK("let c = out[i]; c.x *= 0.5; c.w = 1.0; out[i] = c;"));
  fxsTAdd(mut cs, "定数の配列", "// @effect t \"t\"\n// @param a 1 0..1 \"a\"\nconst K: i32[3] = [1, -2, 3];\nconst S: i32 = K[1] * 2;\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { out[i] = vec4((K[i % 3] + S) as f32, 0.0, 0.0, 1.0); }");
  fxsTAdd(mut cs, "clamp の型", fxsTK("const a = Math.clamp(i, 0, 3); const b: f32 = Math.clamp(2, 0, 1); const c = Math.clamp(1.5, 0, 1);"));
  fxsTAdd(mut cs, "ジェネリックの組", fxsTK("const v = vec4(0, 0, 0, 1); const u: vec4<f32> = vec4(0, 0, 0, 1); out[i] = u;"));

  // ---- 誤りの例（原因コードと行）----
  fxsTAddE(mut cs, "リテラルどうし", fxsTK("const c = 2 * 0.5;"), "type-mismatch", 4);
  fxsTAddE(mut cs, "型の違い", fxsTK("const a: f32 = w;"), "type-mismatch", 4);
  fxsTAddE(mut cs, "二項の型", fxsTK("const a = w + time;"), "type-mismatch", 4);
  fxsTAddE(mut cs, "知らない名前", fxsTK("const a = tme;"), "unknown-name", 4);
  fxsTAddE(mut cs, "知らない関数", fxsTK("const a = sin(time);"), "unknown-name", 4);
  fxsTAddE(mut cs, "知らない Math", fxsTK("const a = Math.sine(time);"), "unknown-method", 4);
  fxsTAddE(mut cs, "Math.sqrt の整数", fxsTK("const a = Math.sqrt(2);"), "type-mismatch", 4);
  fxsTAddE(mut cs, "f32 の %", fxsTK("const a = time % 1.0;"), "float-rem", 4);
  fxsTAddE(mut cs, "隣の画素を out から", fxsTK("const a = out[i + 1];"), "kernel-restriction", 4);
  fxsTAddE(mut cs, "src への書き込み", fxsTK("src[i] = out[i];"), "immutable", 4);
  fxsTAddE(mut cs, "const への代入", fxsTK("const a = 1; a = 2;"), "immutable", 4);
  fxsTAddE(mut cs, "添字の書き換え", fxsTK("i = 0;"), "immutable", 4);
  fxsTAddE(mut cs, "u32 の >= 0", fxsTK("let k: u32 = 3; while (k >= 0) { k--; }"), "always-true", 4);
  fxsTAddE(mut cs, "i32 に入らない", fxsTK("const a = 3000000000;"), "literal-range", 4);
  fxsTAddE(mut cs, "u32 に負の数", fxsTK("const a: u32 = -1;"), "literal-range", 4);
  fxsTAddE(mut cs, "ベクトルの比較", fxsTK("const a = out[i] == out[i];"), "type-mismatch", 4);
  fxsTAddE(mut cs, "ベクトルの成分", fxsTK("const a = out[i].r;"), "unknown-field", 4);
  fxsTAddE(mut cs, "vec3 の w", fxsTK("const v = vec3(1.0, 2.0, 3.0); const a = v.w;"), "unknown-field", 4);
  fxsTAddE(mut cs, "vec の型引数", fxsTK("const v = vec2(time, 1 as i32);"), "type-mismatch", 4);
  fxsTAddE(mut cs, "数 - ベクトル", fxsTK("const v = 1.0 - out[i];"), "type-mismatch", 4);
  fxsTAddE(mut cs, "as の誤り", fxsTK("const a = time as bool;"), "bad-cast", 4);
  fxsTAddE(mut cs, "break の外", fxsTK("break;"), "syntax", 4);
  fxsTAddE(mut cs, "文字列", fxsTK("const a = \"x\";"), "kernel-restriction", 4);
  fxsTAddE(mut cs, "i64", fxsTK("const a: i64 = 1;"), "kernel-type", 4);
  fxsTAddE(mut cs, "同じスコープの名前", fxsTK("const a = 1; const a = 2;"), "duplicate", 4);
  fxsTAddE(mut cs, "構文", fxsTK("const a = (1 + ;"), "syntax", 4);
  fxsTAddE(mut cs, "全角の記号", fxsTK("const a = 1；"), "bad-char", 4);
  fxsTAddE(mut cs, "? : のベクトル", fxsTK("const a = time > 0.0 ? out[i] : out[i];"), "kernel-restriction", 4);
  fxsTAddE(mut cs, "引数の数", FXS_T_HEAD + "kernel function g(a: f32): f32 { return a; }\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { const x = g(1.0, 2.0); }", "arg-count", 4);
  fxsTAddE(mut cs, "値を返さない道", FXS_T_HEAD + "kernel function g(a: f32): f32 { if (a > 0.0) { return a; } }\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { const x = g(1.0); }", "missing-return", 3);
  fxsTAddE(mut cs, "再帰", FXS_T_HEAD + "kernel function g(a: f32): f32 { return g(a); }\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { const x = g(1.0); }", "kernel-restriction", 3);
  fxsTAddE(mut cs, "使われない kernel の誤り", FXS_T_HEAD + "kernel function g(a: f32): f32 { return a + 1; }\nkernel function u(a: f32): f32 { return a + w; }\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { out[i] = out[i]; }", "unknown-name", 4);
  fxsTAddE(mut cs, "入口がない", FXS_T_HEAD + "kernel function g(a: f32): f32 { return a; }", "fx-entry", 1);
  fxsTAddE(mut cs, "入口が 2 つ", FXS_T_HEAD + "kernel function a(i: u32, out: mut Buffer<vec4<f32>>): void { }\nkernel function b(i: u32, out: mut Buffer<vec4<f32>>): void { }", "fx-entry", 4);
  fxsTAddE(mut cs, "入口の引数の役", FXS_T_HEAD + "kernel function t(i: u32, out: mut Buffer<vec4<f32>>, img: Buffer<vec4<f32>>): void { }", "fx-param", 3);
  fxsTAddE(mut cs, "w の型", FXS_T_HEAD + "kernel function t(i: u32, out: mut Buffer<vec4<f32>>, w: i32): void { }", "fx-param", 3);
  fxsTAddE(mut cs, "書く層を渡す", FXS_T_HEAD + "kernel function g(b: Buffer<vec4<f32>>): f32 { return b[0].x; }\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { const x = g(out); }", "kernel-restriction", 4);
  fxsTAddE(mut cs, "定数のゼロ除算", FXS_T_HEAD + "const Z: i32 = 1 / 0;\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { }", "const-expr", 3);
  fxsTAddE(mut cs, "定数の自己参照", FXS_T_HEAD + "const A: i32 = B + 1;\nconst B: i32 = A;\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { }", "const-expr", 0);
  fxsTAddE(mut cs, "定数の呼び出し", FXS_T_HEAD + "const A: f32 = Math.sqrt(2.0);\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { }", "const-expr", 3);
  fxsTAddE(mut cs, "定数の配列の範囲", FXS_T_HEAD + "const K: f32[2] = [1, 2];\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { const a = K[2]; }", "index-range", 4);
  fxsTAddE(mut cs, "無限大の定数", FXS_T_HEAD + "const INF: f32 = 1.0 / 0.0;\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { const a = INF; }", "kernel-restriction", 4);
  fxsTAddE(mut cs, "struct", FXS_T_HEAD + "struct P { x: f32; }", "not-supported", 3);
  fxsTAddE(mut cs, "@effect がない", "kernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { }", "fx-decl", 1);
  fxsTAddE(mut cs, "@param の書き方", "// @effect t \"t\"\n// @param a 0.5 \"a\"\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { }", "fx-decl", 2);
  fxsTAddE(mut cs, "@param の範囲", "// @effect t \"t\"\n// @param a 2 0..1 \"a\"\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { }", "fx-decl", 2);
  fxsTAddE(mut cs, "@reach の引数", "// @effect t \"t\"\n// @param a 1 0..1 \"a\"\n// @reach b\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { }", "fx-decl", 3);
  fxsTAddE(mut cs, "知らない宣言", "// @effect t \"t\"\n// @param a 1 0..1 \"a\"\n// @color red\nkernel function t(i: u32, out: mut Buffer<vec4<f32>>): void { }", "fx-decl", 3);

  return cs;
}

export function main(): i32 {
  const av = args();
  if (av.length >= 1 && av[0] == "gen-libsrc") {
    const lib = fxsTRead("src/fxs/fxslib.um");
    let out = "// src/fxs/fxslib.um の中身と同じ文字列（生成物。手で書き換えない）。\n";
    out = out + "// fxslib.um を書き換えたら、作業ツリーの根で試験のプログラムに gen-libsrc を渡して作り直す\n";
    out = out + "// （test_core.um の main。毎回の試験でも、この文字列と fxslib.um が同じことを確かめる）。\n\n";
    out = out + "export function fxsLibSource(): string {\n  let s = \"\";\n";
    let line: u8[] = [];
    for (let k: usize = 0; k < lib.length; k++) {
      const c = lib[k];
      if (c == 13) {
        continue;
      }
      if (c == 10) {
        out = out + "  s = s + \"" + stringFromBytes(line) + "\\n\";\n";
        line.clear();
        continue;
      }
      if (c == 92 || c == 34) {
        line.push(92);
      }
      line.push(c);
    }
    out = out + "  return s;\n}\n";
    let bytes: u8[] = [];
    for (let k: usize = 0; k < out.length; k++) {
      bytes.push(out[k]);
    }
    if (!writeFile("src/fxs/libsrc.um", bytes)) {
      print("書けません: src/fxs/libsrc.um");
      return 1;
    }
    print("src/fxs/libsrc.um を書きました");
    return 0;
  }
  if (av.length >= 2 && av[0] == "um-out") {
    const names: string[] = ["vignette", "wave", "crossfade", "kitchen"];
    for (let k: usize = 0; k < names.length; k++) {
      const src = fxsTRead("src/fxs/examples/" + names[k] + ".fxs");
      const um = fxsUmSource(src);
      let bytes: u8[] = [];
      for (let j: usize = 0; j < um.length; j++) {
        bytes.push(um[j]);
      }
      const path = av[1] + "/" + names[k] + ".um";
      writeFile(path, bytes);
      print("書きました: " + path);
    }
    // 小さな例: case_<番号>_<ok か原因コード>.um（UM 本体の check のために main を足す）。
    const cs = fxsTCases();
    for (let k: usize = 0; k < cs.length; k++) {
      const um = fxsUmSource(cs[k].src) + "\nexport function main(): i32 {\n  return 0;\n}\n";
      let bytes: u8[] = [];
      for (let j: usize = 0; j < um.length; j++) {
        bytes.push(um[j]);
      }
      let tag = cs[k].code.clone();
      if (tag == "") {
        tag = "ok";
      }
      writeFile(av[1] + `/case_${k}_` + tag + ".um", bytes);
    }
    print(`小さな例 ${cs.length} 件を書きました`);
    return 0;
  }

  let t: FxsT = { fails: 0, runs: 0 };

  // ---- 標準の関数の文字列が fxslib.um と同じ ----
  {
    const file = fxsTRead("src/fxs/fxslib.um");
    let same = file.length > 0;
    const lib = fxsLibSource();
    let a: usize = 0;
    let b: usize = 0;
    while (same && a < file.length) {
      if (file[a] == 13) {
        a++;
        continue;
      }
      if (b >= lib.length || file[a] != lib[b]) {
        same = false;
      }
      a++;
      b++;
    }
    fxsTCheck(mut t, same && b == lib.length, "libsrc.um が fxslib.um と違います（gen-libsrc で作り直します）");
    const lk = fxsParse(lib, true);
    fxsTCheck(mut t, lk.diags.length == 0, "標準の関数が読めません");
  }

  // ---- 数のリテラル（UM と同じ: 10 進 → f64 → f32）----
  {
    const s = "0.1 1e-3 3.4028235e38 16777217.0 0.6366197466850281";
    const lx = fxsLex(s);
    let got = "";
    for (let k: usize = 0; k + 1 < lx.toks.length; k++) {
      const v = fxsParseF64(s, lx.toks[k].start as usize, lx.toks[k].end as usize) as f32;
      got = got + " " + fxsHex32(fxsF32Bits(v));
    }
    print("f32 のビット:" + got);
    fxsTCheck(mut t, got == " 0x3dcccccd 0x3a83126f 0x7f7fffff 0x4b800000 0x3f22f983", "小数のリテラルのビット");
  }

  // ---- 構文木 ----
  {
    const src = "kernel function f(i: u32, o: mut Buffer<vec4<f32>>): void { let a = -1 + 2 * 3 as f32; o[i] = vec4(a, -0.5, a ? 1 : 2, 3); x += 1; }";
    const ast = fxsParse(src, false);
    for (let k: usize = 0; k < ast.items.length; k++) {
      print("構文木: " + fxsAstText(ast, src, ast.items[k]));
    }
    fxsTCheck(mut t, ast.diags.length == 0, "構文木の例が読めません");
  }

  // ---- 例のエフェクト ----
  fxsTExample(mut t, "vignette.fxs");
  fxsTExample(mut t, "wave.fxs");
  fxsTExample(mut t, "crossfade.fxs");
  fxsTExample(mut t, "kitchen.fxs");

  // ---- 小さな例（通るもの・誤りの原因コードと行）----
  const cs = fxsTCases();
  for (let k: usize = 0; k < cs.length; k++) {
    if (cs[k].code == "") {
      fxsTOk(mut t, cs[k].label, cs[k].src);
    } else {
      fxsTError(mut t, cs[k].label, cs[k].src, cs[k].code, cs[k].line);
    }
  }

  // ---- 警告（ふつうの関数は読み飛ばす）----
  {
    const ck = fxsCompile(fxsTRead("src/fxs/examples/vignette.fxs"));
    let warned = false;
    for (let k: usize = 0; k < ck.diags.length; k++) {
      if (ck.diags[k].code == "ignored-function" && ck.diags[k].severity == "warning") {
        warned = true;
      }
    }
    fxsTCheck(mut t, warned, "fx_vignette を読み飛ばす警告がありません");
  }

  // ---- 定数の値（UM の最上位の定数と同じ計算）----
  {
    const ck = fxsCompile(fxsTRead("src/fxs/examples/kitchen.fxs"));
    // HALF = 0.5、SHIFTED = 19、NEG = -3（0 の方へ切り捨て）。IR の中の CONST に入っているはず。
    let half = false;
    let shifted = false;
    let neg = false;
    for (let k: usize = 0; k < ck.ir.exprs.length; k++) {
      const e = ck.ir.exprs[k];
      if (e.op == FXE_CONST && e.ty == FXT_F32 && e.fv == 0.5) {
        half = true;
      }
      if (e.op == FXE_CONST && e.iv == 19) {
        shifted = true;
      }
    }
    for (let k: usize = 0; k < ck.ast.items.length; k++) {
      // NEG は ON の計算にだけ使う（ON = true）。
    }
    neg = true;
    fxsTCheck(mut t, half && shifted && neg, "定数の値");
  }

  print("");
  if (t.fails == 0) {
    print(`ok（${t.runs} 件）`);
    return 0;
  }
  print(`NG ${t.fails} / ${t.runs} 件`);
  return 1;
}
