;; testdata/hosttest.fxs の kernel を手で wasm にしたもの（src/fxs/hostbind.um の約束の形。.mzplug の export も持つ）。
;; src/fxs/test_host.um が wasmFromWat でバイナリにして使う。
(module
  (memory (export "memory") 1)
  (global $top (mut i32) (i32.const 1024))
  (func $alloc (export "fxs_alloc") (param $n i32) (result i32)
    (local $at i32) (local $end i32) (local $pages i32)
    (local.set $at (i32.and (i32.add (global.get $top) (i32.const 15)) (i32.const -16)))
    (local.set $end (i32.add (local.get $at) (local.get $n)))
    (if (i32.or (i32.lt_s (local.get $n) (i32.const 0)) (i32.lt_u (local.get $end) (local.get $at)))
      (then (return (i32.const 0))))
    (local.set $pages (i32.add (i32.shr_u (local.get $end) (i32.const 16)) (i32.const 1)))
    (if (i32.gt_u (local.get $pages) (memory.size))
      (then
        (if (i32.eq (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const -1))
          (then (return (i32.const 0))))))
    (global.set $top (local.get $end))
    (local.get $at))
  ;; 範囲外の添字を最後の要素に切り詰める（長さ 0 は 1 要素とみなす）
  (func $clamp (param $i i32) (param $len i32) (result i32)
    (local $m i32)
    (local.set $m (i32.sub (select (local.get $len) (i32.const 1) (i32.gt_u (local.get $len) (i32.const 1))) (i32.const 1)))
    (select (local.get $i) (local.get $m) (i32.lt_u (local.get $i) (local.get $m))))
  (func $main (export "fxs_main")
    (param $outAt i32) (param $outLen i32) (param $srcAt i32) (param $srcLen i32) (param $src2At i32) (param $src2Len i32)
    (param $w i32) (param $h i32) (param $i0 i32) (param $i1 i32) (param $time f32) (param $p0 f32) (param $p1 f32) (param $p2 f32) (param $p3 f32) (param $p4 f32) (param $p5 f32) (param $p6 f32) (param $p7 f32)
    (local $i i32) (local $o i32) (local $a i32) (local $b i32) (local $r i32)
    (local.set $i (local.get $i0))
    (block $done
      (loop $L
        (br_if $done (i32.ge_u (local.get $i) (local.get $i1)))
        (local.set $o (i32.add (local.get $outAt) (i32.shl (call $clamp (local.get $i) (local.get $outLen)) (i32.const 4))))
        (local.set $a (i32.add (local.get $srcAt) (i32.shl (call $clamp (i32.add (local.get $i) (i32.const 1)) (local.get $srcLen)) (i32.const 4))))
        (local.set $b (i32.add (local.get $src2At) (i32.shl (call $clamp (local.get $i) (local.get $src2Len)) (i32.const 4))))
        (local.set $r (i32.const 0))
        (if (local.get $w) (then (local.set $r (i32.rem_u (local.get $i) (local.get $w)))))
        (f32.store offset=0 (local.get $o) (f32.mul (f32.load offset=0 (local.get $o)) (local.get $p0)))
        (f32.store offset=4 (local.get $o) (f32.load offset=4 (local.get $a)))
        (f32.store offset=8 (local.get $o) (f32.add (f32.load offset=8 (local.get $b)) (local.get $time)))
        (f32.store offset=12 (local.get $o) (f32.convert_i32_u (local.get $r)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $L))))
  ;; .mzplug の形（abi 1）: src は tmp に写し、src2 はゼロの領域（16 バイト目）、time は 0
  (func (export "umAlloc") (param $n i32) (result i32) (call $alloc (local.get $n)))
  (func (export "umFree") (param $at i32))
  (func (export "mzfx_apply") (param $l i32) (param $ll i32) (param $t i32) (param $tl i32) (param $w i32) (param $h i32) (param $p0 f32) (param $p1 f32) (param $p2 f32) (param $p3 f32) (param $p4 f32) (param $p5 f32) (param $p6 f32) (param $p7 f32)
    (memory.copy (local.get $t) (local.get $l) (i32.shl (local.get $ll) (i32.const 4)))
    (call $main (local.get $l) (local.get $ll) (local.get $t) (local.get $tl) (i32.const 16) (i32.const 1)
      (local.get $w) (local.get $h) (i32.const 0) (local.get $ll) (f32.const 0) (local.get $p0) (local.get $p1) (local.get $p2) (local.get $p3) (local.get $p4) (local.get $p5) (local.get $p6) (local.get $p7))))
