// @effect nanfold "計算した値どうしの引き算 e - e（e が無限大・NaN なら NaN）の試し"
// @param a 1 -4..4 "倍率"
//
// GPU のドライバが e - e を 0 に畳まないこと（src/fxs/wgsl.um の um_zl / um_zr）を、特別な値の画像で確かめる（test_three.um）。

kernel function nanfoldSub(a: f32, b: f32): f32 {
  return a - b;
}

kernel function nanfold(i: u32, out: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, p: f32[8]): void {
  const c = src[i];
  const k = c.y * p[0];
  const big = 3.0e38 * 10.0 - 3.0e38 * 10.0;
  let fin: f32 = 0.0;
  if (k - k == 0.0) {
    fin = 1.0;
  }
  out[i] = vec4(c.x * 2.0 - c.x * 2.0, k - k, (c.z + 1.0) - (c.z + 1.0) + nanfoldSub(c.w, c.w), big + fin + (c.x - c.x));
}
