// @effect bigtab "大きな定数の表を添字で読む試し"
// @param a 1 0..1 "使わない"
//
// 最上位の定数の配列（4096 要素の f32 と 1000 要素の i32）を、動的な添字で読む。GPU では表を WGSL の const にせず、
// binding 4 の Buffer（b_tbl）で渡す（src/fxs/wgsl.um）。const にすると、読むたびに表を写して GPU のデバイスが失われた。

kernel function bigtab(i: u32, out: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, p: f32[8]): void {
  const c = src[i];
  const j = i * 7;
  const t = (c.x * 4096.0) as u32;
  out[i] = vec4(T[i], T[j] * p[0], T[t], (U[i % 1000] as f32) + c.w);
}

