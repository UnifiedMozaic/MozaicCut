// @effect looplim "ループの回数の上限（65536 回）の試し"
// @param a 1 0..1 "使わない"
//
// for / while / do-while / continue のあるループが、65536 回で打ち切られること（3 通りで同じ。UM 本体の版は
// src/fxs/umsrc.um の fxsUmLoopLimit が同じ数え方を書き足す）を確かめる（test_three.um）。先頭の 64 画素だけ重い。

kernel function looplim(i: u32, out: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, p: f32[8]): void {
  const c = src[i];
  if (i >= 64) {
    out[i] = c;
    return;
  }
  const n: u32 = 65530 + i % 16;
  let s: u32 = 0;
  for (let k: u32 = 0; k < n; k++) {
    s += 1;
  }
  let m: u32 = 0;
  while (m < n) {
    m++;
  }
  let q: u32 = 0;
  do {
    q++;
  } while (q < n);
  let r: u32 = 0;
  for (let k: u32 = 0; k < n; k++) {
    if (k % 3 == 0) {
      continue;
    }
    r += 1;
  }
  out[i] = vec4(s as f32, m as f32, q as f32, (r as f32) + c.x * p[0] * 0.0);
}
