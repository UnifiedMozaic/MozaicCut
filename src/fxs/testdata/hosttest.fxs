// @effect hosttest "ホストの試験（out・src・src2・time・p を全部使う）"
// @param gain 1 0..4 "赤の倍率"
// @param other 0.05 0..1 "使わない"
//
// testdata/hosttest.wgsl と testdata/hosttest.wat は、この kernel を手で WGSL / wasm にしたもの
// （WGSL は UM 本体の --emit-wgsl の出力）。src/fxs/test_host.um が、ホストの束縛・帯の分け方を確かめるのに使う。

kernel function hosttest(i: u32, out: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, src2: Buffer<vec4<f32>>, w: u32, h: u32, time: f32, p: f32[8]): void {
  const c = out[i];
  const a = src[i + 1];
  const b = src2[i];
  out[i] = vec4(c.x * p[0], a.y, b.z + time, (i % w) as f32);
}
