// エフェクトスクリプトを、UM 本体でコンパイルできる文字列にする（3 通りの実行で画素が一致するかの試験のため）。
//
// エフェクトスクリプトは UM の kernel の書き方そのものだが、Math.sin などの標準の関数は UM 本体の Math にまだない。
// ここでは Math.sin(...) を fxsLibSin(...) のように字句の単位で置き換え、標準の関数（fxslib.um）の中身を後ろに足す。
// 置き換えるのは Math.sin / cos / pow / exp / log / atan2 / fract / mix / clamp / step / smoothstep。
// それ以外（Math.sqrt など、UM 本体にあるもの）はそのまま。
//
// 入口の kernel はそのまま残るので、UM 本体のプログラムから dispatch(<入口>, w * h, mut out, src, w, h, p, ...) で呼べる
// （src などは入口の引数の並びのとおりに渡す）。UM 本体が Math.sin などを持つようになれば、この置き換えは要らない。

import { FxsTok, fxsLex, fxsRangeIs, fxsSub, FXK_ID, FXK_PUNCT } from "./lex.um";
import { fxsLibSource } from "./libsrc.um";

// Math.<name> の置き換え先（なければ ""）。
export function fxsLibNameOf(src: string, start: i32, end: i32): string {
  if (fxsRangeIs(src, start, end, "sin")) { return "fxsLibSin"; }
  if (fxsRangeIs(src, start, end, "cos")) { return "fxsLibCos"; }
  if (fxsRangeIs(src, start, end, "pow")) { return "fxsLibPow"; }
  if (fxsRangeIs(src, start, end, "exp")) { return "fxsLibExp"; }
  if (fxsRangeIs(src, start, end, "log")) { return "fxsLibLog"; }
  if (fxsRangeIs(src, start, end, "atan2")) { return "fxsLibAtan2"; }
  if (fxsRangeIs(src, start, end, "fract")) { return "fxsLibFract"; }
  if (fxsRangeIs(src, start, end, "mix")) { return "fxsLibMix"; }
  if (fxsRangeIs(src, start, end, "clamp")) { return "fxsLibClamp"; }
  if (fxsRangeIs(src, start, end, "step")) { return "fxsLibStep"; }
  if (fxsRangeIs(src, start, end, "smoothstep")) { return "fxsLibSmoothstep"; }
  return "";
}

// UM 本体でコンパイルできる文字列（置き換えたスクリプト + 標準の関数）。行番号はスクリプトの部分で変わらない。
export function fxsUmSource(src: string): string {
  const lx = fxsLex(src);
  let out: u8[] = [];
  let copied: usize = 0;
  let k: usize = 0;
  while (k + 2 < lx.toks.length) {
    const a = lx.toks[k];
    const b = lx.toks[k + 1];
    const c = lx.toks[k + 2];
    if (a.kind == FXK_ID && fxsRangeIs(src, a.start, a.end, "Math") && b.kind == FXK_PUNCT && fxsRangeIs(src, b.start, b.end, ".")
      && c.kind == FXK_ID) {
      const lib = fxsLibNameOf(src, c.start, c.end);
      if (lib != "") {
        while (copied < (a.start as usize)) {
          out.push(src[copied]);
          copied++;
        }
        for (let j: usize = 0; j < lib.length; j++) {
          out.push(lib[j]);
        }
        copied = c.end as usize;
        k += 3;
        continue;
      }
    }
    k++;
  }
  while (copied < src.length) {
    out.push(src[copied]);
    copied++;
  }
  out.push(10);
  const lib = fxsLibSource();
  for (let j: usize = 0; j < lib.length; j++) {
    out.push(lib[j]);
  }
  return stringFromBytes(out);
}
