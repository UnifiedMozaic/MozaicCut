// @effect edges "輪郭の検出（ソーベル）"
// @param strength 2 0..8 "輪郭の強調（大きいほど弱い輪郭も線になる）"
// @param threshold 0.1 0..1 "線にし始める輪郭の強さ"
// @param width 1 1..8 "線の太さ（隣の画素を読む距離。画素）"
// @param color 0.7 0..1 "線の色（0 で白、1 で元の色を明るくしたもの）"
// @param blend 0 0..1 "線の下に元の絵を残す割合（0 で黒地）"
// @param invert 0 0..1 "白黒を反転する（1 で白地に黒い線。鉛筆画のように）"
// @alias sobel
// @alias outline
// @reach width
//
// 縦・横のソーベルのフィルタを r, g, b のそれぞれに掛け、勾配の大きさを 3 色で平均して輪郭の強さにする
// （明るさだけを見ると、明るさの同じ赤と緑の境目が消えるため）。色はアルファを掛けて（プリマルチプライの形で）
// 読むので、透明な所との境目も輪郭になる。結果は不透明にせず、元のアルファと輪郭の強い方をアルファにする。

kernel function edgesTexel(src: Buffer<vec4<f32>>, x: i32, y: i32, w: u32, h: u32): vec3<f32> {
  const c = src[(Math.clamp(y, 0, (h as i32) - 1) as u32) * w + (Math.clamp(x, 0, (w as i32) - 1) as u32)];
  return vec3(c.x * c.w, c.y * c.w, c.z * c.w);
}

kernel function edges(i: u32, out: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  const c = out[i];
  const x = (i % w) as i32;
  const y = (i / w) as i32;
  const d = Math.max(Math.floor(p[2] + 0.5), 1.0) as i32;
  const tl = edgesTexel(src, x - d, y - d, w, h);
  const tc = edgesTexel(src, x, y - d, w, h);
  const tr = edgesTexel(src, x + d, y - d, w, h);
  const ml = edgesTexel(src, x - d, y, w, h);
  const mr = edgesTexel(src, x + d, y, w, h);
  const bl = edgesTexel(src, x - d, y + d, w, h);
  const bc = edgesTexel(src, x, y + d, w, h);
  const br = edgesTexel(src, x + d, y + d, w, h);
  const gx = (tr + mr * 2.0 + br) - (tl + ml * 2.0 + bl);
  const gy = (bl + bc * 2.0 + br) - (tl + tc * 2.0 + tr);
  const m2 = gx.x * gx.x + gx.y * gx.y + gx.z * gx.z + gy.x * gy.x + gy.y * gy.y + gy.z * gy.z;
  const mag = Math.sqrt(m2 / 3.0) * 0.25 * p[0];
  const e = Math.smoothstep(p[1], p[1] + 0.15, mag);
  // 線の色: 白と、元の色を最も明るい成分が 1 になるまで持ち上げたもの
  const mx = Math.max(Math.max(c.x, Math.max(c.y, c.z)), 0.0001);
  const lc = vec3(Math.mix(1.0, c.x / mx, p[3]), Math.mix(1.0, c.y / mx, p[3]), Math.mix(1.0, c.z / mx, p[3]));
  const bg = vec3(c.x, c.y, c.z) * p[4];
  let rgb = bg * (1.0 - e) + lc * e;
  if (p[5] > 0.0) {
    const inv = vec3(1.0 - rgb.x, 1.0 - rgb.y, 1.0 - rgb.z);
    rgb = rgb * (1.0 - p[5]) + inv * p[5];
  }
  out[i] = vec4(Math.clamp(rgb.x, 0.0, 1.0), Math.clamp(rgb.y, 0.0, 1.0), Math.clamp(rgb.z, 0.0, 1.0), Math.max(c.w, e));
}
