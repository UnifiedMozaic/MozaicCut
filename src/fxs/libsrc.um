// src/fxs/fxslib.um の中身と同じ文字列（生成物。手で書き換えない）。
// fxslib.um を書き換えたら、作業ツリーの根で試験のプログラムに gen-libsrc を渡して作り直す
// （test_core.um の main。毎回の試験でも、この文字列と fxslib.um が同じことを確かめる）。

export function fxsLibSource(): string {
  let s = "";
  s = s + "// エフェクトスクリプトの標準の関数（Math.sin など、UM 本体の Math にないもの）。\n";
  s = s + "//\n";
  s = s + "// エフェクトスクリプトの Math.sin(x) などは、ここの kernel function（fxsLibSin など）の呼び出しになる。\n";
  s = s + "// 中身は + - * /・Math.floor・Math.min / max・比較・as だけで書いてあるので、UM 本体の kernel と同じ規則\n";
  s = s + "// （FMA にまとめない、割り算を正しく丸める）で計算すれば、CPU（UM 本体・wasm）と GPU（WGSL）で同じビットになる。\n";
  s = s + "// 精度は f32 で数 ULP くらい（pow は相対誤差 1e-5 くらい）。非正規化数は作らない（GPU が 0 に潰すことがあるため）。\n";
  s = s + "//\n";
  s = s + "// このファイルは UM の kernel としてそのままコンパイルできる。エフェクトスクリプトの文字列を UM 本体で\n";
  s = s + "// コンパイルするときは、fxsUmSource（compile.um）が Math.sin を fxsLibSin に置き換え、このファイルの中身を後ろに足す。\n";
  s = s + "// fxsLibClamp だけはジェネリック（エフェクトスクリプトのコンパイラは、これを読まずに Math.min / max の組にする）。\n";
  s = s + "//\n";
  s = s + "// src/fxs/libsrc.um の fxsLibSource() は、このファイルの中身と同じ文字列（test_core.um が一致を確かめる）。\n";
  s = s + "// このファイルを書き換えたら libsrc.um も作り直す。\n";
  s = s + "\n";
  s = s + "// sin / cos。q = round(x * 2 / pi) で [-pi/4, pi/4] に寄せ（pi/2 を 3 つに分けて引く。|q| < 4096 までは\n";
  s = s + "// 掛け算が丸まらない）、多項式で計算する。phase = 1 で cos。\n";
  s = s + "kernel function fxsLibSinCos(x: f32, phase: i32): f32 {\n";
  s = s + "  const q = Math.floor(x * 0.6366197466850281 + 0.5);\n";
  s = s + "  const r = ((x - q * 1.5703125) - q * 0.0004837512969970703) - q * 7.549790126404332e-8;\n";
  s = s + "  const n = ((q as i32) + phase) & 3;\n";
  s = s + "  const z = r * r;\n";
  s = s + "  let v: f32 = 0.0;\n";
  s = s + "  if ((n & 1) == 0) {\n";
  s = s + "    v = r + r * z * (-1.6666667163e-01 + z * (8.3333337680e-03 + z * (-1.9841270114e-04 + z * 2.7557314297e-06)));\n";
  s = s + "  } else {\n";
  s = s + "    v = 1.0 - 0.5 * z + z * z * (4.1666667908e-02 + z * (-1.3888889225e-03 + z * (2.4801587642e-05 + z * -2.7557314297e-07)));\n";
  s = s + "  }\n";
  s = s + "  if (n >= 2) {\n";
  s = s + "    v = -v;\n";
  s = s + "  }\n";
  s = s + "  return v;\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "kernel function fxsLibSin(x: f32): f32 {\n";
  s = s + "  return fxsLibSinCos(x, 0);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "kernel function fxsLibCos(x: f32): f32 {\n";
  s = s + "  return fxsLibSinCos(x, 1);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// v * 2^k（k は -126〜255。結果が正規化数か無限大になる所だけで使う）。\n";
  s = s + "kernel function fxsLibScale(v: f32, k: i32): f32 {\n";
  s = s + "  let n = k;\n";
  s = s + "  let r = v;\n";
  s = s + "  if (n > 127) {\n";
  s = s + "    r = r * 1.7014118346046923e38;\n";
  s = s + "    n = n - 127;\n";
  s = s + "  }\n";
  s = s + "  let b: f32 = 2.0;\n";
  s = s + "  if (n < 0) {\n";
  s = s + "    b = 0.5;\n";
  s = s + "    n = -n;\n";
  s = s + "  }\n";
  s = s + "  let s: f32 = 1.0;\n";
  s = s + "  while (n > 0) {\n";
  s = s + "    if ((n & 1) != 0) {\n";
  s = s + "      s = s * b;\n";
  s = s + "    }\n";
  s = s + "    b = b * b;\n";
  s = s + "    n = n >> 1;\n";
  s = s + "  }\n";
  s = s + "  return r * s;\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// e^x。x = k * ln2 + r（|r| <= ln2 / 2）にして、e^r を多項式で、2^k を掛ける。\n";
  s = s + "// 結果が非正規化数になる所（x < -87.33654）は 0、大きすぎる所は無限大。\n";
  s = s + "kernel function fxsLibExp(x: f32): f32 {\n";
  s = s + "  if (x != x) {\n";
  s = s + "    return x;\n";
  s = s + "  }\n";
  s = s + "  if (x > 89.0) {\n";
  s = s + "    return 1.0 / 0.0;\n";
  s = s + "  }\n";
  s = s + "  if (x < -87.33654) {\n";
  s = s + "    return 0.0;\n";
  s = s + "  }\n";
  s = s + "  const k = Math.floor(x * 1.4426950216293335 + 0.5);\n";
  s = s + "  const r = (x - k * 0.693145751953125) - k * 1.428606765330187e-06;\n";
  s = s + "  const p = 1.0 + r * (1.0 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333\n";
  s = s + "    + r * (0.001388888888888889 + r * 0.0001984126984126984))))));\n";
  s = s + "  return fxsLibScale(p, k as i32);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// 自然対数。x = m * 2^e（sqrt(1/2) <= m <= sqrt(2)）にして、log(m) = 2 atanh((m - 1) / (m + 1)) を級数で。\n";
  s = s + "// x < 0 は NaN、0 は -無限大、無限大は無限大。\n";
  s = s + "kernel function fxsLibLog(x: f32): f32 {\n";
  s = s + "  if (x != x) {\n";
  s = s + "    return x;\n";
  s = s + "  }\n";
  s = s + "  if (x < 0.0) {\n";
  s = s + "    const z: f32 = 0.0;\n";
  s = s + "    return z / z;\n";
  s = s + "  }\n";
  s = s + "  if (x == 0.0) {\n";
  s = s + "    return -1.0 / 0.0;\n";
  s = s + "  }\n";
  s = s + "  if (x > 3.4028234663852886e38) {\n";
  s = s + "    return x;\n";
  s = s + "  }\n";
  s = s + "  let m = x;\n";
  s = s + "  let e = 0;\n";
  s = s + "  if (m < 1.1754943508222875e-38) {\n";
  s = s + "    m = m * 16777216.0;\n";
  s = s + "    e = -24;\n";
  s = s + "  }\n";
  s = s + "  if (m >= 18446744073709551616.0) {\n";
  s = s + "    m = m * 5.421010862427522e-20;\n";
  s = s + "    e = e + 64;\n";
  s = s + "  }\n";
  s = s + "  if (m >= 4294967296.0) {\n";
  s = s + "    m = m * 2.3283064365386963e-10;\n";
  s = s + "    e = e + 32;\n";
  s = s + "  }\n";
  s = s + "  if (m >= 65536.0) {\n";
  s = s + "    m = m * 0.0000152587890625;\n";
  s = s + "    e = e + 16;\n";
  s = s + "  }\n";
  s = s + "  if (m >= 256.0) {\n";
  s = s + "    m = m * 0.00390625;\n";
  s = s + "    e = e + 8;\n";
  s = s + "  }\n";
  s = s + "  if (m >= 16.0) {\n";
  s = s + "    m = m * 0.0625;\n";
  s = s + "    e = e + 4;\n";
  s = s + "  }\n";
  s = s + "  if (m >= 4.0) {\n";
  s = s + "    m = m * 0.25;\n";
  s = s + "    e = e + 2;\n";
  s = s + "  }\n";
  s = s + "  if (m >= 2.0) {\n";
  s = s + "    m = m * 0.5;\n";
  s = s + "    e = e + 1;\n";
  s = s + "  }\n";
  s = s + "  if (m < 5.421010862427522e-20) {\n";
  s = s + "    m = m * 18446744073709551616.0;\n";
  s = s + "    e = e - 64;\n";
  s = s + "  }\n";
  s = s + "  if (m < 2.3283064365386963e-10) {\n";
  s = s + "    m = m * 4294967296.0;\n";
  s = s + "    e = e - 32;\n";
  s = s + "  }\n";
  s = s + "  if (m < 0.0000152587890625) {\n";
  s = s + "    m = m * 65536.0;\n";
  s = s + "    e = e - 16;\n";
  s = s + "  }\n";
  s = s + "  if (m < 0.00390625) {\n";
  s = s + "    m = m * 256.0;\n";
  s = s + "    e = e - 8;\n";
  s = s + "  }\n";
  s = s + "  if (m < 0.0625) {\n";
  s = s + "    m = m * 16.0;\n";
  s = s + "    e = e - 4;\n";
  s = s + "  }\n";
  s = s + "  if (m < 0.25) {\n";
  s = s + "    m = m * 4.0;\n";
  s = s + "    e = e - 2;\n";
  s = s + "  }\n";
  s = s + "  if (m < 0.5) {\n";
  s = s + "    m = m * 2.0;\n";
  s = s + "    e = e - 1;\n";
  s = s + "  }\n";
  s = s + "  if (m < 1.0) {\n";
  s = s + "    m = m * 2.0;\n";
  s = s + "    e = e - 1;\n";
  s = s + "  }\n";
  s = s + "  if (m > 1.4142135) {\n";
  s = s + "    m = m * 0.5;\n";
  s = s + "    e = e + 1;\n";
  s = s + "  }\n";
  s = s + "  const f = m - 1.0;\n";
  s = s + "  const s = f / (2.0 + f);\n";
  s = s + "  const z = s * s;\n";
  s = s + "  const lf = 2.0 * s + s * (z * (0.6666666666666666 + z * (0.4 + z * (0.2857142857142857 + z * (0.2222222222222222\n";
  s = s + "    + z * 0.18181818181818182)))));\n";
  s = s + "  const ef = e as f32;\n";
  s = s + "  return ef * 0.693145751953125 + (ef * 1.428606765330187e-06 + lf);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// x^y = e^(y log x)。y = 0 か x = 1 なら 1。x = 0 は y > 0 で 0、y < 0 で無限大。\n";
  s = s + "// x < 0 は y が整数のときだけ（奇数なら負）、それ以外は NaN。\n";
  s = s + "kernel function fxsLibPow(x: f32, y: f32): f32 {\n";
  s = s + "  if (y == 0.0 || x == 1.0) {\n";
  s = s + "    return 1.0;\n";
  s = s + "  }\n";
  s = s + "  if (x != x || y != y) {\n";
  s = s + "    return x + y;\n";
  s = s + "  }\n";
  s = s + "  if (x == 0.0) {\n";
  s = s + "    if (y > 0.0) {\n";
  s = s + "      return 0.0;\n";
  s = s + "    }\n";
  s = s + "    return 1.0 / 0.0;\n";
  s = s + "  }\n";
  s = s + "  if (x < 0.0) {\n";
  s = s + "    if (Math.floor(y) != y) {\n";
  s = s + "      const z: f32 = 0.0;\n";
  s = s + "      return z / z;\n";
  s = s + "    }\n";
  s = s + "    const v = fxsLibExp(y * fxsLibLog(-x));\n";
  s = s + "    const h = y * 0.5;\n";
  s = s + "    if (Math.floor(h) != h) {\n";
  s = s + "      return -v;\n";
  s = s + "    }\n";
  s = s + "    return v;\n";
  s = s + "  }\n";
  s = s + "  return fxsLibExp(y * fxsLibLog(x));\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// atan(u)（|u| <= 0.4143）の級数。\n";
  s = s + "kernel function fxsLibAtanPoly(u: f32): f32 {\n";
  s = s + "  const z = u * u;\n";
  s = s + "  return u - u * z * (0.3333333333333333 - z * (0.2 - z * (0.14285714285714285 - z * (0.1111111111111111 - z * (0.09090909090909091\n";
  s = s + "    - z * (0.07692307692307693 - z * (0.06666666666666667 - z * (0.058823529411764705 - z * 0.05263157894736842))))))));\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// atan2(y, x)（-pi〜pi）。atan2(0, 0) = 0（符号つきの 0 は区別しない）。\n";
  s = s + "kernel function fxsLibAtan2(y: f32, x: f32): f32 {\n";
  s = s + "  if (x != x || y != y) {\n";
  s = s + "    return x + y;\n";
  s = s + "  }\n";
  s = s + "  const ax = Math.abs(x);\n";
  s = s + "  const ay = Math.abs(y);\n";
  s = s + "  const mx = Math.max(ax, ay);\n";
  s = s + "  const mn = Math.min(ax, ay);\n";
  s = s + "  if (mx == 0.0) {\n";
  s = s + "    return 0.0;\n";
  s = s + "  }\n";
  s = s + "  let a: f32 = 1.0;\n";
  s = s + "  if (mn - mn == 0.0) {\n";
  s = s + "    a = mn / mx;\n";
  s = s + "  }\n";
  s = s + "  let r: f32 = 0.0;\n";
  s = s + "  if (a > 0.41421356) {\n";
  s = s + "    r = 0.7853981633974483 + fxsLibAtanPoly((a - 1.0) / (a + 1.0));\n";
  s = s + "  } else {\n";
  s = s + "    r = fxsLibAtanPoly(a);\n";
  s = s + "  }\n";
  s = s + "  if (ay > ax) {\n";
  s = s + "    r = 1.5707963267948966 - r;\n";
  s = s + "  }\n";
  s = s + "  if (x < 0.0) {\n";
  s = s + "    r = 3.141592653589793 - r;\n";
  s = s + "  }\n";
  s = s + "  if (y < 0.0) {\n";
  s = s + "    r = -r;\n";
  s = s + "  }\n";
  s = s + "  return r;\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// x - floor(x)（0 <= 結果 <= 1。x がごく小さい負の数だと 1 になることがある）。\n";
  s = s + "kernel function fxsLibFract(x: f32): f32 {\n";
  s = s + "  return x - Math.floor(x);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// a * (1 - t) + b * t（t = 0 で a、t = 1 で b）。\n";
  s = s + "kernel function fxsLibMix(a: f32, b: f32, t: f32): f32 {\n";
  s = s + "  return a * (1.0 - t) + b * t;\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// x < edge なら 0、そうでなければ 1（x が NaN なら 1）。\n";
  s = s + "kernel function fxsLibStep(edge: f32, x: f32): f32 {\n";
  s = s + "  if (x < edge) {\n";
  s = s + "    return 0.0;\n";
  s = s + "  }\n";
  s = s + "  return 1.0;\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// t = clamp((x - e0) / (e1 - e0), 0, 1) として t * t * (3 - 2t)。e0 = e1 なら（NaN になるので）0。\n";
  s = s + "kernel function fxsLibSmoothstep(e0: f32, e1: f32, x: f32): f32 {\n";
  s = s + "  const t = Math.min(Math.max((x - e0) / (e1 - e0), 0.0), 1.0);\n";
  s = s + "  return t * t * (3.0 - 2.0 * t);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// Math.min(Math.max(x, lo), hi)。\n";
  s = s + "kernel function fxsLibClamp<T>(x: T, lo: T, hi: T): T {\n";
  s = s + "  return Math.min(Math.max(x, lo), hi);\n";
  s = s + "}\n";
  return s;
}
