// エフェクトスクリプトの IR（ir.um）から、WGSL（GPU）の文字列を作る。
//
// 出力は UM の gpu.loadKernel がそのまま読み込める形（UM の docs/wgpu.ja.md の「束縛の並び」）で、
// gpu.runKernel で実行する。意味は UM 本体の kernel と同じにする（ir.um の先頭の「意味の約束」）。
// 生成の工夫は UM 本体の src/wgsl.ts と同じ:
//   - 範囲外の添字は最後の要素に切り詰める（um_clamp。層の長さが 0 でも 1 要素ぶんあるとして 0 を返す）
//   - 整数の割り算は WGSL の / のまま（WGSL の決まりで x / 0 = x、最小値 / -1 = 最小値）。
//     余りは um_rem_*（x - (x / y) * y、y = 0 なら 0。NVIDIA の Vulkan で % が負の数を誤ることがあるため）
//   - シフト量は「右の値を u32 として見て & 31」
//   - f32 の割り算と平方根は、整数の演算で正しく丸める（um_fdiv* / um_fsqrt）
//   - f32 の MIN / MAX は「比較して選ぶ」（um_fmin / um_fmax。NaN なら右）、ABS は符号のビットを消す
// UM 本体の src/wgsl.ts より強めた所（NVIDIA の Vulkan で、UM 本体の WGSL の出力が CPU と合わなかったもの）:
//   - f32 の + - * は、左の値と結果を実行時にしか分からない 0（um_z）と OR する（um_fadd* / um_fsub* / um_fmul*）。
//     結果を隠すと FMA にまとめられず（UM の um_fmul と同じ）、左を隠すと (a + b) - a を b にするような
//     式の組み替えができない（UM 本体の WGSL では、smoothstep の (e1 - e0) が組み替えられて 1 ULP ずれた）
//   - f32 の定数も、ビットの形を um_z と OR して作る（ドライバに値を見せない。無限大・NaN も書ける）。
//     符号反転は符号のビットの XOR
//   - f32 の比較は、ビットの整数の演算で行う（um_flt など）。WGSL は実行時の NaN・無限大がないと仮定してよい決まりで、
//     実際に x != x が NaN で false になった
//   - f32 から整数への変換（um_f2i / um_f2u。飽和、NaN は 0）も、ビットの整数の演算で行う
//   - 整数から f32 への変換は、2^24 以上の値も最近接偶数に自分で丸める（um_u2f / um_i2f。GPU の命令の丸めに頼らない）
// さらに、WGSL の「定数式」の決まりに当たらないようにする: 定数どうしの整数の + - * / << と符号反転は、
// WGSL では生成の時に計算され、あふれ・ゼロ除算が「シェーダの誤り」になる（UM の意味では誤りではない）。
// そこで両側が定数のときは、左を select(x, x, um_t)（um_t は値の変わらない private の false）で包んで実行時の計算にする。
// f32 の定数の配列は、ビットの形（array<u32>）で持つ（WGSL の定数式では bitcast が使えないため）。
//
// 確かめた環境: Windows 11、NVIDIA GeForce RTX 5060 Ti、wgpu-native v29.0.1.1 の Vulkan（既定）。例のエフェクト 5 つが、
// NaN・無限大・-0 を混ぜた入力で、UM 本体でコンパイルした CPU の kernel とビットまで一致する（test_wgsl.um）。
// Direct3D 12（UM_WGPU_BACKEND=dx12。シェーダは FXC でコンパイルされる）では、途中に NaN・無限大・-0 が出る計算で
// 合わないことがある（ふつうの値の画素は一致する）。
//
// ■ 束縛の並び（いつも同じ。スクリプトが使わない入力も、並びは変えない）
//   @group(0) @binding(0)  var<storage, read> um_params: UmParams
//       UmParams = { count, row, len_out, len_src, len_src2, p_w, p_h, p_time, p_p: array<f32, 8> }
//   @group(0) @binding(1)  out   var<storage, read_write> array<vec4<f32>>（書く層。実行の前に入力の層を入れておく）
//   @group(0) @binding(2)  src   var<storage, read>       array<vec4<f32>>（入力の層の写し）
//   @group(0) @binding(3)  src2  var<storage, read>       array<vec4<f32>>（2 つ目の入力）
// ホストは次のように呼ぶ（UM の gpu.runKernel は、引数の型と順から UmParams を作る）:
//   gpu.runKernel(k, w * h, mut out, src, src2, w, h, time, p)
//   （out / src / src2: Buffer<vec4<f32>>、w / h: u32、time: f32、p: f32[8]）
// 2 つ目の入力を使わないスクリプト（ir.usesSrc2 が false）でも src2 に何か Buffer を渡す（src をもう一度渡してよい）。
// out と src は別の Buffer にする（同じ Buffer を read_write と read の両方に束縛できないため）。

import {
  FxsIr, FxsExpr, FxsStmt, FxsDiag, fxsDiagMake,
  fxsTyLanes, fxsTyElem, fxsTyIsVec,
  FXT_VOID, FXT_BOOL, FXT_I32, FXT_U32, FXT_F32,
  FXE_CONST, FXE_LOCAL, FXE_NEG, FXE_NOT, FXE_BITNOT, FXE_ADD, FXE_SUB, FXE_MUL, FXE_DIV, FXE_REM, FXE_SHL, FXE_SHR,
  FXE_AND, FXE_OR, FXE_XOR, FXE_LT, FXE_LE, FXE_GT, FXE_GE, FXE_EQ, FXE_NE, FXE_LAND, FXE_LOR, FXE_CAST, FXE_SELECT,
  FXE_VEC, FXE_SPLAT, FXE_COMP, FXE_LOAD, FXE_AREAD, FXE_CALL, FXE_SQRT, FXE_FLOOR, FXE_CEIL, FXE_ABS, FXE_MIN, FXE_MAX,
  FXE_POPCOUNT, FXE_CLZ, FXE_CTZ,
  FXS_ASSIGN, FXS_SETC, FXS_STORE, FXS_IF, FXS_LOOP, FXS_BREAK, FXS_CONTINUE, FXS_RETURN,
  FXS_ROLE_INDEX, FXS_ROLE_OUT, FXS_ROLE_SRC, FXS_ROLE_SRC2, FXS_ROLE_W, FXS_ROLE_H, FXS_ROLE_TIME,
} from "./ir.um";
import { fxsF32Bits, fxsHex32 } from "./num.um";

// 1 つのワークグループの実行の数（UM の src/wgsl.ts の WORKGROUP_SIZE と同じ）。
export const FXS_WGSL_WORKGROUP: i32 = 64;

// 出力の結果。ok が true のときだけ source を使う（ck.ok の IR なら、いつも true）。
export struct FxsWgsl {
  ok: bool;
  source: string;
  diags: FxsDiag[];
}

// 生成の途中の状態。
struct FxsWgState {
  lines: string[];       // いま書いている関数の行
  ind: i32;              // 字下げの深さ
  loops: i32;            // ループの入れ子の深さ（回数の変数の名前に使う）
  helperNames: string[]; // 使った補助の関数の名前（同じものを 2 度出さない）
  helperText: string[];  // その本文
}

// ---- 型 ----

function fxsWElemName(t: i32): string {
  if (t == FXT_BOOL) {
    return "bool";
  }
  if (t == FXT_I32) {
    return "i32";
  }
  if (t == FXT_U32) {
    return "u32";
  }
  return "f32";
}

// WGSL の型の名前。
export function fxsWTy(t: i32): string {
  if (fxsTyIsVec(t)) {
    return `vec${fxsTyLanes(t)}<` + fxsWElemName(fxsTyElem(t)) + ">";
  }
  return fxsWElemName(t);
}

// 補助の関数の名前に付ける型の印（f32 / v4f32 など）。
function fxsWTySfx(t: i32): string {
  if (fxsTyIsVec(t)) {
    return `v${fxsTyLanes(t)}` + fxsWElemName(fxsTyElem(t));
  }
  return fxsWElemName(t);
}

// 同じ成分の数で、成分を u32 にした型。
function fxsWU32Like(t: i32): string {
  if (fxsTyIsVec(t)) {
    return `vec${fxsTyLanes(t)}<u32>`;
  }
  return "u32";
}

// ---- 行と補助の関数 ----

function fxsWLine(st: mut FxsWgState, s: string): void {
  let pad = "";
  for (let k = 0; k < st.ind; k++) {
    pad = pad + "  ";
  }
  st.lines.push(pad + s);
}

function fxsWHas(st: FxsWgState, name: string): bool {
  for (let k: usize = 0; k < st.helperNames.length; k++) {
    if (st.helperNames[k] == name) {
      return true;
    }
  }
  return false;
}

// 補助の関数を使ったことにする（初めてなら本文を足す）。
function fxsWUse(st: mut FxsWgState, name: string, text: string): void {
  if (fxsWHas(st, name)) {
    return;
  }
  st.helperNames.push(name.clone());
  st.helperText.push(text.clone());
}

function fxsWUseFdiv(st: mut FxsWgState): void {
  fxsWUse(mut st, "um_fdiv", fxsWFdivText());
}

// ---- 定数 ----

function fxsWConstText(e: FxsExpr): string {
  if (e.ty == FXT_F32) {
    // f32 の定数は、ビットの形を実行時の 0 と OR して作る（値は正確）。ドライバに値を見せないため
    // （0 や 1 との演算を省く最適化をさせない）と、無限大・NaN が WGSL の定数式で誤りになるのを避けるため。
    return "bitcast<f32>(" + fxsHex32(fxsF32Bits(e.fv)) + "u | um_z)";
  }
  if (e.ty == FXT_U32) {
    return `${(e.iv as u32)}u`;
  }
  if (e.ty == FXT_BOOL) {
    if (e.iv != 0) {
      return "true";
    }
    return "false";
  }
  if (e.iv == -2147483647 - 1) {
    return "(-2147483647i - 1i)";
  }
  if (e.iv < 0) {
    return `(${e.iv}i)`;
  }
  return `${e.iv}i`;
}

// 出力した式が WGSL の定数式になるか（ir.um の式 k について、この出力の書き方で）。
function fxsWIsConst(ir: FxsIr, k: i32): bool {
  if (k < 0) {
    return true;
  }
  const e = ir.exprs[k as usize];
  const op = e.op;
  if (op == FXE_CONST) {
    return e.ty != FXT_F32;
  }
  if (op == FXE_LOCAL || op == FXE_LOAD || op == FXE_CALL || op == FXE_SQRT || op == FXE_REM) {
    return false;
  }
  if (op == FXE_AREAD) {
    if (ir.arrays[e.iv as usize].param || e.ty == FXT_F32) {
      return false;
    }
    return fxsWIsConst(ir, e.a);
  }
  const el = fxsTyElem(e.ty);
  // 包んで実行時の計算にするもの（両側が定数でも定数式にならない）と、関数を通すもの。
  if (op == FXE_ADD || op == FXE_SUB || op == FXE_MUL || op == FXE_DIV || op == FXE_SHL) {
    return false;
  }
  if (op == FXE_NEG) {
    return el == FXT_F32 && fxsWIsConst(ir, e.a);
  }
  if ((op == FXE_MIN || op == FXE_MAX) && el == FXT_F32) {
    return false;
  }
  if (op >= FXE_LT && op <= FXE_NE && fxsTyElem(ir.exprs[e.a as usize].ty) == FXT_F32) {
    return false;
  }
  if (op == FXE_CAST) {
    const from = fxsTyElem(ir.exprs[e.a as usize].ty);
    if (from == FXT_F32 || el == FXT_F32) {
      return false;
    }
    return fxsWIsConst(ir, e.a);
  }
  if (op == FXE_VEC) {
    for (let j = 0; j < e.b; j++) {
      if (!fxsWIsConst(ir, ir.lists[(e.a + j) as usize])) {
        return false;
      }
    }
    return true;
  }
  return fxsWIsConst(ir, e.a) && fxsWIsConst(ir, e.b) && fxsWIsConst(ir, e.c);
}

// 定数式を、値を変えずに実行時の計算にする。
function fxsWOpaque(s: string): string {
  return "select(" + s + ", " + s + ", um_t)";
}

// ---- 式 ----

// 1 つの値（数）の型の変換。x は from の型の式。
function fxsWConvScalar(st: mut FxsWgState, from: i32, to: i32, x: string): string {
  if (from == FXT_F32 && to == FXT_I32) {
    return "um_f2i(" + x + ")";
  }
  if (from == FXT_F32 && to == FXT_U32) {
    return "um_f2u(" + x + ")";
  }
  if (from == FXT_U32 && to == FXT_F32) {
    fxsWUse(mut st, "um_u2f", fxsWU2fText());
    return "um_u2f(" + x + ")";
  }
  if (from == FXT_I32 && to == FXT_F32) {
    fxsWUse(mut st, "um_u2f", fxsWU2fText());
    fxsWUse(mut st, "um_i2f", fxsWI2fText());
    return "um_i2f(" + x + ")";
  }
  if (from == FXT_BOOL) {
    if (to == FXT_I32) {
      return "select(0i, 1i, " + x + ")";
    }
    if (to == FXT_U32) {
      return "select(0u, 1u, " + x + ")";
    }
    return "select(0.0f, 1.0f, " + x + ")";
  }
  // i32 と u32 はビットのまま読み替える。
  return "bitcast<" + fxsWElemName(to) + ">(" + x + ")";
}

function fxsWCast(st: mut FxsWgState, fromTy: i32, toTy: i32, x: string): string {
  const from = fxsTyElem(fromTy);
  const to = fxsTyElem(toTy);
  if (!fxsTyIsVec(toTy)) {
    return fxsWConvScalar(mut st, from, to, x);
  }
  if ((from == FXT_I32 && to == FXT_U32) || (from == FXT_U32 && to == FXT_I32)) {
    return "bitcast<" + fxsWTy(toTy) + ">(" + x + ")";
  }
  // ベクトルは成分ごとに変換する関数を作る（式を何度も書かないように）。
  const name = "um_cv_" + fxsWTySfx(fromTy) + "_" + fxsWTySfx(toTy);
  if (!fxsWHas(st, name)) {
    const n = fxsTyLanes(toTy);
    let parts = "";
    for (let j = 0; j < n; j++) {
      if (j > 0) {
        parts = parts + ", ";
      }
      parts = parts + fxsWConvScalar(mut st, from, to, "v." + fxsWCompName(j));
    }
    fxsWUse(mut st, name, "fn " + name + "(v: " + fxsWTy(fromTy) + ") -> " + fxsWTy(toTy) + " {\n  return " + fxsWTy(toTy) + "(" + parts + ");\n}\n");
  }
  return name + "(" + x + ")";
}

function fxsWCompName(j: i32): string {
  if (j == 0) {
    return "x";
  }
  if (j == 1) {
    return "y";
  }
  if (j == 2) {
    return "z";
  }
  return "w";
}

function fxsWBinOp(op: i32): string {
  if (op == FXE_ADD) { return "+"; }
  if (op == FXE_SUB) { return "-"; }
  if (op == FXE_MUL) { return "*"; }
  if (op == FXE_DIV) { return "/"; }
  if (op == FXE_AND) { return "&"; }
  if (op == FXE_OR) { return "|"; }
  if (op == FXE_XOR) { return "^"; }
  if (op == FXE_LT) { return "<"; }
  if (op == FXE_LE) { return "<="; }
  if (op == FXE_GT) { return ">"; }
  if (op == FXE_GE) { return ">="; }
  if (op == FXE_EQ) { return "=="; }
  if (op == FXE_NE) { return "!="; }
  if (op == FXE_LAND) { return "&&"; }
  if (op == FXE_LOR) { return "||"; }
  if (op == FXE_SHL) { return "<<"; }
  return ">>";
}

function fxsWLayer(role: i32): string {
  if (role == FXS_ROLE_SRC) {
    return "src";
  }
  if (role == FXS_ROLE_SRC2) {
    return "src2";
  }
  return "out";
}

// f32 の掛け算・割り算（ベクトルは成分ごと）。
function fxsWFloatMulDiv(st: mut FxsWgState, ty: i32, div: bool, a: string, b: string): string {
  const n = fxsTyLanes(ty);
  if (div) {
    fxsWUseFdiv(mut st);
    if (n == 1) {
      return "um_fdiv(" + a + ", " + b + ")";
    }
    const name = `um_fdiv${n}`;
    if (!fxsWHas(st, name)) {
      let parts = "";
      for (let j = 0; j < n; j++) {
        if (j > 0) {
          parts = parts + ", ";
        }
        const c = fxsWCompName(j);
        parts = parts + "um_fdiv(a." + c + ", b." + c + ")";
      }
      const t = fxsWTy(ty);
      fxsWUse(mut st, name, "fn " + name + "(a: " + t + ", b: " + t + ") -> " + t + " {\n  return " + t + "(" + parts + ");\n}\n");
    }
    return name + "(" + a + ", " + b + ")";
  }
  return fxsWFloatArith(mut st, ty, "mul", "*", a, b);
}

// f32 の + - *（ベクトルは成分ごと）。左の値と結果を、実行時の 0（um_z）と OR して、ドライバから隠す:
//   - 結果を隠すと、掛け算と足し算を 1 つの命令（FMA）にまとめられない（UM の um_fmul と同じ）
//   - 左の値を隠すと、(a + b) - a を b にするような式の組み替えができない（NVIDIA の Vulkan で実際に起きた。
//     IEEE の丸めでは (a + b) - a と b は違う値になりうる）
// 値は変わらない（um_z は 0）。
function fxsWFloatArith(st: mut FxsWgState, ty: i32, opName: string, sym: string, a: string, b: string): string {
  let name = "um_f" + opName;
  if (fxsTyIsVec(ty)) {
    name = name + `${fxsTyLanes(ty)}`;
  }
  if (!fxsWHas(st, name)) {
    const t = fxsWTy(ty);
    const u = fxsWU32Like(ty);
    let z = "um_z";
    if (fxsTyIsVec(ty)) {
      z = u + "(um_z)";
    }
    let text = "";
    if (opName == "add") {
      text = "// f32 の + - *。左の値と結果を実行時の 0 と OR する（値は同じ）。ドライバが FMA にまとめたり、式を組み替えたりできなくなる。\n";
    }
    text = text + "fn " + name + "(a: " + t + ", b: " + t + ") -> " + t + " {\n"
      + "  return bitcast<" + t + ">(bitcast<" + u + ">(bitcast<" + t + ">(bitcast<" + u + ">(a) | " + z + ") " + sym + " b) | " + z + ");\n}\n";
    fxsWUse(mut st, name, text);
  }
  return name + "(" + a + ", " + b + ")";
}

// f32 の比較（IEEE。NaN は NE だけ真、-0 と +0 は等しい）。WGSL は実行時の NaN と無限大がないと仮定してよい決まりで、
// 実際に NVIDIA の Vulkan では x != x が NaN で false になったので、比較はビットの整数の演算で行う（um_fcmp.um_flt など）。
function fxsWFcmp(st: mut FxsWgState, op: i32, a: string, b: string): string {
  fxsWUse(mut st, "um_fcmp", fxsWFcmpText());
  let name = "um_feq";
  if (op == FXE_LT) {
    name = "um_flt";
  } else if (op == FXE_LE) {
    name = "um_fle";
  } else if (op == FXE_GT) {
    name = "um_fgt";
  } else if (op == FXE_GE) {
    name = "um_fge";
  } else if (op == FXE_NE) {
    name = "um_fne";
  }
  return name + "(" + a + ", " + b + ")";
}

function fxsWExpr(ir: FxsIr, k: i32, st: mut FxsWgState): string {
  const e = ir.exprs[k as usize];
  const op = e.op;
  const ty = e.ty;
  const el = fxsTyElem(ty);
  if (op == FXE_CONST) {
    return fxsWConstText(e);
  }
  if (op == FXE_LOCAL) {
    return `l${e.iv}`;
  }
  if (op == FXE_NEG) {
    let a = fxsWExpr(ir, e.a, mut st);
    if (el == FXT_F32) {
      // f32 の符号反転は、符号のビットを反転する（正確。-(a - b) を b - a にするような組み替えもさせない）。
      const u = fxsWU32Like(ty);
      return "bitcast<" + fxsWTy(ty) + ">(bitcast<" + u + ">(" + a + ") ^ " + u + "(0x80000000u))";
    }
    if (fxsWIsConst(ir, e.a)) {
      a = fxsWOpaque(a);
    }
    if (el == FXT_U32) {
      // WGSL には符号なしの整数の符号反転がないので、0 から引く（ラップする）。
      return "(" + fxsWTy(ty) + "() - " + a + ")";
    }
    return "(-" + a + ")";
  }
  if (op == FXE_NOT) {
    return "(!" + fxsWExpr(ir, e.a, mut st) + ")";
  }
  if (op == FXE_BITNOT) {
    return "(~" + fxsWExpr(ir, e.a, mut st) + ")";
  }
  if (op == FXE_ADD || op == FXE_SUB || op == FXE_MUL || op == FXE_DIV || op == FXE_REM || op == FXE_SHL || op == FXE_SHR) {
    let a = fxsWExpr(ir, e.a, mut st);
    const b = fxsWExpr(ir, e.b, mut st);
    if (op != FXE_REM && op != FXE_SHR && fxsWIsConst(ir, e.a) && fxsWIsConst(ir, e.b)) {
      a = fxsWOpaque(a);
    }
    if (op == FXE_SHL || op == FXE_SHR) {
      // シフト量は「右の値を u32 として見て & 31」。左がベクトルで右が数なら、右を並べる。
      const rt = ir.exprs[e.b as usize].ty;
      let amt = b.clone();
      if (fxsTyElem(rt) == FXT_I32) {
        amt = "bitcast<" + fxsWU32Like(rt) + ">(" + amt + ")";
      }
      const u = fxsWU32Like(ty);
      if (fxsTyIsVec(ty) && !fxsTyIsVec(rt)) {
        amt = u + "(" + amt + ")";
      }
      if (fxsTyIsVec(ty)) {
        amt = "(" + amt + " & " + u + "(31u))";
      } else {
        amt = "(" + amt + " & 31u)";
      }
      return "(" + a + " " + fxsWBinOp(op) + " " + amt + ")";
    }
    if (el == FXT_F32 && (op == FXE_MUL || op == FXE_DIV)) {
      return fxsWFloatMulDiv(mut st, ty, op == FXE_DIV, a, b);
    }
    if (el == FXT_F32 && op == FXE_ADD) {
      return fxsWFloatArith(mut st, ty, "add", "+", a, b);
    }
    if (el == FXT_F32 && op == FXE_SUB) {
      return fxsWFloatArith(mut st, ty, "sub", "-", a, b);
    }
    if (op == FXE_REM) {
      const name = "um_rem_" + fxsWTySfx(ty);
      const t = fxsWTy(ty);
      fxsWUse(mut st, name, "fn " + name + "(x: " + t + ", y: " + t + ") -> " + t + " {\n  return select(x - (x / y) * y, " + t + "(), y == " + t + "());\n}\n");
      return name + "(" + a + ", " + b + ")";
    }
    return "(" + a + " " + fxsWBinOp(op) + " " + b + ")";
  }
  if (op == FXE_AND || op == FXE_OR || op == FXE_XOR || op == FXE_LT || op == FXE_LE || op == FXE_GT || op == FXE_GE
    || op == FXE_EQ || op == FXE_NE || op == FXE_LAND || op == FXE_LOR) {
    const a = fxsWExpr(ir, e.a, mut st);
    const b = fxsWExpr(ir, e.b, mut st);
    if (op >= FXE_LT && op <= FXE_NE && fxsTyElem(ir.exprs[e.a as usize].ty) == FXT_F32) {
      return fxsWFcmp(mut st, op, a, b);
    }
    return "(" + a + " " + fxsWBinOp(op) + " " + b + ")";
  }
  if (op == FXE_CAST) {
    const a = fxsWExpr(ir, e.a, mut st);
    return fxsWCast(mut st, ir.exprs[e.a as usize].ty, ty, a);
  }
  if (op == FXE_SELECT) {
    const c = fxsWExpr(ir, e.a, mut st);
    const t = fxsWExpr(ir, e.b, mut st);
    const f = fxsWExpr(ir, e.c, mut st);
    return "select(" + f + ", " + t + ", " + c + ")";
  }
  if (op == FXE_VEC) {
    let s = fxsWTy(ty) + "(";
    for (let j = 0; j < e.b; j++) {
      if (j > 0) {
        s = s + ", ";
      }
      s = s + fxsWExpr(ir, ir.lists[(e.a + j) as usize], mut st);
    }
    return s + ")";
  }
  if (op == FXE_SPLAT) {
    return fxsWTy(ty) + "(" + fxsWExpr(ir, e.a, mut st) + ")";
  }
  if (op == FXE_COMP) {
    return fxsWExpr(ir, e.a, mut st) + "." + fxsWCompName(e.iv);
  }
  if (op == FXE_LOAD) {
    const name = fxsWLayer(e.iv);
    return "b_" + name + "[um_clamp(" + fxsWExpr(ir, e.a, mut st) + ", um_params.len_" + name + ")]";
  }
  if (op == FXE_AREAD) {
    const aParam = ir.arrays[e.iv as usize].param;
    const aLen = ir.arrays[e.iv as usize].len;
    let base = `k${e.iv}`;
    if (aParam) {
      base = "um_params.p_p";
    }
    const ie = ir.exprs[e.a as usize];
    let at = "";
    if (ie.op == FXE_CONST && (ie.iv as u32) < (aLen as u32)) {
      at = base + `[${(ie.iv as u32)}u]`;
    } else {
      at = base + "[min(" + fxsWExpr(ir, e.a, mut st) + `, ${aLen - 1}u)]`;
    }
    if (!aParam && ty == FXT_F32) {
      return "bitcast<f32>(" + at + " | um_z)";
    }
    return at;
  }
  if (op == FXE_CALL) {
    let s = `fx${e.iv}(`;
    for (let j = 0; j < e.b; j++) {
      if (j > 0) {
        s = s + ", ";
      }
      s = s + fxsWExpr(ir, ir.lists[(e.a + j) as usize], mut st);
    }
    return s + ")";
  }
  if (op == FXE_SQRT) {
    fxsWUse(mut st, "um_fsqrt", fxsWFsqrtText());
    return "um_fsqrt(" + fxsWExpr(ir, e.a, mut st) + ")";
  }
  if (op == FXE_FLOOR) {
    return "floor(" + fxsWExpr(ir, e.a, mut st) + ")";
  }
  if (op == FXE_CEIL) {
    return "ceil(" + fxsWExpr(ir, e.a, mut st) + ")";
  }
  if (op == FXE_ABS) {
    const a = fxsWExpr(ir, e.a, mut st);
    if (el == FXT_F32) {
      return "bitcast<" + fxsWTy(ty) + ">(bitcast<" + fxsWU32Like(ty) + ">(" + a + ") & " + fxsWU32Like(ty) + "(0x7fffffffu))";
    }
    if (el == FXT_U32) {
      return a;
    }
    // i32 の最小値の abs は最小値（WGSL の決まりも同じ）。
    return "abs(" + a + ")";
  }
  if (op == FXE_MIN || op == FXE_MAX) {
    const a = fxsWExpr(ir, e.a, mut st);
    const b = fxsWExpr(ir, e.b, mut st);
    if (el == FXT_F32) {
      if (op == FXE_MIN) {
        fxsWUse(mut st, "um_fcmp", fxsWFcmpText());
        fxsWUse(mut st, "um_fmin", fxsWFminText());
        return "um_fmin(" + a + ", " + b + ")";
      }
      fxsWUse(mut st, "um_fcmp", fxsWFcmpText());
      fxsWUse(mut st, "um_fmax", fxsWFmaxText());
      return "um_fmax(" + a + ", " + b + ")";
    }
    if (op == FXE_MIN) {
      return "min(" + a + ", " + b + ")";
    }
    return "max(" + a + ", " + b + ")";
  }
  if (op == FXE_POPCOUNT) {
    return "countOneBits(" + fxsWExpr(ir, e.a, mut st) + ")";
  }
  if (op == FXE_CLZ) {
    return "countLeadingZeros(" + fxsWExpr(ir, e.a, mut st) + ")";
  }
  if (op == FXE_CTZ) {
    return "countTrailingZeros(" + fxsWExpr(ir, e.a, mut st) + ")";
  }
  return `/* ? op ${op} */ 0`;
}

// ---- 文 ----

function fxsWBlock(ir: FxsIr, start: i32, count: i32, st: mut FxsWgState): void {
  for (let j = 0; j < count; j++) {
    fxsWStmt(ir, ir.lists[(start + j) as usize], mut st);
  }
}

function fxsWStmt(ir: FxsIr, k: i32, st: mut FxsWgState): void {
  const s = ir.stmts[k as usize];
  if (s.op == FXS_ASSIGN) {
    const v = fxsWExpr(ir, s.a, mut st);
    fxsWLine(mut st, `l${s.iv} = ` + v + ";");
  } else if (s.op == FXS_SETC) {
    const v = fxsWExpr(ir, s.a, mut st);
    fxsWLine(mut st, `l${s.iv}.` + fxsWCompName(s.b) + " = " + v + ";");
  } else if (s.op == FXS_STORE) {
    const name = fxsWLayer(s.iv);
    const idx = fxsWExpr(ir, s.b, mut st);
    const v = fxsWExpr(ir, s.a, mut st);
    fxsWLine(mut st, "b_" + name + "[um_clamp(" + idx + ", um_params.len_" + name + ")] = " + v + ";");
  } else if (s.op == FXS_IF) {
    const c = fxsWExpr(ir, s.a, mut st);
    fxsWLine(mut st, "if (" + c + ") {");
    st.ind++;
    fxsWBlock(ir, s.b, s.c, mut st);
    st.ind--;
    if (s.e > 0) {
      fxsWLine(mut st, "} else {");
      st.ind++;
      fxsWBlock(ir, s.d, s.e, mut st);
      st.ind--;
    }
    fxsWLine(mut st, "}");
  } else if (s.op == FXS_LOOP) {
    // 回数の上限つきのループ（ir.um の LOOP）。「次へ」と回数を増やすのは continuing に置く（continue でも実行される）。
    const n = `um_n${st.loops}`;
    st.loops++;
    fxsWLine(mut st, "{");
    st.ind++;
    fxsWLine(mut st, "var " + n + ": u32 = 0u;");
    fxsWLine(mut st, "loop {");
    st.ind++;
    fxsWLine(mut st, "if (" + n + ` >= ${(s.iv as u32)}u) {`);
    fxsWLine(mut st, "  break;");
    fxsWLine(mut st, "}");
    if (s.a >= 0) {
      const c = fxsWExpr(ir, s.a, mut st);
      fxsWLine(mut st, "if (!" + c + ") {");
      fxsWLine(mut st, "  break;");
      fxsWLine(mut st, "}");
    }
    fxsWBlock(ir, s.b, s.c, mut st);
    fxsWLine(mut st, "continuing {");
    st.ind++;
    fxsWBlock(ir, s.d, s.e, mut st);
    fxsWLine(mut st, n + " = " + n + " + 1u;");
    st.ind--;
    fxsWLine(mut st, "}");
    st.ind--;
    fxsWLine(mut st, "}");
    st.ind--;
    fxsWLine(mut st, "}");
    st.loops--;
  } else if (s.op == FXS_BREAK) {
    fxsWLine(mut st, "break;");
  } else if (s.op == FXS_CONTINUE) {
    fxsWLine(mut st, "continue;");
  } else if (s.op == FXS_RETURN) {
    if (s.a >= 0) {
      const v = fxsWExpr(ir, s.a, mut st);
      fxsWLine(mut st, "return " + v + ";");
    } else {
      fxsWLine(mut st, "return;");
    }
  }
}

// ---- 関数 ----

function fxsWFn(ir: FxsIr, f: i32, st: mut FxsWgState): string {
  st.lines = [];
  st.ind = 1;
  st.loops = 0;
  let head = `// ${ir.fns[f as usize].name}\nfn fx${f}(`;
  if (ir.fns[f as usize].entry) {
    head = head + "um_i: u32";
  } else {
    for (let j = 0; j < ir.fns[f as usize].nparams; j++) {
      if (j > 0) {
        head = head + ", ";
      }
      head = head + `a${j}: ` + fxsWTy(ir.locals[(ir.fns[f as usize].localStart + j) as usize].ty);
    }
  }
  head = head + ")";
  if (ir.fns[f as usize].ret != FXT_VOID) {
    head = head + " -> " + fxsWTy(ir.fns[f as usize].ret);
  }
  head = head + " {\n";
  // 局所変数は関数の入口ですべて 0 にする（引数は写しにする。書き換えてよいので var）。
  for (let j = 0; j < ir.fns[f as usize].localCount; j++) {
    const li = (ir.fns[f as usize].localStart + j) as usize;
    const locTy = ir.locals[li].ty;
    const locRole = ir.locals[li].role;
    const t = fxsWTy(locTy);
    if (j < ir.fns[f as usize].nparams) {
      if (ir.fns[f as usize].entry) {
        let v = "um_i";
        if (locRole == FXS_ROLE_W) {
          v = "um_params.p_w";
        } else if (locRole == FXS_ROLE_H) {
          v = "um_params.p_h";
        } else if (locRole == FXS_ROLE_TIME) {
          v = "um_params.p_time";
        } else if (locRole != FXS_ROLE_INDEX) {
          v = t + "()";
        }
        fxsWLine(mut st, `var l${j}: ` + t + " = " + v + ";");
      } else {
        fxsWLine(mut st, `var l${j}: ` + t + ` = a${j};`);
      }
    } else {
      fxsWLine(mut st, `var l${j}: ` + t + ";");
    }
  }
  fxsWBlock(ir, ir.fns[f as usize].body, ir.fns[f as usize].bodyCount, mut st);
  if (ir.fns[f as usize].ret != FXT_VOID) {
    // 最後まで来ることはない（UM の型検査が最後の return を求める）が、WGSL のために置く。
    fxsWLine(mut st, "return " + fxsWTy(ir.fns[f as usize].ret) + "();");
  }
  let s = head;
  for (let j: usize = 0; j < st.lines.length; j++) {
    s = s + st.lines[j] + "\n";
  }
  return s + "}\n";
}

// 最上位の定数の配列を、モジュールの範囲の const にする。f32 の配列は、ビットの形（u32）で持ち、読むときに
// bitcast する（値を正確に書くため。WGSL の定数式では bitcast が使えず、無限大・NaN も書けない）。
function fxsWConstArray(ir: FxsIr, a: i32): string {
  const elem = ir.arrays[a as usize].elem;
  let held = elem;
  if (elem == FXT_F32) {
    held = FXT_U32;
  }
  const t = "array<" + fxsWElemName(held) + `, ${ir.arrays[a as usize].len}>`;
  let s = `// ${ir.arrays[a as usize].name}\nconst k${a}: ` + t + " = " + t + "(";
  for (let j = 0; j < ir.arrays[a as usize].len; j++) {
    if (j > 0) {
      s = s + ", ";
    }
    const at = (ir.arrays[a as usize].start + j) as usize;
    if (elem == FXT_F32) {
      s = s + fxsHex32(fxsF32Bits(ir.arrF[at])) + "u";
    } else {
      let e: FxsExpr = { op: FXE_CONST, ty: elem, a: -1, b: -1, c: -1, iv: ir.arrI[at], fv: 0.0, line: 0, col: 0 };
      s = s + fxsWConstText(e);
    }
  }
  return s + ");\n";
}

// IR から WGSL を作る。ir は fxsCompile の結果で ck.ok が true のもの。
export function fxsWgsl(ir: FxsIr, effectName: string): FxsWgsl {
  let diags: FxsDiag[] = [];
  if (ir.entry < 0 || (ir.entry as usize) >= ir.fns.length) {
    diags.push(fxsDiagMake("fx-entry", 0, 0, "入口の kernel がないので、GPU の版を作れません。",
      "層に書く kernel（mut Buffer<vec4<f32>> を引数に持つもの）を 1 つ書いてください。"));
    return { ok: false, source: "", diags };
  }
  let st: FxsWgState = { lines: [], ind: 1, loops: 0, helperNames: [], helperText: [] };
  let fnText = "";
  for (let f = 0; f < ir.fns.length; f++) {
    fnText = fnText + fxsWFn(ir, f as i32, mut st) + "\n";
  }
  let arrText = "";
  for (let a = 0; a < ir.arrays.length; a++) {
    if (!ir.arrays[a].param) {
      arrText = arrText + fxsWConstArray(ir, a as i32);
    }
  }
  let helpers = "";
  for (let j: usize = 0; j < st.helperText.length; j++) {
    helpers = helpers + st.helperText[j] + "\n";
  }
  const entryName = ir.fns[ir.entry as usize].name.clone();
  let s = "// MozaicCut のエフェクトスクリプトの kernel '" + entryName + "' から生成した WGSL（src/fxs/wgsl.um）。手で編集しない。\n"
    + "// 呼び方: gpu.runKernel(k, w * h, mut out, src, src2, w, h, time, p)\n\n"
    + fxsWHeadText() + "\n" + helpers + arrText;
  if (arrText != "") {
    s = s + "\n";
  }
  s = s + fnText
    + `@compute @workgroup_size(${FXS_WGSL_WORKGROUP})\n`
    + "fn um_main(@builtin(global_invocation_id) gid: vec3<u32>) {\n"
    + "  let um_i: u32 = gid.y * um_params.row + gid.x;\n"
    + "  if (um_i >= um_params.count) {\n"
    + "    return;\n"
    + "  }\n"
    + "  um_z = um_params.row >> 30u;\n"
    + `  fx${ir.entry}(um_i);\n`
    + "}\n";
  return { ok: true, source: s, diags };
}

// ---- 決まった部分の WGSL ----

function fxsWHeadText(): string {
  let s = "";
  s = s + "struct UmParams {\n";
  s = s + "  count: u32,\n";
  s = s + "  row: u32,\n";
  s = s + "  len_out: u32,\n";
  s = s + "  len_src: u32,\n";
  s = s + "  len_src2: u32,\n";
  s = s + "  p_w: u32,\n";
  s = s + "  p_h: u32,\n";
  s = s + "  p_time: f32,\n";
  s = s + "  p_p: array<f32, 8>,\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "@group(0) @binding(0) var<storage, read> um_params: UmParams;\n";
  s = s + "@group(0) @binding(1) var<storage, read_write> b_out: array<vec4<f32>>;\n";
  s = s + "@group(0) @binding(2) var<storage, read> b_src: array<vec4<f32>>;\n";
  s = s + "@group(0) @binding(3) var<storage, read> b_src2: array<vec4<f32>>;\n";
  s = s + "\n";
  s = s + "// 実行時にしか分からない 0（um_main が um_params.row >> 30 を入れる。row は 2^30 未満）。\n";
  s = s + "var<private> um_z: u32;\n";
  s = s + "// 値の変わらない false。定数式を実行時の計算にするために使う（select(x, x, um_t)）。\n";
  s = s + "var<private> um_t: bool;\n";
  s = s + "\n";
  s = s + "// 範囲外の添字を最後の要素に切り詰める。長さ 0 の Buffer は 1 要素ぶん確保されているので 0 を返す。\n";
  s = s + "fn um_clamp(i: u32, len: u32) -> u32 {\n";
  s = s + "  return min(i, max(len, 1u) - 1u);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// f32 から整数へ。0 の方へ切り捨て、範囲外は端の値に飽和し、NaN は 0。\n";
  s = s + "// 浮動小数点の比較と変換の命令を使わず、ビットの整数の演算で行う（NaN・無限大も決まった値にするため）。\n";
  s = s + "fn um_f2i(v: f32) -> i32 {\n";
  s = s + "  let b: u32 = bitcast<u32>(v);\n";
  s = s + "  let e: u32 = (b >> 23u) & 0xffu;\n";
  s = s + "  let neg: bool = (b >> 31u) != 0u;\n";
  s = s + "  if (e == 255u && (b & 0x7fffffu) != 0u) {\n";
  s = s + "    return 0i;\n";
  s = s + "  }\n";
  s = s + "  if (e < 127u) {\n";
  s = s + "    return 0i;\n";
  s = s + "  }\n";
  s = s + "  if (e >= 158u) {\n";
  s = s + "    return select(2147483647i, -2147483647i - 1i, neg);\n";
  s = s + "  }\n";
  s = s + "  let m: u32 = (b & 0x7fffffu) | 0x800000u;\n";
  s = s + "  let mag: u32 = select(m >> (150u - e), m << (e - 150u), e >= 150u);\n";
  s = s + "  return select(bitcast<i32>(mag), bitcast<i32>(0u - mag), neg);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "fn um_f2u(v: f32) -> u32 {\n";
  s = s + "  let b: u32 = bitcast<u32>(v);\n";
  s = s + "  let e: u32 = (b >> 23u) & 0xffu;\n";
  s = s + "  if ((e == 255u && (b & 0x7fffffu) != 0u) || (b >> 31u) != 0u || e < 127u) {\n";
  s = s + "    return 0u;\n";
  s = s + "  }\n";
  s = s + "  if (e >= 159u) {\n";
  s = s + "    return 4294967295u;\n";
  s = s + "  }\n";
  s = s + "  let m: u32 = (b & 0x7fffffu) | 0x800000u;\n";
  s = s + "  return select(m >> (150u - e), m << (e - 150u), e >= 150u);\n";
  s = s + "}\n";
  return s;
}

function fxsWFcmpText(): string {
  let s = "";
  s = s + "// f32 の比較を、ビットの整数の演算で行う（IEEE と同じ結果。NaN は NE だけ真、-0 と +0 は等しい）。\n";
  s = s + "// WGSL は実行時の NaN・無限大がないと仮定してよく、ドライバの浮動小数点の比較は NaN で IEEE と違うことがあるため。\n";
  s = s + "fn um_fnan(a: f32) -> bool {\n";
  s = s + "  return (bitcast<u32>(a) & 0x7fffffffu) > 0x7f800000u;\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// 大小の順に並ぶ u32 の鍵（-0 は +0 にそろえる）。\n";
  s = s + "fn um_fkey(a: f32) -> u32 {\n";
  s = s + "  let b: u32 = bitcast<u32>(a);\n";
  s = s + "  let m: u32 = select(b, 0u, (b & 0x7fffffffu) == 0u);\n";
  s = s + "  return select(m | 0x80000000u, ~m, (m & 0x80000000u) != 0u);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "fn um_flt(a: f32, b: f32) -> bool {\n";
  s = s + "  return !um_fnan(a) && !um_fnan(b) && um_fkey(a) < um_fkey(b);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "fn um_fle(a: f32, b: f32) -> bool {\n";
  s = s + "  return !um_fnan(a) && !um_fnan(b) && um_fkey(a) <= um_fkey(b);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "fn um_fgt(a: f32, b: f32) -> bool {\n";
  s = s + "  return !um_fnan(a) && !um_fnan(b) && um_fkey(a) > um_fkey(b);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "fn um_fge(a: f32, b: f32) -> bool {\n";
  s = s + "  return !um_fnan(a) && !um_fnan(b) && um_fkey(a) >= um_fkey(b);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "fn um_feq(a: f32, b: f32) -> bool {\n";
  s = s + "  return !um_fnan(a) && !um_fnan(b) && um_fkey(a) == um_fkey(b);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "fn um_fne(a: f32, b: f32) -> bool {\n";
  s = s + "  return !um_feq(a, b);\n";
  s = s + "}\n";
  return s;
}

function fxsWFminText(): string {
  let s = "";
  s = s + "// f32 の最小・最大は「比較して選ぶ」（どちらかが NaN なら右）。\n";
  s = s + "fn um_fmin(a: f32, b: f32) -> f32 {\n";
  s = s + "  return select(b, a, um_flt(a, b));\n";
  s = s + "}\n";
  return s;
}

function fxsWFmaxText(): string {
  let s = "";
  s = s + "fn um_fmax(a: f32, b: f32) -> f32 {\n";
  s = s + "  return select(b, a, um_fgt(a, b));\n";
  s = s + "}\n";
  return s;
}

function fxsWU2fText(): string {
  let s = "";
  s = s + "// u32 から f32 へ、最近接偶数に丸める。2^24 未満はそのまま正確。それ以上は 24 ビットに自分で丸め、指数を足す。\n";
  s = s + "fn um_u2f(x: u32) -> f32 {\n";
  s = s + "  if (x < 0x1000000u) {\n";
  s = s + "    return f32(x);\n";
  s = s + "  }\n";
  s = s + "  let sh: u32 = 8u - countLeadingZeros(x);\n";
  s = s + "  var m: u32 = x >> sh;\n";
  s = s + "  let r: u32 = x & ((1u << sh) - 1u);\n";
  s = s + "  let half: u32 = 1u << (sh - 1u);\n";
  s = s + "  if (r > half || (r == half && (m & 1u) == 1u)) {\n";
  s = s + "    m = m + 1u;\n";
  s = s + "  }\n";
  s = s + "  return bitcast<f32>(bitcast<u32>(f32(m)) + (sh << 23u));\n";
  s = s + "}\n";
  return s;
}

function fxsWI2fText(): string {
  let s = "";
  s = s + "fn um_i2f(x: i32) -> f32 {\n";
  s = s + "  let neg: bool = x < 0i;\n";
  s = s + "  let u: u32 = bitcast<u32>(x);\n";
  s = s + "  let r: f32 = um_u2f(select(u, 0u - u, neg));\n";
  s = s + "  return select(r, -r, neg);\n";
  s = s + "}\n";
  return s;
}

// UM 本体の src/wgsl.ts の um_fdiv / um_fround と同じ。
function fxsWFdivText(): string {
  let s = "";
  s = s + "// IEEE 754 の f32 の割り算（最近接偶数への丸め）。GPU の割り算の命令は数 ULP の誤差を許すので、整数の演算で求める。\n";
  s = s + "fn um_fdiv(a: f32, b: f32) -> f32 {\n";
  s = s + "  let ua = bitcast<u32>(a);\n";
  s = s + "  let ub = bitcast<u32>(b);\n";
  s = s + "  let sign = (ua ^ ub) & 0x80000000u;\n";
  s = s + "  var ea = i32((ua >> 23u) & 0xffu);\n";
  s = s + "  var eb = i32((ub >> 23u) & 0xffu);\n";
  s = s + "  var ma = ua & 0x7fffffu;\n";
  s = s + "  var mb = ub & 0x7fffffu;\n";
  s = s + "  let nan = bitcast<f32>(0x7fc00000u | um_z);\n";
  s = s + "  if ((ea == 255 && ma != 0u) || (eb == 255 && mb != 0u)) {\n";
  s = s + "    return nan;\n";
  s = s + "  }\n";
  s = s + "  if (ea == 255) {\n";
  s = s + "    return select(bitcast<f32>(sign | 0x7f800000u), nan, eb == 255);\n";
  s = s + "  }\n";
  s = s + "  if (eb == 255) {\n";
  s = s + "    return bitcast<f32>(sign);\n";
  s = s + "  }\n";
  s = s + "  if (eb == 0 && mb == 0u) {\n";
  s = s + "    return select(bitcast<f32>(sign | 0x7f800000u), nan, ea == 0 && ma == 0u);\n";
  s = s + "  }\n";
  s = s + "  if (ea == 0 && ma == 0u) {\n";
  s = s + "    return bitcast<f32>(sign);\n";
  s = s + "  }\n";
  s = s + "  if (ea == 0) {\n";
  s = s + "    let sh = countLeadingZeros(ma) - 8u;\n";
  s = s + "    ma = ma << sh;\n";
  s = s + "    ea = 1 - i32(sh);\n";
  s = s + "  } else {\n";
  s = s + "    ma = ma | 0x800000u;\n";
  s = s + "  }\n";
  s = s + "  if (eb == 0) {\n";
  s = s + "    let sh = countLeadingZeros(mb) - 8u;\n";
  s = s + "    mb = mb << sh;\n";
  s = s + "    eb = 1 - i32(sh);\n";
  s = s + "  } else {\n";
  s = s + "    mb = mb | 0x800000u;\n";
  s = s + "  }\n";
  s = s + "  if (ma < mb) {\n";
  s = s + "    ma = ma << 1u;\n";
  s = s + "    ea = ea - 1;\n";
  s = s + "  }\n";
  s = s + "  var e = ea - eb + 127;\n";
  s = s + "  var rem = ma;\n";
  s = s + "  var q = 0u;\n";
  s = s + "  for (var k = 0u; k < 25u; k++) {\n";
  s = s + "    q = q << 1u;\n";
  s = s + "    if (rem >= mb) {\n";
  s = s + "      rem = rem - mb;\n";
  s = s + "      q = q | 1u;\n";
  s = s + "    }\n";
  s = s + "    rem = rem << 1u;\n";
  s = s + "  }\n";
  s = s + "  return um_fround(sign, e, q, rem != 0u);\n";
  s = s + "}\n";
  s = s + "\n";
  s = s + "// 25 ビットの仮数 q（最下位は丸めのビット）と sticky を、指数 e（バイアスつき）の f32 に丸める。\n";
  s = s + "fn um_fround(sign: u32, e0: i32, q0: u32, sticky0: bool) -> f32 {\n";
  s = s + "  var e = e0;\n";
  s = s + "  var q = q0;\n";
  s = s + "  var sticky = sticky0;\n";
  s = s + "  if (e >= 255) {\n";
  s = s + "    return bitcast<f32>(sign | 0x7f800000u);\n";
  s = s + "  }\n";
  s = s + "  if (e <= 0) {\n";
  s = s + "    let sh = u32(1 - e);\n";
  s = s + "    e = 1;\n";
  s = s + "    if (sh >= 26u) {\n";
  s = s + "      sticky = sticky || q != 0u;\n";
  s = s + "      q = 0u;\n";
  s = s + "    } else {\n";
  s = s + "      sticky = sticky || (q & ((1u << sh) - 1u)) != 0u;\n";
  s = s + "      q = q >> sh;\n";
  s = s + "    }\n";
  s = s + "  }\n";
  s = s + "  var m = q >> 1u;\n";
  s = s + "  if ((q & 1u) == 1u && (sticky || (m & 1u) == 1u)) {\n";
  s = s + "    m = m + 1u;\n";
  s = s + "  }\n";
  s = s + "  return bitcast<f32>(sign | ((u32(e - 1) << 23u) + m));\n";
  s = s + "}\n";
  return s;
}

// UM 本体の src/wgsl.ts の um_fsqrt と同じ。
function fxsWFsqrtText(): string {
  let s = "";
  s = s + "// IEEE 754 の f32 の平方根（最近接偶数への丸め）。整数の開平（2 ビットずつ）で 25 ビットの根と sticky を求める。\n";
  s = s + "fn um_fsqrt(a: f32) -> f32 {\n";
  s = s + "  let ua = bitcast<u32>(a);\n";
  s = s + "  var e = i32((ua >> 23u) & 0xffu);\n";
  s = s + "  var m = ua & 0x7fffffu;\n";
  s = s + "  if ((ua & 0x7fffffffu) == 0u || (e == 255 && m != 0u)) {\n";
  s = s + "    return a;\n";
  s = s + "  }\n";
  s = s + "  if ((ua & 0x80000000u) != 0u) {\n";
  s = s + "    return bitcast<f32>(0x7fc00000u | um_z);\n";
  s = s + "  }\n";
  s = s + "  if (e == 255) {\n";
  s = s + "    return a;\n";
  s = s + "  }\n";
  s = s + "  var ex: i32;\n";
  s = s + "  if (e == 0) {\n";
  s = s + "    let sh = countLeadingZeros(m) - 8u;\n";
  s = s + "    m = m << sh;\n";
  s = s + "    ex = -126 - i32(sh);\n";
  s = s + "  } else {\n";
  s = s + "    m = m | 0x800000u;\n";
  s = s + "    ex = e - 127;\n";
  s = s + "  }\n";
  s = s + "  let odd = (ex & 1) != 0;\n";
  s = s + "  let mx = m << select(1u, 2u, odd);\n";
  s = s + "  var rem = 0u;\n";
  s = s + "  var root = 0u;\n";
  s = s + "  for (var k = 0u; k < 25u; k++) {\n";
  s = s + "    let bits = select(0u, (mx >> (24u - 2u * k)) & 3u, k < 13u);\n";
  s = s + "    rem = (rem << 2u) | bits;\n";
  s = s + "    let trial = (root << 2u) | 1u;\n";
  s = s + "    root = root << 1u;\n";
  s = s + "    if (rem >= trial) {\n";
  s = s + "      rem = rem - trial;\n";
  s = s + "      root = root | 1u;\n";
  s = s + "    }\n";
  s = s + "  }\n";
  s = s + "  let er = select(ex / 2, (ex - 1) / 2, odd) + 127;\n";
  s = s + "  var r = root >> 1u;\n";
  s = s + "  if ((root & 1u) == 1u && (rem != 0u || (r & 1u) == 1u)) {\n";
  s = s + "    r = r + 1u;\n";
  s = s + "  }\n";
  s = s + "  return bitcast<f32>((u32(er - 1) << 23u) + r);\n";
  s = s + "}\n";
  return s;
}
