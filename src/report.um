// 人向け・機械向けの出力。診断の文、プロジェクトの JSON、端末向けのタイムライン図、キーと効果の一覧（schema）。
// 機械向けは JSON（数は JSON として正しい形。NaN と無限大は null）、人向けは日本語。
// 端末の桁を揃えるため、全角の文字は幅 2 と数える（rpWidth）。
import { sub, isNan, parseNum, appendText, splitBy, fmtTime } from "./text.um";
import { KeyInfo, coreKeys } from "./keys.um";
import { Project, Clip, Diag, FxUse, KIND_VIDEO, KIND_IMAGE, KIND_TEXT, KIND_COLOR, KIND_AUDIO } from "./project.um";
import { OpInfo, opInfos } from "./ops.um";
import { fxCount, fxName, fxDoc, fxParamCount, fxParamName, fxParamDoc, fxParamDefault, fxParamMin, fxParamMax, fxAliasCount, fxAlias } from "./gen/plugins.um";
import { WsaTrackSet, WSA_MASTER, wsaSetJson, wsaFmtVol, wsaFmtEq, wsaFmtComp, wsaNum } from "./ws_audio/mzc.um";
import { ClipAnim } from "./project.um";
import { animTrackJson, animDescribe, animSyntaxDoc, animTypeForKey } from "./m6_anim/anim.um";

// ---------------------------------------------------------------- JSON の部品

// JSON の文字列（前後の " を含む）。" と \ と制御文字をエスケープする。UTF-8 はそのまま。
export function jsonStr(s: string): string {
  let out: u8[] = [];
  rpJsonStrTo(mut out, s);
  return stringFromBytes(out);
}

function rpHexDigit(v: u32): u8 {
  if (v < 10) {
    return (48 + v) as u8;
  }
  return (87 + v) as u8;
}

// 不正な UTF-8 のバイトは U+FFFD（EF BF BD）に置き換える（JSON は UTF-8 でなければならない）。
function rpJsonStrTo(out: mut u8[], s: string): void {
  out.push(34);
  let i: usize = 0;
  while (i < s.length) {
    const b = s[i];
    if (b >= 0x80) {
      const n = rpValidLen(s, i);
      if (n == 0) {
        rpPushReplacement(mut out);
        i++;
      } else {
        for (let k: usize = 0; k < n; k++) {
          out.push(s[i + k]);
        }
        i += n;
      }
      continue;
    }
    i++;
    if (b == 34 || b == 92) {
      out.push(92);
      out.push(b);
    } else if (b == 10) {
      out.push(92);
      out.push(110);
    } else if (b == 13) {
      out.push(92);
      out.push(114);
    } else if (b == 9) {
      out.push(92);
      out.push(116);
    } else if (b == 8) {
      out.push(92);
      out.push(98);
    } else if (b == 12) {
      out.push(92);
      out.push(102);
    } else if (b < 32) {
      // \u00XX
      appendText(mut out, "\\u00");
      out.push(rpHexDigit((b as u32) >> 4));
      out.push(rpHexDigit((b as u32) & 15));
    } else {
      out.push(b);
    }
  }
  out.push(34);
}

// 文字列か、"" なら null。
function rpJsonStrOrNull(out: mut u8[], s: string): void {
  if (s == "") {
    appendText(mut out, "null");
  } else {
    rpJsonStrTo(mut out, s);
  }
}

function rpIsFinite(v: f64): bool {
  return !isNan(v) && !isNan(v - v);
}

// JSON の数。NaN と無限大は null。10 億未満の絶対値はマイクロ秒（1e-6）で丸めて、0.30000000000000004 のような尾を出さない。
// ただし丸めると 0 になる 0 でない値（0.0000004 など）は丸めずに出す。
// UM の ${x} は JavaScript と同じ表記（1e+21、1e-7 など）で、どれも JSON として正しい。
// 秒などの数を JSON の数にする（有限でなければ null）。
export function jsonNum(v: f64): string {
  return rpNum(v);
}

function rpNum(v: f64): string {
  if (!rpIsFinite(v)) {
    return "null";
  }
  if (Math.abs(v) < 1000000000.0) {
    const r = Math.floor(v * 1000000.0 + 0.5) / 1000000.0;
    if (r == 0 && v != 0) {
      return `${v}`;
    }
    return `${r}`;
  }
  return `${v}`;
}

// f32 の値を、f32 に戻すと同じ値になる最も短い小数で書く（1.4 は 1.399999976158142 でなく 1.4）。
function rpF32(v: f32): string {
  const d = v as f64;
  if (!rpIsFinite(d)) {
    return "null";
  }
  let m: f64 = 1;
  for (let k = 0; k < 10; k++) {
    const r = Math.floor(d * m + 0.5) / m;
    if ((r as f32) == v) {
      return `${r}`;
    }
    m = m * 10;
  }
  return `${d}`;
}

// ---------------------------------------------------------------- 文字の幅

// i バイト目から始まる正しい UTF-8 の 1 文字のバイト数。正しくない（はぐれた続きのバイト、途中で切れた列、
// 長すぎる表現、サロゲート、U+10FFFF を超えるもの）なら 0。
function rpValidLen(s: string, i: usize): usize {
  const b = s[i];
  if (b < 0x80) {
    return 1;
  }
  let n: usize = 0;
  let lo: u8 = 0x80;
  let hi: u8 = 0xbf;
  if (b >= 0xc2 && b <= 0xdf) {
    n = 2;
  } else if (b == 0xe0) {
    n = 3;
    lo = 0xa0;
  } else if (b >= 0xe1 && b <= 0xec) {
    n = 3;
  } else if (b == 0xed) {
    n = 3;
    hi = 0x9f;
  } else if (b == 0xee || b == 0xef) {
    n = 3;
  } else if (b == 0xf0) {
    n = 4;
    lo = 0x90;
  } else if (b >= 0xf1 && b <= 0xf3) {
    n = 4;
  } else if (b == 0xf4) {
    n = 4;
    hi = 0x8f;
  } else {
    return 0;
  }
  if (i + n > s.length) {
    return 0;
  }
  if (s[i + 1] < lo || s[i + 1] > hi) {
    return 0;
  }
  for (let k: usize = 2; k < n; k++) {
    if (s[i + k] < 0x80 || s[i + k] > 0xbf) {
      return 0;
    }
  }
  return n;
}

// i バイト目から始まる 1 文字のバイト数（不正なバイトは 1 バイトを 1 文字と数える）。
function rpCharLen(s: string, i: usize): usize {
  const n = rpValidLen(s, i);
  if (n == 0) {
    return 1;
  }
  return n;
}

// U+FFFD（置換文字）の UTF-8 を足す。
function rpPushReplacement(out: mut u8[]): void {
  out.push(0xef);
  out.push(0xbf);
  out.push(0xbd);
}

// i バイト目から始まる 1 文字の符号位置（不正な列は 0xfffd）。
function rpCodePoint(s: string, i: usize): u32 {
  const n = rpValidLen(s, i);
  if (n == 0) {
    return 0xfffd;
  }
  if (n == 1) {
    return s[i] as u32;
  }
  let cp: u32 = 0;
  if (n == 2) {
    cp = (s[i] as u32) & 0x1f;
  } else if (n == 3) {
    cp = (s[i] as u32) & 0x0f;
  } else {
    cp = (s[i] as u32) & 0x07;
  }
  for (let k: usize = 1; k < n; k++) {
    cp = (cp << 6) | ((s[i + k] as u32) & 0x3f);
  }
  return cp;
}

// 端末での 1 文字の幅（東アジアの全角・絵文字は 2、結合文字は 0、ほかは 1）。
function rpCharWidth(cp: u32): i32 {
  if (cp < 0x300) {
    return 1;
  }
  if (cp <= 0x36f || (cp >= 0x200b && cp <= 0x200f) || (cp >= 0x3099 && cp <= 0x309a) || (cp >= 0xfe00 && cp <= 0xfe0f)) {
    return 0;
  }
  if ((cp >= 0x1100 && cp <= 0x115f) || (cp >= 0x2e80 && cp <= 0x303e) || (cp >= 0x3041 && cp <= 0x33ff) ||
      (cp >= 0x3400 && cp <= 0x4dbf) || (cp >= 0x4e00 && cp <= 0x9fff) || (cp >= 0xa000 && cp <= 0xa4cf) ||
      (cp >= 0xac00 && cp <= 0xd7a3) || (cp >= 0xf900 && cp <= 0xfaff) || (cp >= 0xfe30 && cp <= 0xfe4f) ||
      (cp >= 0xff00 && cp <= 0xff60) || (cp >= 0xffe0 && cp <= 0xffe6) || (cp >= 0x1f300 && cp <= 0x1f64f) ||
      (cp >= 0x1f900 && cp <= 0x1f9ff) || (cp >= 0x20000 && cp <= 0x3fffd)) {
    return 2;
  }
  return 1;
}

// 文字列の端末での幅。
function rpWidth(s: string): i32 {
  let w = 0;
  let i: usize = 0;
  while (i < s.length) {
    w += rpCharWidth(rpCodePoint(s, i));
    i += rpCharLen(s, i);
  }
  return w;
}

// 幅が w を超えないところまでで切る。
function rpCut(s: string, w: i32): string {
  let used = 0;
  let i: usize = 0;
  while (i < s.length) {
    const cw = rpCharWidth(rpCodePoint(s, i));
    if (used + cw > w) {
      break;
    }
    used += cw;
    i += rpCharLen(s, i);
  }
  return sub(s, 0, i);
}

// 幅が w を超えるなら切って "..." を付ける。
function rpEllipsis(s: string, w: i32): string {
  if (rpWidth(s) <= w) {
    return s.clone();
  }
  if (w <= 3) {
    return rpCut(s, w);
  }
  return rpCut(s, w - 3) + "...";
}

// 右を空白で埋めて幅 w にする。
function rpPad(s: string, w: i32): string {
  let out: u8[] = [];
  appendText(mut out, s);
  let n = rpWidth(s);
  while (n < w) {
    out.push(32);
    n++;
  }
  return stringFromBytes(out);
}

// 左を空白で埋めて幅 w にする。
function rpPadLeft(s: string, w: i32): string {
  let out: u8[] = [];
  let n = rpWidth(s);
  while (n < w) {
    out.push(32);
    n++;
  }
  appendText(mut out, s);
  return stringFromBytes(out);
}

// 表を書く。各列を最も広い値に合わせる（最後の列は埋めない）。right[c] が true の列は右に寄せる。
function rpTable(out: mut u8[], rows: string[][], right: bool[], indent: string): void {
  let widths: i32[] = [];
  for (const r of rows) {
    for (let c: usize = 0; c < r.length; c++) {
      while (widths.length <= c) {
        widths.push(0);
      }
      widths[c] = Math.max(widths[c], rpWidth(r[c]));
    }
  }
  for (const r of rows) {
    let line: u8[] = [];
    appendText(mut line, indent);
    for (let c: usize = 0; c < r.length; c++) {
      if (c > 0) {
        appendText(mut line, "  ");
      }
      const isRight = c < right.length && right[c];
      if (isRight) {
        appendText(mut line, rpPadLeft(r[c], widths[c]));
      } else if (c + 1 < r.length) {
        appendText(mut line, rpPad(r[c], widths[c]));
      } else {
        appendText(mut line, r[c]);
      }
    }
    // 行末の空白を落とす
    while (line.length > 0 && line[line.length - 1] == 32) {
      line.pop();
    }
    for (const b of line) {
      out.push(b);
    }
    out.push(10);
  }
}

// ---------------------------------------------------------------- 診断

// 人向けの診断。"demo.mzc:7:12: エラー[unknown-key]: ..." と、hint があれば次の行に "  ヒント: ..."。
// 行が 0 なら位置を付けず、列が 0 なら行だけを付ける。最後に改行は付けない。
export function diagText(path: string, d: Diag): string {
  let sev = "警告";
  if (d.severity == "error") {
    sev = "エラー";
  }
  let pos = path.clone();
  if (d.line > 0) {
    pos = pos + `:${d.line}`;
    if (d.col > 0) {
      pos = pos + `:${d.col}`;
    }
  }
  let s = `${pos}: ${sev}[${d.code}]: ${d.msg}`;
  if (d.hint != "") {
    s = s + `\n  ヒント: ${d.hint}`;
  }
  return s;
}

function rpDiagsTo(out: mut u8[], diags: Diag[]): void {
  out.push(91);
  for (let i: usize = 0; i < diags.length; i++) {
    if (i > 0) {
      out.push(44);
    }
    appendText(mut out, "{\"code\":");
    rpJsonStrTo(mut out, diags[i].code);
    appendText(mut out, ",\"severity\":");
    rpJsonStrTo(mut out, diags[i].severity);
    appendText(mut out, `,"line":${diags[i].line},"col":${diags[i].col},"message":`);
    rpJsonStrTo(mut out, diags[i].msg);
    appendText(mut out, ",\"hint\":");
    rpJsonStrTo(mut out, diags[i].hint);
    appendText(mut out, ",\"suggest\":");
    rpJsonStrOrNull(mut out, diags[i].suggest);
    out.push(125);
  }
  out.push(93);
}

// 機械向けの診断: [{"code":..,"severity":..,"line":..,"col":..,"message":..,"hint":..}]
export function diagsJson(diags: Diag[]): string {
  let out: u8[] = [];
  rpDiagsTo(mut out, diags);
  return stringFromBytes(out);
}

// ---------------------------------------------------------------- プロジェクト

function rpKindName(kind: i32): string {
  switch (kind) {
    case KIND_VIDEO:
      return "video";
    case KIND_IMAGE:
      return "image";
    case KIND_TEXT:
      return "text";
    case KIND_COLOR:
      return "color";
    case KIND_AUDIO:
      return "audio";
    default:
      return "unknown";
  }
}

// 効果の番号から名前（登録表の外なら "fx<番号>"）。
function rpFxName(e: i32): string {
  if (e < 0 || e >= fxCount()) {
    return `fx${e}`;
  }
  return fxName(e);
}

function rpFxParamCount(e: i32): i32 {
  if (e < 0 || e >= fxCount()) {
    return 0;
  }
  return Math.min(fxParamCount(e), 8);
}

// プロジェクト全体の JSON。時間は秒の数。
// {"project":{..},"clips":[{index,id,line,kind,track,start,end,duration,in,src,text,effects:[{name,params:{..}}]}],"mix":[..],"diagnostics":[..]}
// id・src・text は、ないとき null。in は video / audio だけ（ほかは null）。
// mix は track の行（音のトラックとマスターの設定。src/ws_audio/mzc.um の wsaSetJson）。track の行がなければ出さない。
export function projectJson(p: Project, diags: Diag[]): string {
  let out: u8[] = [];
  let nErr = 0;
  for (const d of diags) {
    if (d.severity == "error") {
      nErr++;
    }
  }
  appendText(mut out, `{"ok":${nErr == 0},"project":{"width":${p.width},"height":${p.height},"fps":"${p.fpsNum}/${p.fpsDen}","rate":${p.rate},"duration":${rpNum(p.duration)},"effects":`);
  rpFxListTo(mut out, p.fx);
  appendText(mut out, ",\"anims\":");
  rpAnimsJsonTo(mut out, p.anims);
  appendText(mut out, `},"clips":[`);
  for (let i: usize = 0; i < p.clips.length; i++) {
    if (i > 0) {
      out.push(44);
    }
    rpClipJsonTo(mut out, i, p.clips[i]);
  }
  out.push(93);
  if (p.mix.length > 0) {
    appendText(mut out, ",\"mix\":[");
    for (let i: usize = 0; i < p.mix.length; i++) {
      if (i > 0) {
        out.push(44);
      }
      let name = "null";
      if (p.mix[i].name.length > 0) {
        name = jsonStr(p.mix[i].name);
      }
      appendText(mut out, wsaSetJson(p.mix[i], name));
    }
    out.push(93);
  }
  appendText(mut out, ",\"diagnostics\":");
  rpDiagsTo(mut out, diags);
  out.push(125);
  return stringFromBytes(out);
}

function rpClipJsonTo(out: mut u8[], i: usize, c: Clip): void {
  appendText(mut out, `{"index":${i},"id":`);
  rpJsonStrOrNull(mut out, c.id);
  appendText(mut out, `,"line":${c.line},"kind":"${rpKindName(c.kind)}","track":${c.track},"start":${rpNum(c.at)},"end":${rpNum(c.at + c.dur)},"duration":${rpNum(c.dur)},"in":`);
  if (c.kind == KIND_VIDEO || c.kind == KIND_AUDIO) {
    appendText(mut out, rpNum(c.inPt));
  } else {
    appendText(mut out, "null");
  }
  appendText(mut out, ",\"src\":");
  rpJsonStrOrNull(mut out, c.src);
  appendText(mut out, ",\"text\":");
  if (c.kind == KIND_TEXT) {
    rpJsonStrTo(mut out, c.text);
  } else {
    appendText(mut out, "null");
  }
  // at= の書いたまま（参照・秒・省略 = null）、行に書いた key=value、配置が確かか
  appendText(mut out, `,"trackKind":"${rpTrackKind(c)}","at":`);
  rpJsonStrOrNull(mut out, c.atText);
  appendText(mut out, `,"placed":${c.placed},"keys":{`);
  for (let k: usize = 0; k + 1 < c.kv.length; k += 2) {
    if (k > 0) {
      out.push(44);
    }
    rpJsonStrTo(mut out, c.kv[k]);
    out.push(58);
    rpJsonStrTo(mut out, c.kv[k + 1]);
  }
  appendText(mut out, "},\"effects\":");
  rpFxListTo(mut out, c.fx);
  appendText(mut out, ",\"anims\":");
  rpAnimsJsonTo(mut out, c.anims);
  out.push(125);
}

// キーフレームの値（{"x":{"type","keys":[...]},...}。キーフレームがなければ {}）。
function rpAnimsJsonTo(out: mut u8[], anims: ClipAnim[]): void {
  out.push(123);
  for (let k: usize = 0; k < anims.length; k++) {
    if (k > 0) {
      out.push(44);
    }
    rpJsonStrTo(mut out, anims[k].key);
    out.push(58);
    appendText(mut out, animTrackJson(anims[k].track));
  }
  out.push(125);
}

function rpTrackKind(c: Clip): string {
  if (c.kind == KIND_AUDIO) {
    return "audio";
  }
  return "video";
}

function rpFxListTo(out: mut u8[], fx: FxUse[]): void {
  out.push(91);
  for (let k: usize = 0; k < fx.length; k++) {
    if (k > 0) {
      out.push(44);
    }
    const e = fx[k].effect;
    appendText(mut out, "{\"name\":");
    rpJsonStrTo(mut out, rpFxName(e));
    appendText(mut out, ",\"params\":{");
    const n = rpFxParamCount(e);
    for (let j = 0; j < n; j++) {
      if (j > 0) {
        out.push(44);
      }
      rpJsonStrTo(mut out, fxParamName(e, j));
      out.push(58);
      appendText(mut out, rpF32(fx[k].params[j as usize]));
    }
    appendText(mut out, "}}");
  }
  out.push(93);
}

// ---------------------------------------------------------------- タイムライン図

// パスの最後の部分（"media/clip_a.mp4" → "clip_a.mp4"）。
function rpBaseName(s: string): string {
  let start: usize = 0;
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 47 || s[i] == 92) {
      start = i + 1;
    }
  }
  return sub(s, start, s.length);
}

// 端末に出す 1 行の文字にする。改行は \n の 2 文字に、そのほかの制御文字（タブ・DEL を含む）は空白に、
// 不正な UTF-8 のバイトは U+FFFD にする。
function rpOneLine(s: string): string {
  let out: u8[] = [];
  let i: usize = 0;
  while (i < s.length) {
    const b = s[i];
    if (b >= 0x80) {
      const n = rpValidLen(s, i);
      if (n == 0) {
        rpPushReplacement(mut out);
        i++;
      } else {
        for (let k: usize = 0; k < n; k++) {
          out.push(s[i + k]);
        }
        i += n;
      }
      continue;
    }
    i++;
    if (b == 10) {
      out.push(92);
      out.push(110);
    } else if (b == 13) {
      continue;
    } else if (b < 32 || b == 127) {
      out.push(32);
    } else {
      out.push(b);
    }
  }
  return stringFromBytes(out);
}

// 色（RGBA の u32）を "rrggbb"、不透明でなければ "rrggbbaa" に。
function rpColorHex(c: u32): string {
  let out: u8[] = [];
  let digits = 8;
  if ((c & 0xff) == 0xff) {
    digits = 6;
  }
  for (let k = 0; k < digits; k++) {
    const shift = (28 - 4 * k) as u32;
    out.push(rpHexDigit((c >> shift) & 15));
  }
  return stringFromBytes(out);
}

function rpTrackName(c: Clip): string {
  if (c.kind == KIND_AUDIO) {
    return `A${c.track}`;
  }
  return `V${c.track}`;
}

// 素材 / 文字の欄（ID を除く、クリップの中身の説明）。
function rpClipWhat(c: Clip): string {
  if (c.kind == KIND_TEXT) {
    return rpOneLine(c.text);
  }
  if (c.kind == KIND_COLOR) {
    return rpColorHex(c.color);
  }
  return rpOneLine(c.src);
}

// 図の中のラベル。ID があれば ID、なければ素材のファイル名・"T 文字"・"color rrggbb"。
function rpBarLabel(c: Clip): string {
  if (c.id != "") {
    return rpOneLine(c.id);
  }
  if (c.kind == KIND_TEXT) {
    return "T " + rpOneLine(c.text);
  }
  if (c.kind == KIND_COLOR) {
    return "color " + rpColorHex(c.color);
  }
  return rpOneLine(rpBaseName(c.src));
}

// 効果の短い表記: "sat=1.4 vignette=0.6 vignette.radius=0.9"（主でない引数は既定値と違うものだけ）。
function rpFxText(c: Clip): string {
  let s = "";
  for (const u of c.fx) {
    if (s != "") {
      s = s + " ";
    }
    const name = rpFxName(u.effect);
    const n = rpFxParamCount(u.effect);
    if (n == 0) {
      s = s + name;
      continue;
    }
    s = s + `${name}=${rpF32(u.params[0])}`;
    for (let k = 1; k < n; k++) {
      const v = u.params[k as usize];
      if (v != fxParamDefault(u.effect, k)) {
        s = s + ` ${name}.${fxParamName(u.effect, k)}=${rpF32(v)}`;
      }
    }
  }
  return s;
}

// 目盛りの文字の形。0: "0:02"（刻みが 1 秒未満なら "0:02.5"）、1: 1 時間以上の図は "1:02:03"、
// 2: 1 兆秒（およそ 3 万年）以上の図は時間の数に h を付ける（"277777778h"）。
const RP_TICK_MS: i32 = 0;
const RP_TICK_HMS: i32 = 1;
const RP_TICK_HOURS: i32 = 2;
const RP_HUGE_SEC: f64 = 1000000000000.0;

function rpTickMode(dur: f64): i32 {
  if (dur >= RP_HUGE_SEC) {
    return RP_TICK_HOURS;
  }
  if (dur >= 3600) {
    return RP_TICK_HMS;
  }
  return RP_TICK_MS;
}

// とても大きな数を短く書く。1000 兆未満は整数、それ以上は有効数字 3 桁の "2.78e296"。
function rpBigText(v: f64): string {
  const r = Math.floor(v + 0.5);
  if (r < 1000000000000000.0) {
    return `${r as i64}`;
  }
  let m = r;
  let e = 0;
  while (m >= 10 && e < 400) {
    m = m / 10;
    e++;
  }
  let q = Math.floor(m * 100 + 0.5) / 100;
  if (q >= 10) {
    q = q / 10;
    e++;
  }
  return `${q}e${e}`;
}

function rpTickText(t: f64, step: f64, mode: i32): string {
  if (mode == RP_TICK_HOURS) {
    return `${rpBigText(t / 3600)}h`;
  }
  const hours = mode == RP_TICK_HMS;
  const tenths = Math.floor(t * 10 + 0.5) as i64;
  const sec = tenths / 10;
  const m = sec / 60;
  const ss = sec % 60;
  let s = "";
  if (hours) {
    const mm = m % 60;
    s = `${m / 60}:`;
    if (mm < 10) {
      s = s + "0";
    }
    s = s + `${mm}:`;
  } else {
    s = `${m}:`;
  }
  if (ss < 10) {
    s = s + "0";
  }
  s = s + `${ss}`;
  if (step < 1) {
    s = s + `.${tenths % 10}`;
  }
  return s;
}

// 人向けの時刻。1 時間未満は fmtTime の m:ss.mmm、1 時間以上は目盛りに揃えて h:mm:ss.mmm。
// 1 兆秒以上は秒の数に s を付ける（rpBigText の形）。
function rpTime(t: f64): string {
  if (!rpIsFinite(t)) {
    return "-";
  }
  if (t < 3600) {
    return fmtTime(t);
  }
  if (t >= RP_HUGE_SEC) {
    return `${rpBigText(t)}s`;
  }
  const ms = Math.floor(t * 1000 + 0.5) as i64;
  const h = ms / 3600000;
  const m = (ms / 60000) % 60;
  const sec = (ms / 1000) % 60;
  const frac = ms % 1000;
  let s = `${h}:`;
  if (m < 10) {
    s = s + "0";
  }
  s = s + `${m}:`;
  if (sec < 10) {
    s = s + "0";
  }
  s = s + `${sec}.`;
  if (frac < 100) {
    s = s + "0";
  }
  if (frac < 10) {
    s = s + "0";
  }
  return s + `${frac}`;
}

// 時刻を桁に（0..cols）。
function rpCol(t: f64, dur: f64, cols: i32): i32 {
  const c = Math.floor(t / dur * (cols as f64)) as i32;
  return Math.max(0, Math.min(c, cols));
}

function rpBlank(n: i32): string[] {
  let cells: string[] = [];
  for (let i = 0; i < n; i++) {
    cells.push(" ");
  }
  return cells;
}

// 桁 s から幅 w の中に文字を置く。全角の文字は 2 桁を使い、次の桁は "" にする（全角を境目で半分に切らない）。
// 置けたところまでのバイト数を返す。不正な UTF-8 のバイトは U+FFFD にする。
function rpPutText(cells: mut string[], s: i32, w: i32, text: string): usize {
  let col = s;
  let i: usize = 0;
  while (i < text.length) {
    const valid = rpValidLen(text, i);
    const e = i + rpCharLen(text, i);
    const cw = rpCharWidth(rpCodePoint(text, i));
    if (cw == 0) {
      i = e;
      continue;
    }
    if (col + cw > s + w) {
      break;
    }
    if (valid == 0) {
      cells[col as usize] = "�";
    } else {
      cells[col as usize] = sub(text, i, e);
    }
    if (cw == 2) {
      cells[(col + 1) as usize] = "";
    }
    col += cw;
    i = e;
  }
  return i;
}

// クリップの棒 [ラベル   ] を [s, e) に描く。幅 1 なら "|"、2 なら "[]"。
function rpPutBar(cells: mut string[], s: i32, e: i32, label: string): void {
  const n = e - s;
  if (n <= 0) {
    return;
  }
  if (n == 1) {
    cells[s as usize] = "|";
    return;
  }
  cells[s as usize] = "[";
  cells[(e - 1) as usize] = "]";
  const used = rpPutText(mut cells, s + 1, n - 2, label);
  // 改行を書いた "\n" の間で切れたら、残った "\" を消す
  if (used > 0 && used < label.length && label[used - 1] == 92 && label[used] == 110) {
    const last = s + 1 + rpWidth(sub(label, 0, used)) - 1;
    cells[last as usize] = " ";
  }
}

function rpLineTo(out: mut u8[], label: string, labelW: i32, cells: string[]): void {
  let line: u8[] = [];
  appendText(mut line, rpPad(label, labelW));
  for (const c of cells) {
    appendText(mut line, c);
  }
  while (line.length > 0 && line[line.length - 1] == 32) {
    line.pop();
  }
  for (const b of line) {
    out.push(b);
  }
  out.push(10);
}

// 1 本のトラック（映像か音）の行を書く。重なるクリップは行を増やして下に置く（最初の行だけにトラックの名前を書く）。
function rpTrackRows(out: mut u8[], p: Project, audio: bool, track: i32, dur: f64, cols: i32, labelW: i32): void {
  // このトラックのクリップを開始の順に（同じならファイルの順）
  let idx: i32[] = [];
  for (let i: usize = 0; i < p.clips.length; i++) {
    if ((p.clips[i].kind == KIND_AUDIO) != audio || p.clips[i].track != track) {
      continue;
    }
    idx.push(i as i32);
    let k = idx.length - 1;
    while (k > 0 && p.clips[idx[k - 1] as usize].at > p.clips[i].at) {
      const t = idx[k - 1];
      idx[k - 1] = idx[k];
      idx[k] = t;
      k--;
    }
  }
  if (idx.length == 0) {
    return;
  }
  // 行を決める: 桁が重ならない最初の行に置く
  let rowEnd: i32[] = [];
  let rowOf: i32[] = [];
  let starts: i32[] = [];
  let ends: i32[] = [];
  for (const ci of idx) {
    const at = p.clips[ci as usize].at;
    let s = rpCol(at, dur, cols);
    if (s >= cols) {
      s = cols - 1;
    }
    let e = rpCol(at + p.clips[ci as usize].dur, dur, cols);
    if (e <= s) {
      e = s + 1;
    }
    let r: usize = 0;
    while (r < rowEnd.length && rowEnd[r] > s) {
      r++;
    }
    if (r == rowEnd.length) {
      rowEnd.push(e);
    } else {
      rowEnd[r] = e;
    }
    rowOf.push(r as i32);
    starts.push(s);
    ends.push(e);
  }
  let name = `V${track}`;
  if (audio) {
    name = `A${track}`;
  }
  for (let r: usize = 0; r < rowEnd.length; r++) {
    let cells = rpBlank(cols);
    for (let k: usize = 0; k < idx.length; k++) {
      if (rowOf[k] == (r as i32)) {
        rpPutBar(mut cells, starts[k], ends[k], rpBarLabel(p.clips[idx[k] as usize]));
      }
    }
    if (r == 0) {
      rpLineTo(mut out, name, labelW, cells);
    } else {
      rpLineTo(mut out, "", labelW, cells);
    }
  }
}

// 端末向けのタイムライン図とクリップの一覧。width は図の幅（文字数。全角は 2 と数える）。
// 図の幅の最小は、トラックの名前の欄（"V0" なら 4 桁）＋10 桁。width がそれより小さいときは最小の幅で描く。
// 1 行目と一覧の行は width で折り返さない（幅を超えることがある）。
// 映像のトラックは番号の大きいもの（上に重なるもの）を上に、音のトラックはその下に番号の順に並べる。
export function showText(p: Project, width: i32): string {
  let out: u8[] = [];
  let fps = `${p.fpsNum}`;
  if (p.fpsDen != 1 && p.fpsDen != 0) {
    fps = rpNum(Math.floor((p.fpsNum as f64) / (p.fpsDen as f64) * 1000 + 0.5) / 1000);
  }
  appendText(mut out, `${p.width}x${p.height}  ${fps}fps  ${p.rate}Hz  ${rpTime(Math.max(p.duration, 0.0))}  クリップ ${p.clips.length}\n`);
  if (p.clips.length == 0) {
    appendText(mut out, "（クリップがありません）");
    return stringFromBytes(out);
  }

  // トラックの番号の最大と、ラベルの欄の幅
  let maxV = -1;
  let maxA = -1;
  for (const c of p.clips) {
    if (c.kind == KIND_AUDIO) {
      maxA = Math.max(maxA, c.track);
    } else {
      maxV = Math.max(maxV, c.track);
    }
  }
  const labelW = rpWidth(`V${Math.max(Math.max(maxV, maxA), 0)}`) + 2;
  let cols = width - labelW;
  if (cols < 10) {
    cols = 10;
  }
  let dur = p.duration;
  for (const c of p.clips) {
    dur = Math.max(dur, c.at + c.dur);
  }
  if (!rpIsFinite(dur) || dur <= 0) {
    dur = 1;
  }

  // 目盛り: 文字が重ならない最も細かい刻み。表の候補で足りなければ ×2・×2.5・×2 と続けて必ず見つける
  //（dur は有限なので、刻みはいずれ dur を超える）。必要な間隔は、最も遅い目盛りの文字の幅＋2 桁。
  const mode = rpTickMode(dur);
  const steps: f64[] = [0.1, 0.2, 0.5, 1, 2, 5, 10, 15, 30, 60, 120, 300, 600, 900, 1800, 3600, 7200, 18000, 36000];
  const grow: f64[] = [2, 2.5, 2];
  let step: f64 = dur;
  let st: f64 = steps[0];
  for (let i: usize = 0; i < 3000; i++) {
    if (i < steps.length) {
      st = steps[i];
    } else {
      st = st * grow[(i - steps.length) % 3];
    }
    const need = rpWidth(rpTickText(Math.floor(dur / st) * st, st, mode)) + 2;
    if (st / dur * (cols as f64) >= (need as f64) * 0.999999) {
      step = st;
      break;
    }
  }
  // 目盛りの数（刻みの選び方から cols / 3 + 1 個以下。念のため cols で抑える）
  let kMax = Math.floor(dur / step + 0.000001);
  if (kMax > (cols as f64)) {
    kMax = cols as f64;
  }
  const kLast = kMax as i32;
  let labels = rpBlank(cols);
  let ruler: string[] = [];
  for (let i = 0; i < cols; i++) {
    ruler.push("-");
  }
  for (let k = 0; k <= kLast; k++) {
    const col = rpCol((k as f64) * step, dur, cols);
    ruler[Math.min(col, cols - 1) as usize] = "+";
  }
  // 最後の目盛りの文字を先に決める（右の端にかかるなら左へずらす）。ほかの目盛りはそれと重ならないものだけを置く
  const lastText = rpTickText((kLast as f64) * step, step, mode);
  const lastW = rpWidth(lastText);
  let lastS = rpCol((kLast as f64) * step, dur, cols);
  if (lastS + lastW > cols) {
    lastS = cols - lastW;
  }
  let lastEnd = -1;
  for (let k = 0; k < kLast; k++) {
    const t = (k as f64) * step;
    const text = rpTickText(t, step, mode);
    const tw = rpWidth(text);
    let s = rpCol(t, dur, cols);
    if (s + tw > cols) {
      s = cols - tw;
    }
    if (s > lastEnd && s >= 0 && s + tw < lastS) {
      rpPutText(mut labels, s, tw, text);
      lastEnd = s + tw;
    }
  }
  if (lastS >= 0 && lastS > lastEnd) {
    rpPutText(mut labels, lastS, lastW, lastText);
  }
  rpLineTo(mut out, "", labelW, labels);
  rpLineTo(mut out, "", labelW, ruler);
  for (let t = maxV; t >= 0; t--) {
    rpTrackRows(mut out, p, false, t, dur, cols, labelW);
  }
  for (let t = 0; t <= maxA; t++) {
    rpTrackRows(mut out, p, true, t, dur, cols, labelW);
  }

  // クリップの一覧
  out.push(10);
  let rows: string[][] = [];
  rows.push(["#", "ID", "行", "種類", "トラック", "開始", "終わり", "素材 / 文字", "効果"]);
  for (let i: usize = 0; i < p.clips.length; i++) {
    rows.push(rpClipRow(i, p.clips[i]));
  }
  rpTable(mut out, rows, [true, false, true, false, false, true, true, false, false], "");
  // 音のトラックの設定（track の行。あるときだけ）
  if (p.mix.length > 0) {
    out.push(10);
    let mrows: string[][] = [];
    mrows.push(["トラック", "行", "名前", "音量 dB", "パン", "ミュート / ソロ", "EQ", "コンプ"]);
    for (const m of p.mix) {
      mrows.push(rpMixRow(m));
    }
    rpTable(mut out, mrows, [false, true, false, true, true, false, false, false], "");
  }
  // キーフレーム（クリップごとに、動く値の説明）
  let nAnim = p.anims.length;
  for (const c of p.clips) {
    nAnim += c.anims.length;
  }
  if (nAnim > 0) {
    out.push(10);
    appendText(mut out, "キーフレーム\n");
    for (const a of p.anims) {
      appendText(mut out, `  project: ${animDescribe(a.key, a.track)}\n`);
    }
    for (let i: usize = 0; i < p.clips.length; i++) {
      let name = rpOneLine(p.clips[i].id);
      if (name == "") {
        name = `${p.clips[i].line} 行目`;
      }
      for (const a of p.clips[i].anims) {
        appendText(mut out, `  #${i} ${name}: ${animDescribe(a.key, a.track)}\n`);
      }
    }
  }
  while (out.length > 0 && out[out.length - 1] == 10) {
    out.pop();
  }
  return stringFromBytes(out);
}

// 音のトラックの設定の表の 1 行（show。トラックの名前はクリップの一覧と同じ A<番号>）。
function rpMixRow(m: WsaTrackSet): string[] {
  let tr = `A${m.audio}`;
  if (m.audio == WSA_MASTER) {
    tr = "マスター";
  }
  let name = rpEllipsis(rpOneLine(m.name), 24);
  if (name == "") {
    name = "-";
  }
  let ms = "-";
  if (m.mute && m.solo) {
    ms = "ミュート・ソロ";
  } else if (m.mute) {
    ms = "ミュート";
  } else if (m.solo) {
    ms = "ソロ";
  }
  let eq = "-";
  if (m.eq.length > 0) {
    eq = rpEllipsis(wsaFmtEq(m.eq), 40);
    if (m.eqOff) {
      eq = eq + "（切）";
    }
  }
  let comp = "-";
  if (m.hasComp) {
    comp = wsaFmtComp(m);
    if (m.compOff) {
      comp = comp + "（切）";
    }
  }
  let row: string[] = [tr, `${m.line}`, name, wsaFmtVol(m.volDb), wsaNum(m.pan), ms, eq, comp];
  return row;
}

// 一覧の 1 行。
function rpClipRow(i: usize, c: Clip): string[] {
  let id = rpOneLine(c.id);
  if (id == "") {
    id = "-";
  }
  let what = rpEllipsis(rpClipWhat(c), 40);
  if (c.kind == KIND_TEXT) {
    what = "\"" + rpEllipsis(rpClipWhat(c), 38) + "\"";
  }
  let fx = rpFxText(c);
  if (fx == "") {
    fx = "-";
  }
  let row: string[] = [`#${i}`, id, `${c.line}`, rpKindName(c.kind), rpTrackName(c), rpTime(c.at), rpTime(c.at + c.dur), what, fx];
  return row;
}

// ---------------------------------------------------------------- schema

// "enum:a|b|c" の選択肢（enum でなければ空）。
function rpEnumValues(type: string): string[] {
  if (type.length < 5 || sub(type, 0, 5) != "enum:") {
    let none: string[] = [];
    return none;
  }
  return splitBy(sub(type, 5, type.length), 124);
}

// 範囲の表記: "0..1"、上限がなければ "0 以上"、下限がなければ "1 以下"。
function rpRange(a: string, b: string): string {
  if (a == "" && b == "") {
    return "";
  }
  if (b == "") {
    return `${a} 以上`;
  }
  if (a == "") {
    return `${b} 以下`;
  }
  return `${a}..${b}`;
}

// コアのキーと、プラグインの効果・引数の一覧（人向け、日本語の表）。
export function schemaText(): string {
  let out: u8[] = [];
  const keys = coreKeys();
  appendText(mut out, "コアのキー\n");
  if (keys.length == 0) {
    appendText(mut out, "  （なし）\n");
  } else {
    let rows: string[][] = [];
    rows.push(["キー", "使える行", "型", "既定", "範囲", "説明"]);
    for (const k of keys) {
      let def = k.def.clone();
      if (def == "") {
        def = "-";
      }
      let range = rpRange(k.min, k.max);
      if (range == "") {
        range = "-";
      }
      let type = k.type.clone();
      let doc = k.doc.clone();
      const vals = rpEnumValues(k.type);
      if (vals.length > 0) {
        type = "enum";
        if (doc != "") {
          doc = doc + "  ";
        }
        doc = doc + "選択肢: ";
        for (let v: usize = 0; v < vals.length; v++) {
          if (v > 0) {
            doc = doc + " / ";
          }
          doc = doc + vals[v];
        }
      }
      rows.push([k.name.clone(), k.kinds.clone(), type, def, range, doc]);
    }
    rpTable(mut out, rows, [], "  ");
  }
  let animKeys = "";
  for (const k of keys) {
    if (animTypeForKey(k.name) >= 0 && !rpHasWord(animKeys, k.name)) {
      if (animKeys != "") {
        animKeys = animKeys + " / ";
      }
      animKeys = animKeys + k.name;
    }
  }
  appendText(mut out, `  キーフレームで動かせるキー: ${animKeys} と効果の引数\n`);
  appendText(mut out, `  ${animSyntaxDoc()}\n`);
  out.push(10);
  const n = fxCount();
  appendText(mut out, `効果（プラグイン） ${n} 個\n`);
  appendText(mut out, "  書き方: <効果>=<値> で主の引数（最初の引数）を、<効果>.<引数>=<値> でほかの引数を決める。行に書いた順に掛ける。\n");
  appendText(mut out, "  名前だけ（gray）なら主の引数の既定値で掛ける。\n");
  appendText(mut out, "  video / image / text / color の行に書くと、そのクリップ（の層）にだけ掛かる。小窓やロゴにも別々に掛かる。\n");
  appendText(mut out, "  合成した画面全体に掛けるときは project の行に書く（例: project vignette=0.5）。audio の行には書けない。\n");
  appendText(mut out, "  別名は効果の名前の代わりに書ける（<別名>=<値>、<別名>.<引数>=<値>）。\n");
  if (n == 0) {
    appendText(mut out, "  （なし）\n");
  }
  for (let e = 0; e < n; e++) {
    out.push(10);
    appendText(mut out, `  ${fxName(e)}  ${fxDoc(e)}\n`);
    const ac = fxAliasCount(e);
    if (ac > 0) {
      let names = "";
      for (let a = 0; a < ac; a++) {
        if (a > 0) {
          names = names + " / ";
        }
        names = names + fxAlias(e, a);
      }
      appendText(mut out, `    別名: ${names}\n`);
    }
    const pc = rpFxParamCount(e);
    if (pc == 0) {
      appendText(mut out, "    （引数なし）\n");
      continue;
    }
    let rows: string[][] = [];
    rows.push(["引数", "キー", "既定", "範囲", "説明"]);
    for (let k = 0; k < pc; k++) {
      let key = `${fxName(e)}.${fxParamName(e, k)}`;
      if (k == 0) {
        key = `${fxName(e)} / ${key}`;
      }
      rows.push([fxParamName(e, k), key, rpF32(fxParamDefault(e, k)), rpRange(rpF32(fxParamMin(e, k)), rpF32(fxParamMax(e, k))), fxParamDoc(e, k)]);
    }
    rpTable(mut out, rows, [], "    ");
  }
  out.push(10);
  appendText(mut out, "時刻と参照\n");
  for (const l of rpTimeDocs()) {
    appendText(mut out, `  ${l}\n`);
  }
  out.push(10);
  appendText(mut out, "操作（node tools/mozcut.mjs op <project.mzc> <操作> [--dry-run] [--json]）\n");
  let orows: string[][] = [];
  orows.push(["操作", "書き方", "説明", "例"]);
  for (const o of opInfos()) {
    orows.push([o.name.clone(), o.usage.clone(), o.doc.clone(), o.example.clone()]);
  }
  rpTable(mut out, orows, [], "  ");
  appendText(mut out, "  --file <ops.txt | -> で 1 行に 1 つの操作をまとめて適用できる。どれかが失敗したら何も書かない。\n");
  appendText(mut out, "  --dry-run は変更を表示するだけで保存しない。--json の結果: ok / saved / results[{op, ok, code, desc, error, hint, suggest, newId, changes, moved, newDiagnostics}]\n");
  while (out.length > 0 && out[out.length - 1] == 10) {
    out.pop();
  }
  return stringFromBytes(out);
}

// "a / b / c" の並びに w があるか。
function rpHasWord(list: string, w: string): bool {
  for (const s of splitBy(list, 32)) {
    if (s == w) {
      return true;
    }
  }
  return false;
}

// 時刻と参照の書き方（schema の文と JSON で共通）。
function rpTimeDocs(): string[] {
  return [
    "時刻: 秒（12.5）か 分:秒（1:02.5）。時:分:秒（1:02:03）も書ける。分と秒の欄は 60 未満。負の時刻は書けない。",
    "at= の参照: intro.start / intro.end、オフセット付き（intro.start+1.5、intro.end-0.5）、after:intro（= intro.end）。参照先が動けば付いて動く。",
    "at= を省くと、同じトラックの前の行のクリップの後ろに置く（xfade= ならその秒数だけ重ねる）。",
    "クリップの指し方（操作）: ID（intro）、#番号（#3。0 から数える）、@行番号（@7）。",
    "トラック: video / image / text / color は映像トラック、audio は音トラック（番号は別々。show では V0 / A0）。",
    "文字の値の中: \\n は改行、\\t はタブ、\\\" は \"、\\\\ は \\。",
  ];
}

// 数として読めれば数、読めなければ文字列、"" なら null。
function rpJsonLoose(out: mut u8[], s: string): void {
  if (s == "") {
    appendText(mut out, "null");
    return;
  }
  const v = parseNum(s);
  if (rpIsFinite(v)) {
    appendText(mut out, rpNum(v));
  } else {
    rpJsonStrTo(mut out, s);
  }
}

// 機械向けの一覧。
// {"version":2,"keys":[{"name","kinds":[..],"type","values"?,"default","defaultExpr"?,"aliasOf"?,"min","max","doc"}],
//  "effects":[{"name","doc","kinds":[..],"aliases":[..],"params":[{"name","key","default","min","max","doc"}]}],"effectsNote",
//  "ops":[{"name","usage","doc","example"}],"syntax":[..]}
// keys は (name, kinds) で 1 つずつ（同じ name でも行の種類ごとに意味が違うことがある。project の out は output の別名）。
// default は数の型なら数か null（式なら defaultExpr）、ほかは文字列か null。type が enum なら values に選択肢。kinds の "*" は並べて出す。
export function schemaJson(): string {
  let out: u8[] = [];
  const keys = coreKeys();
  appendText(mut out, "{\"version\":2,\"keys\":[");
  for (let i: usize = 0; i < keys.length; i++) {
    if (i > 0) {
      out.push(44);
    }
    appendText(mut out, "{\"name\":");
    rpJsonStrTo(mut out, keys[i].name);
    appendText(mut out, ",\"kinds\":[");
    let kstr = keys[i].kinds.clone();
    if (kstr == "*") {
      kstr = "video,image,text,color,audio";
    }
    const kinds = splitBy(kstr, 44);
    let first = true;
    for (const kd of kinds) {
      if (kd == "") {
        continue;
      }
      if (!first) {
        out.push(44);
      }
      first = false;
      rpJsonStrTo(mut out, kd);
    }
    appendText(mut out, "],\"type\":");
    const vals = rpEnumValues(keys[i].type);
    if (vals.length > 0) {
      rpJsonStrTo(mut out, "enum");
    } else {
      rpJsonStrTo(mut out, keys[i].type);
    }
    if (vals.length > 0) {
      appendText(mut out, ",\"values\":[");
      for (let v: usize = 0; v < vals.length; v++) {
        if (v > 0) {
          out.push(44);
        }
        rpJsonStrTo(mut out, vals[v]);
      }
      out.push(93);
    }
    // default: 数の型なら数か null（式なら defaultExpr）、ほかは文字列か null
    const t = keys[i].type.clone();
    const def = keys[i].def.clone();
    const numeric = t == "number" || t == "int" || t == "time" || t == "flag";
    appendText(mut out, ",\"default\":");
    if (def == "") {
      appendText(mut out, "null");
    } else if (numeric && rpIsFinite(parseNum(def))) {
      appendText(mut out, rpNum(parseNum(def)));
    } else if (numeric) {
      appendText(mut out, "null,\"defaultExpr\":");
      rpJsonStrTo(mut out, def);
    } else {
      rpJsonStrTo(mut out, def);
    }
    // 別名（説明が「〜の別名」）なら aliasOf
    const doc = keys[i].doc.clone();
    const tail = " の別名";
    if (doc.length > tail.length && sub(doc, doc.length - tail.length, doc.length) == tail) {
      appendText(mut out, ",\"aliasOf\":");
      rpJsonStrTo(mut out, sub(doc, 0, doc.length - tail.length));
    }
    appendText(mut out, ",\"min\":");
    rpJsonLoose(mut out, keys[i].min);
    appendText(mut out, ",\"max\":");
    rpJsonLoose(mut out, keys[i].max);
    appendText(mut out, ",\"doc\":");
    rpJsonStrTo(mut out, keys[i].doc);
    // キーフレーム（値@時刻 の列）で動かせるか
    appendText(mut out, `,"animatable":${animTypeForKey(keys[i].name) >= 0}`);
    out.push(125);
  }
  appendText(mut out, "],\"effects\":[");
  const n = fxCount();
  for (let e = 0; e < n; e++) {
    if (e > 0) {
      out.push(44);
    }
    appendText(mut out, "{\"name\":");
    rpJsonStrTo(mut out, fxName(e));
    appendText(mut out, ",\"doc\":");
    rpJsonStrTo(mut out, fxDoc(e));
    appendText(mut out, ",\"kinds\":[\"video\",\"image\",\"text\",\"color\",\"project\"],\"aliases\":[");
    for (let a = 0; a < fxAliasCount(e); a++) {
      if (a > 0) {
        out.push(44);
      }
      rpJsonStrTo(mut out, fxAlias(e, a));
    }
    appendText(mut out, "],\"params\":[");
    const pc = rpFxParamCount(e);
    for (let k = 0; k < pc; k++) {
      if (k > 0) {
        out.push(44);
      }
      appendText(mut out, "{\"name\":");
      rpJsonStrTo(mut out, fxParamName(e, k));
      appendText(mut out, ",\"key\":");
      rpJsonStrTo(mut out, `${fxName(e)}.${fxParamName(e, k)}`);
      appendText(mut out, `,"default":${rpF32(fxParamDefault(e, k))},"min":${rpF32(fxParamMin(e, k))},"max":${rpF32(fxParamMax(e, k))},"doc":`);
      rpJsonStrTo(mut out, fxParamDoc(e, k));
      appendText(mut out, ",\"animatable\":true");
      out.push(125);
    }
    appendText(mut out, "]}");
  }
  appendText(mut out, "],\"effectsNote\":");
  rpJsonStrTo(mut out, "クリップの行に書くとそのクリップの層にだけ掛かる。project の行に書くと合成した画面全体に掛かる。名前だけ（gray）なら主の引数の既定値。行に書いた順に掛ける");
  appendText(mut out, ",\"ops\":[");
  const ops = opInfos();
  for (let i: usize = 0; i < ops.length; i++) {
    if (i > 0) {
      out.push(44);
    }
    appendText(mut out, "{\"name\":");
    rpJsonStrTo(mut out, ops[i].name);
    appendText(mut out, ",\"usage\":");
    rpJsonStrTo(mut out, ops[i].usage);
    appendText(mut out, ",\"doc\":");
    rpJsonStrTo(mut out, ops[i].doc);
    appendText(mut out, ",\"example\":");
    rpJsonStrTo(mut out, ops[i].example);
    out.push(125);
  }
  appendText(mut out, "],\"syntax\":[");
  const td = rpTimeDocs();
  for (let i: usize = 0; i < td.length; i++) {
    if (i > 0) {
      out.push(44);
    }
    rpJsonStrTo(mut out, td[i]);
  }
  out.push(44);
  rpJsonStrTo(mut out, animSyntaxDoc());
  appendText(mut out, "]}");
  return stringFromBytes(out);
}
