// 「音」のワークスペース（ws_audio.um）の状態。E2View.wau と E2Kit.wau に入れる（ws_audio.um だけが書き換える。Kit は読むだけ）。
// E2View / E2Kit から読むので、このファイルは e2_* を読まない。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wau / Wau で始める。
import { MxTheme, mixerThemeFromJson } from "../ui/mixer/theme.um";
import { thMakeDefault } from "../gen/theme.um";
import { thToUk } from "../ui/theme_uk.um";
import { emptyProject } from "../engine/project.um";
import { WsaWs, wsaWsNew } from "../workspaces/audio/model.um";

// 部品と配線が書き換える状態。
export struct WauState {
  // ミキサーの中身（src/workspaces/audio/model.um）。トラックの設定（影の値を含む）・メーター・ラウドネス
  ws: WsaWs;
  // ws を作ったか。作ったとき（合わせたとき）の ed.ver と ed.cache（変わったら作り直すか合わせ直す）
  built: bool;
  ver: i64;
  cache: string;
  // メーターに入れたコマの頭（タイムラインの標本の位置。-1 はまだ）
  fedPos: i64;
  // 影の値が変わったので、止まっていても今のコマを混ぜ直す
  dirty: bool;
  // メーターを、鳴らしている音の値（ed.playMeter）から出したフレームの数（試し用。--stats の audiows）
  playMeters: i64;
  // クリップの欄（選んだクリップの音量・フェード）をドラッグしている間の値。離したときに 1 つの op にする
  // （pendLine は .mzc のクリップの行。0 なら無い）
  pendLine: i32;
  pendKey: string;
  pendVal: f64;
}

// 読むだけのもの（tokens.json から作るテーマなど）。e2KitNew が 1 回だけ作る。
// th.rightW だけは、毎フレーム ws_audio.um が右の列の幅に合わせる。
export struct WauKit {
  // tokens.json を読めたか
  tokensOk: bool;
  scale: f32;
  th: MxTheme;
  // th.rightW の元の値（右の列を畳んだときに使う）
  rightW0: i32;
}

export function wauStateNew(): WauState {
  return { ws: wsaWsNew(emptyProject(), ""), built: false, ver: -1, cache: "", fedPos: -1, dirty: false, playMeters: 0,
    pendLine: 0, pendKey: "", pendVal: 0.0 };
}

// js は tokens.json の本文（読めなければ ""）、scale は画面の倍率。
export function wauKitNew(js: string, scale: f32): WauKit {
  const uk = thToUk(thMakeDefault(scale));
  const th = mixerThemeFromJson(js, uk, scale);
  const rightW0 = th.rightW;
  return { tokensOk: js.length > 0, scale, th, rightW0 };
}
