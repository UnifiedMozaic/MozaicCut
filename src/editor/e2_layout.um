// 新しい編集画面の配置（ui.md 2.1、mockups/edit.html）: 上の帯 40 ／ レール 56 ／ 左の欄 260 ／ モニター ／ 右の列 320 ／
// タイムライン（本体の 44%）／ 状態の帯 24。左の欄・右の列・タイムラインの境目はドラッグで大きさを変えられ、
// ダブルクリックで既定に戻る。大きさは E2View に論理の px（タイムラインは割合）で持つ。
import { UkCtx, ukBehavior, ukId, ukDrawRect, ukSetCursor, UK_CURSOR_RESIZE_EW, UK_CURSOR_RESIZE_NS } from "../ui/kit/core.um";
import { UkRect, ukRect } from "../ui/kit/base.um";
import {
  TH_SIZE_TOP_BAR, TH_SIZE_RAIL, TH_SIZE_STATUS_BAR, TH_SIZE_PANEL_DEFAULT_LEFT, TH_SIZE_PANEL_DEFAULT_RIGHT, TH_SIZE_PANEL_MIN_LEFT,
  TH_SIZE_PANEL_MAX_LEFT, TH_SIZE_PANEL_MIN_RIGHT, TH_SIZE_PANEL_MAX_RIGHT, TH_SIZE_PANEL_MIN_MONITOR_W, TH_SIZE_PANEL_MIN_MONITOR_H,
  TH_SIZE_PANEL_MIN_TIMELINE_H, TH_SIZE_PANEL_DEFAULT_TIMELINE_RATIO, TH_SIZE_PANEL_MAX_TIMELINE_RATIO, thPxAt,
} from "../gen/theme.um";
import { E2Kit, E2View } from "./e2_view.um";

export struct E2Lay {
  top: UkRect;
  rail: UkRect;
  left: UkRect;
  mon: UkRect;
  right: UkRect;
  tl: UkRect;
  status: UkRect;
}

// 境目の当たりの幅（見た目の線は 1px。押しやすいように両側に広げる）。窓の座標で 3。高密度の画面では画素で
// winDensity 倍にして、押しやすさを変えない
const E2_GRIP: i32 = 3;

function e2GripW(ui: UkCtx): i32 {
  return Math.max(Math.floor((E2_GRIP as f64) * ui.winDensity + 0.5) as i32, E2_GRIP);
}

function e2Clamp(v: i32, lo: i32, hi: i32): i32 {
  return Math.max(Math.min(v, hi), lo);
}

// 境目 1 つ。押してドラッグしている間は、マウスの位置（vertical なら x、そうでなければ y）を返す。触っていなければ -1。
// ダブルクリックなら -2。
function e2Grip(ui: mut UkCtx, label: string, r: UkRect, vertical: bool, color: u32, hot: u32): i32 {
  const h = ukBehavior(mut ui, ukId(ui, label), r, false);
  if (h.hover || h.held) {
    ukSetCursor(mut ui, vertical ? UK_CURSOR_RESIZE_EW : UK_CURSOR_RESIZE_NS);
  }
  // 線（触っている間は accent の 2px）
  const c = h.held ? hot : color;
  const t = h.held || h.hover ? 2 : 1;
  if (vertical) {
    ukDrawRect(mut ui, ukRect(r.x + (r.w - 1) / 2 - t / 2, r.y, t, r.h), c);
  } else {
    ukDrawRect(mut ui, ukRect(r.x, r.y + (r.h - 1) / 2 - t / 2, r.w, t), c);
  }
  if (h.dbl) {
    return -2;
  }
  if (h.held) {
    return vertical ? ui.inp.mx : ui.inp.my;
  }
  return -1;
}

// 窓の大きさから配置を決める。境目は部品より先に呼ぶ（境目の当たりを先に取る）。
export function e2Layout(ui: mut UkCtx, kit: E2Kit, v: mut E2View, W: i32, H: i32): E2Lay {
  const s = kit.scale;
  const topH = thPxAt(TH_SIZE_TOP_BAR, s);
  const sbH = thPxAt(TH_SIZE_STATUS_BAR, s);
  const railW = thPxAt(TH_SIZE_RAIL, s);
  const bodyY = topH;
  const bodyH = Math.max(H - topH - sbH, 1);
  // タイムラインの高さ（最小 200、最大 本体の 75%。上の段がモニターの最小を割らないように）
  const tlMin = thPxAt(TH_SIZE_PANEL_MIN_TIMELINE_H, s);
  const tlMax = Math.floor((bodyH as f32) * TH_SIZE_PANEL_MAX_TIMELINE_RATIO) as i32;
  const monMinH = thPxAt(TH_SIZE_PANEL_MIN_MONITOR_H, s);
  let tlH = Math.floor((bodyH as f32) * v.tlFrac + 0.5) as i32;
  tlH = e2Clamp(tlH, tlMin, Math.max(Math.min(tlMax, bodyH - monMinH), tlMin));
  const upperH = Math.max(bodyH - tlH, 0);
  // 左の欄と右の列（窓が狭ければ、モニターの最小を守るまで右の列 → 左の欄の順に畳む）
  const monMinW = thPxAt(TH_SIZE_PANEL_MIN_MONITOR_W, s);
  let lw = v.leftOpen ? thPxAt(e2Clamp(v.leftW, TH_SIZE_PANEL_MIN_LEFT, TH_SIZE_PANEL_MAX_LEFT), s) : 0;
  let rw = v.rightOpen ? thPxAt(e2Clamp(v.rightW, TH_SIZE_PANEL_MIN_RIGHT, TH_SIZE_PANEL_MAX_RIGHT), s) : 0;
  if (W - railW - lw - rw < monMinW) {
    lw = 0;
  }
  if (W - railW - lw - rw < monMinW) {
    rw = 0;
  }
  const monX = railW + lw;
  const monW = Math.max(W - monX - rw, 0);
  let L: E2Lay = {
    top: ukRect(0, 0, W, topH),
    rail: ukRect(0, bodyY, railW, upperH),
    left: ukRect(railW, bodyY, Math.max(lw - 1, 0), upperH),
    mon: ukRect(monX, bodyY, monW, upperH),
    right: ukRect(W - rw + 1, bodyY, Math.max(rw - 1, 0), upperH),
    tl: ukRect(0, bodyY + upperH + 1, W, Math.max(tlH - 1, 0)),
    status: ukRect(0, H - sbH, W, sbH),
  };
  // 境目（左の欄 | モニター、モニター | 右の列、上の段 ／ タイムライン）
  const line = kit.th.c.line;
  const gw = e2GripW(ui);
  const hot = kit.th.c.accent;
  if (lw > 0) {
    const g = e2Grip(mut ui, "##e2-split-left", ukRect(monX - 1 - gw, bodyY, gw * 2 + 1, upperH), true, line, hot);
    if (g == -2) {
      v.leftW = TH_SIZE_PANEL_DEFAULT_LEFT;
    } else if (g >= 0) {
      v.leftW = e2Clamp(Math.floor(((g - railW) as f32) / s + 0.5) as i32, TH_SIZE_PANEL_MIN_LEFT, TH_SIZE_PANEL_MAX_LEFT);
    }
  }
  if (rw > 0) {
    const g = e2Grip(mut ui, "##e2-split-right", ukRect(W - rw - gw, bodyY, gw * 2 + 1, upperH), true, line, hot);
    if (g == -2) {
      v.rightW = TH_SIZE_PANEL_DEFAULT_RIGHT;
    } else if (g >= 0) {
      v.rightW = e2Clamp(Math.floor(((W - g) as f32) / s + 0.5) as i32, TH_SIZE_PANEL_MIN_RIGHT, TH_SIZE_PANEL_MAX_RIGHT);
    }
  }
  const g = e2Grip(mut ui, "##e2-split-tl", ukRect(0, bodyY + upperH - gw, W, gw * 2 + 1), false, line, hot);
  if (g == -2) {
    v.tlFrac = TH_SIZE_PANEL_DEFAULT_TIMELINE_RATIO;
  } else if (g >= 0) {
    const nh = e2Clamp(bodyY + bodyH - g, tlMin, Math.max(Math.min(tlMax, bodyH - monMinH), tlMin));
    v.tlFrac = (nh as f32) / (bodyH as f32);
  }
  return L;
}
