// 合成のワークスペースの「カメラと 3D」の担当のファイル（docs/design/comp.md）。
// 関数の形（引数と返すもの）は変えず、中身だけを書く。状態は v.wcomp.cam（wcomp_state.um の自分の struct）に足す。
// どの関数も「描いて出来事を返す」: .mzc は直接書かず、MoEvent（MO_E_OP の ops など）を返すと ws_comp.um 側が当てる。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wcomp で始める。
import { UkCtx } from "../ui/kit/core.um";
import { UkRect } from "../ui/kit/base.um";
import { MoEvent } from "../workspaces/motion/mo_core.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";
import { WcompVw, WcompGeo, WcompOut, wcompOut } from "./wcomp_state.um";

// 道具の入口（道具の帯で「カメラ」を選んでいる間、毎フレーム、部品を描く前に呼ぶ。ビューアの上の層・vw.area の切り取りの中）。
// 押し・ドラッグをここで取り、.mzc を変えるときは MO_E_OP（途中は MO_E_PREVIEW）を返す。
export function wcompToolCamera(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, vw: WcompVw): MoEvent[] {
  return [];
}

// レイヤーの一覧のいちばん上の、カメラの行（project の camera.* / light.*）。y から描き、使った高さを返す（カメラが無ければ 0）。
// 開いたら camera.* のプロパティの行も描く。
export function wcompRowsCamera(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, g: WcompGeo, y: i32): WcompOut {
  return wcompOut(0);
}

// レイヤーの一覧で、開いたレイヤー ci（ed.project.clips の番号）の「3D（z・回転 rx / ry・アンカー）」の行を y から下に描く（g は一覧の形）。
// 使った高さを返す（行が無ければ 0）。左の欄に名前と値、右の時間の欄にキーフレームの印（wcompTimeX）。
export function wcompRows3d(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, g: WcompGeo, ci: i32, y: i32): WcompOut {
  return wcompOut(0);
}

// 効果のコントロールの「3D とカメラ」の節の中身（見出しは wcomp_fx.um が描く）。r の x・y・幅に描き、使った高さを返す（h は無視してよい）。
// ci が -1 のとき（レイヤーを選んでいない）は、シーンのカメラ・ライトを出してよい（0 なら何も出さない）。
// 0 を返すと、wcomp_fx.um が「準備中」と出す。
export function wcompFxCamera(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, ci: i32, r: UkRect): WcompOut {
  return wcompOut(0);
}
