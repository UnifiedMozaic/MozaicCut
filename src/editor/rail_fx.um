// 左の欄の「効果」（レールの 効果）: 組み込みの効果（src/gen/plugins.um の一覧）を、分類の札と探す欄つきで並べる。
// Premiere のエフェクト、Resolve のエフェクトライブラリにあたる。
//
// - 行には効果の見本の絵（小さな絵に、その効果を実際に掛けたもの）・名前・説明を出す。
// - 付け方は 2 つ: 行をタイムラインのクリップへ運ぶ（rail_frame.um の railFrame が受ける）か、行を選んで［適用］
//   （ダブルクリックでもよい）で、選んでいるクリップに付ける。
// - 付けるのは .mzc のクリップの行の効果のキー（set <クリップ> <効果>=<値>）。値は見本の絵と同じ強さ。
//   強さはインスペクタの効果の節で変えられる。音のクリップには付けない（登録表の効果はどれも映像の効果）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は railFx で始める。
import { UkCtx, ukDrawRect, UK_FONT_SEMIBOLD } from "../ui/kit/core.um";
import { UkRect, ukRect, ukFixed } from "../ui/kit/base.um";
import { ukBeginScrollH, ukEndScroll, ukScrollY } from "../ui/kit/layout.um";
import { thPx } from "../gen/theme.um";
import { FxReg, FX_PARAMS } from "../gen/plugins.um";
import { transCount, transNameAt, transDocAt, transBuiltinLabel, transIsWasm, transApply } from "../effects/transition.um";
import { KIND_AUDIO } from "../engine/project.um";
import { sub, splitLines, parseNum, isNan } from "../engine/text.um";
import { splitArgs } from "../engine/ops.um";
import { E2, e2ApplyOps, e2SetStatus, e2ReloadPlugins } from "./e2_state.um";
import { E2Kit, E2View, e2ViewSync } from "./e2_view.um";
import { e2PanelHead } from "./e2_chrome.um";
import { WrlState, WRL_DRAG_FX, WRL_THUMB_W, WRL_THUMB_H } from "./wrl_state.um";
import {
  railUiSearch, railUiChip, railUiChipW, railUiRow, railUiDrag, railUiButton, railUiButtonW, railUiText, railUiMatch,
  railUiSel, railUiRef, railUiSm, railUiXs, railUiPad, railUiId,
} from "./rail_ui.um";

// 分類（0 はすべて）
export const RAIL_FX_CAT_ALL: i32 = 0;
export const RAIL_FX_CAT_COLOR: i32 = 1;
export const RAIL_FX_CAT_BLUR: i32 = 2;
export const RAIL_FX_CAT_KEY: i32 = 3;
export const RAIL_FX_CAT_STYLE: i32 = 4;
export const RAIL_FX_CAT_PRESET: i32 = 5;
export const RAIL_FX_CAT_TRANS: i32 = 6;
export const RAIL_FX_CAT_PLUGIN: i32 = 7;
export const RAIL_FX_CAT_OTHER: i32 = 8;

function railFxCatName(c: i32): string {
  const names: string[] = ["すべて", "色", "ぼかし・シャープ", "キー", "スタイライズ", "プリセット", "トランジション", "プラグイン", "その他"];
  return names[c as usize].clone();
}

// 外部の効果プリセット（presets/fx.mzc）。複数の効果や色調整（grade.*）を組み合わせた 1 行をクリップに適用できる。
export struct RailFxPreset {
  name: string;
  note: string;
  tokens: string[];
}

export function railFxPresets(): RailFxPreset[] {
  let out: RailFxPreset[] = [];
  out.push({
    name: "映画風（ティール＆オレンジ）", note: "暗部を青緑、明部を暖色にして周辺を締める",
    tokens: ["grade.lift=\"-0.03 0.01 0.04 0\"", "grade.gain=\"1.06 1.0 0.92 1.0\"", "contrast=1.15", "vignette=0.35"],
  });
  out.push({
    name: "ノスタルジー（フィルム調）", note: "粒子とセピア、周辺減光で懐かしさを出す",
    tokens: ["sepia=0.45", "grain=0.22", "vignette=0.45", "contrast=1.1"],
  });
  out.push({
    name: "VHS レトロテープ", note: "走査線と色収差、粒子で古いビデオ風にする",
    tokens: ["chromatic=5", "scanline=0.35", "grain=0.2", "sat=0.85"],
  });
  out.push({
    name: "サイバーパンク発光", note: "色相をマゼンタ寄りに回し、ネオンのグローと色収差を足す",
    tokens: ["hue=-25", "sat=1.4", "glow=0.8", "glow.radius=8", "chromatic=4"],
  });
  out.push({
    name: "ドリーミー（幻想ソフト）", note: "ふんわり発光させて彩度を少し上げる",
    tokens: ["glow=0.9", "glow.radius=12", "glow.cutoff=0.35", "sat=1.15"],
  });
  out.push({
    name: "コミック（漫画プリント）", note: "ポスタライズと網点、輪郭で漫画の印刷風にする",
    tokens: ["posterize=5", "halftone=6", "halftone.contrast=0.55"],
  });
  railFxLoadCustom(mut out);
  return out;
}

// presets/fx.mzc の 1 行を RailFxPreset にする。
// 書き方: fx name="プリセット名" note="説明" glow=0.8 chromatic=4 ...
function railFxParsePresetLine(out: mut RailFxPreset[], line0: string): void {
  const words = splitArgs(line0);
  if (words.length == 0 || words[0] != "fx") {
    return;
  }
  let name = "";
  let note = "外部プリセット（presets/fx.mzc）";
  let tokens: string[] = [];
  for (let i: usize = 1; i < words.length; i++) {
    const w = words[i].clone();
    if (w.length > 0 && w[0] == 35) {
      break;
    }
    let eq = -1;
    for (let j: usize = 0; j < w.length; j++) {
      if (w[j] == 61) {
        eq = j as i32;
        break;
      }
    }
    if (eq < 0) {
      tokens.push(w);
      continue;
    }
    const k = sub(w, 0, eq as usize);
    const v = sub(w, (eq as usize) + 1, w.length);
    if (k == "name") {
      name = v;
    } else if (k == "note") {
      note = v;
    } else {
      let hasSpace = false;
      for (const b of v) {
        if (b == 32 || b == 9) {
          hasSpace = true;
        }
      }
      if (hasSpace) {
        tokens.push(`${k}="${v}"`);
      } else {
        tokens.push(`${k}=${v}`);
      }
    }
  }
  if (name == "" || tokens.length == 0) {
    return;
  }
  const item: RailFxPreset = { name: name.clone(), note, tokens };
  for (let i: usize = 0; i < out.length; i++) {
    if (out[i].name == name) {
      out[i] = item;
      return;
    }
  }
  out.push(item);
}

function railFxLoadCustom(out: mut RailFxPreset[]): void {
  const b = readFile("presets/fx.mzc");
  if (b == null) {
    return;
  }
  for (const ln of splitLines(b)) {
    railFxParsePresetLine(mut out, ln);
  }
}

// 効果の日本語の名前（登録表の名前から。知らない効果は登録表の名前のまま）
export function railFxLabel(e: i32, reg: FxReg): string {
  const n = reg.name(e);
  if (n == "blur") {
    return "ぼかし";
  } else if (n == "bright") {
    return "明るさ";
  } else if (n == "chromakey") {
    return "クロマキー";
  } else if (n == "chromatic") {
    return "色収差";
  } else if (n == "contrast") {
    return "コントラスト";
  } else if (n == "duotone") {
    return "デュオトーン";
  } else if (n == "edge") {
    return "輪郭抽出";
  } else if (n == "emboss") {
    return "エンボス";
  } else if (n == "glitch") {
    return "グリッチ";
  } else if (n == "glow") {
    return "グロー（発光）";
  } else if (n == "grain") {
    return "フィルム粒子";
  } else if (n == "gray") {
    return "白黒";
  } else if (n == "halftone") {
    return "ハーフトーン（網点）";
  } else if (n == "hue") {
    return "色相回転";
  } else if (n == "invert") {
    return "色の反転";
  } else if (n == "lumakey") {
    return "ルミナンスキー";
  } else if (n == "matteview") {
    return "アルファを見る";
  } else if (n == "mirror") {
    return "ミラー（鏡）";
  } else if (n == "motionblur") {
    return "方向ブラー";
  } else if (n == "pixelate") {
    return "モザイク";
  } else if (n == "posterize") {
    return "ポスタライズ";
  } else if (n == "sat") {
    return "彩度";
  } else if (n == "scanline") {
    return "走査線";
  } else if (n == "sepia") {
    return "セピア";
  } else if (n == "sharpen") {
    return "シャープ";
  } else if (n == "solarize") {
    return "ソラリゼーション";
  } else if (n == "threshold") {
    return "2 値化";
  } else if (n == "tint") {
    return "カラーフィルター";
  } else if (n == "vignette") {
    return "周辺減光";
  } else if (n == "wave") {
    return "波形ワープ";
  } else if (n == "exposure") {
    return "露出";
  } else if (n == "levels") {
    return "レベル補正";
  } else if (n == "vibrance") {
    return "自然な彩度";
  } else if (n == "temperature") {
    return "色温度";
  } else if (n == "filmfade") {
    return "色あせフィルム";
  }
  return n;
}

function railFxCat(e: i32, reg: FxReg): i32 {
  const n = reg.name(e);
  if (n == "bright" || n == "contrast" || n == "duotone" || n == "gray" || n == "hue" || n == "invert" ||
    n == "posterize" || n == "sat" || n == "sepia" || n == "solarize" || n == "threshold" || n == "tint" ||
    n == "exposure" || n == "levels" || n == "vibrance" || n == "temperature" || n == "filmfade") {
    return RAIL_FX_CAT_COLOR;
  }
  if (n == "blur" || n == "glow" || n == "motionblur" || n == "sharpen") {
    return RAIL_FX_CAT_BLUR;
  }
  if (n == "chromakey" || n == "lumakey" || n == "matteview") {
    return RAIL_FX_CAT_KEY;
  }
  if (n == "chromatic" || n == "edge" || n == "emboss" || n == "glitch" || n == "grain" || n == "halftone" ||
    n == "mirror" || n == "pixelate" || n == "scanline" || n == "vignette" || n == "wave") {
    return RAIL_FX_CAT_STYLE;
  }
  if (reg.isWasm(e)) {
    return RAIL_FX_CAT_PLUGIN;
  }
  return RAIL_FX_CAT_OTHER;
}

// 付けるときの最初の値（既定の値では何も変わらない効果は、見て分かる強さにする）。
export function railFxValue(e: i32, reg: FxReg): f64 {
  const n = reg.name(e);
  if (n == "bright") {
    return 0.2;
  } else if (n == "contrast") {
    return 1.4;
  } else if (n == "sat") {
    return 1.6;
  } else if (n == "exposure") {
    return 0.7;
  } else if (n == "levels") {
    return 0.1;
  } else if (n == "vibrance") {
    return 0.6;
  } else if (n == "temperature") {
    return 0.4;
  } else if (n == "filmfade") {
    return 0.6;
  }
  if (reg.paramCount(e) == 0) {
    return 1.0;
  }
  return reg.paramDefault(e, 0) as f64;
}

// 見本の絵に掛けるときの値（画素で測る引数は、小さな絵に合わせて縮める）
function railFxThumbParams(e: i32, reg: FxReg): f32[8] {
  let ps: f32[8];
  for (let k = 0; k < reg.paramCount(e) && k < FX_PARAMS; k++) {
    ps[k as usize] = reg.paramDefault(e, k);
  }
  const n = reg.name(e);
  if (reg.paramCount(e) > 0) {
    ps[0] = railFxValue(e, reg) as f32;
  }
  if (n == "pixelate") {
    ps[0] = 4.0;
  } else if (n == "blur") {
    ps[0] = 1.0;
  } else if (n == "motionblur") {
    ps[0] = 3.0;
  } else if (n == "glow") {
    ps[1] = 2.0;
  } else if (n == "chromatic") {
    ps[0] = 3.0;
  } else if (n == "halftone") {
    ps[0] = 4.0;
  } else if (n == "wave") {
    ps[0] = 3.0;
    ps[1] = 14.0;
  } else if (n == "glitch") {
    ps[0] = 5.0;
  } else if (n == "scanline") {
    ps[1] = 2.0;
  }
  return ps;
}

// 値を op に書く文字（整数ならそのまま、そうでなければ小数 2 桁まで。後ろの 0 は消す）
export function railFxNum(v: f64): string {
  if (Math.floor(v) == v && Math.abs(v) < 1.0e9) {
    return `${v as i64}`;
  }
  const s = ukFixed(v, 2);
  let n = s.length;
  while (n > 1 && s[n - 1] == 48) {
    n--;
  }
  if (n > 1 && s[n - 1] == 46) {
    n--;
  }
  let out: u8[] = [];
  for (let i: usize = 0; i < n; i++) {
    out.push(s[i]);
  }
  return stringFromBytes(out);
}

// ---- 見本の絵 ----

// 見本の元の絵: 上は空のグラデーション、左下は緑の布（クロマキー）、下の帯は暗い所（ルミナンスキー）、中央に人の肌の色の丸。
function railFxSample(x: i32, y: i32): f32[] {
  const W = WRL_THUMB_W as f32;
  const H = WRL_THUMB_H as f32;
  const fx = ((x as f32) + 0.5) / W;
  const fy = ((y as f32) + 0.5) / H;
  let r: f32 = 0.25 + 0.65 * fx;
  let g: f32 = 0.45 + 0.25 * fy;
  let b: f32 = 0.95 - 0.6 * fx;
  if (fy > 0.55 && fx < 0.35) {
    r = 0.1;
    g = 0.7;
    b = 0.3;
  }
  if (fy > 0.82) {
    r = 0.06;
    g = 0.05;
    b = 0.08;
  }
  const dx = fx - 0.58;
  const dy = (fy - 0.48) * H / W;
  if (dx * dx + dy * dy < 0.028) {
    r = 0.93;
    g = 0.72;
    b = 0.58;
  }
  return [r, g, b];
}

function railFxByte(v: f32): u32 {
  return Math.floor(Math.min(Math.max(v, 0.0), 1.0) * 255.0 + 0.5) as u32;
}

// プリセット pr のトークンから効果を順に掛け（見本の絵用）。
function railFxApplyPresetThumb(pr: RailFxPreset, layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, W: u32, H: u32, reg: FxReg): void {
  let order: i32[] = [];
  let vals: f32[] = [];
  for (const tok of pr.tokens) {
    let eq = -1;
    for (let j: usize = 0; j < tok.length; j++) {
      if (tok[j] == 61) {
        eq = j as i32;
        break;
      }
    }
    if (eq <= 0) {
      continue;
    }
    const k = sub(tok, 0, eq as usize);
    const v = parseNum(sub(tok, (eq as usize) + 1, tok.length));
    if (isNan(v)) {
      continue;
    }
    const fk = reg.findKey(k);
    if (fk.effect < 0 || fk.param < 0 || fk.param >= FX_PARAMS) {
      continue;
    }
    let idx = -1;
    for (let i: usize = 0; i < order.length; i++) {
      if (order[i] == fk.effect) {
        idx = i as i32;
        break;
      }
    }
    if (idx < 0) {
      idx = order.length as i32;
      order.push(fk.effect);
      const base = railFxThumbParams(fk.effect, reg);
      for (let m = 0; m < FX_PARAMS; m++) {
        vals.push(base[m as usize]);
      }
    }
    let fv = v as f32;
    const en = reg.name(fk.effect);
    if (fk.param == 0 && (en == "chromatic" || en == "motionblur" || en == "blur" || en == "pixelate" || en == "halftone")) {
      fv = Math.min(fv, 3.0);
    } else if (fk.param == 1 && en == "glow") {
      fv = Math.min(fv, 2.0);
    }
    vals[((idx * FX_PARAMS + fk.param) as usize)] = fv;
  }
  for (let i: usize = 0; i < order.length; i++) {
    let ps: f32[8];
    for (let m = 0; m < FX_PARAMS; m++) {
      ps[m as usize] = vals[i * (FX_PARAMS as usize) + (m as usize)];
    }
    reg.apply(order[i], mut layer, mut tmp, W, H, ps);
  }
}

// トランジション見本用の 2 枚目の絵（暖色の夕焼け）
function railFxSampleB(x: i32, y: i32): f32[] {
  const W = WRL_THUMB_W as f32;
  const H = WRL_THUMB_H as f32;
  const fx = ((x as f32) + 0.5) / W;
  const fy = ((y as f32) + 0.5) / H;
  let r: f32 = 0.92 - 0.18 * fy;
  let g: f32 = 0.42 + 0.35 * (1.0 - fy);
  let b: f32 = 0.22 + 0.15 * fx;
  if (fy > 0.72) {
    r = 0.16;
    g = 0.11;
    b = 0.18;
  }
  const dx = fx - 0.36;
  const dy = (fy - 0.42) * H / W;
  if (dx * dx + dy * dy < 0.022) {
    r = 1.0;
    g = 0.94;
    b = 0.72;
  }
  return [r, g, b];
}

// すべての効果・プリセット・トランジションの見本の絵を作る（初めの 1 回。数が変わったら作り直す）。
function railFxThumbs(st: mut WrlState, presets: RailFxPreset[], reg: FxReg): void {
  const n = reg.count();
  const npres = presets.length as i32;
  const ntr = transCount(reg.wasm);
  const total = n + npres + ntr;
  if (st.fxThumbN == total && st.fxThumb.length > 0) {
    return;
  }
  const W = WRL_THUMB_W;
  const H = WRL_THUMB_H;
  const np = (W * H) as u32;
  let out: u32[] = [];
  for (let e = 0; e < total; e++) {
    let layer = new Buffer<vec4<f32>>(np);
    let tmp = new Buffer<vec4<f32>>(np);
    for (let y = 0; y < H; y++) {
      for (let x = 0; x < W; x++) {
        const c = railFxSample(x, y);
        layer[(y * W + x) as usize] = vec4(c[0], c[1], c[2], 1.0);
      }
    }
    if (e < n) {
      reg.apply(e, mut layer, mut tmp, W as u32, H as u32, railFxThumbParams(e, reg));
    } else if (e < n + npres) {
      railFxApplyPresetThumb(presets[(e - n) as usize], mut layer, mut tmp, W as u32, H as u32, reg);
    } else {
      let layerB = new Buffer<vec4<f32>>(np);
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const cb = railFxSampleB(x, y);
          layerB[(y * W + x) as usize] = vec4(cb[0], cb[1], cb[2], 1.0);
        }
      }
      const ti = e - n - npres;
      transApply(transNameAt(ti, reg.wasm), reg.wasm, mut layer, layerB, mut tmp, W as u32, H as u32, 0.5, 0.0, 0.08, 0.0);
    }
    for (let y = 0; y < H; y++) {
      for (let x = 0; x < W; x++) {
        const c = layer[(y * W + x) as usize];
        // 透けた所は市松模様の上に重ねる（色はまっすぐなアルファ）
        let chk: f32 = 0.28;
        if ((x / 3 + y / 3) % 2 == 0) {
          chk = 0.42;
        }
        const a = Math.min(Math.max(c.w, 0.0), 1.0);
        const r = c.x * a + chk * (1.0 - a);
        const g = c.y * a + chk * (1.0 - a);
        const b = c.z * a + chk * (1.0 - a);
        out.push(0xff000000 | (railFxByte(r) << 16) | (railFxByte(g) << 8) | railFxByte(b));
      }
    }
  }
  st.fxThumb = out;
  st.fxThumbN = total;
}

// 効果またはプリセット slot の見本の絵を (x, y) に描く（1 画素を s×s の四角に）。
function railFxThumbDraw(ui: mut UkCtx, st: WrlState, slot: i32, x: i32, y: i32, s: i32): void {
  const W = WRL_THUMB_W;
  const H = WRL_THUMB_H;
  const base = (slot * W * H) as usize;
  if (base + ((W * H) as usize) > st.fxThumb.length) {
    return;
  }
  for (let yy = 0; yy < H; yy++) {
    // 同じ色が続く所は 1 つの四角にまとめる
    let x0 = 0;
    while (x0 < W) {
      const c = st.fxThumb[base + ((yy * W + x0) as usize)];
      let x1 = x0 + 1;
      while (x1 < W && st.fxThumb[base + ((yy * W + x1) as usize)] == c) {
        x1++;
      }
      ukDrawRect(mut ui, ukRect(x + x0 * s, y + yy * s, (x1 - x0) * s, s), c);
      x0 = x1;
    }
  }
}

// ---- 付ける ----

function railFxItemLabel(e: i32, presets: RailFxPreset[], reg: FxReg): string {
  if (e >= 2000) {
    const ti = e - 2000;
    return transBuiltinLabel(transNameAt(ti, reg.wasm));
  }
  if (e >= 1000 && ((e - 1000) as usize) < presets.length) {
    return presets[(e - 1000) as usize].name.clone();
  }
  return railFxLabel(e, reg);
}

function railFxItemDoc(e: i32, presets: RailFxPreset[], reg: FxReg): string {
  if (e >= 2000) {
    return transDocAt(e - 2000, reg.wasm);
  }
  if (e >= 1000 && ((e - 1000) as usize) < presets.length) {
    return presets[(e - 1000) as usize].note.clone();
  }
  return reg.doc(e);
}

// 効果（0..）、プリセット（1000..）、トランジション（2000..）を、クリップ clips に付ける。付けたら true。
export function railFxApply(ed: mut E2, v: mut E2View, e: i32, clips: i32[]): bool {
  const presets = railFxPresets();
  const isTrans = e >= 2000;
  const isPreset = !isTrans && e >= 1000;
  if (!isTrans && !isPreset && (e < 0 || e >= ed.fxReg.count())) {
    return false;
  }
  if (isPreset && ((e - 1000) as usize) >= presets.length) {
    return false;
  }
  if (isTrans && (e - 2000 < 0 || e - 2000 >= transCount(ed.fxReg.wasm))) {
    return false;
  }
  const label = railFxItemLabel(e, presets, ed.fxReg);
  if (clips.length == 0) {
    e2SetStatus(mut ed, `「${label}」を付けるクリップを選んでください（タイムラインのクリップへ運んでも付けられます）`, true);
    return false;
  }
  let ops: string[] = [];
  let skipped = 0;
  let first = "";
  for (const ci of clips) {
    if (ci < 0 || (ci as usize) >= ed.project.clips.length) {
      continue;
    }
    const kind = ed.project.clips[ci as usize].kind;
    const ref = railUiRef(ed.project.clips[ci as usize]);
    if (kind == KIND_AUDIO) {
      skipped++;
      continue;
    }
    if (first == "") {
      first = ref.clone();
    }
    if (isTrans) {
      const tname = transNameAt(e - 2000, ed.fxReg.wasm);
      if (ed.project.clips[ci as usize].xfade > 0.0 || ed.project.clips[ci as usize].fadeIn > 0.0) {
        ops.push(`set ${ref} trans=${tname}`);
      } else {
        ops.push(`set ${ref} xfade=0.8 trans=${tname}`);
      }
    } else if (isPreset) {
      let s = `set ${ref}`;
      for (const tok of presets[(e - 1000) as usize].tokens) {
        s = `${s} ${tok}`;
      }
      ops.push(s);
    } else {
      ops.push(`set ${ref} ${ed.fxReg.name(e)}=${railFxNum(railFxValue(e, ed.fxReg))}`);
    }
  }
  if (ops.length == 0) {
    e2SetStatus(mut ed, `「${label}」は映像の効果なので、音のクリップには付けられません`, true);
    return false;
  }
  if (!e2ApplyOps(mut ed, ops)) {
    return false;
  }
  let who = first.clone();
  if (ops.length > 1) {
    who = `${first} ほか ${ops.length - 1} 個`;
  }
  let note = "（強さはインスペクタで変えられます）";
  if (skipped > 0) {
    note = `（音のクリップ ${skipped} 個には付けていません）`;
  }
  e2SetStatus(mut ed, `「${label}」を ${who} に付けました${note}`, false);
  return true;
}

// 並べる効果・プリセット・トランジション（1000.. はプリセット、2000.. はトランジション）
function railFxVisible(st: WrlState, presets: RailFxPreset[], reg: FxReg): i32[] {
  let out: i32[] = [];
  if (st.fxCat != RAIL_FX_CAT_PRESET && st.fxCat != RAIL_FX_CAT_TRANS) {
    for (let e = 0; e < reg.count(); e++) {
      if (st.fxCat != RAIL_FX_CAT_ALL && st.fxCat != RAIL_FX_CAT_PLUGIN && railFxCat(e, reg) != st.fxCat) {
        continue;
      }
      if (st.fxCat == RAIL_FX_CAT_PLUGIN && !reg.isWasm(e)) {
        continue;
      }
      if (!railUiMatch(st.fxQuery, railFxLabel(e, reg)) && !railUiMatch(st.fxQuery, reg.name(e)) && !railUiMatch(st.fxQuery, reg.doc(e))) {
        continue;
      }
      out.push(e);
    }
  }
  if (st.fxCat == RAIL_FX_CAT_ALL || st.fxCat == RAIL_FX_CAT_PRESET) {
    for (let pi: usize = 0; pi < presets.length; pi++) {
      if (!railUiMatch(st.fxQuery, presets[pi].name) && !railUiMatch(st.fxQuery, presets[pi].note)) {
        continue;
      }
      out.push(1000 + (pi as i32));
    }
  }
  if (st.fxCat == RAIL_FX_CAT_ALL || st.fxCat == RAIL_FX_CAT_TRANS || st.fxCat == RAIL_FX_CAT_PLUGIN) {
    const ntr = transCount(reg.wasm);
    for (let ti = 0; ti < ntr; ti++) {
      if (st.fxCat == RAIL_FX_CAT_PLUGIN && !transIsWasm(ti, reg.wasm)) {
        continue;
      }
      const tn = transNameAt(ti, reg.wasm);
      const tl = transBuiltinLabel(tn);
      const td = transDocAt(ti, reg.wasm);
      if (!railUiMatch(st.fxQuery, tl) && !railUiMatch(st.fxQuery, tn) && !railUiMatch(st.fxQuery, td)) {
        continue;
      }
      out.push(2000 + ti);
    }
  }
  return out;
}

export function railFx(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, r: UkRect): void {
  const body = e2PanelHead(mut ui, kit, r, "効果");
  const th = kit.th;
  const presets = railFxPresets();
  railFxThumbs(mut v.rl, presets, ed.fxReg);
  const pad = railUiPad(kit);
  const x = body.x + pad;
  const w = body.w - pad * 2;
  const ch = ui.theme.ctrlH;
  let y = body.y + th.space[2];
  // 探す欄 + ［再読み込み］ボタン（plugins/ フォルダへ追加・削除した .mzplug を即反映）
  const relLbl = "再読込";
  const relW = railUiButtonW(mut ui, relLbl);
  const qW = Math.max(w - relW - thPx(th, 4), thPx(th, 60));
  v.rl.fxQuery = railUiSearch(mut ui, ukRect(x, y, qW, ch), "効果を探す", "railFxQ", v.rl.fxQuery);
  if (railUiButton(mut ui, ukRect(x + qW + thPx(th, 4), y, relW, ch), `${relLbl}##railFxReload`, true)) {
    e2ReloadPlugins(mut ed);
    v.rl.fxThumb.clear();
    v.rl.fxThumbN = 0;
    v.rl.fxSel = -1;
    e2ViewSync(ed, mut kit, mut v);
  }
  y = y + ch + th.space[2];
  // 分類の札（入らなければ折り返す）
  let cx = x;
  const chipH = thPx(th, 22);
  const gap = thPx(th, 4);
  let used: i32[] = [0];
  for (let c = 0; c < RAIL_FX_CAT_OTHER; c++) {
    const name = railFxCatName(c);
    const cw = railUiChipW(mut ui, kit, name);
    if (cx > x && cx + cw > x + w) {
      cx = x;
      y = y + chipH + gap;
    }
    if (railUiChip(mut ui, kit, cx, y, name, v.rl.fxCat == c, railUiId(ui, "railFxCat", c), mut used)) {
      v.rl.fxCat = c;
    }
    cx = cx + used[0] + gap;
  }
  y = y + chipH + th.space[2];
  const sel = railUiSel(ed, v);
  // 下の帯（選んだ効果と［適用］）の場所
  const footH = th.space[2] * 2 + thPx(th, 20) + ch;
  const foot = ukRect(body.x, body.y + body.h - footH, body.w, footH);
  // 一覧
  const vis = railFxVisible(v.rl, presets, ed.fxReg);
  const rowH = thPx(th, 40);
  const list = ukRect(body.x, y, body.w, Math.max(foot.y - y, 0));
  ukBeginScrollH(mut ui, "railFxList", list, (vis.length as i32) * rowH);
  const sy = ukScrollY(mut ui, "railFxList");
  let apply = -1;
  const nFx = ed.fxReg.count();
  for (let i: usize = 0; i < vis.length; i++) {
    const e = vis[i];
    const rr = ukRect(x - thPx(th, 4), list.y - sy + (i as i32) * rowH, w + thPx(th, 8), rowH - thPx(th, 2));
    if (rr.y + rr.h < list.y || rr.y > list.y + list.h) {
      continue;
    }
    const h = railUiRow(mut ui, kit, rr, railUiId(ui, "railFxRow", e), v.rl.fxSel == e);
    if (h.pressed) {
      v.rl.fxSel = e;
    }
    if (h.dbl) {
      apply = e;
    }
    const itemLabel = railFxItemLabel(e, presets, ed.fxReg);
    const itemDoc = railFxItemDoc(e, presets, ed.fxReg);
    railUiDrag(mut ui, kit, h, WRL_DRAG_FX, e, `効果: ${itemLabel}`);
    const s = thPx(th, 2);
    const tht = WRL_THUMB_H * s;
    const slot = e >= 2000 ? nFx + (presets.length as i32) + (e - 2000) : (e >= 1000 ? nFx + (e - 1000) : e);
    railFxThumbDraw(mut ui, v.rl, slot, rr.x + thPx(th, 4), rr.y + (rr.h - tht) / 2, s);
    const tx = rr.x + thPx(th, 4) + WRL_THUMB_W * s + thPx(th, 8);
    const txw = rr.x + rr.w - tx - thPx(th, 4);
    railUiText(mut ui, ukRect(tx, rr.y + thPx(th, 3), txw, thPx(th, 18)), itemLabel, railUiSm(kit), th.c.text1, UK_FONT_SEMIBOLD);
    railUiText(mut ui, ukRect(tx, rr.y + thPx(th, 20), txw, thPx(th, 16)), itemDoc, railUiXs(kit), v.rl.fxSel == e ? th.c.text1 : th.c.text3, 0);
  }
  if (vis.length == 0) {
    railUiText(mut ui, ukRect(x, list.y + thPx(th, 8), w, thPx(th, 18)), "当てはまる効果がありません", railUiSm(kit), th.c.text3, 0);
  }
  ukEndScroll(mut ui);
  // 下の帯
  ukDrawRect(mut ui, ukRect(foot.x, foot.y, foot.w, th.borderHairline), th.c.line);
  let fy = foot.y + th.space[2];
  let target = "クリップを選ぶと、ここから付けられます";
  if (sel.length == 1) {
    target = `付ける先: ${railUiRef(ed.project.clips[sel[0] as usize])}`;
  } else if (sel.length > 1) {
    target = `付ける先: 選んだクリップ ${sel.length} 個`;
  }
  railUiText(mut ui, ukRect(x, fy, w, thPx(th, 18)), target, railUiXs(kit), sel.length > 0 ? th.c.text2 : th.c.text3, 0);
  fy = fy + thPx(th, 20);
  let name = "効果を選ぶか、クリップへ運びます";
  const ntr = transCount(ed.fxReg.wasm);
  if ((v.rl.fxSel >= 0 && v.rl.fxSel < nFx) || (v.rl.fxSel >= 1000 && ((v.rl.fxSel - 1000) as usize) < presets.length) ||
    (v.rl.fxSel >= 2000 && v.rl.fxSel - 2000 < ntr)) {
    name = railFxItemLabel(v.rl.fxSel, presets, ed.fxReg);
  }
  const bl = "適用";
  const bw = railUiButtonW(mut ui, bl);
  railUiText(mut ui, ukRect(x, fy, w - bw - thPx(th, 8), ch), name, railUiSm(kit), th.c.text1, 0);
  const ready = v.rl.fxSel >= 0 && sel.length > 0;
  if (railUiButton(mut ui, ukRect(x + w - bw, fy, bw, ch), `${bl}##railFxApply`, ready)) {
    apply = v.rl.fxSel;
    if (apply < 0) {
      e2SetStatus(mut ed, "付ける効果を一覧から選んでください", true);
    }
  }
  if (apply >= 0) {
    v.rl.fxSel = apply;
    railFxApply(mut ed, mut v, apply, sel);
  }
}
