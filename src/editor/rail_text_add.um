// .mzc の色（0xRRGGBBAA）を描く色（0xAARRGGBB）に直す。
function railTextArgb(rgba: u32): u32 {
  return (rgba >> 8) | ((rgba & 255) << 24);
}

// 外部のプリセットファイル（presets/text.mzc・presets/custom.mzc）の 1 行を RailTextKind にする。
// 書き方:
//   text "文字" name="ひな形名" note="説明" dur=3 size=64 color=ffffff ...
//   shape star name="ひな形名" note="説明" dur=3 points=5 r=140 ...
//   particles name="ひな形名" note="説明" dur=4 emit=point ...
// 同じ name が既にあれば上書きし、なければ末尾に足す。
function railTextParseLine(out: mut RailTextKind[], line0: string): void {
  const words = splitArgs(line0);
  if (words.length == 0) {
    return;
  }
  const head = words[0].clone();
  if (head != "text" && head != "shape" && head != "particles") {
    return;
  }
  let posText = "";
  let name = "";
  let note = "外部プリセット（presets/text.mzc）";
  let dur = 3.0;
  let color: u32 = 0xffffffff;
  let outline: u32 = 0;
  let bg: u32 = 0;
  let size: i32 = 100;
  let place: i32 = 0;
  if (head == "shape") {
    place = 3;
    color = 0xff40e0ff;
  } else if (head == "particles") {
    place = 4;
    color = 0xffffcc66;
  }
  let keys = "";
  for (let i: usize = 1; i < words.length; i++) {
    const w = words[i].clone();
    if (w.length > 0 && w[0] == 35) {
      break;
    }
    let eq = -1;
    for (let j: usize = 0; j < w.length; j++) {
      if (w[j] == 61) {
        eq = j as i32;
        break;
      }
    }
    if (eq < 0) {
      if (posText == "" && (head == "text" || head == "shape")) {
        posText = w;
      } else {
        if (keys != "") {
          keys = keys + " ";
        }
        keys = keys + w;
      }
      continue;
    }
    const k = sub(w, 0, eq as usize);
    const v = sub(w, (eq as usize) + 1, w.length);
    if (k == "name") {
      name = v;
      continue;
    }
    if (k == "note") {
      note = v;
      continue;
    }
    if (k == "dur") {
      const d = parseNum(v);
      if (!isNan(d) && d > 0.0) {
        dur = d;
      }
      continue;
    }
    if (k == "at" || k == "track" || k == "id") {
      continue;
    }
    if (k == "color" || k == "fill" || k == "stroke") {
      const c = parseColor(v);
      if (c >= 0) {
        color = railTextArgb(c as u32);
      }
    } else if (k == "outline" || k == "color.end") {
      const c = parseColor(v);
      if (c >= 0) {
        outline = railTextArgb(c as u32);
      }
    } else if (k == "bg") {
      const c = parseColor(v);
      if (c >= 0) {
        bg = railTextArgb(c as u32);
      }
    } else if (k == "size" && head == "text") {
      const sz = parseNum(v);
      if (!isNan(sz) && sz > 0.0) {
        size = Math.min(Math.max((sz * 1.6) as i32, 48), 160);
      }
    } else if (k == "y" && head == "text") {
      const yv = parseNum(v);
      if (!isNan(yv) && yv < 0.0) {
        place = 1;
      }
    } else if (k == "x" && head == "text") {
      const xv = parseNum(v);
      if (!isNan(xv) && xv > 0.0) {
        place = 2;
      }
    }
    if (keys != "") {
      keys = keys + " ";
    }
    keys = keys + k + "=" + railUiQuote(v);
  }
  if (name == "") {
    if (posText != "") {
      name = posText.clone();
    } else {
      return;
    }
  }
  const item: RailTextKind = {
    clipKind: head, name: name.clone(), note, text: posText, dur, keys, color, outline, bg, size, place,
  };
  for (let i: usize = 0; i < out.length; i++) {
    if (out[i].name == name) {
      out[i] = item;
      return;
    }
  }
  out.push(item);
}

function railTextLoadCustom(out: mut RailTextKind[]): void {
  const files: string[] = ["presets/text.mzc", "presets/custom.mzc"];
  for (const f of files) {
    const b = readFile(f);
    if (b == null) {
      continue;
    }
    for (const ln of splitLines(b)) {
      railTextParseLine(mut out, ln);
    }
  }
}

// ひな形 i の長さ（秒。運んでいる間の影に使う）。
export function railTextDur(i: i32): f64 {
  const kinds = railTextKinds();
  if (i < 0 || (i as usize) >= kinds.length) {
    return 3.0;
  }
  return kinds[i as usize].dur;
}

// 時刻 t から長さ dur の間、映像のトラック track にクリップ（音でない）があるか。
function railTextBusy(ed: E2, track: i32, t: f64, dur: f64): bool {
  for (const c of ed.project.clips) {
    if (c.kind == KIND_AUDIO || c.track != track) {
      continue;
    }
    if (c.at < t + dur - 0.0005 && c.at + c.dur > t + 0.0005) {
      return true;
    }
  }
  return false;
}

// 置く映像のトラック: いちばん上の映像のトラックが時刻 t〜t+dur で空いていればそこ、埋まっていればその 1 つ上
// （下の映像を隠さないように、いつも上に重ねる）。
function railTextTrack(ed: E2, t: f64, dur: f64): i32 {
  let top = 0;
  for (const c of ed.project.clips) {
    if (c.kind != KIND_AUDIO && c.track > top) {
      top = c.track;
    }
  }
  if (!railTextBusy(ed, top, t, dur)) {
    return top;
  }
  return top + 1;
}

// ひな形 i を時刻 t に置く（track が負なら空いているいちばん上の映像のトラック）。置いたら true で、そのクリップを選ぶ。
export function railTextAdd(ed: mut E2, v: mut E2View, i: i32, t0: f64, track0: i32): bool {
  const kinds = railTextKinds();
  if (i < 0 || (i as usize) >= kinds.length) {
    return false;
  }
  const iu = i as usize;
  const k = kinds[iu].name.clone();
  const ck = kinds[iu].clipKind.clone();
  const dur = kinds[iu].dur;
  const t = Math.max(t0, 0.0);
  let track = track0;
  if (track < 0) {
    track = railTextTrack(ed, t, dur);
  }
  const at = tlOpTime(v.tl, t);
  let op = `add ${ck}`;
  if (ck == "text") {
    op = `${op} ${railUiQuote(kinds[iu].text)}`;
  } else if (ck == "shape" && kinds[iu].text != "") {
    op = `${op} ${kinds[iu].text}`;
  }
  op = `${op} at=${at} dur=${dur} track=${track}`;
  if (kinds[iu].keys != "") {
    op = `${op} ${kinds[iu].keys}`;
  }
  const n0 = ed.project.clips.length;
  const ops: string[] = [op];
  if (!e2ApplyOps(mut ed, ops)) {
    return false;
  }
  // 足したクリップを選ぶ（同じトラックの同じ時刻に始まるもののうち、行がいちばん後ろのもの）
  let wantKind = KIND_TEXT;
  if (ck == "shape") {
    wantKind = KIND_SHAPE;
  } else if (ck == "particles") {
    wantKind = KIND_PARTICLES;
  }
  let found = -1;
  let line = -1;
  let ci = 0;
  for (const c of ed.project.clips) {
    if (c.kind == wantKind && c.track == track && Math.abs(c.at - t) < 0.02 && c.line > line) {
      found = ci;
      line = c.line;
    }
    ci++;
  }
  if (found >= 0 && ed.project.clips.length > n0) {
    railUiSelect(mut v, found);
  }
  e2SetStatus(mut ed, `「${k}」を ${tlTc(v.tl, t)} の V${track + 1} に足しました（見た目はインスペクタで変えられます）`, false);
  return true;
}
