// 文字のひな形の表と、ひな形を再生ヘッドなどの時刻に置く処理（rail_text.um の文字の欄、rail_frame.um の運んで置く処理、
// e2c_clip.um の「タイトルを足す」コマンドが使う）。e2_chrome.um を読まないので、コマンドの表からも読める。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は railText で始める。
import { KIND_TEXT, KIND_SHAPE, KIND_PARTICLES, KIND_AUDIO } from "../engine/project.um";
import { sub, splitLines, parseNum, parseColor, isNan } from "../engine/text.um";
import { splitArgs } from "../engine/ops.um";
import { tlOpTime, tlTc } from "../ui/timeline/tl_model.um";
import { E2, e2ApplyOps, e2SetStatus } from "./e2_state.um";
import { E2View } from "./e2_view.um";
import { railUiQuote, railUiSelect } from "./rail_ui.um";

// ひな形の 1 つ。clipKind は "text"（既定）・"shape"・"particles"。
// text が "" でないときは行の 2 番目に置く（text なら文字の内容、shape なら形の種類）。keys は後ろに付けるキー（at・dur・track は置くときに足す）。
export struct RailTextKind {
  clipKind: string;
  name: string;
  note: string;
  text: string;
  dur: f64;
  keys: string;
  // 見本の絵の描き方: 文字の色・縁の色（0 はなし）・帯の色（0 はなし）・大きさ（1080 の高さでの画素）・置く所（0 中央、1 下、2 左下、3 図形、4 パーティクル）
  color: u32;
  outline: u32;
  bg: u32;
  size: i32;
  place: i32;
}

