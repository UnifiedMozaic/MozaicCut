// 文字のひな形の表と、ひな形を再生ヘッドなどの時刻に置く処理（rail_text.um の文字の欄、rail_frame.um の運んで置く処理、
// e2c_clip.um の「タイトルを足す」コマンドが使う）。e2_chrome.um を読まないので、コマンドの表からも読める。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は railText で始める。
import { KIND_TEXT, KIND_AUDIO } from "../engine/project.um";
import { tlOpTime, tlTc } from "../ui/timeline/tl_model.um";
import { E2, e2ApplyOps, e2SetStatus } from "./e2_state.um";
import { E2View } from "./e2_view.um";
import { railUiQuote, railUiSelect } from "./rail_ui.um";

// ひな形の 1 つ。keys は add text の後ろに付けるキー（at・dur・track は置くときに足す）。
export struct RailTextKind {
  name: string;
  note: string;
  text: string;
  dur: f64;
  keys: string;
  // 見本の絵の描き方: 文字の色・縁の色（0 はなし）・帯の色（0 はなし）・大きさ（1080 の高さでの画素）・置く所（0 中央、1 下、2 左下）
  color: u32;
  outline: u32;
  bg: u32;
  size: i32;
  place: i32;
}

export function railTextKinds(): RailTextKind[] {
  let o: RailTextKind[] = [];
  o.push({
    name: "大きな題", note: "画面の中央に大きく", text: "タイトル", dur: 3.0,
    keys: "size=96 color=ffffff outline=000000 outlinew=4 shadow=00000099 fade=0.3", color: 0xffffffff, outline: 0xff000000,
    bg: 0, size: 150, place: 0,
  });
  o.push({
    name: "テロップ（強調）", note: "黄色の太い縁どり", text: "ここがポイント！", dur: 2.5,
    keys: "size=64 color=ffe14d outline=202020 outlinew=6 shadow=00000099 fade=0.2", color: 0xffffe14d, outline: 0xff202020,
    bg: 0, size: 110, place: 0,
  });
  o.push({
    name: "下の帯の名前", note: "左下に名前と肩書き", text: "山田 太郎　撮影担当", dur: 4.0,
    keys: "x=60 y=-90 size=34 color=ffffff bg=000000b0 pad=14 fade=0.25", color: 0xffffffff, outline: 0, bg: 0xb0000000,
    size: 64, place: 2,
  });
  o.push({
    name: "字幕", note: "下の中央、縁どりの白", text: "ここに字幕が入ります", dur: 3.0,
    keys: "y=-50 size=40 color=ffffff outline=000000 outlinew=3", color: 0xffffffff, outline: 0xff000000, bg: 0, size: 70,
    place: 1,
  });
  o.push({
    name: "字幕（帯つき）", note: "下の中央、半透明の帯", text: "ここに字幕が入ります", dur: 3.0,
    keys: "y=-50 size=36 color=ffffff bg=00000099 pad=10", color: 0xffffffff, outline: 0, bg: 0x99000000, size: 64, place: 1,
  });
  o.push({
    name: "クレジット", note: "中央に小さく、ゆっくり出す", text: "撮影 山田　編集 佐藤", dur: 4.0,
    keys: "size=30 color=dddddd fade=0.8", color: 0xffdddddd, outline: 0, bg: 0, size: 60, place: 0,
  });
  return o;
}

// ひな形 i の長さ（秒。運んでいる間の影に使う）。
export function railTextDur(i: i32): f64 {
  const kinds = railTextKinds();
  if (i < 0 || (i as usize) >= kinds.length) {
    return 3.0;
  }
  return kinds[i as usize].dur;
}

// 時刻 t から長さ dur の間、映像のトラック track にクリップ（音でない）があるか。
function railTextBusy(ed: E2, track: i32, t: f64, dur: f64): bool {
  for (const c of ed.project.clips) {
    if (c.kind == KIND_AUDIO || c.track != track) {
      continue;
    }
    if (c.at < t + dur - 0.0005 && c.at + c.dur > t + 0.0005) {
      return true;
    }
  }
  return false;
}

// 置く映像のトラック: いちばん上の映像のトラックが時刻 t〜t+dur で空いていればそこ、埋まっていればその 1 つ上
// （下の映像を隠さないように、いつも上に重ねる）。
function railTextTrack(ed: E2, t: f64, dur: f64): i32 {
  let top = 0;
  for (const c of ed.project.clips) {
    if (c.kind != KIND_AUDIO && c.track > top) {
      top = c.track;
    }
  }
  if (!railTextBusy(ed, top, t, dur)) {
    return top;
  }
  return top + 1;
}

// ひな形 i を時刻 t に置く（track が負なら空いているいちばん上の映像のトラック）。置いたら true で、そのクリップを選ぶ。
export function railTextAdd(ed: mut E2, v: mut E2View, i: i32, t0: f64, track0: i32): bool {
  const kinds = railTextKinds();
  if (i < 0 || (i as usize) >= kinds.length) {
    return false;
  }
  const k = kinds[i as usize].name.clone();
  const dur = kinds[i as usize].dur;
  const t = Math.max(t0, 0.0);
  let track = track0;
  if (track < 0) {
    track = railTextTrack(ed, t, dur);
  }
  const at = tlOpTime(v.tl, t);
  const op = `add text ${railUiQuote(kinds[i as usize].text)} at=${at} dur=${dur} track=${track} ${kinds[i as usize].keys}`;
  const n0 = ed.project.clips.length;
  const ops: string[] = [op];
  if (!e2ApplyOps(mut ed, ops)) {
    return false;
  }
  // 足したクリップを選ぶ（文字で、同じトラックの同じ時刻に始まるもののうち、行がいちばん後ろのもの）
  let found = -1;
  let line = -1;
  let ci = 0;
  for (const c of ed.project.clips) {
    if (c.kind == KIND_TEXT && c.track == track && Math.abs(c.at - t) < 0.02 && c.line > line) {
      found = ci;
      line = c.line;
    }
    ci++;
  }
  if (found >= 0 && ed.project.clips.length > n0) {
    railUiSelect(mut v, found);
  }
  e2SetStatus(mut ed, `「${k}」を ${tlTc(v.tl, t)} の V${track + 1} に足しました（文字と見た目はインスペクタで変えられます）`, false);
  return true;
}
