// キーの割り当ての配列（標準・Premiere Pro 互換・DaVinci Resolve 互換・0.x）を <home>/mozcut-keymap.txt に覚える。
// スタート画面の「ほかの編集ソフトから来た方へ: キーの割り当て」で選ぶと書き、編集画面（e2KitNew）が起動のときに読む。
// ファイルの中身は配列の ID（keymap.um の kmPresetId: standard / premiere / resolve / legacy）の 1 行。
// なければ・読めなければ標準。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wmisc で始める。
import { kmPresetId, kmPresetFromId, KM_PRESET_STANDARD, KM_PRESET_COUNT } from "../engine/keymap.um";

function wmiscKeymapFile(home: string): string {
  if (home.length == 0) {
    return "";
  }
  return `${home}/mozcut-keymap.txt`;
}

// 覚えている配列（KM_PRESET_*）。
export function wmiscKeymapRead(home: string): i32 {
  const f = wmiscKeymapFile(home);
  if (f.length == 0) {
    return KM_PRESET_STANDARD;
  }
  const b = readFile(f);
  if (b == null) {
    return KM_PRESET_STANDARD;
  }
  let id: u8[] = [];
  for (const c of b) {
    if (c == 10 || c == 13) {
      break;
    }
    id.push(c);
  }
  const p = kmPresetFromId(stringFromBytes(id));
  if (p < 0 || p >= KM_PRESET_COUNT) {
    return KM_PRESET_STANDARD;
  }
  return p;
}

// 配列 p（KM_PRESET_*）を覚える。書けたら true。
export function wmiscKeymapWrite(home: string, p: i32): bool {
  const f = wmiscKeymapFile(home);
  if (f.length == 0) {
    return false;
  }
  let out: u8[] = [];
  for (const c of `${kmPresetId(p)}\n`) {
    out.push(c);
  }
  return writeFile(f, out);
}
