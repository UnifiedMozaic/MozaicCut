// 配線（インスペクタ）の状態: 無効にした効果（.mzc から消して、値をここで覚えているもの）。
// E2Kit.wi に入れる（wire_inspector.um だけが書き換える）。E2Kit から読むので、このファイルは e2_* を読まない。
//
// .mzc には効果を「無効」にする書き方がまだないので、無効にした効果は行から消し、値をここに覚えておく。
// インスペクタの中身を作り直したら、wireInspectorPrep が insAddDisabledFx で戻す（無効の効果として見せる）。
// 覚えているのは編集画面を開いているあいだだけ（閉じると無効にした効果は消える）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wi / Wi で始める。

// 無効にした効果 1 つ。ref はクリップ（ID か @行番号）、at は効果の並びの位置。
export struct WiOff {
  ref: string;
  name: string;
  vals: f64[];
  at: i32;
}

export struct WiState {
  off: WiOff[];
}

export function wiStateNew(): WiState {
  return { off: [] };
}
