// 新しい編集画面（v0.2）の状態: 開いているプロジェクト（.mzc の本文・読んだ Project・診断・素材）と、
// 取り消しの履歴、再生のエンジンへの頼み。画面の部品の状態は e2_view.um の E2View が持つ。
//
// 名前の空間は全ファイルで 1 つなので、このフォルダの名前はすべて e2 / E2 / E2_ で始める（配線のファイルは wire）。
import { splitLines, sub } from "../engine/text.um";
import { e2wPre, e2wDesc } from "./e2_words.um";
import { Project, Probe, Diag, parseProjectReg, readProbes, emptyProject, KIND_VIDEO, KIND_IMAGE, KIND_AUDIO } from "../engine/project.um";
import { loadMediaFor, reloadMedia, mediaUsesCache, releaseMedia } from "../engine/render.um";
import { MediaSource, MEDIA_OPEN_FAST, mediaProbeSources, mediaProbeFile, mediaRemember, mediaSourcePath } from "../engine/media.um";
import { ffEnabled } from "../engine/ffmpeg.um";
import { Font, projectFont, loadFont } from "../effects/text/ttf.um";
import { ApMeter, apMeterNone } from "../engine/audioplay.um";
import { runOpsReg, splitArgs } from "../engine/ops.um";
import { FxReg, fxRegDiscover, fxRegSetPreviewTimeout } from "../gen/plugins.um";

// 再生のエンジンへの頼み（E2.pbq）。入力の処理（配線のファイル）が積み、e2_clock.um の e2ClockApply が順に渡す。
export const E2_PB_TOGGLE: i32 = 1;   // 再生 ／ 一時停止
export const E2_PB_SEEK: i32 = 2;     // arg 秒へ
export const E2_PB_STEP: i32 = 3;     // arg コマ進める（負なら戻す）
export const E2_PB_J: i32 = 4;
export const E2_PB_K: i32 = 5;
export const E2_PB_L: i32 = 6;
export const E2_PB_PLAY: i32 = 7;     // arg の速さで再生（負なら逆再生）
export const E2_PB_PAUSE: i32 = 8;

// 取り消しの履歴の 1 つ。text は操作の前のファイルの中身、desc はその操作の説明。
export struct E2Undo {
  text: string;
  desc: string;
}

export struct E2 {
  path: string;
  cache: string;
  home: string;
  // 素材の展開を mozcut.mjs が受け持っているか（--managed か、キャッシュを指定して起動されたとき）
  managed: bool;
  text: string;
  crlf: bool;
  lines: string[];
  probeText: string;
  probes: Probe[];
  // FFmpeg の組み込みで調べた素材の情報（書き換えのたびに調べ直さないため。media.um の mediaProbeSources）
  probeKnown: Probe[];
  // 素材の欄に読み込んだだけの素材（タイムラインでは使っていないもの）。.mzc の「#pool "<素材>"」の注釈の行
  // （e2PoolLine）から e2Reparse が作り直す。素材の欄（e2_view.um）に並び、op を通すときは素材の情報として ed.probes に足して渡す
  imported: Probe[];
  project: Project;
  errors: Diag[];
  media: MediaSource[];
  // プレビューの文字のクリップのフォント（project の fontPath / fontIndex が変わったときだけ読み直す）
  pfont: Font;
  pfontLoaded: bool;
  pfontPath: string;
  pfontIndex: i32;
  // 読み直すたびに 1 増える（部品は、この版が変わったときだけ中身を作り直す）
  ver: i64;
  undo: E2Undo[];
  redo: E2Undo[];
  // 状態の帯の左の 1 文（直前の操作の結果）。statusErr なら誤りの色
  status: string;
  statusErr: bool;
  // 保存の状態（上の帯）。saveErr なら「保存できませんでした」
  saveErr: bool;
  lastPoll: f64;
  // 再生のエンジンへの頼み（E2_PB_* と、その値）
  pbq: i32[];
  pbqArg: f64[];
  // プロジェクトや素材が変わったので、再生のエンジンを合わせ直す必要がある
  pbStale: bool;
  // プレビューを描き直す
  previewDirty: bool;
  // 再生のエンジンから毎フレーム写す値（表示用）
  t: f64;
  frame: i64;
  // 全体のコマの数（再生のエンジンの pb.total）
  total: i64;
  playing: bool;
  speed: f64;
  // 終わる（メニューの「終わる」など）
  quit: bool;
  // 鳴らしている音の、見せているコマの範囲のメーターの値（e2ClockTick が毎フレーム入れる。鳴らしていなければ ok = false）。
  // 音のワークスペースのメーターが使う
  playMeter: ApMeter;
  // 組み込みと外部 .mzplug の効果の登録表（起動時に plugins-installed/ と <home>/plugins/ から読む）
  fxReg: FxReg;
}

export function e2Bytes(s: string): u8[] {
  let out: u8[] = [];
  for (const b of s) {
    out.push(b);
  }
  return out;
}

export function e2ReadText(path: string): string {
  const b = readFile(path);
  if (b == null) {
    return "";
  }
  return stringFromBytes(b);
}

function e2HasCr(s: string): bool {
  for (const b of s) {
    if (b == 13) {
      return true;
    }
  }
  return false;
}

// パスの最後の部分（区切りは / と \）。
export function e2BaseName(s: string): string {
  let start: usize = 0;
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 47 || s[i] == 92) {
      start = i + 1;
    }
  }
  return sub(s, start, s.length);
}

// 拡張子を除いたファイル名（「本編_v3.mzc」→「本編_v3」）。
export function e2StemName(s: string): string {
  const b = e2BaseName(s);
  let end = b.length;
  for (let i: usize = 0; i < b.length; i++) {
    if (b[i] == 46) {
      end = i;
    }
  }
  if (end == 0) {
    return b;
  }
  return sub(b, 0, end);
}

// プロジェクトのファイルのあるフォルダ（区切りがなければ "."）。
export function e2DirOf(path: string): string {
  let end: usize = 0;
  let found = false;
  for (let i: usize = 0; i < path.length; i++) {
    if (path[i] == 47 || path[i] == 92) {
      end = i;
      found = true;
    }
  }
  if (!found) {
    return ".";
  }
  return sub(path, 0, end);
}

// <名前>.mzc → <名前>.cache（mozcut.mjs の cacheDir と同じ）。
export function e2CacheFor(project: string): string {
  const dir = e2DirOf(project);
  return `${dir}/${e2StemName(project)}.cache`;
}

export function e2New(path: string, cache: string, home: string, managed: bool): E2 {
  let pdirs: string[] = [];
  if (home.length > 0) {
    pdirs.push(`${home}/plugins`);
  }
  const fxReg = fxRegDiscover(pdirs);
  fxRegSetPreviewTimeout(fxReg);
  let ed: E2 = {
    path: path.clone(), cache: cache.clone(), home: home.clone(), managed, text: e2ReadText(path), crlf: false, lines: [],
    probeText: e2ReadText(`${cache}/probe.txt`), probes: [], probeKnown: [], imported: [], project: emptyProject(), errors: [], media: [],
    pfont: loadFont("", 0), pfontLoaded: false, pfontPath: "", pfontIndex: 0, ver: 0, undo: [], redo: [], status: "",
    statusErr: false, saveErr: false, lastPoll: 0.0, pbq: [], pbqArg: [], pbStale: true, previewDirty: true, t: 0.0,
    frame: 0, total: 1, playing: false, speed: 0.0, quit: false, playMeter: apMeterNone(), fxReg,
  };
  e2Reparse(mut ed);
  if (ed.project.clips.length > 0) {
    e2SetStatus(mut ed, `${e2BaseName(path)} を開きました（クリップ ${ed.project.clips.length} 個）`, false);
  }
  return ed;
}

// ed.text を読み直す。誤りがあれば前のプロジェクトを使い続け、誤りを errors に入れる。
export function e2Reparse(ed: mut E2): void {
  let err: Diag[] = [];
  // 素材は FFmpeg の組み込みで調べ、probe.txt（予備の経路で mozcut.mjs が書いたもの）は予備にする。
  // 同じ呼び出しに ed を mut と別の引数で渡せないので、文字列は写してから渡す
  const ptext = e2Bytes(ed.text);
  const ppath = ed.path.clone();
  const fallback = readProbes(`${ed.cache}/probe.txt`);
  ed.probes = mediaProbeSources(ptext, ppath, fallback, mut ed.probeKnown);
  const p = parseProjectReg(e2Bytes(ed.text), ed.probes, mut err, ed.fxReg);
  ed.crlf = e2HasCr(ed.text);
  ed.lines = splitLines(e2Bytes(ed.text));
  // クリップが 1 つもないこと（empty-timeline）は、作り始め・最後のクリップを消したあとの状態で、誤りにしない。
  // 新しい（空の）プロジェクトをそのまま使い、右下は「エラー 1」ではなく「タイムラインは空です」の案内にする
  // （e2_chrome.um）。書き出しはエンジンの検査で止まる
  let keep: Diag[] = [];
  while (err.length > 0) {
    const d = err.pop();
    if (!(d.code == "empty-timeline" && p.clips.length == 0)) {
      keep.push(d);
    }
  }
  while (keep.length > 0) {
    err.push(keep.pop());
  }
  let hasError = false;
  for (const d of err) {
    if (d.severity == "error" && d.code != "missing-source") {
      hasError = true;
    }
  }
  if (!hasError || ed.project.clips.length == 0) {
    ed.project = p;
    if (!ed.pfontLoaded || ed.project.fontPath != ed.pfontPath || ed.project.fontIndex != ed.pfontIndex) {
      ed.pfont = projectFont(ed.project.fontPath, ed.project.fontIndex);
      ed.pfontPath = ed.project.fontPath.clone();
      ed.pfontIndex = ed.project.fontIndex;
      ed.pfontLoaded = true;
    }
    // 印と開き方が同じ素材は前の展開器を使い続ける（書き換えのたびに開き直さない）。
    // 同じ呼び出しに ed を mut と別の引数で渡せないので、前の素材は取り出してから渡す（順は問わない）
    let old: MediaSource[] = [];
    while (ed.media.length > 0) {
      old.push(ed.media.pop());
    }
    ed.media = reloadMedia(ed.project, ed.cache, MEDIA_OPEN_FAST, mut old);
  }
  ed.errors = err;
  e2PoolRead(mut ed);
  if (ed.t > ed.project.duration) {
    ed.t = ed.project.duration;
  }
  ed.ver = ed.ver + 1;
  ed.pbStale = true;
  ed.previewDirty = true;
}

// ---- 素材の欄に読み込んだだけの素材（.mzc の #pool の行） ----
// タイムラインで使っていない素材は、.mzc の注釈の行「#pool "<素材>"」で残す（素材の名前の書き方は src= と同じ:
// プロジェクトのフォルダの中なら相対、外なら絶対）。注釈なので、エンジン・書き出し・診断・ops.um は読み飛ばし、
// 編集画面だけが読む。開き直しても素材の欄から消えない。

const E2_POOL_HEAD: string = "#pool ";

// 素材 src を残す #pool の行。
export function e2PoolLine(src: string): string {
  let out: u8[] = [];
  for (const b of E2_POOL_HEAD) {
    out.push(b);
  }
  out.push(34);
  for (const b of src) {
    if (b == 34 || b == 92) {
      out.push(92);
    }
    out.push(b);
  }
  out.push(34);
  return stringFromBytes(out);
}

// 行が #pool の行なら、その素材の名前（でなければ ""）。
export function e2PoolSrcOf(line: string): string {
  const n = E2_POOL_HEAD.length;
  if (line.length <= n || sub(line, 0, n) != E2_POOL_HEAD) {
    return "";
  }
  const w = splitArgs(sub(line, n, line.length));
  if (w.length == 0) {
    return "";
  }
  return w[0].clone();
}

function e2PoolLower(s: string): string {
  let out: u8[] = [];
  for (const b of s) {
    out.push(b >= 65 && b <= 90 ? b + 32 : b);
  }
  return stringFromBytes(out);
}

function e2PoolExt(s: string, exts: string[]): bool {
  const l = e2PoolLower(s);
  for (const e of exts) {
    if (l.length > e.length && sub(l, l.length - e.length, l.length) == e) {
      return true;
    }
  }
  return false;
}

// 1 つの素材の情報（調べた結果を ed.probeKnown に覚え、読み直すたびに調べ直さない。ファイルがなければ missing）。
function e2PoolProbe(ed: mut E2, src: string): Probe {
  const file = mediaSourcePath(ed.path, src);
  const audio = e2PoolExt(src, [".wav", ".mp3", ".m4a", ".aac", ".flac", ".ogg", ".opus"]);
  if (fileSize(file) == null) {
    return { path: src.clone(), dur: -1.0, hasVideo: !audio, hasAudio: audio, missing: true, looked: file.clone(), file: "", unreadable: "" };
  }
  if (!ffEnabled()) {
    return { path: src.clone(), dur: -1.0, hasVideo: !audio, hasAudio: audio, missing: false, looked: "", file: file.clone(), unreadable: "" };
  }
  for (const q of ed.probeKnown) {
    if (q.file == file) {
      let c = e2CopyProbe(q);
      c.path = src.clone();
      return c;
    }
  }
  const q = mediaProbeFile(src, file);
  mediaRemember(mut ed.probeKnown, q);
  return q;
}

// ed.imported を、本文の #pool の行から作り直す（e2Reparse が呼ぶ。前と同じ名前で、ファイルがあったものは調べ直さない）。
function e2PoolRead(ed: mut E2): void {
  let srcs: string[] = [];
  for (const l of ed.lines) {
    const s = e2PoolSrcOf(l);
    if (s == "") {
      continue;
    }
    let dup = false;
    for (const o of srcs) {
      if (o == s) {
        dup = true;
      }
    }
    if (!dup) {
      srcs.push(s);
    }
  }
  let out: Probe[] = [];
  for (const s of srcs) {
    let kept = false;
    for (const q of ed.imported) {
      if (q.path == s && !q.missing) {
        out.push(e2CopyProbe(q));
        kept = true;
        break;
      }
    }
    if (!kept) {
      out.push(e2PoolProbe(mut ed, s));
    }
  }
  ed.imported = out;
}

// 本文を行の並び lines に置き換えて保存し、取り消しの 1 つとして積む（op を通さない書き換え: #pool の行など）。
// 書けなければ状態の帯に理由を出して false（本文は変えない）。
export function e2WriteLines(ed: mut E2, lines: string[], desc: string): bool {
  const text = e2JoinLines(lines, ed.crlf);
  if (text == ed.text) {
    e2SetStatus(mut ed, desc, false);
    return true;
  }
  const old = ed.text.clone();
  if (!e2WriteText(mut ed, text)) {
    return false;
  }
  ed.undo.push({ text: old, desc: desc.clone() });
  ed.redo.clear();
  e2SetStatus(mut ed, desc, false);
  return true;
}

// 取り消しの積み（ed.undo）の mark 番目より後ろを、mark 番目の 1 つにまとめる（取り消し 1 回で mark の前の本文に戻る）。
// いくつかの書き換えで 1 つの操作にするとき（素材を落としたときの #pool の行とクリップの行など）。
export function e2UndoJoin(ed: mut E2, mark: usize, desc: string): void {
  if (ed.undo.length <= mark + 1) {
    return;
  }
  while (ed.undo.length > mark + 1) {
    ed.undo.pop();
  }
  ed.undo[mark].desc = desc.clone();
}

// 素材を素材の欄に残す（#pool の行を末尾に足す。すでに #pool の行があるものは足さない）。
// タイムラインで使っている素材にも行を書く。素材の欄は .mzc の #pool の行の順（読み込んだ順）に並び、
// クリップを消しても欄に残る（e2_view.um の e2BuildLibFrom）。
// 足した数を返す（0 なら書かない）。書けなければ -1。
export function e2PoolAdd(ed: mut E2, srcs: string[], desc: string): i32 {
  let lines: string[] = [];
  for (const l of ed.lines) {
    lines.push(l.clone());
  }
  let n = 0;
  for (const s of srcs) {
    let have = false;
    for (const l of lines) {
      if (e2PoolSrcOf(l) == s) {
        have = true;
      }
    }
    if (!have) {
      lines.push(e2PoolLine(s));
      n++;
    }
  }
  if (n == 0) {
    return 0;
  }
  return e2WriteLines(mut ed, lines, desc) ? n : -1;
}

// 素材を素材の欄から外す（その #pool の行を消す）。外した数を返す（書けなければ -1）。
export function e2PoolRemove(ed: mut E2, srcs: string[], desc: string): i32 {
  let lines: string[] = [];
  let n = 0;
  for (const l of ed.lines) {
    const s = e2PoolSrcOf(l);
    let drop = false;
    if (s != "") {
      for (const r of srcs) {
        if (r == s) {
          drop = true;
        }
      }
    }
    if (drop) {
      n++;
    } else {
      lines.push(l.clone());
    }
  }
  if (n == 0) {
    return 0;
  }
  return e2WriteLines(mut ed, lines, desc) ? n : -1;
}

// 素材の展開の結果が変わったか（大きさ・コマ数・展開した範囲・中身の印）。
function e2MediaChanged(a: MediaSource[], b: MediaSource[]): bool {
  if (a.length != b.length) {
    return true;
  }
  for (let i: usize = 0; i < a.length; i++) {
    if (a[i].ok != b[i].ok || a[i].w != b[i].w || a[i].h != b[i].h || a[i].frames != b[i].frames || a[i].inPt != b[i].inPt ||
      a[i].key != b[i].key) {
      return true;
    }
  }
  return false;
}

// 外での書き換えの取り消しの行の説明（e2Poll が積み、wire_ai.um が Claude Code の 1 文に置き換える）
export const E2_EXT_DESC: string = "ファイルが外で書き換えられました";

// ファイルと素材の変化を見る（ほかのエディタでの書き換え、mozcut.mjs の展開）。0.4 秒に 1 回。
export function e2Poll(ed: mut E2, now: f64): void {
  if (now - ed.lastPoll < 0.4) {
    return;
  }
  ed.lastPoll = now;
  const text = e2ReadText(ed.path);
  const probe = e2ReadText(`${ed.cache}/probe.txt`);
  if (text != ed.text && text.length > 0) {
    // 外での書き換え（ほかのエディタ・Claude Code の MCP サーバー）も取り消しの 1 行にする（Ctrl+Z で戻せる。
    // Claude Code の編集なら、wire_ai.um が .mzc.history の 1 文をこの行に付ける）
    ed.undo.push({ text: ed.text.clone(), desc: E2_EXT_DESC });
    ed.redo.clear();
    ed.text = text;
    ed.probeText = probe;
    e2Reparse(mut ed);
    e2SetStatus(mut ed, "ファイルが書き換わったので読み直しました", false);
    return;
  }
  if (probe != ed.probeText) {
    ed.probeText = probe;
    e2Reparse(mut ed);
    return;
  }
  // 展開したキャッシュを読む素材がなければ（FFmpeg の組み込みで直接開いている）、展開の変化を見に行かない
  if (!mediaUsesCache(ed.media)) {
    return;
  }
  let media = loadMediaFor(ed.project, ed.cache, MEDIA_OPEN_FAST);
  if (e2MediaChanged(ed.media, media)) {
    releaseMedia(mut ed.media);
    ed.media = media;
    ed.pbStale = true;
    ed.previewDirty = true;
  } else {
    releaseMedia(mut media);
  }
}

export function e2SetStatus(ed: mut E2, s: string, isErr: bool): void {
  ed.status = s.clone();
  ed.statusErr = isErr;
}

// ---- 再生のエンジンへの頼み ----

export function e2PbRequest(ed: mut E2, kind: i32, arg: f64): void {
  ed.pbq.push(kind);
  ed.pbqArg.push(arg);
}

// ---- 操作の適用・保存・取り消し（配線のファイルが使う） ----

function e2JoinLines(lines: string[], crlf: bool): string {
  let out: u8[] = [];
  for (const l of lines) {
    for (const b of l) {
      out.push(b);
    }
    if (crlf) {
      out.push(13);
    }
    out.push(10);
  }
  return stringFromBytes(out);
}

function e2WriteText(ed: mut E2, text: string): bool {
  if (!writeFile(ed.path, e2Bytes(text))) {
    ed.saveErr = true;
    e2SetStatus(mut ed, `${e2BaseName(ed.path)} に書き込めません（読み取り専用でないか、ほかのプログラムが開いていないかを確かめます）`, true);
    return false;
  }
  ed.saveErr = false;
  ed.text = text.clone();
  e2Reparse(mut ed);
  return true;
}

// op の文（"move pip 2"、"split clip_a 3.5" など。ops.um の書き方）をまとめて 1 つの操作として適用し、保存する。
// 取り消しの履歴には 1 つとして積む。成功したら true。失敗したら状態の帯に理由を出し、ファイルは変えない。
// ed.probes に、素材の欄に読み込んだだけの素材（ed.imported）のうち ed.probes にないものを足した並び（op に渡す）。
export function e2ProbesWithImported(ed: E2): Probe[] {
  let out: Probe[] = [];
  for (const q of ed.probes) {
    out.push(e2CopyProbe(q));
  }
  for (const q of ed.imported) {
    let found = false;
    for (const o of ed.probes) {
      if (o.path == q.path) {
        found = true;
      }
    }
    if (!found) {
      out.push(e2CopyProbe(q));
    }
  }
  return out;
}

function e2CopyProbe(q: Probe): Probe {
  return {
    path: q.path.clone(), dur: q.dur, hasVideo: q.hasVideo, hasAudio: q.hasAudio, missing: q.missing, looked: q.looked.clone(),
    file: q.file.clone(), unreadable: q.unreadable.clone(),
  };
}

export function e2ApplyOps(ed: mut E2, ops: string[]): bool {
  if (ops.length == 0) {
    return true;
  }
  let words: string[][] = [];
  for (const o of ops) {
    words.push(splitArgs(o));
  }
  const res = runOpsReg(ed.lines, e2ProbesWithImported(ed), words, ed.fxReg);
  // 知らせの文のために、指すクリップの名前を操作の前に取っておく（e2_words.um）
  const pre = e2wPre(ed.project, words[0]);
  if (!res.ok || res.results.length == 0) {
    let msg = "操作を適用できませんでした";
    if (res.results.length > 0) {
      const last = res.results.length - 1;
      msg = res.results[last].error.clone();
      if (res.results[last].hint != "") {
        msg = `${msg}（${res.results[last].hint}）`;
      }
    }
    e2SetStatus(mut ed, msg, true);
    return false;
  }
  let changed = false;
  for (const r of res.results) {
    if (r.changes.length > 0) {
      changed = true;
    }
  }
  let more = "";
  if (res.results.length > 1) {
    more = ` ほか ${res.results.length - 1} 個の操作`;
  }
  if (!changed) {
    e2SetStatus(mut ed, e2wDesc(pre, ed.project, words[0], res.results[0]) + more, false);
    return true;
  }
  const old = ed.text.clone();
  if (!e2WriteText(mut ed, e2JoinLines(res.lines, ed.crlf))) {
    return false;
  }
  const desc = e2wDesc(pre, ed.project, words[0], res.results[0]) + more;
  ed.undo.push({ text: old, desc: desc.clone() });
  ed.redo.clear();
  e2SetStatus(mut ed, desc, false);
  return true;
}

export function e2CanUndo(ed: E2): bool {
  return ed.undo.length > 0;
}

export function e2CanRedo(ed: E2): bool {
  return ed.redo.length > 0;
}

export function e2Undo(ed: mut E2): void {
  if (ed.undo.length == 0) {
    e2SetStatus(mut ed, "取り消せる操作がありません", false);
    return;
  }
  const u = ed.undo.pop();
  const cur = ed.text.clone();
  if (e2WriteText(mut ed, u.text)) {
    ed.redo.push({ text: cur, desc: u.desc.clone() });
    e2SetStatus(mut ed, `取り消しました: ${u.desc}`, false);
  }
}

export function e2Redo(ed: mut E2): void {
  if (ed.redo.length == 0) {
    e2SetStatus(mut ed, "やり直せる操作がありません", false);
    return;
  }
  const r = ed.redo.pop();
  const cur = ed.text.clone();
  if (e2WriteText(mut ed, r.text)) {
    ed.undo.push({ text: cur, desc: r.desc.clone() });
    e2SetStatus(mut ed, `やり直しました: ${r.desc}`, false);
  }
}

// クリップが素材のファイルを使うか。
export function e2UsesFile(kind: i32): bool {
  return kind == KIND_VIDEO || kind == KIND_IMAGE || kind == KIND_AUDIO;
}

// 診断の件数（[エラー, 警告]）。
export function e2DiagCounts(ed: E2): i32[] {
  let e = 0;
  let w = 0;
  for (const d of ed.errors) {
    if (d.severity == "error") {
      e++;
    } else {
      w++;
    }
  }
  return [e, w];
}
