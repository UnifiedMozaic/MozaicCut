// SHA-256（FIPS 180-4）。自動更新（upd_*.um）が、落としてきた zip を SHA256SUMS.txt と照らすのに使う。
// 少しずつ足せる形にして、受け取った分からその場で計算する（ファイルを読み直さない）。
//
//   let s = updShaNew();
//   updShaStr(mut s, "abc");           // httpRead の文字列など
//   updShaBytes(mut s, bytes, n);      // u8[] の先頭 n バイト
//   const hex = updShaHex(mut s);      // 小文字の 16 進 64 字。呼んだあとの s は使わない
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は updSha / UpdSha で始める。

export struct UpdSha {
  h: u32[];      // 途中の値（8 語）
  k: u32[];      // 丸めの定数（64 語）
  w: u32[];      // 1 ブロックの作業の場所（64 語）
  buf: u8[];     // まだ 64 バイトにならない分
  n: usize;      // buf に入っているバイト数
  total: u64;    // 足したバイト数の合計
}

function updShaK(): u32[] {
  return [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
  ];
}

export function updShaNew(): UpdSha {
  return {
    h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],
    k: updShaK(),
    w: new Array<u32>(64),
    buf: new Array<u8>(64),
    n: 0,
    total: 0,
  };
}

function updShaRotr(x: u32, n: u32): u32 {
  return (x >> n) | (x << (32 - n));
}

// buf の 64 バイトを 1 ブロックとして混ぜる。
function updShaBlock(s: mut UpdSha): void {
  for (let i: usize = 0; i < 16; i++) {
    const j = i * 4;
    s.w[i] = ((s.buf[j] as u32) << 24) | ((s.buf[j + 1] as u32) << 16) | ((s.buf[j + 2] as u32) << 8) | (s.buf[j + 3] as u32);
  }
  for (let i: usize = 16; i < 64; i++) {
    const a = s.w[i - 15];
    const b = s.w[i - 2];
    const s0 = updShaRotr(a, 7) ^ updShaRotr(a, 18) ^ (a >> 3);
    const s1 = updShaRotr(b, 17) ^ updShaRotr(b, 19) ^ (b >> 10);
    s.w[i] = s.w[i - 16] + s0 + s.w[i - 7] + s1;
  }
  let a = s.h[0];
  let b = s.h[1];
  let c = s.h[2];
  let d = s.h[3];
  let e = s.h[4];
  let f = s.h[5];
  let g = s.h[6];
  let h = s.h[7];
  for (let i: usize = 0; i < 64; i++) {
    const S1 = updShaRotr(e, 6) ^ updShaRotr(e, 11) ^ updShaRotr(e, 25);
    const ch = (e & f) ^ ((~e) & g);
    const t1 = h + S1 + ch + s.k[i] + s.w[i];
    const S0 = updShaRotr(a, 2) ^ updShaRotr(a, 13) ^ updShaRotr(a, 22);
    const maj = (a & b) ^ (a & c) ^ (b & c);
    const t2 = S0 + maj;
    h = g;
    g = f;
    f = e;
    e = d + t1;
    d = c;
    c = b;
    b = a;
    a = t1 + t2;
  }
  s.h[0] = s.h[0] + a;
  s.h[1] = s.h[1] + b;
  s.h[2] = s.h[2] + c;
  s.h[3] = s.h[3] + d;
  s.h[4] = s.h[4] + e;
  s.h[5] = s.h[5] + f;
  s.h[6] = s.h[6] + g;
  s.h[7] = s.h[7] + h;
}

function updShaByte(s: mut UpdSha, b: u8): void {
  s.buf[s.n] = b;
  s.n++;
  if (s.n == 64) {
    updShaBlock(mut s);
    s.n = 0;
  }
}

// 文字列のバイトを足す（httpRead の文字列は、UTF-8 でなくてもバイト列のまま）。
export function updShaStr(s: mut UpdSha, data: string): void {
  for (const b of data) {
    updShaByte(mut s, b);
  }
  s.total = s.total + (data.length as u64);
}

// data の先頭 count バイトを足す。
export function updShaBytes(s: mut UpdSha, data: u8[], count: usize): void {
  const n = Math.min(count, data.length);
  for (let i: usize = 0; i < n; i++) {
    updShaByte(mut s, data[i]);
  }
  s.total = s.total + (n as u64);
}

// 終わりの詰め物を足して、小文字の 16 進 64 字を返す。呼んだあとの s は使わない。
export function updShaHex(s: mut UpdSha): string {
  const bits = s.total * 8;
  updShaByte(mut s, 0x80);
  while (s.n != 56) {
    updShaByte(mut s, 0);
  }
  for (let i: u64 = 0; i < 8; i++) {
    updShaByte(mut s, ((bits >> ((7 - i) * 8)) & 255) as u8);
  }
  const digits = "0123456789abcdef";
  let out: u8[] = [];
  for (const w of s.h) {
    for (let i: u32 = 0; i < 8; i++) {
      const nib = (w >> ((7 - i) * 4)) & 15;
      out.push(digits[nib as usize]);
    }
  }
  return stringFromBytes(out);
}
