// 「出力」のワークスペース（ws_export.um）の状態。E2View.wex と E2Kit.wex に入れる（ws_export.um だけが書き換える。Kit は読むだけ）。
// E2View / E2Kit から読むので、このファイルは e2_* を読まない。
// 書き出しの中身（プリセット・範囲・確認・待ち行列）は、src/workspaces/export/ の WsxState をそのまま持つ。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wex / Wex で始める。
import { UeTheme, ueThemeFromTokens } from "../ui/export/theme.um";
import { UeCache, ueCacheNew } from "../ui/export/draw.um";
import { WsxState } from "../workspaces/export/types.um";
import { wsxOpen, wsxOpenArgs } from "../workspaces/export/state.um";

// 部品と配線が書き換える状態。
export struct WexState {
  // st を本物の .mzc で開いたか（はじめて「出力」を開いたときに開く。それまでの st は空の仮のもの）
  opened: bool;
  // 前のフレームに「出力」を出していたか（開き直したときに、イン・アウト・選んだクリップを写し直す）
  shown: bool;
  // 書き出しのワークスペースの中身（src/workspaces/export/types.um）
  st: WsxState;
  // プレビューの絵を MonCanvas に写したときの印（絵の版・キャンバスの版・四角）と、ukDrawImage の版（写し直すたびに増える）
  picSig: i64[];
  picKey: u32;
  // 状態の帯に出す書き出しの 1 文（"" なら出さない）、進み具合（0..1。負なら棒を出さない）、誤りの色にするか
  jobText: string;
  jobFrac: f32;
  jobErr: bool;
  // 終わった仕事の書き出したファイルの絶対パス（状態の帯の［パスをコピー］で写す。走っている間と失敗は ""）
  jobPath: string;
  // 終わった・失敗した仕事の id と、それを見つけた時刻（状態の帯に、しばらく結果を出してから消す）
  jobEndId: i32;
  jobEndAt: f64;
  // 確認の「場所を指定する」で、素材のファイルを選んでいる行（.mzc の行番号。選んでいなければ 0）
  relinkLine: i32;
}

// 読むだけのもの（tokens.json から作るテーマなど）。e2KitNew が 1 回だけ作る。
export struct WexKit {
  // tokens.json を読めたか
  tokensOk: bool;
  scale: f32;
  // 書き出しの画面（src/ui/export/）のテーマ
  th: UeTheme;
  // 書き出しの画面の文字の覚え（src/ui/export/draw.um。描くたびに書き足すだけの置き場なので、例外として ws_export.um が書き換える）
  cache: UeCache;
}

export function wexStateNew(): WexState {
  // 開くまでの仮の中身（.mzc の名前が空なので「読めない」という診断が 1 つ入るだけ。画面には出さない）
  return {
    opened: false, shown: false, st: wsxOpen(wsxOpenArgs("", "")), picSig: [], picKey: 0x40000000,
    jobText: "", jobFrac: -1.0, jobErr: false, jobPath: "", jobEndId: -1, jobEndAt: 0.0, relinkLine: 0,
  };
}

// js は tokens.json の本文（読めなければ ""）、scale は画面の倍率。
export function wexKitNew(js: string, scale: f32): WexKit {
  return { tokensOk: js.length > 0, scale, th: ueThemeFromTokens(js, scale), cache: ueCacheNew() };
}
