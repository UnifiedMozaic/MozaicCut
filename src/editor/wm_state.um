// 配線（モニター）の状態: 全画面・スクラブの前の速さ・再生中の描画の時間とコマ落ちの統計・ソースモニター・時刻の欄・
// 色を選ぶ窓。E2View.wm に入れる（wire_monitor.um と wcp_pick.um だけが書き換える）。E2View から読むので、このファイルは e2_* を読まない。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wm / Wm で始める。
import { UkRect, ukRect } from "../ui/kit/base.um";
import { MonState, monNew, MON_SOURCE } from "../ui/monitor/monitor.um";
import { Project, emptyProject } from "../engine/project.um";
import { MediaSource } from "../engine/media.um";
import { RenderCache, newRenderCache } from "../engine/render.um";
import { InsEvent } from "../ui/inspector/ins_model.um";

export struct WmState {
  // 全画面（モニターだけを窓いっぱいに出し、窓も全画面にする）。F11 で切り替え、Esc で戻る
  full: bool;
  // スクラブを始めたときの速さ（再生中だったら、放したあと同じ速さで再生し直す。止まっていたら 0）
  resume: f64;
  // 再生中の 1 コマの描画（renderFrameFrom と縮小）の時間（秒）: 直前・合計・最大・数
  rLast: f64;
  rSum: f64;
  rMax: f64;
  rN: i64;
  // 再生中の 1 フレーム全体（入力から画面に出して先読みと合流するまで）の時間（秒）
  fSum: f64;
  fMax: f64;
  // 止まっているあいだの 1 フレームの時間（試し用。最初の 10 フレームは数えない。再生ヘッドを動かすときの引っかかりを見る）
  sSum: f64;
  sMax: f64;
  sN: i64;
  fN: i64;
  // 再生のエンジンの統計を写したもの（見せたコマ・飛ばしたコマ・うちコマ落ち）
  shown: i64;
  skipped: i64;
  dropped: i64;
  // プレビューを合成している実行先（"GPU" か "CPU"。"" ならまだ調べていない。wireMonEngineSync が決める）
  engine: string;

  // ---- ソースモニター（素材の欄でダブルクリックした素材を開く） ----
  // ソースのモニターの部品の状態（プログラムは E2View.mon）。1 つのときも、ソースのタブはこちらで描く
  smon: MonState;
  // 開いている素材の ID（PoolMedia.id。"" なら何も開いていない）と、名前・種類（POOL_K_*）・長さ（秒）・大きさ
  srcId: string;
  srcName: string;
  srcKind: i32;
  srcDur: f64;
  srcW: i32;
  srcH: i32;
  // 素材だけを置いた小さなプロジェクトと、その素材（描画は render.um の renderFrame）
  srcProj: Project;
  srcMedia: MediaSource[];
  // 描画の置き場・合成するキャンバス（線形の RGBA）・モニターに渡す絵（0xAARRGGBB）。どれも 1 つだけ入れた配列
  // （同じ呼び出しに v を mut と別の引数で渡せないので、使う間だけ取り出す）
  srcRc: RenderCache[];
  srcCanvas: Buffer<vec4<f32>>[];
  srcCw: i32;
  srcCh: i32;
  srcImg: Buffer<u32>[];
  srcPw: i32;
  srcPh: i32;
  srcSerial: i64;
  // 絵に描いてあるコマ（-1 なら描き直す）
  srcDrawn: i64;
  // ソースの再生の時計: いまの時刻（秒）・速さ（0 なら止まっている。負なら逆再生）・前のフレームの時刻
  srcT: f64;
  srcSpeed: f64;
  srcLast: f64;
  // スクラブを始めたときのソースの速さ
  srcResume: f64;
  // 2 つ並べたとき、キーをソースに渡すか（最後に押したモニター。素材を開いたときもソース）
  focusSrc: bool;
  // 素材を開いたフレーム（同じフレームの押しで focusSrc を戻さない）
  justOpened: bool;
  // ソースの絵を押して、まだ動かしていない（動かしたらタイムラインへのドラッグにする）
  dragArm: bool;

  // ---- 時刻の欄（モニターの時刻を押すと開く。打ち込んだ時刻へ飛ぶ） ----
  gotoOpen: bool;
  // ソースのモニターの時刻か（false ならプログラム）
  gotoSrc: bool;
  // 開いたフレーム（そのフレームに欄へフォーカスを移し、全部を選んだ形にする）
  gotoNew: bool;
  gotoText: string;
  // 欄を出すモニターの四角（その再生の帯の左に重ねる）
  gotoR: UkRect;

  // ---- 色を選ぶ窓（インスペクタの色の見本を押すと開く。wcp_pick.um） ----
  cpOpen: bool;
  // 変える色のキー（InsRow.colorKey）・開いたときの値（"#RRGGBB" か "#RRGGBBAA"）・不透明度の 2 桁（なければ ""）
  cpKey: string;
  cpOrig: string;
  cpAlpha: string;
  // 開いたときの宛先（インスペクタの mode と refs）。変わったら閉じる（ほかのクリップに書かない）
  cpRefKey: string;
  // 色相（0〜1）・彩度・明るさ
  cpH: f64;
  cpS: f64;
  cpV: f64;
  // HEX の欄の文字
  cpHex: string;
  // スポイト（次にモニターの絵を押すと、その画素の色を拾う）
  cpEye: bool;
  // 窓の左上（画面の座標。-1 なら開いたときに決める）
  cpX: i32;
  cpY: i32;
  // 値を変えた（プレビューを出した）か
  cpDirty: bool;
  // インスペクタの出来事として次のフレームに渡すもの（wireInspector の頭で、部品の出来事の前に足す）
  cpEvs: InsEvent[];
}

export function wmStateNew(): WmState {
  return {
    full: false, resume: 0.0, rLast: 0.0, rSum: 0.0, rMax: 0.0, rN: 0, fSum: 0.0, fMax: 0.0, fN: 0, sSum: 0.0, sMax: 0.0, sN: 0, shown: 0, skipped: 0,
    dropped: 0, engine: "",
    smon: monNew(MON_SOURCE), srcId: "", srcName: "", srcKind: 0, srcDur: 0.0, srcW: 0, srcH: 0, srcProj: emptyProject(),
    srcMedia: [], srcRc: [newRenderCache()], srcCanvas: [new Buffer<vec4<f32>>(1)], srcCw: 1, srcCh: 1, srcImg: [new Buffer<u32>(1)],
    srcPw: 1, srcPh: 1, srcSerial: 0, srcDrawn: -1, srcT: 0.0, srcSpeed: 0.0, srcLast: -1.0, srcResume: 0.0, focusSrc: false,
    justOpened: false, dragArm: false,
    gotoOpen: false, gotoSrc: false, gotoNew: false, gotoText: "", gotoR: ukRect(0, 0, 0, 0),
    cpOpen: false, cpKey: "", cpOrig: "", cpAlpha: "", cpRefKey: "", cpH: 0.0, cpS: 0.0, cpV: 0.0, cpHex: "", cpEye: false,
    cpX: -1, cpY: -1, cpDirty: false, cpEvs: [],
  };
}
