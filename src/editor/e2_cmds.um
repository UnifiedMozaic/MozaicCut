  e2CmdRow(mut o, "help.checkUpdate", H, "更新を確かめる", true, 0, true);
  e2CmdRow(mut o, "help.about", H, "MozaicCut について", false, 0, true);
  // メニューに出さないもの（コマンドの欄とキー）
  e2CmdRow(mut o, "play.toggle", N, "再生 ／ 停止", false, MO, false);
  e2CmdRow(mut o, "play.reverse", N, "逆再生（J）", false, 0, false);
  e2CmdRow(mut o, "play.stop", N, "停止（K）", false, 0, false);
  e2CmdRow(mut o, "play.forward", N, "再生（L）", false, 0, false);
  e2CmdRow(mut o, "playhead.stepBack", N, "1 フレーム戻る", false, 0, false);
  e2CmdRow(mut o, "playhead.stepForward", N, "1 フレーム進む", false, 0, false);
  e2CmdRow(mut o, "playhead.step10Back", N, "10 フレーム戻る", false, 0, false);
  e2CmdRow(mut o, "playhead.step10Forward", N, "10 フレーム進む", false, 0, false);
