  e2CmdRow(mut o, "workspace.comp", V, "合成", false, 0, true);
  e2CmdRow(mut o, "workspace.color", V, "色", false, 0, true);
  e2CmdRow(mut o, "workspace.audio", V, "音", false, 0, true);
  e2CmdRow(mut o, "workspace.export", V, "出力", false, 0, true);
  e2CmdRow(mut o, "panel.inspector", V, "インスペクタ", true, 0, true);
  e2CmdRow(mut o, "panel.history", V, "履歴", false, 0, true);
  e2CmdRow(mut o, "panel.problems", V, "問題の一覧", false, 0, false);
  e2CmdRow(mut o, "text.reveal", V, "テキストで見る", false, CL, true);
