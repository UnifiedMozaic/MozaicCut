  e2CmdRow(mut o, "playhead.forward1s", N, "1 秒進む", false, 0, false);
  e2CmdRow(mut o, "playhead.start", N, "先頭へ", false, 0, false);
  e2CmdRow(mut o, "playhead.end", N, "末尾へ", false, 0, false);
  e2CmdRow(mut o, "playhead.prevEdit", N, "前の編集点へ", false, 0, false);
  e2CmdRow(mut o, "playhead.nextEdit", N, "次の編集点へ", false, 0, false);
  e2CmdRow(mut o, "playhead.goto", N, "時刻へ移動…", false, 0, true);
  return o;
}

// つないだコマンドか（受け持ちのファイルに聞く）。
export function e2CmdReady(id: string): bool {
  return e2cFileReady(id) || e2cEditReady(id) || e2cClipReady(id) || e2cSeqReady(id) || e2cMarkerReady(id) ||
    e2cViewReady(id) || e2cHelpReady(id) || wsrcCmdReady(id);
}

// 表を作る（最初の 1 回。つないだかどうかはビルドで決まるので、そのときに決めておく）。
export function e2CmdBuild(v: mut E2View): void {
  if (v.cm.built) {
    return;
  }
  let t = e2CmdTable();
  for (let i: usize = 0; i < t.length; i++) {
    t[i].ready = e2CmdReady(t[i].id);
  }
  v.cm.cmds = t;
  v.cm.built = true;
}

// コマンドを実行する。実行したら true（空の ID・つないでいないコマンドは false）。
export function e2CmdRun(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, id: string): bool {
  if (id == "") {
    return false;
  }
  if (e2cFileRun(mut ui, mut ed, mut kit, mut v, id)) {
    return true;
  }
  if (e2cEditRun(mut ui, mut ed, mut kit, mut v, id)) {
    return true;
  }
  if (e2cClipRun(mut ui, mut ed, mut kit, mut v, id)) {
    return true;
  }
  if (e2cSeqRun(mut ui, mut ed, mut kit, mut v, id)) {
    return true;
  }
  if (e2cMarkerRun(mut ui, mut ed, mut kit, mut v, id)) {
    return true;
  }
  if (e2cViewRun(mut ui, mut ed, mut kit, mut v, id)) {
    return true;
  }
  if (e2cHelpRun(mut ui, mut ed, mut kit, mut v, id)) {
    return true;
  }
  if (wsrcCmdRun(mut ui, mut ed, mut kit, mut v, id)) {
    return true;
  }
  return false;
}

// キーの札（いまの割り当て。なければ ""）。
export function e2CmdKeyText(kit: E2Kit, id: string): string {
  return kmShortcutText(kit.keys, id, kit.isMac, KM_LAYOUT_JIS);
}

// ---- メニュー ----

// つないだ項目が 1 つでもあるメニュー（上の帯に並べるもの。E2_MENU_* の順）。
export function e2CmdMenusShown(v: mut E2View): i32[] {
  e2CmdBuild(mut v);
  let out: i32[] = [];
  for (let m = 0; m < E2_MENU_COUNT; m++) {
    let any = false;
    for (const c of v.cm.cmds) {
      if (c.menu == m && c.ready) {
        any = true;
      }
    }
    if (any) {
      out.push(m);
    }
  }
  return out;
}

// 開いているメニューの中身（ukMenu / ukBeginSubMenu の中で呼ぶ）。選んだコマンドの ID を返す（なければ ""）。
function e2CmdMenuItems(ui: mut UkCtx, kit: E2Kit, v: E2View, m: i32): string {
  let cmd = "";
  let n = 0;
  for (const c of v.cm.cmds) {
    if (c.menu != m || !c.ready) {
      continue;
    }
    if (c.sep && n > 0) {
      ukMenuSep(mut ui);
    }
    if (ukMenuItem(mut ui, c.label + "##" + c.id, e2CmdKeyText(kit, c.id))) {
      cmd = c.id.clone();
    }
    n++;
    // 「プロジェクトを開く…」の後に「最近のプロジェクト」のサブメニュー（e2c_file.um。選ぶと file.recent:<番号>）
    if (c.id == "file.open") {
      const rc = e2cFileRecentMenu(mut ui, v);
      if (rc != "") {
        cmd = rc;
      }
    }
  }
  return cmd;
}

// メニューの帯（四角 r に横に並べる）。選んだコマンドの ID を返す（なければ ""）。
export function e2CmdMenuBar(ui: mut UkCtx, kit: E2Kit, v: mut E2View, r: UkRect): string {
  const shown = e2CmdMenusShown(mut v);
  let cmd = "";
  ukBeginRowAt(mut ui, r, []);
  ukGap(mut ui, 0);
  for (const m of shown) {
    if (ukMenu(mut ui, e2CmdMenuName(m))) {
      const c = e2CmdMenuItems(mut ui, kit, v, m);
      if (c != "") {
        cmd = c;
      }
      ukEndMenu(mut ui);
    }
  }
  ukEndBox(mut ui);
  return cmd;
}

// 幅が足りないときの ≡ のメニューの中身（ukMenu の中で呼ぶ）: メニューを 1 つずつサブメニューにする。
export function e2CmdMenuNested(ui: mut UkCtx, kit: E2Kit, v: mut E2View): string {
  const shown = e2CmdMenusShown(mut v);
  let cmd = "";
  for (const m of shown) {
    if (ukBeginSubMenu(mut ui, e2CmdMenuName(m) + "##e2-nest")) {
      const c = e2CmdMenuItems(mut ui, kit, v, m);
      if (c != "") {
        cmd = c;
      }
      ukEndMenu(mut ui);
    }
  }
  return cmd;
}

// ---- コマンドの欄（Ctrl+K）と素材の欄に渡す一覧 ----

// つないだコマンドの番号（v.cm.cmds の番号。表の順）。
export function e2CmdReadyList(v: mut E2View): i32[] {
  e2CmdBuild(mut v);
  let out: i32[] = [];
  for (let i: usize = 0; i < v.cm.cmds.length; i++) {
    if (v.cm.cmds[i].ready) {
      out.push(i as i32);
    }
  }
  return out;
}

// 場所の種類 kind の右クリックのメニューに出す、つないだコマンドの番号。
export function e2CtxList(v: mut E2View, kind: i32): i32[] {
  e2CmdBuild(mut v);
  let out: i32[] = [];
  for (let i: usize = 0; i < v.cm.cmds.length; i++) {
    const ci = i as usize;
    if (v.cm.cmds[ci].ready && (v.cm.cmds[ci].ctx & kind) != 0) {
      out.push(i as i32);
    }
  }
  return out;
}

// 素材の欄の右クリックのメニューの下に足す項目を渡す（poolPanel の前に毎フレーム呼ぶ。選ぶと PoolEv.cmd に ID が来る）。
export function e2CtxPoolPrep(kit: E2Kit, v: mut E2View): void {
  const list = e2CtxList(mut v, E2_CTX_POOL);
  let ls: string[] = [];
  let ks: string[] = [];
  let cs: string[] = [];
  for (const i of list) {
    const ci = i as usize;
    ls.push(v.cm.cmds[ci].label.clone());
    ks.push(e2CmdKeyText(kit, v.cm.cmds[ci].id));
    cs.push(v.cm.cmds[ci].id.clone());
  }
  v.pool.ctxLabels = ls;
  v.pool.ctxKeys = ks;
  v.pool.ctxCmds = cs;
}

// ---- 右クリックのメニュー ----

// 場所の種類 kind の右クリックのメニューをマウスの所に開く（出す項目がなければ開かない）。
// clip・media は右クリックしたクリップ・素材の番号（なければ -1）、t はその所の時刻。
export function e2CtxOpen(ui: mut UkCtx, v: mut E2View, kind: i32, clip: i32, media: i32, t: f64): void {
  if (e2CtxList(mut v, kind).length == 0) {
    return;
  }
  v.cm.kind = kind;
  v.cm.clip = clip;
  v.cm.media = media;
  v.cm.t = t;
  ukOpenPopup(mut ui, ukId(ui, "##e2-ctx"), ui.inp.mx, ui.inp.my);
  ui.activeTook = true;
}

// タイムラインとモニターの右クリックを見て、その場所のメニューを開く（部品を描いたあとに毎フレーム呼ぶ）。
// クリップの上なら、そのクリップを選んでから開く（選んでいなければ、それだけを選ぶ。Premiere と同じ）。
// 素材の欄は、欄が自分の右クリックのメニューを持つので、ここでは開かない（e2CtxPoolPrep で項目を足す）。
export function e2CtxTake(ui: mut UkCtx, ed: E2, v: mut E2View, tl: UkRect, mon: UkRect): void {
  if ((ui.inp.pressed & 4) == 0) {
    return;
  }
  const mx = ui.inp.mx;
  const my = ui.inp.my;
  if (tl.h > 0 && ukInside(tl, mx, my)) {
    const ci = tlClipAt(mut v.tl, ed.project, tl, ui.theme.scale, mx, my);
    if (ci >= 0) {
      let has = false;
      for (const s of v.tl.sel) {
        if (s == ci) {
          has = true;
        }
      }
      if (!has) {
        v.tl.sel = [ci];
        tlSyncSel(mut v.tl);
      }
      e2CtxOpen(mut ui, mut v, E2_CTX_CLIP, ci, -1, ed.t);
    } else {
      // 隙間の上なら、その隙間を選んでから開く（メニューの［隙間を詰める］が効く）
      tlPickGapAt(mut v.tl, tl, ui.theme.scale, mx, my);
      e2CtxOpen(mut ui, mut v, E2_CTX_TIMELINE, -1, -1, ed.t);
    }
  } else if (v.workspace == E2_WS_EDIT && mon.w > 0 && mon.h > 0 && ukInside(mon, mx, my)) {
    e2CtxOpen(mut ui, mut v, E2_CTX_MONITOR, -1, -1, ed.t);
  }
}

// 開いている右クリックのメニューを描く（部品をすべて描いたあと）。選んだコマンドの ID を返す（なければ ""）。
export function e2CtxMenu(ui: mut UkCtx, kit: E2Kit, v: mut E2View): string {
  if (v.cm.kind == 0) {
    return "";
  }
  const id = ukId(ui, "##e2-ctx");
  if (!ukBeginPopup(mut ui, id, 200)) {
    v.cm.kind = 0;
    return "";
  }
  let cmd = "";
  let n = 0;
  const list = e2CtxList(mut v, v.cm.kind);
  for (const i of list) {
    const ci = i as usize;
    if (v.cm.cmds[ci].sep && n > 0) {
      ukMenuSep(mut ui);
    }
    if (ukMenuItem(mut ui, v.cm.cmds[ci].label + "##ctx-" + v.cm.cmds[ci].id, e2CmdKeyText(kit, v.cm.cmds[ci].id))) {
      cmd = v.cm.cmds[ci].id.clone();
    }
    n++;
  }
  ukEndPopup(mut ui);
  if (cmd != "") {
    v.cm.kind = 0;
  }
  return cmd;
}

// ---- キー ----

// 部品がまだ取っていないキーを、表のキーの割り当てで引いて実行する（部品の配線をすべて済ませたあとに毎フレーム呼ぶ）。
// 表で key が true・つないだコマンドだけ（部品がキーを取ったら ui.inp.keys の所が 0 になるので、二重には動かない）。
export function e2CmdKeys(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View): void {
  // 文字の入力中・ドラッグの最中（部品が押されたまま、タイムラインで運んでいる）は何もしない
  if (ui.wantText || ui.active != 0 || v.tl.drag != TL_DRAG_NONE) {
    return;
  }
  e2CmdBuild(mut v);
  for (let i: usize = 0; i < ui.inp.keys.length; i++) {
    const k = ui.inp.keys[i];
    if (k == 0) {
      continue;
    }
    const id = kmLookupEvent(kit.keys, k, ui.inp.keyMods[i], kit.isMac, KM_LAYOUT_JIS, []);
    if (id == "") {
      continue;
    }
    let hit = false;
    for (const c of v.cm.cmds) {
      if (c.id == id && c.key && c.ready) {
        hit = true;
      }
    }
    if (hit) {
      ui.inp.keys[i] = 0;
      e2CmdRun(mut ui, mut ed, mut kit, mut v, id);
    }
  }
}
