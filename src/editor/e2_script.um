// 試し用のキーの名前（edit2.um の --key）を uikit のキーに直す。
//   ctrl+k / shift+tab / alt+1 / enter / esc / tab / backspace / delete / left / right / up / down / home / end /
//   pgup / pgdn / space / f1〜f12 / 1 文字（英字は小文字にする）
import {
  UK_KEY_TAB, UK_KEY_ENTER, UK_KEY_ESC, UK_KEY_BACKSPACE, UK_KEY_DELETE, UK_KEY_LEFT, UK_KEY_RIGHT, UK_KEY_UP, UK_KEY_DOWN,
  UK_KEY_HOME, UK_KEY_END, UK_KEY_PGUP, UK_KEY_PGDN, UK_KEY_SPACE, UK_KEY_F, UK_KEY_CHAR, UK_MOD_SHIFT, UK_MOD_CTRL, UK_MOD_ALT,
} from "../ui/kit/core.um";
import { sub, parseNum } from "../engine/text.um";

function e2ScLower(s: string): string {
  let b: u8[] = [];
  for (const c of s) {
    if (c >= 65 && c <= 90) {
      b.push(c + 32);
    } else {
      b.push(c);
    }
  }
  return stringFromBytes(b);
}

// 「ctrl+shift+k」を [修飾キーの部分, キーの名前] に分ける（最後の + の後ろがキー。「ctrl++」は +）。
function e2ScSplit(s0: string): string[] {
  const s = e2ScLower(s0);
  let last: usize = 0;
  let found = false;
  for (let i: usize = 0; i + 1 < s.length; i++) {
    if (s[i] == 43) {
      last = i;
      found = true;
    }
  }
  if (!found) {
    return ["", s];
  }
  return [sub(s, 0, last + 1), sub(s, last + 1, s.length)];
}

function e2ScHas(s: string, w: string): bool {
  if (w.length > s.length) {
    return false;
  }
  for (let i: usize = 0; i + w.length <= s.length; i++) {
    if (sub(s, i, i + w.length) == w) {
      return true;
    }
  }
  return false;
}

export function e2ScriptMods(s: string): i32 {
  const p = e2ScSplit(s)[0].clone();
  let m = 0;
  if (e2ScHas(p, "ctrl+")) {
    m = m | UK_MOD_CTRL;
  }
  if (e2ScHas(p, "shift+")) {
    m = m | UK_MOD_SHIFT;
  }
  if (e2ScHas(p, "alt+")) {
    m = m | UK_MOD_ALT;
  }
  return m;
}

// キーの名前 → UK_KEY_*（知らなければ 0）。
export function e2ScriptKey(s: string): i32 {
  const n = e2ScSplit(s)[1].clone();
  if (n == "enter" || n == "return") {
    return UK_KEY_ENTER;
  }
  if (n == "esc" || n == "escape") {
    return UK_KEY_ESC;
  }
  if (n == "tab") {
    return UK_KEY_TAB;
  }
  if (n == "backspace") {
    return UK_KEY_BACKSPACE;
  }
  if (n == "delete" || n == "del") {
    return UK_KEY_DELETE;
  }
  if (n == "left") {
    return UK_KEY_LEFT;
  }
  if (n == "right") {
    return UK_KEY_RIGHT;
  }
  if (n == "up") {
    return UK_KEY_UP;
  }
  if (n == "down") {
    return UK_KEY_DOWN;
  }
  if (n == "home") {
    return UK_KEY_HOME;
  }
  if (n == "end") {
    return UK_KEY_END;
  }
  if (n == "pgup") {
    return UK_KEY_PGUP;
  }
  if (n == "pgdn") {
    return UK_KEY_PGDN;
  }
  if (n == "space") {
    return UK_KEY_SPACE;
  }
  if (n.length >= 2 && n.length <= 3 && n[0] == 102) {
    const k = parseNum(sub(n, 1, n.length));
    if (k >= 1.0 && k <= 12.0) {
      return UK_KEY_F + (k as i32);
    }
  }
  if (n.length == 1) {
    return UK_KEY_CHAR + (n[0] as i32);
  }
  return 0;
}
