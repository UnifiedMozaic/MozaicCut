// 配線（素材の欄・コマンドパレット・保存）の状態: コマンドパレットの開閉と探す語、保存の状態の表示、
// 素材をタイムラインへ運んでいる間の落とし先。E2View.wp に入れる（wire_pool.um と wp_*.um だけが書き換える）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wp / Wp で始める。
import { I18n, i18nNew, I18N_JA } from "../engine/i18n.um";
import { E2, e2Bytes, e2BaseName, e2SetStatus } from "./e2_state.um";

// コマンドパレットの 1 行（kmCommands の 1 つ）。
export struct WpEntry {
  id: string;
  name: string;
  en: string;
  alias: string;
  aliasEn: string;
  group: string;
  keys: string;
  // 実行できるか（e2_cmds.um の e2CmdReady。パレットには実行できるものだけを並べるので、いまはいつも true）
  can: bool;
}

export struct WpState {
  // コマンドパレット
  palOpen: bool;
  palQuery: string;
  // 選んでいる行（絞り込んだ行の中の番号。op の行があれば 0 がそれ）と、上の端の行
  palSel: i32;
  palTop: i32;
  entries: WpEntry[];
  built: bool;
  tr: I18n;
  // 保存の状態: 最後に見た E2 の版・本文・取り消しの数と、手で保存した時刻・外で書き換わった時刻（ui.now の秒）
  lastVer: i64;
  lastText: string;
  lastUndo: usize;
  lastRedo: usize;
  savedFlash: f64;
  extAt: f64;
  // 素材をタイムラインへ運んでいる間の落とし先（dropOn のときだけ。時刻・行）
  dropOn: bool;
  dropT: f64;
  dropRow: i32;
}

export function wpStateNew(): WpState {
  return {
    palOpen: false, palQuery: "", palSel: 0, palTop: 0, entries: [], built: false, tr: i18nNew(I18N_JA), lastVer: -1,
    lastText: "", lastUndo: 0, lastRedo: 0, savedFlash: -100.0, extAt: -100.0, dropOn: false, dropT: 0.0, dropRow: -1,
  };
}

// 毎フレームの初めに呼ぶ。E2 の版が変わったとき、取り消し・操作ではないのに本文が変わっていたら「外で変更あり」。
// コマンドパレットを開く（palette.open。e2c_edit.um から呼ぶ）。
export function wpOpen(wp: mut WpState): void {
  wp.palOpen = true;
  wp.palQuery = "";
  wp.palSel = 0;
  wp.palTop = 0;
}

export function wpTick(ed: E2, wp: mut WpState, now: f64): void {
  if (ed.ver == wp.lastVer) {
    return;
  }
  if (wp.lastVer >= 0 && ed.text != wp.lastText && ed.undo.length == wp.lastUndo && ed.redo.length == wp.lastRedo) {
    wp.extAt = now;
  }
  wp.lastVer = ed.ver;
  wp.lastText = ed.text.clone();
  wp.lastUndo = ed.undo.length;
  wp.lastRedo = ed.redo.length;
}

// 保存（Ctrl+S）。操作のたびに保存しているので、いまの本文をもう一度書くだけ。書けなければ「保存できませんでした」。
export function wpSave(ed: mut E2, wp: mut WpState, now: f64): bool {
  if (!writeFile(ed.path, e2Bytes(ed.text))) {
    ed.saveErr = true;
    e2SetStatus(mut ed, `${e2BaseName(ed.path)} に書き込めません（読み取り専用でないか、ほかのプログラムが開いていないかを確かめます）`, true);
    return false;
  }
  ed.saveErr = false;
  wp.savedFlash = now;
  e2SetStatus(mut ed, `${e2BaseName(ed.path)} を保存しました`, false);
  return true;
}

// 上の帯の保存の状態の札: 0 保存済み（ok）・1 保存しました（ok。手で保存した直後）・2 外で変更あり（textSource）・3 保存できませんでした（error）。
export function wpSaveKind(ed: E2, wp: WpState, now: f64): i32 {
  if (ed.saveErr) {
    return 3;
  }
  if (now - wp.extAt < 1.5) {
    return 2;
  }
  if (now - wp.savedFlash < 2.0) {
    return 1;
  }
  return 0;
}

export function wpSaveText(kind: i32): string {
  if (kind == 1) {
    return "保存しました";
  }
  if (kind == 2) {
    return "外で変更あり";
  }
  if (kind == 3) {
    return "保存できませんでした";
  }
  return "保存済み";
}
