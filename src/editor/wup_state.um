// 自動更新の画面の側の状態（状態の帯の知らせ・設定の「更新を確かめる」）。E2View.up に入れる
// （wire_update.um だけが書き換える。e2_chrome.um の状態の帯と rail_settings.um は読んで、頼みの印だけを立てる）。
// 裏のスレッドとの受け渡しは upd_worker.um。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wup / Wup / WUP で始める。

export const WUP_IDLE: i32 = 0;       // 知らせることがない
export const WUP_CHECKING: i32 = 1;   // 手で頼んだ確かめの最中（状態の帯に「確かめています」）
export const WUP_AVAILABLE: i32 = 2;  // 新しい版がある（［更新］）
export const WUP_GETTING: i32 = 3;    // 落として、確かめて、展開している
export const WUP_READY: i32 = 4;      // 入れ替えの用意ができた（閉じると入れ替える。［今すぐ再起動］）

export struct WupState {
  on: bool;          // 設定の「更新を確かめる」（<home>/mozcut-update.txt）
  auto: bool;        // 自動で確かめてよいか（配布の形で動いている、か試しの MOZCUT_UPDATE_URL がある）
  phase: i32;        // WUP_*
  latest: string;    // 最新の版
  page: string;      // リリースのページ
  step: string;      // WUP_GETTING の今の段の文
  frac: f64;         // 落とした割合（-1 は分からない）
  stage: string;     // WUP_READY: 展開した新しい単位（.../MozaicCut.update/MozaicCut など）
  unit: string;      // WUP_READY: 入れ替える単位
  // 画面からの頼み（wire_update.um が次のフレームで裏のスレッドへ送る）
  reqCheck: bool;
  reqInstall: bool;
  // ［今すぐ再起動］を押した（終わるときに、入れ替えたあとで起動し直す）
  restart: bool;
  // 最後に自動の確かめを頼んだ clock()（-1 はまだ）
  lastAuto: f64;
  // 試し用（MOZCUT_UPDATE_AUTO_INSTALL）: 新しい版を見つけたら、押さなくても取り込む
  autoInstall: bool;
}

export function wupStateNew(): WupState {
  return {
    on: true, auto: false, phase: WUP_IDLE, latest: "", page: "", step: "", frac: -1.0, stage: "", unit: "",
    reqCheck: false, reqInstall: false, restart: false, lastAuto: -1.0, autoInstall: false,
  };
}

// 別のプロジェクトを開き直して部品の状態を作り直すとき（e2c_file.um の e2cFileNewView）に引き継ぐ。
export function wupStateCopy(o: WupState): WupState {
  return {
    on: o.on, auto: o.auto, phase: o.phase, latest: o.latest.clone(), page: o.page.clone(), step: o.step.clone(), frac: o.frac,
    stage: o.stage.clone(), unit: o.unit.clone(), reqCheck: o.reqCheck, reqInstall: o.reqInstall, restart: o.restart,
    lastAuto: o.lastAuto, autoInstall: o.autoInstall,
  };
}
