// 「合成」のワークスペース（ws_comp.um と wcomp_*.um）の状態と、そこで使う型。E2View.wcomp に入れる。
// E2View から読むので、このファイルは e2_* を読まない。docs/design/comp.md が、どのファイルに何を書くかの表。
//
// 担当ごとの状態は、下の WcompCam・WcompShape… の struct に分けてある。自分の struct の欄だけを足し・書き換える
// （ほかの担当の struct と、WcompState の共通の欄は変えない。足りなければまとめ役に言う）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wcomp / Wcomp / WCOMP で始める。
import { UkRect, ukRect } from "../ui/kit/base.um";
import { MoEvent, MoView } from "../workspaces/motion/mo_core.um";

// ---- 道具（中央の上の道具の帯。押した道具の入口 wcompTool* だけが、ビューアの上に描く） ----
export const WCOMP_TOOL_SELECT: i32 = 0;    // 選択（変形のギズモと点の編集。wire_motion.um と同じもの）
export const WCOMP_TOOL_CAMERA: i32 = 1;    // カメラ（wcomp_camera.um）
export const WCOMP_TOOL_SHAPE: i32 = 2;     // 図形（wcomp_shape.um）
export const WCOMP_TOOL_PEN: i32 = 3;       // ペン・マスク（wcomp_pen.um）
export const WCOMP_TOOL_TEXT: i32 = 4;      // 文字（wcomp_text.um）
export const WCOMP_TOOL_PARTICLE: i32 = 5;  // パーティクル（wcomp_particle.um）
export const WCOMP_TOOL_TRACK: i32 = 6;     // トラッカー（wcomp_track.um）
export const WCOMP_TOOL_COUNT: i32 = 7;

// ---- 出来事 ----
// 入口はどれも MoEvent[]（src/workspaces/motion/mo_core.um）を返す。MO_E_OP / PREVIEW / SEEK / SELECT / CANCEL は M6 の部品と同じ意味で、
// ws_comp.um の wcompHandle が wire_motion.um の wmoHandle に渡す（.mzc に当てる・ドラッグの途中を見せる・再生ヘッドを動かす）。
// 合成のワークスペースだけの出来事は 20 から:
export const WCOMP_E_LAYER: i32 = 20;   // レイヤー n（ed.project.clips の番号）を選ぶ
export const WCOMP_E_TOOL: i32 = 21;    // 道具を n（WCOMP_TOOL_*）に替える
export const WCOMP_E_STATUS: i32 = 22;  // 状態の帯に text を出す（n が 1 なら誤り）
export const WCOMP_E_PRECOMP: i32 = 23; // 選んだレイヤー n を別 .mzc にプリコンポーズする

// 描いた高さと出来事。レイヤーの一覧の行（wcompRows*）と効果のコントロールの節（wcompFx*）が返す。
// h は使った高さ（画素）。0 なら何も描いていない。節の h が -1 なら「このレイヤーには出さない」（見出しも出さない）。
export struct WcompOut {
  evs: MoEvent[];
  h: i32;
}

export function wcompOut(h: i32): WcompOut {
  return { evs: [], h };
}

// ビューア（中央）の場所。道具の入口に渡す。
//   pic  絵の四角（キャンバスの画素 ↔ 画面は view。前のフレームの monPanel が決めた v.mon.picR）
//   area 道具が描いてよい四角（ビューアの、再生の帯を除いた所。切り取りはこれ）
//   t    再生ヘッドのタイムラインの秒（コマに合わせたもの）
//   sel  選んでいるレイヤー（1 つだけのとき。なければ -1）
export struct WcompVw {
  pic: UkRect;
  area: UkRect;
  view: MoView;
  t: f64;
  sel: i32;
}

// レイヤーの一覧（下）の形。行を描く関数に渡す。
//   left   左の欄（▶・名前・プロパティの名前と値）の x と幅
//   time   右の時間の欄の x と幅（キーフレームの列・レイヤーの帯）
//   t0, pxPerSec  時間の欄の左の端の秒と、1 秒の画素（x = time.x + (t − t0)·pxPerSec）
//   rowH   1 行の高さ、indent は 1 段の字下げ
export struct WcompGeo {
  leftX: i32;
  leftW: i32;
  timeX: i32;
  timeW: i32;
  t0: f64;
  pxPerSec: f64;
  rowH: i32;
  indent: i32;
  // 一覧の見えている所（行の切り取り）
  clip: UkRect;
}

export function wcompTimeX(g: WcompGeo, t: f64): i32 {
  return g.timeX + Math.floor((t - g.t0) * g.pxPerSec) as i32;
}

// ---- 共通のドラッグ数値操作（スクラブ）状態 ----
export struct WcompScrub {
  id: u32;
  startX: i32;
  startVal: f64;
  active: bool;
}

export function wcompScrubNew(): WcompScrub {
  return { id: 0, startX: 0, startVal: 0.0, active: false };
}

// ---- 担当ごとの状態（自分の struct だけを書き換える） ----

// カメラと 3D（wcomp_camera.um）
export struct WcompCam {
  dragging: bool;
  // 0: 軌道（オービット）、1: パン、2: ドリー
  mode: i32;
  // レイヤー一覧のカメラ行が開いているか
  open: bool;
  // ドラッグ開始時のマウスとカメラ
  startMx: i32;
  startMy: i32;
  startPx: f64;
  startPy: f64;
  startPz: f64;
  startTx: f64;
  startTy: f64;
  startTz: f64;
}

// 図形（wcomp_shape.um）
export struct WcompShape {
  dragging: bool;
  // 0: 長方形, 1: 楕円, 2: 多角形, 3: 星
  form: i32;
  x0: f64;
  y0: f64;
  x1: f64;
  y1: f64;
}

// ペン・マスク・描画モード（wcomp_pen.um）
export struct WcompPen {
  dragging: bool;
  // 0: マスク（選択レイヤーに追加）, 1: シェイプ（新規パス）
  target: i32;
  ptsX: f64[];
  ptsY: f64[];
}

// 文字とテキストアニメーター（wcomp_text.um）
export struct WcompText {
  dragging: bool;
  // 道具で置くときのプリセット（0: なし, 1: typewriter, 2: bounce, 3: rise, 4: wave）
  preset: i32;
}

// パーティクル（wcomp_particle.um）
export struct WcompPart {
  dragging: bool;
  // 道具で置くときのプリセット（0: 火花, 1: 雪, 2: 紙吹雪, 3: ほこり, 4: リング）
  preset: i32;
}

// トラッキング・キーイング（wcomp_track.um）
export struct WcompTrack {
  dragging: bool;
  hasPt: bool;
  ptX: f64;
  ptY: f64;
  feature: i32;
  search: i32;
  // 追った動きを書き込む先（クリップの番号。-1 なら未指定）
  targetClip: i32;
}

// エクスプレッション（wcomp_expr.um）
export struct WcompExpr {
  editing: bool;
  propIdx: i32;
  // 0: key.expr（値に重ねる）, 1: key=expr(...)（式で置換）
  mode: i32;
  buf: string;
  bufClip: i32;
  bufKey: string;
}

// ---- 共通の状態（ws_comp.um・wcomp_layers.um・wcomp_fx.um が書き換える） ----
export struct WcompState {
  tool: i32;
  // レイヤーの一覧: 開いているレイヤー（クリップの行番号 Clip.line。読み直しで番号がずれないように行で覚える）
  open: i32[];
  // 一覧の縦のずらし（画素）
  scroll: i32;
  // 時間の欄の横の拡大（1 なら全体が入る）と左の端の秒
  zoom: f64;
  t0: f64;
  // 効果のコントロール: 閉じた節の名前と縦のずらし
  fxClosed: string[];
  fxScroll: i32;
  // 共通の数値ドラッグ状態
  scrub: WcompScrub;
  cam: WcompCam;
  shape: WcompShape;
  pen: WcompPen;
  text: WcompText;
  part: WcompPart;
  track: WcompTrack;
  expr: WcompExpr;
}

export function wcompStateNew(): WcompState {
  return {
    tool: WCOMP_TOOL_SELECT, open: [], scroll: 0, zoom: 1.0, t0: 0.0, fxClosed: [], fxScroll: 0,
    scrub: wcompScrubNew(),
    cam: { dragging: false, mode: 0, open: false, startMx: 0, startMy: 0, startPx: 0.0, startPy: 0.0, startPz: 0.0, startTx: 0.0, startTy: 0.0, startTz: 0.0 },
    shape: { dragging: false, form: 0, x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0 },
    pen: { dragging: false, target: 0, ptsX: [], ptsY: [] }, text: { dragging: false, preset: 0 },
    part: { dragging: false, preset: 0 },
    track: { dragging: false, hasPt: false, ptX: 0.0, ptY: 0.0, feature: 15, search: 32, targetClip: -1 },
    expr: { editing: false, propIdx: 0, mode: 0, buf: "", bufClip: -1, bufKey: "" },
  };
}

export function wcompIsOpen(s: WcompState, line: i32): bool {
  for (const l of s.open) {
    if (l == line) {
      return true;
    }
  }
  return false;
}

export function wcompToggleOpen(s: mut WcompState, line: i32): void {
  let o: i32[] = [];
  let found = false;
  for (const l of s.open) {
    if (l == line) {
      found = true;
    } else {
      o.push(l);
    }
  }
  if (!found) {
    o.push(line);
  }
  s.open = o;
}

export function wcompEmptyRect(): UkRect {
  return ukRect(0, 0, 0, 0);
}
