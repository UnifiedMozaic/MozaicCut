// コマンドの表（e2_cmds.um）の状態: 表の 1 行の形と、作った表の覚え、右クリックのメニュー（e2CtxOpen / e2CtxMenu）の
// いま開いているメニューの場所の種類と、右クリックした所のもの（クリップの番号など）。
// E2View.cm に入れる（e2_cmds.um だけが書き換える）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wcm / Wcm で始める。

// コマンドの表の 1 行（e2_cmds.um の e2CmdTable）。
export struct WcmCmd {
  // コマンドの ID（keymap.um の kmCommands と同じ。キーと i18n の名前はこの ID で引く）
  id: string;
  // 出すメニュー（e2_cmds.um の E2_MENU_*。-1 はメニューに出さず、コマンドの欄だけ）
  menu: i32;
  // メニュー・右クリック・コマンドの欄に出す名前
  label: string;
  // メニューでこの項目の前に区切りの線を引く
  sep: bool;
  // 右クリックのメニューに出す場所（E2_CTX_* の和。0 なら出さない）
  ctx: i32;
  // 表のキーの振り分け（e2CmdKeys）がキーを受ける。部品の配線が自分でキーを受けるもの（再生・分割など）は false
  key: bool;
  // つないだか（e2CmdReady。表を作るときに決める）。false のものはどこにも出さず、キーでも動かない
  ready: bool;
}

export struct WcmState {
  // 作った表（e2CmdTable を ready を付けて写したもの）
  cmds: WcmCmd[];
  built: bool;
  // 場所の種類（e2_cmds.um の E2_CTX_*）。0 なら開いていない
  kind: i32;
  // 右クリックしたクリップの番号（ed.project.clips の番号。クリップの上でなければ -1）
  clip: i32;
  // 右クリックした素材の番号（kit.lib.media の番号。素材の上でなければ -1）
  media: i32;
  // 右クリックした所の時刻（タイムラインなら、その x の時刻。ほかは再生ヘッド）
  t: f64;
  // macOS のメニューバー（e2_macmenu.um）を最後に組み立てたときの印と、有効／無効・チェックの印のビット（-1 はまだ）
  macSig: string;
  macBits: i32;
}

export function wcmStateNew(): WcmState {
  return { cmds: [], built: false, kind: 0, clip: -1, media: -1, t: 0.0, macSig: "", macBits: -1 };
}
