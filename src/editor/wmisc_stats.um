// 試し用（edit2.um の --stats）: 画面の配置の状態（左の欄・レールの欄・ワークスペース・右の列のタブ）と、状態の帯の 1 文。
// 部品をつないだ所（左の欄を開く・ワークスペースを替える・状態の帯に知らせる）を、画像の画素ではなく値で確かめるために使う。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wmisc で始める。
import { jsonStr } from "../engine/report.um";
import { E2 } from "./e2_state.um";
import { E2View } from "./e2_view.um";

// keymap はキーの割り当ての配列（KM_PRESET_*。E2Kit.keys.preset）。
export function wmiscStatsJson(ed: E2, v: E2View, keymap: i32): string {
  return `{"leftOpen":${v.leftOpen},"railSel":${v.railSel},"workspace":${v.workspace},"rightOpen":${v.rightOpen},"rightTab":${v.rightTab},"sel":${v.tl.sel.length},"status":${jsonStr(ed.status)},"statusErr":${ed.statusErr},"keymap":${keymap}}`;
}
