// 合成のワークスペースの「パーティクル」の担当のファイル（docs/design/comp.md）。
// - wcompToolParticle: ビューアを押した所にパーティクル（火花・雪・紙吹雪・ほこり・リング）を置く。
//                      パーティクルレイヤー選択中は発生源の位置をビューア上でドラッグ移動できる
// - wcompRowsParticle: レイヤー一覧で開いたパーティクルレイヤーに要約行を出す
// - wcompFxParticle: 効果のコントロール「パーティクル」節（発生源・動き/力・見た目/色）
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wcomp で始める。
import {
  UkCtx, ukBehavior, ukId, ukDrawRect, ukDrawRound, ukDrawStroke, ukDrawText, ukDrawCircle, ukLineH,
  ukMouseIn, ukKeyTake, UK_KEY_ESC,
} from "../ui/kit/core.um";
import { UkRect, ukRect, ukAlpha } from "../ui/kit/base.um";
import { thPx } from "../gen/theme.um";
import { KIND_PARTICLES, KIND_AUDIO } from "../engine/project.um";
import { keyValue, hasKey } from "../engine/lineedit.um";
import {
  PtSpec, PtDiag, ptSpecFromKv, ptResolveSpec,
  PT_EMIT_CIRCLE, PT_EMIT_BOX, PT_EMIT_LAYER, PT_BLEND_OVER,
} from "../effects/particles/particles.um";
import {
  MoEvent, moEv, moRef, moNum, moToScreenX, moToScreenY, moFromScreenX, moFromScreenY,
  MO_E_OP, MO_E_PREVIEW, MO_E_CANCEL,
} from "../workspaces/motion/mo_core.um";
import { moDot, moEdgedLine } from "../workspaces/motion/mo_draw.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";
import { WcompVw, WcompGeo, WcompOut, wcompOut } from "./wcomp_state.um";
import {
  WCOMP_NUM_PREVIEW, WCOMP_NUM_COMMIT, WCOMP_NUM_CANCEL,
  wcompUiSubHead, wcompUiCycleRow, wcompUiChips, wcompUiNumRow, wcompUiColorRow,
} from "./wcomp_ui.um";

function wcompPtSpec(ed: E2, ci: usize): PtSpec {
  let d: PtDiag[] = [];
  const raw = ptSpecFromKv(ed.project.clips[ci].kv, mut d);
  return ptResolveSpec(raw, Math.max(ed.project.width, 1), Math.max(ed.project.height, 1));
}

// ---- 道具の入口（パーティクルを置く・発生源を動かす） ----

export function wcompToolParticle(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, vw: WcompVw): MoEvent[] {
  let out: MoEvent[] = [];
  const pad = kit.wmo.th.s2;
  const hudH = thPx(kit.th, 26);
  const hudW = thPx(kit.th, 320);
  const hudR = ukRect(vw.area.x + pad, vw.area.y + pad, hudW, hudH);
  ukDrawRound(mut ui, hudR, 4, ukAlpha(kit.wmo.th.bg1, 225));
  ukDrawStroke(mut ui, hudR, 4, kit.wmo.th.hair, kit.wmo.th.lineStrong);
  const pick = wcompUiChips(mut ui, kit.wmo.th, "wcomp.pt.pre", ["火花", "雪", "紙吹雪", "ほこり", "リング"], v.wcomp.part.preset,
    ukRect(hudR.x + 2, hudR.y + 1, hudW - 4, hudH - 2));
  if (pick >= 0) {
    v.wcomp.part.preset = pick;
  }

  // 選択中のレイヤーがパーティクルなら、発生源ハンドルを描いてドラッグ移動できるようにする
  const selPt = vw.sel >= 0 && (vw.sel as usize) < ed.project.clips.length && ed.project.clips[vw.sel as usize].kind == KIND_PARTICLES;
  if (selPt) {
    const idx = vw.sel as usize;
    const sp = wcompPtSpec(ed, idx);
    const sx = moToScreenX(vw.view, sp.x);
    const sy = moToScreenY(vw.view, sp.y);
    moEdgedLine(mut ui, sx - 12.0, sy, sx + 12.0, sy, 1.5, kit.wmo.th.warn, kit.wmo.th.edge);
    moEdgedLine(mut ui, sx, sy - 12.0, sx, sy + 12.0, 1.5, kit.wmo.th.warn, kit.wmo.th.edge);
    moDot(mut ui, sx, sy, 4.5, kit.wmo.th.warn, kit.wmo.th.edge);
    if (sp.emit == PT_EMIT_CIRCLE) {
      ukDrawCircle(mut ui, sx, sy, (sp.radius as f32) * (vw.view.s as f32), 1.2, ukAlpha(kit.wmo.th.warn, 190));
    }
    const hr = ukRect((sx as i32) - 14, (sy as i32) - 14, 28, 28);
    const hh = ukBehavior(mut ui, ukId(ui, "wcomp.pt.emit"), hr, false);
    if (hh.pressed) {
      v.wcomp.part.dragging = true;
    } else if (v.wcomp.part.dragging) {
      if (ukKeyTake(mut ui, UK_KEY_ESC)) {
        v.wcomp.part.dragging = false;
        out.push(moEv(MO_E_CANCEL, [], 0.0, 0, ""));
        return out;
      }
      const nx = Math.floor(moFromScreenX(vw.view, ui.inp.mx) + 0.5) as i32;
      const ny = Math.floor(moFromScreenY(vw.view, ui.inp.my) + 0.5) as i32;
      const ref = moRef(ed.project.clips[idx]);
      const op = `set ${ref} x=${nx}px y=${ny}px`;
      if (hh.held) {
        out.push(moEv(MO_E_PREVIEW, [op], 0.0, 0, ""));
      } else {
        v.wcomp.part.dragging = false;
        out.push(moEv(MO_E_OP, [op], 0.0, 0, "パーティクルの発生源を移動"));
      }
      return out;
    }
  }

  // 何もない所をクリックしたら新しいパーティクルレイヤーを置く
  const bh = ukBehavior(mut ui, ukId(ui, "wcomp.pt.place"), vw.area, false);
  if (bh.pressed && !ukMouseIn(ui, hudR)) {
    const cx = Math.floor(moFromScreenX(vw.view, ui.inp.mx) + 0.5) as i32;
    const cy = Math.floor(moFromScreenY(vw.view, ui.inp.my) + 0.5) as i32;
    const cw = Math.max(ed.project.width, 1);
    const at = moNum(vw.t, 3);
    const pre = v.wcomp.part.preset;
    let op = "";
    if (pre == 0) {
      op = `add particles emit=point x=${cx}px y=${cy}px rate=350 speed=320 dir=-90 spread=35 gravity=420 life=1.8 size=7 size.end=2 color=ffd27a color.end=ff3a1a opacity.out=0.4 draw=soft blend=add at=${at} dur=5`;
    } else if (pre == 1) {
      op = `add particles emit=line x=0px y=0px x2=${cw}px y2=0px rate=160 speed=60 dir=90 spread=20 wind=25 turb=40 life=8 size=6 color=ffffff draw=soft blend=over prewarm=4 at=${at} dur=5`;
    } else if (pre == 2) {
      op = `add particles emit=box x=${cx}px y=${cy}px w=300 h=40 rate=200 speed=180 dir=90 spread=60 gravity=240 spin=180 life=3 size=10 color=ff5c5c color.end=4c8dff draw=point blend=over at=${at} dur=5`;
    } else if (pre == 3) {
      op = `add particles emit=box x=${cx}px y=${cy}px w=600 h=400 rate=80 speed=20 spread=180 turb=60 life=4 size=5 color=ffffff draw=soft blend=add prewarm=2 at=${at} dur=5`;
    } else {
      op = `add particles emit=circle x=${cx}px y=${cy}px radius=80 emit.edge=1 rate=250 speed=120 dir.mode=out life=1.5 size=8 size.end=1 color=4c8dff color.end=cc79a7 draw=ring blend=add at=${at} dur=5`;
    }
    out.push(moEv(MO_E_OP, [op], 0.0, 0, "パーティクルのレイヤーを追加"));
  }
  return out;
}

// ---- レイヤー一覧のパーティクル行 ----

export function wcompRowsParticle(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, g: WcompGeo, ci: i32, y: i32): WcompOut {
  let out = wcompOut(0);
  const idx = ci as usize;
  const sp = wcompPtSpec(ed, idx);
  const rowH = g.rowH;
  const lh = ukLineH(ui, kit.wmo.th.fsSm);
  const ix = g.leftX + g.indent;
  ukDrawText(mut ui, ix + kit.wmo.th.s2, y + (rowH - lh) / 2, "パーティクル", kit.wmo.th.fsSm, kit.wmo.th.text2);
  ukDrawRect(mut ui, ukRect(g.leftX, y + rowH - kit.wmo.th.hair, g.leftW + g.timeW + 1, kit.wmo.th.hair), kit.wmo.th.line);
  out.h = rowH;

  const emitNames: string[] = ["点", "線", "円", "箱", "レイヤー"];
  let en = "点";
  if ((sp.emit as usize) < emitNames.length) {
    en = emitNames[sp.emit as usize].clone();
  }
  ukDrawText(mut ui, ix + g.indent + kit.wmo.th.s2, y + out.h + (rowH - lh) / 2,
    `発生源: ${en}  レート ${moNum(sp.rate, 0)}/s  速度 ${moNum(sp.speed as f64, 0)}  寿命 ${moNum(sp.life as f64, 1)}s`,
    kit.wmo.th.fsXs, kit.wmo.th.text2);
  ukDrawRect(mut ui, ukRect(g.leftX, y + out.h + rowH - kit.wmo.th.hair, g.leftW + g.timeW + 1, kit.wmo.th.hair), ukAlpha(kit.wmo.th.line, 120));
  out.h = out.h + rowH;
  return out;
}

function wcompPtNum(
  ui: mut UkCtx, kit: E2Kit, v: mut E2View, line: i32, ref: string, key: string, label: string,
  val: f64, lo: f64, hi: f64, step: f64, dec: i32, unit: string, suffix: string, r: UkRect, out: mut WcompOut,
): void {
  const nr = wcompUiNumRow(mut ui, kit.wmo.th, `wcpt.${line}.${key}`, label, val, lo, hi, step, dec, unit, false, r, mut v.wcomp.scrub, false);
  if (nr.kind == WCOMP_NUM_PREVIEW) {
    out.evs.push(moEv(MO_E_PREVIEW, [`set ${ref} ${key}=${moNum(nr.val, dec)}${suffix}`], 0.0, 0, ""));
  } else if (nr.kind == WCOMP_NUM_COMMIT) {
    out.evs.push(moEv(MO_E_OP, [`set ${ref} ${key}=${moNum(nr.val, dec)}${suffix}`], 0.0, 0, `${label} を変える`));
  } else if (nr.kind == WCOMP_NUM_CANCEL) {
    out.evs.push(moEv(MO_E_CANCEL, [], 0.0, 0, ""));
  }
}

// ---- 効果のコントロール: 「パーティクル」の節 ----

export function wcompFxParticle(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, ci: i32, r: UkRect): WcompOut {
  let out = wcompOut(0);
  const idx = ci as usize;
  const sp = wcompPtSpec(ed, idx);
  const rowH = thPx(kit.th, 26);
  const subH = thPx(kit.th, 22);
  const ref = moRef(ed.project.clips[idx]);
  const line = ed.project.clips[idx].line;
  const lineStr = ed.lines[(line - 1) as usize].clone();

  // 発生源
  wcompUiSubHead(mut ui, kit.wmo.th, "発生源", ukRect(r.x, r.y + out.h, r.w, subH));
  out.h = out.h + subH;
  const emitVals: string[] = ["point", "line", "circle", "box", "layer"];
  const ep = wcompUiCycleRow(mut ui, kit.wmo.th, `wcpt.em.${line}`, "形", ["点", "線", "円", "箱", "レイヤー"], sp.emit as i32, ukRect(r.x, r.y + out.h, r.w, rowH));
  if (ep >= 0) {
    out.evs.push(moEv(MO_E_OP, [`set ${ref} emit=${emitVals[ep as usize]}`], 0.0, 0, "発生源の形を変える"));
  }
  out.h = out.h + rowH;

  if (sp.emit == PT_EMIT_LAYER) {
    let lOpts: string[] = ["なし"];
    let lIds: string[] = [""];
    let curL: i32 = 0;
    for (let j: usize = 0; j < ed.project.clips.length; j++) {
      if (j == idx || ed.project.clips[j].kind == KIND_AUDIO || ed.project.clips[j].kind == KIND_PARTICLES || ed.project.clips[j].id == "") {
        continue;
      }
      if (ed.project.clips[j].id == sp.layer) {
        curL = lIds.length as i32;
      }
      lOpts.push(ed.project.clips[j].id.clone());
      lIds.push(ed.project.clips[j].id.clone());
    }
    const lp = wcompUiCycleRow(mut ui, kit.wmo.th, `wcpt.ly.${line}`, "対象レイヤー", lOpts, curL, ukRect(r.x, r.y + out.h, r.w, rowH));
    if (lp > 0) {
      out.evs.push(moEv(MO_E_OP, [`set ${ref} layer=${lIds[lp as usize]}`], 0.0, 0, "発生源のレイヤーを変える"));
    }
    out.h = out.h + rowH;
  } else {
    wcompPtNum(mut ui, kit, mut v, line, ref, "x", "発生 X", sp.x, -4000.0, 8000.0, 10.0, 0, "px", "px", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
    out.h = out.h + rowH;
    wcompPtNum(mut ui, kit, mut v, line, ref, "y", "発生 Y", sp.y, -4000.0, 8000.0, 10.0, 0, "px", "px", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
    out.h = out.h + rowH;
    if (sp.emit == PT_EMIT_CIRCLE) {
      wcompPtNum(mut ui, kit, mut v, line, ref, "radius", "半径", sp.radius as f64, 1.0, 4000.0, 8.0, 0, "px", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
      out.h = out.h + rowH;
    } else if (sp.emit == PT_EMIT_BOX) {
      wcompPtNum(mut ui, kit, mut v, line, ref, "w", "幅", sp.emitW as f64, 1.0, 8000.0, 10.0, 0, "px", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
      out.h = out.h + rowH;
      wcompPtNum(mut ui, kit, mut v, line, ref, "h", "高さ", sp.emitH as f64, 1.0, 8000.0, 10.0, 0, "px", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
      out.h = out.h + rowH;
    }
  }
  wcompPtNum(mut ui, kit, mut v, line, ref, "rate", "発生率", sp.rate, 0.0, 5000.0, 20.0, 0, "/s", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;
  wcompPtNum(mut ui, kit, mut v, line, ref, "burst", "バースト", sp.burst as f64, 0.0, 5000.0, 10.0, 0, "粒", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;

  // 動きと力
  wcompUiSubHead(mut ui, kit.wmo.th, "動きと力", ukRect(r.x, r.y + out.h, r.w, subH));
  out.h = out.h + subH;
  wcompPtNum(mut ui, kit, mut v, line, ref, "speed", "速さ", sp.speed as f64, 0.0, 4000.0, 15.0, 0, "px/s", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;
  wcompPtNum(mut ui, kit, mut v, line, ref, "dir", "方向", sp.dir as f64, -360.0, 360.0, 5.0, 0, "°", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;
  wcompPtNum(mut ui, kit, mut v, line, ref, "spread", "広がり", sp.spread as f64, 0.0, 360.0, 5.0, 0, "°", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;
  wcompPtNum(mut ui, kit, mut v, line, ref, "gravity", "重力", sp.gravity as f64, -2000.0, 2000.0, 20.0, 0, "", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;
  wcompPtNum(mut ui, kit, mut v, line, ref, "wind", "風", sp.wind as f64, -2000.0, 2000.0, 20.0, 0, "", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;
  wcompPtNum(mut ui, kit, mut v, line, ref, "turb", "乱流", sp.turb as f64, 0.0, 2000.0, 20.0, 0, "", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;

  // 見た目
  wcompUiSubHead(mut ui, kit.wmo.th, "粒の見た目", ukRect(r.x, r.y + out.h, r.w, subH));
  out.h = out.h + subH;
  wcompPtNum(mut ui, kit, mut v, line, ref, "life", "寿命", sp.life as f64, 0.1, 30.0, 0.1, 1, "s", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;
  wcompPtNum(mut ui, kit, mut v, line, ref, "size", "大きさ", sp.size as f64, 1.0, 200.0, 1.0, 1, "px", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;
  const seVal = sp.sizeEnd >= 0.0 ? (sp.sizeEnd as f64) : (sp.size as f64);
  wcompPtNum(mut ui, kit, mut v, line, ref, "size.end", "終サイズ", seVal, 0.0, 200.0, 1.0, 1, "px", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;

  const palHex: string[] = ["ffffff", "ffd27a", "ff5c5c", "4c8dff", "30c070", "cc79a7", "00c0ff"];
  const palCol: u32[] = [0xffffffff, 0xffffd27a, 0xffff5c5c, 0xff4c8dff, 0xff30c070, 0xffcc79a7, 0xff00c0ff];
  let curC = "ffffff";
  if (hasKey(lineStr, "color")) {
    curC = keyValue(lineStr, "color");
  }
  const pc1 = wcompUiColorRow(mut ui, kit.wmo.th, `wcpt.c1.${line}`, "開始色", curC, palHex, palCol, ukRect(r.x, r.y + out.h, r.w, rowH));
  if (pc1 != "") {
    out.evs.push(moEv(MO_E_OP, [`set ${ref} color=${pc1}`], 0.0, 0, "パーティクルの開始色を変える"));
  }
  out.h = out.h + rowH;
  let curC2 = "";
  if (hasKey(lineStr, "color.end")) {
    curC2 = keyValue(lineStr, "color.end");
  }
  const pc2 = wcompUiColorRow(mut ui, kit.wmo.th, `wcpt.c2.${line}`, "終了色", curC2, palHex, palCol, ukRect(r.x, r.y + out.h, r.w, rowH));
  if (pc2 != "") {
    out.evs.push(moEv(MO_E_OP, [`set ${ref} color.end=${pc2}`], 0.0, 0, "パーティクルの終了色を変える"));
  }
  out.h = out.h + rowH;

  const drawVals: string[] = ["point", "soft", "ring", "star"];
  const curDraw = Math.min(sp.draw as i32, 3);
  const dp = wcompUiCycleRow(mut ui, kit.wmo.th, `wcpt.dr.${line}`, "粒の形", ["点", "ソフト", "リング", "星"], curDraw, ukRect(r.x, r.y + out.h, r.w, rowH));
  if (dp >= 0) {
    out.evs.push(moEv(MO_E_OP, [`set ${ref} draw=${drawVals[dp as usize]}`], 0.0, 0, "粒の形を変える"));
  }
  out.h = out.h + rowH;

  const curBl = sp.blend == PT_BLEND_OVER ? 1 : 0;
  const bp = wcompUiCycleRow(mut ui, kit.wmo.th, `wcpt.bl.${line}`, "合成", ["加算", "通常"], curBl, ukRect(r.x, r.y + out.h, r.w, rowH));
  if (bp >= 0) {
    let bv = "add";
    if (bp == 1) {
      bv = "over";
    }
    out.evs.push(moEv(MO_E_OP, [`set ${ref} blend=${bv}`], 0.0, 0, "パーティクルの合成を変える"));
  }
  out.h = out.h + rowH;

  wcompPtNum(mut ui, kit, mut v, line, ref, "prewarm", "予熱", sp.prewarm, 0.0, 20.0, 0.5, 1, "s", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;
  wcompPtNum(mut ui, kit, mut v, line, ref, "seed", "乱数の種", sp.seed as f64, 0.0, 9999.0, 1.0, 0, "", "", ukRect(r.x, r.y + out.h, r.w, rowH), mut out);
  out.h = out.h + rowH;
  return out;
}
