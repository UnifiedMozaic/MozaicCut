// 合成のワークスペースの「トラッキングとキーイング」の担当のファイル（docs/design/comp.md）。
// 関数の形（引数と返すもの）は変えず、中身だけを書く。状態は v.wcomp.track（wcomp_state.um の自分の struct）に足す。
// どの関数も「描いて出来事を返す」: .mzc は直接書かず、MoEvent（MO_E_OP の ops など）を返すと ws_comp.um 側が当てる。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wcomp で始める。
import { UkCtx } from "../ui/kit/core.um";
import { UkRect } from "../ui/kit/base.um";
import { MoEvent } from "../workspaces/motion/mo_core.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";
import { WcompVw, WcompGeo, WcompOut, wcompOut } from "./wcomp_state.um";

// 道具の入口（道具の帯で「トラッカー」を選んでいる間、毎フレーム、部品を描く前に呼ぶ。ビューアの上の層・vw.area の切り取りの中）。
// 押し・ドラッグをここで取り、.mzc を変えるときは MO_E_OP（途中は MO_E_PREVIEW）を返す。
export function wcompToolTrack(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, vw: WcompVw): MoEvent[] {
  return [];
}

// 効果のコントロールの「キーイングとトラッキング」の節の中身（見出しは wcomp_fx.um が描く）。r の x・y・幅に描き、使った高さを返す（h は無視してよい）。
// 0 を返すと、wcomp_fx.um が「準備中」と出す。
export function wcompFxKey(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, ci: i32, r: UkRect): WcompOut {
  return wcompOut(0);
}
