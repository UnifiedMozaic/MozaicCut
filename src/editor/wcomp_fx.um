// 合成のワークスペースの右の列: 効果のコントロール（選んだレイヤーのプロパティを節ごとに並べる）。docs/design/comp.md。
//
//   見出し   「効果のコントロール」とレイヤー名
//   節       変形（このファイル。moPropRow）→ 描画モードとマスク → 3D とカメラ → 図形 → 文字 → パーティクル
//            → キーイングとトラッキング → 効果（このファイル。掛けた効果の名前）→ エクスプレッション
//            節の中身は担当のファイルの wcompFx*。見出しを押すと閉じる。中身が 0 の高さなら「準備中」と出す
//   どの節を出すかはこのファイルが決める（文字は文字のレイヤーだけ、など）
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wcomp で始める。
import { UkCtx, ukBehavior, ukId, ukDrawRect, ukDrawText, ukDrawTextIn, ukLineH, ukPushClip, ukPopClip, ukMouseIn, ukTooltip, ukWheelAny, ukWheelTake } from "../ui/kit/core.um";
import { UkRect, ukRect } from "../ui/kit/base.um";
import { KIND_VIDEO, KIND_IMAGE, KIND_TEXT, KIND_SHAPE, KIND_PARTICLES, KIND_AUDIO } from "../engine/project.um";
import { thPx } from "../gen/theme.um";
import { railFxLabel } from "./rail_fx.um";
import { icnDrawIn } from "../ui/icons/draw.um";
import { ICN_CHEV_R, ICN_CHEV_D } from "../gen/icons.um";
import { MoEvent, moEv, moFps, moSnap, moMotionKeys, moRef, MO_E_OP } from "../workspaces/motion/mo_core.um";
import { moPropRow } from "../workspaces/motion/mo_keynav.um";
import { E2 } from "./e2_state.um";
import { E2Kit, E2View } from "./e2_view.um";
import { WcompOut, wcompOut } from "./wcomp_state.um";
import { wcompHandle } from "./wcomp_ev.um";
import { wcompUiCycleRow } from "./wcomp_ui.um";
import { wcompSel, wcompLayerName, wcompKindName, wcompKeyLabel } from "./wcomp_layers.um";
import { wcompFxCamera } from "./wcomp_camera.um";
import { wcompFxShape } from "./wcomp_shape.um";
import { wcompFxPen } from "./wcomp_pen.um";
import { wcompFxText } from "./wcomp_text.um";
import { wcompFxParticle } from "./wcomp_particle.um";
import { wcompFxKey } from "./wcomp_track.um";
import { wcompFxExpr } from "./wcomp_expr.um";

// 節の番号（見出しの名前と、閉じた節を覚える名前）
const WCOMP_FX_XFORM: i32 = 0;
const WCOMP_FX_PEN: i32 = 1;
const WCOMP_FX_3D: i32 = 2;
const WCOMP_FX_SHAPE: i32 = 3;
const WCOMP_FX_TEXT: i32 = 4;
const WCOMP_FX_PARTICLE: i32 = 5;
const WCOMP_FX_KEY: i32 = 6;
const WCOMP_FX_EFFECTS: i32 = 7;
const WCOMP_FX_EXPR: i32 = 8;
const WCOMP_FX_COUNT: i32 = 9;

function wcompFxTitle(n: i32): string {
  const names: string[] = [
    "変形", "描画モードとマスク", "3D とカメラ", "図形", "文字", "パーティクル", "キーイングとトラッキング", "効果", "エクスプレッション",
  ];
  return names[n as usize].clone();
}

// レイヤーの種類 kind に節 n を出すか。
function wcompFxWants(n: i32, kind: i32): bool {
  if (n == WCOMP_FX_SHAPE) {
    return kind == KIND_SHAPE;
  } else if (n == WCOMP_FX_TEXT) {
    return kind == KIND_TEXT;
  } else if (n == WCOMP_FX_PARTICLE) {
    return kind == KIND_PARTICLES;
  } else if (n == WCOMP_FX_KEY) {
    return kind == KIND_VIDEO || kind == KIND_IMAGE;
  }
  return true;
}

function wcompFxIsClosed(v: E2View, name: string): bool {
  for (const s of v.wcomp.fxClosed) {
    if (s == name) {
      return true;
    }
  }
  return false;
}

function wcompFxToggle(v: mut E2View, name: string): void {
  let o: string[] = [];
  let found = false;
  for (const s of v.wcomp.fxClosed) {
    if (s == name) {
      found = true;
    } else {
      o.push(s.clone());
    }
  }
  if (!found) {
    o.push(name.clone());
  }
  v.wcomp.fxClosed = o;
}

// 変形の節（このファイル）: 動かせるキーを moPropRow で並べる。
function wcompFxXform(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, ci: i32, r: UkRect): WcompOut {
  let out = wcompOut(0);
  const i = ci as usize;
  const fps = moFps(ed.project);
  const lt = moSnap(ed.t, fps) - ed.project.clips[i].at;
  const line = ed.project.clips[i].line;
  const rowH = thPx(kit.th, 26);
  const keys = moMotionKeys(ed.project.clips[i]);
  for (const k of keys) {
    const pr = ukRect(r.x, r.y + out.h, r.w, rowH);
    const pe = moPropRow(mut ui, kit.wmo.th, ed.project.clips[i], ed.lines[(line - 1) as usize], k, wcompKeyLabel(k), lt, fps, pr, v.wmo.prop == k);
    for (const e of pe) {
      out.evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
    }
    out.h = out.h + rowH;
  }
  // 親レイヤー（parent=<ID>。particles 以外の映像レイヤー）
  if (ed.project.clips[i].kind != KIND_PARTICLES) {
    let vals: string[] = [""];
    let labels: string[] = ["なし"];
    for (let j: usize = 0; j < ed.project.clips.length; j++) {
      if (j == i) {
        continue;
      }
      if (ed.project.clips[j].kind == KIND_AUDIO || ed.project.clips[j].kind == KIND_PARTICLES) {
        continue;
      }
      if (ed.project.clips[j].id != "") {
        vals.push(ed.project.clips[j].id.clone());
        labels.push(ed.project.clips[j].id.clone());
      }
    }
    const cur = ed.project.clips[i].parent.clone();
    let curIdx: i32 = 0;
    for (let k: usize = 0; k < vals.length; k++) {
      if (vals[k] == cur) {
        curIdx = k as i32;
        break;
      }
    }
    const pr = ukRect(r.x, r.y + out.h, r.w, rowH);
    const nv = wcompUiCycleRow(mut ui, kit.wmo.th, `wcomp.xf.parent.${line}`, "親レイヤー", labels, curIdx, pr);
    if (ukMouseIn(ui, pr)) {
      ukTooltip(mut ui, "親レイヤーの動き・回転・拡大に追従します（x / y は親の中央からの相対位置になります）");
    }
    if (nv >= 0 && nv != curIdx) {
      const ref = moRef(ed.project.clips[i]);
      const nxt = vals[nv as usize].clone();
      if (nxt == "") {
        out.evs.push(moEv(MO_E_OP, [`unset ${ref} parent`], 0.0, 0, ""));
      } else {
        out.evs.push(moEv(MO_E_OP, [`set ${ref} parent=${nxt}`], 0.0, 0, ""));
      }
    }
    out.h = out.h + rowH;
  }
  return out;
}

// 効果の節（このファイル）: 掛けた効果の名前を並べる（引数はいまはインスペクタで）。
function wcompFxEffects(ui: mut UkCtx, ed: E2, kit: E2Kit, ci: i32, r: UkRect): WcompOut {
  const rowH = thPx(kit.th, 24);
  const lh = ukLineH(ui, kit.wmo.th.fsSm);
  let out = wcompOut(0);
  const n = ed.project.clips[ci as usize].fx.length;
  if (n == 0) {
    ukDrawText(mut ui, r.x + kit.wmo.th.s3, r.y + (rowH - lh) / 2, "効果はありません（左の「効果」から運んで掛けます）", kit.wmo.th.fsXs, kit.wmo.th.text3);
    out.h = rowH;
    return out;
  }
  for (let k: usize = 0; k < n; k++) {
    const e = ed.project.clips[ci as usize].fx[k].effect;
    ukDrawText(mut ui, r.x + kit.wmo.th.s3, r.y + out.h + (rowH - lh) / 2, railFxLabel(e, ed.fxReg), kit.wmo.th.fsSm, kit.wmo.th.text1);
    out.h = out.h + rowH;
  }
  return out;
}

// 節 n の中身。担当のファイルに振り分ける。
function wcompFxBody(ui: mut UkCtx, ed: E2, kit: E2Kit, v: mut E2View, n: i32, ci: i32, r: UkRect): WcompOut {
  if (n == WCOMP_FX_XFORM) {
    return wcompFxXform(mut ui, ed, kit, mut v, ci, r);
  } else if (n == WCOMP_FX_PEN) {
    return wcompFxPen(mut ui, ed, kit, mut v, ci, r);
  } else if (n == WCOMP_FX_3D) {
    return wcompFxCamera(mut ui, ed, kit, mut v, ci, r);
  } else if (n == WCOMP_FX_SHAPE) {
    return wcompFxShape(mut ui, ed, kit, mut v, ci, r);
  } else if (n == WCOMP_FX_TEXT) {
    return wcompFxText(mut ui, ed, kit, mut v, ci, r);
  } else if (n == WCOMP_FX_PARTICLE) {
    return wcompFxParticle(mut ui, ed, kit, mut v, ci, r);
  } else if (n == WCOMP_FX_KEY) {
    return wcompFxKey(mut ui, ed, kit, mut v, ci, r);
  } else if (n == WCOMP_FX_EFFECTS) {
    return wcompFxEffects(mut ui, ed, kit, ci, r);
  }
  return wcompFxExpr(mut ui, ed, kit, mut v, ci, r);
}

// 右の列の全体（r は L.right。畳んでいれば幅 0）。
export function wcompFxPanel(ui: mut UkCtx, ed: mut E2, kit: E2Kit, v: mut E2View, r: UkRect): void {
  if (r.w <= 0 || r.h <= 0) {
    return;
  }
  ukDrawRect(mut ui, r, kit.wmo.th.bg1);
  ukDrawRect(mut ui, ukRect(r.x, r.y, kit.wmo.th.hair, r.h), kit.wmo.th.line);
  const hdrH = thPx(kit.th, 44);
  const lh = ukLineH(ui, kit.wmo.th.fsMd);
  ukDrawRect(mut ui, ukRect(r.x + kit.wmo.th.hair, r.y, r.w - kit.wmo.th.hair, hdrH), kit.wmo.th.bg2);
  ukDrawRect(mut ui, ukRect(r.x, r.y + hdrH - kit.wmo.th.hair, r.w, kit.wmo.th.hair), kit.wmo.th.line);
  ukDrawText(mut ui, r.x + kit.wmo.th.s4, r.y + kit.wmo.th.s2, "効果のコントロール", kit.wmo.th.fsMd, kit.wmo.th.text1);
  const ci = wcompSel(v);
  let evs: MoEvent[] = [];
  const valid = ci >= 0 && (ci as usize) < ed.project.clips.length;
  if (valid) {
    const k = ed.project.clips[ci as usize].kind;
    ukDrawText(mut ui, r.x + kit.wmo.th.s4, r.y + kit.wmo.th.s2 + lh, `${wcompLayerName(ed.project.clips[ci as usize])}（${wcompKindName(k)}）`,
      kit.wmo.th.fsXs, kit.wmo.th.text3);
  }
  const body = ukRect(r.x + kit.wmo.th.hair, r.y + hdrH, r.w - kit.wmo.th.hair, Math.max(r.h - hdrH, 0));
  if (ukMouseIn(ui, body) && ukWheelAny(ui)) {
    const wy = ui.inp.wheelFY != 0.0 ? ui.inp.wheelFY : (ui.inp.wheelY as f64);
    v.wcomp.fxScroll = Math.max(v.wcomp.fxScroll - Math.floor(wy * (thPx(kit.th, 48) as f64) + 0.5) as i32, 0);
    ukWheelTake(mut ui);
  }
  ukPushClip(mut ui, body);
  let y = body.y - v.wcomp.fxScroll;
  const secH = thPx(kit.th, 28);
  const fsSm = kit.wmo.th.fsSm;
  const slh = ukLineH(ui, fsSm);
  if (!valid) {
    // レイヤーを選んでいないとき: シーンのカメラ（担当が書けば）か、案内
    const cam = wcompFxCamera(mut ui, ed, kit, mut v, -1, ukRect(body.x, y, body.w, 0));
    for (const e of cam.evs) {
      evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
    }
    if (cam.h == 0) {
      ukDrawTextIn(mut ui, ukRect(body.x, y + kit.wmo.th.s4, body.w, secH * 2), "下のレイヤーの一覧か、ビューアでレイヤーを 1 つ選ぶと、", fsSm, kit.wmo.th.text3, 1);
      ukDrawTextIn(mut ui, ukRect(body.x, y + kit.wmo.th.s4 + slh + kit.wmo.th.s2, body.w, secH * 2), "ここにそのプロパティが出ます", fsSm, kit.wmo.th.text3, 1);
    }
    y = y + cam.h;
  } else {
    const kind = ed.project.clips[ci as usize].kind;
    for (let n: i32 = 0; n < WCOMP_FX_COUNT; n++) {
      if (!wcompFxWants(n, kind)) {
        continue;
      }
      const title = wcompFxTitle(n);
      const closed = wcompFxIsClosed(v, title);
      const sr = ukRect(body.x, y, body.w, secH);
      const sh = ukBehavior(mut ui, ukId(ui, "wcomp.fx." + title), sr, false);
      ukDrawRect(mut ui, sr, sh.hover ? kit.wmo.th.bg3 : kit.wmo.th.bg2);
      ukDrawRect(mut ui, ukRect(sr.x, sr.y + sr.h - kit.wmo.th.hair, sr.w, kit.wmo.th.hair), kit.wmo.th.line);
      icnDrawIn(mut ui, mut v.icons, ukRect(sr.x + kit.wmo.th.s2, sr.y, secH, secH), closed ? ICN_CHEV_R : ICN_CHEV_D, 12, kit.wmo.th.text2);
      ukDrawText(mut ui, sr.x + kit.wmo.th.s2 + secH, sr.y + (secH - slh) / 2, title, fsSm, kit.wmo.th.text1);
      if (sh.clicked) {
        wcompFxToggle(mut v, title);
      }
      y = y + secH;
      if (closed) {
        continue;
      }
      const o = wcompFxBody(mut ui, ed, kit, mut v, n, ci, ukRect(body.x + kit.wmo.th.s2, y + kit.wmo.th.s1, body.w - kit.wmo.th.s2 * 2, 0));
      for (const e of o.evs) {
        evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
      }
      if (o.h > 0) {
        y = y + o.h + kit.wmo.th.s2;
      } else if (o.h == 0) {
        ukDrawText(mut ui, body.x + kit.wmo.th.s4 + secH, y + (secH - slh) / 2, "準備中", kit.wmo.th.fsXs, kit.wmo.th.text3);
        y = y + secH;
      }
    }
  }
  ukPopClip(mut ui);
  const contentH = y + v.wcomp.fxScroll - body.y;
  v.wcomp.fxScroll = Math.max(Math.min(v.wcomp.fxScroll, contentH - body.h + secH), 0);
  wcompHandle(mut ed, mut v, evs, ci);
}
