// 高密度の画面（HiDPI）: 編集画面とスタート画面を、ウィンドウの画素の大きさのままくっきり描くための値。
//
// - 描く Buffer はウィンドウの画素の大きさ（windowPixelSize）。OS はこれを引き伸ばさずに出す。
// - 部品の倍率は 利用者の倍率 × 画面の表示の倍率（windowDisplayScale）。部品は画面の上で同じ大きさのまま、くっきりする。
// - マウスの位置はウィンドウの座標で来るので、画素の密度（windowPixelDensity）倍にする（ui.winDensity。kit/window.um）。
// 窓が別の画面へ移って密度や倍率が変わっても、大きさの変わりのイベントが来るとは限らないので、毎フレーム問い合わせる
// （どれも SDL の値を読むだけで軽い）。
//
// 試し用の --density <倍率>: OS の値の代わりに、その密度の画面だと思って描く（offscreen の SDL は密度 1 しか返さない
// ので、Retina の描き方を試すため）。Buffer はウィンドウの大きさ × 倍率、表示の倍率も同じ倍率にする。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は e2Dpi で始める。
import { UkCtx, ukInvalidate } from "../ui/kit/core.um";
import { thToUk } from "../ui/theme_uk.um";
import { E2Kit, e2KitNew } from "./e2_view.um";

export struct E2Dpi {
  // 試し用の --density（0 なら OS の値を使う）
  fake: f64;
  // ウィンドウの座標 1 あたりの画素の数
  density: f64;
  // 画面の表示の倍率（部品の倍率に掛ける）
  disp: f32;
  // 描く Buffer の画素の大きさ
  pw: i32;
  ph: i32;
}

export function e2DpiNew(fake: f64): E2Dpi {
  return { fake, density: 1.0, disp: 1.0, pw: 0, ph: 0 };
}

// 倍率を 1/100 に丸める（OS の値の小さな揺れで部品を作り直さないように）。
function e2DpiRound(v: f64): f64 {
  if (v <= 0.0) {
    return 1.0;
  }
  return Math.floor(v * 100.0 + 0.5) / 100.0;
}

// 今の値を問い合わせる。W・H はウィンドウの座標の大きさ（大きさの変わりのイベントで知ったもの）。
export function e2DpiUpdate(d: mut E2Dpi, win: i32, W: i32, H: i32): void {
  if (d.fake > 0.0) {
    d.density = d.fake;
    d.disp = d.fake as f32;
    d.pw = Math.max(Math.floor((W as f64) * d.fake + 0.5) as i32, 1);
    d.ph = Math.max(Math.floor((H as f64) * d.fake + 0.5) as i32, 1);
    return;
  }
  d.density = e2DpiRound(windowPixelDensity(win));
  d.disp = e2DpiRound(windowDisplayScale(win)) as f32;
  const ps = windowPixelSize(win);
  if (ps.width > 0 && ps.height > 0) {
    d.pw = ps.width;
    d.ph = ps.height;
  } else {
    d.pw = Math.max(Math.floor((W as f64) * d.density + 0.5) as i32, 1);
    d.ph = Math.max(Math.floor((H as f64) * d.density + 0.5) as i32, 1);
  }
}

// 画面の表示の倍率が kit を作ったときと違えば、部品のテーマと大きさを作り直す（フレームの外で）。作り直したら true。
// 利用者の倍率（kit.userScale）はそのまま。
export function e2DpiRescale(ui: mut UkCtx, kit: mut E2Kit, d: E2Dpi, home: string): bool {
  ui.winDensity = d.density;
  if (Math.abs(kit.dispScale - d.disp) < 0.001) {
    return false;
  }
  kit = e2KitNew(home, kit.userScale, d.disp);
  ui.theme = thToUk(kit.th);
  ukInvalidate(mut ui);
  return true;
}
