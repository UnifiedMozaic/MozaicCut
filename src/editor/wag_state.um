// AI（src/ai/）をつなぐ所の状態。E2View.ag に入れる（wire_ai.um と rail_ai.um だけが書き換える）。
// E2View から読むので、このファイルは e2_* を読まない。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wag / Wag / WAG で始める。
import { AgConfig, agConfigLoad, agConfigPath } from "../ai/ai_config.um";
import { AgAgent, agNew } from "../ai/ai_agent.um";
import { AgWatch } from "../ai/ai_external.um";
import { AgBook, agBookLoad, agBookPath } from "../ai/ai_usage.um";

// Claude Code の編集の、まだ取り消しの行に付けていない 1 文（e2Poll の読み直しより先に history が届いたとき）。
export struct WagExt {
  desc: string;
  at: f64;
}

// HTTP の口（AgHttp）は edit2.um の輪が持ち、wireAiTick に渡す（エージェントと同じ値の中に置くと、1 つの呼び出しに
// 両方を mut で渡せないため）。部品の出来事から頼むものは、ここに積んで次の wireAiTick で送る。
export struct WagState {
  cfgPath: string;
  cfg: AgConfig;
  agent: AgAgent;
  // 使った量の月ごとの記録（ai-usage.json。ai.json と同じフォルダ）
  bookPath: string;
  book: AgBook;
  // AI の欄の提案（v.ai.proposals）の番号 → agent.proposals の番号
  propMap: i32[];
  // Claude Code（外の AI）の編集を拾う口（開いたプロジェクトのパス。違えば作り直す）
  watch: AgWatch;
  watchPath: string;
  watchAt: f64;
  ext: WagExt[];
  // 次の wireAiTick で行うこと
  askWant: bool;
  askText: string;      // AI に送る文（直してほしい点なら、提案の ID を頭に付けたもの）
  stopWant: bool;
  testWant: bool;
  modelsWant: bool;
  // ---- 設定の AI の節（rail_ai.um） ----
  keyDraft: string;     // API キーの欄に打っている途中の文字（確定したら cfg.apiKey に入れて空にする）
  okeyDraft: string;    // OpenAI 互換のキー
  models: string[];     // Ollama / OpenAI 互換の［一覧を取る］の結果
  modelsReq: i32;       // 一覧を取っている頼み（0 はなし）
  modelsBody: string;
  modelsNote: string;
  testReq: i32;         // ［つながるか確かめる］の頼み（0 はなし）
  testBody: string;
  testStatus: i32;
  testNote: string;
  testOk: bool;
  saveNote: string;
}

export function wagStateNew(): WagState {
  const path = agConfigPath();
  const cfg = agConfigLoad(path);
  const agent = agNew(cfg);
  const bookPath = agBookPath(path);
  const book = agBookLoad(bookPath);
  return {
    cfgPath: path, cfg, agent, bookPath, book, propMap: [],
    watch: { path: "", histPath: "", ownText: "", histPos: 0 }, watchPath: "", watchAt: 0.0, ext: [],
    askWant: false, askText: "", stopWant: false, testWant: false, modelsWant: false,
    keyDraft: "", okeyDraft: "", models: [], modelsReq: 0, modelsBody: "", modelsNote: "", testReq: 0, testBody: "",
    testStatus: 0, testNote: "", testOk: false, saveNote: "",
  };
}
