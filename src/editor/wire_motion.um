// M6 の操作の画面（src/workspaces/motion/。docs/design/motion.md）を新しい編集画面につなぐ所。docs/design/edit2.md の「M6 の操作の画面の配線」。
//
// - wmoTick（edit2.um が e2Frame の初め、タイムラインのキー wireTimelineKeys より前に呼ぶ）:
//   タイムラインのクリップの上のキーフレームの印（moKfOnClip）と、タイムラインの上に開くグラフエディタ（moGraph）、
//   モニターの上の変形のギズモ（moGizmo）と点の編集（moPoints）。
//   部品（tlTimeline）より先に押しを取るため、部品より前に呼び、上の層（WMO_LAYER）に描いて部品の上に重ねる。
//   選んだキーの Delete も、タイムラインの Delete（クリップを消す）より先に取る。
// - wmoInspectorPrep（wireInspectorPrep、インスペクタを描く前）と wmoInspector（wireInspector の初め）: インスペクタの ◇ ◀ ◆ ▶。
// - wmoTimeline・wmoMonitor（各配線の関数の初めに 1 行ずつ）: 部品を描いた直後の口。いまは何もしない。
//
// 部品の出来事（MoEvent）の受け方（motion.md の「出来事」）:
//   MO_E_OP は e2ApplyOps（1 つの取り消し）、MO_E_PREVIEW は ed.lines に当てた写しで ed.project を入れ替えて描き直す
//   （保存も履歴もしない。離したときの MO_E_OP か、やめたときの MO_E_CANCEL で読み直す）、MO_E_SEEK は E2_PB_SEEK、
//   MO_E_SELECT は v.wmo.prop（グラフに出すキー）と、そのクリップの選択。
// 状態は v.wmo（wmo_state.um の WmoState）、テーマは kit.wmo.th（MoTheme）。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は wmo / Wmo で始める。
import {
  UkCtx, ukPushClip, ukPopClip, ukPushLayer, ukPopLayer, ukMouseIn, ukBehavior, ukId, ukIdInt, ukBlock, ukDrawRect, ukDrawRound,
  ukDrawText, ukDrawTextIn, ukTextW, ukLineH, ukTooltip, UK_MOD_ALT,
} from "../ui/kit/core.um";
import { UkRect, ukRect, ukIntersect, ukEmpty } from "../ui/kit/base.um";
import { MonAct, MON_PROGRAM } from "../ui/monitor/monitor.um";
import {
  InsEvent, insSetKf, insSetRowValue, insToDb, INS_M_CLIP, INS_KF_NONE, INS_KF_OFF, INS_KF_ON, INS_E_SET, INS_E_PREVIEW, INS_E_KF_TOGGLE, INS_E_KF_PREV,
  INS_E_KF_NEXT, INS_E_KF_HERE,
} from "../ui/inspector/ins_model.um";
import { tlSyncSel } from "../ui/timeline/tl_model.um";
import { TlGeo, tlGeo, tlX, tlRowArea } from "../ui/timeline/tl_geo.um";
import { tlPx } from "../ui/timeline/tl_theme.um";
import { Project, Clip, Diag, parseProject, findClip, KIND_SHAPE, POS_CENTER, UNSET } from "../engine/project.um";
import { runOps, splitArgs } from "../engine/ops.um";
import {
  MoEvent, MoView, MoTheme, moEv, moFps, moSnap, moNum, moRef, moIsVisual, moAnimIndex, moKeyAt, moValueText, moOpValue, moParseVals, MO_E_OP,
  MO_E_PREVIEW, MO_E_SEEK, MO_E_SELECT, MO_E_CANCEL,
} from "../workspaces/motion/mo_core.um";
import { moNeighborKey } from "../workspaces/motion/mo_keynav.um";
import { moKfStateNew, moKfOnClip, moKfMenu } from "../workspaces/motion/mo_kflane.um";
import { moGraph } from "../workspaces/motion/mo_graph.um";
import { moGizmo, moGizmoBusy } from "../workspaces/motion/mo_gizmo.um";
import { moPoints, moPointsBusy } from "../workspaces/motion/mo_points.um";
import { moClipAtPoint, moClipXfSized, MoXf } from "../workspaces/motion/mo_geom.um";
import { E2, e2ApplyOps, e2Reparse, e2PbRequest, e2SetStatus, e2Bytes, E2_PB_SEEK } from "./e2_state.um";
import { E2Kit, E2View, e2ViewSync, E2_WS_EDIT } from "./e2_view.um";
import { WmoState } from "./wmo_state.um";

// 印を描く層（部品の地の層 0 より上、ドラッグの影 UK_L_FLOAT より下）。上の層は、ポップアップに覆われていなければ先に押しを取れる。
const WMO_LAYER: i32 = 1;

// ---- 出来事 ----

// 部品のどれかがドラッグの途中か。
function wmoBusy(s: WmoState): bool {
  return s.kf.dragKey != "" || s.graph.dragging || moGizmoBusy(s.giz) || moPointsBusy(s.pts);
}

function wmoJoin(lines: string[], crlf: bool): string {
  let out: u8[] = [];
  for (const l of lines) {
    for (const b of l) {
      out.push(b);
    }
    if (crlf) {
      out.push(13);
    }
    out.push(10);
  }
  return stringFromBytes(out);
}

// ops を ed.lines に当てた写しを ed.project に入れる（ドラッグの途中に見せるだけ。保存も履歴もしない）。
// 当てられない・誤りが出る・クリップの数が変わる（部品の索引がずれる）ときは見せない。
// mark なら M6 の部品のドラッグとして覚える（離したのに操作が来なければ wmoTick が読み直す）。インスペクタの値のドラッグは、
// インスペクタの配線と同じく覚えない（離したときの操作が読み直す）。
function wmoPreview(ed: mut E2, s: mut WmoState, ops: string[], mark: bool): void {
  if (ops.length == 0) {
    return;
  }
  let words: string[][] = [];
  for (const o of ops) {
    words.push(splitArgs(o));
  }
  const res = runOps(ed.lines, ed.probes, words);
  if (!res.ok) {
    return;
  }
  let err: Diag[] = [];
  const p = parseProject(e2Bytes(wmoJoin(res.lines, ed.crlf)), ed.probes, mut err);
  for (const d of err) {
    if (d.severity == "error" && d.code != "missing-source") {
      return;
    }
  }
  if (p.clips.length != ed.project.clips.length) {
    return;
  }
  ed.project = p;
  ed.pbStale = true;
  ed.previewDirty = true;
  if (mark) {
    s.preview = true;
  }
}

// 見せていた写しをやめて、ファイルの中身に戻す。
function wmoEndPreview(ed: mut E2, s: mut WmoState): void {
  if (s.preview) {
    s.preview = false;
    e2Reparse(mut ed);
  }
}

// クリップ ci だけを選ぶ（インスペクタは e2ViewSync が作り直す）。
function wmoSelectClip(v: mut E2View, ci: i32): void {
  if (v.tl.sel.length == 1 && v.tl.sel[0] == ci) {
    return;
  }
  v.tl.sel = [ci];
  tlSyncSel(mut v.tl);
}

// 部品の出来事を当てる。ci は出来事を出したクリップ（-1 なら分からない）。
function wmoHandle(ed: mut E2, v: mut E2View, evs: MoEvent[], ci: i32): void {
  for (const e of evs) {
    if (e.kind == MO_E_OP) {
      const ver0 = ed.ver;
      e2ApplyOps(mut ed, e.ops);
      // 当てられなかった・何も変わらなかったときは e2ApplyOps が読み直さないので、見せていた写しをここで捨てる
      if (ed.ver == ver0) {
        wmoEndPreview(mut ed, mut v.wmo);
      }
      v.wmo.preview = false;
    } else if (e.kind == MO_E_PREVIEW) {
      wmoPreview(mut ed, mut v.wmo, e.ops, true);
    } else if (e.kind == MO_E_CANCEL) {
      wmoEndPreview(mut ed, mut v.wmo);
    } else if (e.kind == MO_E_SEEK) {
      e2PbRequest(mut ed, E2_PB_SEEK, Math.max(e.t, 0.0));
    } else if (e.kind == MO_E_SELECT) {
      if (e.text != "") {
        v.wmo.prop = e.text.clone();
      }
      if (ci >= 0) {
        wmoSelectClip(mut v, ci);
      }
    }
  }
}

// ---- タイムラインのクリップの上のキーフレームの印 ----

function wmoTimelineMarks(ui: mut UkCtx, ed: mut E2, kit: E2Kit, v: mut E2View, g: TlGeo): void {
  // 選んだキーのクリップを、ほかのクリップに選び直したら、キーの選択を外す
  if (v.wmo.kfClip >= 0 && v.wmo.kf.dragKey == "") {
    let still = false;
    for (const i of v.tl.sel) {
      if (i == v.wmo.kfClip) {
        still = true;
      }
    }
    if (!still || (v.wmo.kfClip as usize) >= ed.project.clips.length) {
      v.wmo.kf = moKfStateNew();
      v.wmo.kfClip = -1;
    }
  }
  const fps = moFps(ed.project);
  const pps = v.tl.pps;
  const m = tlPx(g.sc, 2.0);
  let evs: MoEvent[] = [];
  let evClip: i32 = -1;
  ukPushLayer(mut ui, WMO_LAYER);
  for (let it: usize = 0; it < v.tl.items.length; it++) {
    const ci = v.tl.items[it].clip;
    if (v.tl.items[it].audioPart || ci < 0 || (ci as usize) >= ed.project.clips.length) {
      continue;
    }
    if (ed.project.clips[ci as usize].anims.length == 0) {
      continue;
    }
    const row = v.tl.items[it].row as usize;
    const area = ukIntersect(tlRowArea(v.tl, g, row), g.lanes);
    const x0 = tlX(v.tl, g, v.tl.items[it].s);
    const x1 = tlX(v.tl, g, v.tl.items[it].e);
    let y = g.rowY[row] + m;
    let h = g.rowH[row] - m * 2;
    const half = v.tl.items[it].half;
    if (half == 1) {
      h = h / 2;
    } else if (half == 2) {
      y = y + h / 2;
      h = h - h / 2;
    }
    const cr = ukRect(x0, y, Math.max(x1 - x0, 2), h);
    if (ukEmpty(ukIntersect(cr, area))) {
      continue;
    }
    ukPushClip(mut ui, area);
    let ke: MoEvent[] = [];
    if (v.wmo.kfClip == ci) {
      ke = moKfOnClip(mut ui, kit.wmo.th, ed.project.clips[ci as usize], cr, pps, fps, mut v.wmo.kf);
    } else {
      let tmp = moKfStateNew();
      ke = moKfOnClip(mut ui, kit.wmo.th, ed.project.clips[ci as usize], cr, pps, fps, mut tmp);
      // このクリップのキーを押した・選んだ: 状態をこのクリップのものにする
      if (tmp.dragKey != "" || tmp.selKey != "") {
        v.wmo.kf = tmp;
        v.wmo.kfClip = ci;
      }
    }
    ukPopClip(mut ui);
    for (const e of ke) {
      evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
      evClip = ci;
    }
  }
  ukPopLayer(mut ui);
  // キーの右クリックのメニュー（イーズ）。クリップの切り取りの外で描く
  if (v.wmo.kfClip >= 0 && (v.wmo.kfClip as usize) < ed.project.clips.length) {
    const me = moKfMenu(mut ui, ed.project.clips[v.wmo.kfClip as usize], mut v.wmo.kf);
    for (const e of me) {
      evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
      evClip = v.wmo.kfClip;
    }
  }
  wmoHandle(mut ed, mut v, evs, evClip);
}

// ---- モニターの上の変形のギズモと点の編集 ----

// 選んだクリップ（1 つだけのとき）が、再生ヘッドの所で見えていれば、点の編集 → ギズモの順に描く（点は枠の中にあるので先に取る）。
// 何もない所・ほかのクリップを押したら、その点にあるクリップを選ぶ（押しはモニターにも渡す。ずらす・フォーカスを外す）。
function wmoMonitorMarks(ui: mut UkCtx, ed: mut E2, kit: E2Kit, v: mut E2View): void {
  if (v.mon.tab != MON_PROGRAM || v.mon.twoUp || ed.project.width <= 0) {
    return;
  }
  const pr = v.mon.picR;
  const vr = v.mon.viewR;
  if (pr.w <= 0 || pr.h <= 0 || vr.w <= 0 || vr.h <= 0) {
    return;
  }
  const view: MoView = { ox: pr.x as f64, oy: pr.y as f64, s: (pr.w as f64) / (ed.project.width as f64) };
  const fps = moFps(ed.project);
  const t = moSnap(ed.t, fps);
  let evs: MoEvent[] = [];
  let sel: i32 = -1;
  if (v.tl.sel.length == 1) {
    sel = v.tl.sel[0];
  }
  ukPushLayer(mut ui, WMO_LAYER);
  ukPushClip(mut ui, vr);
  if (sel >= 0 && (sel as usize) < ed.project.clips.length && moIsVisual(ed.project.clips[sel as usize].kind)) {
    const ci = sel as usize;
    const lt = t - ed.project.clips[ci].at;
    if (lt >= 0.0 && lt <= ed.project.clips[ci].dur) {
      const pe = moPoints(mut ui, kit.wmo.th, ed.project, ed.lines, ci, lt, view, mut v.wmo.pts);
      for (const e of pe) {
        evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
      }
      const xs = wmoMediaSizes(ed);
      const ge = moGizmo(mut ui, kit.wmo.th, ed.project, ci, lt, xs[ci * 2], xs[ci * 2 + 1], view, vr, mut v.wmo.giz);
      for (const e of ge) {
        evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
      }
    }
  }
  // 点とギズモが取らなかった押し: その点のクリップを選ぶ
  if ((ui.inp.pressed & 1) != 0 && ui.active == 0 && ukMouseIn(ui, pr) && !moGizmoBusy(v.wmo.giz) && !moPointsBusy(v.wmo.pts)) {
    const cx = ((ui.inp.mx as f64) - view.ox) / view.s;
    const cy = ((ui.inp.my as f64) - view.oy) / view.s;
    const hit = moClipAtPoint(ed.project, t, cx, cy, wmoMediaSizes(ed));
    if (hit >= 0) {
      wmoSelectClip(mut v, hit);
    }
  }
  ukPopClip(mut ui);
  ukPopLayer(mut ui);
  wmoHandle(mut ed, mut v, evs, sel);
}

// ---- グラフエディタ（タイムラインの上に開く札） ----
// ルーラーの左の隅（トラックの見出しの上）に「グラフ」の札を置き、押すとタイムラインのトラックの所に重ねてグラフエディタを開く
// （ルーラーと帯は見えたまま。もう一度札を押すか、右の［閉じる］で閉じる）。出すのは選んだクリップ（1 つ）の、
// 上の段の札で選んだキー（MO_E_SELECT・タイムラインの印を押したときのキーでも替わる）。

// 札の四角（ルーラーの左の隅の右寄せ）。
function wmoGraphTabRect(ui: mut UkCtx, th: MoTheme, g: TlGeo): UkRect {
  const w = ukTextW(mut ui, "グラフ", th.fsXs) + tlPx(g.sc, 20.0);
  const h = Math.max(g.ruler.h - tlPx(g.sc, 8.0), 12);
  return ukRect(g.ruler.x + g.hdrW - w - tlPx(g.sc, 8.0), g.ruler.y + (g.ruler.h - h) / 2, w, h);
}

function wmoGraphTab(ui: mut UkCtx, kit: E2Kit, v: mut E2View, g: TlGeo): void {
  const r = wmoGraphTabRect(mut ui, kit.wmo.th, g);
  const h = ukBehavior(mut ui, ukId(ui, "wmo.graph.tab"), r, false);
  let bg = kit.wmo.th.bg3;
  let fg = kit.wmo.th.text2;
  if (v.wmo.graphOpen) {
    bg = kit.wmo.th.accentTint;
    fg = kit.wmo.th.accent;
  } else if (h.hover) {
    bg = kit.wmo.th.bg4;
    fg = kit.wmo.th.text1;
  }
  ukDrawRound(mut ui, r, 3, bg);
  ukDrawTextIn(mut ui, r, "グラフ", kit.wmo.th.fsXs, fg, 1);
  if (v.wmo.graphOpen) {
    ukTooltip(mut ui, "グラフエディタを閉じる");
  } else {
    ukTooltip(mut ui, "グラフエディタを開く（選んだクリップのキーフレームのカーブ）");
  }
  if (h.clicked) {
    v.wmo.graphOpen = !v.wmo.graphOpen;
  }
}

// グラフエディタの欄。トラックの所（見出しを含む幅、ルーラーの下から横のスクロールまで）に重ねる。
function wmoGraphPanel(ui: mut UkCtx, ed: mut E2, th: MoTheme, v: mut E2View, g: TlGeo): void {
  const sc = g.sc;
  const pr = ukRect(g.r.x, g.lanes.y, g.lanes.x + g.lanes.w - g.r.x, g.r.y + g.r.h - g.lanes.y);
  if (pr.w <= 0 || pr.h <= 0) {
    return;
  }
  // 下の層（タイムラインの部品）に、この四角の中の押しを渡さない（次のフレームから効く）
  ukBlock(mut ui, pr);
  ukDrawRect(mut ui, pr, th.bg1);
  ukDrawRect(mut ui, ukRect(pr.x, pr.y, pr.w, th.hair), th.lineStrong);
  // 上の段: キーの札と［閉じる］
  const rowH = tlPx(sc, 26.0);
  const top = ukRect(pr.x, pr.y + th.hair, pr.w, rowH);
  ukDrawRect(mut ui, top, th.bg2);
  const lh = ukLineH(ui, th.fsSm);
  let x = top.x + th.s3;
  x = x + ukDrawText(mut ui, x, top.y + (rowH - lh) / 2, "グラフエディタ", th.fsSm, th.text1) + th.s4;
  // ［閉じる］
  const cw = ukTextW(mut ui, "閉じる", th.fsXs) + tlPx(sc, 16.0);
  const cr = ukRect(top.x + top.w - cw - th.s3, top.y + tlPx(sc, 4.0), cw, rowH - tlPx(sc, 8.0));
  const ch = ukBehavior(mut ui, ukId(ui, "wmo.graph.close"), cr, false);
  let cbg = th.bg3;
  if (ch.hover) {
    cbg = th.bg4;
  }
  ukDrawRound(mut ui, cr, 3, cbg);
  ukDrawTextIn(mut ui, cr, "閉じる", th.fsXs, th.text1, 1);
  if (ch.clicked) {
    v.wmo.graphOpen = false;
  }
  const body = ukRect(pr.x, top.y + rowH, pr.w, pr.y + pr.h - (top.y + rowH));
  // 出すクリップ: タイムラインで選んだ 1 つ
  let ci: i32 = -1;
  if (v.tl.sel.length == 1 && v.tl.sel[0] >= 0 && (v.tl.sel[0] as usize) < ed.project.clips.length) {
    ci = v.tl.sel[0];
  }
  if (ci < 0) {
    ukDrawTextIn(mut ui, body, "クリップを 1 つ選ぶと、キーフレームのカーブが出ます", th.fsMd, th.text2, 1);
    return;
  }
  const c = ci as usize;
  if (ed.project.clips[c].anims.length == 0) {
    ukDrawTextIn(mut ui, body, `${moRef(ed.project.clips[c])} にはキーフレームがありません。インスペクタの ◇ でキーを打ちます`, th.fsMd, th.text2, 1);
    return;
  }
  // 出すキー: 選んだキーがこのクリップになければ、キーフレームのある最初のキー
  if (moAnimIndex(ed.project.clips[c], v.wmo.prop) < 0) {
    v.wmo.prop = ed.project.clips[c].anims[0].key.clone();
  }
  // キーの札
  ukDrawText(mut ui, x, top.y + (rowH - lh) / 2, moRef(ed.project.clips[c]), th.fsSm, th.text2);
  x = x + ukTextW(mut ui, moRef(ed.project.clips[c]), th.fsSm) + th.s3;
  for (let i: usize = 0; i < ed.project.clips[c].anims.length; i++) {
    const k = ed.project.clips[c].anims[i].key.clone();
    const w = ukTextW(mut ui, k, th.fsXs) + tlPx(sc, 16.0);
    if (x + w > cr.x - th.s3) {
      break;
    }
    const kr = ukRect(x, top.y + tlPx(sc, 4.0), w, rowH - tlPx(sc, 8.0));
    const kh = ukBehavior(mut ui, ukIdInt(ui, "wmo.graph.key", i as i32), kr, false);
    const on = k == v.wmo.prop;
    let bg = th.bg3;
    let fg = th.text2;
    if (on) {
      bg = th.accentTint;
      fg = th.accent;
    } else if (kh.hover) {
      bg = th.bg4;
      fg = th.text1;
    }
    ukDrawRound(mut ui, kr, 3, bg);
    ukDrawTextIn(mut ui, kr, k, th.fsXs, fg, 1);
    if (kh.clicked) {
      v.wmo.prop = k.clone();
    }
    x = x + w + th.s1;
  }
  const fps = moFps(ed.project);
  const lt = moSnap(ed.t, fps) - ed.project.clips[c].at;
  const prop = v.wmo.prop.clone();
  ukPushClip(mut ui, body);
  const ge = moGraph(mut ui, th, ed.project.clips[c], prop, body, lt, fps, mut v.wmo.graph);
  ukPopClip(mut ui);
  let evs: MoEvent[] = [];
  for (const e of ge) {
    evs.push(moEv(e.kind, e.ops, e.t, e.n, e.text));
  }
  wmoHandle(mut ed, mut v, evs, ci);
}

// ---- インスペクタの ◇ ◀ ◆ ▶ ----
// インスペクタの部品（ui_inspector）は、行の右に ◇ と ◀ ◆ ▶ を自分で描き、押すと INS_E_KF_* を返す（行の四角は外に出さない）。
// そこで moKeyNav を重ねて描く代わりに、その出来事を moKeyNav と同じ操作にする。行の印（◇ か ◀ ◆ ▶ か、再生ヘッドにキーがあるか）は
// wmoInspectorPrep が毎フレーム描く前に insSetKf で入れる。

// インスペクタの行のキー → .mzc のキー。「位置 X」「位置 Y」の行（key は x と y）は、どちらも x と y の 2 つ
// （1 つの◇で位置のキーを打つ。shape の pos= か pos のキーフレームなら pos）。
function wmoRowKeys(c: Clip, rowKey: string): string[] {
  if (rowKey == "x" || rowKey == "y") {
    if (moAnimIndex(c, "pos") >= 0 || (c.kind == KIND_SHAPE && c.shape.posSet)) {
      return ["pos"];
    }
    return ["x", "y"];
  }
  return [rowKey.clone()];
}

// クリップごとの展開した素材の幅と高さ（[w0, h0, w1, h1, ...]。開けていないものは 0）。
function wmoMediaSizes(ed: E2): i32[] {
  let out: i32[] = [];
  for (let i: usize = 0; i < ed.project.clips.length; i++) {
    if (i < ed.media.length && ed.media[i].ok) {
      out.push(ed.media[i].w);
      out.push(ed.media[i].h);
    } else {
      out.push(0);
      out.push(0);
    }
  }
  return out;
}

// クリップ ci の変形（video / image は展開した素材の大きさで。w= のない画像は素材の大きさで置かれるため）。
function wmoXf(ed: E2, ci: usize, lt: f64): MoXf {
  let mw = 0;
  let mh = 0;
  if (ci < ed.media.length && ed.media[ci].ok) {
    mw = ed.media[ci].w;
    mh = ed.media[ci].h;
  }
  return moClipXfSized(ed.project, ci, lt, mw, mh);
}

// key add に渡す今の値。x / y がキーフレームでない行（真ん中に置いたクリップ、右端からの負の値など）は、
// 置いた箱の左上の画素（キーフレームの x / y は左上からの画素なので、そのまま書くと位置が飛ぶ）。
function wmoKeyValue(ed: E2, ci: usize, line: string, key: string, lt: f64): string {
  if ((key == "x" || key == "y") && moAnimIndex(ed.project.clips[ci], key) < 0) {
    const xf = wmoXf(ed, ci, lt);
    if (xf.ok && !xf.usePos) {
      if (key == "x") {
        return moNum(xf.left, 0);
      }
      return moNum(xf.top, 0);
    }
  }
  return moValueText(ed.project.clips[ci], line, key, lt);
}

// インスペクタが 1 つのクリップを出しているなら、その番号（でなければ -1）。
function wmoInsClip(ed: E2, kit: E2Kit): i32 {
  if (kit.insModel.mode != INS_M_CLIP || kit.insModel.refs.length != 1) {
    return -1;
  }
  return findClip(ed.project, kit.insModel.refs[0]);
}

// wireInspectorPrep（インスペクタを描く前）が呼ぶ: キーフレームの行の印を、いまのクリップと再生ヘッドに合わせる。
export function wmoInspectorPrep(ed: E2, kit: mut E2Kit): void {
  const ci = wmoInsClip(ed, kit);
  if (ci < 0) {
    return;
  }
  const c = ci as usize;
  const fps = moFps(ed.project);
  const lt = moSnap(ed.t, fps) - ed.project.clips[c].at;
  const rows: string[] = ["x", "y", "opacity", "volume"];
  for (const rk of rows) {
    let on = false;
    let at = false;
    for (const k of wmoRowKeys(ed.project.clips[c], rk)) {
      if (moAnimIndex(ed.project.clips[c], k) >= 0) {
        on = true;
        if (moKeyAt(ed.project.clips[c], k, lt, fps) >= 0) {
          at = true;
        }
      }
    }
    let st = INS_KF_OFF;
    if (on) {
      st = INS_KF_ON;
    }
    insSetKf(mut kit.insModel, rk, st, at);
  }
  // キーフレームのある行は、再生ヘッドの時刻の値を出す（クリップの行に書いた 0 秒の値ではなく）
  wmoInsAnimValues(ed, mut kit, c, lt);
  // 中央に置いた位置: 「中央」と出したまま、打ち込みとスクラブが始まる値を実際の左上の画素にする
  if (moAnimIndex(ed.project.clips[c], "x") < 0 && moAnimIndex(ed.project.clips[c], "pos") < 0) {
    const cx = ed.project.clips[c].x == POS_CENTER || ed.project.clips[c].x == UNSET;
    const cy = ed.project.clips[c].y == POS_CENTER || ed.project.clips[c].y == UNSET;
    if (cx || cy) {
      const xf = wmoXf(ed, c, lt);
      if (xf.ok && !xf.usePos && !xf.shape) {
        if (cx) {
          insSetRowValue(mut kit.insModel, "x", Math.floor(xf.left), "中央");
        }
        if (cy && moAnimIndex(ed.project.clips[c], "y") < 0) {
          insSetRowValue(mut kit.insModel, "y", Math.floor(xf.top), "中央");
        }
      }
    }
  }
  // 幅・文字の大きさは .mzc でキーフレームにできない（ops の key add が断る）ので ◇ を出さない
  insSetKf(mut kit.insModel, "w", INS_KF_NONE, false);
  insSetKf(mut kit.insModel, "size", INS_KF_NONE, false);
}

// キーフレームのある位置・不透明度・音量の行に、時刻 lt（クリップの始まりから）の値を入れる（表示の単位に直して）。
function wmoInsAnimValues(ed: E2, kit: mut E2Kit, c: usize, lt: f64): void {
  const li = ed.project.clips[c].line - 1;
  if (li < 0 || (li as usize) >= ed.lines.length) {
    return;
  }
  const line = ed.lines[li as usize].clone();
  if (moAnimIndex(ed.project.clips[c], "pos") >= 0) {
    const pv = moParseVals(moValueText(ed.project.clips[c], line, "pos", lt));
    if (pv.length >= 2) {
      insSetRowValue(mut kit.insModel, "x", pv[0], "");
      insSetRowValue(mut kit.insModel, "y", pv[1], "");
    }
  }
  const keys: string[] = ["x", "y", "opacity", "volume"];
  for (const k of keys) {
    if (moAnimIndex(ed.project.clips[c], k) < 0) {
      continue;
    }
    const vs = moParseVals(moValueText(ed.project.clips[c], line, k, lt));
    if (vs.length == 0) {
      continue;
    }
    let v = vs[0];
    if (k == "opacity") {
      v = v * 100.0;
    } else if (k == "volume") {
      v = insToDb(v);
    }
    insSetRowValue(mut kit.insModel, k, v, "");
  }
}

// ◇ ◆ ◀ ▶ の 1 つの出来事を、ops か再生ヘッドの移動にする（moKeyNav と同じ）。
function wmoInsKf(ed: mut E2, kind: i32, rowKey: string, ci: usize, alt: bool): void {
  const fps = moFps(ed.project);
  const lt = moSnap(ed.t, fps) - ed.project.clips[ci].at;
  const keys = wmoRowKeys(ed.project.clips[ci], rowKey);
  const ref = moRef(ed.project.clips[ci]);
  if (kind == INS_E_KF_PREV || kind == INS_E_KF_NEXT) {
    let dir = 1;
    if (kind == INS_E_KF_PREV) {
      dir = -1;
    }
    let best = 0.0 / 0.0;
    for (const k of keys) {
      const t = moNeighborKey(ed.project.clips[ci], k, lt, fps, dir);
      if (t == t && (best != best || (dir < 0 && t > best) || (dir > 0 && t < best))) {
        best = t;
      }
    }
    if (best == best) {
      e2PbRequest(mut ed, E2_PB_SEEK, ed.project.clips[ci].at + best);
    }
    return;
  }
  if (lt < 0.0 || lt > ed.project.clips[ci].dur) {
    e2SetStatus(mut ed, "再生ヘッドがクリップの外にあるので、キーを打てません", false);
    return;
  }
  const line = ed.lines[(ed.project.clips[ci].line - 1) as usize].clone();
  let ops: string[] = [];
  let anyAt = false;
  for (const k of keys) {
    if (moKeyAt(ed.project.clips[ci], k, lt, fps) >= 0) {
      anyAt = true;
    }
  }
  for (const k of keys) {
    const ai = moAnimIndex(ed.project.clips[ci], k);
    if (ai >= 0 && alt) {
      // キーフレームをやめる（今の値をふつうの値で残す）
      ops.push(`key clear ${ref} ${k} ${moNum(lt, 4)}`);
    } else if (anyAt) {
      const kAt = moKeyAt(ed.project.clips[ci], k, lt, fps);
      if (kAt >= 0) {
        if (ed.project.clips[ci].anims[ai as usize].track.keys.length <= 1) {
          ops.push(`key clear ${ref} ${k}`);
        } else {
          ops.push(`key remove ${ref} ${k} #${kAt}`);
        }
      }
    } else {
      ops.push(`key add ${ref} ${k} ${moNum(lt, 4)} ${wmoKeyValue(ed, ci, line, k, lt)}`);
    }
  }
  if (ops.length > 0) {
    e2ApplyOps(mut ed, ops);
  }
}

// 空白・引用符・# を含む値は引用符で囲む（splitArgs で分けた語を op の文に戻す）。
function wmoQuoteArg(s: string): string {
  let need = false;
  for (const b of s) {
    if (b == 32 || b == 34 || b == 35) {
      need = true;
    }
  }
  if (!need) {
    return s.clone();
  }
  let out: u8[] = [34];
  for (const c of s) {
    if (c == 34 || c == 92) {
      out.push(92);
    }
    out.push(c);
  }
  out.push(34);
  return stringFromBytes(out);
}

// インスペクタの set の op のうち、キーフレームのあるキーの値を、再生ヘッドの時刻の key add にする（moOpValue）。
// 書き換えたものがなければ false（そのまま set でよい）。書き換えたら、残りのキーの set と key add を out に入れる。
function wmoInsSetToKeys(ed: E2, op: string, out: mut string[]): bool {
  const w = splitArgs(op);
  if (w.length < 3 || w[0] != "set") {
    return false;
  }
  const ci = findClip(ed.project, w[1]);
  if (ci < 0) {
    return false;
  }
  const c = ci as usize;
  const fps = moFps(ed.project);
  const lt = moSnap(ed.t, fps) - ed.project.clips[c].at;
  let keyOps: string[] = [];
  let rest: string[] = [];
  for (let i: usize = 2; i < w.length; i++) {
    let kb: u8[] = [];
    let vb: u8[] = [];
    let eq = false;
    for (const b of w[i]) {
      if (!eq && b == 61) {
        eq = true;
      } else if (eq) {
        vb.push(b);
      } else {
        kb.push(b);
      }
    }
    const k = stringFromBytes(kb);
    if (eq && kb.length > 0 && moAnimIndex(ed.project.clips[c], k) >= 0) {
      keyOps.push(moOpValue(ed.project.clips[c], k, lt, wmoQuoteArg(stringFromBytes(vb))));
    } else if (eq) {
      rest.push(`${k}=${wmoQuoteArg(stringFromBytes(vb))}`);
    } else {
      rest.push(wmoQuoteArg(w[i]));
    }
  }
  if (keyOps.length == 0) {
    return false;
  }
  if (rest.length > 0) {
    let s = `set ${w[1]}`;
    for (const r of rest) {
      s = `${s} ${r}`;
    }
    out.push(s);
  }
  for (const k of keyOps) {
    out.push(k.clone());
  }
  return true;
}

// ---- 口 ----

// e2Frame の初め（ワークスペースの Tick のあと、wireTimelineKeys の前）に毎フレーム呼ぶ。tl はタイムライン、mon はモニターの四角。
// モニターの絵の場所は前のフレームの v.mon.picR（monPanel が決める）。カット編集のワークスペースのときだけ描く。
export function wmoTick(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, tl: UkRect, mon: UkRect): void {
  const ver0 = ed.ver;
  if (v.workspace == E2_WS_EDIT && mon.w > 0 && mon.h > 0) {
    wmoMonitorMarks(mut ui, mut ed, kit, mut v);
  }
  if (tl.h > 0 && tl.w > 0) {
    const g = tlGeo(mut v.tl, tl, ui.theme.scale);
    ukPushLayer(mut ui, WMO_LAYER);
    wmoGraphTab(mut ui, kit, mut v, g);
    ukPopLayer(mut ui);
    if (v.wmo.graphOpen) {
      // 開いている間は、トラックの所をグラフで覆う（印は出さない）。印より 1 つ上の層
      ukPushLayer(mut ui, WMO_LAYER + 1);
      wmoGraphPanel(mut ui, mut ed, kit.wmo.th, mut v, g);
      ukPopLayer(mut ui);
    } else {
      wmoTimelineMarks(mut ui, mut ed, kit, mut v, g);
    }
  }
  // 離したのに操作もやめるも来なかった（同じ値で離した）ときは、見せていた写しを捨てる
  if (v.wmo.preview && !wmoBusy(v.wmo)) {
    wmoEndPreview(mut ed, mut v.wmo);
  }
  // ファイルを書き換えたら、このフレームの部品を描く前に中身を作り直す
  if (ed.ver != ver0) {
    e2ViewSync(ed, mut kit, mut v);
  }
}

// タイムライン（tlTimeline を描いた直後。r はタイムラインの四角）。印は wmoTick が描くので、いまは何もしない。
export function wmoTimeline(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, r: UkRect): void {
}

// インスペクタ（insDraw を描いた直後。evs はインスペクタの出来事）。ここで扱った出来事に true を返し、wireInspector はそれを飛ばす:
// - INS_E_KF_*（◇ ◆ ◀ ▶）: moKeyNav と同じ操作（key add / remove / clear、Alt+◆ で key clear <今の時刻>、前後のキーへ）
// - INS_E_SET / INS_E_PREVIEW のうち、キーフレームのあるキーの値を変えるもの: set ではなく再生ヘッドの時刻の key add
//   （set で書くと、キーフレームの列が 1 つの値に置き換わってしまう）
export function wmoInspector(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, evs: InsEvent[]): bool[] {
  let taken: bool[] = [];
  const ci = wmoInsClip(ed, kit);
  const alt = (ui.inp.mods & UK_MOD_ALT) != 0;
  for (const e of evs) {
    let take = false;
    if (e.kind == INS_E_KF_TOGGLE || e.kind == INS_E_KF_HERE || e.kind == INS_E_KF_PREV || e.kind == INS_E_KF_NEXT) {
      take = true;
      if (ci >= 0) {
        wmoInsKf(mut ed, e.kind, e.key, ci as usize, alt);
      }
    } else if (e.kind == INS_E_SET || e.kind == INS_E_PREVIEW) {
      let ops: string[] = [];
      for (const o of e.ops) {
        if (wmoInsSetToKeys(ed, o, mut ops)) {
          take = true;
        } else {
          ops.push(o.clone());
        }
      }
      if (take) {
        if (e.kind == INS_E_SET) {
          e2ApplyOps(mut ed, ops);
        } else {
          wmoPreview(mut ed, mut v.wmo, ops, false);
        }
      }
    }
    taken.push(take);
  }
  return taken;
}

// モニター（monPanel と monKeys の直後。acts はモニターの出来事）。ギズモと点の編集は、モニターの部品より先に押しを取るため
// wmoTick が描くので、いまは何もしない（全画面のときは wmoTick が呼ばれないので、ギズモも出ない）。
export function wmoMonitor(ui: mut UkCtx, ed: mut E2, kit: mut E2Kit, v: mut E2View, acts: MonAct[]): void {
}
