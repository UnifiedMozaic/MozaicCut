// 書き出しの画面の小さな部品: アイコン（モックアップの 16 単位の線の絵）、日本語の折り返し、セグメント、
// ボタン、札、リンク、色付きのコードの箱。uikit にまだないものを、ここに仮に作る（報告の「uikit に足すべきもの」）。
import { UkRect, ukRect, ukAlpha, ukNextChar, ukSub, ukShrink } from "../uikit/base.um";
import {
  UkCtx, UkHit, ukBehavior, ukBehaviorEx, ukId, ukIdInt, ukDrawRect, ukDrawRound, ukDrawStroke, ukDrawLine, ukDrawCircle,
  ukDrawTri, ukDrawText, ukDrawTextIn, ukTextW, ukTextPrefixW, ukFitText, ukTooltip, ukKeyTake, ukFocus, ukMouseIn,
  UK_KEY_LEFT, UK_KEY_RIGHT,
} from "../uikit/core.um";
import { UeTheme } from "./theme.um";

// ---- アイコン ----

export const UE_I_EXPORT: i32 = 1;
export const UE_I_WARN: i32 = 2;
export const UE_I_ERROR: i32 = 3;
export const UE_I_CHECK: i32 = 4;
export const UE_I_CLOSE: i32 = 5;
export const UE_I_CHEV_R: i32 = 6;
export const UE_I_CHEV_D: i32 = 7;
export const UE_I_PLUS: i32 = 8;
export const UE_I_MEDIA: i32 = 9;
export const UE_I_FILE: i32 = 10;
export const UE_I_AUDIO: i32 = 11;
export const UE_I_IMAGE: i32 = 12;
export const UE_I_CLOCK: i32 = 13;
export const UE_I_FOLDER: i32 = 14;
export const UE_I_GEAR: i32 = 15;
export const UE_I_SEARCH: i32 = 16;
export const UE_I_UNDO: i32 = 17;
export const UE_I_REDO: i32 = 18;
export const UE_I_GPU: i32 = 19;
export const UE_I_PLAY: i32 = 20;
export const UE_I_RETRY: i32 = 21;
export const UE_I_COPY: i32 = 22;

// 16 単位の座標の点の並び pts（x0,y0,x1,y1,…）を線でつなぐ。
function ueIcPoly(ui: mut UkCtx, r: UkRect, pts: f32[], t: f32, c: u32): void {
  const k = (r.w as f32) / 16.0;
  const ox = r.x as f32;
  const oy = r.y as f32;
  let i: usize = 0;
  while (i + 3 < pts.length) {
    ukDrawLine(mut ui, ox + pts[i] * k, oy + pts[i + 1] * k, ox + pts[i + 2] * k, oy + pts[i + 3] * k, t, c);
    i += 2;
  }
}

function ueIcCircle(ui: mut UkCtx, r: UkRect, cx: f32, cy: f32, rad: f32, t: f32, c: u32): void {
  const k = (r.w as f32) / 16.0;
  ukDrawCircle(mut ui, (r.x as f32) + cx * k, (r.y as f32) + cy * k, rad * k, t, c);
}

// sin / cos（Math にないので、角を -π..π に寄せてから級数で求める）
function ueSin(x0: f32): f32 {
  let x = x0;
  const pi: f32 = 3.14159265;
  while (x > pi) {
    x = x - 2.0 * pi;
  }
  while (x < -pi) {
    x = x + 2.0 * pi;
  }
  const x2 = x * x;
  return x * (1.0 - x2 / 6.0 * (1.0 - x2 / 20.0 * (1.0 - x2 / 42.0 * (1.0 - x2 / 72.0 * (1.0 - x2 / 110.0)))));
}

function ueCos(x: f32): f32 {
  return ueSin(x + 1.57079633);
}

// 円の弧を点の並びにする（角度は度。0 が右、90 が下）。
function ueArcPts(cx: f32, cy: f32, rad: f32, a0: f32, a1: f32, n: i32): f32[] {
  let out: f32[] = [];
  for (let i = 0; i <= n; i++) {
    const a = (a0 + (a1 - a0) * (i as f32) / (n as f32)) * 3.14159265 / 180.0;
    out.push(cx + rad * ueCos(a));
    out.push(cy + rad * ueSin(a));
  }
  return out;
}

// アイコンを四角 r（正方形）に描く。線の太さはモックアップの stroke-width 1.5（16 単位）。
export function ueIcon(ui: mut UkCtx, r: UkRect, icon: i32, c: u32): void {
  const k = (r.w as f32) / 16.0;
  const t = Math.max(1.5 * k, 1.0);
  if (icon == UE_I_EXPORT) {
    ueIcPoly(mut ui, r, [8.0, 10.0, 8.0, 2.5], t, c);
    ueIcPoly(mut ui, r, [5.0, 5.5, 8.0, 2.5, 11.0, 5.5], t, c);
    ueIcPoly(mut ui, r, [3.0, 9.5, 3.0, 13.5, 13.0, 13.5, 13.0, 9.5], t, c);
  } else if (icon == UE_I_WARN) {
    ueIcPoly(mut ui, r, [8.0, 2.0, 14.5, 13.5, 1.5, 13.5, 8.0, 2.0], t, c);
    ueIcPoly(mut ui, r, [8.0, 6.5, 8.0, 9.7], t, c);
    ueIcCircle(mut ui, r, 8.0, 11.7, 0.9, 0.0, c);
  } else if (icon == UE_I_ERROR) {
    // 丸に ×（tokens の note: エラーは必ず丸に × のアイコン。playhead の赤と形で分ける）
    ueIcCircle(mut ui, r, 8.0, 8.0, 6.0, t, c);
    ueIcPoly(mut ui, r, [5.8, 5.8, 10.2, 10.2], t, c);
    ueIcPoly(mut ui, r, [10.2, 5.8, 5.8, 10.2], t, c);
  } else if (icon == UE_I_CHECK) {
    ueIcPoly(mut ui, r, [3.0, 8.5, 6.0, 11.5, 13.0, 4.5], t, c);
  } else if (icon == UE_I_CLOSE) {
    ueIcPoly(mut ui, r, [4.0, 4.0, 12.0, 12.0], t, c);
    ueIcPoly(mut ui, r, [12.0, 4.0, 4.0, 12.0], t, c);
  } else if (icon == UE_I_CHEV_R) {
    ueIcPoly(mut ui, r, [6.0, 4.5, 9.5, 8.0, 6.0, 11.5], t, c);
  } else if (icon == UE_I_CHEV_D) {
    ueIcPoly(mut ui, r, [4.5, 6.0, 8.0, 9.5, 11.5, 6.0], t, c);
  } else if (icon == UE_I_PLUS) {
    ueIcPoly(mut ui, r, [8.0, 3.0, 8.0, 13.0], t, c);
    ueIcPoly(mut ui, r, [3.0, 8.0, 13.0, 8.0], t, c);
  } else if (icon == UE_I_MEDIA) {
    ukDrawStroke(mut ui, ukRect(r.x + (2.0 * k) as i32, r.y + (3.0 * k) as i32, (12.0 * k) as i32, (10.0 * k) as i32),
      Math.max((1.5 * k) as i32, 1), Math.max(t as i32, 1), c);
    ueIcPoly(mut ui, r, [7.0, 6.2, 7.0, 9.8, 10.0, 8.0, 7.0, 6.2], t, c);
  } else if (icon == UE_I_FILE) {
    ueIcPoly(mut ui, r, [4.0, 1.8, 9.0, 1.8, 12.0, 4.8, 12.0, 14.2, 4.0, 14.2, 4.0, 1.8], t, c);
    ueIcPoly(mut ui, r, [9.0, 1.8, 9.0, 4.8, 12.0, 4.8], t, c);
  } else if (icon == UE_I_AUDIO) {
    ueIcPoly(mut ui, r, [2.5, 6.5, 2.5, 9.5], t, c);
    ueIcPoly(mut ui, r, [5.0, 4.5, 5.0, 11.5], t, c);
    ueIcPoly(mut ui, r, [7.5, 2.5, 7.5, 13.5], t, c);
    ueIcPoly(mut ui, r, [10.0, 5.0, 10.0, 11.0], t, c);
    ueIcPoly(mut ui, r, [12.5, 7.0, 12.5, 9.0], t, c);
  } else if (icon == UE_I_IMAGE) {
    ukDrawStroke(mut ui, ukRect(r.x + (2.0 * k) as i32, r.y + (3.0 * k) as i32, (12.0 * k) as i32, (10.0 * k) as i32),
      Math.max((1.2 * k) as i32, 1), Math.max(t as i32, 1), c);
    ueIcCircle(mut ui, r, 6.0, 6.5, 1.2, t, c);
    ueIcPoly(mut ui, r, [2.5, 12.0, 6.5, 8.0, 9.5, 11.0, 11.5, 9.0, 14.0, 11.5], t, c);
  } else if (icon == UE_I_CLOCK) {
    ueIcCircle(mut ui, r, 8.0, 8.0, 5.5, t, c);
    ueIcPoly(mut ui, r, [8.0, 5.0, 8.0, 8.0, 10.0, 9.5], t, c);
  } else if (icon == UE_I_FOLDER) {
    ueIcPoly(mut ui, r, [2.0, 3.5, 6.0, 3.5, 7.5, 5.0, 14.0, 5.0, 14.0, 13.0, 2.0, 13.0, 2.0, 3.5], t, c);
  } else if (icon == UE_I_GEAR) {
    ueIcCircle(mut ui, r, 8.0, 8.0, 2.0, t, c);
    ueIcPoly(mut ui, r, [8.0, 1.5, 8.0, 3.5], t, c);
    ueIcPoly(mut ui, r, [8.0, 12.5, 8.0, 14.5], t, c);
    ueIcPoly(mut ui, r, [1.5, 8.0, 3.5, 8.0], t, c);
    ueIcPoly(mut ui, r, [12.5, 8.0, 14.5, 8.0], t, c);
    ueIcPoly(mut ui, r, [3.4, 3.4, 4.8, 4.8], t, c);
    ueIcPoly(mut ui, r, [11.2, 11.2, 12.6, 12.6], t, c);
    ueIcPoly(mut ui, r, [3.4, 12.6, 4.8, 11.2], t, c);
    ueIcPoly(mut ui, r, [11.2, 4.8, 12.6, 3.4], t, c);
  } else if (icon == UE_I_SEARCH) {
    ueIcCircle(mut ui, r, 7.0, 7.0, 4.0, t, c);
    ueIcPoly(mut ui, r, [10.0, 10.0, 13.5, 13.5], t, c);
  } else if (icon == UE_I_UNDO) {
    ueIcPoly(mut ui, r, [5.5, 3.0, 2.5, 6.0, 5.5, 9.0], t, c);
    ueIcPoly(mut ui, r, [2.5, 6.0, 9.5, 6.0], t, c);
    ueIcPoly(mut ui, r, ueArcPts(9.5, 10.0, 4.0, -90.0, 90.0, 8), t, c);
    ueIcPoly(mut ui, r, [9.5, 14.0, 7.0, 14.0], t, c);
  } else if (icon == UE_I_REDO) {
    ueIcPoly(mut ui, r, [10.5, 3.0, 13.5, 6.0, 10.5, 9.0], t, c);
    ueIcPoly(mut ui, r, [13.5, 6.0, 6.5, 6.0], t, c);
    ueIcPoly(mut ui, r, ueArcPts(6.5, 10.0, 4.0, 270.0, 90.0, 8), t, c);
    ueIcPoly(mut ui, r, [6.5, 14.0, 9.0, 14.0], t, c);
  } else if (icon == UE_I_GPU) {
    ueIcPoly(mut ui, r, [3.0, 3.0, 13.0, 3.0, 13.0, 13.0, 3.0, 13.0, 3.0, 3.0], t, c);
    ueIcPoly(mut ui, r, [6.0, 6.0, 10.0, 6.0, 10.0, 10.0, 6.0, 10.0, 6.0, 6.0], t, c);
    ueIcPoly(mut ui, r, [6.0, 1.5, 6.0, 3.0], t, c);
    ueIcPoly(mut ui, r, [10.0, 1.5, 10.0, 3.0], t, c);
    ueIcPoly(mut ui, r, [6.0, 13.0, 6.0, 14.5], t, c);
    ueIcPoly(mut ui, r, [10.0, 13.0, 10.0, 14.5], t, c);
  } else if (icon == UE_I_PLAY) {
    const ox = r.x as f32;
    const oy = r.y as f32;
    ukDrawTri(mut ui, ox + 5.0 * k, oy + 3.5 * k, ox + 5.0 * k, oy + 12.5 * k, ox + 12.0 * k, oy + 8.0 * k, c);
  } else if (icon == UE_I_RETRY) {
    ueIcPoly(mut ui, r, ueArcPts(8.0, 8.0, 5.0, 200.0, 520.0, 14), t, c);
    ueIcPoly(mut ui, r, [3.0, 2.5, 3.0, 5.0, 5.5, 5.0], t, c);
  } else if (icon == UE_I_COPY) {
    ueIcPoly(mut ui, r, [5.0, 5.0, 13.5, 5.0, 13.5, 13.5, 5.0, 13.5, 5.0, 5.0], t, c);
    ueIcPoly(mut ui, r, [3.0, 10.5, 3.0, 2.5, 10.5, 2.5], t, c);
  }
}

// アイコンを (x, y) を左上に、大きさ sz で描く
export function ueIconAt(ui: mut UkCtx, x: i32, y: i32, sz: i32, icon: i32, c: u32): void {
  ueIcon(mut ui, ukRect(x, y, sz, sz), icon, c);
}

// ---- 覚えておく値（折り返し・省略・コードの箱の行の分け方） ----
//
// 折り返しと「…」の結果を (文, 幅, 大きさ) でとっておく。中身・幅・倍率が変われば鍵が変わるので、
// 作り直しは要らない（古いものは数が増えたら捨てる）。呼ぶ側が 1 つ作り、毎フレーム ueWorkspace / ueQueueList に渡す。
export struct UeCache {
  // 折り返し: 鍵と、行の並び（wLines の wStart から wCount 行）
  wKey: string[];
  wW: i32[];
  wSize: f32[];
  wStart: i32[];
  wCount: i32[];
  wLines: string[];
  // 真ん中の省略
  mKey: string[];
  mW: i32[];
  mSize: f32[];
  mOut: string[];
  // コードの箱（1 つだけ）: 切れ端と、その位置（箱の中の左上から）
  codeKey: string;
  codeW: i32;
  codeSize: f32;
  codeText: string[];
  codeCol: u32[];
  codeX: i32[];
  codeY: i32[];
  codeH: i32;
  // フォーカスのある部品の四角（スクロールを寄せるのに使う）
  focusSeen: bool;
  focusTop: i32;
  focusBot: i32;
  focusLast: u32;
  // 数（作り直した回数。試しで見る）
  builds: i32;
}

export function ueCacheNew(): UeCache {
  return {
    wKey: [], wW: [], wSize: [], wStart: [], wCount: [], wLines: [], mKey: [], mW: [], mSize: [], mOut: [],
    codeKey: "", codeW: 0, codeSize: 0.0, codeText: [], codeCol: [], codeX: [], codeY: [], codeH: 0,
    focusSeen: false, focusTop: 0, focusBot: 0, focusLast: 0, builds: 0,
  };
}

const UE_CACHE_MAX: usize = 256;

// 直前に呼んだ部品にフォーカスがあれば、その四角を覚える（スクロールを寄せるため）
export function ueTrackFocus(ui: UkCtx, c: mut UeCache): void {
  if (ui.focus != 0 && ui.focus == ui.lastId) {
    c.focusSeen = true;
    c.focusTop = ui.lastRect.y;
    c.focusBot = ui.lastRect.y + ui.lastRect.h;
  }
}

// ---- 文字 ----

// 表示だけで、バックスラッシュ（0x5C）を全角の ＼（U+FF3C）にする。UI のフォント（游ゴシック）は 0x5C を円の記号で
// 描くため。等幅のフォント（IBM Plex Mono）を uikit で選べるようになったら要らない。
export function ueBsShow(s: string): string {
  let has = false;
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 92) {
      has = true;
      break;
    }
  }
  if (!has) {
    return s.clone();
  }
  let out: u8[] = [];
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == 92) {
      out.push(0xef);
      out.push(0xbc);
      out.push(0xbc);
    } else {
      out.push(s[i]);
    }
  }
  return stringFromBytes(out);
}

// 行の高さ lh の帯（上端 y）に、文字を縦の中央で置く。幅を返す。
export function ueText(ui: mut UkCtx, x: i32, y: i32, lh: i32, s: string, size: f32, c: u32): i32 {
  if (s.length == 0) {
    return 0;
  }
  const w = ukTextW(mut ui, s, size);
  ukDrawTextIn(mut ui, ukRect(x, y, w + 2, lh), s, size, c, 0);
  return w;
}

// 右寄せ（右端 xr）
export function ueTextR(ui: mut UkCtx, xr: i32, y: i32, lh: i32, s: string, size: f32, c: u32): i32 {
  if (s.length == 0) {
    return 0;
  }
  const w = ukTextW(mut ui, s, size);
  ukDrawTextIn(mut ui, ukRect(xr - w, y, w + 2, lh), s, size, c, 0);
  return w;
}

// 幅 w に収め、はみ出す分は後ろを「…」（font.ellipsis.default = end）
export function ueTextFit(ui: mut UkCtx, x: i32, y: i32, w: i32, lh: i32, s: string, size: f32, c: u32): void {
  if (w <= 0) {
    return;
  }
  ukDrawTextIn(mut ui, ukRect(x, y, w, lh), s, size, c, 0);
}

function uePrevChar(s: string, i: usize): usize {
  if (i == 0) {
    return 0;
  }
  let j = i - 1;
  while (j > 0 && (s[j] & 0xc0) == 0x80) {
    j--;
  }
  return j;
}

// 真ん中を「…」で省く（font.ellipsis.mediaName = middle）。拡張子が見えるように、後ろを半分残す。
function ueFitMid(ui: mut UkCtx, s: string, size: f32, w: i32): string {
  const total = ukTextW(mut ui, s, size);
  if (total <= w) {
    return s.clone();
  }
  const ell = "…";
  const avail = w - ukTextW(mut ui, ell, size);
  if (avail <= 0) {
    return ell;
  }
  // 後ろ: 幅 avail / 2 に収まる一番長い後ろ
  let a = s.length;
  while (a > 0) {
    const p = uePrevChar(s, a);
    if (total - ukTextPrefixW(ui, s, p, size) > avail / 2) {
      break;
    }
    a = p;
  }
  const tailW = total - ukTextPrefixW(ui, s, a, size);
  // 前: 残りに収まる一番長い前
  let b: usize = 0;
  while (b < a) {
    const n = ukNextChar(s, b);
    if (ukTextPrefixW(ui, s, n, size) > avail - tailW) {
      break;
    }
    b = n;
  }
  return ukSub(s, 0, b) + ell + ukSub(s, a, s.length);
}

export function ueTextFitMid(ui: mut UkCtx, c: mut UeCache, x: i32, y: i32, w: i32, lh: i32, s: string, size: f32, col: u32): void {
  if (w <= 0 || s.length == 0) {
    return;
  }
  let k: i32 = -1;
  for (let i: usize = 0; i < c.mKey.length; i++) {
    if (c.mW[i] == w && c.mSize[i] == size && c.mKey[i] == s) {
      k = i as i32;
      break;
    }
  }
  if (k < 0) {
    if (c.mKey.length >= UE_CACHE_MAX) {
      c.mKey = [];
      c.mW = [];
      c.mSize = [];
      c.mOut = [];
    }
    c.mKey.push(s.clone());
    c.mW.push(w);
    c.mSize.push(size);
    c.mOut.push(ueFitMid(mut ui, ueBsShow(s), size, w));
    c.builds = c.builds + 1;
    k = (c.mKey.length as i32) - 1;
  }
  ukDrawTextIn(mut ui, ukRect(x, y, w + 2, lh), c.mOut[k as usize], size, col, 0);
}

// 行の頭に置かない文字（。、）」』・：！？ と、閉じ括弧）
function ueNoHead(s: string, i: usize): bool {
  if (i >= s.length) {
    return false;
  }
  const b = s[i];
  if (b == 41 || b == 44 || b == 46 || b == 58 || b == 93) {
    return true;
  }
  if (b == 0xe3 && i + 2 < s.length) {
    const b1 = s[i + 1];
    const b2 = s[i + 2];
    // 、。 = E3 80 81 / E3 80 82、」』】 = E3 80 8D / 8F / 91、ー = E3 83 BC、・ = E3 83 BB
    if (b1 == 0x80 && (b2 == 0x81 || b2 == 0x82 || b2 == 0x8d || b2 == 0x8f || b2 == 0x91)) {
      return true;
    }
    if (b1 == 0x83 && (b2 == 0xbc || b2 == 0xbb)) {
      return true;
    }
  }
  if (b == 0xef && i + 2 < s.length) {
    // ）：！？， = EF BC 89 / 9A / 81 / 9F / 8C
    const b1 = s[i + 1];
    const b2 = s[i + 2];
    if (b1 == 0xbc && (b2 == 0x89 || b2 == 0x9a || b2 == 0x81 || b2 == 0x9f || b2 == 0x8c)) {
      return true;
    }
  }
  return false;
}

// 行の終わりに置かない文字（開き括弧と ' "）。cut の直前の文字を見る
function ueNoTail(s: string, start: usize, cut: usize): usize {
  if (cut <= start + 1) {
    return cut;
  }
  const b = s[cut - 1];
  if (b == 39 || b == 34 || b == 40 || b == 91) {
    return cut - 1;
  }
  if (cut >= start + 4 && s[cut - 3] == 0xe3 && s[cut - 2] == 0x80 && (s[cut - 1] == 0x8c || s[cut - 1] == 0x8e || s[cut - 1] == 0x90)) {
    return cut - 3;
  }
  if (cut >= start + 4 && s[cut - 3] == 0xef && s[cut - 2] == 0xbc && s[cut - 1] == 0x88) {
    return cut - 3;
  }
  return cut;
}

function ueIsWordByte(b: u8): bool {
  return (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 45 || b == 46 || b == 92 || b == 47 || b == 58;
}

// 日本語の折り返し: 幅 maxW に収まる行に分ける。英数字の語（タイムコードを含む）は途中で切らない
// （語が 1 行より長いときは切る）。行の頭に句読点と閉じ括弧を置かない: その前の 1 文字を次の行へ送る（追い出し）。
// 送れないとき（行が 1 文字だけなど）だけ、前の行にぶら下げる。
export function ueWrap(ui: mut UkCtx, s: string, size: f32, maxW: i32): string[] {
  let lines: string[] = [];
  if (s.length == 0) {
    return lines;
  }
  if (ukTextW(mut ui, s, size) <= maxW) {
    lines.push(s.clone());
    return lines;
  }
  let start: usize = 0;
  while (start < s.length) {
    // 行の頭から測る（ukSub は行ごとに 1 回）
    const rest = ukSub(s, start, s.length);
    let i = start;
    let last = start;
    while (i < s.length) {
      const j = ukNextChar(s, i);
      if (ukTextPrefixW(ui, rest, j - start, size) > maxW && i > start) {
        break;
      }
      last = j;
      i = j;
    }
    let cut = last;
    if (cut < s.length) {
      // 英数字の語の途中なら、語の頭まで戻す
      if (ueIsWordByte(s[cut]) && cut > start && ueIsWordByte(s[cut - 1])) {
        let b = cut;
        while (b > start && ueIsWordByte(s[b - 1])) {
          b--;
        }
        if (b > start) {
          cut = b;
        }
      }
      // 行の終わりに開き括弧を置かない
      cut = ueNoTail(s, start, cut);
      // 行の頭に置かない文字: 前の文字を次の行へ送る（3 文字まで戻る）
      if (cut < s.length && ueNoHead(s, cut)) {
        let b = cut;
        let n = 0;
        let moved = false;
        while (b > start && n < 3) {
          b = uePrevChar(s, b);
          n++;
          if (b > start && !ueNoHead(s, b)) {
            moved = true;
            break;
          }
        }
        if (moved) {
          cut = ueNoTail(s, start, b);
        } else {
          // 送れない: ぶら下げる（2 文字まで）
          let k = 0;
          while (cut < s.length && ueNoHead(s, cut) && k < 2) {
            cut = ukNextChar(s, cut);
            k++;
          }
        }
      }
    }
    if (cut <= start) {
      cut = ukNextChar(s, start);
    }
    // 行の頭の空白は捨てる
    let a = start;
    while (a < cut && s[a] == 32) {
      a++;
    }
    lines.push(ukSub(s, a, cut));
    start = cut;
    while (start < s.length && s[start] == 32) {
      start++;
    }
  }
  return lines;
}

// 折り返しをとっておき、その番号を返す（行は c.wLines[c.wStart[k] ..]、数は c.wCount[k]）
export function ueWrapC(ui: mut UkCtx, c: mut UeCache, s: string, size: f32, maxW: i32): usize {
  for (let i: usize = 0; i < c.wKey.length; i++) {
    if (c.wW[i] == maxW && c.wSize[i] == size && c.wKey[i] == s) {
      return i;
    }
  }
  if (c.wKey.length >= UE_CACHE_MAX) {
    c.wKey = [];
    c.wW = [];
    c.wSize = [];
    c.wStart = [];
    c.wCount = [];
    c.wLines = [];
  }
  // 表示だけ、バックスラッシュを ＼ にする（鍵は元の文）
  const lines = ueWrap(mut ui, ueBsShow(s), size, maxW);
  c.wKey.push(s.clone());
  c.wW.push(maxW);
  c.wSize.push(size);
  c.wStart.push(c.wLines.length as i32);
  c.wCount.push(lines.length as i32);
  for (const l of lines) {
    c.wLines.push(l.clone());
  }
  c.builds = c.builds + 1;
  return c.wKey.length - 1;
}

// 折り返したときの行の数
export function ueWrapN(ui: mut UkCtx, c: mut UeCache, s: string, size: f32, maxW: i32): i32 {
  const k = ueWrapC(mut ui, mut c, s, size, maxW);
  return c.wCount[k];
}

// 折り返して描き、使った高さを返す
export function ueTextWrap(ui: mut UkCtx, c: mut UeCache, x: i32, y: i32, w: i32, lh: i32, s: string, size: f32, col: u32): i32 {
  const k = ueWrapC(mut ui, mut c, s, size, w);
  const a = c.wStart[k] as usize;
  const n = c.wCount[k] as usize;
  let yy = y;
  for (let i = a; i < a + n; i++) {
    ukDrawTextIn(mut ui, ukRect(x, yy, w + 2, lh), c.wLines[i], size, col, 0);
    yy += lh;
  }
  return yy - y;
}

// ---- フォーカスの輪（ui.md §17）----

// 二重の輪: 部品から border.focusOffset 離して、内に accent を border.focus の幅、その外に focusOuter（黒）を hairline。
// 主のボタン（地が accent）でも、黒い輪と隙間で見える。rad は部品の角の半径。
export function ueFocusRing(ui: mut UkCtx, t: UeTheme, r: UkRect, rad: i32, h: UkHit): void {
  if (!h.focused || !ui.focusVisible) {
    return;
  }
  ueFocusRingAt(mut ui, t, r, rad);
}

export function ueFocusRingAt(ui: mut UkCtx, t: UeTheme, r: UkRect, rad: i32): void {
  const o = t.focusOffset;
  const fw = t.focusW;
  ukDrawStroke(mut ui, ukShrink(r, -(o + fw)), rad + o + fw, fw, t.accent);
  ukDrawStroke(mut ui, ukShrink(r, -(o + fw + t.hairline)), rad + o + fw + t.hairline, t.hairline, t.focusOuter);
}

// ---- 部品 ----

// セグメント（.seg）: 地 bg1・枠 lineStrong・角 md の箱に、項目を並べる。
// 高さは btnSm + 2 × (余白 2 + 枠 1)。幅は文字の幅 + 左右の余白 s3。
export function ueSegW(ui: mut UkCtx, t: UeTheme, items: string[]): i32 {
  const pad = Math.max(t.s1 / 2, 1);
  let w = pad * 2 + t.hairline * 2;
  for (let i: usize = 0; i < items.length; i++) {
    w += ukTextW(mut ui, items[i], t.fsSm) + t.s3 * 2;
    if (i > 0) {
      w += pad;
    }
  }
  return w;
}

export function ueSegH(t: UeTheme): i32 {
  return t.btnSm + 2 * (Math.max(t.s1 / 2, 1) + t.hairline);
}

function ueSegOff(dis: bool[], i: i32): bool {
  return i >= 0 && (i as usize) < dis.length && dis[i as usize];
}

// 選んだ番号を返す。セグメント全体で 1 つのフォーカスの止まり所（Tab で入り、左右の矢印で選ぶ）。
// dis[i] が true の項目は使えない（文字を text.disabled にし、ホバーで tips[i] を出す。矢印でも飛ばす）。
export function ueSeg(ui: mut UkCtx, t: UeTheme, label: string, x: i32, y: i32, items: string[], cur: i32, dis: bool[], tips: string[]): i32 {
  const pad = Math.max(t.s1 / 2, 1);
  const w = ueSegW(mut ui, t, items);
  const h = ueSegH(t);
  const box = ukRect(x, y, w, h);
  ukDrawRound(mut ui, box, t.rMd, t.lineStrong);
  ukDrawRound(mut ui, ukShrink(box, t.hairline), Math.max(t.rMd - t.hairline, 0), t.bg1);
  const boxId = ukId(ui, label);
  let out = cur;
  let xx = x + t.hairline + pad;
  // 項目は押すだけ（フォーカスは取らない）。箱のふるまいより先に呼ぶ（押したのを項目が取る）
  for (let i: usize = 0; i < items.length; i++) {
    const iw = ukTextW(mut ui, items[i], t.fsSm) + t.s3 * 2;
    const r = ukRect(xx, y + t.hairline + pad, iw, t.btnSm);
    const off = ueSegOff(dis, i as i32);
    const h2 = ukBehavior(mut ui, ukIdInt(ui, label, i as i32), r, false);
    if (h2.clicked && !off) {
      out = i as i32;
      ukFocus(mut ui, boxId, false);
    }
    const on = (i as i32) == cur;
    if (on) {
      ukDrawRound(mut ui, r, t.rSm, t.bg4);
    } else if (h2.hover && !off) {
      ukDrawRound(mut ui, r, t.rSm, t.bg3);
    }
    let c = t.text2;
    if (off) {
      c = t.textDis;
    } else if (on || h2.hover) {
      c = t.text1;
    }
    ukDrawTextIn(mut ui, r, items[i], t.fsSm, c, 1);
    if (off && (i as usize) < tips.length && tips[i].length > 0) {
      ukTooltip(mut ui, tips[i]);
    }
    xx += iw + pad;
  }
  // 箱のふるまいは Tab の止まり所とキーのためだけ。当たりの四角は空にする（項目のホバーとツールチップを奪わない）。
  // 後で ueTrackFocus が使えるように、直前の部品の四角は箱にしておく
  const hb = ukBehaviorEx(mut ui, boxId, ukRect(box.x, box.y, 0, 0), true, false);
  ui.lastRect = box;
  if (hb.focused) {
    const n = items.length as i32;
    let d = 0;
    if (ukKeyTake(mut ui, UK_KEY_LEFT)) {
      d = -1;
    } else if (ukKeyTake(mut ui, UK_KEY_RIGHT)) {
      d = 1;
    }
    if (d != 0) {
      let k = out + d;
      while (k >= 0 && k < n && ueSegOff(dis, k)) {
        k += d;
      }
      if (k >= 0 && k < n) {
        out = k;
      }
    }
  }
  ueFocusRing(mut ui, t, box, t.rMd, hb);
  return out;
}

// ボタンの種類
export const UE_B_NORMAL: i32 = 0;
export const UE_B_PRIMARY: i32 = 1;

// 文字のボタン（.btn）。大きさ sz は t.btnSm / btnMd / btnLg。
export function ueButtonW(ui: mut UkCtx, t: UeTheme, s: string, sz: i32): i32 {
  let fs = t.fsMd;
  let pad = t.s3;
  if (sz <= t.btnSm) {
    fs = t.fsSm;
    pad = t.s2;
  } else if (sz >= t.btnLg) {
    pad = t.s4;
  }
  return ukTextW(mut ui, s, fs) + pad * 2 + t.hairline * 2;
}

// 押したら true。disabled なら押せず、フォーカスも取らない。
// 使えない主のボタンは .btn.primary.dis（地と枠 bg3、文字 text.disabled。不透明度は使わない）。
// 使えない普通のボタンは、地と枠はそのままで文字を text.disabled にする。tip は使えないときもホバーで出す。
export function ueButton(ui: mut UkCtx, t: UeTheme, label: string, s: string, r: UkRect, kind: i32, disabled: bool, tip: string): bool {
  let fs = t.fsMd;
  if (r.h <= t.btnSm) {
    fs = t.fsSm;
  }
  // 使えないときもホバーは取る（理由のツールチップを出すため）。押しても何もしない
  const h = ukBehavior(mut ui, ukId(ui, label), r, !disabled);
  let face = t.bg3;
  let edge = t.lineStrong;
  let fg = t.text1;
  if (kind == UE_B_PRIMARY) {
    face = t.accent;
    edge = t.accent;
    fg = t.textOnAccent;
    if (disabled) {
      face = t.bg3;
      edge = t.bg3;
      fg = t.textDis;
    } else if (h.hover) {
      face = t.accentHover;
      edge = t.accentHover;
    }
  } else if (disabled) {
    fg = t.textDis;
  } else if (h.hover) {
    face = t.bg4;
  }
  ukDrawRound(mut ui, r, t.rMd, edge);
  ukDrawRound(mut ui, ukShrink(r, t.hairline), Math.max(t.rMd - t.hairline, 0), face);
  ukDrawTextIn(mut ui, r, s, fs, fg, 1);
  ueFocusRing(mut ui, t, r, t.rMd, h);
  if (tip.length > 0) {
    ukTooltip(mut ui, ueBsShow(tip));
  }
  return h.clicked && !disabled;
}

// アイコンだけのボタン（.ibtn）。ホバーで bg3、色 text2 → text1。show が false なら、ホバーかフォーカスのときだけ描く
// （ふるまいは毎フレーム通すので、Tab の順に入り、キーボードでも押せる）。
export function ueIconBtnEx(ui: mut UkCtx, t: UeTheme, label: string, r: UkRect, icon: i32, tip: string, show: bool): UkHit {
  const h = ukBehavior(mut ui, ukId(ui, label), r, true);
  if (show || h.hover || h.focused) {
    let c = t.text2;
    if (h.hover) {
      ukDrawRound(mut ui, r, t.rMd, t.bg3);
      c = t.text1;
    }
    const isz = t.iconSm;
    ueIcon(mut ui, ukRect(r.x + (r.w - isz) / 2, r.y + (r.h - isz) / 2, isz, isz), icon, c);
    ueFocusRing(mut ui, t, r, t.rMd, h);
    if (tip.length > 0) {
      ukTooltip(mut ui, tip);
    }
  }
  return h;
}

export function ueIconButton(ui: mut UkCtx, t: UeTheme, label: string, r: UkRect, icon: i32, tip: string): bool {
  const h = ueIconBtnEx(mut ui, t, label, r, icon, tip, true);
  return h.clicked;
}

// リンク（.link。accent.hover の文字）。押したら true。
export function ueLink(ui: mut UkCtx, t: UeTheme, label: string, x: i32, y: i32, lh: i32, s: string, size: f32): bool {
  const w = ukTextW(mut ui, s, size);
  const r = ukRect(x, y, w, lh);
  const h = ukBehavior(mut ui, ukId(ui, label), r, true);
  let c = t.accentHover;
  if (h.hover) {
    c = t.text1;
  }
  ukDrawTextIn(mut ui, ukRect(x, y, w + 2, lh), s, size, c, 0);
  if (h.hover) {
    ukDrawRect(mut ui, ukRect(x, y + lh - t.hairline, w, t.hairline), c);
  }
  ueFocusRing(mut ui, t, r, t.rSm, h);
  return h.clicked;
}

export function ueLinkW(ui: mut UkCtx, s: string, size: f32): i32 {
  return ukTextW(mut ui, s, size);
}

// 数の札（.badge）: 丸い地に xs の数字。幅を返す。
export function ueBadge(ui: mut UkCtx, t: UeTheme, x: i32, y: i32, s: string, bg: u32, fg: u32): i32 {
  const h = t.lhSm;
  const w = Math.max(ukTextW(mut ui, s, t.fsXs) + t.s1 * 2, h);
  ukDrawRound(mut ui, ukRect(x, y, w, h), h / 2, bg);
  ukDrawTextIn(mut ui, ukRect(x, y, w, h), s, t.fsXs, fg, 1);
  return w;
}

// 札（.chip）: 色 c の薄い地（accent.tint と同じ不透明度）に、色 c の文字。幅を返す。
export function ueChipW(ui: mut UkCtx, t: UeTheme, s: string): i32 {
  return ukTextW(mut ui, s, t.fsSm) + t.s2 * 2 - 2;
}

export function ueChip(ui: mut UkCtx, t: UeTheme, x: i32, y: i32, s: string, c: u32): i32 {
  const h = t.lhSm + t.s1;
  const w = ueChipW(mut ui, t, s);
  ukDrawRound(mut ui, ukRect(x, y, w, h), t.rSm, ukAlpha(c, t.tintAlpha));
  ukDrawTextIn(mut ui, ukRect(x, y, w, h), s, t.fsSm, c, 1);
  return w;
}

// 細い進み具合の帯（.bar）
export function ueBar(ui: mut UkCtx, t: UeTheme, r: UkRect, frac: f64, c: u32): void {
  ukDrawRound(mut ui, r, r.h / 2, t.bg4);
  const f = Math.min(Math.max(frac, 0.0), 1.0);
  const fw = Math.floor((r.w as f64) * f + 0.5) as i32;
  if (fw > 0) {
    ukDrawRound(mut ui, ukRect(r.x, r.y, Math.max(fw, r.h), r.h), r.h / 2, c);
  }
}

// ---- 色付きのコードの箱（.code）----
//
// 切れ端 runs（色 colors）を、トークン（toks の同じ番号の切れ端の並び。.tk）の境目で折り返す
// （font.ellipsis.code）。1 行より長いトークンだけ文字で切る。toks が -1 の切れ端は改行、-2 は語のあいだの空白
// （行の頭では捨てる）。行の分け方は c にとっておき、key・幅・大きさが変わったときだけ作り直す。

export function ueCodeCached(c: UeCache, key: string, w: i32, size: f32): bool {
  return c.codeW == w && c.codeSize == size && c.codeKey == key;
}

function ueCodePut(c: mut UeCache, s: own string, col: u32, x: i32, y: i32): void {
  c.codeText.push(s);
  c.codeCol.push(col);
  c.codeX.push(x);
  c.codeY.push(y);
}

export function ueCodeLayout(ui: mut UkCtx, c: mut UeCache, key: string, w: i32, lh: i32, size: f32, runs: string[], colors: u32[], toks: i32[]): void {
  c.codeKey = key.clone();
  c.codeW = w;
  c.codeSize = size;
  c.codeText = [];
  c.codeCol = [];
  c.codeX = [];
  c.codeY = [];
  c.builds = c.builds + 1;
  let cx = 0;
  let cy = 0;
  let k: usize = 0;
  while (k < runs.length) {
    const tk = toks[k];
    if (tk == -1) {
      cx = 0;
      cy += lh;
      k++;
      continue;
    }
    if (tk == -2) {
      const sw = ukTextW(mut ui, runs[k], size);
      if (cx > 0 && cx + sw <= w) {
        cx += sw;
      }
      k++;
      continue;
    }
    // 同じトークンの切れ端 [k, e)
    let e = k;
    let tw = 0;
    while (e < runs.length && toks[e] == tk) {
      tw += ukTextW(mut ui, runs[e], size);
      e++;
    }
    if (cx > 0 && cx + tw > w) {
      cx = 0;
      cy += lh;
    }
    for (let q = k; q < e; q++) {
      const s = runs[q].clone();
      if (cx + ukTextW(mut ui, s, size) <= w) {
        const pw = ukTextW(mut ui, s, size);
        ueCodePut(mut c, own s, colors[q], cx, cy);
        cx += pw;
        continue;
      }
      // 1 行より長いトークン: 文字で切る
      let start: usize = 0;
      while (start < s.length) {
        const rest = ukSub(s, start, s.length);
        let i = start;
        let fit = start;
        while (i < s.length) {
          const j = ukNextChar(s, i);
          if (cx + ukTextPrefixW(ui, rest, j - start, size) > w) {
            break;
          }
          fit = j;
          i = j;
        }
        if (fit == start) {
          if (cx == 0) {
            fit = ukNextChar(s, start);
          } else {
            cx = 0;
            cy += lh;
            continue;
          }
        }
        const piece = ukSub(s, start, fit);
        const pw = ukTextW(mut ui, piece, size);
        ueCodePut(mut c, own piece, colors[q], cx, cy);
        cx += pw;
        start = fit;
        if (start < s.length) {
          cx = 0;
          cy += lh;
        }
      }
    }
    k = e;
  }
  c.codeH = cy + lh;
}

export function ueCodeDraw(ui: mut UkCtx, c: UeCache, x: i32, y: i32, lh: i32): void {
  for (let i: usize = 0; i < c.codeText.length; i++) {
    const pw = ukTextW(mut ui, c.codeText[i], c.codeSize);
    ukDrawTextIn(mut ui, ukRect(x + c.codeX[i], y + c.codeY[i], pw + 2, lh), c.codeText[i], c.codeSize, c.codeCol[i], 0);
  }
}
