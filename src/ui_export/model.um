// 書き出しの画面の中身（画面が見る値）。プリセット・シーケンス・確認の結果・待ち行列の仕事を、
// 描くのに要る形（人向けの文を含む）で持つ。m5-finish の presets.um（ExportPreset）・renderqueue.um（RenderJob）・
// project.um（Project・Diag）からの写し方は link_m5.um。
import { ukFormatTimecode, ukFpsInt } from "../uikit/widgets.um";
import { ukFixed } from "../uikit/base.um";

// プリセットの組（左の列の見出し）
export const UE_G_RECENT: i32 = 0;   // 最近の設定
export const UE_G_SHARE: i32 = 1;    // 配る
export const UE_G_KEEP: i32 = 2;     // 保存と受け渡し
export const UE_G_MINE: i32 = 3;     // 自分のプリセット

// プリセットのアイコン
export const UE_PI_VIDEO: i32 = 0;
export const UE_PI_FILE: i32 = 1;
export const UE_PI_AUDIO: i32 = 2;
export const UE_PI_IMAGE: i32 = 3;

// 範囲
export const UE_R_ALL: i32 = 0;      // シーケンス全体
export const UE_R_INOUT: i32 = 1;    // イン〜アウト
export const UE_R_CLIPS: i32 = 2;    // 選んだクリップ

// 字幕
export const UE_SUB_NONE: i32 = 0;
export const UE_SUB_BURN: i32 = 1;   // 焼き込む
export const UE_SUB_SRT: i32 = 2;    // SRT を別に書く

// 待ち行列の仕事の状態（renderqueue.um の RQ_* と同じ番号）
export const UE_J_WAIT: i32 = 0;
export const UE_J_RUN: i32 = 1;
export const UE_J_DONE: i32 = 2;
export const UE_J_FAIL: i32 = 3;
export const UE_J_CANCEL: i32 = 4;

// 確認の項目の重さ
export const UE_C_ERROR: i32 = 0;
export const UE_C_WARN: i32 = 1;

// 画面から外へ知らせること（ueWorkspace が ev に足す）。a は番号（仕事の id・項目の番号・行）、s は文字。
export const UE_EV_PRESET: i32 = 1;        // プリセットを選んだ（a = presets の添字、s = id）
export const UE_EV_RANGE: i32 = 2;         // 範囲を変えた（a = UE_R_*）
export const UE_EV_NAME: i32 = 3;          // ファイル名を変えた（s = 新しい名前。拡張子なし）
export const UE_EV_PICK_FOLDER: i32 = 4;   // 「変える…」を押した（呼ぶ側が場所を選ぶダイアログを開く）
export const UE_EV_SAVE_PRESET: i32 = 5;   // 「自分のプリセットを保存」を押した
export const UE_EV_EXPORT: i32 = 6;        // 「書き出す」を押した
export const UE_EV_ENQUEUE: i32 = 7;       // 「待ち行列に足す」を押した
export const UE_EV_CHECK_ACTION: i32 = 8;  // 確認の項目のボタン（a = checks の添字、s = ボタンの action）
export const UE_EV_JOB_CANCEL: i32 = 9;    // 仕事を取りやめる（a = 仕事の id）
export const UE_EV_JOB_OPEN: i32 = 10;     // フォルダを開く（a = 仕事の id）
export const UE_EV_JOB_PLAY: i32 = 11;     // 再生する（a = 仕事の id）
export const UE_EV_JOB_RETRY: i32 = 12;    // やり直す（a = 仕事の id）
export const UE_EV_JOB_GOTO: i32 = 13;     // 失敗した所のクリップへ移る（a = 仕事の id、s = 止まった時刻のタイムコード）
export const UE_EV_JOB_COPY: i32 = 14;     // 失敗の詳細をコピーする（a = 仕事の id、s = 日本語の文と JSON）
export const UE_EV_DETAILS: i32 = 15;      // 詳細を開いた・閉じた（a = 1 開いた / 0 閉じた）
export const UE_EV_SUBTITLES: i32 = 16;    // 字幕の扱いを変えた（a = UE_SUB_*）
export const UE_EV_SCRUB: i32 = 17;        // 範囲をスクラブする帯で再生ヘッドを動かした（a = コマ。st.seq.playhead も変わる）
                                           // 呼ぶ側はそのコマを lay.content に描き直す

export struct UeEvent {
  kind: i32;
  a: i32;
  s: string;
}

// 左の列の 1 つのプリセット（ExportPreset から作る。幅・高さ・コマの速さが 0 ならシーケンスに合わせる）
export struct UePreset {
  id: string;
  name: string;
  // 2 行目（"H.264 · 1920×1080 · 30p"）
  detail: string;
  group: i32;
  icon: i32;
  ext: string;
  // 形式の 1 行（"MP4 · H.264 · AAC"）
  format: string;
  hasVideo: bool;
  width: i32;
  height: i32;
  fps: f64;
  // 映像のコーデック・ビットレート（"12 Mbps"・"品質 26"・"" ）と音（"AAC 320 kbps"）・色
  videoCodec: string;
  videoRate: string;
  audio: string;
  color: string;
  // 推定の大きさに使う平均のビットレート（kbps。映像と音の合計。0 なら推定しない）
  totalKbps: i32;
  // .mzc の project 行に書ける形の残り（"crf=18 preset=slow"）
  projectArgs: string;
}

// 書き出す元（いまのシーケンス）
export struct UeSeq {
  project: string;     // プロジェクトの名前（"谷中の豆腐店"）
  name: string;        // シーケンスの名前（"本編"）
  mzc: string;         // .mzc のファイル名（"本編_v3.mzc"）
  width: i32;
  height: i32;
  fpsNum: i32;
  fpsDen: i32;
  audioRate: i32;
  frames: i64;         // シーケンス全体のコマ数
  inFrame: i64;        // イン（なければ -1）
  outFrame: i64;       // アウト（なければ -1。アウトのコマを含む）
  selFrom: i64;        // 選んだクリップの範囲（なければ -1）
  selTo: i64;
  playhead: i64;
  hasSubtitles: bool;
}

// 書き出しの前の確認の 1 項目（Diag から作る）
export struct UeCheck {
  severity: i32;
  code: string;
  msg: string;
  // 場所（"本編_v3.mzc:27"）。"" なら出さない
  loc: string;
  line: i32;
  // ボタン（表示する名前と、押したときに UE_EV_CHECK_ACTION の s で返す action）
  actions: string[];
  actionIds: string[];
}

// 待ち行列の 1 つの仕事（RenderJob から作る）
export struct UeJob {
  id: i32;
  name: string;
  state: i32;
  frac: f64;
  // 残り時間（"0:12"。見込みがなければ ""）
  eta: string;
  // 補足（実行中・待ち: "1080×1920 · SNS 縦"、完了: "14:05 に終わりました · 0:30 · 48 MB"）
  info: string;
  // 失敗: どこまで書き出せたか・どこで止まったか（日本語）と、止まった時刻、詳細（日本語の文と JSON）
  failWhat: string;
  failWhere: string;
  failAt: string;
  failDetail: string;
}

export struct UeState {
  presets: UePreset[];
  sel: i32;
  seq: UeSeq;
  range: i32;
  fileName: string;
  folder: string;
  // .mzc のあるフォルダ（要約の output= を、.mzc から見た相対のパスで書くのに使う。"" なら folder をそのまま書く）
  baseDir: string;
  subtitles: i32;
  detailsOpen: bool;
  checks: UeCheck[];
  checkSec: f64;
  // 確認がまだ走っている（"確かめています…" を出す）
  checking: bool;
  jobs: UeJob[];
  // 推定（呼ぶ側が決める。"" なら ueEstimate* で出す）
  estSize: string;
  estTime: string;
  // 右の列の中身の高さ（前のフレームに測ったもの。スクロールに使う）
  sideH: i32;
  leftH: i32;
}

// ---- 写し（構造体には .clone() がないので、ここで作る） ----

export function ueStrsCopy(a: string[]): string[] {
  let out: string[] = [];
  for (const x of a) {
    out.push(x.clone());
  }
  return out;
}

export function uePresetCopy(p: UePreset): UePreset {
  return {
    id: p.id.clone(), name: p.name.clone(), detail: p.detail.clone(), group: p.group, icon: p.icon, ext: p.ext.clone(),
    format: p.format.clone(), hasVideo: p.hasVideo, width: p.width, height: p.height, fps: p.fps,
    videoCodec: p.videoCodec.clone(), videoRate: p.videoRate.clone(), audio: p.audio.clone(), color: p.color.clone(),
    totalKbps: p.totalKbps, projectArgs: p.projectArgs.clone(),
  };
}

export function ueSeqCopy(q: UeSeq): UeSeq {
  return {
    project: q.project.clone(), name: q.name.clone(), mzc: q.mzc.clone(), width: q.width, height: q.height,
    fpsNum: q.fpsNum, fpsDen: q.fpsDen, audioRate: q.audioRate, frames: q.frames, inFrame: q.inFrame,
    outFrame: q.outFrame, selFrom: q.selFrom, selTo: q.selTo, playhead: q.playhead, hasSubtitles: q.hasSubtitles,
  };
}

export function ueCheckCopy(c: UeCheck): UeCheck {
  return {
    severity: c.severity, code: c.code.clone(), msg: c.msg.clone(), loc: c.loc.clone(), line: c.line,
    actions: ueStrsCopy(c.actions), actionIds: ueStrsCopy(c.actionIds),
  };
}

export function ueJobCopy(j: UeJob): UeJob {
  return {
    id: j.id, name: j.name.clone(), state: j.state, frac: j.frac, eta: j.eta.clone(), info: j.info.clone(),
    failWhat: j.failWhat.clone(), failWhere: j.failWhere.clone(), failAt: j.failAt.clone(), failDetail: j.failDetail.clone(),
  };
}

export function ueJobsCopy(a: UeJob[]): UeJob[] {
  let out: UeJob[] = [];
  for (const j of a) {
    out.push(ueJobCopy(j));
  }
  return out;
}

// ---- 文の組み立て ----

export function ueFpsText(num: i32, den: i32): string {
  if (den <= 0) {
    return "?";
  }
  if (num % den == 0) {
    return `${num / den}p`;
  }
  return ukFixed((num as f64) / (den as f64), 2) + "p";
}

export function ueFpsTextF(v: f64): string {
  const r = Math.floor(v + 0.5);
  if (Math.abs(v - r) < 0.001) {
    return `${r as i64}p`;
  }
  return ukFixed(v, 2) + "p";
}

// 音の標本化の周波数（48000 → "48kHz"、44100 → "44.1kHz"）
export function ueKhzText(rate: i32): string {
  if (rate % 1000 == 0) {
    return `${rate / 1000}kHz`;
  }
  return ukFixed((rate as f64) / 1000.0, 1) + "kHz";
}

export function ueSizeText(w: i32, h: i32): string {
  return `${w}×${h}`;
}

// 秒を "1 分 32 秒" に
export function ueDurJa(sec: i64): string {
  if (sec < 60) {
    return `${sec} 秒`;
  }
  if (sec < 3600) {
    const r = sec % 60;
    if (r == 0) {
      return `${sec / 60} 分`;
    }
    return `${sec / 60} 分 ${r} 秒`;
  }
  return `${sec / 3600} 時間 ${(sec % 3600) / 60} 分`;
}

// 秒を "0:12" / "1:04:05" に（残り時間・長さ）
export function ueClock(sec: f64): string {
  if (sec < 0.0) {
    return "";
  }
  const s = Math.floor(sec + 0.5) as i64;
  const h = s / 3600;
  const m = (s % 3600) / 60;
  const r = s % 60;
  let rs = `${r}`;
  if (r < 10) {
    rs = "0" + rs;
  }
  if (h > 0) {
    let ms = `${m}`;
    if (m < 10) {
      ms = "0" + ms;
    }
    return `${h}:${ms}:${rs}`;
  }
  return `${m}:${rs}`;
}

// バイト数を "142 MB" に
export function ueBytesText(bytes: f64): string {
  const mb = bytes / 1000000.0;
  if (mb >= 1000.0) {
    return ukFixed(mb / 1000.0, 1) + " GB";
  }
  if (mb >= 10.0) {
    return `${Math.floor(mb + 0.5) as i64} MB`;
  }
  return ukFixed(mb, 1) + " MB";
}

// その範囲を選べるか（イン〜アウトはインかアウトが、選んだクリップは選んだ範囲があるとき）
export function ueRangeHas(seq: UeSeq, range: i32): bool {
  if (range == UE_R_INOUT) {
    return seq.inFrame >= 0 || seq.outFrame >= 0;
  }
  if (range == UE_R_CLIPS) {
    return seq.selFrom >= 0 && seq.selTo > seq.selFrom;
  }
  return true;
}

// 選べないときの理由（ツールチップ）
export function ueRangeWhyNot(range: i32): string {
  if (range == UE_R_INOUT) {
    return "イン・アウトが付いていません";
  }
  if (range == UE_R_CLIPS) {
    return "クリップを選んでいません";
  }
  return "";
}

// 範囲のコマ（[from, to)）。イン〜アウトや選んだクリップがなければ全体（画面では選べないようにしてある）。
export function ueRangeFrom(seq: UeSeq, range: i32): i64 {
  if (range == UE_R_INOUT && seq.inFrame >= 0) {
    return seq.inFrame;
  }
  if (range == UE_R_CLIPS && seq.selFrom >= 0) {
    return seq.selFrom;
  }
  return 0;
}

export function ueRangeTo(seq: UeSeq, range: i32): i64 {
  if (range == UE_R_INOUT && seq.outFrame >= 0) {
    return Math.min(seq.outFrame + 1, seq.frames);
  }
  if (range == UE_R_INOUT && seq.inFrame >= 0) {
    return seq.frames;
  }
  if (range == UE_R_CLIPS && seq.selTo >= 0) {
    return seq.selTo;
  }
  return seq.frames;
}

// 範囲の文（"00:00:00:00 – 00:01:32:00"）
export function ueRangeText(seq: UeSeq, range: i32): string {
  const fps = ukFpsInt(seq.fpsNum, seq.fpsDen);
  return ukFormatTimecode(ueRangeFrom(seq, range), fps) + " – " + ukFormatTimecode(ueRangeTo(seq, range), fps);
}

export function ueRangeSec(seq: UeSeq, range: i32): f64 {
  if (seq.fpsNum <= 0) {
    return 0.0;
  }
  const n = ueRangeTo(seq, range) - ueRangeFrom(seq, range);
  return (n as f64) * (seq.fpsDen as f64) / (seq.fpsNum as f64);
}

// 出力の大きさ（プリセットが 0 ならシーケンス）
export function ueOutW(p: UePreset, seq: UeSeq): i32 {
  if (p.width > 0) {
    return p.width;
  }
  return seq.width;
}

export function ueOutH(p: UePreset, seq: UeSeq): i32 {
  if (p.height > 0) {
    return p.height;
  }
  return seq.height;
}

export function ueSeqFps(seq: UeSeq): f64 {
  if (seq.fpsDen <= 0) {
    return 0.0;
  }
  return (seq.fpsNum as f64) / (seq.fpsDen as f64);
}

// 出力のコマの速さ（プリセットが 0 か、シーケンスより速いときはシーケンス。上限を超えるときは上限）
export function ueOutFps(p: UePreset, seq: UeSeq): f64 {
  const f = ueSeqFps(seq);
  if (p.fps > 0.0 && f > p.fps + 0.01) {
    return p.fps;
  }
  return f;
}

// 推定のサイズ（呼ぶ側が決めていなければ、ビットレート × 長さ）
export function ueEstimateSize(st: UeState): string {
  if (st.estSize.length > 0) {
    return st.estSize.clone();
  }
  if (st.sel < 0 || (st.sel as usize) >= st.presets.length) {
    return "—";
  }
  const k = st.presets[st.sel as usize].totalKbps;
  if (k <= 0) {
    return "—";
  }
  const sec = ueRangeSec(st.seq, st.range);
  return "約 " + ueBytesText((k as f64) * 1000.0 / 8.0 * sec);
}

export function ueEstimateTime(st: UeState): string {
  if (st.estTime.length > 0) {
    return st.estTime.clone();
  }
  return "—";
}

export function ueErrorCount(st: UeState): i32 {
  let n = 0;
  for (const c of st.checks) {
    if (c.severity == UE_C_ERROR) {
      n++;
    }
  }
  return n;
}

export function ueWarnCount(st: UeState): i32 {
  let n = 0;
  for (const c of st.checks) {
    if (c.severity == UE_C_WARN) {
      n++;
    }
  }
  return n;
}

// 待ち行列で、まだ終わっていない仕事の数（見出しの札）
export function ueQueueCount(st: UeState): i32 {
  let n = 0;
  for (const j of st.jobs) {
    if (j.state == UE_J_WAIT || j.state == UE_J_RUN) {
      n++;
    }
  }
  return n;
}

// 状態の帯に出す文（書き出し中の仕事があれば "書き出し中 42% · 残り 0:12"、その仕事の名前）。なければ ""。
export function ueStatusText(st: UeState): string {
  for (const j of st.jobs) {
    if (j.state == UE_J_RUN) {
      let s = `書き出し中 ${Math.floor(j.frac * 100.0 + 0.5) as i64}%`;
      if (j.eta.length > 0) {
        s = s + ` · 残り ${j.eta}`;
      }
      return s;
    }
  }
  return "";
}

export function ueStatusName(st: UeState): string {
  for (const j of st.jobs) {
    if (j.state == UE_J_RUN) {
      return `（${j.name}）`;
    }
  }
  return "";
}

// 選んだプリセットの拡張子（"." つき）
export function ueExt(st: UeState): string {
  if (st.sel < 0 || (st.sel as usize) >= st.presets.length) {
    return "";
  }
  return "." + st.presets[st.sel as usize].ext;
}

// .mzc の project 行に書ける形
export function ueProjectLine(st: UeState): string {
  if (st.sel < 0 || (st.sel as usize) >= st.presets.length) {
    return "";
  }
  const k = st.sel as usize;
  let s = `project size=${ueOutW(st.presets[k], st.seq)}x${ueOutH(st.presets[k], st.seq)} fps=${ueFpsTextNum(ueOutFps(st.presets[k], st.seq))}`;
  // 名前の " と \ は .mzc の文字列のエスケープにする（そのままだと壊れた行 = bad-escape を見せることになる）
  s = s + ` output="${ueMzcEscape(ueOutputRel(st))}"`;
  if (st.presets[k].projectArgs.length > 0) {
    s = s + " " + st.presets[k].projectArgs;
  }
  return s;
}

// 書き出す先（場所 + ファイル名 + 拡張子）を、.mzc のフォルダ（baseDir）から見た形にする。
// 実際に書くのは folder の下なので、要約の output= もそこを指す（.mzc のフォルダの下なら相対、外なら絶対のパス）。
export function ueOutputRel(st: UeState): string {
  const name = st.fileName + ueExt(st);
  let dir = st.folder.clone();
  // 末尾の区切りを落とす
  while (dir.length > 1 && (dir[dir.length - 1] == 47 || dir[dir.length - 1] == 92)) {
    dir = ueSub(dir, 0, dir.length - 1);
  }
  let base = st.baseDir.clone();
  while (base.length > 1 && (base[base.length - 1] == 47 || base[base.length - 1] == 92)) {
    base = ueSub(base, 0, base.length - 1);
  }
  if (dir.length == 0 || dir == "." || (base.length > 0 && ueSamePath(dir, base))) {
    return name;
  }
  if (base.length > 0 && dir.length > base.length + 1 && ueSamePath(ueSub(dir, 0, base.length), base) &&
      (dir[base.length] == 47 || dir[base.length] == 92)) {
    return ueSlashes(ueSub(dir, base.length + 1, dir.length)) + "/" + name;
  }
  return ueSlashes(dir) + "/" + name;
}

function ueSub(s: string, a: usize, b: usize): string {
  let out: u8[] = [];
  for (let i = a; i < b && i < s.length; i++) {
    out.push(s[i]);
  }
  return stringFromBytes(out);
}

// \ を / にする（.mzc の中のパスは / で書く）
function ueSlashes(s: string): string {
  let out: u8[] = [];
  for (const b of s) {
    out.push(b == 92 ? 47 : b);
  }
  return stringFromBytes(out);
}

// 区切り（/ と \）と英字の大小を区別せずに比べる（Windows のパス）
function ueSamePath(a: string, b: string): bool {
  if (a.length != b.length) {
    return false;
  }
  for (let i: usize = 0; i < a.length; i++) {
    let x = a[i];
    let y = b[i];
    if (x == 92) {
      x = 47;
    }
    if (y == 92) {
      y = 47;
    }
    if (x >= 65 && x <= 90) {
      x = x + 32;
    }
    if (y >= 65 && y <= 90) {
      y = y + 32;
    }
    if (x != y) {
      return false;
    }
  }
  return true;
}

// .mzc の "…" の中に書けるようにする（バックスラッシュは 2 つに、" は前にバックスラッシュを付ける）
export function ueMzcEscape(s: string): string {
  let out: u8[] = [];
  for (let i: usize = 0; i < s.length; i++) {
    const b = s[i];
    if (b == 92 || b == 34) {
      out.push(92);
    }
    out.push(b);
  }
  return stringFromBytes(out);
}

// ---- ファイル名の確かめ ----

function ueUpperAscii(s: string): string {
  let out: u8[] = [];
  for (let i: usize = 0; i < s.length; i++) {
    const b = s[i];
    if (b >= 97 && b <= 122) {
      out.push(b - 32);
    } else {
      out.push(b);
    }
  }
  return stringFromBytes(out);
}

// 書き出すファイルの名前（拡張子なし）が使えるか。使えれば ""、使えなければ理由（1 行の日本語）。
// Windows・macOS・Linux のどれでも書ける名前にする: 使えない文字（\ / : * ? " < > | と制御文字）、空、
// 終わりの空白とピリオド、Windows の予約の名前（CON・PRN・AUX・NUL・COM1〜9・LPT1〜9）。
export function ueNameProblem(name: string): string {
  let nonSpace = false;
  for (let i: usize = 0; i < name.length; i++) {
    if (name[i] != 32) {
      nonSpace = true;
    }
  }
  if (!nonSpace) {
    return "ファイル名が空です。";
  }
  for (let i: usize = 0; i < name.length; i++) {
    const b = name[i];
    if (b < 32 || b == 92 || b == 47 || b == 58 || b == 42 || b == 63 || b == 34 || b == 60 || b == 62 || b == 124) {
      return "ファイル名に使えない文字があります（\\ / : * ? \" < > |）。";
    }
  }
  const last = name[name.length - 1];
  if (last == 32 || last == 46) {
    return "ファイル名の終わりに空白とピリオドは置けません。";
  }
  // 予約の名前（拡張子の前の部分で見る）
  let stem: u8[] = [];
  for (let i: usize = 0; i < name.length; i++) {
    if (name[i] == 46) {
      break;
    }
    stem.push(name[i]);
  }
  const u = ueUpperAscii(stringFromBytes(stem));
  let bad = u == "CON" || u == "PRN" || u == "AUX" || u == "NUL";
  if (u.length == 4 && u[3] >= 49 && u[3] <= 57) {
    const head = ukSubAscii(u, 3);
    if (head == "COM" || head == "LPT") {
      bad = true;
    }
  }
  if (bad) {
    return `「${u}」は Windows で使えない名前です。`;
  }
  return "";
}

function ukSubAscii(s: string, n: usize): string {
  let out: u8[] = [];
  for (let i: usize = 0; i < n && i < s.length; i++) {
    out.push(s[i]);
  }
  return stringFromBytes(out);
}

// ---- 書き出せない理由 ----

// 確認の項目の原因コードを、短い日本語の名前にする（使えない［書き出す］のツールチップ）
export function ueCheckLabel(code: string): string {
  switch (code) {
    case "missing-source":
      return "素材がありません";
    case "no-video-stream":
      return "映像のない素材";
    case "no-audio-stream":
      return "音のない素材";
    case "font-not-found":
      return "字形がありません";
    case "unknown-length":
      return "長さが分からない素材";
    case "empty-timeline":
      return "空のシーケンス";
    case "preset-empty":
      return "書き出すものがない";
    default:
      return "エラー";
  }
}

// ［書き出す］が使えない理由（モックアップの title「素材がありません 1 件を直すと書き出せます」の形）。使えるなら ""。
export function ueExportBlockTip(st: UeState): string {
  if (st.sel < 0 || (st.sel as usize) >= st.presets.length) {
    return "左の一覧から目的を選んでください";
  }
  const np = ueNameProblem(st.fileName);
  if (np.length > 0) {
    return np;
  }
  let labels: string[] = [];
  let counts: i32[] = [];
  for (const c of st.checks) {
    if (c.severity != UE_C_ERROR) {
      continue;
    }
    const l = ueCheckLabel(c.code);
    let k: i32 = -1;
    for (let i: usize = 0; i < labels.length; i++) {
      if (labels[i] == l) {
        k = i as i32;
      }
    }
    if (k < 0) {
      labels.push(l);
      counts.push(1);
    } else {
      counts[k as usize] = counts[k as usize] + 1;
    }
  }
  if (labels.length > 0) {
    let s = "";
    for (let i: usize = 0; i < labels.length; i++) {
      if (i > 0) {
        s = s + "・";
      }
      s = s + `${labels[i]} ${counts[i]} 件`;
    }
    return s + "を直すと書き出せます";
  }
  if (st.checking) {
    return "書き出しの前の確認が終わるのを待っています";
  }
  return "";
}

function ueFpsTextNum(v: f64): string {
  const r = Math.floor(v + 0.5);
  if (Math.abs(v - r) < 0.001) {
    return `${r as i64}`;
  }
  return ukFixed(v, 3);
}
