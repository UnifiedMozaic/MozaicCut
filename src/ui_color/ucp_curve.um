// 色のパネル（ucp）のカーブ: 輝度・R・G・B のカーブを編集する四角。
//
// 見た目: 地は bg.0、4 等分の格子と対角線（変えないときの線）、後ろに輝度のヒストグラム（無彩色で薄く）。
// 選んだチャンネルのカーブを太く、ほかに変えたチャンネルがあれば薄く重ねる。
// 操作:
//   何もない所を押す → そこに点を足して、そのままドラッグ（既存の点の x に近すぎるときは足さず、何も動かさない）
//   点をドラッグ → 動かす（両端の点は上下だけ。点は隣の点を越えない）
//   点をダブルクリック、または選んで Delete → 消す（両端は消せない）
//   フォーカス中の矢印キー → 選んだ点を少し動かす（Shift で 10 倍、Ctrl で 1/10。連打は 1 つの確定にまとめる）
// 曲線の式は src/color/grade.um の単調な 3 次スプライン（ucp_math.um に同じ式）。
import { UkRect, ukRect, ukShrink, ukAlpha } from "../uikit/base.um";
import {
  UkCtx, ukBehavior, ukId, ukSt, ukPushId, ukPopId, ukDrawRect, ukDrawRound, ukDrawStroke, ukDrawLine, ukDrawCircle,
  ukKeyTake, UK_KEY_DELETE, UK_KEY_BACKSPACE, UK_KEY_LEFT, UK_KEY_RIGHT, UK_KEY_UP, UK_KEY_DOWN,
} from "../uikit/core.um";
import { UcpTheme } from "./ucp_theme.um";
import { UcpPanel, UcpCurve, UCP_CH_Y, UCP_CH_R, UCP_CH_G, ucpCurveKey, ucpCurveText, ucpCurveIsIdentity } from "./ucp_state.um";
import { ucpSplineSlopes, ucpSplineEval } from "./ucp_math.um";
import { ucpFocusRing, ucpTrack, ucpModMul } from "./ucp_parts.um";

export function ucpChannelColor(th: UcpTheme, ch: i32): u32 {
  if (ch == UCP_CH_R) {
    return th.chR;
  }
  if (ch == UCP_CH_G) {
    return th.chG;
  }
  if (ch == UCP_CH_Y) {
    return th.chY;
  }
  return th.chB;
}

function ucpCurveDraw(ui: mut UkCtx, pr: UkRect, c: UcpCurve, t: f32, col: u32): void {
  const m = ucpSplineSlopes(c.xs, c.ys);
  const n = Math.max(pr.w / 3, 16);
  let lx: f32 = 0.0;
  let ly: f32 = 0.0;
  for (let k = 0; k <= n; k++) {
    const x = (k as f64) / (n as f64);
    const y = Math.min(Math.max(ucpSplineEval(c.xs, c.ys, m, x), 0.0), 1.0);
    const sx = (pr.x as f32) + (x as f32) * (pr.w as f32);
    const sy = (pr.y as f32) + ((1.0 - y) as f32) * (pr.h as f32);
    if (k > 0) {
      ukDrawLine(mut ui, lx, ly, sx, sy, t, col);
    }
    lx = sx;
    ly = sy;
  }
}

// 点を x の順に差し込み、番号を返す。
function ucpCurveInsert(c: mut UcpCurve, x: f64, y: f64): i32 {
  let pos: usize = c.xs.length;
  for (let j: usize = 0; j < c.xs.length; j++) {
    if (c.xs[j] > x) {
      pos = j;
      break;
    }
  }
  c.xs.push(0.0);
  c.ys.push(0.0);
  let j = c.xs.length - 1;
  while (j > pos) {
    c.xs[j] = c.xs[j - 1];
    c.ys[j] = c.ys[j - 1];
    j--;
  }
  c.xs[pos] = x;
  c.ys[pos] = y;
  return pos as i32;
}

function ucpCurveRemove(c: mut UcpCurve, i: usize): void {
  let xs: f64[] = [];
  let ys: f64[] = [];
  for (let j: usize = 0; j < c.xs.length; j++) {
    if (j != i) {
      xs.push(c.xs[j]);
      ys.push(c.ys[j]);
    }
  }
  c.xs = xs;
  c.ys = ys;
}

// カーブの編集の四角。r は正方形が望ましい（呼ぶ側が決める）。
export function ucpCurveEditor(ui: mut UkCtx, th: UcpTheme, p: mut UcpPanel, r: UkRect): void {
  const ch = p.curveCh;
  ukPushId(mut ui, ucpCurveKey(ch));
  const ci = ch as usize;
  let c: UcpCurve = { xs: p.g.curves[ci].xs.clone(), ys: p.g.curves[ci].ys.clone() };
  const before = ucpCurveText(c);
  let sel = p.curveSel;
  if (sel >= (c.xs.length as i32)) {
    sel = -1;
  }
  const inset = th.s2;
  const pr = ukShrink(r, inset);
  const id = ukId(ui, "area");
  const h = ukBehavior(mut ui, id, r, true);
  const si = ukSt(mut ui, id);
  const hitR = (th.hit as f64) * 0.5;
  // 押した所の点。ドラッグで動かす点は押したフレームで決め、ui.st の i[2] に（番号＋1、0 で動かさない）覚える。
  // 点に当たらず、近すぎて点を足さなかったときは、選びを外して何も動かさない（前に選んだ点が飛ばないように）。
  if (h.pressed) {
    let best: i32 = -1;
    let bd = hitR * hitR;
    for (let k: usize = 0; k < c.xs.length; k++) {
      const sx = (pr.x as f64) + c.xs[k] * (pr.w as f64);
      const sy = (pr.y as f64) + (1.0 - c.ys[k]) * (pr.h as f64);
      const dx = (ui.inp.mx as f64) - sx;
      const dy = (ui.inp.my as f64) - sy;
      if (dx * dx + dy * dy <= bd) {
        bd = dx * dx + dy * dy;
        best = k as i32;
      }
    }
    sel = -1;
    if (best >= 0) {
      sel = best;
      if (h.dbl && best > 0 && best < (c.xs.length as i32) - 1) {
        ucpCurveRemove(mut c, best as usize);
        sel = -1;
      }
    } else {
      const x = Math.min(Math.max(((ui.inp.mx - pr.x) as f64) / (pr.w as f64), 0.0), 1.0);
      const y = Math.min(Math.max(1.0 - ((ui.inp.my - pr.y) as f64) / (pr.h as f64), 0.0), 1.0);
      let near = false;
      for (let k: usize = 0; k < c.xs.length; k++) {
        if (Math.abs(c.xs[k] - x) < 0.02) {
          near = true;
        }
      }
      if (!near) {
        sel = ucpCurveInsert(mut c, x, y);
      }
    }
    ui.st[si].i[2] = sel + 1;
  } else if (h.held && ui.st[si].i[2] > 0 && ui.st[si].i[2] <= (c.xs.length as i32)) {
    const s = (ui.st[si].i[2] - 1) as usize;
    const n = c.xs.length;
    let x = ((ui.inp.mx - pr.x) as f64) / (pr.w as f64);
    const y = Math.min(Math.max(1.0 - ((ui.inp.my - pr.y) as f64) / (pr.h as f64), 0.0), 1.0);
    if (s == 0) {
      x = 0.0;
    } else if (s == n - 1) {
      x = 1.0;
    } else {
      x = Math.min(Math.max(x, c.xs[s - 1] + 0.01), c.xs[s + 1] - 0.01);
    }
    c.xs[s] = x;
    c.ys[s] = y;
    sel = s as i32;
  }
  if (!h.held && !h.pressed) {
    ui.st[si].i[2] = 0;
  }
  let kbd = false;
  if (h.focused && sel >= 0) {
    const s = sel as usize;
    const n = c.xs.length;
    if ((ukKeyTake(mut ui, UK_KEY_DELETE) || ukKeyTake(mut ui, UK_KEY_BACKSPACE)) && s > 0 && s < n - 1) {
      ucpCurveRemove(mut c, s);
      sel = -1;
    } else {
      const st: f64 = 0.005 * ucpModMul(ui);
      if (ukKeyTake(mut ui, UK_KEY_UP)) {
        c.ys[s] = Math.min(c.ys[s] + st, 1.0);
        kbd = true;
      }
      if (ukKeyTake(mut ui, UK_KEY_DOWN)) {
        c.ys[s] = Math.max(c.ys[s] - st, 0.0);
        kbd = true;
      }
      if (s > 0 && s < n - 1) {
        if (ukKeyTake(mut ui, UK_KEY_LEFT)) {
          c.xs[s] = Math.max(c.xs[s] - st, c.xs[s - 1] + 0.01);
          kbd = true;
        }
        if (ukKeyTake(mut ui, UK_KEY_RIGHT)) {
          c.xs[s] = Math.min(c.xs[s] + st, c.xs[s + 1] - 0.01);
          kbd = true;
        }
      }
    }
  }
  // ---- 描く ----
  ukDrawRect(mut ui, r, th.bg0);
  // ヒストグラム（無彩色で薄く）
  if (p.hist.length == 256) {
    for (let x = 0; x < pr.w; x++) {
      const b = (x * 256 / Math.max(pr.w, 1)) as usize;
      const hh = Math.floor(p.hist[b] * (pr.h as f64) * 0.92) as i32;
      if (hh > 0) {
        ukDrawRect(mut ui, ukRect(pr.x + x, pr.y + pr.h - hh, 1, hh), th.bg2);
      }
    }
  }
  for (let k = 1; k < 4; k++) {
    const gx = pr.x + pr.w * k / 4;
    const gy = pr.y + pr.h * k / 4;
    ukDrawRect(mut ui, ukRect(gx, pr.y, th.hair, pr.h), th.line);
    ukDrawRect(mut ui, ukRect(pr.x, gy, pr.w, th.hair), th.line);
  }
  ukDrawStroke(mut ui, pr, 0, th.hair, th.line);
  ukDrawLine(mut ui, pr.x as f32, (pr.y + pr.h) as f32, (pr.x + pr.w) as f32, pr.y as f32, th.hair as f32, th.lineStrong);
  // ほかのチャンネル（変えてあれば薄く）
  for (let o = 0; o < 4; o++) {
    if (o != ch && !ucpCurveIsIdentity(p.g.curves[o as usize])) {
      ucpCurveDraw(mut ui, pr, p.g.curves[o as usize], th.hair as f32, ukAlpha(ucpChannelColor(th, o), 110));
    }
  }
  const col = ucpChannelColor(th, ch);
  ucpCurveDraw(mut ui, pr, c, th.curveW, col);
  // 点
  const pr0 = th.pointR;
  for (let k: usize = 0; k < c.xs.length; k++) {
    const sx = (pr.x as f32) + (c.xs[k] as f32) * (pr.w as f32);
    const sy = (pr.y as f32) + ((1.0 - c.ys[k]) as f32) * (pr.h as f32);
    if ((k as i32) == sel) {
      ukDrawCircle(mut ui, sx, sy, pr0 + 2.0, 0.0, th.focusOuter);
      ukDrawCircle(mut ui, sx, sy, pr0 + 1.0, 0.0, th.text1);
    } else {
      ukDrawCircle(mut ui, sx, sy, pr0 + 1.0, 0.0, th.focusOuter);
      ukDrawCircle(mut ui, sx, sy, pr0, 0.0, th.bg0);
      ukDrawCircle(mut ui, sx, sy, pr0, 1.5, col);
    }
  }
  ucpFocusRing(mut ui, th, r, h);
  // ---- 変更 ----
  const after = ucpCurveText(c);
  const changed = after != before;
  if (changed) {
    p.g.curves[ci] = c;
  }
  p.curveSel = sel;
  ucpTrack(mut ui, mut p, ukId(ui, "trk"), ucpCurveKey(ch), after, changed, ui.active == id, kbd);
  ukPopId(mut ui);
}
