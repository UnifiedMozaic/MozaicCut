// 色のパネルとスコープ（ucp）の文言: 画面のコードに日本語を直接書かず、i18n の鍵で引く（ui.md 16.1）。
// 鍵は ja.json に置く前提の名前（color.*）。ja.json の読み込みが来たら、この表をそこから引くように替える。
// 用語は ui.md 16.2 に従う（「戻す」は注釈にしたクリップだけ。既定値へは「既定に戻す」）。
export function ucpT(key: string): string {
  switch (key) {
    // 札と見出し
    case "color.tab.wheels": return "ホイール";
    case "color.tab.curves": return "カーブ";
    case "color.tab.lut": return "LUT";
    case "color.kind.video": return "映像（video）";
    case "color.reset.all": return "すべての色の調整を既定に戻す";
    case "color.reset.item": return "既定に戻す";
    case "color.reset.curve": return "このカーブを既定に戻す";
    case "color.reset.wheel": return "このホイールを既定に戻す";
    case "color.keyframe": return "キーフレーム（.mzc にキーフレームの書き方が入ってから）";
    case "color.chip.id": return "押すと ID をコピー";
    case "color.chip.where": return "押すとテキストの欄のその行へ";
    // 項目
    case "color.temperature": return "色温度";
    case "color.temperature.tip": return "撮影したときの光の色温度。6504 K で変えない";
    case "color.tint": return "色かぶり";
    case "color.tint.tip": return "正で緑かぶりを取る（マゼンタ寄りになる）";
    case "color.exposure": return "露出";
    case "color.saturation": return "彩度";
    case "color.unit.kelvin": return "K";
    case "color.unit.stop": return "段";
    case "color.unit.percent": return "%";
    case "color.label.drag": return "左右にドラッグで値が変わる（Shift で 10 倍、Ctrl で 1/10）";
    // ホイール
    case "color.wheel.lift": return "リフト";
    case "color.wheel.gamma": return "ガンマ";
    case "color.wheel.gain": return "ゲイン";
    case "color.wheel.offset": return "オフセット";
    case "color.wheel.disc.tip": return "ドラッグで色。ダブルクリックで既定に戻す（Shift で 10 倍、Ctrl で 1/10）";
    case "color.wheel.master.tip": return "全体（r g b をまとめて）。ダブルクリックで既定に戻す";
    // カーブ
    case "color.curve.luma": return "輝度";
    case "color.curve.point": return "入力 {x}  →  出力 {y}";
    case "color.curve.count": return "点 {n} 個";
    case "color.curve.help": return "押して点を足す・ダブルクリックか Delete で消す";
    // LUT
    case "color.lut": return "LUT";
    case "color.lut.none": return "なし";
    case "color.lut.load": return "読み込む…";
    case "color.lut.load.tip": return ".cube（1D・3D）を読み込む";
    case "color.lut.amount": return "強さ";
    case "color.lut.interp": return "補間";
    case "color.lut.tetra": return "四面体";
    case "color.lut.trilinear": return "三線形";
    case "color.lut.empty": return "LUT を選ぶと、ここに形式と範囲が出ます";
    case "color.lut.unreadable": return "読めない LUT は当てません";
    case "color.lut.missing.code": return "lut-missing";
    case "color.lut.missing.msg": return "この LUT は一覧にありません（{path}）";
    case "color.lut.missing.hint": return "ファイルを移したなら［読み込む…］で読み直してください";
    case "color.diag.details": return "詳細";
    case "color.diag.hide": return "詳細を閉じる";
    // スコープ
    case "color.scope": return "スコープ";
    case "color.scope.wave": return "波形";
    case "color.scope.parade": return "パレード";
    case "color.scope.vector": return "ベクトルスコープ";
    case "color.scope.hist": return "ヒストグラム";
    case "color.scope.wave.cap": return "輝度 · 0〜100%";
    case "color.scope.parade.cap": return "R G B · 0〜100%";
    case "color.scope.vector.cap": return "BT.709 · 75%";
    case "color.scope.hist.cap": return "R G B · 輝度";
  }
  return key.clone();
}

// "{name}" を値に置き換える（1 つだけ）。
export function ucpTf(key: string, name: string, val: string): string {
  const s = ucpT(key);
  const pat = "{" + name + "}";
  let out: u8[] = [];
  let i: usize = 0;
  while (i < s.length) {
    let hit = i + pat.length <= s.length;
    if (hit) {
      for (let k: usize = 0; k < pat.length; k++) {
        if (s[i + k] != pat[k]) {
          hit = false;
          break;
        }
      }
    }
    if (hit) {
      for (let k: usize = 0; k < val.length; k++) {
        out.push(val[k]);
      }
      i = i + pat.length;
    } else {
      out.push(s[i]);
      i++;
    }
  }
  return stringFromBytes(out);
}
