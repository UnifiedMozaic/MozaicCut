// 色のパネルとスコープ（ucp）のテーマ: docs/design/tokens.json の値を、道筋（"color.dark.bg.0" など）で読んで持つ。
// 部品は色や大きさを直接書かず、必ずこの構造体を通して使う。
// 既定値は tokens.json（version 2）と同じ値。tokens.json が読めないときだけ使う（製品では tokens.json を必ず渡す）。
//
// tokens.json にまだない値は、足してほしい道筋で読み、いまは既定値を使う（報告の「tokens.json に足すべきもの」）:
//   color.dark.scope.r / g / b / luma   スコープとカーブのチャンネルの色
//   size.color.*                        色のパネルとスコープの部品の寸法（ホイールの直径・スコープの帯の高さなど）
//   size.chip / size.segmentedPad / size.modDot / size.propIcon / size.propGap / size.slider.*  部品の寸法（components.html の値）
//
// uikit の UkTheme（汎用の部品が使う）へは ucpUkTheme で写す（theme.um の名前が製品の名前と違うため。
// uikit 側で tokens.json の名前を直接読めるようになったら要らなくなる）。
import { UkTheme, ukThemeSet, ukParseHex, ukThemeScale } from "../uikit/theme.um";

export struct UcpTheme {
  scale: f32;
  // ---- 面（R=G=B の無彩色） ----
  bg0: u32;          // 窓
  bg1: u32;          // パネル
  bg2: u32;          // 見出しの帯
  bg3: u32;          // 値の欄・ボタン
  bg4: u32;          // 押下・ホバー
  bgViewer: u32;     // 映像とスコープのまわり
  bgPopover: u32;
  line: u32;
  lineStrong: u32;
  lineControl: u32;  // 部品の輪郭（値の欄・溝・切り替えの札）。bg.0〜bg.3 に 3:1 以上
  // ---- 文字 ----
  text1: u32;
  text2: u32;
  text3: u32;
  textDisabled: u32;
  textOnDark: u32;
  // ---- 意味の色 ----
  accent: u32;
  accentHover: u32;
  accentTint: u32;
  accentTintSolid: u32;
  ok: u32;
  warn: u32;
  error: u32;
  focusOuter: u32;
  // ---- スコープとカーブのチャンネル（tokens.json に足すべきもの） ----
  chR: u32;
  chG: u32;
  chB: u32;
  chY: u32;
  clipVideo: u32;    // 種類のアイコン（clip.video.mark）
  // ---- 文字の大きさ（倍率を掛けた px） ----
  fsXs: f32;
  fsSm: f32;
  fsMd: f32;
  fsLg: f32;
  fsCodeSm: f32;
  // ---- 寸法（倍率を掛けた px） ----
  s1: i32;
  s2: i32;
  s3: i32;
  s4: i32;
  s5: i32;
  panelHeader: i32;
  tabBar: i32;
  row: i32;          // 項目の行 28
  field: i32;        // 値の欄 24
  btnSm: i32;
  btnMd: i32;
  hit: i32;          // 押せる範囲の最小
  iconSm: i32;
  rSm: i32;
  rMd: i32;
  rLg: i32;
  hair: i32;         // 1px の線（倍率で丸める）
  focusW: i32;
  // ---- 部品の寸法（tokens.json の size.*。倍率を掛けた px） ----
  propLabel: i32;    // 項目のラベルの幅 86（size.propertyLabel）
  propIcon: i32;     // 項目の行の ◇ と ↺ の列 20
  propGap: i32;      // 項目の行の間 6
  modDot: i32;       // 変わった印の点 5
  chip: i32;         // 札の高さ 20
  segPad: i32;       // 切り替えの札の内側の余白 2
  sliderTrack: i32;  // 帯の溝の太さ 4
  sliderKnob: i32;   // 帯のつまみ 14
  topBar: i32;       // 40（見本のまわり）
  statusBar: i32;    // 24
  rail: i32;         // 56
  panelLeft: i32;    // 260
  panelRight: i32;   // 320
  // ---- 色のパネルとスコープの寸法（tokens.json の size.color.* に足すべきもの） ----
  wheelD: i32;       // ホイールの円盤の直径の上限 108
  wheelRing: f32;    // 円盤の縁の色の輪の太さ 3
  knobR: f32;        // ホイールの玉とカーブの点の半径 5 / 4
  pointR: f32;
  curveW: f32;       // カーブの線の太さ 1.5
  curveSide: i32;    // カーブの四角の一辺の上限 300
  scopeStrip: i32;   // スコープの帯の高さ 200
  scopeKindW: i32;   // スコープの種類のドロップダウンの幅 148
  upperRatio: f32;   // 「色」のワークスペースの上の段の割合 0.66
}

// tokens.json を平らにした表（道筋 → 値の文字列か数）。
struct UcpTok {
  keys: string[];
  strs: string[];
  nums: f64[];
  isNum: bool[];
}

function ucpJsonWs(s: string, i0: usize): usize {
  let i = i0;
  while (i < s.length && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) {
    i++;
  }
  return i;
}

function ucpJsonStr(s: string, i0: usize, end: mut usize[]): string {
  let out: u8[] = [];
  let i = i0 + 1;
  while (i < s.length && s[i] != 34) {
    if (s[i] == 92 && i + 1 < s.length) {
      i++;
    }
    out.push(s[i]);
    i++;
  }
  end[0] = i + 1;
  return stringFromBytes(out);
}

function ucpJoin(path: string[]): string {
  let out: u8[] = [];
  for (let k: usize = 0; k < path.length; k++) {
    if (k > 0) {
      out.push(46);
    }
    const p = path[k].clone();
    for (let j: usize = 0; j < p.length; j++) {
      out.push(p[j]);
    }
  }
  return stringFromBytes(out);
}

// JSON を読み、葉の値（文字列か数）を道筋つきで集める。配列の中は飛ばす（"[]" の道筋になる）。
function ucpTokParse(json: string): UcpTok {
  let t: UcpTok = { keys: [], strs: [], nums: [], isNum: [] };
  let path: string[] = [];
  let isObj: bool[] = [];
  let pendingKey = false;
  let end: usize[] = [0];
  let i = ucpJsonWs(json, 0);
  while (i < json.length) {
    const b = json[i];
    if (b == 123) {
      isObj.push(true);
      path.push("");
      pendingKey = true;
      i++;
    } else if (b == 125 || b == 93) {
      if (isObj.length == 0) {
        return t;
      }
      isObj.pop();
      path.pop();
      i++;
    } else if (b == 91) {
      isObj.push(false);
      path.push("[]");
      i++;
    } else if (b == 44) {
      if (isObj.length > 0 && isObj[isObj.length - 1]) {
        pendingKey = true;
      }
      i++;
    } else if (b == 58) {
      pendingKey = false;
      i++;
    } else if (b == 34) {
      const str = ucpJsonStr(json, i, mut end);
      i = end[0];
      if (pendingKey && path.length > 0) {
        path[path.length - 1] = str;
        pendingKey = false;
      } else {
        t.keys.push(ucpJoin(path));
        t.strs.push(str);
        t.nums.push(0.0);
        t.isNum.push(false);
      }
    } else if ((b >= 48 && b <= 57) || b == 45) {
      let j = i;
      let v: f64 = 0.0;
      let neg = false;
      if (json[j] == 45) {
        neg = true;
        j++;
      }
      while (j < json.length && json[j] >= 48 && json[j] <= 57) {
        v = v * 10.0 + ((json[j] - 48) as f64);
        j++;
      }
      if (j < json.length && json[j] == 46) {
        j++;
        let f: f64 = 0.1;
        while (j < json.length && json[j] >= 48 && json[j] <= 57) {
          v = v + ((json[j] - 48) as f64) * f;
          f = f * 0.1;
          j++;
        }
      }
      if (neg) {
        v = -v;
      }
      t.keys.push(ucpJoin(path));
      t.strs.push("");
      t.nums.push(v);
      t.isNum.push(true);
      i = j;
    } else {
      i++;
    }
  }
  return t;
}

function ucpTokColor(t: UcpTok, key: string, def: u32): u32 {
  for (let k: usize = 0; k < t.keys.length; k++) {
    if (!t.isNum[k] && t.keys[k] == key) {
      const c = ukParseHex(t.strs[k]);
      if (c >= 0) {
        return c as u32;
      }
    }
  }
  return def;
}

function ucpTokNum(t: UcpTok, key: string, def: f64): f64 {
  for (let k: usize = 0; k < t.keys.length; k++) {
    if (t.isNum[k] && t.keys[k] == key) {
      return t.nums[k];
    }
  }
  return def;
}

function ucpSc(v: f64, s: f32): i32 {
  return Math.max(Math.floor(v * (s as f64) + 0.5) as i32, 1);
}

function ucpScF(v: f64, s: f32): f32 {
  return (v as f32) * s;
}

// tokens.json の中身（文字列。空なら既定値だけ）からテーマを作る。scale は UI の倍率。
export function ucpThemeFrom(json: string, scale: f32): UcpTheme {
  const t = ucpTokParse(json);
  const s = Math.min(Math.max(scale, 0.8), 2.0);
  const c = "color.dark.";
  return {
    scale: s,
    bg0: ucpTokColor(t, c + "bg.0", 0xff141414),
    bg1: ucpTokColor(t, c + "bg.1", 0xff1b1b1b),
    bg2: ucpTokColor(t, c + "bg.2", 0xff222222),
    bg3: ucpTokColor(t, c + "bg.3", 0xff2c2c2c),
    bg4: ucpTokColor(t, c + "bg.4", 0xff383838),
    bgViewer: ucpTokColor(t, c + "bg.viewer", 0xff0d0d0d),
    bgPopover: ucpTokColor(t, c + "bg.popover", 0xff1f1f1f),
    line: ucpTokColor(t, c + "line.default", 0xff2c2c2c),
    lineStrong: ucpTokColor(t, c + "line.strong", 0xff3c3c3c),
    lineControl: ucpTokColor(t, c + "line.control", 0xff767676),
    text1: ucpTokColor(t, c + "text.1", 0xffe6e6e6),
    text2: ucpTokColor(t, c + "text.2", 0xffa3a3a3),
    text3: ucpTokColor(t, c + "text.3", 0xff8c8c8c),
    textDisabled: ucpTokColor(t, c + "text.disabled", 0xff666666),
    textOnDark: ucpTokColor(t, c + "text.onDark", 0xfff2f2f2),
    accent: ucpTokColor(t, c + "accent.default", 0xff4c8dff),
    accentHover: ucpTokColor(t, c + "accent.hover", 0xff6fa3ff),
    accentTint: ucpTokColor(t, c + "accent.tint", 0x294c8dff),
    accentTintSolid: ucpTokColor(t, c + "accent.tintSolid", 0xff1e2a3d),
    ok: ucpTokColor(t, c + "semantic.ok", 0xff4cc38a),
    warn: ucpTokColor(t, c + "semantic.warn", 0xfff08a3c),
    error: ucpTokColor(t, c + "semantic.error", 0xffff706c),
    focusOuter: ucpTokColor(t, c + "semantic.focusOuter", 0xff000000),
    chR: ucpTokColor(t, c + "scope.r", 0xffe06a6a),
    chG: ucpTokColor(t, c + "scope.g", 0xff5fbf7a),
    chB: ucpTokColor(t, c + "scope.b", 0xff6a95e6),
    chY: ucpTokColor(t, c + "scope.luma", 0xffd9d9d9),
    clipVideo: ucpTokColor(t, c + "clip.video.mark", 0xff56b4e9),
    fsXs: ucpScF(ucpTokNum(t, "font.size.xs.size", 11.0), s),
    fsSm: ucpScF(ucpTokNum(t, "font.size.sm.size", 12.0), s),
    fsMd: ucpScF(ucpTokNum(t, "font.size.md.size", 13.0), s),
    fsLg: ucpScF(ucpTokNum(t, "font.size.lg.size", 15.0), s),
    fsCodeSm: ucpScF(ucpTokNum(t, "font.size.codeSm.size", 11.0), s),
    s1: ucpSc(ucpTokNum(t, "space.1", 4.0), s),
    s2: ucpSc(ucpTokNum(t, "space.2", 8.0), s),
    s3: ucpSc(ucpTokNum(t, "space.3", 12.0), s),
    s4: ucpSc(ucpTokNum(t, "space.4", 16.0), s),
    s5: ucpSc(ucpTokNum(t, "space.5", 24.0), s),
    panelHeader: ucpSc(ucpTokNum(t, "size.panelHeader", 32.0), s),
    tabBar: ucpSc(ucpTokNum(t, "size.tabBar", 32.0), s),
    row: ucpSc(ucpTokNum(t, "size.propertyRow", 28.0), s),
    field: ucpSc(ucpTokNum(t, "size.field", 24.0), s),
    btnSm: ucpSc(ucpTokNum(t, "size.button.sm", 24.0), s),
    btnMd: ucpSc(ucpTokNum(t, "size.button.md", 28.0), s),
    hit: ucpSc(ucpTokNum(t, "size.hitTargetMin", 24.0), s),
    iconSm: ucpSc(ucpTokNum(t, "size.icon.sm", 16.0), s),
    rSm: ucpSc(ucpTokNum(t, "radius.sm", 3.0), s),
    rMd: ucpSc(ucpTokNum(t, "radius.md", 5.0), s),
    rLg: ucpSc(ucpTokNum(t, "radius.lg", 8.0), s),
    hair: Math.max(Math.floor((ucpTokNum(t, "border.hairline", 1.0) as f32) * s + 0.25) as i32, 1),
    focusW: ucpSc(ucpTokNum(t, "border.focus", 2.0), s),
    propLabel: ucpSc(ucpTokNum(t, "size.propertyLabel", 86.0), s),
    propIcon: ucpSc(ucpTokNum(t, "size.propIcon", 20.0), s),
    propGap: ucpSc(ucpTokNum(t, "size.propGap", 6.0), s),
    modDot: ucpSc(ucpTokNum(t, "size.modDot", 5.0), s),
    chip: ucpSc(ucpTokNum(t, "size.chip", 20.0), s),
    segPad: ucpSc(ucpTokNum(t, "size.segmentedPad", 2.0), s),
    sliderTrack: ucpSc(ucpTokNum(t, "size.slider.track", 4.0), s),
    sliderKnob: ucpSc(ucpTokNum(t, "size.slider.knob", 14.0), s),
    topBar: ucpSc(ucpTokNum(t, "size.topBar", 40.0), s),
    statusBar: ucpSc(ucpTokNum(t, "size.statusBar", 24.0), s),
    rail: ucpSc(ucpTokNum(t, "size.rail", 56.0), s),
    panelLeft: ucpSc(ucpTokNum(t, "size.panelDefault.left", 260.0), s),
    panelRight: ucpSc(ucpTokNum(t, "size.panelDefault.right", 320.0), s),
    wheelD: ucpSc(ucpTokNum(t, "size.color.wheel", 108.0), s),
    wheelRing: ucpScF(ucpTokNum(t, "size.color.wheelRing", 3.0), s),
    knobR: ucpScF(ucpTokNum(t, "size.color.wheelBall", 5.0), s),
    pointR: ucpScF(ucpTokNum(t, "size.color.curvePoint", 4.0), s),
    curveW: ucpScF(ucpTokNum(t, "size.color.curveLine", 1.5), s),
    curveSide: ucpSc(ucpTokNum(t, "size.color.curve", 300.0), s),
    scopeStrip: ucpSc(ucpTokNum(t, "size.color.scopeStrip", 200.0), s),
    scopeKindW: ucpSc(ucpTokNum(t, "size.color.scopeKind", 148.0), s),
    upperRatio: ucpTokNum(t, "size.color.upperRatio", 0.66) as f32,
  };
}

// uikit の汎用の部品（ドロップダウン・スライダー・ボタン）を製品の色と大きさに合わせる。
export function ucpUkTheme(u: mut UkTheme, t: UcpTheme): void {
  ukThemeSet(mut u, "color.bg", t.bg0, 0.0, true);
  ukThemeSet(mut u, "color.panel", t.bg1, 0.0, true);
  ukThemeSet(mut u, "color.panelAlt", t.bg2, 0.0, true);
  ukThemeSet(mut u, "color.raised", t.bg3, 0.0, true);
  ukThemeSet(mut u, "color.raisedHover", t.bg4, 0.0, true);
  ukThemeSet(mut u, "color.raisedActive", t.bg2, 0.0, true);
  ukThemeSet(mut u, "color.inputBg", t.bg3, 0.0, true);
  ukThemeSet(mut u, "color.border", t.line, 0.0, true);
  ukThemeSet(mut u, "color.borderStrong", t.lineControl, 0.0, true);
  ukThemeSet(mut u, "color.text", t.text1, 0.0, true);
  ukThemeSet(mut u, "color.textDim", t.text2, 0.0, true);
  ukThemeSet(mut u, "color.textOff", t.textDisabled, 0.0, true);
  ukThemeSet(mut u, "color.accent", t.accent, 0.0, true);
  ukThemeSet(mut u, "color.accentHover", t.accentHover, 0.0, true);
  ukThemeSet(mut u, "color.accentActive", t.accent, 0.0, true);
  ukThemeSet(mut u, "color.onAccent", t.textOnDark, 0.0, true);
  ukThemeSet(mut u, "color.danger", t.error, 0.0, true);
  ukThemeSet(mut u, "color.success", t.ok, 0.0, true);
  ukThemeSet(mut u, "color.warning", t.warn, 0.0, true);
  ukThemeSet(mut u, "color.focus", t.accent, 0.0, true);
  ukThemeSet(mut u, "color.selection", t.accentTintSolid, 0.0, true);
  ukThemeSet(mut u, "color.track", t.bg3, 0.0, true);
  ukThemeSet(mut u, "color.tipBg", t.bgPopover, 0.0, true);
  ukThemeSet(mut u, "color.tipText", t.text1, 0.0, true);
  const s = t.scale;
  ukThemeSet(mut u, "size.font", 0, t.fsMd / s, false);
  ukThemeSet(mut u, "size.fontSmall", 0, t.fsSm / s, false);
  ukThemeSet(mut u, "size.fontLarge", 0, t.fsLg / s, false);
  ukThemeSet(mut u, "size.ctrlH", 0, (t.field as f32) / s, false);
  ukThemeSet(mut u, "size.rowH", 0, (t.row as f32) / s, false);
  ukThemeSet(mut u, "size.pad", 0, (t.s2 as f32) / s, false);
  ukThemeSet(mut u, "size.gap", 0, (t.s1 as f32) / s, false);
  ukThemeSet(mut u, "size.radius", 0, (t.rMd as f32) / s, false);
  ukThemeSet(mut u, "size.radiusSm", 0, (t.rSm as f32) / s, false);
  ukThemeSet(mut u, "size.tabH", 0, (t.tabBar as f32) / s, false);
  ukThemeSet(mut u, "size.menuH", 0, (t.row as f32) / s, false);
  ukThemeScale(mut u, s);
}
