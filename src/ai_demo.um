// AI の提案と履歴のパネル（src/ui_ai/）の見本。mockups/ai.html と同じ状態を、ダミーのデータで描く。
//
//   node <UM>/src/cli.ts build src/ai_demo.um --target host -o build/ai-demo
//   SDL_VIDEO_DRIVER=offscreen build/ai-demo [--state review|card|thinking|history|empty|offline]
//        [--tokens docs/design/tokens.json] [--scale 1.0] [--frames N] [--shot x.bmp]
//        [--click x,y@F] [--move x,y@F] [--key 名前@F]（enter esc up down space tab ctrl+enter alt+c ctrl+j 1 文字）
//        [--active ai|timeline]（作業中のパネル。timeline なら AI のキーは取らない）
//
// 画面の配置は mockups/ai.html（1440×900、右の列 440、タイムラインを低くした状態）に合わせる。
// 真ん中（素材・モニター）とタイムラインのクリップは、ほかの部品の場所を示すだけの仮の絵。
import {
  UkCtx, ukNew, ukBegin, ukEnd, ukDrawRect, ukDrawRound, ukDrawTextIn, ukPushClip, ukPopClip, ukEventMouseMove,
  ukEventMouseButton, ukEventKey, ukToast, UK_KEY_ENTER, UK_KEY_ESC, UK_KEY_UP, UK_KEY_DOWN, UK_KEY_SPACE,
  UK_KEY_TAB, UK_KEY_CHAR, UK_MOD_CTRL, UK_MOD_ALT, UK_MOD_SHIFT, ukKeyTakeMods, ukEventText,
} from "./uikit/core.um";
import { UkRect, ukRect } from "./uikit/base.um";
import { ukThemeDefault, ukThemeFromTokens } from "./uikit/theme.um";
import { UkWinRes, ukWinResNew, ukFeedWindowEvent } from "./uikit/window.um";
import { ukWriteBmp } from "./uikit/bmp.um";
import { uiFont } from "./ttf.um";
import { AiTheme, AiTokens, aiTokensParse, aiTokensEmpty, aiThemeFrom, aiTokColor } from "./ui_ai/ai_theme.um";
import {
  AiPanelState, AiProposal, AiOp, AiHist, AiEvent, AiDiagItem, aiPanelNew, aiProposalNew, aiOpNew, aiChip,
  aiDiffOfLine, aiPreviewOf, aiStrs, aiPanelApplyEvent, aiPendingCount, aiSelectedOps, aiHistPush, aiHistToJson,
  aiHistNew, aiHistOfProposal, aiRecomputeSummary, aiToastShow, aiRecheckWanted, aiStatusText, aiTimecode, aiDiffClone,
  AI_CHIP_PLAIN, AI_CHIP_RIPPLE, AI_CHIP_OK, AI_CHIP_WARN, AI_CHIP_MONO, AI_PV_CUT, AI_PV_SET,
  AI_WHO_HUMAN, AI_WHO_AI, AI_WHO_TEXT, AI_PROP_REVIEW, AI_PROP_APPLIED,
  AI_EV_APPLY, AI_EV_REJECT, AI_EV_UNDO, AI_EV_REDO, AI_EV_UNDO_TO, AI_EV_REDO_TO, AI_EV_HIST_DIFF, AI_EV_ASK,
  AI_EV_FIX, AI_EV_FOCUS_ASK, AI_EV_UNREJECT, AI_EV_HOVER_HIST,
} from "./ui_ai/ai_model.um";
import {
  aiTabBar, aiTabAi, aiTabHistory, aiProblems, aiPanelKeys, aiDrawPreview, aiTopBadge, aiDrawToast, aiStatusDiagText,
  aiSharingText,
} from "./ui_ai/ai_panel.um";
import { aiText, aiIconSparkle, aiIconEye, aiIconError } from "./ui_ai/ai_draw.um";
import { AI_T_REJECTED, AI_T_APPLIED } from "./ui_ai/ai_text.um";

// ---- 見本のデータ（mockups/ai.html の「谷中の豆腐店」） ----

function aidProposal(): AiProposal {
  let p = aiProposalNew("p_0001", "インタビューの言いよどみを詰めて。BGM のサビを最後の店先に合わせたい。",
    "3 か所を詰め、BGM のサビを合わせます。");
  p.summary = "インタビューの言いよどみ 3 か所を詰め、BGM のサビをエンディングの店先に合わせます。";
  p.context = [aiChip(AI_CHIP_MONO, "int_a"), aiChip(AI_CHIP_MONO, "00:00:22:15")];
  p.contextMore = 2;
  // 動くクリップの ID（op 1 は 14 個、op 2 はその後ろの 9 個）。上の 3 つの数は aiRecomputeSummary で作る
  let ids1: string[] = [];
  let ids2: string[] = [];
  for (let k = 0; k < 14; k++) {
    ids1.push(`c${k}`);
    if (k >= 5) {
      ids2.push(`c${k}`);
    }
  }
  let o1 = aiOpNew("cut 24.200000 25.000000", "からの「えーと」0.80 秒（24 コマ）を全トラックから切り取り、後ろを詰めます");
  o1.tc = aiTimecode(24.2, 30);
  o1.movedIds = ids1;
  o1.lenSec = -0.8;
  o1.chips = [aiChip(AI_CHIP_RIPPLE, "詰める"), aiChip(AI_CHIP_PLAIN, "後ろの 14 個が 0.80 秒前へ"), aiChip(AI_CHIP_PLAIN, "int_a を 2 つに分ける")];
  o1.diff = [
    aiDiffOfLine(23, "… id=int_a in=133.4 dur=12.6", "… id=int_a in=133.4 dur=5.8"),
    { toks: [{ kind: 4, text: "24 行目" }, { kind: 3, text: "video … id=int_a_2 in=140.0 dur=6.0" }] },
  ];
  o1.pv = AI_PV_CUT;
  o1.t0 = 24.2;
  o1.t1 = 25.0;
  o1.tag = "−0.80";
  o1.rippleN = 14;
  o1.rippleSec = -0.8;
  o1.json = "{\"op\":\"cut\",\"from\":\"0:24.200\",\"to\":\"0:25.000\",\"ripple\":true}";
  let o2 = aiOpNew("cut 43.300000 43.933333", "からの「あの」0.63 秒（19 コマ）を切り取り、後ろを詰めます");
  o2.tc = aiTimecode(43.3, 30);
  o2.note = "（1 を適用した後の時刻）";
  o2.movedIds = ids2;
  o2.lenSec = -0.63;
  o2.chips = [aiChip(AI_CHIP_RIPPLE, "詰める"), aiChip(AI_CHIP_PLAIN, "後ろの 9 個が 0.63 秒前へ")];
  o2.pv = AI_PV_CUT;
  o2.t0 = 44.1;
  o2.t1 = 44.733;
  o2.tag = "−0.63";
  o2.rippleN = 9;
  o2.rippleSec = -0.63;
  o2.json = "{\"op\":\"cut\",\"from\":43.3,\"to\":43.933333,\"ripple\":true}";
  let o3 = aiOpNew("cut 63.966667 64.566667", "からの「まあ」0.60 秒（18 コマ）を切り取り、後ろを詰めます");
  o3.tc = aiTimecode(63.966667, 30);
  o3.lenSec = -0.6;
  o3.chips = [aiChip(AI_CHIP_WARN, "字幕「この町が好きだから」が文の途中で切れます")];
  o3.on = false;
  o3.byHuman = true;
  o3.pv = AI_PV_CUT;
  o3.t0 = 65.4;
  o3.t1 = 66.0;
  o3.tag = "−0.60";
  o3.rippleN = 4;
  o3.rippleSec = -0.6;
  o3.json = "{\"op\":\"cut\",\"from\":63.966667,\"to\":64.566667,\"ripple\":true}";
  let o4 = aiOpNew("set bgm in=12.400000", "BGM を素材の " + aiTimecode(12.4, 30) + " から始めます");
  o4.chips = [aiChip(AI_CHIP_OK, "マーカー「サビ」と 0 コマ差"), aiChip(AI_CHIP_PLAIN, "動くクリップなし")];
  o4.pv = AI_PV_SET;
  o4.t0 = 0.0;
  o4.t1 = 92.0;
  o4.track = 5;
  o4.clipId = "bgm";
  o4.tag = "素材のイン " + aiTimecode(0.0, 30) + " → " + aiTimecode(12.4, 30);
  o4.okTag = "✓ サビと 0 コマ差";
  o4.okTagT = 80.4;
  o4.json = "{\"op\":\"set\",\"clip\":\"bgm\",\"key\":\"in\",\"value\":12.4}";
  o4.diff = [aiDiffOfLine(52, "audio bgm.wav id=bgm at=0 in=0", "audio bgm.wav id=bgm at=0 in=12.4")];
  p.ops = [o1, o2, o3, o4];
  aiRecomputeSummary(mut p);
  return p;
}

function aidProposal2(): AiProposal {
  let p = aiProposalNew("p_0002", "後半のテロップを字幕のトラックにそろえて。", "テロップ 2 個を V3 に移します。");
  p.summary = "後半のテロップ 2 個を V3（字幕・テロップ）に移し、表示の長さを 4 秒にそろえます。";
  p.moved = 2;
  p.recomputed = "計算し直しました（動くクリップ 1 → 2）";
  p.ops = [aiOpNew("move sub_05 track=2", "テロップ「毎日、同じ味を」を V3 へ移します"), aiOpNew("set sub_06 dur=4", "テロップ「制作 谷中映像研究会」を 4 秒にします")];
  return p;
}

function aidHist(t: string, who: i32, ops: string[], desc: string): AiHist {
  return aiHistNew(t, who, ops, desc);
}

function aidHistory(st: mut AiPanelState): void {
  let h1 = aidHist("2026-11-21T14:20:11+09:00", AI_WHO_HUMAN, ["split int_a 31"], "店主インタビュー_A.mp4 を 00:00:31:00 で分割しました");
  h1.changes = [aiDiffOfLine(23, "video int_a.mp4 id=int_a at=18.4 dur=25.6", "video int_a.mp4 id=int_a at=18.4 dur=12.6")];
  aiHistPush(mut st, h1);
  let h2 = aidHist("2026-11-21T14:22:40+09:00", AI_WHO_TEXT, ["set sub_03 text=「毎日、同じ味を」"], "外で 本編_v3.mzc が変わりました。読み直しました（1 行）");
  h2.changes = [aiDiffOfLine(31, "text id=sub_03 text=「毎日同じ味を」", "text id=sub_03 text=「毎日、同じ味を」")];
  aiHistPush(mut st, h2);
  let h3 = aidHist("2026-11-21T14:26:05+09:00", AI_WHO_AI, ["cut 12.000000 12.400000", "cut 51.200000 51.700000", "set sub_02 at=24", "set amb dur=18.4"], "");
  h3.applied = true;
  h3.open = true;
  // AI の提案の行の差分は、中の op の差分を合わせたもの
  h3.changes = [
    aiDiffOfLine(19, "video shikomi.mp4 id=shikomi at=6.5 dur=11.9", "video shikomi.mp4 id=shikomi at=6.5 dur=11.5"),
    aiDiffOfLine(33, "text id=sub_02 at=24.4", "text id=sub_02 at=24"),
  ];
  aiHistPush(mut st, h3);
  let h4 = aidHist("2026-11-21T14:30:52+09:00", AI_WHO_HUMAN, ["move steam at=74"], "湯気_スロー.mp4 を 00:01:14:00 へ動かしました");
  h4.changes = [aiDiffOfLine(40, "video steam.mp4 id=steam at=75.2", "video steam.mp4 id=steam at=74")];
  aiHistPush(mut st, h4);
  let h5 = aidHist("2026-11-21T14:32:05+09:00", AI_WHO_HUMAN, ["set bgm volume=0.45"], "朝の光（BGM）.wav の音量を 45% にしました");
  aiHistPush(mut st, h5);
  st.histPos = 4;
  st.histDiff = 0;
}

function aidDiags(): AiDiagItem[] {
  return [
    {
      severity: "warning", code: "subtitle-cut", msg: "字幕「この町が好きだから」がクリップの途中で切れます。",
      hint: "字幕の終わりを 00:01:05:00 より前にするか、切る範囲を外してください。", file: "本編_v3.mzc", line: 47, col: 3,
      suggest: "", fixOp: "",
    },
    {
      severity: "error", code: "unknown-key", msg: "'colour' というキーはありません。",
      hint: "'color' のことですか？", file: "本編_v3.mzc", line: 7, col: 12, suggest: "color", fixOp: "renamekey title_1 colour color",
    },
  ];
}

// ---- 仮の周り（上の帯・素材・モニター・タイムライン・状態の帯） ----

struct AidClip {
  tr: i32;
  s: f64;
  e: f64;
  kind: string;
  name: string;
}

function aidC(tr: i32, s: f64, e: f64, kind: string, name: string): AidClip {
  return { tr, s, e, kind: kind.clone(), name: name.clone() };
}

function aidClips(): AidClip[] {
  return [
    aidC(2, 0.0, 6.5, "video", "オープニング_店先.mp4"), aidC(2, 6.5, 18.4, "video", "仕込み_手元.mp4"),
    aidC(2, 18.4, 31.0, "video", "店主インタビュー_A.mp4"), aidC(2, 31.0, 38.5, "video", "豆腐を切る_寄り.mp4"),
    aidC(2, 38.5, 52.0, "video", "店主インタビュー_A.mp4"), aidC(2, 52.0, 60.0, "video", "商店街_夕方.mp4"),
    aidC(2, 60.0, 74.0, "video", "店主インタビュー_B.mp4"), aidC(2, 74.0, 82.0, "video", "湯気_スロー.mp4"),
    aidC(2, 82.0, 92.0, "video", "エンディング_夜の店先.mp4"),
    aidC(1, 10.0, 14.0, "video", "大豆を洗う.mp4"), aidC(1, 26.0, 29.5, "image", "看板_寄り.png"), aidC(1, 44.0, 49.0, "video", "常連さん.mp4"),
    aidC(0, 19.0, 23.5, "text", "店主 丸山 和子さん"), aidC(0, 24.0, 28.0, "text", "「朝 4 時から仕込みます」"),
    aidC(0, 40.0, 44.5, "text", "「毎日、同じ味を」"), aidC(0, 61.0, 65.0, "text", "「この町が好きだから」"),
    aidC(0, 84.0, 90.0, "text", "制作 谷中映像研究会"),
    aidC(3, 18.4, 31.0, "audio", "店主インタビュー_A.mp4"), aidC(3, 38.5, 52.0, "audio", "店主インタビュー_A.mp4"),
    aidC(3, 60.0, 74.0, "audio", "店主インタビュー_B.mp4"),
    aidC(4, 0.0, 18.4, "audio", "商店街の音.wav"), aidC(4, 31.0, 38.5, "audio", "包丁の音.wav"), aidC(4, 52.0, 60.0, "audio", "夕方の雑踏.wav"),
    aidC(5, 0.0, 92.0, "audio", "朝の光（BGM）.wav"),
  ];
}

function aidTimeline(ui: mut UkCtx, th: AiTheme, tk: AiTokens, st: AiPanelState, r: UkRect, active: bool): void {
  ukDrawRect(mut ui, r, th.bg1);
  // ツールバー（36）
  const tb = 36;
  ukDrawRect(mut ui, ukRect(r.x, r.y, r.w, tb), th.bg2);
  ukDrawRect(mut ui, ukRect(r.x, r.y + tb - 1, r.w, 1), th.line);
  aiText(mut ui, r.x + th.s3, r.y, tb, "00:01:20:12", th.fsLg, th.text1);
  if (active) {
    ukDrawRect(mut ui, ukRect(r.x, r.y, r.w, 2), th.accent);
  }
  if (st.review >= 0) {
    const bx = ukRect(r.x + 290, r.y + 4, 1000, 28);
    ukDrawRound(mut ui, bx, th.rMd, th.aiTint);
    aiIconSparkle(mut ui, ukRect(bx.x + 10, bx.y + 6, th.iconSm, th.iconSm), th.ai);
    const w1 = aiText(mut ui, bx.x + 32, bx.y, bx.h, "提案を重ねて表示しています", th.fsSm, th.ai);
    aiText(mut ui, bx.x + 36 + w1, bx.y, bx.h, "· 触ってもかまいません。変えたら提案を計算し直します", th.fsSm, th.text2);
  }
  // ルーラーと見出し
  const hdrW = 176;
  const rulerH = 26;
  const ry = r.y + tb;
  ukDrawRect(mut ui, ukRect(r.x, ry, r.w, rulerH), th.bg2);
  ukDrawRect(mut ui, ukRect(r.x, ry + rulerH - 1, r.w, 1), th.line);
  if (st.review >= 0) {
    aiText(mut ui, r.x + 8, ry, rulerH, "提案を表示中", th.fsSm, th.ai);
  }
  const names: string[] = ["字幕・テロップ", "Bロール", "本編", "本編の声", "環境音", "BGM"];
  const ids: string[] = ["V3", "V2", "V1", "A1", "A2", "A3"];
  const hs: i32[] = [26, 28, 34, 34, 26, 30];
  let ys: i32[] = [];
  let y = ry + rulerH;
  for (let i: usize = 0; i < 6; i++) {
    if (i == 3) {
      ukDrawRect(mut ui, ukRect(r.x, y, r.w, 4), th.bg0);
      y = y + 4;
    }
    ys.push(y);
    ukDrawRect(mut ui, ukRect(r.x, y, hdrW, hs[i]), th.bg2);
    ukDrawRect(mut ui, ukRect(r.x, y + hs[i] - 1, r.w, 1), th.line);
    const tid = ukRect(r.x + 6, y + (hs[i] - 18) / 2, 28, 18);
    ukDrawRound(mut ui, tid, th.rSm, (i == 2 || i == 3) ? th.accent : th.bg3);
    ukDrawTextIn(mut ui, tid, ids[i], th.fsXs, (i == 2 || i == 3) ? th.textOnLight : th.text2, 1);
    aiText(mut ui, r.x + 40, y, hs[i], names[i], th.fsSm, th.text1);
    y = y + hs[i];
  }
  ukDrawRect(mut ui, ukRect(r.x + hdrW - 1, ry, 1, y - ry), th.line);
  const lanes = ukRect(r.x + hdrW, ry + rulerH, r.w - hdrW - 28, y - ry - rulerH);
  const pps: f64 = 13.2;
  ukPushClip(mut ui, lanes);
  for (const c of aidClips()) {
    const x0 = lanes.x + (Math.floor(c.s * pps) as i32);
    const x1 = lanes.x + (Math.floor(c.e * pps) as i32);
    const cr = ukRect(x0, ys[c.tr as usize] + 2, x1 - x0 - 1, hs[c.tr as usize] - 4);
    const face = aiTokColor(tk, "color.dark.clip." + c.kind + ".face", th.bg3);
    const mark = aiTokColor(tk, "color.dark.clip." + c.kind + ".mark", th.text2);
    ukDrawRound(mut ui, cr, th.rSm, face);
    ukDrawRect(mut ui, ukRect(cr.x, cr.y, cr.w, 2), mark);
    ukDrawTextIn(mut ui, ukRect(cr.x + 6, cr.y + 2, cr.w - 8, 16), c.name, th.fsSm, aiTokColor(tk, "color.dark.text.onDark", th.text1), 0);
  }
  ukPopClip(mut ui);
  // 再生ヘッド
  const phx = lanes.x + (Math.floor(80.4 * pps) as i32);
  ukDrawRect(mut ui, ukRect(phx, ry, 1, y - ry), aiTokColor(tk, "color.dark.semantic.playhead", th.error));
  // 提案の重ね
  if (st.review >= 0) {
    const pv = aiPreviewOf(st.proposals[st.review as usize], st.focusOp, pps, 40.0);
    aiDrawPreview(mut ui, th, pv, lanes, 0.0, pps, ys, hs, ys[1] + 6, ys[2] + hs[2] + 1, ys[3] + hs[3] - 18);
  }
}

function aidChrome(ui: mut UkCtx, th: AiTheme, st: AiPanelState, W: i32, H: i32): void {
  ukDrawRect(mut ui, ukRect(0, 0, W, H), th.bg0);
  // 上の帯（40）
  ukDrawRect(mut ui, ukRect(0, 0, W, 40), th.bg2);
  ukDrawRect(mut ui, ukRect(0, 39, W, 1), th.line);
  aiText(mut ui, 44, 0, 40, "谷中の豆腐店 / 本編 v3", th.fsMd, th.text1);
  aiTopBadge(mut ui, th, st, ukRect(W - 620, 0, 200, 40));
  // レール（56）と素材の欄（220）とモニター（仮）
  ukDrawRect(mut ui, ukRect(0, 40, 56, 592), th.bg2);
  ukDrawRect(mut ui, ukRect(56 + 260, 40, 1000 - 316, 592), aiTokColorDefault(th));
  ukDrawTextIn(mut ui, ukRect(316, 40, 684, 592), "（モニター: 今 ／ 左右で比べる ／ 提案の後）", th.fsSm, th.text3, 1);
  // 状態の帯
  ukDrawRect(mut ui, ukRect(0, H - 24, W, 24), th.bg2);
  ukDrawRect(mut ui, ukRect(0, H - 24, W, 1), th.line);
  const s = aiStatusText(st);
  if (s.length > 0) {
    aiIconSparkle(mut ui, ukRect(12, H - 20, 16, 16), st.connected ? th.ai : th.text3);
    aiText(mut ui, 34, H - 24, 24, s, th.fsSm, st.connected ? th.ai : th.text2);
  }
  const sh = aiSharingText(st);
  if (sh.length > 0) {
    aiIconEye(mut ui, ukRect(W - 420, H - 18, 12, 12), th.ai);
    aiText(mut ui, W - 404, H - 24, 24, sh, th.fsSm, th.ai);
  }
  aiIconError(mut ui, ukRect(W - 282, H - 18, 12, 12), st.diags.length > 0 ? th.error : th.text3);
  aiText(mut ui, W - 266, H - 24, 24, aiStatusDiagText(st), th.fsSm, th.text2);
}

function aiTokColorDefault(th: AiTheme): u32 {
  return th.bg0;
}

// ---- 入力（見た目の確かめ用） ----

struct AidEv {
  frame: i64;
  kind: i32;
  x: i32;
  y: i32;
  key: i32;
  mods: i32;
  text: string;
}

function aidFind(s: string, b: u8): i32 {
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == b) {
      return i as i32;
    }
  }
  return -1;
}

function aidSub(s: string, a: usize, b: usize): string {
  let out: u8[] = [];
  for (let i = a; i < b && i < s.length; i++) {
    out.push(s[i]);
  }
  return stringFromBytes(out);
}

function aidInt(s: string, a: usize, b: usize): i64 {
  let v: i64 = 0;
  for (let i = a; i < b && i < s.length; i++) {
    if (s[i] >= 48 && s[i] <= 57) {
      v = v * 10 + ((s[i] - 48) as i64);
    }
  }
  return v;
}

function aidKey(n0: string, mods: mut i32[]): i32 {
  let n = n0.clone();
  while (true) {
    if (n.length > 5 && aidSub(n, 0, 5) == "ctrl+") {
      mods[0] = mods[0] | UK_MOD_CTRL;
      n = aidSub(n, 5, n.length);
    } else if (n.length > 4 && aidSub(n, 0, 4) == "alt+") {
      mods[0] = mods[0] | UK_MOD_ALT;
      n = aidSub(n, 4, n.length);
    } else if (n.length > 6 && aidSub(n, 0, 6) == "shift+") {
      mods[0] = mods[0] | UK_MOD_SHIFT;
      n = aidSub(n, 6, n.length);
    } else {
      break;
    }
  }
  switch (n) {
    case "enter": return UK_KEY_ENTER;
    case "esc": return UK_KEY_ESC;
    case "up": return UK_KEY_UP;
    case "down": return UK_KEY_DOWN;
    case "space": return UK_KEY_SPACE;
    case "tab": return UK_KEY_TAB;
  }
  if (n.length == 1) {
    return UK_KEY_CHAR + (n[0] as i32);
  }
  return 0;
}

// ---- 出来事を当てる（アプリの代わり。ops.um への適用はせず、履歴に積むだけ） ----

function aidHandle(ui: mut UkCtx, st: mut AiPanelState, e: AiEvent): void {
  if (e.kind != AI_EV_HOVER_HIST) {
    eprint(`ev: kind=${e.kind} prop=${e.prop} index=${e.index} text=` + e.text);
  }
  aiPanelApplyEvent(mut st, e);
  if (e.kind == AI_EV_APPLY && e.prop >= 0) {
    // 本物のアプリはここで aiSelectedArgs を runOps に渡して dry-run し直し、aiMarkRecheck が false なら書く
    const h = aiHistOfProposal(st.proposals[e.prop as usize], "2026-11-21T14:33:00+09:00");
    eprint("history: " + aiHistToJson(h));
    aiHistPush(mut st, h);
    st.proposals[e.prop as usize].state = AI_PROP_APPLIED;
    st.review = -1;
    ukToast(mut ui, AI_T_APPLIED, 1);
  } else if (e.kind == AI_EV_REJECT) {
    aiToastShow(mut st, AI_T_REJECTED, e.prop, ui.now);
  } else if (e.kind == AI_EV_UNDO && st.histPos > 0) {
    st.histPos = st.histPos - 1;
  } else if (e.kind == AI_EV_REDO && (st.histPos as usize) < st.history.length) {
    st.histPos = st.histPos + 1;
  } else if (e.kind == AI_EV_UNDO_TO || e.kind == AI_EV_REDO_TO) {
    st.histPos = e.index + 1;
  } else if (e.kind == AI_EV_HOVER_HIST) {
    eprint(`hover: ${e.index}`);
  } else if (e.kind == AI_EV_ASK) {
    st.thinking = true;
    st.thinkingSince = ui.now;
  } else if (e.kind == AI_EV_FIX) {
    eprint("fix: " + e.text);
  }
}

export function main(): i32 {
  const a = args();
  let W: i32 = 1440;
  let H: i32 = 900;
  let maxFrames: i64 = -1;
  let shot = "";
  let tokens = "docs/design/tokens.json";
  let state = "review";
  let activePanel = "ai";
  let evs: AidEv[] = [];
  let i: usize = 0;
  while (i + 1 < a.length) {
    const opt = a[i].clone();
    const val = a[i + 1].clone();
    if (opt == "--frames") {
      maxFrames = aidInt(val, 0, val.length);
    } else if (opt == "--shot") {
      shot = val;
    } else if (opt == "--tokens") {
      tokens = val;
    } else if (opt == "--state") {
      state = val;
    } else if (opt == "--active") {
      activePanel = val;
    } else if (opt == "--type") {
      // --type 文字@F（英数字。入力の欄に打つ）
      const at = aidFind(val, 64);
      if (at >= 0) {
        evs.push({ frame: aidInt(val, (at as usize) + 1, val.length), kind: 5, x: 0, y: 0, key: 0, mods: 0, text: aidSub(val, 0, at as usize) });
      }
    } else if (opt == "--click" || opt == "--move" || opt == "--key") {
      const at = aidFind(val, 64);
      if (at >= 0) {
        const body = aidSub(val, 0, at as usize);
        let ev: AidEv = { frame: aidInt(val, (at as usize) + 1, val.length), kind: 0, x: 0, y: 0, key: 0, mods: 0, text: "" };
        const comma = aidFind(body, 44);
        if (comma >= 0) {
          ev.x = aidInt(body, 0, comma as usize) as i32;
          ev.y = aidInt(body, (comma as usize) + 1, body.length) as i32;
        }
        if (opt == "--click") {
          ev.kind = 2;
        } else if (opt == "--move") {
          ev.kind = 1;
        } else {
          ev.kind = 4;
          let m: i32[] = [0];
          ev.key = aidKey(body, mut m);
          ev.mods = m[0];
        }
        evs.push(ev);
      }
    } else {
      eprint(`warning: unknown option '${opt}'`);
    }
    i += 2;
  }
  let tk = aiTokensEmpty();
  let theme = ukThemeDefault(1.0);
  const tj = readFile(tokens);
  if (tj != null) {
    const js = stringFromBytes(tj);
    tk = aiTokensParse(js);
    ukThemeFromTokens(mut theme, js);
    eprint(`tokens: ${tk.keys.length} 個の値`);
  } else {
    eprint(`warning: cannot read '${tokens}'（既定の値で描きます）`);
  }
  const th = aiThemeFrom(tk, theme.scale);
  let ui = ukNew(theme, own uiFont());
  // 状態
  let st = aiPanelNew();
  st.proposals = [aidProposal(), aidProposal2()];
  st.share = [aiChip(AI_CHIP_MONO, "int_b2"), aiChip(AI_CHIP_MONO, "00:00:31:14"), aiChip(AI_CHIP_PLAIN, "イン〜アウト")];
  st.diags = aidDiags();
  aidHistory(mut st);
  let tab = 2;
  if (state == "review") {
    st.review = 0;
    st.proposals[0].state = AI_PROP_REVIEW;
  } else if (state == "thinking") {
    st.proposals = [];
    st.thinking = true;
  } else if (state == "history") {
    tab = 1;
  } else if (state == "empty") {
    st.proposals = [];
    st.history = [];
    st.histPos = 0;
    st.diags = [];
  } else if (state == "offline") {
    st.connected = false;
  } else if (state == "longreply") {
    // 長い返事と頼み（上の欄が op の一覧を押しつぶさないことを確かめる）
    st.review = 0;
    st.proposals[0].state = AI_PROP_REVIEW;
    st.proposals[0].reply = "3 か所を詰め、BGM のサビを合わせます。言いよどみは「えーと」「あの」「まあ」の 3 つで、どれも話の区切りではないところにあります。字幕「この町が好きだから」は文の途中で切れるので、3 は外しておくことをすすめます。BGM はマーカー「サビ」に合わせて素材の 00:00:12:12 から始めると、エンディングの店先にサビの頭が重なります。音量はいまの 45% のままです。";
    st.proposals[0].request = "インタビューの言いよどみを詰めて。BGM のサビを最後の店先に合わせたい。字幕が途中で切れるところは避けて。全体は 1 分 30 秒を超えないようにして。音量は変えないで。";
  } else if (state == "manyshare") {
    st.share = [aiChip(AI_CHIP_MONO, "int_b2"), aiChip(AI_CHIP_MONO, "00:00:31:14"), aiChip(AI_CHIP_PLAIN, "イン〜アウト"),
      aiChip(AI_CHIP_PLAIN, "マーカー 3 個"), aiChip(AI_CHIP_PLAIN, "問題の一覧"), aiChip(AI_CHIP_MONO, "sub_04"), aiChip(AI_CHIP_MONO, "bgm")];
  } else if (state == "undoneall") {
    tab = 1;
    st.histPos = 0;
  } else if (state == "rejected") {
    st.review = 0;
    st.proposals[0].state = AI_PROP_REVIEW;
  }
  const opened = windowOpen("AI の提案と履歴（見本）", W, H);
  if (opened == null) {
    eprint("error: could not open a window");
    return 1;
  }
  const win = opened;
  let px = new Buffer<u32>((W * H) as u32);
  let frames: i64 = 0;
  let running = true;
  while (running) {
    let res = ukWinResNew();
    while (true) {
      const e = pollWindowEvent(maxFrames >= 0 ? 0 : 16);
      if (e == null) {
        break;
      }
      ukFeedWindowEvent(mut ui, e, mut res);
    }
    for (const ev of evs) {
      if (ev.frame == frames) {
        if (ev.kind == 1) {
          ukEventMouseMove(mut ui, ev.x, ev.y);
        } else if (ev.kind == 2) {
          ukEventMouseMove(mut ui, ev.x, ev.y);
          ukEventMouseButton(mut ui, ev.x, ev.y, 1, true);
          ukEventMouseButton(mut ui, ev.x, ev.y, 1, false);
        } else if (ev.kind == 4) {
          ukEventKey(mut ui, ev.key, ev.mods);
        } else if (ev.kind == 5) {
          for (let k: usize = 0; k < ev.text.length; k++) {
            ukEventText(mut ui, ev.text[k] as u32);
          }
        }
      }
    }
    if (res.quit) {
      running = false;
    }
    let now = clock();
    if (maxFrames >= 0) {
      now = (frames as f64) / 60.0;
    }
    ukBegin(mut ui, W, H, now);
    let out: AiEvent[] = [];
    aidChrome(mut ui, th, st, W, H);
    // 左の欄: 問題（素材の欄の場所に出す）
    aiProblems(mut ui, th, mut st, ukRect(56, 40, 260, 592), mut out);
    // 右の列: タブと中身（作業中のパネルなら上の辺に accent の 2px の帯）
    const col = ukRect(W - 440, 40, 440, 592);
    ukDrawRect(mut ui, ukRect(col.x - 1, col.y, 1, col.h), th.line);
    tab = aiTabBar(mut ui, th, ukRect(col.x, col.y, col.w, th.tabBar), ["インスペクタ", "履歴", "AI"], tab, 2, st.connected ? aiPendingCount(st) : 0);
    if (activePanel == "ai") {
      ukDrawRect(mut ui, ukRect(col.x, col.y, col.w, 2), th.accent);
    }
    const body = ukRect(col.x, col.y + th.tabBar, col.w, col.h - th.tabBar);
    if (tab == 2) {
      aiTabAi(mut ui, th, mut st, body, mut out);
      aiPanelKeys(mut ui, mut st, mut out, activePanel == "ai");
    } else if (tab == 1) {
      aiTabHistory(mut ui, th, mut st, body, mut out);
    } else {
      ukDrawRect(mut ui, body, th.bg1);
      ukDrawTextIn(mut ui, ukRect(body.x, body.y + 24, body.w, 18), "クリップを選ぶと、ここに設定が出ます", th.fsMd, th.text2, 1);
    }
    // タイムライン（作業中なら Space を再生に使う。AI のパネルが奪っていないことを確かめる）
    aidTimeline(mut ui, th, tk, st, ukRect(0, 633, W, H - 24 - 633), activePanel == "timeline");
    if (activePanel == "timeline") {
      if (ukKeyTakeMods(mut ui, UK_KEY_SPACE) >= 0) {
        eprint("timeline: space（再生）");
      }
      if (ukKeyTakeMods(mut ui, UK_KEY_DOWN) >= 0) {
        eprint("timeline: down（次の編集点）");
      }
    }
    if (state == "rejected" && frames == 1) {
      out.push({ kind: AI_EV_REJECT, prop: 0, index: -1, text: "" });
    }
    aiDrawToast(mut ui, th, mut st, ukRect(0, 40, W, H - 64), mut out);
    for (const e of out) {
      aidHandle(mut ui, mut st, e);
      if (e.kind == AI_EV_FOCUS_ASK) {
        tab = 2;
      }
    }
    // 選び直した提案は dry-run し直す（見本では ops.um を通さず、その場で作り直した数をそのまま使う）
    const rp = aiRecheckWanted(st);
    if (rp >= 0) {
      eprint(`recheck: 提案 ${rp} を選んだ op だけで dry-run し直す（動くクリップ ${st.proposals[rp as usize].moved}）`);
      st.proposals[rp as usize].dirty = false;
    }
    ukEnd(mut ui, mut px);
    windowPresent(win, px, W, H);
    frames++;
    if (maxFrames >= 0 && frames >= maxFrames) {
      running = false;
    }
  }
  if (shot.length > 0) {
    if (!ukWriteBmp(shot, px, W, H)) {
      eprint(`error: cannot write '${shot}'`);
    }
  }
  windowClose(win);
  return 0;
}
