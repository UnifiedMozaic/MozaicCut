// 編集画面の音の再生（SDL3 の音の出力）。再生のエンジン（playback.um）の時計を、音の出力が実際に鳴らした標本の数に
// 差し替える（映像を音に合わせる）。editor.um だけが使う（エンジンの main.um に SDL3 をリンクさせないため、
// playback.um とは別のファイルにする）。
//
// 方針
// - 音を鳴らすのは等速の順再生のときだけ（pbAudioWanted）。逆再生・2 倍・4 倍（J / L を重ねたとき）と、止めているあいだは
//   出力を止めて待ち行列を捨てる（映像だけで、時計は壁時計）。速さを変えた音（ピッチを保つ伸び縮み）はまだ作らない。
// - 鳴らし始め（再生を始めた・シークした・等速に戻した）は、出力を止めて待ち行列を捨て、その位置から混ぜた音を
//   AP_QUEUE_SEC 秒分ためてから鳴らす。時刻の基準は、そのときの audioPlayed（鳴らし終えたフレームの数）。
// - 毎フレーム、待ち行列が AP_QUEUE_SEC 秒を下回ったら AP_CHUNK フレームずつ混ぜて足す（audio.um の mixRange。
//   素材は media.um の読み手で、続きはシークせずに読む）。
// - 時計: 鳴らし始めの位置 + (audioPlayed − 基準 − audioLatency) / rate を pbAudioClock に渡す。音が途切れたり
//   出力が遅れたりしても、映像は音の位置に合う。
// - 音のデバイスがなければ（audioOpen が null）何もせず、時計は壁時計のまま。
import { Project } from "./project.um";
import { MediaSource, MEDIA_OPEN_FAST } from "./media.um";
import { openSounds, releaseSounds, mixRange } from "./audio.um";
import { Playback, PB_CLOCK_AUDIO, pbSetClockSource, pbAudioWanted, pbAudioClock } from "./playback.um";

// 待ち行列にためておく長さ（秒）と、1 回に混ぜるフレームの数
const AP_QUEUE_SEC: f64 = 0.1;
const AP_CHUNK: i64 = 1024;

export struct AudioPlay {
  // 出力の番号（音のデバイスがなければ ok = false）
  ok: bool;
  stream: i32;
  rate: i32;
  // クリップごとの音の読み手（音のないクリップは mediaNone）
  srcs: MediaSource[];
  // 鳴らしているか（等速の順再生）
  playing: bool;
  // 次に混ぜるタイムラインの標本の番号
  pos: i64;
  // 鳴らし始めの位置（秒）と、そのときの audioPlayed
  startT: f64;
  base: i64;
  // 作業用（出力に渡す f32）
  out: Buffer<f32>;
  // 統計: 鳴らし始めた回数、書いたフレームの数、最後に渡した時計（秒）
  starts: i64;
  written: i64;
  lastT: f64;
}

// 音の出力を開く（プロジェクトの rate のステレオ）。開けなくても AudioPlay を返す（ok = false）。
export function newAudioPlay(p: Project, cache: string, pb: mut Playback): AudioPlay {
  let ap: AudioPlay = {
    ok: false, stream: 0, rate: p.rate, srcs: [], playing: false, pos: 0, startT: 0, base: 0,
    out: new Buffer<f32>((AP_CHUNK * 2) as u32), starts: 0, written: 0, lastT: 0,
  };
  const s = audioOpen(p.rate, 2);
  if (s != null) {
    ap.stream = s;
    ap.ok = true;
    pbSetClockSource(mut pb, PB_CLOCK_AUDIO);
  }
  ap.srcs = openSounds(p, cache, MEDIA_OPEN_FAST);
  return ap;
}

// プロジェクトを書き換えた・素材が変わったときに呼ぶ（pbReload と一緒に）。音の読み手を開き直し、鳴らしていれば
// 次のフレームでいまの位置から鳴らし直す。標本化周波数が変わったら出力も開き直す。
export function apReload(ap: mut AudioPlay, p: Project, cache: string): void {
  releaseSounds(mut ap.srcs);
  ap.srcs = openSounds(p, cache, MEDIA_OPEN_FAST);
  if (ap.ok && p.rate != ap.rate) {
    audioClose(ap.stream);
    ap.ok = false;
    const s = audioOpen(p.rate, 2);
    if (s != null) {
      ap.stream = s;
      ap.ok = true;
    }
  }
  ap.rate = p.rate;
  apStop(mut ap);
}

function apStop(ap: mut AudioPlay): void {
  if (ap.ok && ap.playing) {
    audioPause(ap.stream);
    audioClear(ap.stream);
  }
  ap.playing = false;
}

// 位置 t（秒）から鳴らし始める。
function apStart(ap: mut AudioPlay, p: Project, t: f64): void {
  audioPause(ap.stream);
  audioClear(ap.stream);
  ap.pos = Math.floor(t * (ap.rate as f64) + 0.5) as i64;
  ap.startT = (ap.pos as f64) / (ap.rate as f64);
  ap.base = audioPlayed(ap.stream);
  ap.playing = true;
  ap.starts++;
  apFill(mut ap, p);
  audioResume(ap.stream);
}

// 待ち行列が AP_QUEUE_SEC 秒を下回っていたら、混ぜて足す。
function apFill(ap: mut AudioPlay, p: Project): void {
  const want = Math.floor(AP_QUEUE_SEC * (ap.rate as f64)) as i64;
  // 同じ呼び出しに ap を mut と別の引数で渡せないので、作業用の配列と位置は手元の変数にする
  let mix: f32[] = [];
  for (let i: i64 = 0; i < AP_CHUNK * 2; i++) {
    mix.push(0);
  }
  let buf: f32[] = [];
  let guard = 0;
  while (audioQueued(ap.stream) < want && guard < 16) {
    guard++;
    // 終わりより後ろは無音（mixRange が 0 を書く）。止めるのは pb が終わりで止まったとき
    const pos = ap.pos;
    mixRange(p, mut ap.srcs, pos, AP_CHUNK, mut mix, mut buf);
    for (let j: u32 = 0; j < (AP_CHUNK * 2) as u32; j++) {
      ap.out[j] = Math.min(Math.max(mix[j as usize] / 32768.0, -1.0), 1.0);
    }
    if (!audioWrite(ap.stream, ap.out, 0, AP_CHUNK * 2)) {
      break;
    }
    ap.pos += AP_CHUNK;
    ap.written += AP_CHUNK;
  }
}

// 毎フレーム、入力の処理（シーク・再生の頼み）の後、pbTick の前に呼ぶ。鳴らし始め・止め・足しと、時計の受け渡し。
export function apUpdate(ap: mut AudioPlay, pb: mut Playback, p: Project, now: f64): void {
  if (!ap.ok) {
    return;
  }
  if (!pbAudioWanted(pb)) {
    apStop(mut ap);
    return;
  }
  // 再生を始めた・シークした・等速に戻したとき、pb は音の時計を捨てている（audioOk = false）
  if (!ap.playing || !pb.audioOk) {
    apStart(mut ap, p, pb.t);
  } else {
    apFill(mut ap, p);
  }
  const played = Math.max(audioPlayed(ap.stream) - ap.base - audioLatency(ap.stream), 0 as i64);
  ap.lastT = ap.startT + (played as f64) / (ap.rate as f64);
  pbAudioClock(mut pb, ap.lastT, now);
}

// 閉じる。
export function apClose(ap: mut AudioPlay): void {
  releaseSounds(mut ap.srcs);
  if (ap.ok) {
    audioClose(ap.stream);
  }
  ap.ok = false;
  ap.playing = false;
}

// 統計（機械向け）。{"ok":..,"rate":..,"playing":..,"starts":..,"written":..,"played":..,"t":..}
// played は出力を開いてから鳴らし終えたフレームの数（audioPlayed）。
export function apStatsJson(ap: AudioPlay): string {
  let played: i64 = 0;
  if (ap.ok) {
    played = audioPlayed(ap.stream);
  }
  let okText = "false";
  if (ap.ok) {
    okText = "true";
  }
  let playText = "false";
  if (ap.playing) {
    playText = "true";
  }
  return `{"ok":${okText},"rate":${ap.rate},"playing":${playText},"starts":${ap.starts},"written":${ap.written},"played":${played},"t":${Math.floor(ap.lastT * 1000) / 1000}}`;
}
