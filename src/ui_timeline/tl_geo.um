// タイムラインの配置: 帯（36）・ルーラー（26）・見出し（176）・映像と音の領域（溝 4 で分け、別々にスクロール）・横のスクロール（12）。
// 寸法は tokens の size.*（倍率 1.0 の論理 px）に UI の倍率を掛けたもの。
import { UkRect, ukRect } from "../uikit/base.um";
import { TlState } from "./tl_model.um";
import { tlPx } from "./tl_theme.um";

export struct TlGeo {
  sc: f32;
  r: UkRect;
  bar: UkRect;
  ruler: UkRect;      // 隅（見出しの幅）を含む
  hdrW: i32;
  lanes: UkRect;      // クリップを描く所（見出しの右、ルーラーの下、横のスクロールの上）
  vArea: UkRect;      // 映像の領域（見出しを含む幅）
  aArea: UkRect;
  gutterY: i32;       // 溝の上の y（-1 ならない）
  gutterH: i32;
  rowY: i32[];
  rowH: i32[];
  hs: UkRect;
  vContent: i32;
  aContent: i32;
}

export function tlGeo(st: mut TlState, r: UkRect, sc: f32): TlGeo {
  const t = st.tok;
  const barH = tlPx(sc, t.sizeTimelineToolbar);
  const rulerH = tlPx(sc, t.sizeRuler);
  const hdrW = tlPx(sc, t.sizeTrackHeader);
  const hsH = tlPx(sc, t.sizeScrollbar);
  const gutH = tlPx(sc, t.space1);
  const bar = ukRect(r.x, r.y, r.w, barH);
  const rp = tlPx(sc, st.rightPad);
  const ruler = ukRect(r.x, r.y + barH, r.w - rp, rulerH);
  const top = r.y + barH + rulerH;
  const bot = r.y + r.h - hsH;
  const hs = ukRect(r.x, bot, r.w, hsH);
  let vC = 0;
  let aC = 0;
  let nA = 0;
  for (const tr of st.tracks) {
    if (tr.audio) {
      aC = aC + tlPx(sc, tr.h);
      nA++;
    } else {
      vC = vC + tlPx(sc, tr.h);
    }
  }
  const g = nA > 0 && aC > 0 && vC > 0 ? gutH : 0;
  const avail = Math.max(bot - top - g, 0);
  let vH = vC;
  let aH = avail - vC;
  if (vC + aC > avail) {
    vH = Math.min(vC, Math.max(avail / 2, avail - aC));
    aH = avail - vH;
  }
  const vArea = ukRect(r.x, top, r.w - rp, vH);
  const aArea = ukRect(r.x, top + vH + g, r.w - rp, Math.max(bot - (top + vH + g), 0));
  // スクロールの範囲に収める
  st.scrollV = Math.min(Math.max(st.scrollV, 0), Math.max(vC - vH, 0));
  st.scrollA = Math.min(Math.max(st.scrollA, 0), Math.max(aC - aArea.h, 0));
  let rowY: i32[] = [];
  let rowH: i32[] = [];
  // 映像: 収まらないときは V1 を溝に付けて下からそろえる（scrollV で上を見る）
  let vy = vArea.y;
  if (vC > vH) {
    vy = vArea.y + vH - vC + st.scrollV;
  }
  let ay = aArea.y - st.scrollA;
  for (const tr of st.tracks) {
    const h = tlPx(sc, tr.h);
    if (tr.audio) {
      rowY.push(ay);
      ay = ay + h;
    } else {
      rowY.push(vy);
      vy = vy + h;
    }
    rowH.push(h);
  }
  return {
    sc, r, bar, ruler, hdrW, lanes: ukRect(r.x + hdrW, top, Math.max(r.w - hdrW - rp, 0), Math.max(bot - top, 0)), vArea, aArea,
    gutterY: g > 0 ? top + vH : -1, gutterH: g, rowY, rowH, hs, vContent: vC, aContent: aC,
  };
}

// 行 row の領域（映像か音。切り取りに使う）。
export function tlRowArea(st: TlState, g: TlGeo, row: usize): UkRect {
  if (st.tracks[row].audio) {
    return g.aArea;
  }
  return g.vArea;
}

// 時刻 → 画面の x。
export function tlX(st: TlState, g: TlGeo, t: f64): i32 {
  return g.lanes.x + (Math.floor((t - st.t0) * st.pps + 0.5) as i32);
}

export function tlXf(st: TlState, g: TlGeo, t: f64): f32 {
  return (g.lanes.x as f32) + ((t - st.t0) * st.pps) as f32;
}

// 画面の x → 時刻。
export function tlT(st: TlState, g: TlGeo, x: i32): f64 {
  return st.t0 + ((x - g.lanes.x) as f64) / st.pps;
}

// y にある行（なければ -1）。溝・領域の外は -1。
export function tlRowAt(st: TlState, g: TlGeo, y: i32): i32 {
  for (let i: usize = 0; i < st.tracks.length; i++) {
    const a = tlRowArea(st, g, i);
    if (y < a.y || y >= a.y + a.h) {
      continue;
    }
    if (y >= g.rowY[i] && y < g.rowY[i] + g.rowH[i]) {
      return i as i32;
    }
  }
  return -1;
}

// 全体に合わせる（人が拡大縮小するまで。ui.md 4.6）。
export function tlFitView(st: mut TlState, g: TlGeo): void {
  const d = Math.max(st.duration, 1.0);
  const w = Math.max((g.lanes.w as f64) - 16.0 * (g.sc as f64), 50.0);
  st.pps = w / d;
  st.t0 = 0.0;
}
