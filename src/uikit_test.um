// uikit の試し（ウィンドウなし）。入力を作って部品を動かし、結果を確かめる。
// 1 行に 1 つ "ok <名前>" か "NG <名前>: <中身>" を書き、最後に {"ok":数,"ng":数} を書く。tests/uikit/run.mjs が実行する。
import {
  UkCtx, ukNew, ukBegin, ukEnd, ukEndImage, ukInvalidate, ukEventMouseMove, ukEventMouseButtonAt, ukEventKey, ukEventText,
  ukEventWheel, ukEventMods, ukToast, ukTooltip, ukPushIdInt, ukPopId, ukTextW, ukFitText, ukNextFrameMs, ukDrawImage,
  ukDrawRect, ukPushLayer, ukPopLayer, ukSetFallbackFont, ukSetFont, ukTextWS, ukDrawTextS, UK_TEXT_TABULAR,
  UK_FONT_SANS, UK_FONT_SEMIBOLD, UK_FONT_MONO, UK_FONT_MONO_MEDIUM, UK_KEY_TAB, UK_KEY_ENTER, UK_KEY_ESC,
  UK_KEY_BACKSPACE, UK_KEY_LEFT, ukFitTextMid, ukAlphaSet, ukAlphaHas, ukDrawAlpha, ukEventDropBegin, ukEventDropMove,
  ukEventDropFile, ukEventDropComplete, ukDropOver, ukDropTake, UK_CURSOR_TEXT, UK_CURSOR_DEFAULT, ukEventImeComposition,
  UK_KEY_RIGHT, UK_KEY_HOME, UK_KEY_END, UK_KEY_DOWN, UK_KEY_CHAR, UK_MOD_SHIFT, UK_MOD_CTRL, UK_L_POPUP, UK_L_TOAST,
  UK_L_MODAL,
} from "./uikit/core.um";
import {
  UkRect, ukRect, ukIntersect, ukMix, ukInsert, ukErase, ukFixed, ukLabel, ukPrevChar, ukNextChar, ukFinite,
} from "./uikit/base.um";
import {
  UkTheme, ukThemeDefault, ukThemeFromTokens, ukThemeFromTokensEx, ukTokPaths, ukParseHex, ukParseShadow,
} from "./uikit/theme.um";
import {
  ukBeginColAt, ukBeginRowAt, ukEndBox, ukNext, ukSplit, ukBeginScroll, ukEndScroll, ukScrollY, UkDock, ukDockNew,
  ukDockAddArea, ukDockMove, ukTabsAt,
} from "./uikit/layout.um";
import {
  ukButton, ukButtonDanger, ukIconButton, ukToggle, ukCheck, ukRadio, ukSlider, ukNumber, ukTextField, ukDropdown,
  ukParseTimecode, ukFormatTimecode, ukFormatTimecodeDf, ukParseTimecodeDf, ukIsDropFrame, ukFpsInt, ukParseF64, ukSnap,
  ukDragStep, ukBeginList, ukListRow, ukEndList, ukOpenDialog, ukCloseDialog, ukDialogIsOpen, ukBeginDialog,
  ukEndDialog, ukContextMenu, ukMenuItem, ukEndMenu, ukBeginMenuBar, ukEndMenuBar, ukMenu, ukTextLine,
} from "./uikit/widgets.um";
import { UK_I_LOCK } from "./uikit/icons.um";
import { ukPixelHash } from "./uikit/bmp.um";
import { uiFont, loadFont, glyphIndex, renderTextImageEx, textWidthPxEx, emptyFont } from "./ttf.um";

struct TState {
  ok: i32;
  ng: i32;
}

function check(t: mut TState, cond: bool, name: string, detail: string): void {
  if (cond) {
    t.ok += 1;
    print(`ok ${name}`);
  } else {
    t.ng += 1;
    print(`NG ${name}: ${detail}`);
  }
}

const TW: i32 = 640;
const TH: i32 = 480;

// ボタンの入力（時刻は前のフレームの少し後。試しの時計は ukBegin に渡す now）。
function btn(ui: mut UkCtx, x: i32, y: i32, b: i32, down: bool): void {
  ukEventMouseButtonAt(mut ui, x, y, b, down, ui.now + 0.05);
}

function click(ui: mut UkCtx, x: i32, y: i32): void {
  btn(mut ui, x, y, 1, true);
  btn(mut ui, x, y, 1, false);
}

function rectText(r: UkRect): string {
  return `${r.x},${r.y},${r.w},${r.h}`;
}

function testBase(t: mut TState): void {
  const r = ukIntersect(ukRect(0, 0, 10, 10), ukRect(5, 5, 10, 10));
  check(mut t, r.x == 5 && r.y == 5 && r.w == 5 && r.h == 5, "base.intersect", rectText(r));
  check(mut t, ukMix(0xff000000, 0xffffffff, 128) == 0xff7f7f7f, "base.mix", `${ukMix(0xff000000, 0xffffffff, 128)}`);
  check(mut t, ukInsert("あいう", 3, "x") == "あxいう", "base.insert", ukInsert("あいう", 3, "x"));
  check(mut t, ukErase("あいう", 3, 6) == "あう", "base.erase", ukErase("あいう", 3, 6));
  check(mut t, ukPrevChar("あい", 6) == 3 && ukNextChar("あい", 0) == 3, "base.utf8-step", "");
  check(mut t, ukFixed(2.5, 0) == "3" && ukFixed(1.25, 1) == "1.3", "base.fixed", ukFixed(1.25, 1));
  check(mut t, ukFixed(-0.75, 1) == "-0.8", "base.fixed-neg", ukFixed(-0.75, 1));
  check(mut t, ukLabel("削除##clip3") == "削除", "base.label", ukLabel("削除##clip3"));
}

function testTheme(t: mut TState): void {
  let th = ukThemeDefault(1.0);
  check(mut t, ukParseHex("#3d7eff") == 0xff3d7eff, "theme.hex6", "");
  check(mut t, ukParseHex("#11223380") == 0x80112233, "theme.hex8", "");
  const json = "{\"color\": {\"bg\": {\"$value\": \"#101010\"}, \"accent\": \"#ff8800\"}, \"size\": {\"ctrlH\": 30, \"radius\": \"4px\", \"pad\": {\"$value\": \"10px\"}, \"gap\": -5}, \"other\": 1, \"x\": {\"color\": {\"text\": \"#ffffff\"}}}";
  const n = ukThemeFromTokens(mut th, json);
  check(mut t, n == 6, "theme.tokens-count", `${n}`);
  check(mut t, th.bg == 0xff101010 && th.accent == 0xffff8800, "theme.tokens-color", "");
  check(mut t, th.ctrlH == 30 && th.pad == 10 && th.radius == 4, "theme.tokens-size", `${th.ctrlH} ${th.pad} ${th.radius}`);
  // 負の寸法は下限に収める。最後の 2 つのキーだけの偶然の一致（x.color.text）は当てない
  check(mut t, th.gap >= 1 && th.text == 0xffe6e6ea, "theme.tokens-clamp-and-path", `${th.gap} ${th.text}`);
  let t2 = ukThemeDefault(2.0);
  check(mut t, t2.ctrlH == 52 && t2.fontSize == 26.0, "theme.scale2", `${t2.ctrlH}`);
  let t3 = ukThemeDefault(5.0);
  check(mut t, t3.scale == 2.0, "theme.scale-clamp", "");
}

function testNumbers(t: mut TState): void {
  const fps = ukFpsInt(30000, 1001);
  check(mut t, fps == 30, "tc.fps", `${fps}`);
  check(mut t, ukFormatTimecode(1234, 30) == "00:00:41:04", "tc.format", ukFormatTimecode(1234, 30));
  check(mut t, ukFormatTimecode(30 * 3600 + 1, 30) == "01:00:00:01", "tc.format-hour", "");
  check(mut t, ukParseTimecode("00:00:41:04", 30, 0) == 1234, "tc.parse", "");
  check(mut t, ukParseTimecode("1:00", 30, 0) == 30, "tc.parse-short", `${ukParseTimecode("1:00", 30, 0)}`);
  check(mut t, ukParseTimecode("1000", 30, 0) == 300, "tc.parse-packed", `${ukParseTimecode("1000", 30, 0)}`);
  check(mut t, ukParseTimecode("+15", 30, 100) == 115, "tc.parse-rel", "");
  check(mut t, ukParseTimecode("-1.00", 30, 100) == 70, "tc.parse-rel-neg", `${ukParseTimecode("-1.00", 30, 100)}`);
  check(mut t, ukParseTimecode("ab", 30, 0) == -1, "tc.parse-bad", "");
  let out: f64[] = [0.0];
  check(mut t, ukParseF64(" -12.5 ", mut out) && out[0] == -12.5, "num.parse", "");
  check(mut t, !ukParseF64("1x", mut out), "num.parse-bad", "");
}

function testLayout(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukBegin(mut ui, TW, TH, 0.0);
  ukBeginRowAt(mut ui, ukRect(0, 0, 640, 30), [100, -1, -1]);
  const a = ukNext(mut ui, 10, 10);
  const b = ukNext(mut ui, 10, 10);
  const c = ukNext(mut ui, 10, 10);
  ukEndBox(mut ui);
  ukBeginColAt(mut ui, ukRect(10, 40, 200, 400));
  const d = ukNext(mut ui, 50, 20);
  const e = ukNext(mut ui, 50, 20);
  ukEndBox(mut ui);
  ukEnd(mut ui, mut px);
  const g = ui.theme.gap;
  check(mut t, a.w == 100 && b.x == 100 + g && b.w + c.w == 640 - 100 - 2 * g && c.x + c.w == 640, "layout.row-flex",
    `${rectText(a)} ${rectText(b)} ${rectText(c)}`);
  check(mut t, d.w == 200 && e.y == d.y + 20 + g, "layout.col", `${rectText(d)} ${rectText(e)}`);
}

function twoButtons(ui: mut UkCtx, px: mut Buffer<u32>, now: f64, res: mut bool[]): i32 {
  ukBegin(mut ui, TW, TH, now);
  ukBeginColAt(mut ui, ukRect(10, 10, 120, 400));
  res[0] = ukButton(mut ui, "保存");
  res[1] = ukButton(mut ui, "開く");
  ukEndBox(mut ui);
  return ukEnd(mut ui, mut px);
}

function testButtonsAndDirty(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let res: bool[] = [false, false];
  // 1 回目は全体を描く
  ukInvalidate(mut ui);
  ukEventMouseMove(mut ui, 600, 470);
  const d0 = twoButtons(mut ui, mut px, 1.0, mut res);
  check(mut t, d0 == TW * TH, "dirty.full", `${d0}`);
  // 同じ画面: 描き直しなし
  const d1 = twoButtons(mut ui, mut px, 1.1, mut res);
  check(mut t, d1 == 0, "dirty.none", `${d1}`);
  // ボタンに乗る: その所だけ
  ukEventMouseMove(mut ui, 50, 20);
  const d2 = twoButtons(mut ui, mut px, 1.2, mut res);
  check(mut t, d2 > 0 && d2 <= 64 * 64 * 4, "dirty.hover", `${d2}`);
  // 部分の描き直しと、全体の描き直しが同じ画素になる
  const hPart = ukPixelHash(px, (TW * TH) as u32);
  ukInvalidate(mut ui);
  twoButtons(mut ui, mut px, 1.3, mut res);
  const hFull = ukPixelHash(px, (TW * TH) as u32);
  check(mut t, hPart == hFull, "dirty.same-pixels", `${hPart} ${hFull}`);
  // クリック
  click(mut ui, 50, 20);
  twoButtons(mut ui, mut px, 1.4, mut res);
  check(mut t, res[0] && !res[1], "button.click", "");
}

function testFocus(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let got: i32[] = [];
  click(mut ui, 600, 400);
  for (let step = 0; step < 4; step++) {
    if (step == 1 || step == 2) {
      ukEventKey(mut ui, UK_KEY_TAB, 0);
    }
    if (step == 3) {
      ukEventKey(mut ui, UK_KEY_TAB, UK_MOD_SHIFT);
    }
    ukBegin(mut ui, TW, TH, 2.0 + (step as f64) * 0.1);
    ukBeginColAt(mut ui, ukRect(10, 10, 120, 400));
    ukButton(mut ui, "A");
    const ida = ui.lastId;
    ukButton(mut ui, "B");
    const idb = ui.lastId;
    ukButton(mut ui, "C");
    ukEndBox(mut ui);
    ukEnd(mut ui, mut px);
    let f = -1;
    if (ui.focus == ida) {
      f = 0;
    } else if (ui.focus == idb) {
      f = 1;
    } else if (ui.focus != 0) {
      f = 2;
    }
    got.push(f);
  }
  // 何もない所を押してフォーカスを外した後: Tab で A、もう一度で B、Shift+Tab で A
  check(mut t, got[0] == -1 && got[1] == 0 && got[2] == 1 && got[3] == 0 && ui.focusVisible, "focus.tab",
    `${got[0]} ${got[1]} ${got[2]} ${got[3]}`);
}

function textFrame(ui: mut UkCtx, px: mut Buffer<u32>, s: string, now: f64): string {
  ukBegin(mut ui, TW, TH, now);
  ukBeginColAt(mut ui, ukRect(10, 10, 300, 400));
  const r = ukTextField(mut ui, "名前##t", s);
  ukEndBox(mut ui);
  ukEnd(mut ui, mut px);
  return r;
}

function testText(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let s = "夏";
  click(mut ui, 200, 20);
  s = textFrame(mut ui, mut px, s, 3.0);
  check(mut t, ui.focus != 0, "text.focus", "");
  ukEventKey(mut ui, UK_KEY_END, 0);
  ukEventText(mut ui, 0x306e);   // の
  ukEventText(mut ui, 0x65c5);   // 旅
  s = textFrame(mut ui, mut px, s, 3.1);
  check(mut t, s == "夏の旅", "text.ime-commit", s);
  ukEventKey(mut ui, UK_KEY_BACKSPACE, 0);
  s = textFrame(mut ui, mut px, s, 3.2);
  check(mut t, s == "夏の", "text.backspace", s);
  ukEventKey(mut ui, UK_KEY_LEFT, 0);
  ukEventText(mut ui, 120);      // x
  s = textFrame(mut ui, mut px, s, 3.3);
  check(mut t, s == "夏xの", "text.left-insert", s);
  ukEventKey(mut ui, UK_KEY_HOME, 0);
  s = textFrame(mut ui, mut px, s, 3.35);
  ukEventText(mut ui, 65);
  s = textFrame(mut ui, mut px, s, 3.36);
  ukEventKey(mut ui, UK_KEY_END, 0);
  ukEventText(mut ui, 66);
  s = textFrame(mut ui, mut px, s, 3.4);
  check(mut t, s == "A夏xのB", "text.home-end", s);
  ukEventKey(mut ui, UK_KEY_CHAR + 97, UK_MOD_CTRL);
  ukEventKey(mut ui, UK_KEY_CHAR + 99, UK_MOD_CTRL);
  s = textFrame(mut ui, mut px, s, 3.5);
  check(mut t, ui.clipboard == "A夏xのB", "text.copy", ui.clipboard);
  ukEventKey(mut ui, UK_KEY_CHAR + 97, UK_MOD_CTRL);
  ukEventText(mut ui, 0x6625);   // 春
  s = textFrame(mut ui, mut px, s, 3.6);
  check(mut t, s == "春", "text.replace-all", s);
  ukEventKey(mut ui, UK_KEY_CHAR + 118, UK_MOD_CTRL);
  s = textFrame(mut ui, mut px, s, 3.7);
  check(mut t, s == "春A夏xのB", "text.paste", s);
  ukEventKey(mut ui, UK_KEY_LEFT, UK_MOD_SHIFT);
  ukEventKey(mut ui, UK_KEY_LEFT, UK_MOD_SHIFT);
  ukEventKey(mut ui, UK_KEY_BACKSPACE, 0);
  s = textFrame(mut ui, mut px, s, 3.75);
  check(mut t, s == "春A夏x", "text.shift-select-delete", s);
  check(mut t, ui.wantText, "text.want-keyboard", "");
  ukEventKey(mut ui, UK_KEY_ESC, 0);
  s = textFrame(mut ui, mut px, s, 3.8);
  check(mut t, ui.focus == 0, "text.esc", "");
}

function valFrame(ui: mut UkCtx, px: mut Buffer<u32>, v: mut f64[], now: f64): void {
  ukBegin(mut ui, TW, TH, now);
  ukBeginColAt(mut ui, ukRect(10, 10, 300, 400));
  v[0] = ukSlider(mut ui, "音量", v[0], 0.0, 1.0, 0.1, 1);
  v[1] = ukNumber(mut ui, "数", v[1], 0.0, 100.0, 1.0, 0);
  ukEndBox(mut ui);
  ukEnd(mut ui, mut px);
}

function testValues(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let v: f64[] = [0.5, 10.0];
  ukEventMouseMove(mut ui, 620, 470);
  valFrame(mut ui, mut px, mut v, 4.0);
  // スライダーの左端を押す → 0
  const top = 10 + ui.theme.ctrlH / 2;
  click(mut ui, 12, top);
  valFrame(mut ui, mut px, mut v, 4.1);
  check(mut t, v[0] == 0.0, "slider.click-left", `${v[0]}`);
  ukEventKey(mut ui, UK_KEY_RIGHT, 0);
  ukEventKey(mut ui, UK_KEY_RIGHT, 0);
  valFrame(mut ui, mut px, mut v, 4.2);
  check(mut t, Math.abs(v[0] - 0.2) < 1e-9, "slider.keys", `${v[0]}`);
  ukEventKey(mut ui, UK_KEY_END, 0);
  valFrame(mut ui, mut px, mut v, 4.3);
  check(mut t, v[0] == 1.0, "slider.end", `${v[0]}`);
  // 数値: ドラッグで 1 画素 1 ずつ
  const ny = 10 + ui.theme.ctrlH + ui.theme.gap + ui.theme.ctrlH / 2;
  btn(mut ui, 100, ny, 1, true);
  valFrame(mut ui, mut px, mut v, 4.4);
  ukEventMouseMove(mut ui, 125, ny);
  valFrame(mut ui, mut px, mut v, 4.5);
  btn(mut ui, 125, ny, 1, false);
  valFrame(mut ui, mut px, mut v, 4.6);
  check(mut t, v[1] == 35.0, "number.drag", `${v[1]}`);
  // クリックで打ち込み、Enter で確定
  click(mut ui, 100, ny);
  valFrame(mut ui, mut px, mut v, 5.6);
  ukEventKey(mut ui, UK_KEY_CHAR + 97, UK_MOD_CTRL);
  valFrame(mut ui, mut px, mut v, 5.65);
  ukEventText(mut ui, 52);
  ukEventText(mut ui, 50);
  valFrame(mut ui, mut px, mut v, 5.66);
  ukEventKey(mut ui, UK_KEY_ENTER, 0);
  valFrame(mut ui, mut px, mut v, 5.7);
  check(mut t, v[1] == 42.0, "number.type", `${v[1]}`);
  // 範囲の外は収める
  click(mut ui, 100, ny);
  valFrame(mut ui, mut px, mut v, 6.7);
  ukEventKey(mut ui, UK_KEY_CHAR + 97, UK_MOD_CTRL);
  valFrame(mut ui, mut px, mut v, 6.75);
  ukEventText(mut ui, 57);
  ukEventText(mut ui, 57);
  ukEventText(mut ui, 57);
  valFrame(mut ui, mut px, mut v, 6.76);
  ukEventKey(mut ui, UK_KEY_ENTER, 0);
  valFrame(mut ui, mut px, mut v, 6.8);
  check(mut t, v[1] == 100.0, "number.clamp", `${v[1]}`);
}

function choiceFrame(ui: mut UkCtx, px: mut Buffer<u32>, b: mut bool[], sel: mut i32[], now: f64): bool {
  ukBegin(mut ui, TW, TH, now);
  ukBeginColAt(mut ui, ukRect(10, 10, 300, 400));
  sel[1] = ukDropdown(mut ui, "画質", ["低い", "ふつう", "高い"], sel[1]);
  const under = ukButton(mut ui, "下のボタン");
  b[0] = ukToggle(mut ui, "トグル", b[0]);
  b[1] = ukCheck(mut ui, "チェック", b[1]);
  sel[0] = ukRadio(mut ui, "ラジオ0", sel[0], 0);
  sel[0] = ukRadio(mut ui, "ラジオ1", sel[0], 1);
  ukEndBox(mut ui);
  ukEnd(mut ui, mut px);
  return under;
}

function testChoices(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let b: bool[] = [false, false];
  let sel: i32[] = [0, 0];
  const ch = ui.theme.ctrlH;
  const g = ui.theme.gap;
  const rowY = 10 + (ch + g) * 2 + ch / 2;
  choiceFrame(mut ui, mut px, mut b, mut sel, 7.0);
  click(mut ui, 20, rowY);
  choiceFrame(mut ui, mut px, mut b, mut sel, 7.1);
  check(mut t, b[0], "toggle.click", "");
  click(mut ui, 20, rowY + ch + g);
  choiceFrame(mut ui, mut px, mut b, mut sel, 7.2);
  check(mut t, b[1], "check.click", "");
  click(mut ui, 20, rowY + (ch + g) * 3);
  choiceFrame(mut ui, mut px, mut b, mut sel, 7.3);
  check(mut t, sel[0] == 1, "radio.click", `${sel[0]}`);
  // ドロップダウンを開く → 下のボタンはポップアップに覆われ、押せない
  click(mut ui, 50, 10 + ch / 2);
  choiceFrame(mut ui, mut px, mut b, mut sel, 7.4);
  check(mut t, ui.popups.length == 1, "dropdown.open", `${ui.popups.length}`);
  choiceFrame(mut ui, mut px, mut b, mut sel, 7.5);
  // 2 つ目の項目（ふつう）は、下のボタンと同じ高さにある
  const itemY = 10 + ch + 2 + Math.max(ui.theme.pad / 2, 2) + ui.theme.menuH + ui.theme.menuH / 2;
  click(mut ui, 50, itemY);
  const under = choiceFrame(mut ui, mut px, mut b, mut sel, 7.6);
  check(mut t, !under, "popup.blocks-below", "");
  check(mut t, sel[1] == 1 && ui.popups.length == 0, "dropdown.select", `${sel[1]} ${ui.popups.length}`);
  // 外を押すと閉じる
  click(mut ui, 50, 10 + ch / 2);
  choiceFrame(mut ui, mut px, mut b, mut sel, 7.7);
  click(mut ui, 600, 400);
  choiceFrame(mut ui, mut px, mut b, mut sel, 7.8);
  check(mut t, ui.popups.length == 0, "popup.outside-closes", `${ui.popups.length}`);
}

function listFrame(ui: mut UkCtx, px: mut Buffer<u32>, sel: mut i32[], now: f64): i32 {
  ukBegin(mut ui, TW, TH, now);
  const lr = ukBeginList(mut ui, "一覧", ukRect(10, 10, 300, 200), 100000, sel[0]);
  sel[0] = lr.sel;
  let drawn = 0;
  for (let i = lr.first; i < lr.last; i++) {
    const h = ukListRow(mut ui, i, `行 ${i}`, i == sel[0]);
    if (h.pressed) {
      sel[0] = i;
    }
    drawn++;
  }
  ukEndList(mut ui);
  ukEnd(mut ui, mut px);
  return drawn;
}

function testList(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let sel: i32[] = [0];
  const n = listFrame(mut ui, mut px, mut sel, 8.0);
  check(mut t, n > 0 && n <= 200 / ui.theme.rowH + 2, "list.virtual", `${n}`);
  click(mut ui, 50, 10 + ui.theme.rowH * 2 + 3);
  listFrame(mut ui, mut px, mut sel, 8.1);
  check(mut t, sel[0] == 2, "list.click", `${sel[0]}`);
  ukEventKey(mut ui, UK_KEY_DOWN, 0);
  listFrame(mut ui, mut px, mut sel, 8.2);
  check(mut t, sel[0] == 3, "list.key-down", `${sel[0]}`);
  ukEventKey(mut ui, UK_KEY_END, 0);
  listFrame(mut ui, mut px, mut sel, 8.3);
  listFrame(mut ui, mut px, mut sel, 8.4);
  const sy = ukScrollY(mut ui, "一覧");
  check(mut t, sel[0] == 99999 && sy == 100000 * ui.theme.rowH - 200, "list.key-end-scroll", `${sel[0]} ${sy}`);
  ukEventMouseMove(mut ui, 50, 50);
  ukEventWheel(mut ui, 0, 1);
  listFrame(mut ui, mut px, mut sel, 8.5);
  const sy2 = ukScrollY(mut ui, "一覧");
  check(mut t, sy2 == sy - ui.theme.rowH * 3, "list.wheel", `${sy2}`);
}

function dlgFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64): bool {
  ukBegin(mut ui, TW, TH, now);
  ukBeginColAt(mut ui, ukRect(10, 10, 300, 400));
  const under = ukButton(mut ui, "下");
  ukEndBox(mut ui);
  if (ukBeginDialog(mut ui, "確認", 300, 200)) {
    ukButton(mut ui, "はい");
    ukEndDialog(mut ui);
  }
  ukEnd(mut ui, mut px);
  return under;
}

function testDialog(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukOpenDialog(mut ui, "確認");
  dlgFrame(mut ui, mut px, 9.0);
  click(mut ui, 20, 10 + ui.theme.ctrlH / 2);
  const u = dlgFrame(mut ui, mut px, 9.1);
  check(mut t, !u, "dialog.modal-blocks", "");
  ukEventKey(mut ui, UK_KEY_ESC, 0);
  dlgFrame(mut ui, mut px, 9.2);
  dlgFrame(mut ui, mut px, 9.3);
  click(mut ui, 20, 10 + ui.theme.ctrlH / 2);
  const u2 = dlgFrame(mut ui, mut px, 9.4);
  check(mut t, u2, "dialog.esc-closes", "");
}

function testDockSplitScroll(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let d = ukDockNew(own ["a", "b", "c", "d"]);
  ukDockAddArea(mut d, own [0, 1]);
  ukDockAddArea(mut d, own [2, 3]);
  ukDockMove(mut d, 0, 1, 1);
  check(mut t, d.areas[0].panels.length == 1 && d.areas[1].panels[1] == 0 && d.areas[1].panels.length == 3,
    "dock.move", `${d.areas[1].panels.length}`);
  ukDockMove(mut d, 3, 1, 0);
  check(mut t, d.areas[1].panels[0] == 3 && d.areas[1].panels[1] == 2, "dock.reorder", "");
  // 分割の仕切りをドラッグ
  let a = 0;
  for (let k = 0; k < 4; k++) {
    if (k == 1) {
      btn(mut ui, 320, 100, 1, true);
    } else if (k == 2) {
      ukEventMouseMove(mut ui, 200, 100);
    } else if (k == 3) {
      btn(mut ui, 200, 100, 1, false);
    }
    ukBegin(mut ui, TW, TH, 10.0 + (k as f64) * 0.1);
    const sp = ukSplit(mut ui, "分割", ukRect(0, 0, 640, 480), true, 0.5, 50, 50);
    a = sp.a.w;
    ukEnd(mut ui, mut px);
  }
  check(mut t, a == 200 - ui.theme.splitW / 2, "split.drag", `${a}`);
  // スクロール: 中身の高さを測り、ホイールで動く
  for (let k = 0; k < 3; k++) {
    if (k == 2) {
      ukEventMouseMove(mut ui, 50, 50);
      ukEventWheel(mut ui, 0, -2);
    }
    ukBegin(mut ui, TW, TH, 11.0 + (k as f64) * 0.1);
    ukBeginScroll(mut ui, "sc", ukRect(0, 0, 300, 100));
    for (let i = 0; i < 20; i++) {
      ukPushIdInt(mut ui, i);
      ukButton(mut ui, "b");
      ukPopId(mut ui);
    }
    ukEndScroll(mut ui);
    ukEnd(mut ui, mut px);
  }
  const sy = ukScrollY(mut ui, "sc");
  check(mut t, sy == 2 * 3 * ui.theme.rowH, "scroll.wheel", `${sy}`);
}

function testToastAndMenu(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukBegin(mut ui, TW, TH, 20.0);
  ukToast(mut ui, "保存しました", 1);
  ukEnd(mut ui, mut px);
  check(mut t, ui.toasts.length == 1, "toast.add", "");
  ukBegin(mut ui, TW, TH, 30.0);
  ukEnd(mut ui, mut px);
  check(mut t, ui.toasts.length == 0, "toast.expire", "");
  // 右クリックのメニュー
  let hit = false;
  for (let k = 0; k < 4; k++) {
    if (k == 1) {
      btn(mut ui, 300, 300, 3, true);
      btn(mut ui, 300, 300, 3, false);
    } else if (k == 3) {
      click(mut ui, 320, 300 + Math.max(ui.theme.pad / 2, 2) + ui.theme.menuH / 2);
    }
    ukBegin(mut ui, TW, TH, 31.0 + (k as f64) * 0.1);
    if (ukContextMenu(mut ui, "ctx", ukRect(0, 0, TW, TH))) {
      if (ukMenuItem(mut ui, "貼り付け", "Ctrl+V")) {
        hit = true;
      }
      ukEndMenu(mut ui);
    }
    ukEnd(mut ui, mut px);
  }
  check(mut t, hit && ui.popups.length == 0, "menu.context", `${hit} ${ui.popups.length}`);
}


// ---- 指摘を直したことの試し ----

// 1 フレームに違う文字列を 5000 個測っても止まらない（表がその場で大きくなる）。たまった状態からでも同じ。
function testManyTexts(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukBegin(mut ui, TW, TH, 40.0);
  let w = 0;
  for (let i = 0; i < 1500; i++) {
    w += ukTextW(mut ui, `前の ${i}`, 13.0);
  }
  ukEnd(mut ui, mut px);
  const t0 = clock();
  ukBegin(mut ui, TW, TH, 40.1);
  for (let i = 0; i < 5000; i++) {
    w += ukTextW(mut ui, `列 ${i}`, 13.0);
  }
  ukBeginColAt(mut ui, ukRect(10, 10, 200, 100));
  ukButton(mut ui, "あと");
  ukEndBox(mut ui);
  ukEnd(mut ui, mut px);
  const sec = clock() - t0;
  check(mut t, ui.tx.length >= 5000 && sec < 10.0, "text-cache.5000-in-a-frame", `${ui.tx.length} ${sec}`);
  ukBegin(mut ui, TW, TH, 40.2);
  ukEnd(mut ui, mut px);
  ukBegin(mut ui, TW, TH, 40.3);
  ukEnd(mut ui, mut px);
  check(mut t, ui.tx.length < 1536, "text-cache.compact", `${ui.tx.length}`);
  check(mut t, w > 0, "text-cache.width", "");
}

function dlgKeyFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64, ids: mut u32[]): i32 {
  let pressed = 0;
  ukBegin(mut ui, TW, TH, now);
  ukBeginColAt(mut ui, ukRect(10, 10, 200, 400));
  if (ukButtonDanger(mut ui, "削除")) {
    pressed = 1;
  }
  ids[0] = ui.lastId;
  ukEndBox(mut ui);
  if (ukBeginDialog(mut ui, "確かめる", 300, 200)) {
    if (ukButton(mut ui, "はい")) {
      pressed = 2;
    }
    ids[1] = ui.lastId;
    ukButton(mut ui, "いいえ");
    ukEndDialog(mut ui);
  }
  ukEnd(mut ui, mut px);
  return pressed;
}

// ダイアログを開いたら、裏の部品に Enter が届かない。フォーカスは中の最初の部品に移り、閉じたら戻る。
function testDialogKeys(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let ids: u32[] = [0, 0];
  click(mut ui, 600, 400);
  dlgKeyFrame(mut ui, mut px, 50.0, mut ids);
  ukEventKey(mut ui, UK_KEY_TAB, 0);
  dlgKeyFrame(mut ui, mut px, 50.1, mut ids);
  check(mut t, ui.focus == ids[0] && ids[0] != 0, "dialog.setup-focus-below", "");
  ukOpenDialog(mut ui, "確かめる");
  ukEventKey(mut ui, UK_KEY_ENTER, 0);
  const p1 = dlgKeyFrame(mut ui, mut px, 50.2, mut ids);
  check(mut t, p1 == 0, "dialog.enter-not-below", `${p1}`);
  check(mut t, ui.focus == ids[1] && ids[1] != 0, "dialog.focus-moves-in", `${ui.focus} ${ids[1]}`);
  ukEventKey(mut ui, UK_KEY_ENTER, 0);
  const p2 = dlgKeyFrame(mut ui, mut px, 50.3, mut ids);
  check(mut t, p2 == 2, "dialog.enter-inside", `${p2}`);
  ukEventKey(mut ui, UK_KEY_ESC, 0);
  dlgKeyFrame(mut ui, mut px, 50.4, mut ids);
  dlgKeyFrame(mut ui, mut px, 50.5, mut ids);
  check(mut t, !ukDialogIsOpen(mut ui, "確かめる") && ui.focus == ids[0], "dialog.focus-restored", `${ui.focus}`);
}

// ダブルクリックは入力の時刻で決める（フレームが入力のときだけ回っても、間のあいた 2 回はダブルクリックにしない）。
function testDoubleClickTime(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukEventMouseButtonAt(mut ui, 300, 300, 1, true, 60.0);
  ukEventMouseButtonAt(mut ui, 300, 300, 1, false, 60.0);
  ukBegin(mut ui, TW, TH, 60.0);
  ukEnd(mut ui, mut px);
  ukEventMouseButtonAt(mut ui, 300, 300, 1, true, 64.7);
  ukEventMouseButtonAt(mut ui, 300, 300, 1, false, 64.7);
  ukBegin(mut ui, TW, TH, 64.7);
  const c1 = ui.inp.clicks;
  ukEnd(mut ui, mut px);
  ukEventMouseButtonAt(mut ui, 300, 300, 1, true, 64.9);
  ukBegin(mut ui, TW, TH, 64.9);
  const c2 = ui.inp.clicks;
  ukEnd(mut ui, mut px);
  ukEventMouseButtonAt(mut ui, 300, 300, 1, false, 64.95);
  ukBegin(mut ui, TW, TH, 65.0);
  ukEnd(mut ui, mut px);
  check(mut t, c1 == 1 && c2 == 2, "dblclick.event-time", `${c1} ${c2}`);
}

// マウスの戻る・進む（4・5）は右クリックにならない。
function testMouseButton45(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukEventMouseButtonAt(mut ui, 300, 300, 4, true, 70.0);
  ukEventMouseButtonAt(mut ui, 300, 300, 4, false, 70.0);
  ukBegin(mut ui, TW, TH, 70.0);
  const pressed = ui.inp.pressed;
  if (ukContextMenu(mut ui, "ctx45", ukRect(0, 0, TW, TH))) {
    ukEndMenu(mut ui);
  }
  ukEnd(mut ui, mut px);
  check(mut t, pressed == 0 && ui.popups.length == 0, "mouse.button4-ignored", `${pressed} ${ui.popups.length}`);
}

function dlgNumFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64, v: mut f64[]): void {
  ukBegin(mut ui, TW, TH, now);
  if (ukBeginDialog(mut ui, "数の確かめ", 300, 200)) {
    v[0] = ukNumber(mut ui, "値", v[0], 0.0, 100.0, 1.0, 0);
    ukEndDialog(mut ui);
  }
  ukEnd(mut ui, mut px);
}

// ダイアログの中で打ち込み中に Esc を押すと、打ち込みだけが取り消される（ダイアログは閉じない）。
function testDialogEscEdit(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let v: f64[] = [10.0];
  ukOpenDialog(mut ui, "数の確かめ");
  dlgNumFrame(mut ui, mut px, 80.0, mut v);
  // 中身の列は (W-300)/2 + pad*2、(H-200)/2 + tabH + pad + pad*2 から
  const cx = (TW - 300) / 2 + ui.theme.pad * 2 + 20;
  const cy = (TH - 200) / 2 + ui.theme.tabH + ui.theme.pad + ui.theme.pad * 2 + ui.theme.ctrlH / 2;
  click(mut ui, cx, cy);
  dlgNumFrame(mut ui, mut px, 80.1, mut v);
  ukEventText(mut ui, 55);
  dlgNumFrame(mut ui, mut px, 80.2, mut v);
  ukEventKey(mut ui, UK_KEY_ESC, 0);
  dlgNumFrame(mut ui, mut px, 80.3, mut v);
  dlgNumFrame(mut ui, mut px, 80.4, mut v);
  check(mut t, ukDialogIsOpen(mut ui, "数の確かめ") && v[0] == 10.0, "dialog.esc-cancels-edit-first", `${v[0]}`);
  ukEventKey(mut ui, UK_KEY_ESC, 0);
  dlgNumFrame(mut ui, mut px, 80.5, mut v);
  check(mut t, !ukDialogIsOpen(mut ui, "数の確かめ"), "dialog.esc-then-closes", "");
}

// タイムコード: ui.md の fps ごとの往復、ドロップフレームの値、桁あふれ。
function testTimecodeDf(t: mut TState): void {
  const nums: i32[] = [24, 25, 30000, 30, 50, 60000, 60];
  const dens: i32[] = [1, 1, 1001, 1, 1, 1001, 1];
  const frames: i64[] = [0, 1, 1799, 1800, 1801, 17981, 17982, 35964, 107891, 107892, 215784, 3599999, 8000000];
  let bad = "";
  for (let k: usize = 0; k < nums.length; k++) {
    const fps = ukFpsInt(nums[k], dens[k]);
    const df = ukIsDropFrame(nums[k], dens[k]);
    for (const f of frames) {
      const s = ukFormatTimecodeDf(f, fps, df);
      const back = ukParseTimecodeDf(s, fps, df, 0);
      if (back != f) {
        bad = bad + ` ${nums[k]}/${dens[k]}:${f}->${s}->${back}`;
      }
    }
  }
  check(mut t, bad.length == 0, "tc.roundtrip-all-rates", bad);
  check(mut t, ukIsDropFrame(30000, 1001) && ukIsDropFrame(60000, 1001) && !ukIsDropFrame(24000, 1001), "tc.df-rates", "");
  check(mut t, ukParseTimecodeDf("01:00:00;00", 30, true, 0) == 107892, "tc.df-one-hour", `${ukParseTimecodeDf("01:00:00;00", 30, true, 0)}`);
  check(mut t, ukFormatTimecodeDf(1800, 30, true) == "00:01:00;02", "tc.df-minute-skip", ukFormatTimecodeDf(1800, 30, true));
  check(mut t, ukFormatTimecodeDf(17982, 30, true) == "00:10:00;00", "tc.df-ten-minutes", ukFormatTimecodeDf(17982, 30, true));
  check(mut t, ukFormatTimecodeDf(3600, 60, true) == "00:01:00;04", "tc.df-5994", ukFormatTimecodeDf(3600, 60, true));
  check(mut t, ukFormatTimecodeDf(1800, 30, false) == "00:01:00:00", "tc.ndf-colon", "");
  check(mut t, ukParseTimecode("99999999999999999999", 30, 0) == -1, "tc.overflow-packed", "");
  check(mut t, ukParseTimecode("99999999999999:00:00:00", 30, 0) == -1, "tc.overflow-field", "");
  check(mut t, ukParseTimecode("1:2:3:4:5", 30, 0) == -1, "tc.too-many-fields", "");
  check(mut t, ukParseTimecode("12345678", 30, 0) == ((12 * 3600 + 34 * 60 + 56) * 30 + 78) as i64, "tc.packed-8", "");
  check(mut t, ukFixed(1e20, 2) == "1.000e20" && ukFixed(-2.5e16, 0) == "-2.500e16", "base.fixed-large", ukFixed(1e20, 2));
}

function infFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64, v: mut f64[]): void {
  const inf = 1e308 * 10.0;
  ukBegin(mut ui, TW, TH, now);
  ukBeginColAt(mut ui, ukRect(10, 10, 300, 400));
  v[0] = ukNumber(mut ui, "位置X", v[0], -inf, inf, 1.0, 1);
  v[1] = ukNumber(mut ui, "大きな範囲", v[1], -1e9, 1e9, 0.0, 2);
  ukEndBox(mut ui);
  ukEnd(mut ui, mut px);
}

// 範囲のない数値の欄をドラッグしても、値が壊れない（NaN・無限大にならない）。大きな範囲でも 1 画素で大きく動かない。
// ドラッグの修飾キーは ui.md の通り（Shift で 10 倍、Alt で 1/10）。
function testNumberRanges(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let v: f64[] = [5.0, 0.0];
  ukEventMouseMove(mut ui, 620, 470);
  infFrame(mut ui, mut px, 90.0, mut v);
  const y0 = 10 + ui.theme.ctrlH / 2;
  btn(mut ui, 100, y0, 1, true);
  infFrame(mut ui, mut px, 90.1, mut v);
  ukEventMouseMove(mut ui, 120, y0);
  infFrame(mut ui, mut px, 90.2, mut v);
  btn(mut ui, 120, y0, 1, false);
  infFrame(mut ui, mut px, 90.3, mut v);
  check(mut t, ukFinite(v[0]) && v[0] == 25.0, "number.infinite-range-drag", `${v[0]}`);
  const y1 = y0 + ui.theme.ctrlH + ui.theme.gap;
  btn(mut ui, 100, y1, 1, true);
  infFrame(mut ui, mut px, 90.4, mut v);
  ukEventMouseMove(mut ui, 104, y1);
  infFrame(mut ui, mut px, 90.5, mut v);
  btn(mut ui, 104, y1, 1, false);
  infFrame(mut ui, mut px, 90.6, mut v);
  check(mut t, ukFinite(v[1]) && Math.abs(v[1]) <= 1.0, "number.huge-range-step", `${v[1]}`);
  // Shift で 10 倍
  btn(mut ui, 100, y0, 1, true);
  infFrame(mut ui, mut px, 90.7, mut v);
  ukEventMods(mut ui, UK_MOD_SHIFT);
  ukEventMouseMove(mut ui, 105, y0);
  infFrame(mut ui, mut px, 90.8, mut v);
  btn(mut ui, 105, y0, 1, false);
  ukEventMods(mut ui, 0);
  infFrame(mut ui, mut px, 90.9, mut v);
  check(mut t, v[0] == 75.0, "number.shift-x10", `${v[0]}`);
  check(mut t, ukSnap(1e308 * 10.0, -1e308 * 10.0, 1e308 * 10.0, 1.0) == 0.0 && ukSnap(3.7, -1e308 * 10.0, 5.0, 1.0) == 4.0,
    "number.snap-finite", "");
  check(mut t, ukDragStep(-1e9, 1e9, 0.0, 2) == 0.01 && ukDragStep(0.0, 100.0, 0.0, 0) == 0.5, "number.drag-step", "");
}

function ddFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64, items: string[], sel: mut i32[]): bool {
  ukBegin(mut ui, TW, TH, now);
  ukBeginColAt(mut ui, ukRect(10, 10, 200, 400));
  sel[0] = ukDropdown(mut ui, "長い一覧", items, sel[0]);
  ukEndBox(mut ui);
  ukBeginColAt(mut ui, ukRect(400, 10, 200, 400));
  const b = ukButton(mut ui, "右のボタン");
  ukEndBox(mut ui);
  ukEnd(mut ui, mut px);
  return b;
}

// 長いドロップダウンは画面に収まり、スクロールし、キーで最後の項目まで選べる。外を押しても下のボタンは押されない。
function testLongDropdown(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let items: string[] = [];
  for (let i = 0; i < 60; i++) {
    items.push(`項目 ${i}`);
  }
  let sel: i32[] = [0];
  ddFrame(mut ui, mut px, 100.0, items, mut sel);
  click(mut ui, 50, 10 + ui.theme.ctrlH / 2);
  ddFrame(mut ui, mut px, 100.1, items, mut sel);
  ddFrame(mut ui, mut px, 100.2, items, mut sel);
  ddFrame(mut ui, mut px, 100.3, items, mut sel);
  let inside = false;
  let pr = ukRect(0, 0, 0, 0);
  for (const b of ui.blocks) {
    if (b.layer >= UK_L_POPUP && b.layer < UK_L_TOAST) {
      pr = b.r;
      inside = b.r.y >= 0 && b.r.y + b.r.h <= TH && b.r.h > 0;
    }
  }
  check(mut t, inside && ui.popups.length == 1, "dropdown.fits-screen", rectText(pr));
  ukEventKey(mut ui, UK_KEY_END, 0);
  ddFrame(mut ui, mut px, 100.4, items, mut sel);
  ukEventKey(mut ui, UK_KEY_ENTER, 0);
  ddFrame(mut ui, mut px, 100.5, items, mut sel);
  check(mut t, sel[0] == 59 && ui.popups.length == 0, "dropdown.keys-when-open", `${sel[0]} ${ui.popups.length}`);
  // 開いて、ポップアップの外の右のボタンを押す → 閉じるだけで、ボタンは押されない
  click(mut ui, 50, 10 + ui.theme.ctrlH / 2);
  ddFrame(mut ui, mut px, 100.6, items, mut sel);
  ddFrame(mut ui, mut px, 100.7, items, mut sel);
  click(mut ui, 450, 10 + ui.theme.ctrlH / 2);
  const pressed = ddFrame(mut ui, mut px, 100.8, items, mut sel);
  check(mut t, !pressed && ui.popups.length == 0, "popup.outside-click-not-passed", `${pressed} ${ui.popups.length}`);
  click(mut ui, 450, 10 + ui.theme.ctrlH / 2);
  const pressed2 = ddFrame(mut ui, mut px, 101.8, items, mut sel);
  check(mut t, pressed2, "popup.next-click-works", "");
}

function plainDlgFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64): i32 {
  ukBegin(mut ui, TW, TH, now);
  ukBeginColAt(mut ui, ukRect(10, 10, 300, 400));
  ukButton(mut ui, "下の部品");
  ukEndBox(mut ui);
  if (ukBeginDialog(mut ui, "暗幕なし", 300, 200)) {
    ukTextLine(mut ui, "中身");
    ukEndDialog(mut ui);
  }
  return ukEnd(mut ui, mut px);
}

// ダイアログの後ろに暗幕を重ねない（開いても、描き直すのはダイアログの所だけ）。
function testDialogNoOverlay(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukEventMouseMove(mut ui, 630, 470);
  plainDlgFrame(mut ui, mut px, 110.0);
  plainDlgFrame(mut ui, mut px, 110.1);
  ukOpenDialog(mut ui, "暗幕なし");
  const d = plainDlgFrame(mut ui, mut px, 110.2);
  let full = false;
  for (const c of ui.cmds) {
    if (c.w >= TW && c.h >= TH && c.layer >= UK_L_MODAL) {
      full = true;
    }
  }
  check(mut t, !full && d < TW * TH / 2, "dialog.no-overlay", `${d}`);
  ukCloseDialog(mut ui, "暗幕なし");
  plainDlgFrame(mut ui, mut px, 110.3);
}

// 本物の tokens.json（docs/design/tokens.json）を読む。対応表の道筋がすべて見つかり、色と寸法が入る。
function testRealTokens(t: mut TState, path: string): void {
  if (path.length == 0) {
    print("skip theme.real-tokens: tokens.json の場所が渡されていません");
    return;
  }
  const bytes = readFile(path);
  if (bytes == null) {
    check(mut t, false, "theme.real-tokens-read", path);
    return;
  }
  let th = ukThemeDefault(1.0);
  const res = ukThemeFromTokensEx(mut th, stringFromBytes(bytes));
  let missing = "";
  for (const p of ukTokPaths()) {
    let found = false;
    for (const m of res.mapped) {
      if (m == p) {
        found = true;
      }
    }
    if (!found) {
      missing = missing + " " + p;
    }
  }
  print(`info theme.real-tokens: 値 ${res.set} 個を設定、道筋 ${res.mapped.length} 個を当てた、使わない道筋 ${res.unused.length} 個`);
  check(mut t, missing.length == 0, "theme.real-tokens-all-paths", missing);
  check(mut t, th.bg == 0xff141414 && th.panel == 0xff1b1b1b && th.accent == 0xff4c8dff && th.text == 0xffe6e6e6,
    "theme.real-tokens-colors", "");
  check(mut t, th.radius == 5 && th.radiusSm == 3 && th.stroke == 1 && th.fontSize == 13.0 && th.ctrlH == 28,
    "theme.real-tokens-sizes", `${th.radius} ${th.radiusSm} ${th.stroke} ${th.fontSize} ${th.ctrlH}`);
  check(mut t, Math.abs(th.tipDelay - 0.6) < 1e-9 && Math.abs(th.toastLife - 4.0) < 1e-9, "theme.real-tokens-motion", "");
}

function stFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64, many: i32): i32 {
  ukBegin(mut ui, TW, TH, now);
  const sp = ukSplit(mut ui, "長く覚える分割", ukRect(0, 0, 640, 480), true, 0.5, 50, 50);
  ukBeginColAt(mut ui, ukRect(0, 0, 100, 10000));
  for (let i = 0; i < many; i++) {
    ukPushIdInt(mut ui, i);
    ukNumber(mut ui, "n", 1.0, 0.0, 10.0, 1.0, 0);
    ukPopId(mut ui);
  }
  ukEndBox(mut ui);
  ukEnd(mut ui, mut px);
  return sp.a.w;
}

// 覚えておく値があふれても、使っている値（分割の位置）を捨てない。
function testStateOverflow(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukEventMouseMove(mut ui, 630, 470);
  stFrame(mut ui, mut px, 120.0, 0);
  btn(mut ui, 320, 470, 1, true);
  stFrame(mut ui, mut px, 120.1, 0);
  ukEventMouseMove(mut ui, 100, 470);
  stFrame(mut ui, mut px, 120.2, 0);
  btn(mut ui, 100, 470, 1, false);
  const a0 = stFrame(mut ui, mut px, 120.3, 0);
  stFrame(mut ui, mut px, 120.4, 3200);
  stFrame(mut ui, mut px, 120.5, 3200);
  const a1 = stFrame(mut ui, mut px, 120.6, 0);
  check(mut t, a0 == a1 && a0 < 200, "state.overflow-keeps-split", `${a0} ${a1}`);
  check(mut t, ui.st.length >= 3200, "state.table-grows", `${ui.st.length}`);
}

function tipFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64): void {
  ukBegin(mut ui, TW, TH, now);
  ukBeginColAt(mut ui, ukRect(10, 10, 120, 400));
  ukButton(mut ui, "左");
  ukTooltip(mut ui, "左の説明");
  ukButton(mut ui, "右");
  ukTooltip(mut ui, "右の説明");
  ukEndBox(mut ui);
  ukEnd(mut ui, mut px);
}

// ツールチップは 0.6 秒待って出て、出た直後に隣へ動いたらすぐ出る。待つ間は次に描く時刻を返す。倍率は 0.8 まで下げられる。
function testTooltipAndWake(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukEventMouseMove(mut ui, 630, 470);
  tipFrame(mut ui, mut px, 130.0);
  check(mut t, ukNextFrameMs(ui) == -1, "wake.idle-sleeps", `${ukNextFrameMs(ui)}`);
  ukEventMouseMove(mut ui, 40, 10 + ui.theme.ctrlH / 2);
  tipFrame(mut ui, mut px, 130.1);
  tipFrame(mut ui, mut px, 130.2);
  const ms = ukNextFrameMs(ui);
  check(mut t, ui.tipText.length == 0 && ms > 0 && ms <= 600, "tooltip.waits-and-wakes", `${ms}`);
  tipFrame(mut ui, mut px, 130.75);
  const early = ui.tipText.length;
  tipFrame(mut ui, mut px, 130.85);
  check(mut t, early == 0 && ui.tipText == "左の説明", "tooltip.delay-600ms", ui.tipText);
  ukEventMouseMove(mut ui, 40, 10 + ui.theme.ctrlH + ui.theme.gap + ui.theme.ctrlH / 2);
  tipFrame(mut ui, mut px, 130.9);
  tipFrame(mut ui, mut px, 130.95);
  check(mut t, ui.tipText == "右の説明", "tooltip.neighbor-immediate", ui.tipText);
  ukEventMouseMove(mut ui, 630, 470);
  tipFrame(mut ui, mut px, 132.0);
  const t1 = ukThemeDefault(0.5);
  const t2 = ukThemeDefault(0.9);
  check(mut t, t1.scale == 0.8 && Math.abs(t2.scale - 0.9) < 1e-6, "theme.scale-min-0.8", `${t1.scale} ${t2.scale}`);
}

// 文字の欄にフォーカスがあるときは、カーソルの点滅の切り替わりまで眠ってよい（毎フレーム描かない）。
function testCaretWake(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  click(mut ui, 200, 20);
  textFrame(mut ui, mut px, "abc", 140.0);
  textFrame(mut ui, mut px, "abc", 140.1);
  const ms = ukNextFrameMs(ui);
  check(mut t, ms > 0 && ms <= 500, "wake.caret-blink", `${ms}`);
  click(mut ui, 600, 450);
  textFrame(mut ui, mut px, "abc", 140.2);
}

// 狭い所: 「…」も入らない幅では何も描かない。アイコンだけのボタンは自分の四角で切り取る。タブの列は切り取り、送る。
function testNarrow(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukBegin(mut ui, TW, TH, 150.0);
  const fit = ukFitText(mut ui, "音量", ui.theme.fontSize, 3);
  ukBeginRowAt(mut ui, ukRect(10, 10, 6, ui.theme.ctrlH), [6]);
  const c0 = ui.cmds.length;
  ukIconButton(mut ui, "錠", UK_I_LOCK, false);
  const c1 = ui.cmds.length;
  ukEndBox(mut ui);
  const tr = ukRect(10, 100, 80, ui.theme.tabH);
  const c2 = ui.cmds.length;
  ukTabsAt(mut ui, "狭いタブ", tr, ["メディア", "効果", "文字", "音", "書き出し"], 0);
  const c3 = ui.cmds.length;
  ukEnd(mut ui, mut px);
  check(mut t, fit.length == 0, "narrow.fit-empty", fit);
  let over = false;
  for (let i = c0; i < c1; i++) {
    if (ui.cmds[i].bx + ui.cmds[i].bw > 16) {
      over = true;
    }
  }
  check(mut t, !over, "narrow.icon-clipped", "");
  let over2 = false;
  for (let i = c2; i < c3; i++) {
    if (ui.cmds[i].bw > 0 && ui.cmds[i].bx + ui.cmds[i].bw > tr.x + tr.w) {
      over2 = true;
    }
  }
  check(mut t, !over2, "tabs.clipped", "");
}

function menuFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64): bool {
  let hit = false;
  ukBegin(mut ui, TW, TH, now);
  ukBeginMenuBar(mut ui, ukRect(0, 0, TW, ui.theme.menuH + 4));
  if (ukMenu(mut ui, "ファイル")) {
    if (ukMenuItem(mut ui, "開く", "Ctrl+O")) {
      hit = true;
    }
    ukMenuItem(mut ui, "保存", "Ctrl+S");
    ukEndMenu(mut ui);
  }
  ukEndMenuBar(mut ui);
  ukEnd(mut ui, mut px);
  return hit;
}

// メニューバーを押したまま項目へ動かして離すと選べる。
function testMenuDrag(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  ukEventMouseMove(mut ui, 630, 470);
  menuFrame(mut ui, mut px, 160.0);
  const my = (ui.theme.menuH + 4) / 2;
  btn(mut ui, 20, my, 1, true);
  menuFrame(mut ui, mut px, 160.1);
  const opened = ui.popups.length == 1;
  const iy = ui.theme.menuH + Math.max(ui.theme.pad / 2, 2) + ui.theme.menuH / 2;
  ukEventMouseMove(mut ui, 30, iy);
  menuFrame(mut ui, mut px, 160.2);
  btn(mut ui, 30, iy, 1, false);
  const hit = menuFrame(mut ui, mut px, 160.3);
  check(mut t, opened && hit && ui.popups.length == 0, "menu.press-drag-release", `${opened} ${hit} ${ui.popups.length}`);
}

// 画像の命令: 層の順に描かれ、上の層（ポップアップ）に隠れない。版が変わったときだけ描き直す。
function imgFrame(ui: mut UkCtx, px: mut Buffer<u32>, img: Buffer<u32>, ver: u32, now: f64): i32 {
  ukBegin(mut ui, TW, TH, now);
  ukDrawImage(mut ui, ukRect(100, 100, 64, 64), 0, 0, 8, 8, ver);
  ukPushLayer(mut ui, UK_L_POPUP);
  ukDrawRect(mut ui, ukRect(100, 100, 20, 20), 0xff00ff00);
  ukPopLayer(mut ui);
  return ukEndImage(mut ui, mut px, img, 8, 8);
}

function testImageCmd(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let img = new Buffer<u32>(64);
  img.fill(0xffff0000);
  ukEventMouseMove(mut ui, 630, 470);
  imgFrame(mut ui, mut px, img, 1, 170.0);
  const a = px[(110 * TW + 110) as u32];
  const b = px[(150 * TW + 150) as u32];
  check(mut t, (a & 0xffffff) == 0x00ff00 && (b & 0xffffff) == 0xff0000, "image.layer-order", `${a} ${b}`);
  const d0 = imgFrame(mut ui, mut px, img, 1, 170.1);
  img.fill(0xff0000ff);
  const d1 = imgFrame(mut ui, mut px, img, 2, 170.2);
  const a2 = px[(110 * TW + 110) as u32];
  const b2 = px[(150 * TW + 150) as u32];
  check(mut t, d0 == 0 && d1 > 0 && d1 <= 96 * 96 && (a2 & 0xffffff) == 0x00ff00 && (b2 & 0xffffff) == 0x0000ff,
    "image.redraw-on-version", `${d0} ${d1}`);
}

// 等幅の数字: そろえる字（0-9 : ; . + -）はどれも同じ送り幅（1 字の箱は切り上げで測るので、5 字は 5 × (w8 - 1) より広く 5 × w8 以下）になり、ほかの字は変わらない。
function testTabularDigits(t: mut TState, ui: mut UkCtx): void {
  const fs: f32 = 15.0;
  const w8 = ukTextWS(mut ui, "8", fs, UK_TEXT_TABULAR);
  const wa = ukTextWS(mut ui, "11:11", fs, UK_TEXT_TABULAR);
  const wb = ukTextWS(mut ui, "00.00", fs, UK_TEXT_TABULAR);
  const wc = ukTextWS(mut ui, "-1+2;", fs, UK_TEXT_TABULAR);
  const pa = ukTextW(mut ui, "11:11", fs);
  const pb = ukTextW(mut ui, "00.00", fs);
  check(mut t, Math.abs(wa - wb) <= 1 && Math.abs(wa - wc) <= 1 && wa <= 5 * w8 && wa > 5 * (w8 - 1) && wa >= pa && wb >= pb,
    "text.tabular.width", `${w8} ${wa} ${wb} ${wc} / ${pa} ${pb}`);
  const xa = ukTextWS(mut ui, "abc", fs, UK_TEXT_TABULAR);
  const xb = ukTextW(mut ui, "abc", fs);
  check(mut t, xa == xb, "text.tabular.letters", `${xa} ${xb}`);
}

// 文字の役: 等幅の書体を渡すと UK_FONT_MONO の字はどれも同じ幅になり、見出しの書体がなければ本文に太さを足して描く。
function roleFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64, style: i32): void {
  ukBegin(mut ui, TW, TH, now);
  ukDrawRect(mut ui, ukRect(0, 0, TW, TH), 0xff000000);
  ukDrawTextS(mut ui, 10, 10, "MozaicCut", 20.0, 0xffffffff, style);
  ukEnd(mut ui, mut px);
}

function inkSum(px: Buffer<u32>): i32 {
  let n = 0;
  for (let y = 0; y < 60; y++) {
    for (let x = 0; x < 200; x++) {
      n = n + ((px[(y * TW + x) as u32] >> 8) & 0xff) as i32;
    }
  }
  return n;
}

function testFontRoles(t: mut TState): void {
  let ui = ukNew(ukThemeDefault(1.0), own uiFont());
  let px = new Buffer<u32>((TW * TH) as u32);
  // 見出しの書体がないとき: 幅は本文と同じで、字が太る
  const ws = ukTextWS(mut ui, "MozaicCut", 20.0, UK_FONT_SANS);
  const wb = ukTextWS(mut ui, "MozaicCut", 20.0, UK_FONT_SEMIBOLD);
  roleFrame(mut ui, mut px, 200.0, UK_FONT_SANS);
  const inkS = inkSum(px);
  ukInvalidate(mut ui);
  roleFrame(mut ui, mut px, 200.1, UK_FONT_SEMIBOLD);
  const inkB = inkSum(px);
  check(mut t, ws == wb && inkB > inkS + inkS / 10, "font.role.semibold-substitute", `${ws} ${wb} ${inkS} ${inkB}`);
  // 等幅の書体
  const mono = loadFont("C:/Windows/Fonts/consola.ttf", 0);
  if (!mono.ok) {
    print("skip font.role.mono: Consolas が見つかりません");
    return;
  }
  const pi = ukTextWS(mut ui, "iiii", 20.0, UK_FONT_MONO);
  const pw = ukTextWS(mut ui, "WWWW", 20.0, UK_FONT_MONO);
  ukSetFont(mut ui, UK_FONT_MONO, own loadFont("C:/Windows/Fonts/consola.ttf", 0));
  const mi = ukTextWS(mut ui, "iiii", 20.0, UK_FONT_MONO);
  const mw = ukTextWS(mut ui, "WWWW", 20.0, UK_FONT_MONO);
  const mm = ukTextWS(mut ui, "WWWW", 20.0, UK_FONT_MONO_MEDIUM);
  const sw = ukTextW(mut ui, "WWWW", 20.0);
  check(mut t, pi != pw && mi == mw && mm == mw && sw == pw, "font.role.mono", `${pi} ${pw} ${mi} ${mw} ${mm} ${sw}`);
}

// 見た目の試し: 部品の輪郭（lineControl）・二重のフォーカスの輪・枠だけの危ないボタン・影のずらし。
// テーマの色を見分けやすい純色にして描き、その色の画素があるか（ないか）を数える。
function colorCount(px: Buffer<u32>, r: UkRect, c: u32): i32 {
  let n = 0;
  for (let y = r.y; y < r.y + r.h; y++) {
    for (let x = r.x; x < r.x + r.w; x++) {
      if ((px[(y * TW + x) as u32] & 0xffffff) == (c & 0xffffff)) {
        n++;
      }
    }
  }
  return n;
}

function lookFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64): void {
  ukBegin(mut ui, TW, TH, now);
  ukDrawRect(mut ui, ukRect(0, 0, TW, TH), 0xff202020);
  ukBeginColAt(mut ui, ukRect(20, 20, 200, 400));
  ukButtonDanger(mut ui, "消す");
  ukCheck(mut ui, "チェック", false);
  ukEndBox(mut ui);
  ukEnd(mut ui, mut px);
}

function testLook(t: mut TState): void {
  let th = ukThemeDefault(1.0);
  // tokens.json の道筋で読む
  const json = "{\"color\": {\"dark\": {\"line\": {\"control\": \"#00ff00\"}, \"semantic\": {\"error\": \"#ff0000\", \"focusOuter\": \"#00ffff\"}}}, \"shadow\": {\"popover\": {\"css\": \"1 6px 10px rgba(17,34,51,.25)\"}}, \"border\": {\"focus\": 3, \"focusOffset\": 2}}";
  ukThemeFromTokens(mut th, json);
  check(mut t, th.lineControl == 0xff00ff00 && th.focusOuter == 0xff00ffff && th.focusW == 3 && th.focusOffset == 2,
    "theme.tokens-line-focus", `${th.lineControl} ${th.focusOuter} ${th.focusW} ${th.focusOffset}`);
  check(mut t, th.shadowX == 1 && th.shadowY == 6 && th.shadowBlur == 10 && th.shadow == 0x40112233, "theme.tokens-shadow-css",
    `${th.shadowX} ${th.shadowY} ${th.shadowBlur} ${th.shadow}`);
  let v: f64[] = [0.0, 0.0, 0.0];
  let c: u32[] = [0];
  check(mut t, ukParseShadow("0 4px 12px rgba(0,0,0,.5)", mut v, mut c) && v[1] == 4.0 && v[2] == 12.0 && c[0] == 0x80000000 &&
    !ukParseShadow("4px", mut v, mut c), "theme.parse-shadow", `${v[0]} ${v[1]} ${v[2]} ${c[0]}`);
  th.focus = 0xffff00ff;
  let ui = ukNew(th, own uiFont());
  let px = new Buffer<u32>((TW * TH) as u32);
  lookFrame(mut ui, mut px, 300.0);
  // 危ないボタンは塗りつぶさず、error の枠だけ。チェックの枠は lineControl
  const btnR = ukRect(20, 20, 80, ui.theme.ctrlH);
  const red = colorCount(px, btnR, 0xffff0000);
  const inner = colorCount(px, ukRect(26, 24, 10, ui.theme.ctrlH - 8), 0xffff0000);
  const green = colorCount(px, ukRect(20, 20, 200, 80), 0xff00ff00);
  check(mut t, red > 20 && inner == 0 && green > 8, "look.danger-outline-and-line-control", `${red} ${inner} ${green}`);
  // Tab でフォーカスすると、内側の accent と外側の focusOuter の二重の輪が出る
  // フォーカスはフレームの終わりで移るので、輪は次のフレームに出る
  ukEventKey(mut ui, UK_KEY_TAB, 0);
  lookFrame(mut ui, mut px, 300.1);
  lookFrame(mut ui, mut px, 300.2);
  const area = ukRect(10, 10, 200, 60);
  const inR = colorCount(px, area, 0xffff00ff);
  const outR = colorCount(px, area, 0xff00ffff);
  check(mut t, ui.focusVisible && inR > 40 && outR > 40, "look.focus-double-ring", `${inR} ${outR}`);
}

// 省略: 真ん中を省くと頭と拡張子が残り、幅に収まる。後ろの省略は頭を残して「…」で終わり、幅に収まる。
function startsWithS(s: string, p: string): bool {
  if (p.length > s.length) {
    return false;
  }
  for (let i: usize = 0; i < p.length; i++) {
    if (s[i] != p[i]) {
      return false;
    }
  }
  return true;
}

function endsWithS(s: string, p: string): bool {
  if (p.length > s.length) {
    return false;
  }
  const o = s.length - p.length;
  for (let i: usize = 0; i < p.length; i++) {
    if (s[o + i] != p[i]) {
      return false;
    }
  }
  return true;
}

function testEllipsis(t: mut TState, ui: mut UkCtx): void {
  const name = "店主インタビュー_本番_テイク12_最終版.mp4";
  const fs: f32 = 13.0;
  const full = ukTextW(mut ui, name, fs);
  const w = full / 2;
  const m = ukFitTextMid(mut ui, name, fs, w, 0);
  const mw = ukTextW(mut ui, m, fs);
  check(mut t, startsWithS(m, "店主") && endsWithS(m, "版.mp4") && mw <= w && mw > w - 30,
    "text.ellipsis-middle", `${m} ${mw} ${w}`);
  check(mut t, ukFitTextMid(mut ui, "a.mp4", fs, 500, 0) == "a.mp4" && ukFitTextMid(mut ui, name, fs, 2, 0) == "",
    "text.ellipsis-middle-edges", "");
  const e = ukFitText(mut ui, name, fs, w);
  const ew = ukTextW(mut ui, e, fs);
  check(mut t, startsWithS(e, "店主") && endsWithS(e, "…") && ew <= w, "text.ellipsis-end", `${e} ${ew} ${w}`);
}

// 被覆率の画像: 置き場に入れた画像を色で描き、変わらなければ描き直さず、差し替えたらその所だけ描き直す。
function alphaFrame(ui: mut UkCtx, px: mut Buffer<u32>, now: f64): i32 {
  ukBegin(mut ui, TW, TH, now);
  ukDrawRect(mut ui, ukRect(0, 0, TW, TH), 0xff000000);
  ukDrawAlpha(mut ui, 50, 60, 77, 0xffff0000);
  ukDrawAlpha(mut ui, 90, 60, 78, 0xffff0000);
  return ukEnd(mut ui, mut px);
}

function testAlphaCmd(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let a = new Array<u8>(64);
  a.fill(255);
  ukAlphaSet(mut ui, 77, 8, 8, a);
  ukEventMouseMove(mut ui, 630, 470);
  alphaFrame(mut ui, mut px, 400.0);
  const p0 = px[(63 * TW + 53) as u32];
  const p1 = px[(63 * TW + 93) as u32];
  check(mut t, ukAlphaHas(ui, 77) && !ukAlphaHas(ui, 78) && (p0 & 0xffffff) == 0xff0000 && (p1 & 0xffffff) == 0,
    "alpha.draw", `${p0} ${p1}`);
  const d0 = alphaFrame(mut ui, mut px, 400.1);
  let b = new Array<u8>(64);
  b.fill(0);
  ukAlphaSet(mut ui, 77, 8, 8, b);
  const d1 = alphaFrame(mut ui, mut px, 400.2);
  const p2 = px[(63 * TW + 53) as u32];
  check(mut t, d0 == 0 && d1 > 0 && d1 <= 64 * 64 && (p2 & 0xffffff) == 0, "alpha.redraw-on-replace", `${d0} ${d1} ${p2}`);
}

// OS とつなぐ状態: コピーの印、IME の候補の場所、カーソルの形、窓の外からのドロップ（window.um が OS に渡す前の uikit の側）。
function testOsBridge(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let s = "素材.mp4";
  ui.clipboardOut = false;
  click(mut ui, 200, 20);
  s = textFrame(mut ui, mut px, s, 500.0);
  // 入力欄の上: 文字の形のカーソル、入力中で、欄の場所を知らせる
  ukEventMouseMove(mut ui, 200, 20);
  s = textFrame(mut ui, mut px, s, 500.1);
  const area = ui.imeArea.clone();
  check(mut t, ui.cursor == UK_CURSOR_TEXT && ui.textActive && area[2] > 0 && area[1] >= 10 && area[1] < 60,
    "os.cursor-and-ime-area", `${ui.cursor} ${ui.textActive} ${area[0]} ${area[1]} ${area[2]} ${area[3]} ${area[4]}`);
  // コピーすると印が立つ（window.um がそれを見て OS に書く）
  ukEventKey(mut ui, UK_KEY_CHAR + 97, UK_MOD_CTRL);
  ukEventKey(mut ui, UK_KEY_CHAR + 99, UK_MOD_CTRL);
  s = textFrame(mut ui, mut px, s, 500.2);
  check(mut t, ui.clipboardOut && ui.clipboard == "素材.mp4", "os.copy-flag", ui.clipboard);
  ui.clipboardOut = false;
  // 外に出ると既定の形
  ukEventMouseMove(mut ui, 600, 450);
  s = textFrame(mut ui, mut px, s, 500.3);
  check(mut t, ui.cursor == UK_CURSOR_DEFAULT, "os.cursor-default", `${ui.cursor}`);
  // ドロップ: 引いている間は受け口の上か分かり、落としたフレームだけファイルを 1 回受け取れる
  ukEventDropBegin(mut ui);
  ukEventDropMove(mut ui, 100, 100);
  s = textFrame(mut ui, mut px, s, 500.4);
  const over = ukDropOver(ui, ukRect(50, 50, 100, 100)) && !ukDropOver(ui, ukRect(300, 300, 10, 10));
  ukEventDropFile(mut ui, "C:/素材/a.mp4");
  ukEventDropFile(mut ui, "C:/素材/b.wav");
  ukEventDropComplete(mut ui, 100, 100);
  ukBegin(mut ui, TW, TH, 500.5);
  const miss = ukDropTake(mut ui, ukRect(300, 300, 10, 10));
  const got = ukDropTake(mut ui, ukRect(50, 50, 100, 100));
  const again = ukDropTake(mut ui, ukRect(50, 50, 100, 100));
  ukEnd(mut ui, mut px);
  ukBegin(mut ui, TW, TH, 500.6);
  const later = ui.dropped;
  ukEnd(mut ui, mut px);
  check(mut t, over && miss.length == 0 && got.length == 2 && got[1] == "C:/素材/b.wav" && again.length == 0 && !later,
    "os.drop", `${over} ${miss.length} ${got.length} ${again.length} ${later}`);
}

// IME で変換している間は、入力欄が Backspace・Enter・Esc・矢印を使わない（OS がそれらを KeyDown としても届けた場合）。
// 変換が終われば（途中の文字が空になれば）、いつもどおり使う。
function testImeKeys(t: mut TState, ui: mut UkCtx, px: mut Buffer<u32>): void {
  let s = "素材";
  click(mut ui, 200, 20);
  s = textFrame(mut ui, mut px, s, 510.0);
  ukEventKey(mut ui, UK_KEY_END, 0);
  s = textFrame(mut ui, mut px, s, 510.1);
  ukEventImeComposition(mut ui, "えい");
  ukEventKey(mut ui, UK_KEY_BACKSPACE, 0);
  ukEventKey(mut ui, UK_KEY_LEFT, 0);
  ukEventKey(mut ui, UK_KEY_ENTER, 0);
  ukEventKey(mut ui, UK_KEY_ESC, 0);
  s = textFrame(mut ui, mut px, s, 510.2);
  const focused = ui.focus != 0;
  check(mut t, s == "素材" && !ui.lastSubmit && focused, "ime.keys-while-composing", `${s} ${ui.lastSubmit} ${focused}`);
  // 確定: 途中の文字が空になり、確定した文字が入る。カーソルは動いていないので末尾に入る
  ukEventImeComposition(mut ui, "");
  ukEventText(mut ui, 0x6620);   // 映
  s = textFrame(mut ui, mut px, s, 510.3);
  ukEventKey(mut ui, UK_KEY_BACKSPACE, 0);
  ukEventKey(mut ui, UK_KEY_BACKSPACE, 0);
  s = textFrame(mut ui, mut px, s, 510.4);
  ukEventKey(mut ui, UK_KEY_ENTER, 0);
  s = textFrame(mut ui, mut px, s, 510.5);
  check(mut t, s == "素" && ui.lastSubmit, "ime.keys-after-commit", `${s} ${ui.lastSubmit}`);
}

// 字ごとの予備の書体: Latin だけの書体（Consolas）に和文の書体を予備として渡すと、和文が予備の字形で測られ描かれる。
function alphaSum(a: f32[]): f32 {
  let s: f32 = 0.0;
  for (const v of a) {
    s = s + v;
  }
  return s;
}

function testFallbackFont(t: mut TState): void {
  const latin = loadFont("C:/Windows/Fonts/consola.ttf", 0);
  const jp = uiFont();
  if (!latin.ok || !jp.ok || glyphIndex(latin, 0x3042) != 0 || glyphIndex(jp, 0x3042) == 0) {
    print("skip font.fallback: Consolas と和文の書体が見つかりません");
    return;
  }
  let ui = ukNew(ukThemeDefault(1.0), own loadFont("C:/Windows/Fonts/consola.ttf", 0));
  const wa0 = ukTextW(mut ui, "abc", 20.0);
  ukSetFallbackFont(mut ui, own uiFont());
  const wa1 = ukTextW(mut ui, "abc", 20.0);
  const wj = ukTextW(mut ui, "あい", 20.0);
  const wr = textWidthPxEx(jp, emptyFont(), "あい", 20.0, 0);
  const wn = textWidthPxEx(latin, emptyFont(), "あい", 20.0, 0);
  check(mut t, wa0 == wa1 && wj == wr && wj != wn, "font.fallback.width", `${wa0} ${wa1} ${wj} ${wr} ${wn}`);
  const none = renderTextImageEx(latin, emptyFont(), "あ", 20.0, 0, 2, 0);
  const fb = renderTextImageEx(latin, jp, "あ", 20.0, 0, 2, 0);
  const ref = renderTextImageEx(jp, emptyFont(), "あ", 20.0, 0, 2, 0);
  const sf = alphaSum(fb.alpha);
  const sr = alphaSum(ref.alpha);
  check(mut t, Math.abs(sf - sr) < sr * 0.02 && Math.abs(alphaSum(none.alpha) - sf) > sr * 0.1, "font.fallback.glyph",
    `${sf} ${sr} ${alphaSum(none.alpha)}`);
}

export function main(): i32 {
  let t: TState = { ok: 0, ng: 0 };
  testBase(mut t);
  testTheme(mut t);
  testNumbers(mut t);
  let ui = ukNew(ukThemeDefault(1.0), own uiFont());
  let px = new Buffer<u32>((TW * TH) as u32);
  testLayout(mut t, mut ui, mut px);
  testButtonsAndDirty(mut t, mut ui, mut px);
  testFocus(mut t, mut ui, mut px);
  testText(mut t, mut ui, mut px);
  testValues(mut t, mut ui, mut px);
  testChoices(mut t, mut ui, mut px);
  testList(mut t, mut ui, mut px);
  testDialog(mut t, mut ui, mut px);
  testDockSplitScroll(mut t, mut ui, mut px);
  testToastAndMenu(mut t, mut ui, mut px);
  testManyTexts(mut t, mut ui, mut px);
  testDialogKeys(mut t, mut ui, mut px);
  testDoubleClickTime(mut t, mut ui, mut px);
  testMouseButton45(mut t, mut ui, mut px);
  testDialogEscEdit(mut t, mut ui, mut px);
  testTimecodeDf(mut t);
  testNumberRanges(mut t, mut ui, mut px);
  testLongDropdown(mut t, mut ui, mut px);
  testDialogNoOverlay(mut t, mut ui, mut px);
  testStateOverflow(mut t, mut ui, mut px);
  testTooltipAndWake(mut t, mut ui, mut px);
  testCaretWake(mut t, mut ui, mut px);
  testNarrow(mut t, mut ui, mut px);
  testMenuDrag(mut t, mut ui, mut px);
  testImageCmd(mut t, mut ui, mut px);
  testFallbackFont(mut t);
  testTabularDigits(mut t, mut ui);
  testFontRoles(mut t);
  testLook(mut t);
  testEllipsis(mut t, mut ui);
  testAlphaCmd(mut t, mut ui, mut px);
  testOsBridge(mut t, mut ui, mut px);
  testImeKeys(mut t, mut ui, mut px);
  const a = args();
  let tokPath = "";
  if (a.length > 0) {
    tokPath = a[0].clone();
  }
  testRealTokens(mut t, tokPath);
  print(`{"ok":${t.ok},"ng":${t.ng}}`);
  return t.ng == 0 ? 0 : 1;
}
