// エクスプレッションの数学の部品（kernel の関数）。
// - hash と乱数は CPU の値の式（expr.um）と画素の式（expr_pixel.um）の両方で使う（同じ整数の計算なので同じ値）。
// - f32 の sin / cos / atan / exp / log / pow は画素の式の kernel が使う。UM の kernel には Math.sin などがないので、
//   足し算・掛け算・割り算・floor だけの多項式で求める（UM は CPU と GPU で四則演算の丸めを揃えるので、結果は 1 ビットも違わない）。

// 足し算・引き算の並び（(a - b) - c）を、GPU のドライバが並べ替えないようにする。
// NVIDIA の Vulkan で、(a - b) - c が a - (b + c) と計算され、CPU と 1 ULP 違うことがあった（UM の WGSL は掛け算の
// FMA へのまとめだけを止めている）。掛け算は UM が WGSL で um_fmul（実行時の 0 との OR）にするので、v * 1.0 を挟むと
// ドライバはその先を見通せない。CPU では v * 1.0 は v そのもの。
export kernel function exprKeep(v: f32): f32 {
  return v * 1.0;
}

// 32 ビットの整数の hash（lowbias32）。
export kernel function exprHash(x0: u32): u32 {
  let x = x0;
  x = x ^ (x >> 16);
  x = x * 0x7feb352d;
  x = x ^ (x >> 15);
  x = x * 0x846ca68b;
  x = x ^ (x >> 16);
  return x;
}

// hash から 0 以上 1 未満の数（24 ビット。f32 でも f64 でも正確に同じ値）。
export kernel function exprHashF(x: u32): f32 {
  return ((exprHash(x) >> 8) as f32) * (1.0 / 16777216.0);
}

export kernel function exprSinPolyF(r: f32): f32 {
  const r2 = r * r;
  return r + r * r2 * (-0.16666666666666666 + r2 * (0.008333333333333333 + r2 * (-0.0001984126984126984 + r2 * 0.0000027557319223985893)));
}

export kernel function exprCosPolyF(r: f32): f32 {
  const r2 = r * r;
  return 1.0 + r2 * (-0.5 + r2 * (0.041666666666666664 + r2 * (-0.001388888888888889 + r2 * (0.0000248015873015873 - r2 * 0.0000002755731922398589))));
}

// sin（q0 = 0）と cos（q0 = 1）。
// x から k * π/2 を引いて |r| ≤ π/4 にする（Cody-Waite）。π/2 は 8 ビットずつの C1〜C3 と残りの C4 に、k は 256 の倍数の kh と
// 残りの kl（< 256）に分けるので、k < 2^23 なら kh * Cn と kl * Cn は f32 で正確で、引き算もほぼ正確（大きい部品から引く）。
// 並べ替えられないよう、引くごとに exprKeep を挟む。
// |x| が 2^23（8388608）以上の f32 は整数しか表せず、位相が意味を持たないので 0 を返す（schema と文書に書いてある上限）。
export kernel function exprSinCosF(x: f32, q0: i32): f32 {
  if (!(x < 8388608.0 && x > -8388608.0)) {
    return 0.0;
  }
  const k = Math.floor(x * 0.6366197723675814 + 0.5);
  const kh = Math.floor(k * 0.00390625) * 256.0;
  const kl = k - kh;
  let r = exprKeep(x - kh * 1.5703125);
  r = exprKeep(r - kl * 1.5703125);
  r = exprKeep(r - kh * 0.0004825592041015625);
  r = exprKeep(r - kl * 0.0004825592041015625);
  r = exprKeep(r - kh * 0.00000126659870147705078125);
  r = exprKeep(r - kl * 0.00000126659870147705078125);
  r = r - k * 9.9209362947050295e-10;
  const q = ((k as i32) + q0) & 3;
  if (q == 0) {
    return exprSinPolyF(r);
  }
  if (q == 1) {
    return exprCosPolyF(r);
  }
  if (q == 2) {
    return -exprSinPolyF(r);
  }
  return -exprCosPolyF(r);
}

export kernel function exprSinF(x: f32): f32 {
  return exprSinCosF(x, 0);
}

export kernel function exprCosF(x: f32): f32 {
  return exprSinCosF(x, 1);
}

export kernel function exprAtanF(x0: f32): f32 {
  if (x0 != x0) {
    return x0;
  }
  let x = Math.abs(x0);
  let inv = false;
  if (x > 1.0) {
    inv = true;
    x = 1.0 / x;
  }
  let off: f32 = 0.0;
  if (x > 0.2679491924311227) {
    off = 0.5235987755982988;
    x = (x * 1.7320508075688772 - 1.0) / (x + 1.7320508075688772);
  }
  const x2 = x * x;
  let r = off + exprKeep(x + x * x2 * (-0.3333333333333333 + x2 * (0.2 + x2 * (-0.14285714285714285 + x2 * (0.1111111111111111 - x2 * 0.09090909090909091)))));
  if (inv) {
    r = 1.5707963267948966 - r;
  }
  if (x0 < 0.0) {
    r = -r;
  }
  return r;
}

export kernel function exprAtan2F(y: f32, x: f32): f32 {
  if (x > 0.0) {
    return exprAtanF(y / x);
  }
  if (x < 0.0) {
    if (y >= 0.0) {
      return exprAtanF(y / x) + 3.141592653589793;
    }
    return exprAtanF(y / x) - 3.141592653589793;
  }
  if (y > 0.0) {
    return 1.5707963267948966;
  }
  if (y < 0.0) {
    return -1.5707963267948966;
  }
  return 0.0;
}

export kernel function exprPow2iF(k0: i32): f32 {
  let k = k0;
  let b: f32 = 2.0;
  if (k < 0) {
    k = -k;
    b = 0.5;
  }
  let p: f32 = 1.0;
  for (let i = 0; i < 8; i++) {
    if ((k & 1) != 0) {
      p = p * b;
    }
    b = b * b;
    k = k >> 1;
  }
  return p;
}

export kernel function exprExpF(x: f32): f32 {
  if (x != x) {
    return x;
  }
  if (x > 88.0) {
    return 3.0e38 * 10.0;
  }
  if (x < -87.0) {
    return 0.0;
  }
  const k = Math.floor(x * 1.4426950408889634 + 0.5);
  const r = exprKeep(x - k * 0.693145751953125) - k * 0.0000014286068203094173;
  const e = 1.0 + r * (1.0 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333 + r * (0.001388888888888889 + r * 0.0001984126984126984))))));
  return e * exprPow2iF(k as i32);
}

export kernel function exprLogF(x0: f32): f32 {
  if (x0 != x0 || x0 < 0.0) {
    const z: f32 = 0.0;
    return z / z;
  }
  if (x0 == 0.0) {
    return -3.0e38 * 10.0;
  }
  if (x0 > 3.0e38) {
    return x0;
  }
  let m = x0;
  let e: i32 = 0;
  for (let i = 0; i < 8; i++) {
    if (m >= 65536.0) {
      m = m * 0.0000152587890625;
      e = e + 16;
    }
    if (m < 0.0000152587890625) {
      m = m * 65536.0;
      e = e - 16;
    }
  }
  for (let i = 0; i < 17; i++) {
    if (m >= 1.4142135623730951) {
      m = m * 0.5;
      e = e + 1;
    }
    if (m < 0.7071067811865476) {
      m = m * 2.0;
      e = e - 1;
    }
  }
  const s = (m - 1.0) / (m + 1.0);
  const s2 = s * s;
  const lm = 2.0 * (s + s * s2 * (0.3333333333333333 + s2 * (0.2 + s2 * (0.14285714285714285 + s2 * 0.1111111111111111))));
  const fe = e as f32;
  return fe * 0.693145751953125 + exprKeep(lm + fe * 0.0000014286068203094173);
}

export kernel function exprPowF(a: f32, b: f32): f32 {
  if (b == 0.0) {
    return 1.0;
  }
  if (b == Math.floor(b) && b <= 32.0 && b >= -32.0) {
    let n = b as i32;
    let inv = false;
    if (n < 0) {
      inv = true;
      n = -n;
    }
    let p: f32 = 1.0;
    let base = a;
    for (let i = 0; i < 6; i++) {
      if ((n & 1) != 0) {
        p = p * base;
      }
      base = base * base;
      n = n >> 1;
    }
    if (inv) {
      return 1.0 / p;
    }
    return p;
  }
  if (a < 0.0) {
    const z: f32 = 0.0;
    return z / z;
  }
  if (a == 0.0) {
    if (b > 0.0) {
      return 0.0;
    }
    return 3.0e38 * 10.0;
  }
  return exprExpF(b * exprLogF(a));
}

// 値の雑音（-1〜1）。expr.um の exNoise1 / exNoise2 と同じ格子と hash（精度は f32）。
export kernel function exprNoise1F(x: f32, seed: u32): f32 {
  const fl = Math.floor(x);
  const i = (fl as i32) as u32;
  const f = x - fl;
  const a = exprHashF(i ^ seed) * 2.0 - 1.0;
  const b = exprHashF((i + 1) ^ seed) * 2.0 - 1.0;
  const u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
  return a + (b - a) * u;
}

export kernel function exprNoise2F(x: f32, y: f32, seed: u32): f32 {
  const fx = Math.floor(x);
  const fy = Math.floor(y);
  const ix = (fx as i32) as u32;
  const iy = (fy as i32) as u32;
  const tx = x - fx;
  const ty = y - fy;
  const sy0 = exprHash(iy ^ seed);
  const sy1 = exprHash((iy + 1) ^ seed);
  const a = exprHashF(ix ^ sy0) * 2.0 - 1.0;
  const b = exprHashF((ix + 1) ^ sy0) * 2.0 - 1.0;
  const c = exprHashF(ix ^ sy1) * 2.0 - 1.0;
  const d = exprHashF((ix + 1) ^ sy1) * 2.0 - 1.0;
  const ux = tx * tx * tx * (tx * (tx * 6.0 - 15.0) + 10.0);
  const uy = ty * ty * ty * (ty * (ty * 6.0 - 15.0) + 10.0);
  const top = a + (b - a) * ux;
  const bot = c + (d - c) * ux;
  return top + (bot - top) * uy;
}
