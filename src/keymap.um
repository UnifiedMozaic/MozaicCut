  kmCmd(mut o, "ai.reject", "ai", V, "aiReview", "ai.reject");
  return o;
}

export function kmFindCommand(cmds: KmCommand[], id: string): i32 {
  for (let i: usize = 0; i < cmds.length; i++) {
    if (cmds[i].id == id) {
      return i as i32;
    }
  }
  return -1;
}

// ---- プリセット ----

// 割り当てを 1 つ足す。chords は " / " で区切って複数書ける（"Delete / Backspace"）。
function kmB(out: mut KmBinding[], cmds: KmCommand[], cmd: string, chords: string): void {
  const ci = kmFindCommand(cmds, cmd);
  let ctx = "";
  if (ci >= 0) {
    ctx = cmds[ci as usize].ctx.clone();
  } else {
    eprint(`keymap: unknown command '${cmd}'`);
  }
  let a: usize = 0;
  let i: usize = 0;
  while (i <= chords.length) {
    const end = i == chords.length || (i + 2 < chords.length && chords[i] == 32 && chords[i + 1] == 47 && chords[i + 2] == 32);
    if (end) {
      const part = kmSub(chords, a, i);
      const ch = kmParseChord(part);
      if (ch.key.length == 0) {
        eprint(`keymap: cannot read '${part}' (${cmd})`);
      } else {
        out.push({ cmd: cmd.clone(), chord: ch, ctx: ctx.clone() });
      }
      a = i + 3;
      i = i + 3;
    } else {
      i++;
    }
  }
}

export function kmPresetId(p: i32): string {
  switch (p) {
    case 1: return "premiere";
    case 2: return "resolve";
    case 3: return "legacy";
  }
  return "standard";
}

export function kmPresetFromId(s: string): i32 {
  switch (s) {
    case "premiere": return KM_PRESET_PREMIERE;
    case "resolve": return KM_PRESET_RESOLVE;
    case "legacy": return KM_PRESET_LEGACY;
  }
  return KM_PRESET_STANDARD;
}

// どの配列でも同じ割り当て（ファイル・AI など）
function kmCommon(o: mut KmBinding[], c: KmCommand[]): void {
  kmB(mut o, c, "play.toggle", "Space");
  kmB(mut o, c, "playhead.stepBack", "Left");
  kmB(mut o, c, "playhead.stepForward", "Right");
  kmB(mut o, c, "playhead.step10Back", "Shift+Left");
  kmB(mut o, c, "playhead.step10Forward", "Shift+Right");
  kmB(mut o, c, "playhead.prevEdit", "Up");
  kmB(mut o, c, "playhead.nextEdit", "Down");
  kmB(mut o, c, "playhead.start", "Home");
  kmB(mut o, c, "playhead.end", "End");
  kmB(mut o, c, "playhead.goto", "Ctrl+G");
  kmB(mut o, c, "playhead.toIn", "Shift+I");
  kmB(mut o, c, "playhead.toOut", "Shift+O");
  kmB(mut o, c, "mark.in", "I");
  kmB(mut o, c, "mark.out", "O");
  kmB(mut o, c, "mark.clip", "X");
  kmB(mut o, c, "marker.add", "M");
  kmB(mut o, c, "tool.hand", "H");
  kmB(mut o, c, "clip.nudgeBack", "Alt+Left");
