  kmB(mut o, c, "panel.prev", "Shift+F6");
  kmB(mut o, c, "focus.next", "Tab");
  kmB(mut o, c, "ui.confirm", "Enter");
  kmB(mut o, c, "ui.cancel", "Esc");
  kmB(mut o, c, "ai.focus", "Ctrl+J");
