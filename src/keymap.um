// キーの割り当て（docs/design/ui.md の 5.3・5.4）: 操作の名前（コマンドの ID）→ キー。
//
// - キーは物理キーの位置を US 配列の名前で持つ（"=" は US の = の位置。JIS では「^」と刻印する）。
// - 修飾キーは論理で持つ: KM_MOD_CTRL は「主の修飾キー」（Windows・Linux は Ctrl、Mac は Cmd）、KM_MOD_ALT は Alt（Mac は Option）、
//   KM_MOD_META は Windows キー（Mac は Control）。Mac で Ctrl を Cmd に読み替えるのは kmChordText と kmEventMods の 2 か所だけ。
// - 配列のプリセット（標準・Premiere Pro 互換・DaVinci Resolve 互換・MozaicCut 0.x）は、どれも同じコマンドの ID を呼ぶ。
// - 文脈（ctx）: "" はどこでも（タイムライン）、"trim" はトリムモード、"aiInput" は AI の入力の欄、"aiCard" は提案のカード、
//   "aiReview" は確かめる欄。文脈のある割り当ては、同じキーの "" の割り当てより先に効く（重複とは数えない）。
// - 利用者が変えた割り当ては JSON（kmUserJson / kmLoadUser）で読み書きする。
//
// 名前の空間は全ファイルで 1 つなので、このファイルの名前は km / Km / KM_ で始める。
// 修飾キーのビットは uikit の UK_MOD_* と同じ値にしてある（ukKeyTakeMods の値をそのまま渡せる）。

export const KM_MOD_SHIFT: i32 = 1;
export const KM_MOD_CTRL: i32 = 2;
export const KM_MOD_ALT: i32 = 4;
export const KM_MOD_META: i32 = 8;

export const KM_PRESET_STANDARD: i32 = 0;
export const KM_PRESET_PREMIERE: i32 = 1;
export const KM_PRESET_RESOLVE: i32 = 2;
export const KM_PRESET_LEGACY: i32 = 3;
export const KM_PRESET_COUNT: i32 = 4;

export const KM_LAYOUT_JIS: i32 = 0;
export const KM_LAYOUT_US: i32 = 1;

// キーボードの絵の色分け（shortcuts.html の凡例）
export const KM_CAT_NONE: i32 = 0;
export const KM_CAT_PLAY: i32 = 1;   // 再生と移動
export const KM_CAT_MARK: i32 = 2;   // 印
export const KM_CAT_TOOL: i32 = 3;   // ツール
export const KM_CAT_RIPPLE: i32 = 4; // 詰める
export const KM_CAT_OVER: i32 = 5;   // 詰めない
export const KM_CAT_VIEW: i32 = 6;   // 表示・その他

export struct KmChord {
  mods: i32;
  // US 配列の位置の名前（"A"、"1"、"F5"、"Delete"、"Left"、"="、"Yen" など）。空なら「割り当てなし」
  key: string;
}

export struct KmCommand {
  id: string;
  // 分類（i18n の "grp.<group>"）
  group: string;
  cat: i32;
  ctx: string;
  // 一覧の表で 1 行にまとめる名前（i18n の "row.<row>"。コマンドが 1 つだけの行は id と同じ）
  row: string;
}

export struct KmBinding {
  cmd: string;
  chord: KmChord;
  ctx: string;
}

export struct KmMap {
  preset: i32;
  binds: KmBinding[];
}

// 同じ文脈で同じキーが 2 つのコマンドに当たっている。
export struct KmConflict {
  chord: KmChord;
  ctx: string;
  a: string;
  b: string;
}

// ---- 文字列の小道具 ----

function kmSub(s: string, a: usize, b: usize): string {
  let out: u8[] = [];
  let i = a;
  while (i < b && i < s.length) {
    out.push(s[i]);
    i++;
  }
  return stringFromBytes(out);
}

function kmUpper(s: string): string {
  let out: u8[] = [];
  for (let i: usize = 0; i < s.length; i++) {
    const c = s[i];
    if (c >= 97 && c <= 122) {
      out.push(c - 32);
    } else {
      out.push(c);
    }
  }
  return stringFromBytes(out);
}

function kmIsDigits(s: string): bool {
  if (s.length == 0) {
    return false;
  }
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] < 48 || s[i] > 57) {
      return false;
    }
  }
  return true;
}

function kmToInt(s: string): i32 {
  let v = 0;
  for (let i: usize = 0; i < s.length; i++) {
    v = v * 10 + ((s[i] as i32) - 48);
  }
  return v;
}

// ASCII だけの大文字・小文字を無視した比較
function kmEqI(a: string, b: string): bool {
  return kmUpper(a) == kmUpper(b);
}

// ---- キーの名前 ----

// 書き方の揺れを正しい名前にする（"del" → "Delete"、"←" → "Left"、"a" → "A"）。分からなければ ""。
export function kmNormKey(s0: string): string {
  const s = s0.clone();
  if (s.length == 0) {
    return "";
  }
  if (s.length == 1) {
    const c = s[0];
    if (c >= 97 && c <= 122) {
      return kmUpper(s);
    }
    if ((c >= 65 && c <= 90) || (c >= 48 && c <= 57)) {
      return s.clone();
    }
    switch (c) {
      case 45: return "-";
      case 61: return "=";
      case 91: return "[";
      case 93: return "]";
      case 92: return "\\";
      case 59: return ";";
      case 39: return "'";
      case 44: return ",";
      case 46: return ".";
      case 47: return "/";
      case 96: return "`";
      case 32: return "Space";
    }
    return "";
  }
  switch (s) {
    case "←": return "Left";
    case "→": return "Right";
    case "↑": return "Up";
    case "↓": return "Down";
    case "¥": return "Yen";
  }
  const u = kmUpper(s);
  switch (u) {
    case "SPACE": return "Space";
    case "ENTER": return "Enter";
    case "RETURN": return "Enter";
    case "ESC": return "Esc";
    case "ESCAPE": return "Esc";
    case "TAB": return "Tab";
    case "BACKSPACE": return "Backspace";
    case "BS": return "Backspace";
    case "DELETE": return "Delete";
    case "DEL": return "Delete";
    case "INSERT": return "Insert";
    case "INS": return "Insert";
    case "HOME": return "Home";
    case "END": return "End";
    case "PAGEUP": return "PageUp";
    case "PGUP": return "PageUp";
    case "PAGEDOWN": return "PageDown";
    case "PGDN": return "PageDown";
    case "LEFT": return "Left";
    case "RIGHT": return "Right";
    case "UP": return "Up";
    case "DOWN": return "Down";
    case "YEN": return "Yen";
    case "RO": return "Ro";
    case "MUHENKAN": return "Muhenkan";
    case "HENKAN": return "Henkan";
    case "KANA": return "Kana";
  }
  if (u.length >= 2 && u.length <= 3 && u[0] == 70) {
    const n = kmSub(u, 1, u.length);
    if (kmIsDigits(n)) {
      const v = kmToInt(n);
      if (v >= 1 && v <= 24) {
        return u.clone();
      }
    }
  }
  return "";
}

// 画面に出すキーの刻印。JIS では US の位置の名前を JIS の刻印に読み替える（"=" → "^"）。
export function kmKeyCap(key: string, layout: i32): string {
  switch (key) {
    case "Left": return "←";
    case "Right": return "→";
    case "Up": return "↑";
    case "Down": return "↓";
    case "PageUp": return "PgUp";
    case "PageDown": return "PgDn";
    case "Yen": return "¥";
    case "Ro": return "ろ";
    case "Muhenkan": return "無変換";
    case "Henkan": return "変換";
    case "Kana": return "かな";
  }
  if (layout == KM_LAYOUT_JIS) {
    switch (key) {
      case "=": return "^";
      case "[": return "@";
      case "]": return "[";
      case "\\": return "]";
      case "'": return ":";
      case "`": return "半/全";
    }
  }
  return key.clone();
}

// 押した文字（SDL の Key.Char の符号位置）から、US の位置の名前を求める。
// スキャンコードの組み込み（ui.md 21.5 の 2）が来るまでの代わり。Shift を押した記号も元のキーに戻す。分からなければ ""。
export function kmKeyFromChar(cp: i32, layout: i32): string {
  if (cp >= 97 && cp <= 122) {
    return stringFromBytes([(cp - 32) as u8]);
  }
  if ((cp >= 65 && cp <= 90) || (cp >= 48 && cp <= 57)) {
    return stringFromBytes([cp as u8]);
  }
  if (cp == 165) {
    return "Yen";
  }
  if (layout == KM_LAYOUT_JIS) {
    switch (cp) {
      case 33: return "1";   // !
      case 34: return "2";   // "
      case 35: return "3";   // #
      case 36: return "4";   // $
      case 37: return "5";   // %
      case 38: return "6";   // &
      case 39: return "7";   // '
      case 40: return "8";   // (
      case 41: return "9";   // )
      case 45: return "-";
      case 61: return "-";   // = は Shift+-
      case 94: return "=";   // ^
      case 126: return "=";  // ~
      case 124: return "Yen"; // |
      case 64: return "[";   // @
      case 96: return "[";   // `
      case 91: return "]";   // [
      case 123: return "]";  // {
      case 93: return "\\";  // ]
      case 125: return "\\"; // }
      case 59: return ";";
      case 43: return ";";   // +
      case 58: return "'";   // :
      case 42: return "'";   // *
      case 44: return ",";
      case 60: return ",";
      case 46: return ".";
      case 62: return ".";
      case 47: return "/";
      case 63: return "/";
      case 92: return "Ro";  // \（ろ）
      case 95: return "Ro";  // _
      case 32: return "Space";
    }
    return "";
  }
  switch (cp) {
    case 33: return "1";
    case 64: return "2";
    case 35: return "3";
    case 36: return "4";
    case 37: return "5";
    case 94: return "6";
    case 38: return "7";
    case 42: return "8";
    case 40: return "9";
    case 41: return "0";
    case 45: return "-";
    case 95: return "-";
    case 61: return "=";
    case 43: return "=";
    case 91: return "[";
    case 123: return "[";
    case 93: return "]";
    case 125: return "]";
    case 92: return "\\";
    case 124: return "\\";
    case 59: return ";";
    case 58: return ";";
    case 39: return "'";
    case 34: return "'";
    case 44: return ",";
    case 60: return ",";
    case 46: return ".";
    case 62: return ".";
    case 47: return "/";
    case 63: return "/";
    case 96: return "`";
    case 126: return "`";
    case 32: return "Space";
  }
  return "";
}

// ---- キーの組み合わせ ----

export function kmChord(mods: i32, key: string): KmChord {
  return { mods, key: key.clone() };
}

export function kmChordEq(a: KmChord, b: KmChord): bool {
  return a.mods == b.mods && a.key == b.key;
}

// "Ctrl+Shift+B"、"Cmd+K"、"Alt+←"、"Shift+=" を読む。読めなければ key が空。
// Cmd / Command / ⌘ は主の修飾キー（KM_MOD_CTRL）として読む。Option は Alt。Win / Meta / Super は KM_MOD_META。
export function kmParseChord(s: string): KmChord {
  let mods = 0;
  let parts: string[] = [];
  let a: usize = 0;
  let i: usize = 0;
  while (i < s.length) {
    if (s[i] == 43 && i > a) {
      parts.push(kmSub(s, a, i));
      a = i + 1;
    }
    i++;
  }
  parts.push(kmSub(s, a, s.length));
  if (parts.length == 0) {
    return { mods: 0, key: "" };
  }
  for (let k: usize = 0; k + 1 < parts.length; k++) {
    const u = kmUpper(parts[k]);
    switch (u) {
      case "CTRL": mods = mods | KM_MOD_CTRL; break;
      case "CONTROL": mods = mods | KM_MOD_CTRL; break;
      case "CMD": mods = mods | KM_MOD_CTRL; break;
      case "COMMAND": mods = mods | KM_MOD_CTRL; break;
      case "⌘": mods = mods | KM_MOD_CTRL; break;
      case "SHIFT": mods = mods | KM_MOD_SHIFT; break;
      case "⇧": mods = mods | KM_MOD_SHIFT; break;
      case "ALT": mods = mods | KM_MOD_ALT; break;
      case "OPTION": mods = mods | KM_MOD_ALT; break;
      case "OPT": mods = mods | KM_MOD_ALT; break;
      case "⌥": mods = mods | KM_MOD_ALT; break;
      case "WIN": mods = mods | KM_MOD_META; break;
      case "META": mods = mods | KM_MOD_META; break;
      case "SUPER": mods = mods | KM_MOD_META; break;
      default: return { mods: 0, key: "" };
    }
  }
  const key = kmNormKey(parts[parts.length - 1]);
  return { mods, key };
}

function kmModNames(mods: i32, mac: bool): string[] {
  let out: string[] = [];
  if ((mods & KM_MOD_CTRL) != 0) {
    if (mac) {
      out.push("Cmd");
    } else {
      out.push("Ctrl");
    }
  }
  if ((mods & KM_MOD_ALT) != 0) {
    if (mac) {
      out.push("Option");
    } else {
      out.push("Alt");
    }
  }
  if ((mods & KM_MOD_SHIFT) != 0) {
    out.push("Shift");
  }
  if ((mods & KM_MOD_META) != 0) {
    if (mac) {
      out.push("Control");
    } else {
      out.push("Win");
    }
  }
  return out;
}

// 画面に出す表記。sep は "+"（文の中・メニュー）か " "（キーの札）。layout で刻印を選ぶ。
// Mac では Ctrl を Cmd、Alt を Option と書く。
export function kmChordText(c: KmChord, mac: bool, layout: i32, sep: string): string {
  if (c.key.length == 0) {
    return "";
  }
  let s = "";
  const names = kmModNames(c.mods, mac);
  for (const n of names) {
    s = s + n + sep;
  }
  return s + kmKeyCap(c.key, layout);
}

// 保存に使う表記（配列によらない US の名前。Mac でも "Ctrl"）。kmParseChord で読み戻せる。
export function kmChordStore(c: KmChord): string {
  if (c.key.length == 0) {
    return "";
  }
  let s = "";
  const names = kmModNames(c.mods, false);
  for (const n of names) {
    s = s + n + "+";
  }
  return s + c.key;
}

// uikit の修飾キーのビット（UK_MOD_*）を論理の修飾キーにする。Mac では Cmd（UK_MOD_META）が主、Control が META。
export function kmEventMods(ukMods: i32, mac: bool): i32 {
  if (!mac) {
    return ukMods & 15;
  }
  let m = ukMods & (KM_MOD_SHIFT | KM_MOD_ALT);
  if ((ukMods & 8) != 0) {
    m = m | KM_MOD_CTRL;
  }
  if ((ukMods & 2) != 0) {
    m = m | KM_MOD_META;
  }
  return m;
}

// uikit のキーの値（UK_KEY_*。文字は 4096 + 符号位置、F キーは 100 + n）を US の位置の名前にする。
export function kmKeyFromUk(k: i32, layout: i32): string {
  if (k >= 4096) {
    return kmKeyFromChar(k - 4096, layout);
  }
  if (k > 100 && k <= 124) {
    return "F" + `${k - 100}`;
  }
  switch (k) {
    case 1: return "Tab";
    case 2: return "Enter";
    case 3: return "Esc";
    case 4: return "Backspace";
    case 5: return "Delete";
    case 6: return "Left";
    case 7: return "Right";
    case 8: return "Up";
    case 9: return "Down";
    case 10: return "Home";
    case 11: return "End";
    case 12: return "PageUp";
    case 13: return "PageDown";
    case 14: return "Space";
  }
  return "";
}

// 1 つのキーの出来事を組み合わせにする（Shift で変わった記号も元のキーに戻る）。
export function kmEventChord(ukKey: i32, ukMods: i32, mac: bool, layout: i32): KmChord {
  return { mods: kmEventMods(ukMods, mac), key: kmKeyFromUk(ukKey, layout) };
}

// ---- コマンドの表 ----

function kmCmd(out: mut KmCommand[], id: string, group: string, cat: i32, ctx: string, row: string): void {
  out.push({ id: id.clone(), group: group.clone(), cat, ctx: ctx.clone(), row: row.clone() });
}

// 分類の並び（一覧の表の順）
export function kmGroups(): string[] {
  return ["play", "mark", "tool", "edit", "trim", "view", "file", "ai"];
}

// すべてのコマンド。名前は i18n の "cmd.<id>"（キーボードの絵の短い名前は "keycap.<id>"。なければ "cmd.<id>"）。
export function kmCommands(): KmCommand[] {
  let o: KmCommand[] = [];
  const P = KM_CAT_PLAY;
  const MK = KM_CAT_MARK;
  const T = KM_CAT_TOOL;
  const R = KM_CAT_RIPPLE;
  const O = KM_CAT_OVER;
  const V = KM_CAT_VIEW;
  // 再生と移動
  kmCmd(mut o, "play.toggle", "play", P, "", "play.toggle");
  kmCmd(mut o, "play.reverse", "play", P, "", "play.jkl");
  kmCmd(mut o, "play.stop", "play", P, "", "play.jkl");
  kmCmd(mut o, "play.forward", "play", P, "", "play.jkl");
  kmCmd(mut o, "playhead.stepBack", "play", P, "", "playhead.step");
  kmCmd(mut o, "playhead.stepForward", "play", P, "", "playhead.step");
  kmCmd(mut o, "playhead.step10Back", "play", P, "", "playhead.step10");
  kmCmd(mut o, "playhead.step10Forward", "play", P, "", "playhead.step10");
  kmCmd(mut o, "playhead.back1s", "play", P, "", "playhead.1s");
  kmCmd(mut o, "playhead.forward1s", "play", P, "", "playhead.1s");
  kmCmd(mut o, "playhead.prevEdit", "play", P, "", "playhead.edit");
  kmCmd(mut o, "playhead.nextEdit", "play", P, "", "playhead.edit");
  kmCmd(mut o, "playhead.start", "play", P, "", "playhead.ends");
  kmCmd(mut o, "playhead.end", "play", P, "", "playhead.ends");
  kmCmd(mut o, "playhead.goto", "play", P, "", "playhead.goto");
  kmCmd(mut o, "playhead.toIn", "play", P, "", "playhead.inout");
  kmCmd(mut o, "playhead.toOut", "play", P, "", "playhead.inout");
  kmCmd(mut o, "play.aroundEdit", "play", P, "", "play.aroundEdit");
  kmCmd(mut o, "play.inToOut", "play", P, "", "play.inToOut");
  // 印
  kmCmd(mut o, "mark.in", "mark", MK, "", "mark.inout");
  kmCmd(mut o, "mark.out", "mark", MK, "", "mark.inout");
  kmCmd(mut o, "mark.clip", "mark", MK, "", "mark.clip");
  kmCmd(mut o, "mark.clearIn", "mark", MK, "", "mark.clear");
  kmCmd(mut o, "mark.clearOut", "mark", MK, "", "mark.clear");
  kmCmd(mut o, "mark.clearBoth", "mark", MK, "", "mark.clear");
  kmCmd(mut o, "marker.add", "mark", MK, "", "marker.add");
  kmCmd(mut o, "playhead.nextMarker", "mark", P, "", "playhead.marker");
  kmCmd(mut o, "playhead.prevMarker", "mark", P, "", "playhead.marker");
  kmCmd(mut o, "marker.delete", "mark", MK, "", "marker.remove");
  kmCmd(mut o, "marker.clearAll", "mark", MK, "", "marker.remove");
  // ツール
  kmCmd(mut o, "tool.select", "tool", T, "", "tool.select");
  kmCmd(mut o, "tool.trim", "tool", T, "", "tool.trim");
  kmCmd(mut o, "trim.mode.ripple", "tool", T, "", "trim.mode");
  kmCmd(mut o, "trim.mode.roll", "tool", T, "", "trim.mode");
  kmCmd(mut o, "trim.mode.slip", "tool", T, "", "trim.mode");
  kmCmd(mut o, "trim.mode.slide", "tool", T, "", "trim.mode");
  kmCmd(mut o, "tool.blade", "tool", T, "", "tool.blade");
  kmCmd(mut o, "tool.hand", "tool", T, "", "tool.hand");
  // 編集
  kmCmd(mut o, "edit.split", "edit", V, "", "edit.split");
  kmCmd(mut o, "edit.splitAll", "edit", V, "", "edit.splitAll");
  kmCmd(mut o, "edit.lift", "edit", O, "", "edit.lift");
  kmCmd(mut o, "edit.rippleDelete", "edit", R, "", "edit.rippleDelete");
  kmCmd(mut o, "edit.liftRange", "edit", O, "", "edit.liftRange");
  kmCmd(mut o, "edit.extract", "edit", R, "", "edit.extract");
  kmCmd(mut o, "edit.rippleTrimStart", "edit", R, "", "edit.rippleTrim");
  kmCmd(mut o, "edit.rippleTrimEnd", "edit", R, "", "edit.rippleTrim");
  kmCmd(mut o, "edit.trimStart", "edit", O, "", "edit.trim");
  kmCmd(mut o, "edit.trimEnd", "edit", O, "", "edit.trim");
  kmCmd(mut o, "edit.insert", "edit", R, "", "edit.insert");
  kmCmd(mut o, "edit.overwrite", "edit", O, "", "edit.overwrite");
  kmCmd(mut o, "edit.replace", "edit", O, "", "edit.place");
  kmCmd(mut o, "edit.placeOnTop", "edit", O, "", "edit.place");
  kmCmd(mut o, "edit.append", "edit", V, "", "edit.place");
  kmCmd(mut o, "clip.nudgeBack", "edit", O, "", "clip.nudge");
  kmCmd(mut o, "clip.nudgeForward", "edit", O, "", "clip.nudge");
  kmCmd(mut o, "clip.nudge10Back", "edit", O, "", "clip.nudge10");
  kmCmd(mut o, "clip.nudge10Forward", "edit", O, "", "clip.nudge10");
  kmCmd(mut o, "source.match", "edit", MK, "", "source.match");
  kmCmd(mut o, "source.reverseMatch", "edit", MK, "", "source.reverseMatch");
  kmCmd(mut o, "clip.link", "edit", V, "", "clip.link");
  kmCmd(mut o, "clip.speed", "edit", V, "", "clip.speed");
  kmCmd(mut o, "clip.rename", "edit", V, "", "clip.rename");
  kmCmd(mut o, "clip.renameId", "edit", V, "", "clip.renameId");
  kmCmd(mut o, "clip.enable", "edit", V, "", "clip.enable");
  kmCmd(mut o, "clip.gain", "edit", V, "", "clip.gain");
  kmCmd(mut o, "clip.transition", "edit", V, "", "clip.transition");
  kmCmd(mut o, "clip.revealInPool", "edit", V, "", "clip.revealInPool");
  kmCmd(mut o, "edit.cut", "edit", V, "", "edit.clipboard");
  kmCmd(mut o, "edit.copy", "edit", V, "", "edit.clipboard");
  kmCmd(mut o, "edit.paste", "edit", V, "", "edit.clipboard");
