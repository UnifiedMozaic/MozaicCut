  kmB(mut o, c, "file.open", "Ctrl+O");
  kmB(mut o, c, "file.save", "Ctrl+S");
  kmB(mut o, c, "file.saveAs", "Ctrl+Shift+S");
  kmB(mut o, c, "app.quit", "Ctrl+Q");
  kmB(mut o, c, "media.import", "Ctrl+I");
  kmB(mut o, c, "text.reveal", "Ctrl+E");
  kmB(mut o, c, "history.copy", "Ctrl+Shift+C");
  kmB(mut o, c, "history.copyJson", "Ctrl+Alt+C");
  kmB(mut o, c, "view.focusMode", "Ctrl+Shift+F");
  kmB(mut o, c, "view.monitors", "Shift+2");
  kmB(mut o, c, "panel.inspector", "Ctrl+Alt+I");
  kmB(mut o, c, "panel.history", "Ctrl+Alt+H");
  kmB(mut o, c, "view.cleanViewer", "Ctrl+Shift+H");
