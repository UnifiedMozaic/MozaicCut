  kmB(mut o, c, "clip.nudge10Forward", "Alt+Shift+Right");
  kmB(mut o, c, "source.match", "F");
  kmB(mut o, c, "clip.rename", "F2");
  kmB(mut o, c, "clip.renameId", "Shift+F2");
  kmB(mut o, c, "subtitle.add", "Shift+T");
  kmB(mut o, c, "edit.copy", "Ctrl+C");
  kmB(mut o, c, "edit.cut", "Ctrl+X");
  kmB(mut o, c, "edit.paste", "Ctrl+V");
  kmB(mut o, c, "edit.pasteInsert", "Ctrl+Shift+V");
  kmB(mut o, c, "edit.selectAll", "Ctrl+A");
  kmB(mut o, c, "edit.deselectAll", "Ctrl+Shift+A");
  kmB(mut o, c, "trim.commit", "Enter");
  kmB(mut o, c, "trim.cancel", "Esc");
  kmB(mut o, c, "view.linkedSelection", "Ctrl+Shift+L");
  kmB(mut o, c, "view.refs", "Ctrl+Shift+R");
  kmB(mut o, c, "undo", "Ctrl+Z");
  kmB(mut o, c, "redo", "Ctrl+Shift+Z / Ctrl+Y");
