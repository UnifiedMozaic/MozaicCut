// 標準・Premiere・Resolve の 3 つに共通で、0.x にはないもの
function kmModern(o: mut KmBinding[], c: KmCommand[]): void {
  kmB(mut o, c, "play.reverse", "J");
  kmB(mut o, c, "play.stop", "K");
  kmB(mut o, c, "play.forward", "L");
  kmB(mut o, c, "edit.lift", "Delete / Backspace");
  kmB(mut o, c, "edit.rippleDelete", "Shift+Delete");
}

export function kmPresetBindings(p: i32, c: KmCommand[]): KmBinding[] {
  let o: KmBinding[] = [];
  kmCommon(mut o, c);
  if (p == KM_PRESET_LEGACY) {
    // いまの editor.um の割り当て（移行のために 1 版だけ残す）
    kmB(mut o, c, "playhead.back1s", "J");
    kmB(mut o, c, "playhead.forward1s", "L");
    kmB(mut o, c, "play.stop", "K");
    kmB(mut o, c, "edit.split", "S");
    kmB(mut o, c, "view.fit", "F");
    kmB(mut o, c, "edit.rippleDelete", "Delete / Backspace");
    kmB(mut o, c, "keymap.open", "Ctrl+/");
    kmB(mut o, c, "palette.open", "Ctrl+K");
    kmB(mut o, c, "menu.open", "F10");
    // F は全体（マッチフレームは割り当てなし）
    let keep: KmBinding[] = [];
    for (const b of o) {
      if (!(b.cmd == "source.match")) {
        keep.push({ cmd: b.cmd.clone(), chord: kmChord(b.chord.mods, b.chord.key), ctx: b.ctx.clone() });
      }
    }
    return keep;
  }
  kmModern(mut o, c);
  if (p == KM_PRESET_PREMIERE) {
    kmB(mut o, c, "play.aroundEdit", "Shift+K");
    kmB(mut o, c, "play.inToOut", "Ctrl+Shift+Space");
    kmB(mut o, c, "mark.clearIn", "Ctrl+Shift+I");
    kmB(mut o, c, "mark.clearOut", "Ctrl+Shift+O");
    kmB(mut o, c, "mark.clearBoth", "Ctrl+Shift+X");
    kmB(mut o, c, "playhead.nextMarker", "Shift+M");
    kmB(mut o, c, "playhead.prevMarker", "Ctrl+Shift+M");
    kmB(mut o, c, "tool.select", "V");
    kmB(mut o, c, "trim.mode.ripple", "B");
    kmB(mut o, c, "trim.mode.roll", "N");
    kmB(mut o, c, "trim.mode.slip", "Y");
    kmB(mut o, c, "trim.mode.slide", "U");
    kmB(mut o, c, "tool.blade", "C");
    kmB(mut o, c, "edit.split", "Ctrl+K");
    kmB(mut o, c, "edit.splitAll", "Ctrl+Shift+K");
    kmB(mut o, c, "edit.liftRange", ";");
    kmB(mut o, c, "edit.extract", "'");
    kmB(mut o, c, "edit.rippleTrimStart", "Q");
    kmB(mut o, c, "edit.rippleTrimEnd", "W");
    kmB(mut o, c, "edit.trimStart", "Alt+Q");
    kmB(mut o, c, "edit.trimEnd", "Alt+W");
    kmB(mut o, c, "edit.insert", ",");
    kmB(mut o, c, "edit.overwrite", ".");
    kmB(mut o, c, "source.reverseMatch", "Shift+R");
    kmB(mut o, c, "clip.link", "Ctrl+L");
    kmB(mut o, c, "clip.speed", "Ctrl+R");
    kmB(mut o, c, "clip.enable", "Shift+E");
    kmB(mut o, c, "trim.nudgeBack", "Ctrl+Left");
    kmB(mut o, c, "trim.nudgeForward", "Ctrl+Right");
    kmB(mut o, c, "trim.nudge10Back", "Ctrl+Shift+Left");
    kmB(mut o, c, "trim.nudge10Forward", "Ctrl+Shift+Right");
    kmB(mut o, c, "trim.side", "Ctrl+T");
    kmB(mut o, c, "view.snap", "S");
    kmB(mut o, c, "view.zoomIn", "=");
    kmB(mut o, c, "view.zoomOut", "-");
    kmB(mut o, c, "view.fit", "\\");
    kmB(mut o, c, "view.videoTracksTaller", "Shift+=");
    kmB(mut o, c, "view.videoTracksShorter", "Shift+-");
    kmB(mut o, c, "view.audioTracksTaller", "Ctrl+Shift+=");
    kmB(mut o, c, "view.audioTracksShorter", "Ctrl+Shift+-");
    kmB(mut o, c, "palette.open", "Ctrl+Shift+P");
    kmB(mut o, c, "export.open", "Ctrl+M");
    kmB(mut o, c, "workspace.edit", "Alt+Shift+1");
    kmB(mut o, c, "workspace.color", "Alt+Shift+2");
    kmB(mut o, c, "workspace.audio", "Alt+Shift+3");
    kmB(mut o, c, "workspace.export", "Alt+Shift+4");
    kmB(mut o, c, "view.resetLayout", "Alt+Shift+0");
    kmB(mut o, c, "view.maximizePanel", "`");
    kmB(mut o, c, "menu.open", "F10");
    kmB(mut o, c, "keymap.open", "Ctrl+Alt+K");
    return o;
  }
  if (p == KM_PRESET_RESOLVE) {
    kmB(mut o, c, "play.aroundEdit", "/");
    kmB(mut o, c, "play.inToOut", "Alt+/");
    kmB(mut o, c, "mark.clearIn", "Alt+I");
    kmB(mut o, c, "mark.clearOut", "Alt+O");
    kmB(mut o, c, "mark.clearBoth", "Alt+X");
    kmB(mut o, c, "playhead.nextMarker", "Shift+Down");
    kmB(mut o, c, "playhead.prevMarker", "Shift+Up");
    kmB(mut o, c, "tool.select", "A");
    kmB(mut o, c, "tool.trim", "T");
    kmB(mut o, c, "tool.blade", "B");
    kmB(mut o, c, "edit.split", "Ctrl+B / Ctrl+\\");
    kmB(mut o, c, "edit.splitAll", "Ctrl+Shift+B");
    kmB(mut o, c, "edit.rippleDelete", "Shift+Backspace");
    kmB(mut o, c, "edit.extract", "Ctrl+Shift+Delete");
    kmB(mut o, c, "edit.rippleTrimStart", "Ctrl+Shift+[");
    kmB(mut o, c, "edit.rippleTrimEnd", "Ctrl+Shift+]");
    kmB(mut o, c, "edit.trimStart", "Shift+[");
    kmB(mut o, c, "edit.trimEnd", "Shift+]");
    kmB(mut o, c, "edit.insert", "F9");
    kmB(mut o, c, "edit.overwrite", "F10");
    kmB(mut o, c, "edit.replace", "F11");
    kmB(mut o, c, "edit.placeOnTop", "F12");
    kmB(mut o, c, "edit.append", "Shift+F12");
    kmB(mut o, c, "source.reverseMatch", "Shift+F");
    kmB(mut o, c, "clip.link", "Ctrl+Alt+L");
    kmB(mut o, c, "clip.speed", "R");
    kmB(mut o, c, "clip.enable", "D");
    kmB(mut o, c, "trim.nudgeBack", ",");
    kmB(mut o, c, "trim.nudgeForward", ".");
    kmB(mut o, c, "trim.nudge10Back", "Shift+,");
    kmB(mut o, c, "trim.nudge10Forward", "Shift+.");
    kmB(mut o, c, "trim.side", "U");
    kmB(mut o, c, "view.snap", "N");
    kmB(mut o, c, "view.zoomIn", "Ctrl+=");
    kmB(mut o, c, "view.zoomOut", "Ctrl+-");
    kmB(mut o, c, "view.fit", "Shift+Z");
    kmB(mut o, c, "view.rubberBands", "Ctrl+Shift+K");
    kmB(mut o, c, "palette.open", "Ctrl+K");
    kmB(mut o, c, "export.open", "Ctrl+Shift+M");
    kmB(mut o, c, "workspace.edit", "Alt+1");
    kmB(mut o, c, "workspace.color", "Alt+2");
    kmB(mut o, c, "workspace.audio", "Alt+3");
    kmB(mut o, c, "workspace.export", "Alt+4");
    kmB(mut o, c, "view.resetLayout", "Ctrl+Alt+0");
    kmB(mut o, c, "view.maximizePanel", "Ctrl+Shift+Enter");
    // F10 は上書きに使うので、メニューは Alt だけで開く（報告済み）
    kmB(mut o, c, "keymap.open", "Ctrl+Alt+K");
    return o;
  }
  // 標準
  kmB(mut o, c, "play.aroundEdit", "/");
  kmB(mut o, c, "play.inToOut", "Ctrl+Shift+Space");
  kmB(mut o, c, "mark.clearIn", "Alt+I");
  kmB(mut o, c, "mark.clearOut", "Alt+O");
  kmB(mut o, c, "mark.clearBoth", "Alt+X");
  kmB(mut o, c, "playhead.nextMarker", "Shift+M");
  kmB(mut o, c, "playhead.prevMarker", "Ctrl+Shift+M");
  kmB(mut o, c, "tool.select", "V");
  kmB(mut o, c, "tool.trim", "T");
  kmB(mut o, c, "tool.blade", "B");
  kmB(mut o, c, "edit.split", "Ctrl+B");
  kmB(mut o, c, "edit.splitAll", "Ctrl+Shift+B");
  kmB(mut o, c, "edit.liftRange", "Ctrl+Delete");
  kmB(mut o, c, "edit.extract", "Ctrl+Shift+Delete");
  kmB(mut o, c, "edit.rippleTrimStart", "Q");
  kmB(mut o, c, "edit.rippleTrimEnd", "W");
  kmB(mut o, c, "edit.trimStart", "Alt+Q");
  kmB(mut o, c, "edit.trimEnd", "Alt+W");
  kmB(mut o, c, "edit.insert", ",");
  kmB(mut o, c, "edit.overwrite", ".");
  kmB(mut o, c, "edit.replace", "Shift+F11");
  kmB(mut o, c, "edit.placeOnTop", "F12");
  kmB(mut o, c, "edit.append", "Shift+F12");
  kmB(mut o, c, "source.reverseMatch", "Shift+F");
  kmB(mut o, c, "clip.link", "Ctrl+L");
  kmB(mut o, c, "clip.speed", "Ctrl+R");
  kmB(mut o, c, "clip.enable", "Shift+E");
  kmB(mut o, c, "trim.nudgeBack", ",");
  kmB(mut o, c, "trim.nudgeForward", ".");
  kmB(mut o, c, "trim.nudge10Back", "Shift+,");
  kmB(mut o, c, "trim.nudge10Forward", "Shift+.");
  kmB(mut o, c, "trim.side", "U");
  kmB(mut o, c, "view.snap", "N");
  kmB(mut o, c, "view.zoomIn", "=");
  kmB(mut o, c, "view.zoomOut", "-");
  kmB(mut o, c, "view.fit", "Shift+Z / \\");
  kmB(mut o, c, "view.videoTracksTaller", "Shift+=");
  kmB(mut o, c, "view.videoTracksShorter", "Shift+-");
  kmB(mut o, c, "view.audioTracksTaller", "Ctrl+Shift+=");
  kmB(mut o, c, "view.audioTracksShorter", "Ctrl+Shift+-");
  kmB(mut o, c, "view.rubberBands", "Ctrl+Shift+K");
  kmB(mut o, c, "palette.open", "Ctrl+K");
  kmB(mut o, c, "export.open", "Ctrl+M");
  kmB(mut o, c, "workspace.edit", "Alt+1");
  kmB(mut o, c, "workspace.color", "Alt+2");
  kmB(mut o, c, "workspace.audio", "Alt+3");
  kmB(mut o, c, "workspace.export", "Alt+4");
  kmB(mut o, c, "view.resetLayout", "Ctrl+Alt+0");
  kmB(mut o, c, "view.maximizePanel", "Ctrl+Shift+Enter");
  kmB(mut o, c, "menu.open", "F10");
  kmB(mut o, c, "keymap.open", "Ctrl+/");
  return o;
}

function kmCopyBinds(bs: KmBinding[]): KmBinding[] {
  let out: KmBinding[] = [];
  for (const b of bs) {
    out.push({ cmd: b.cmd.clone(), chord: kmChord(b.chord.mods, b.chord.key), ctx: b.ctx.clone() });
  }
  return out;
}

export function kmMapNew(preset: i32, cmds: KmCommand[]): KmMap {
  return { preset, binds: kmPresetBindings(preset, cmds) };
}

export function kmMapClone(m: KmMap): KmMap {
  return { preset: m.preset, binds: kmCopyBinds(m.binds) };
}

// ---- 引く ----

// コマンドに割り当てたキー（割り当ての順）
export function kmChordsFor(m: KmMap, cmd: string): KmChord[] {
  let out: KmChord[] = [];
  for (const b of m.binds) {
    if (b.cmd == cmd) {
      out.push(kmChord(b.chord.mods, b.chord.key));
    }
  }
  return out;
}

// メニュー・ツールチップ・コマンドパレットに並べる表記（最初の 1 つ。なければ ""）。
export function kmShortcutText(m: KmMap, cmd: string, mac: bool, layout: i32): string {
  for (const b of m.binds) {
    if (b.cmd == cmd) {
      return kmChordText(b.chord, mac, layout, "+");
    }
  }
  return "";
}

// 押したキーのコマンド。ctxs は今の文脈（具体的なものから順。例 ["trim"]）。どれにもなければ "" の文脈を見る。
export function kmLookup(m: KmMap, c: KmChord, ctxs: string[]): string {
  for (const cx of ctxs) {
    for (const b of m.binds) {
      if (b.ctx == cx && kmChordEq(b.chord, c)) {
        return b.cmd.clone();
      }
    }
  }
  for (const b of m.binds) {
    if (b.ctx.length == 0 && kmChordEq(b.chord, c)) {
      return b.cmd.clone();
    }
  }
  return "";
}

// uikit のキーの出来事から直に引く（IME がオンでも、スキャンコードが来るまでは文字から位置を戻す）。
export function kmLookupEvent(m: KmMap, ukKey: i32, ukMods: i32, mac: bool, layout: i32, ctxs: string[]): string {
  const c = kmEventChord(ukKey, ukMods, mac, layout);
  if (c.key.length == 0) {
    return "";
  }
  return kmLookup(m, c, ctxs);
}

// 同じ文脈で同じキーが別のコマンドに当たっている組をすべて返す。
export function kmConflicts(m: KmMap): KmConflict[] {
  let out: KmConflict[] = [];
  for (let i: usize = 0; i < m.binds.length; i++) {
    for (let j: usize = i + 1; j < m.binds.length; j++) {
      if (m.binds[i].ctx == m.binds[j].ctx && m.binds[i].cmd != m.binds[j].cmd && kmChordEq(m.binds[i].chord, m.binds[j].chord)) {
        out.push({
          chord: kmChord(m.binds[i].chord.mods, m.binds[i].chord.key), ctx: m.binds[i].ctx.clone(),
          a: m.binds[i].cmd.clone(), b: m.binds[j].cmd.clone(),
        });
      }
    }
  }
  return out;
}

// cmd に c を割り当てると外れるコマンド（同じ文脈で c を使っているもの）。
export function kmAssignVictims(m: KmMap, cmds: KmCommand[], cmd: string, c: KmChord): string[] {
  const ci = kmFindCommand(cmds, cmd);
  let ctx = "";
  if (ci >= 0) {
    ctx = cmds[ci as usize].ctx.clone();
  }
  let out: string[] = [];
  for (const b of m.binds) {
    if (b.ctx == ctx && b.cmd != cmd && kmChordEq(b.chord, c)) {
      out.push(b.cmd.clone());
    }
  }
  return out;
}

// cmd に c を割り当てる。同じ文脈で c を使っていたコマンドからは外す。keepOld が false なら cmd の前のキーも外す。
export function kmAssign(m: mut KmMap, cmds: KmCommand[], cmd: string, c: KmChord, keepOld: bool): void {
  const ci = kmFindCommand(cmds, cmd);
  let ctx = "";
  if (ci >= 0) {
    ctx = cmds[ci as usize].ctx.clone();
  }
  let out: KmBinding[] = [];
  for (const b of m.binds) {
    const same = b.ctx == ctx && kmChordEq(b.chord, c);
    const mineOld = b.cmd == cmd && !keepOld;
    if (!same && !mineOld) {
      out.push({ cmd: b.cmd.clone(), chord: kmChord(b.chord.mods, b.chord.key), ctx: b.ctx.clone() });
    }
  }
  out.push({ cmd: cmd.clone(), chord: kmChord(c.mods, c.key), ctx });
  m.binds = out;
}

// cmd のキーをすべて外す。
export function kmUnassign(m: mut KmMap, cmd: string): void {
  let out: KmBinding[] = [];
  for (const b of m.binds) {
    if (b.cmd != cmd) {
      out.push({ cmd: b.cmd.clone(), chord: kmChord(b.chord.mods, b.chord.key), ctx: b.ctx.clone() });
    }
  }
  m.binds = out;
}

// キーボードの絵の 1 つのキー: 修飾キー mods と key に当たるコマンド。"" の文脈を先に、なければほかの文脈の最初のもの。
export function kmCommandOnKey(m: KmMap, mods: i32, key: string): string {
  let other = "";
  for (const b of m.binds) {
    if (b.chord.mods == mods && b.chord.key == key) {
      if (b.ctx.length == 0) {
        return b.cmd.clone();
      }
      if (other.length == 0) {
        other = b.cmd.clone();
      }
    }
  }
  return other;
}

// ---- 利用者が変えた割り当て（JSON） ----
//
// 形: {"version": 1, "preset": "standard", "bindings": [{"command": "export.open", "keys": ["Ctrl+E"]}, ...]}
// bindings に書いたコマンドだけ、プリセットのキーを置き換える（"keys": [] は割り当てなし）。
// 書き出し（kmExportJson）はすべてのコマンドを書くので、読み込めばそのまま同じ割り当てになる。

function kmJsonEsc(s: string): string {
  let out: u8[] = [];
  for (let i: usize = 0; i < s.length; i++) {
    const c = s[i];
    if (c == 34 || c == 92) {
      out.push(92);
    }
    out.push(c);
  }
  return stringFromBytes(out);
}

function kmSameChords(a: KmChord[], b: KmChord[]): bool {
  if (a.length != b.length) {
    return false;
  }
  for (let i: usize = 0; i < a.length; i++) {
    if (!kmChordEq(a[i], b[i])) {
      return false;
    }
  }
  return true;
}

function kmJsonLine(cmd: string, cs: KmChord[]): string {
  let s = `    {"command": "${kmJsonEsc(cmd)}", "keys": [`;
  for (let i: usize = 0; i < cs.length; i++) {
    if (i > 0) {
      s = s + ", ";
    }
    s = s + "\"" + kmJsonEsc(kmChordStore(cs[i])) + "\"";
  }
  return s + "]}";
}

function kmJsonDoc(preset: i32, lines: string[]): string {
  let s = "{\n  \"version\": 1,\n  \"preset\": \"" + kmPresetId(preset) + "\",\n  \"bindings\": [\n";
  for (let i: usize = 0; i < lines.length; i++) {
    s = s + lines[i];
    if (i + 1 < lines.length) {
      s = s + ",";
    }
    s = s + "\n";
  }
  return s + "  ]\n}\n";
}

// プリセットから変えたコマンドだけを書く（設定の場所の keymap.json に保存する形）。
export function kmUserJson(m: KmMap, cmds: KmCommand[]): string {
  const base = kmMapNew(m.preset, cmds);
  let lines: string[] = [];
  for (const c of cmds) {
    const now = kmChordsFor(m, c.id);
    const was = kmChordsFor(base, c.id);
    if (!kmSameChords(now, was)) {
      lines.push(kmJsonLine(c.id, now));
    }
  }
  return kmJsonDoc(m.preset, lines);
}

// すべてのコマンドを書く（［書き出す（JSON）］）。
export function kmExportJson(m: KmMap, cmds: KmCommand[]): string {
  let lines: string[] = [];
  for (const c of cmds) {
    lines.push(kmJsonLine(c.id, kmChordsFor(m, c.id)));
  }
  return kmJsonDoc(m.preset, lines);
}

// 読んだ結果。errors は読めなかった所。言葉に依らない形で、"原因\t引数…"（"unknownCommand\t<ID>"、"badKey\t<キー>\t<ID>"）。
// 画面では kmsLoadErrorText（i18n の keymap.err.<原因>）で文にする。
export struct KmLoadResult {
  map: KmMap;
  applied: i32;
  errors: string[];
}

function kmJsonSkipWs(s: string, i0: usize): usize {
  let i = i0;
  while (i < s.length && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) {
    i++;
  }
  return i;
}

function kmJsonReadStr(s: string, i0: usize, end: mut usize[]): string {
  let out: u8[] = [];
  let i = i0 + 1;
  while (i < s.length && s[i] != 34) {
    if (s[i] == 92 && i + 1 < s.length) {
      i++;
    }
    out.push(s[i]);
    i++;
  }
  end[0] = i + 1;
  return stringFromBytes(out);
}

// 利用者の JSON を読み、プリセット（JSON の "preset"。なければ fallbackPreset）に重ねる。
export function kmLoadUser(json: string, cmds: KmCommand[], fallbackPreset: i32): KmLoadResult {
  // 1 回目: 字句を順に見て、"preset" と bindings の各要素を集める
  let preset = fallbackPreset;
  let ids: string[] = [];
  let keys: string[][] = [];
  let errors: string[] = [];
  let depth = 0;
  let lastKey = "";
  let expectKey = false;
  let inKeys = false;
  let curCmd = "";
  let curKeys: string[] = [];
  let haveKeys = false;
  let objDepth = -1;
  let end: usize[] = [0];
  let i = kmJsonSkipWs(json, 0);
  while (i < json.length) {
    const b = json[i];
    if (b == 123) {
      depth++;
      expectKey = true;
      if (depth == 2) {
        // bindings の要素（最上位の { が 1）
        objDepth = depth;
        curCmd = "";
        curKeys = [];
        haveKeys = false;
      }
      i++;
    } else if (b == 125) {
      if (depth == objDepth) {
        if (curCmd.length > 0 && haveKeys) {
          ids.push(curCmd.clone());
          let cp: string[] = [];
          for (const x of curKeys) {
            cp.push(x.clone());
          }
          keys.push(cp);
        }
        objDepth = -1;
      }
      depth--;
      i++;
    } else if (b == 91) {
      if (lastKey == "keys" && depth == objDepth) {
        inKeys = true;
        haveKeys = true;
      }
      i++;
    } else if (b == 93) {
      inKeys = false;
      i++;
    } else if (b == 44) {
      if (!inKeys) {
        expectKey = true;
      }
      i++;
    } else if (b == 58) {
      expectKey = false;
      i++;
    } else if (b == 34) {
      const str = kmJsonReadStr(json, i, mut end);
      i = end[0];
      if (inKeys) {
        curKeys.push(str.clone());
      } else if (expectKey) {
        lastKey = str.clone();
      } else {
        if (depth == 1 && lastKey == "preset") {
          preset = kmPresetFromId(str);
        } else if (depth == objDepth && lastKey == "command") {
          curCmd = str.clone();
        }
      }
    } else {
      i++;
    }
  }
  let m = kmMapNew(preset, cmds);
  let applied = 0;
  for (let k: usize = 0; k < ids.length; k++) {
    const id = ids[k].clone();
    if (kmFindCommand(cmds, id) < 0) {
      errors.push("unknownCommand\t" + id);
      continue;
    }
    kmUnassign(mut m, id);
    for (const ks of keys[k]) {
      const ch = kmParseChord(ks);
      if (ch.key.length == 0) {
        errors.push("badKey\t" + ks + "\t" + id);
        continue;
      }
      // 読み込みでは外さずに足す（重なりは kmConflicts で知らせる）
      const ci = kmFindCommand(cmds, id);
      m.binds.push({ cmd: id.clone(), chord: ch, ctx: cmds[ci as usize].ctx.clone() });
    }
    applied++;
  }
  return { map: m, applied, errors };
}

// ---- 探す ----

// 名前（日本語・英語）・ID・キーの表記のどれかに q を含むか（ASCII は大文字・小文字を無視）。
export function kmMatch(q: string, ja: string, en: string, id: string, keysText: string): bool {
  if (q.length == 0) {
    return true;
  }
  const u = kmUpper(q);
  return kmContains(ja, q) || kmContains(kmUpper(en), u) || kmContains(kmUpper(id), u) || kmContains(kmUpper(keysText), u);
}

function kmContains(s: string, q: string): bool {
  if (q.length == 0) {
    return true;
  }
  if (q.length > s.length) {
    return false;
  }
  for (let i: usize = 0; i + q.length <= s.length; i++) {
    let ok = true;
    for (let j: usize = 0; j < q.length; j++) {
      if (s[i + j] != q[j]) {
        ok = false;
        break;
      }
    }
    if (ok) {
      return true;
    }
  }
  return false;
}
