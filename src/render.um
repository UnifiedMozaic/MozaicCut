// ---- kernel ----
//
// 書き込み先のキャンバスに重ねる kernel（composite / fillRect / yuvComposite / rgbaComposite、textlayer.um の tlDraw）は、
// kernel が自分の [i] にしか書けないので、キャンバスの添字で dispatch して層の外はすぐ戻る。ただし dispatch の個数は
// 「層の下の端の行まで」（rowsCount）にして、それより下の行は実行しない。層の範囲が空なら dispatch しない。

kernel function clamp01(v: f32): f32 {
  return Math.min(Math.max(v, 0.0), 1.0);
}

kernel function clearCanvas(i: u32, canvas: mut Buffer<vec4<f32>>, color: vec4<f32>): void {
  canvas[i] = color;
}

// YUV 4:2:0（BT.709、リミテッドレンジ）の 1 コマの i 番目の画素を RGBA にする。rgb は 0..1 に収める。
// g の 2 つ目の引き算の前の Math.max（値は変えない）は、GPU のシェーダのコンパイラが (a - b) - c を a - (b + c) に
// まとめて丸めが変わる（CPU と 1 ULP ずれる）のを防ぐため。2026-11、wgpu-native v29 の Vulkan と Direct3D 12 の両方で起きた。
kernel function yuvPixel(yuv: Buffer<u8>, i: u32, w: u32, h: u32): vec4<f32> {
  const x = i % w;
  const y = i / w;
  const cw = w / 2;
  const ci = (y / 2) * cw + x / 2;
  const plane = w * h;
  const yv = (yuv[i] as i32) as f32;
  const uv = (yuv[plane + ci] as i32) as f32;
  const vv = (yuv[plane + plane / 4 + ci] as i32) as f32;
  const yy = (yv - 16.0) / 219.0;
  const cb = (uv - 128.0) / 224.0;
  const cr = (vv - 128.0) / 224.0;
  const r = yy + 1.5748 * cr;
  const g = Math.max(yy - 0.18732 * cb, -1.0e30) - 0.46812 * cr;
  const b = yy + 1.8556 * cb;
  return vec4(clamp01(r), clamp01(g), clamp01(b), 1.0);
}

// RGBA の 8 ビットの画素（PAM の本体）の i 番目を 0..1 の RGBA にする（ストレートアルファ）。
kernel function rgbaPixel(px: Buffer<u8>, i: u32): vec4<f32> {
  const k = i * 4;
  const r = ((px[k] as i32) as f32) / 255.0;
  const g = ((px[k + 1] as i32) as f32) / 255.0;
  const b = ((px[k + 2] as i32) as f32) / 255.0;
  const a = ((px[k + 3] as i32) as f32) / 255.0;
  return vec4(r, g, b, a);
}

// YUV の 1 コマを RGBA の層にする（効果を掛けるとき用）。
kernel function yuvToLayer(i: u32, layer: mut Buffer<vec4<f32>>, yuv: Buffer<u8>, w: u32, h: u32): void {
  layer[i] = yuvPixel(yuv, i, w, h);
}

// RGBA の 8 ビットの画素を層にする（効果を掛けるとき用）。
kernel function rgbaToLayer(i: u32, layer: mut Buffer<vec4<f32>>, px: Buffer<u8>): void {
  layer[i] = rgbaPixel(px, i);
}

kernel function blendOver(d: vec4<f32>, s: vec4<f32>, a: f32): vec4<f32> {
  return vec4(d.x + (s.x - d.x) * a, d.y + (s.y - d.y) * a, d.z + (s.z - d.z) * a, 1.0);
}

// 層を (lx, ly) に置いて重ねる。
kernel function composite(
  i: u32, canvas: mut Buffer<vec4<f32>>, layer: Buffer<vec4<f32>>,
  cw: u32, lx: i32, ly: i32, lw: i32, lh: i32, alpha: f32,
): void {
  const dx = ((i % cw) as i32) - lx;
  const dy = ((i / cw) as i32) - ly;
  if (dx < 0 || dy < 0 || dx >= lw || dy >= lh) {
    return;
  }
  const s = layer[(dy * lw + dx) as u32];
  canvas[i] = blendOver(canvas[i], s, s.w * alpha);
}

// 効果のない映像: YUV のコマを層に広げずに、その場で RGBA にして (lx, ly) に重ねる（yuvToLayer + composite と同じ値）。
kernel function yuvComposite(
  i: u32, canvas: mut Buffer<vec4<f32>>, yuv: Buffer<u8>,
  cw: u32, lx: i32, ly: i32, lw: i32, lh: i32, alpha: f32,
): void {
  const dx = ((i % cw) as i32) - lx;
  const dy = ((i / cw) as i32) - ly;
  if (dx < 0 || dy < 0 || dx >= lw || dy >= lh) {
    return;
  }
  const s = yuvPixel(yuv, (dy * lw + dx) as u32, lw as u32, lh as u32);
  canvas[i] = blendOver(canvas[i], s, s.w * alpha);
}

// 効果のない画像: RGBA の画素を層に広げずに (lx, ly) に重ねる（rgbaToLayer + composite と同じ値）。
kernel function rgbaComposite(
  i: u32, canvas: mut Buffer<vec4<f32>>, px: Buffer<u8>,
  cw: u32, lx: i32, ly: i32, lw: i32, lh: i32, alpha: f32,
): void {
  const dx = ((i % cw) as i32) - lx;
  const dy = ((i / cw) as i32) - ly;
  if (dx < 0 || dy < 0 || dx >= lw || dy >= lh) {
    return;
  }
  const s = rgbaPixel(px, (dy * lw + dx) as u32);
  canvas[i] = blendOver(canvas[i], s, s.w * alpha);
}

kernel function fillRect(
  i: u32, canvas: mut Buffer<vec4<f32>>, cw: u32, x0: i32, y0: i32, x1: i32, y1: i32, color: vec4<f32>, alpha: f32,
): void {
  const x = (i % cw) as i32;
  const y = (i / cw) as i32;
  if (x < x0 || y < y0 || x >= x1 || y >= y1) {
    return;
  }
  canvas[i] = blendOver(canvas[i], color, color.w * alpha);
}

kernel function toByte(v: f32): u8 {
  return (Math.min(Math.max(v + 0.5, 0.0), 255.0) as i32) as u8;
}

// キャンバスを YUV 4:2:0（BT.709、リミテッドレンジ）にする。色差は 2x2 の平均。
kernel function toYuv(i: u32, out: mut Buffer<u8>, canvas: Buffer<vec4<f32>>, w: u32, h: u32): void {
  const n = w * h;
  if (i < n) {
    const c = canvas[i];
    const l = 0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z;
    out[i] = toByte(16.0 + 219.0 * l);
    return;
  }
  const cw = w / 2;
  const q = cw * (h / 2);
  let j = i - n;
  let isV = false;
  if (j >= q) {
    j = j - q;
    isV = true;
  }
  const x = (j % cw) * 2;
  const y = (j / cw) * 2;
  const k = y * w + x;
  const c = (canvas[k] + canvas[k + 1] + canvas[k + w] + canvas[k + w + 1]) * 0.25;
  const l = 0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z;
  if (isV) {
    out[i] = toByte(128.0 + 224.0 * (c.x - l) / 1.5748);
  } else {
    out[i] = toByte(128.0 + 224.0 * (c.z - l) / 1.8556);
  }
}

// ---- CPU 側 ----

export function colorVec(c: u32): vec4<f32> {
  const r = ((c >> 24) & 255) as f32;
  const g = ((c >> 16) & 255) as f32;
  const b = ((c >> 8) & 255) as f32;
  const a = (c & 255) as f32;
  return vec4(r / 255, g / 255, b / 255, a / 255);
}

export function videoCachePath(cache: string, i: usize): string {
  return `${cache}/clip${i}.y4m`;
}

export function imageCachePath(cache: string, i: usize): string {
  return `${cache}/clip${i}.pam`;
}

export function audioCachePath(cache: string, i: usize): string {
  return `${cache}/clip${i}.pcm`;
}

// クリップごとの素材を開く（映像・画像のクリップだけ。ほかは mediaNone()）。mode は media.um の MEDIA_OPEN_*。
// 書き出しと preview は MEDIA_OPEN_BEST（loadMedia）、編集画面は MEDIA_OPEN_FAST。
// 使い終えたら releaseMedia で閉じる（FFmpeg の組み込みの展開器を返すため）。
export function loadMediaFor(p: Project, cache: string, mode: i32): MediaSource[] {
  let out: MediaSource[] = [];
  for (let i: usize = 0; i < p.clips.length; i++) {
    const kind = p.clips[i].kind;
    if (kind == KIND_VIDEO || kind == KIND_IMAGE) {
      out.push(mediaOpenClip(p, cache, i, kind, mode));
    } else {
      out.push(mediaNone());
    }
  }
  return out;
}

export function loadMedia(p: Project, cache: string): MediaSource[] {
  return loadMediaFor(p, cache, MEDIA_OPEN_BEST);
}

// loadMedia で開いた素材を閉じる。
export function releaseMedia(media: mut MediaSource[]): void {
  for (let i: usize = 0; i < media.length; i++) {
    mediaRelease(mut media[i]);
  }
}

// 素材が揃っているか。足りなければ説明を返す。
export function checkMedia(p: Project, media: MediaSource[], cache: string, from: f64, to: f64): string[] {
  let errs: string[] = [];
  for (let i: usize = 0; i < p.clips.length; i++) {
    const kind = p.clips[i].kind;
    const used = p.clips[i].at <= to && p.clips[i].at + p.clips[i].dur > from;
    if (used && (kind == KIND_VIDEO || kind == KIND_IMAGE) && !media[i].ok) {
      let path = videoCachePath(cache, i);
      if (kind == KIND_IMAGE) {
        path = imageCachePath(cache, i);
      }
      errs.push(`${p.clips[i].line} 行目: 展開した素材 '${path}' がないか壊れています（mozcut.mjs を通して実行してください）`);
    }
  }
  return errs;
}

// ---- 作業用の Buffer の置き場（フレームをまたいで使い回す） ----
// 層・効果の作業用・余白つきの層（vec4<f32>）と、素材の画素を写す Buffer（u8）は、毎コマ確保し直さずに使い回す
// （1280x720 の vec4<f32> は 14.7 MB。確保と 0 埋めに 2〜3 ms、GPU の経路では GPU 側の確保と送りも毎回かかる）。
// - 要る長さちょうどの Buffer を置き場から借り（takeV4 / takeU8）、使い終えたら返す（giveV4 / giveU8）。
//   長さが合うものがなければ新しく確保する。大きさが変わったときだけ作り直すことになる。
// - 返したものは、そのフレームのあいだは「使用中」に置き、次のフレームの始め（rcFrame）に置き場へ戻す。
//   同じフレームの 2 つのクリップが同じ Buffer を使わないので、GPU がまだ読んでいる素材を CPU が書き換えて待つことがない。
// - 借りた Buffer の中身は決まっていない（前に使ったときの値が残る）。借りた側がすべての要素を書いてから読む。
// - RC_KEEP_FRAMES フレーム使わなかったものは捨てる。数が RC_POOL_MAX を超えるか、vec4 の置き場の大きさの合計が
//   RC_POOL_V4_BYTES を超えたら、一番長く使っていないものから捨てる（GPU の経路では GPU 側にも同じ大きさの写しを持つ）。
// - 借りる・返すは関数の引数で受け渡す（RenderCache のフィールドを 2 つ同じ呼び出しに mut で渡すことは、UM の借用の
//   決まりでできないため。借りたものは呼ぶ側の変数になるので、fxApply(mut layer.b, mut tmp.b) のように渡せる）。

struct PoolV4 {
  b: Buffer<vec4<f32>>;
  used: i64;
}

struct PoolU8 {
  b: Buffer<u8>;
  used: i64;
}

const RC_KEEP_FRAMES: i64 = 30;
const RC_POOL_MAX: i32 = 24;
const RC_POOL_V4_BYTES: u64 = 256 * 1024 * 1024;

function v4PoolBytes(pool: PoolV4[]): u64 {
  let sum: u64 = 0;
  for (const e of pool) {
    sum += (e.b.length as u64) * 16;
  }
  return sum;
}

// 置き場から長さ n の Buffer を借りる（なければ確保する）。
function takeV4(rc: mut RenderCache, n: u32): PoolV4 {
  let k: i64 = -1;
  for (let i: usize = 0; i < rc.v4Free.length; i++) {
    if (rc.v4Free[i].b.length == n) {
      k = i as i64;
      break;
    }
  }
  if (k < 0) {
    return { b: new Buffer<vec4<f32>>(n), used: rc.frame };
  }
  // k 番目を取り出す（要素は移動できないので、後ろを一時の配列に移してから pop する）
  let rest: PoolV4[] = [];
  while ((rc.v4Free.length as i64) > k + 1) {
    rest.push(rc.v4Free.pop());
  }
  let e = rc.v4Free.pop();
  while (rest.length > 0) {
    rc.v4Free.push(rest.pop());
  }
  e.used = rc.frame;
  return e;
}

function giveV4(rc: mut RenderCache, e: own PoolV4): void {
  rc.v4Used.push(e);
}

function takeU8(rc: mut RenderCache, n: u32): PoolU8 {
  let k: i64 = -1;
  for (let i: usize = 0; i < rc.u8Free.length; i++) {
    if (rc.u8Free[i].b.length == n) {
      k = i as i64;
      break;
    }
  }
  if (k < 0) {
    return { b: new Buffer<u8>(n), used: rc.frame };
  }
  let rest: PoolU8[] = [];
  while ((rc.u8Free.length as i64) > k + 1) {
    rest.push(rc.u8Free.pop());
  }
  let e = rc.u8Free.pop();
  while (rest.length > 0) {
    rc.u8Free.push(rest.pop());
  }
  e.used = rc.frame;
  return e;
}

function giveU8(rc: mut RenderCache, e: own PoolU8): void {
  rc.u8Used.push(e);
}

// 置き場の v4 の Buffer を、長く使わないものとあふれたものを捨てて整える。
function trimV4(pool: mut PoolV4[], frame: i64): void {
  let i: usize = 0;
  while (i < pool.length) {
    if (frame - pool[i].used > RC_KEEP_FRAMES) {
      const last = pool.pop();
      if (i < pool.length) {
        pool[i] = last;
      }
    } else {
      i++;
    }
  }
  while ((pool.length as i32) > RC_POOL_MAX || (pool.length > 0 && v4PoolBytes(pool) > RC_POOL_V4_BYTES)) {
    let old: usize = 0;
    for (let j: usize = 1; j < pool.length; j++) {
      if (pool[j].used < pool[old].used) {
        old = j;
      }
    }
    const last = pool.pop();
    if (old < pool.length) {
      pool[old] = last;
    }
  }
}

function trimU8(pool: mut PoolU8[], frame: i64): void {
  let i: usize = 0;
  while (i < pool.length) {
    if (frame - pool[i].used > RC_KEEP_FRAMES) {
      const last = pool.pop();
      if (i < pool.length) {
        pool[i] = last;
      }
    } else {
      i++;
    }
  }
  while ((pool.length as i32) > RC_POOL_MAX) {
    let old: usize = 0;
    for (let j: usize = 1; j < pool.length; j++) {
      if (pool[j].used < pool[old].used) {
        old = j;
      }
    }
    const last = pool.pop();
    if (old < pool.length) {
      pool[old] = last;
    }
  }
}

// フレームの始めに呼ぶ。使用中のものを置き場に戻し、長く使わないものとあふれたものを捨てる。
function rcFrame(rc: mut RenderCache): void {
  rc.frame = rc.frame + 1;
  while (rc.v4Used.length > 0) {
    rc.v4Free.push(rc.v4Used.pop());
  }
  while (rc.u8Used.length > 0) {
    rc.u8Free.push(rc.u8Used.pop());
  }
  trimV4(mut rc.v4Free, rc.frame);
  trimU8(mut rc.u8Free, rc.frame);
}

// フレームをまたいで使い回すもの。呼ぶ側が newRenderCache() で 1 度だけ作り、renderFrame に毎回 mut で渡す。
// - text: 文字の画像（文字・大きさ・揃え・縁取り・フォントが同じなら作り直さない）
// - v4Free / v4Used / u8Free / u8Used: 作業用の Buffer の置き場（上の「作業用の Buffer の置き場」）
// - grade: 色の調整（grade.*）を焼いた表と読んだ .cube（gradelayer.um）
// - blendLut / blendTf: 描画モードの線形の光の表（project の blend.tf が変わったときだけ作り直す）
// - masks: クリップの番号ごとのマスク（マスクの行と層の大きさが同じなら作り直さない）
export struct RenderCache {
  text: TextLayerCache;
  grade: GradeCache;
  frame: i64;
  v4Free: PoolV4[];
  v4Used: PoolV4[];
  u8Free: PoolU8[];
  u8Used: PoolU8[];
  blendLut: MblLut;
  blendTf: u32;
  masks: MblMaskCache[];
  // shape の行の形の置き場（クリップの番号ごと。形・位置・時刻が同じコマは作り直さない）
  shape: ShapeCaches;
  // テキストアニメーターの字の並びとアトラス（文字・大きさ・縁取り・フォントが同じなら作り直さない）
  ta: TaCache;
  // パーティクルの状態（クリップごと。シミュレーションに関わる値が同じなら、時刻を進めるだけで作り直さない）
  pt: PtCache;
  // 3D レイヤーの画素を集めるアトラス（毎コマ空にして使い回す）と、重い場面の和の置き場（1 つ。pop / push で借りて返す。
  // t3Render に atlas と work を同じ rc から渡すと、同じ変数を mut と別の引数で渡すことになるため）
  t3atlas: T3Atlas;
  t3work: T3Work[];
}

export function newRenderCache(): RenderCache {
  return {
    text: newTextLayerCache(), grade: newGradeCache(), frame: 0, v4Free: [], v4Used: [], u8Free: [], u8Used: [],
    blendLut: mblNewLut(MBL_TF_DEFAULT), blendTf: MBL_TF_DEFAULT, masks: [], shape: newShapeCaches(), ta: newTaCache(),
    pt: ptNewCache(), t3atlas: t3AtlasNew(1 << 20), t3work: [t3WorkNew()],
  };
}

// 置き場にある Buffer の数（試験・計測用）。
export function renderCacheBuffers(rc: RenderCache): i32 {
  return (rc.v4Free.length + rc.v4Used.length + rc.u8Free.length + rc.u8Used.length) as i32;
}

// ---- 描画 ----

function envelope(t: f64, dur: f64, fin: f64, fout: f64): f64 {
  let a: f64 = 1;
  if (fin > 0) {
    a = Math.min(a, t / fin);
  }
  if (fout > 0) {
    a = Math.min(a, (dur - t) / fout);
  }
  return Math.min(Math.max(a, 0.0), 1.0);
}

export function audioEnvelope(c: Clip, t: f64): f64 {
  return envelope(t, c.dur, Math.max(c.fadeIn, c.afadeIn), Math.max(c.fadeOut, c.afadeOut));
}

// ---- キーフレーム ----

// クリップのキーフレーム（Clip.anims）を、クリップの始まりからの時刻 lt で評価して差し替えた写し。
// 位置（x / y / pos）は左上からの画素のまま（xAbs / yAbs が立っている）。数は範囲に丸め、色は 0〜1 に丸めてある。
// timeremap は素材の時刻なので、ここでは差し替えない（clipSourceTime）。
export function clipAt(c: Clip, lt: f64): Clip {
  let o = clipCopy(c);
  for (const a of c.anims) {
    if (a.key == "timeremap") {
      continue;
    }
    const v = animEval(a.track, lt);
    if (o.kind == KIND_SHAPE && shapeAnimType(a.key) >= 0) {
      clipShapeAnim(mut o, a.key, v, a.lo, a.hi);
      continue;
    }
    if (a.fx >= 0) {
      const x = animClamp(v[0], a.lo, a.hi) as f32;
      for (let s: usize = 0; s < o.fx.length; s++) {
        if (o.fx[s].effect == a.fx) {
          o.fx[s].params[a.param as usize] = x;
        }
      }
      continue;
    }
    switch (a.key) {
      case "x":
        o.x = v[0];
        break;
      case "y":
        o.y = v[0];
        break;
      case "pos":
        o.x = v[0];
        o.y = v[1];
        break;
      case "opacity":
        o.opacity = animClamp(v[0], 0, 1) as f32;
        break;
      case "color":
        o.color = animEvalColor(a.track, lt);
        break;
      case "volume":
      case "vol":
        o.volume = animClamp(v[0], 0, 10) as f32;
        break;
    }
  }
  return o;
}

// shape の行の形のキーのキーフレームの値を ShapeSpec に入れる。
function clipShapeAnim(o: mut Clip, key: string, v: f64[4], lo: f64, hi: f64): void {
  const x = animClamp(v[0], lo, hi);
  switch (key) {
    case "pos":
      o.shape.posSet = true;
      o.shape.posX = v[0];
      o.shape.posY = v[1];
      break;
    case "anchor":
      o.shape.anchorX = v[0];
      o.shape.anchorY = v[1];
      break;
    case "rotation":
      o.shape.rotation = v[0];
      break;
    case "repeatrot":
      o.shape.repRot = v[0];
      break;
    case "scale":
      o.shape.scaleX = x;
      o.shape.scaleY = x;
      break;
    case "trimstart":
      o.shape.trimStart = x;
      break;
    case "trimend":
      o.shape.trimEnd = x;
      break;
    case "trimoffset":
      o.shape.trimOffset = x;
      break;
    case "strokew":
      o.shape.strokeW = x;
      break;
    case "r":
      o.shape.r = x;
      break;
    case "inner":
      o.shape.inner = x;
      o.shape.innerSet = true;
      break;
    case "w":
      o.shape.w = x;
      break;
    case "h":
      o.shape.h = x;
      break;
    case "radius":
      o.shape.radius = x;
      break;
    case "repeatx":
      o.shape.repX = x;
      break;
    case "repeaty":
      o.shape.repY = x;
      break;
    case "repeatscale":
      o.shape.repScale = x;
      break;
  }
}

// クリップの始まりからの時刻 lt に見せる素材の時刻（秒）。timeremap があればその値、なければ in + lt。
export function clipSourceTime(c: Clip, lt: f64): f64 {
  for (const a of c.anims) {
    if (a.key == "timeremap") {
      return animRemapTime(a.track, lt);
    }
  }
  return lt + c.inPt;
}

// project の行の効果を、タイムラインの時刻 t のキーフレームの値にした写し。
function projectFxAt(p: Project, t: f64): FxUse[] {
  let out = p.fx.clone();
  for (const a of p.anims) {
    if (a.fx < 0) {
      continue;
    }
    const x = animClamp(animEval(a.track, t)[0], a.lo, a.hi) as f32;
    for (let s: usize = 0; s < out.length; s++) {
      if (out[s].effect == a.fx) {
        out[s].params[a.param as usize] = x;
      }
    }
  }
  return out;
}

// (x, y) に w × h で置く層について、キャンバスに重ねる kernel の dispatch の個数（層の下の端の行までの画素数）。
// 層がキャンバスと重ならなければ 0（dispatch しない）。
function rowsCount(p: Project, x: i32, y: i32, w: i32, h: i32): u32 {
  if (w <= 0 || h <= 0 || x >= p.width || y >= p.height || x + w <= 0 || y + h <= 0) {
    return 0;
  }
  const y1 = Math.min(y + h, p.height);
  return (y1 * p.width) as u32;
}

// クリップの効果（Clip.fx）を、行に書いた順に層に掛ける。作業用の tmp は 1 つ確保して使い回す。
// （1 回だけ掛けるとき用。renderFrame は置き場の tmp を渡して applyClipFxTmp を使う）
export function applyClipFx(layer: mut Buffer<vec4<f32>>, c: Clip, w: u32, h: u32): void {
  if (c.fx.length == 0) {
    return;
  }
  let tmp = new Buffer<vec4<f32>>(w * h);
  applyClipFxTmp(mut layer, mut tmp, c, w, h);
}

// クリップの効果を、作業用の tmp（長さ w * h 以上。中身は何でもよい）を使って掛ける。
export function applyClipFxTmp(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, c: Clip, w: u32, h: u32): void {
  for (const u of c.fx) {
    fxApply(u.effect, mut layer, mut tmp, w, h, u.params);
  }
}

// 効果が周りへ広がる画素数の合計（@reach。blur / sharpen など）。
function clipFxReach(c: Clip): i32 {
  let r = 0;
  for (const u of c.fx) {
    r = r + fxReach(u.effect, u.params);
  }
  return Math.min(r, 512);
}

// 層のまわりに pad 画素の透明な余白を足して写す。
kernel function padCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, pw: u32, w: i32, h: i32, pad: i32): void {
  const x = ((i % pw) as i32) - pad;
  const y = ((i / pw) as i32) - pad;
  if (x < 0 || y < 0 || x >= w || y >= h) {
    dst[i] = vec4(0.0, 0.0, 0.0, 0.0);
    return;
  }
  dst[i] = src[(y * w + x) as u32];
}

// 層を (lx, ly) に重ねる（層の下の端の行までだけ dispatch する）。
function compositeLayer(
  canvas: mut Buffer<vec4<f32>>, layer: Buffer<vec4<f32>>, p: Project, lx: i32, ly: i32, w: i32, h: i32, alpha: f32,
): void {
  const cnt = rowsCount(p, lx, ly, w, h);
  if (cnt > 0) {
    dispatch(composite, cnt, mut canvas, layer, p.width as u32, lx, ly, w, h, alpha);
  }
}

// 効果を掛けて (lx, ly) に重ねる。透明なまわりがある層（画像・文字）で、効果が広がる（blur など）なら、
// 広がる分の透明な余白を足した層に掛ける（層の四角で切れないように）。不透明な層（映像・色）は端をくり返す。
// 作業用の Buffer は置き場（rc）から借りる。
function fxComposite(
  canvas: mut Buffer<vec4<f32>>, layer: mut Buffer<vec4<f32>>, c: Clip, p: Project,
  lx: i32, ly: i32, w: i32, h: i32, alpha: f32, rc: mut RenderCache,
): void {
  const pad = clipFxReach(c);
  if (pad > 0 && (c.kind == KIND_IMAGE || c.kind == KIND_TEXT)) {
    const pw = w + 2 * pad;
    const ph = h + 2 * pad;
    const pn = (pw * ph) as u32;
    let big = takeV4(mut rc, pn);
    let tmp = takeV4(mut rc, pn);
    dispatch(padCopy, pn, mut big.b, layer, pw as u32, w, h, pad);
    applyClipFxTmp(mut big.b, mut tmp.b, c, pw as u32, ph as u32);
    compositeLayer(mut canvas, big.b, p, lx - pad, ly - pad, pw, ph, alpha);
    giveV4(mut rc, own big);
    giveV4(mut rc, own tmp);
    return;
  }
  let tmp = takeV4(mut rc, (w * h) as u32);
  applyClipFxTmp(mut layer, mut tmp.b, c, w as u32, h as u32);
  compositeLayer(mut canvas, layer, p, lx, ly, w, h, alpha);
  giveV4(mut rc, own tmp);
}

// st は見せる素材の時刻（秒。clipSourceTime）。
function drawVideo(
  canvas: mut Buffer<vec4<f32>>, c: Clip, m: MediaSource, p: Project, cache: string, idx: usize, st: f64, alpha: f32,
  rc: mut RenderCache, fc: FrameCache,
): void {
  const lx = clipPos(c.x, c.xAbs, m.w, p.width);
  const ly = clipPos(c.y, c.yAbs, m.h, p.height);
  const plain = c.fx.length == 0 && !clipGraded(c);
  const cnt = rowsCount(p, lx, ly, m.w, m.h);
  if (plain && cnt == 0) {
    return;
  }
  let yuv = takeU8(mut rc, m.frameBytes as u32);
  if (!readVideoYuv(mut yuv.b, c, m, p, cache, idx, st, fc)) {
    giveU8(mut rc, own yuv);
    return;
  }
  if (plain) {
    // 効果がなければ、層に広げずにキャンバスへ直接重ねる
    dispatch(yuvComposite, cnt, mut canvas, yuv.b, p.width as u32, lx, ly, m.w, m.h, alpha);
    giveU8(mut rc, own yuv);
    return;
  }
  const n = (m.w * m.h) as u32;
  let layer = takeV4(mut rc, n);
  dispatch(yuvToLayer, n, mut layer.b, yuv.b, m.w as u32, m.h as u32);
  giveU8(mut rc, own yuv);
  gradeLayer(mut layer.b, n, c, cache, mut rc.grade);
  fxComposite(mut canvas, mut layer.b, c, p, lx, ly, m.w, m.h, alpha, mut rc);
  giveV4(mut rc, own layer);
}

// 素材の時刻 st の映像のコマ（YUV 4:2:0）を yuv に読む（先読みの置き場 fc にあればそこから）。読めなければ false。
function readVideoYuv(
  yuv: mut Buffer<u8>, c: Clip, m: MediaSource, p: Project, cache: string, idx: usize, st: f64, fc: FrameCache,
): bool {
  const fps = (p.fpsNum as f64) / (p.fpsDen as f64);
  // 展開した範囲の始まり（.in がなければ、計画どおり in か timeremap の範囲の始まり）
  let base = c.inPt;
  if (c.remapLo != UNSET) {
    base = c.remapLo;
  }
  // mediaFrameAt は (lt + clipIn − 展開の始まり) を数えるので、clipIn に base、lt に st − base を渡す
  const k = mediaFrameAt(m, base, st - base, fps);
  if (fcVideoYuv(fc, idx, k, mut yuv, m.w, m.h)) {
    return true;
  }
  return mediaReadFrame(m, k, mut yuv);
}

function drawImage(
  canvas: mut Buffer<vec4<f32>>, c: Clip, m: MediaSource, p: Project, cache: string, idx: usize, alpha: f32, rc: mut RenderCache,
): void {
  const lx = clipPos(c.x, c.xAbs, m.w, p.width);
  const ly = clipPos(c.y, c.yAbs, m.h, p.height);
  const plain = c.fx.length == 0 && !clipGraded(c);
  const cnt = rowsCount(p, lx, ly, m.w, m.h);
  if (plain && cnt == 0) {
    return;
  }
  const n = (m.w * m.h) as u32;
  let px = takeU8(mut rc, n * 4);
  if (!mediaReadFrame(m, 0, mut px.b)) {
    giveU8(mut rc, own px);
    return;
  }
  if (plain) {
    dispatch(rgbaComposite, cnt, mut canvas, px.b, p.width as u32, lx, ly, m.w, m.h, alpha);
    giveU8(mut rc, own px);
    return;
  }
  let layer = takeV4(mut rc, n);
  dispatch(rgbaToLayer, n, mut layer.b, px.b);
  giveU8(mut rc, own px);
  gradeLayer(mut layer.b, n, c, cache, mut rc.grade);
  fxComposite(mut canvas, mut layer.b, c, p, lx, ly, m.w, m.h, alpha, mut rc);
  giveV4(mut rc, own layer);
}

function drawColor(canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, alpha: f32, rc: mut RenderCache): void {
  let w = c.w;
  let h = c.h;
  if (w <= 0) {
    w = p.width;
  }
  if (h <= 0) {
    h = p.height;
  }
  const x0 = clipPos(c.x, c.xAbs, w, p.width);
  const y0 = clipPos(c.y, c.yAbs, h, p.height);
  if (c.fx.length > 0) {
    // 効果があるときは、色を w × h の層に塗ってから効果を掛けて重ねる（video / image と同じ）。
    const n = (w * h) as u32;
    let layer = takeV4(mut rc, n);
    dispatch(clearCanvas, n, mut layer.b, colorVec(c.color));
    fxComposite(mut canvas, mut layer.b, c, p, x0, y0, w, h, alpha, mut rc);
    giveV4(mut rc, own layer);
    return;
  }
  const cnt = rowsCount(p, x0, y0, w, h);
  if (cnt > 0) {
    dispatch(fillRect, cnt, mut canvas, p.width as u32, x0, y0, x0 + w, y0 + h, colorVec(c.color), alpha);
  }
}

// 文字のクリップ。効果がなければキャンバスに直接描き、あれば透明な層に描いて効果を掛けてから重ねる。
// テキストアニメーター（anim=）があれば、字ごとに動かして描く（lt はクリップの始まりからの時刻）。
function drawText(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, font: Font, lt: f64, alpha: f32, rc: mut RenderCache,
): void {
  if (taClipAnimated(c)) {
    // 字の動きはクリップの中の時刻（in= で分けた後半も続きから。animout は full= から数える）
    let st = taStyleFromClip(c);
    st.dur = clipInnerDur(c);
    const it = clipInnerTime(c, lt);
    const spec = taClipSpec(c, p);
    if (c.fx.length == 0) {
      taDrawCanvas(mut canvas, p.width, p.height, st, spec, font, it, alpha, mut rc.ta);
      return;
    }
    let lo = taRenderLayer(p.width, p.height, st, spec, font, it, mut rc.ta);
    if (lo.w > 0 && lo.h > 0) {
      fxComposite(mut canvas, mut lo.layer, c, p, lo.x, lo.y, lo.w, lo.h, alpha, mut rc);
    }
    return;
  }
  if (c.fx.length == 0) {
    renderTextClipCached(mut canvas, c, p, font, alpha, mut rc.text);
    return;
  }
  const r = textClipRect(c, p, font, mut rc.text);
  if (r.w <= 0 || r.h <= 0) {
    return;
  }
  let layer = takeV4(mut rc, (r.w * r.h) as u32);
  textClipDrawLayer(mut layer.b, c, p, font, mut rc.text);
  fxComposite(mut canvas, mut layer.b, c, p, r.x, r.y, r.w, r.h, alpha, mut rc);
  giveV4(mut rc, own layer);
}

// 時刻 t のコマをキャンバスに描く。font は文字のクリップのフォント（呼ぶ側が projectFont(p.fontPath, p.fontIndex) で 1 度だけ読む）。
// rc は newRenderCache() で作り、フレームをまたいで同じものを渡す（文字の画像と作業用の Buffer を作り直さないため）。
export function renderFrame(
  p: Project, media: MediaSource[], cache: string, t: f64, canvas: mut Buffer<vec4<f32>>, font: Font, rc: mut RenderCache,
): void {
  const fc = emptyFrameCache();
  renderFrameFrom(p, media, cache, t, mut canvas, font, mut rc, fc);
}

export function renderFrameFrom(
  p: Project, media: MediaSource[], cache: string, t: f64, canvas: mut Buffer<vec4<f32>>, font: Font, rc: mut RenderCache,
  fc: FrameCache,
): void {
  textCacheFrame(mut rc.text);
  gradeCacheFrame(mut rc.grade);
  taCacheFrame(mut rc.ta);
  ptCacheFrame(mut rc.pt);
  t3AtlasClear(mut rc.t3atlas);
  rcFrame(mut rc);
  if (rc.blendTf != p.blendTf) {
    rc.blendLut = mblNewLut(p.blendTf);
    rc.blendTf = p.blendTf;
  }
  const n = (p.width * p.height) as u32;
  dispatch(clearCanvas, n, mut canvas, colorVec(p.bg));
  // エクスプレッション: このコマの値を先に全部求める（clip('ID') でほかのクリップの値を読むため）
  let ov: ExprOut[] = [];
  if (p.exprProgs.length > 0) {
    exprFrame(p, media, t, font, mut rc, mut ov);
  }
  let layers3d: T3Layer[] = [];
  for (const ci of p.drawOrder) {
    const idx = ci as usize;
    const lt = t - p.clips[idx].at;
    if (lt < 0 || lt >= p.clips[idx].dur) {
      continue;
    }
    // ほかのクリップのトラックマットの元は、画面に描かない（マットにだけ使う）
    if (p.clips[idx].id != "" && isMatteSource(p, p.clips[idx].id)) {
      continue;
    }
    const st = clipSourceTime(p.clips[idx], lt);
    if (p.clips[idx].d3.is3d) {
      // 3D のレイヤーは、続けて並ぶ 3D のクリップを 1 組にして、組の終わりで t3Render で重ねる（After Effects と同じく、
      // 間に 2D のレイヤーがあると組が分かれる）
      let c = clipAt(p.clips[idx], lt);
      exprApply(mut c, idx, ov);
      put3dLayer(mut layers3d, c, p, media, cache, idx, lt, st, font, mut rc, fc);
      continue;
    }
    flush3d(mut canvas, mut layers3d, p, t, mut rc);
    if (exprHas(idx, ov)) {
      // 式で決めた値は、キーフレームを評価した写しの上に差し替える
      let c = clipAt(p.clips[idx], lt);
      exprApply(mut c, idx, ov);
      drawClip(mut canvas, c, p, media, cache, idx, t, lt, st, font, mut rc, fc);
    } else if (p.clips[idx].anims.length == 0) {
      drawClip(mut canvas, p.clips[idx], p, media, cache, idx, t, lt, st, font, mut rc, fc);
    } else {
      // キーフレームのあるクリップは、その時刻の値にした写しで描く（不透明度もこの値で判断する）
      const c = clipAt(p.clips[idx], lt);
      drawClip(mut canvas, c, p, media, cache, idx, t, lt, st, font, mut rc, fc);
    }
  }
  flush3d(mut canvas, mut layers3d, p, t, mut rc);
  // project の行の効果は、合成した画面全体に掛ける（行に書いた順。引数のキーフレームはタイムラインの時刻で評価する）
  if (p.fx.length > 0) {
    let tmp = takeV4(mut rc, n);
    const fxs = projectFxAt(p, t);
    for (const u of fxs) {
      fxApply(u.effect, mut canvas, mut tmp.b, p.width as u32, p.height as u32, u.params);
    }
    giveV4(mut rc, own tmp);
  }
}

// 1 つのクリップを描く（c は p.clips[idx] か、キーフレームを評価した写し。t はタイムラインの時刻、
// lt はクリップの始まりからの時刻、st は見せる素材の時刻）。
function drawClip(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, media: MediaSource[], cache: string, idx: usize, t: f64, lt: f64, st: f64,
  font: Font, rc: mut RenderCache, fc: FrameCache,
): void {
  const env = envelope(lt, c.dur, c.fadeIn, c.fadeOut);
  const alpha = (env as f32) * c.opacity;
  if (alpha <= 0) {
    return;
  }
  if (c.blend.used || c.masks.length > 0) {
    drawBlended(mut canvas, c, p, media, cache, idx, t, st, font, alpha, mut rc, fc);
    return;
  }
  const kind = c.kind;
  if (kind == KIND_VIDEO) {
    drawVideo(mut canvas, c, media[idx], p, cache, idx, st, alpha, mut rc, fc);
  } else if (kind == KIND_IMAGE) {
    drawImage(mut canvas, c, media[idx], p, cache, idx, alpha, mut rc);
  } else if (kind == KIND_COLOR) {
    drawColor(mut canvas, c, p, alpha, mut rc);
  } else if (kind == KIND_TEXT) {
    drawText(mut canvas, c, p, font, lt, alpha, mut rc);
  } else if (kind == KIND_SHAPE) {
    drawShape(mut canvas, c, p, idx, lt, alpha, mut rc);
  } else if (kind == KIND_PARTICLES) {
    drawParticles(mut canvas, c, p, font, lt, alpha, mut rc);
  }
}

// particles の行。状態は rc.pt がクリップの ID（なければ @行）ごとに持つ。emit=layer なら、layer= のクリップ
// （text / color）の始まりの層を 1 度だけ渡す。効果があれば画面の大きさの層に描いて掛ける（blend=add は加算で重ねる）。
function drawParticles(canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, font: Font, clt: f64, alpha: f32, rc: mut RenderCache): void {
  // 粒の計算はクリップの中の時刻（in= で分けた後半も、頭からやり直さずに続きから。粒の数は full= の長さで決める）
  const lt = clipInnerTime(c, clt);
  const idur = clipInnerDur(c);
  let ds: PtDiag[] = [];
  const spec = ptResolveSpec(ptSpecFromKv(c.kv, mut ds), p.width, p.height);
  let key = c.id.clone();
  if (key == "") {
    key = `@${c.line}`;
  }
  const W = p.width as u32;
  const H = p.height as u32;
  if (spec.emit == PT_EMIT_LAYER && ptCacheNeedsLayer(mut rc.pt, key, spec, idur)) {
    const j = findClip(p, spec.layer);
    if (j >= 0 && p.clips[j as usize].kind == KIND_TEXT) {
      let lo = textClipLayer(p.clips[j as usize], p, font, mut rc.text);
      if (lo.w > 0 && lo.h > 0) {
        ptCacheSetLayer(mut rc.pt, key, spec, idur, lo.layer, lo.w as u32, lo.h as u32, lo.x as f32, lo.y as f32);
      }
    } else if (j >= 0 && p.clips[j as usize].kind == KIND_COLOR) {
      const ju = j as usize;
      let w = p.clips[ju].w;
      let h = p.clips[ju].h;
      if (w <= 0) {
        w = p.width;
      }
      if (h <= 0) {
        h = p.height;
      }
      let layer = new Buffer<vec4<f32>>((w * h) as u32);
      dispatch(clearCanvas, (w * h) as u32, mut layer, colorVec(p.clips[ju].color));
      ptCacheSetLayer(mut rc.pt, key, spec, idur, layer, w as u32, h as u32,
        clipPos(p.clips[ju].x, p.clips[ju].xAbs, w, p.width) as f32, clipPos(p.clips[ju].y, p.clips[ju].yAbs, h, p.height) as f32);
    }
  }
  if (c.fx.length == 0) {
    ptCacheDraw(mut rc.pt, key, spec, idur, lt, mut canvas, W, H, alpha);
    return;
  }
  let layer = takeV4(mut rc, W * H);
  ptCacheDrawLayer(mut rc.pt, key, spec, idur, lt, mut layer.b, W, H);
  if (spec.blend == PT_BLEND_ADD) {
    // 加算の粒は、効果を掛けた層を加算で重ねる（ふつうの重ねでは黒い背景の上でしか加算と同じにならない）
    let tmp = takeV4(mut rc, W * H);
    applyClipFxTmp(mut layer.b, mut tmp.b, c, W, H);
    giveV4(mut rc, own tmp);
    ptAddLayer(mut canvas, layer.b, W * H, alpha);
  } else {
    fxComposite(mut canvas, mut layer.b, c, p, 0, 0, p.width, p.height, alpha, mut rc);
  }
  giveV4(mut rc, own layer);
}

// shape の行（ベクターの図形）。効果がなければキャンバスに直接描き、あれば層に描いて効果を掛けてから重ねる。
// 層は効果が広がる分（margin）の透明な余白をすでに含むので、fxComposite は余白を足さない（KIND_SHAPE は image / text でない）。
function drawShape(canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, idx: usize, lt: f64, alpha: f32, rc: mut RenderCache): void {
  shapeCachesEnsure(mut rc.shape, idx);
  const margin = clipFxReach(c);
  const r = shapePrepareAt(mut rc.shape.items[idx], c.shape, c.x, c.y, c.xAbs, c.yAbs, POS_CENTER, clipInnerTime(c, lt), clipInnerDur(c), p.width, p.height, margin);
  if (r.w <= 0 || r.h <= 0) {
    return;
  }
  if (c.fx.length == 0) {
    shapeDrawDirect(mut canvas, p.width, p.height, alpha, rc.shape.items[idx]);
    return;
  }
  let layer = takeV4(mut rc, (r.w * r.h) as u32);
  shapeRenderLayer(mut layer.b, rc.shape.items[idx]);
  fxComposite(mut canvas, mut layer.b, c, p, r.x, r.y, r.w, r.h, alpha, mut rc);
  giveV4(mut rc, own layer);
}

// ---- エクスプレッション（src/m6_expr/） ----

// 1 つの式の、このコマの値。
struct ExprOut {
  clip: usize;
  key: string;
  v: ExprVal;
}

function exprHas(idx: usize, ov: ExprOut[]): bool {
  for (const o of ov) {
    if (o.clip == idx) {
      return true;
    }
  }
  return false;
}

// 式の値をクリップの写しに入れる。x / y / position は左上の画素（xAbs / yAbs）、opacity は 0〜1 に丸める。
function exprApply(c: mut Clip, idx: usize, ov: ExprOut[]): void {
  for (const o of ov) {
    if (o.clip != idx) {
      continue;
    }
    if (o.key == "x") {
      c.x = o.v.x;
      c.xAbs = true;
    } else if (o.key == "y") {
      c.y = o.v.x;
      c.yAbs = true;
    } else if (o.key == "position") {
      c.x = o.v.x;
      c.y = o.v.y;
      c.xAbs = true;
      c.yAbs = true;
    } else if (o.key == "opacity") {
      c.opacity = Math.min(Math.max(o.v.x, 0.0), 1.0) as f32;
    } else if (o.key == "volume") {
      c.volume = Math.min(Math.max(o.v.x, 0.0), 10.0) as f32;
    } else {
      const fk = fxFindKey(o.key);
      if (fk.effect >= 0) {
        let k = fk.param;
        if (k < 0) {
          k = 0;
        }
        for (let s: usize = 0; s < c.fx.length; s++) {
          if (c.fx[s].effect == fk.effect) {
            c.fx[s].params[k as usize] = o.v.x as f32;
          }
        }
      }
    }
  }
}

// このコマの式の値を、評価の順（Project.exprOrder）に求めて ov に入れる。場面の値（ほかのクリップの x / y / w / h /
// opacity / 効果の引数）は、キーフレームを評価した後の値を、解いた後の画素で入れる（式の座標の約束）。
function exprFrame(p: Project, media: MediaSource[], t: f64, font: Font, rc: mut RenderCache, ov: mut ExprOut[]): void {
  const fps = (p.fpsNum as f64) / (p.fpsDen as f64);
  let sc = exprSceneNew(own exprEnvFor(), p.width as f64, p.height as f64, p.duration, fps);
  const sx = exprEnvSlot(sc.env, "x");
  const sy = exprEnvSlot(sc.env, "y");
  const sw = exprEnvSlot(sc.env, "w");
  const sh = exprEnvSlot(sc.env, "h");
  const so = exprEnvSlot(sc.env, "opacity");
  const sv = exprEnvSlot(sc.env, "volume");
  const si = exprEnvSlot(sc.env, "inPoint");
  const se = exprEnvSlot(sc.env, "outPoint");
  const sd = exprEnvSlot(sc.env, "duration");
  const sn = exprEnvSlot(sc.env, "index");
  for (let i: usize = 0; i < p.clips.length; i++) {
    sc.layers.push(exprLayerNew(p.clips[i].id, sc.env));
    const lt = t - p.clips[i].at;
    const c = clipAt(p.clips[i], lt);
    const li = i as i32;
    const r = clipLayerRect(c, media[i], p, font, i, lt, mut rc);
    if (r.ok) {
      exprScenePut(mut sc, li, sx, exprNum(r.x as f64));
      exprScenePut(mut sc, li, sy, exprNum(r.y as f64));
      exprScenePut(mut sc, li, sw, exprNum(r.w as f64));
      exprScenePut(mut sc, li, sh, exprNum(r.h as f64));
    } else {
      exprScenePut(mut sc, li, sx, exprNum(clipPos(c.x, c.xAbs, 0, p.width) as f64));
      exprScenePut(mut sc, li, sy, exprNum(clipPos(c.y, c.yAbs, 0, p.height) as f64));
    }
    exprScenePut(mut sc, li, so, exprNum(c.opacity as f64));
    exprScenePut(mut sc, li, sv, exprNum(c.volume as f64));
    exprScenePut(mut sc, li, si, exprNum(c.at));
    exprScenePut(mut sc, li, se, exprNum(c.at + c.dur));
    exprScenePut(mut sc, li, sd, exprNum(c.dur));
    exprScenePut(mut sc, li, sn, exprNum((i + 1) as f64));
    for (const u of c.fx) {
      const pc = fxParamCount(u.effect);
      for (let k = 0; k < pc; k++) {
        if (k == 0) {
          const s0 = exprEnvSlot(sc.env, fxName(u.effect));
          if (s0 >= 0) {
            exprScenePut(mut sc, li, s0, exprNum(u.params[0] as f64));
          }
        }
        const sk = exprEnvSlot(sc.env, fxName(u.effect) + "." + fxParamName(u.effect, k));
        if (sk >= 0) {
          exprScenePut(mut sc, li, sk, exprNum(u.params[k as usize] as f64));
        }
      }
    }
  }
  for (const oi of p.exprOrder) {
    const i = oi as usize;
    const li = p.exprNodes[i].layer as usize;
    let cx = exprCtxNew(t, exprLayerGet(sc.layers[li], p.exprNodes[i].slot), (li + 1) as i32, li as i32);
    // キーフレーム（loopOut / valueAtTime / key(n) が使う）。時刻はタイムラインの秒、値は AnimKey.v の 4 つ
    // （位置は左上の画素、色は 0〜1）。式の値の名前 position はキーフレームの pos
    let animKey = p.exprKeys[i].clone();
    if (animKey == "position") {
      animKey = "pos";
    }
    for (const a of p.clips[li].anims) {
      if (a.key == animKey) {
        for (const k of a.track.keys) {
          let interp = EXPR_KEY_LINEAR;
          if (k.outMode == ANIM_HOLD) {
            interp = EXPR_KEY_HOLD;
          }
          cx.keys.push({ t: p.clips[li].at + k.t, v: { x: k.v[0], y: k.v[1], z: k.v[2], w: k.v[3] }, interp });
        }
        // 値の表（valueAtTime / loopOut / loopIn が引く）: animEval の値をコマの 1/4 ごとに。イーズ・ベジェもキーフレームと同じ値
        const nk = a.track.keys.length;
        if (p.exprProgs[i].usesKeys && nk >= 2 && fps > 0) {
          const k0 = a.track.keys[0].t;
          const dt = 1.0 / (fps * 4.0);
          const n = (Math.ceil((a.track.keys[nk - 1].t - k0) / dt) as i64) + 1;
          let vals: f64[] = [];
          for (let j: i64 = 0; j < n; j++) {
            const v = animEval(a.track, k0 + (j as f64) * dt);
            vals.push(v[0]);
            vals.push(v[1]);
            vals.push(v[2]);
            vals.push(v[3]);
          }
          exprCtxSetCurve(mut cx, p.clips[li].at + k0, dt, own vals);
        }
      }
    }
    const r = exprEvalFull(p.exprProgs[i], cx, sc);
    exprScenePut(mut sc, li as i32, p.exprNodes[i].slot, r.v);
    ov.push({ clip: li, key: p.exprKeys[i].clone(), v: r.v });
  }
}

// ---- 3D レイヤー（src/m6_3d/） ----

// 3D のクリップの層（マスク・効果を掛けたもの）をアトラスに入れ、T3Layer を layers に足す。描くものがなければ何もしない。
function put3dLayer(
  layers: mut T3Layer[], c: Clip, p: Project, media: MediaSource[], cache: string, idx: usize, lt: f64, st: f64, font: Font,
  rc: mut RenderCache, fc: FrameCache,
): void {
  const alpha = (envelope(lt, c.dur, c.fadeIn, c.fadeOut) as f32) * c.opacity;
  if (alpha <= 0) {
    return;
  }
  const r = clipLayerRect(c, media[idx], p, font, idx, lt, mut rc);
  if (!r.ok) {
    return;
  }
  const n = (r.w * r.h) as u32;
  let layer = takeV4(mut rc, n);
  if (!fillClipLayer(mut layer.b, c, media[idx], p, cache, idx, st, font, mut rc, fc)) {
    giveV4(mut rc, own layer);
    return;
  }
  if (c.masks.length > 0) {
    while (rc.masks.length <= idx) {
      rc.masks.push(mblNewMaskCache());
    }
    if (mblBuildMaskCached(mut rc.masks[idx], c.masks, r.w, r.h)) {
      dispatch(mblApplyMask, n, mut layer.b, rc.masks[idx].mask);
    }
  }
  const pad = clipFxReach(c);
  if (c.fx.length > 0 && pad > 0 && (c.kind == KIND_IMAGE || c.kind == KIND_TEXT)) {
    // 透明なまわりのある層は、効果が広がる分の余白を足して掛ける（中央は変わらない）
    const pw = r.w + 2 * pad;
    const ph = r.h + 2 * pad;
    const pn = (pw * ph) as u32;
    let big = takeV4(mut rc, pn);
    let tmp = takeV4(mut rc, pn);
    dispatch(padCopy, pn, mut big.b, layer.b, pw as u32, r.w, r.h, pad);
    applyClipFxTmp(mut big.b, mut tmp.b, c, pw as u32, ph as u32);
    const slot = t3AtlasPut(mut rc.t3atlas, big.b, pw, ph);
    giveV4(mut rc, own big);
    giveV4(mut rc, own tmp);
    layers.push({ slot, spec: copyLayer3d(c.d3), baseX: (r.x as f64) + (r.w as f64) / 2, baseY: (r.y as f64) + (r.h as f64) / 2, start: c.at, alpha });
  } else {
    if (c.fx.length > 0) {
      let tmp = takeV4(mut rc, n);
      applyClipFxTmp(mut layer.b, mut tmp.b, c, r.w as u32, r.h as u32);
      giveV4(mut rc, own tmp);
    }
    const slot = t3AtlasPut(mut rc.t3atlas, layer.b, r.w, r.h);
    layers.push({ slot, spec: copyLayer3d(c.d3), baseX: (r.x as f64) + (r.w as f64) / 2, baseY: (r.y as f64) + (r.h as f64) / 2, start: c.at, alpha });
  }
  giveV4(mut rc, own layer);
}

// 集めた 3D のレイヤーの組を、project のカメラ・ライトで重ねて空にする。
function flush3d(canvas: mut Buffer<vec4<f32>>, layers: mut T3Layer[], p: Project, t: f64, rc: mut RenderCache): void {
  if (layers.length == 0) {
    return;
  }
  if (rc.t3work.length == 0) {
    rc.t3work.push(t3WorkNew());
  }
  let work = rc.t3work.pop();
  const fps = (p.fpsNum as f64) / (p.fpsDen as f64);
  t3Render(mut canvas, { spec: copyScene3d(p.scene3d), cw: p.width, ch: p.height, fps }, layers, rc.t3atlas, mut work, t);
  rc.t3work.push(work);
  while (layers.length > 0) {
    layers.pop();
  }
}

// ---- 描画モード・マスク・トラックマット（src/m6_blend/） ----

// id がほかのクリップの matte= に使われているか（マットの元は画面に描かない）。
function isMatteSource(p: Project, id: string): bool {
  for (const c of p.clips) {
    if (c.blend.matte == id) {
      return true;
    }
  }
  return false;
}

struct LayerRect {
  ok: bool;
  x: i32;
  y: i32;
  w: i32;
  h: i32;
}

// クリップの層（効果の前の素材の絵）の置き場所と大きさ。shape の層は効果の広がる分の余白を含む。
function clipLayerRect(c: Clip, m: MediaSource, p: Project, font: Font, idx: usize, lt: f64, rc: mut RenderCache): LayerRect {
  const kind = c.kind;
  if (kind == KIND_SHAPE) {
    shapeCachesEnsure(mut rc.shape, idx);
    const r = shapePrepareAt(mut rc.shape.items[idx], c.shape, c.x, c.y, c.xAbs, c.yAbs, POS_CENTER, clipInnerTime(c, lt), clipInnerDur(c), p.width, p.height,
      clipFxReach(c));
    return { ok: r.w > 0 && r.h > 0, x: r.x, y: r.y, w: r.w, h: r.h };
  }
  if (kind == KIND_VIDEO || kind == KIND_IMAGE) {
    if (!m.ok) {
      return { ok: false, x: 0, y: 0, w: 0, h: 0 };
    }
    return { ok: true, x: clipPos(c.x, c.xAbs, m.w, p.width), y: clipPos(c.y, c.yAbs, m.h, p.height), w: m.w, h: m.h };
  }
  if (kind == KIND_COLOR) {
    let w = c.w;
    let h = c.h;
    if (w <= 0) {
      w = p.width;
    }
    if (h <= 0) {
      h = p.height;
    }
    return { ok: true, x: clipPos(c.x, c.xAbs, w, p.width), y: clipPos(c.y, c.yAbs, h, p.height), w, h };
  }
  if (kind == KIND_TEXT) {
    const r = textClipRect(c, p, font, mut rc.text);
    return { ok: r.w > 0 && r.h > 0, x: r.x, y: r.y, w: r.w, h: r.h };
  }
  return { ok: false, x: 0, y: 0, w: 0, h: 0 };
}

// クリップの層を layer（clipLayerRect の大きさ）に描く。読めなければ false。
function fillClipLayer(
  layer: mut Buffer<vec4<f32>>, c: Clip, m: MediaSource, p: Project, cache: string, idx: usize, st: f64, font: Font,
  rc: mut RenderCache, fc: FrameCache,
): bool {
  const kind = c.kind;
  if (kind == KIND_VIDEO) {
    let yuv = takeU8(mut rc, m.frameBytes as u32);
    const ok = readVideoYuv(mut yuv.b, c, m, p, cache, idx, st, fc);
    if (ok) {
      dispatch(yuvToLayer, layer.length, mut layer, yuv.b, m.w as u32, m.h as u32);
    }
    giveU8(mut rc, own yuv);
    if (ok) {
      // 色の調整は層を作るときに掛ける（マスク・効果・描画モードより先。drawVideo / drawImage と同じ順）
      gradeLayer(mut layer, layer.length, c, cache, mut rc.grade);
    }
    return ok;
  }
  if (kind == KIND_IMAGE) {
    const n = (m.w * m.h) as u32;
    let px = takeU8(mut rc, n * 4);
    if (!mediaReadFrame(m, 0, mut px.b)) {
      giveU8(mut rc, own px);
      return false;
    }
    dispatch(rgbaToLayer, n, mut layer, px.b);
    giveU8(mut rc, own px);
    gradeLayer(mut layer, n, c, cache, mut rc.grade);
    return true;
  }
  if (kind == KIND_COLOR) {
    dispatch(clearCanvas, layer.length, mut layer, colorVec(c.color));
    return true;
  }
  if (kind == KIND_TEXT) {
    textClipDrawLayer(mut layer, c, p, font, mut rc.text);
    return true;
  }
  if (kind == KIND_SHAPE) {
    // clipLayerRect の shapePrepareAt で準備した形
    shapeRenderLayer(mut layer, rc.shape.items[idx]);
    return true;
  }
  return false;
}

// クリップの層を作り、マスク（効果より前。After Effects と同じ）→ 効果 → 描画モードで dst に重ねる。
// matte はキャンバスの大きさのマット（flags に MBL_USE_MATTE を立てたときだけ使う）。
function blendClipOnto(
  dst: mut Buffer<vec4<f32>>, c: Clip, idx: usize, p: Project, media: MediaSource[], cache: string, lt: f64, st: f64, font: Font,
  alpha: f32, mode: u32, space: u32, matte: Buffer<f32>, flags: u32, rc: mut RenderCache, fc: FrameCache,
): void {
  const r = clipLayerRect(c, media[idx], p, font, idx, lt, mut rc);
  if (!r.ok) {
    return;
  }
  const n = (r.w * r.h) as u32;
  let layer = takeV4(mut rc, n);
  if (!fillClipLayer(mut layer.b, c, media[idx], p, cache, idx, st, font, mut rc, fc)) {
    giveV4(mut rc, own layer);
    return;
  }
  if (c.masks.length > 0) {
    while (rc.masks.length <= idx) {
      rc.masks.push(mblNewMaskCache());
    }
    if (mblBuildMaskCached(mut rc.masks[idx], c.masks, r.w, r.h)) {
      dispatch(mblApplyMask, n, mut layer.b, rc.masks[idx].mask);
    }
  }
  const none = mblNoMap();
  const pad = clipFxReach(c);
  if (c.fx.length > 0 && pad > 0 && (c.kind == KIND_IMAGE || c.kind == KIND_TEXT)) {
    // 透明なまわりのある層は、効果が広がる分の余白を足して掛ける（fxComposite と同じ）
    const pw = r.w + 2 * pad;
    const ph = r.h + 2 * pad;
    const pn = (pw * ph) as u32;
    let big = takeV4(mut rc, pn);
    let tmp = takeV4(mut rc, pn);
    dispatch(padCopy, pn, mut big.b, layer.b, pw as u32, r.w, r.h, pad);
    applyClipFxTmp(mut big.b, mut tmp.b, c, pw as u32, ph as u32);
    mblCompositeLayer(mut dst, big.b, none, matte, rc.blendLut, p.width, p.height, r.x - pad, r.y - pad, pw, ph, alpha, mode, space, flags);
    giveV4(mut rc, own big);
    giveV4(mut rc, own tmp);
  } else {
    if (c.fx.length > 0) {
      let tmp = takeV4(mut rc, n);
      applyClipFxTmp(mut layer.b, mut tmp.b, c, r.w as u32, r.h as u32);
      giveV4(mut rc, own tmp);
    }
    mblCompositeLayer(mut dst, layer.b, none, matte, rc.blendLut, p.width, p.height, r.x, r.y, r.w, r.h, alpha, mode, space, flags);
  }
  giveV4(mut rc, own layer);
}

// 描画モード・マスク・トラックマットのあるクリップを描く。マットがあれば、先にマットの元をキャンバスの大きさの
// 透明な下地に描いてマットにする（元がその時刻になければマットは 0、反転なら 1）。キャンバスに重ねるときは
// いつも MBL_DST_OPAQUE（bg が透明でも blendOver と同じ式）。
function drawBlended(
  canvas: mut Buffer<vec4<f32>>, c: Clip, p: Project, media: MediaSource[], cache: string, idx: usize, t: f64, st: f64,
  font: Font, alpha: f32, rc: mut RenderCache, fc: FrameCache,
): void {
  const lt = t - c.at;
  if (c.blend.matte == "") {
    const none = mblNoMap();
    blendClipOnto(mut canvas, c, idx, p, media, cache, lt, st, font, alpha, c.blend.mode, c.blend.space, none, MBL_DST_OPAQUE, mut rc, fc);
    return;
  }
  const n = (p.width * p.height) as u32;
  let mc = takeV4(mut rc, n);
  mblClearTransparent(mut mc.b);
  const j = findClip(p, c.blend.matte);
  if (j >= 0) {
    const ju = j as usize;
    const lts = t - p.clips[ju].at;
    if (lts >= 0 && lts < p.clips[ju].dur) {
      const s = clipAt(p.clips[ju], lts);
      const sst = clipSourceTime(p.clips[ju], lts);
      const alphaS = (envelope(lts, s.dur, s.fadeIn, s.fadeOut) as f32) * s.opacity;
      if (alphaS > 0) {
        const none = mblNoMap();
        blendClipOnto(mut mc.b, s, ju, p, media, cache, lts, sst, font, alphaS, MBL_NORMAL, MBL_SPACE_DISPLAY, none, 0, mut rc, fc);
      }
    }
  }
  let matte = new Buffer<f32>(n);
  mblMatteFrom(mut matte, mc.b, c.blend.matteKind, c.blend.matteInvert);
  giveV4(mut rc, own mc);
  blendClipOnto(mut canvas, c, idx, p, media, cache, lt, st, font, alpha, c.blend.mode, c.blend.space, matte,
    MBL_DST_OPAQUE | MBL_USE_MATTE, mut rc, fc);
}

export function canvasToYuv(canvas: Buffer<vec4<f32>>, out: mut Buffer<u8>, w: i32, h: i32): void {
  dispatch(toYuv, out.length, mut out, canvas, w as u32, h as u32);
}

function push32(out: mut u8[], v: u32): void {
  out.push((v & 255) as u8);
  out.push(((v >> 8) & 255) as u8);
  out.push(((v >> 16) & 255) as u8);
  out.push(((v >> 24) & 255) as u8);
}

function byteOf(v: f32): u8 {
  return (Math.min(Math.max(v * 255 + 0.5, 0.0), 255.0) as i32) as u8;
}

// キャンバスを 24 ビットの BMP に書く（プレビュー用）。
export function writeBmp(path: string, canvas: Buffer<vec4<f32>>, w: i32, h: i32): bool {
  const rowBytes = ((w * 3 + 3) / 4) * 4;
  const dataBytes = (rowBytes * h) as u32;
  let out: u8[] = [66, 77];
  push32(mut out, 54 + dataBytes);
  push32(mut out, 0);
  push32(mut out, 54);
  push32(mut out, 40);
  push32(mut out, w as u32);
  push32(mut out, h as u32);
  out.push(1);
  out.push(0);
  out.push(24);
  out.push(0);
  push32(mut out, 0);
  push32(mut out, dataBytes);
  push32(mut out, 2835);
  push32(mut out, 2835);
  push32(mut out, 0);
  push32(mut out, 0);
  for (let y = h - 1; y >= 0; y--) {
    for (let x = 0; x < w; x++) {
      const c = canvas[(y * w + x) as u32];
      out.push(byteOf(c.z));
      out.push(byteOf(c.y));
      out.push(byteOf(c.x));
    }
    for (let k = w * 3; k < rowBytes; k++) {
      out.push(0);
    }
  }
  return writeFile(path, out);
}
