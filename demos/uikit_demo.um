// uikit の見本（ギャラリー）: すべての部品を並べたウィンドウ。
//
//   node <UM>/src/cli.ts build src/uikit_demo.um --target host -o build/uikit-demo
//   build/uikit-demo [--size 1440x900] [--scale 1.0] [--tokens docs/design/tokens.json]
//                    [--frames N] [--shot x.bmp]               N フレーム描いたら終わり、最後の画面を BMP に書く
//                    [--move x,y@F] [--click x,y@F] [--rclick x,y@F] [--down x,y@F] [--up x,y@F]
//                    [--key 名前@F] [--type 文字@F] [--wheel d@F]  F フレーム目に入力を入れる（見た目の確かめ用）
//                    [--bench]                                  ウィンドウを開かずに、部品 300 個の画面の描く速さを測る
// キーの名前: tab enter esc left right up down home end pgup pgdn backspace delete space f1..f12 a..z、
// 前に shift+ / ctrl+ を付けられる（例: shift+tab、ctrl+a）。
import * from "um:window";
import {
  UkCtx, ukNew, ukBegin, ukEnd, ukInvalidate, ukNextFrameMs, ukToast, ukTooltip, ukDrawRect, ukDrawTextIn,
  ukEventMouseMove, ukEventMouseButtonAt, ukEventKey, ukEventText, ukEventWheel, ukPushId, ukPopId, ukPushIdInt,
  ukPushClip, ukPopClip, UK_KEY_TAB, UK_KEY_ENTER, UK_KEY_ESC, UK_KEY_BACKSPACE, UK_KEY_DELETE, UK_KEY_LEFT,
  UK_KEY_RIGHT, UK_KEY_UP, UK_KEY_DOWN, UK_KEY_HOME, UK_KEY_END, UK_KEY_PGUP, UK_KEY_PGDN, UK_KEY_SPACE, UK_KEY_F,
  UK_KEY_CHAR, UK_MOD_SHIFT, UK_MOD_CTRL,
} from "./ui/kit/core.um";
import { UkRect, ukRect, ukShrink, ukFixed } from "./ui/kit/base.um";
import { UkTheme, ukThemeDefault, ukThemeFromTokens, ukThemeScale } from "./ui/kit/theme.um";
import {
  ukBeginColAt, ukBeginRowAt, ukBeginRow, ukBeginGroup, ukEndBox, ukNext, ukSpace, ukSplit, ukBeginScroll, ukEndScroll,
  ukTabs, ukBeginColumns, UkDock, ukDockNew, ukDockAddArea, ukDockArea, ukGap, ukAlign, UK_A_CENTER, ukRest,
} from "./ui/kit/layout.um";
import {
  ukButton, ukButtonEx, ukButtonPrimary, ukButtonDanger, ukIconButton, ukToggle, ukCheck, ukRadio, ukSlider, ukNumber,
  ukTimecode, ukTextField, ukDropdown, ukProgress, ukTextLine, ukTextDim, ukHeading, ukSection, ukSeparator, ukBeginProp,
  ukBeginMenuBar, ukEndMenuBar, ukMenu, ukMenuItem, ukMenuCheck, ukMenuSep, ukBeginSubMenu, ukEndMenu, ukContextMenu,
  ukBeginList, ukListRow, ukEndList, ukOpenDialog, ukBeginDialog, ukEndDialog, ukBeginDialogFooter, ukCloseDialog,
  UK_BTN_SECONDARY, UK_BTN_PRIMARY, UK_BTN_DANGER, UK_BTN_QUIET,
} from "./ui/kit/widgets.um";
import {
  UK_I_NONE, UK_I_PLAY, UK_I_PAUSE, UK_I_STOP, UK_I_PLUS, UK_I_MINUS, UK_I_CLOSE, UK_I_CUT, UK_I_PREV, UK_I_NEXT,
  UK_I_SEARCH, UK_I_MENU, UK_I_EYE, UK_I_LOCK, UK_I_INFO, UK_I_WARN,
} from "./ui/kit/icons.um";
import { UkWinRes, ukWinResNew, ukFeedWindowEvent, ukWindowSync } from "./ui/kit/window.um";
import { ukWriteBmp } from "./ui/kit/bmp.um";
import { uiFont, decodeUtf8 } from "./effects/text/ttf.um";

struct DemoState {
  vol: f64;
  speed: f64;
  opacity: f64;
  scaleV: f64;
  frame: i64;
  name: string;
  search: string;
  snap: bool;
  ripple: bool;
  loop: bool;
  audio: bool;
  mode: i32;
  quality: i32;
  codec: i32;
  tab: i32;
  sel: i32;
  playing: bool;
  progress: f64;
  showGrid: bool;
  dock: UkDock;
  lastMs: f64;
  avgMs: f64;
  clicks: i32;
}

function demoNew(): DemoState {
  let dock = ukDockNew(own ["プロジェクト", "効果", "メディア", "タイムライン", "書き出し", "情報"]);
  ukDockAddArea(mut dock, own [0, 1, 2]);
  ukDockAddArea(mut dock, own [3, 4, 5]);
  return {
    vol: 0.8, speed: 1.0, opacity: 100.0, scaleV: 100.0, frame: 1234, name: "夏の旅行", search: "", snap: true,
    ripple: false, loop: false, audio: true, mode: 1, quality: 2, codec: 0, tab: 0, sel: 3, playing: false,
    progress: 0.42, showGrid: true, dock, lastMs: 0.0, avgMs: 0.0, clicks: 0,
  };
}

// ---- ギャラリーの中身 ----

function demoMenus(ui: mut UkCtx, st: mut DemoState): void {
  ukBeginMenuBar(mut ui, ukRect(0, 0, ui.W, ui.theme.menuH + 4));
  if (ukMenu(mut ui, "ファイル")) {
    if (ukMenuItem(mut ui, "新規プロジェクト", "Ctrl+N")) {
      ukToast(mut ui, "新しいプロジェクトを作りました", 1);
    }
    ukMenuItem(mut ui, "開く…", "Ctrl+O");
    if (ukBeginSubMenu(mut ui, "最近使ったファイル")) {
      ukMenuItem(mut ui, "夏の旅行.mzc", "");
      ukMenuItem(mut ui, "結婚式.mzc", "");
      ukMenuItem(mut ui, "製品紹介.mzc", "");
      ukEndMenu(mut ui);
    }
    ukMenuSep(mut ui);
    ukMenuItem(mut ui, "保存", "Ctrl+S");
    if (ukMenuItem(mut ui, "書き出し…", "Ctrl+M")) {
      ukOpenDialog(mut ui, "書き出し");
    }
    ukMenuSep(mut ui);
    ukMenuItem(mut ui, "終了", "Ctrl+Q");
    ukEndMenu(mut ui);
  }
  if (ukMenu(mut ui, "編集")) {
    ukMenuItem(mut ui, "取り消し", "Ctrl+Z");
    ukMenuItem(mut ui, "やり直し", "Ctrl+Shift+Z");
    ukMenuSep(mut ui);
    ukMenuItem(mut ui, "切り取り", "Ctrl+X");
    ukMenuItem(mut ui, "コピー", "Ctrl+C");
    ukMenuItem(mut ui, "貼り付け", "Ctrl+V");
    ukEndMenu(mut ui);
  }
  if (ukMenu(mut ui, "表示")) {
    st.snap = ukMenuCheck(mut ui, "スナップ", "S", st.snap);
    st.showGrid = ukMenuCheck(mut ui, "セーフエリア", "", st.showGrid);
    ukMenuSep(mut ui);
    ukMenuItem(mut ui, "拡大", "=");
    ukMenuItem(mut ui, "縮小", "-");
    ukEndMenu(mut ui);
  }
  if (ukMenu(mut ui, "ヘルプ")) {
    ukMenuItem(mut ui, "キーボードショートカット", "F1");
    ukMenuItem(mut ui, "MozaicCut について", "");
    ukEndMenu(mut ui);
  }
  ukEndMenuBar(mut ui);
}

function demoButtons(ui: mut UkCtx, st: mut DemoState): void {
  ukSection(mut ui, "ボタン");
  ukBeginRow(mut ui, ui.theme.ctrlH, []);
  if (ukButtonPrimary(mut ui, "書き出し")) {
    ukOpenDialog(mut ui, "書き出し");
  }
  ukTooltip(mut ui, "動画をファイルに書き出します");
  if (ukButton(mut ui, "読み込み")) {
    st.clicks += 1;
    ukToast(mut ui, "素材を読み込みました", 0);
  }
  if (ukButtonDanger(mut ui, "削除")) {
    ukToast(mut ui, "クリップを削除しました", 3);
  }
  ukButtonEx(mut ui, "静かなボタン", UK_BTN_QUIET, UK_I_NONE);
  ukEndBox(mut ui);
  ukBeginRow(mut ui, ui.theme.ctrlH, []);
  ukButtonEx(mut ui, "追加", UK_BTN_SECONDARY, UK_I_PLUS);
  ukButtonEx(mut ui, "分割", UK_BTN_SECONDARY, UK_I_CUT);
  ui.disabled += 1;
  ukButton(mut ui, "使えない");
  ui.disabled -= 1;
  ukEndBox(mut ui);
  ukBeginRow(mut ui, ui.theme.ctrlH, []);
  ukIconButton(mut ui, "前のコマ", UK_I_PREV, false);
  if (ukIconButton(mut ui, "再生 / 停止", st.playing ? UK_I_PAUSE : UK_I_PLAY, st.playing)) {
    st.playing = !st.playing;
  }
  ukIconButton(mut ui, "停止", UK_I_STOP, false);
  ukIconButton(mut ui, "次のコマ", UK_I_NEXT, false);
  ukIconButton(mut ui, "表示", UK_I_EYE, true);
  ukIconButton(mut ui, "固定", UK_I_LOCK, false);
  ukIconButton(mut ui, "検索", UK_I_SEARCH, false);
  ukIconButton(mut ui, "メニュー", UK_I_MENU, false);
  ukEndBox(mut ui);
}

function demoChoices(ui: mut UkCtx, st: mut DemoState): void {
  ukSection(mut ui, "トグル・チェック・ラジオ");
  st.snap = ukToggle(mut ui, "スナップ", st.snap);
  st.ripple = ukToggle(mut ui, "リップル編集", st.ripple);
  st.loop = ukCheck(mut ui, "ループ再生", st.loop);
  st.audio = ukCheck(mut ui, "音声を書き出す", st.audio);
  ukBeginRow(mut ui, ui.theme.ctrlH, []);
  st.mode = ukRadio(mut ui, "選択", st.mode, 0);
  st.mode = ukRadio(mut ui, "トリム", st.mode, 1);
  st.mode = ukRadio(mut ui, "レーザー", st.mode, 2);
  ukEndBox(mut ui);
}

function demoValues(ui: mut UkCtx, st: mut DemoState): void {
  ukSection(mut ui, "スライダー・数値・タイムコード");
  const nw = 96 * ui.theme.ctrlH / 26;
  ukBeginProp(mut ui, "音量", nw);
  st.vol = ukSlider(mut ui, "音量##s", st.vol, 0.0, 1.0, 0.01, 2);
  ukEndBox(mut ui);
  ukBeginProp(mut ui, "速さ", nw);
  st.speed = ukSlider(mut ui, "速さ##s", st.speed, 0.25, 4.0, 0.05, 2);
  ukEndBox(mut ui);
  ukBeginProp(mut ui, "不透明度", nw);
  st.opacity = ukNumber(mut ui, "不透明度##n", st.opacity, 0.0, 100.0, 1.0, 0);
  ukEndBox(mut ui);
  ukBeginProp(mut ui, "拡大率", nw);
  st.scaleV = ukNumber(mut ui, "拡大率##n", st.scaleV, 1.0, 400.0, 0.5, 1);
  ukEndBox(mut ui);
  ukBeginProp(mut ui, "再生位置", nw);
  st.frame = ukTimecode(mut ui, "再生位置##tc", st.frame, 30000, 1001);
  ukEndBox(mut ui);
}

function demoInputs(ui: mut UkCtx, st: mut DemoState): void {
  ukSection(mut ui, "文字の入力・ドロップダウン");
  const nw = 96 * ui.theme.ctrlH / 26;
  ukBeginProp(mut ui, "名前", nw);
  st.name = ukTextField(mut ui, "シーケンスの名前##name", st.name);
  ukEndBox(mut ui);
  ukBeginProp(mut ui, "検索", nw);
  st.search = ukTextField(mut ui, "クリップを探す…##search", st.search);
  ukEndBox(mut ui);
  ukBeginProp(mut ui, "画質", nw);
  st.quality = ukDropdown(mut ui, "画質", ["低い（速い）", "ふつう", "高い", "最高（遅い）"], st.quality);
  ukEndBox(mut ui);
  ukBeginProp(mut ui, "形式", nw);
  st.codec = ukDropdown(mut ui, "形式", ["H.264（MP4）", "H.265（MP4）", "ProRes 422（MOV）", "PNG の連番"], st.codec);
  ukEndBox(mut ui);
}

function demoFeedback(ui: mut UkCtx, st: mut DemoState): void {
  ukSection(mut ui, "進み具合・通知・ダイアログ");
  ukProgress(mut ui, st.progress, "書き出し");
  ukProgress(mut ui, -1.0, "解析中");
  ukBeginRow(mut ui, ui.theme.ctrlH, []);
  if (ukButton(mut ui, "情報の通知")) {
    ukToast(mut ui, "自動保存しました", 0);
  }
  if (ukButton(mut ui, "成功")) {
    ukToast(mut ui, "書き出しが終わりました", 1);
  }
  if (ukButton(mut ui, "注意")) {
    ukToast(mut ui, "素材が見つかりません: clip03.mp4", 2);
  }
  ukEndBox(mut ui);
  ukBeginRow(mut ui, ui.theme.ctrlH, []);
  if (ukButton(mut ui, "ダイアログを開く")) {
    ukOpenDialog(mut ui, "書き出し");
  }
  if (ukButton(mut ui, "進める")) {
    st.progress = Math.min(st.progress + 0.1, 1.0);
  }
  ukEndBox(mut ui);
}

function demoGallery(ui: mut UkCtx, st: mut DemoState, r: UkRect): void {
  ukDrawRect(mut ui, r, ui.theme.panel);
  ukBeginScroll(mut ui, "gallery", r);
  ukBeginColAt(mut ui, ukShrink(ukRest(ui), ui.theme.pad * 2));
  ukHeading(mut ui, "uikit の部品");
  ukTextDim(mut ui, "MozaicCut の画面の部品。Tab でフォーカスが動き、右クリックでメニューが出ます。");
  const colW = (ukRest(ui).w - ui.theme.pad * 4) / 3;
  ukBeginColumns(mut ui, [colW, colW, colW]);
  ukGap(mut ui, ui.theme.pad * 2);
  ukBeginGroup(mut ui, 0, 0);
  demoButtons(mut ui, mut st);
  demoChoices(mut ui, mut st);
  ukEndBox(mut ui);
  ukBeginGroup(mut ui, 0, 0);
  demoValues(mut ui, mut st);
  demoFeedback(mut ui, mut st);
  ukEndBox(mut ui);
  ukBeginGroup(mut ui, 0, 0);
  demoInputs(mut ui, mut st);
  ukSection(mut ui, "タブ");
  st.tab = ukTabs(mut ui, "tabs", ["エフェクト", "カラー", "オーディオ"], st.tab);
  ukTextDim(mut ui, `選んだタブ: ${st.tab}  ボタンを押した回数: ${st.clicks}`);
  ukEndBox(mut ui);
  ukEndBox(mut ui);
  ukEndBox(mut ui);
  ukEndScroll(mut ui);
  // ギャラリーの地を右クリック
  if (ukContextMenu(mut ui, "gallery-ctx", r)) {
    ukMenuItem(mut ui, "貼り付け", "Ctrl+V");
    ukMenuItem(mut ui, "すべて選択", "Ctrl+A");
    ukMenuSep(mut ui);
    if (ukBeginSubMenu(mut ui, "表示の大きさ")) {
      ukMenuItem(mut ui, "小", "");
      ukMenuItem(mut ui, "中", "");
      ukMenuItem(mut ui, "大", "");
      ukEndMenu(mut ui);
    }
    ukEndMenu(mut ui);
  }
}

function demoPanel(ui: mut UkCtx, st: mut DemoState, panel: i32, r: UkRect): void {
  ukPushClip(mut ui, r);
  if (panel == 0 || panel == 2) {
    // 10 万行の一覧（見えている行だけ描く）
    const n = 100000;
    const lr = ukBeginList(mut ui, "clips", ukShrink(r, ui.theme.pad), n, st.sel);
    st.sel = lr.sel;
    for (let i = lr.first; i < lr.last; i++) {
      let z = "";
      if (i % 60 < 10) {
        z = "0";
      }
      const h = ukListRow(mut ui, i, `clip${i + 1}.mp4    00:00:${z}${i % 60}:00`, i == st.sel);
      if (h.pressed) {
        st.sel = i;
      }
    }
    ukEndList(mut ui);
  } else if (panel == 1) {
    ukBeginColAt(mut ui, ukShrink(r, ui.theme.pad));
    ukTextLine(mut ui, "効果の一覧（見本）");
    ukTextDim(mut ui, "ぼかし / 色相 / 明るさ / クロップ / 拡大");
    ukEndBox(mut ui);
  } else if (panel == 3) {
    ukBeginColAt(mut ui, ukShrink(r, ui.theme.pad));
    ukBeginRow(mut ui, ui.theme.ctrlH, [0, 0, 0, -1, 0]);
    if (ukIconButton(mut ui, "再生##tl", st.playing ? UK_I_PAUSE : UK_I_PLAY, st.playing)) {
      st.playing = !st.playing;
    }
    ukIconButton(mut ui, "分割##tl", UK_I_CUT, false);
    st.frame = ukTimecode(mut ui, "位置##tl", st.frame, 30000, 1001);
    ukNext(mut ui, 10, 10);
    st.snap = ukToggle(mut ui, "スナップ##tl", st.snap);
    ukEndBox(mut ui);
    // トラックの見本
    const rest = ukRest(ui);
    const th = ui.theme.ctrlH + 6;
    for (let t = 0; t < 3; t++) {
      const tr = ukRect(rest.x, rest.y + t * (th + 2), rest.w, th);
      if (tr.y + tr.h > rest.y + rest.h) {
        break;
      }
      ukDrawRect(mut ui, tr, ui.theme.panelAlt);
      ukDrawTextIn(mut ui, ukRect(tr.x + 6, tr.y, 60, tr.h), `V${3 - t}`, ui.theme.fontSmall, ui.theme.textDim, 0);
      for (let c = 0; c < 4; c++) {
        const cx = tr.x + 70 + c * 180 + t * 40;
        if (cx + 160 < tr.x + tr.w) {
          const col: u32 = t == 2 ? 0xff3f7f5f : 0xff4a62a8;
          ukDrawRect(mut ui, ukRect(cx, tr.y + 3, 160, tr.h - 6), col);
          ukDrawTextIn(mut ui, ukRect(cx + 6, tr.y + 3, 150, tr.h - 6), `clip${t * 4 + c + 1}`, ui.theme.fontSmall, 0xffffffff, 0);
        }
      }
    }
    ukEndBox(mut ui);
  } else if (panel == 4) {
    ukBeginColAt(mut ui, ukShrink(r, ui.theme.pad));
    ukProgress(mut ui, st.progress, "書き出し中");
    ukTextDim(mut ui, "残り 1 分 20 秒");
    ukEndBox(mut ui);
  } else {
    ukBeginColAt(mut ui, ukShrink(r, ui.theme.pad));
    ukTextDim(mut ui, `前のフレーム ${ukFixed(st.lastMs, 2)} ms（平均 ${ukFixed(st.avgMs, 2)} ms）`);
    ukTextDim(mut ui, `部品 ${ui.statWidgets} 個、命令 ${ui.statCmds} 個、描き直し ${ui.statDirtyPx} 画素`);
    ukEndBox(mut ui);
  }
  ukPopClip(mut ui);
}

function demoDialog(ui: mut UkCtx, st: mut DemoState): void {
  if (ukBeginDialog(mut ui, "書き出し", 480, 300)) {
    ukTextLine(mut ui, "書き出しの設定");
    const nw = 96 * ui.theme.ctrlH / 26;
    ukBeginProp(mut ui, "ファイル名", nw);
    st.name = ukTextField(mut ui, "ファイル名##dlg", st.name);
    ukEndBox(mut ui);
    ukBeginProp(mut ui, "形式", nw);
    st.codec = ukDropdown(mut ui, "形式##dlg", ["H.264（MP4）", "H.265（MP4）", "ProRes 422（MOV）", "PNG の連番"], st.codec);
    ukEndBox(mut ui);
    st.audio = ukCheck(mut ui, "音声を書き出す##dlg", st.audio);
    ukBeginDialogFooter(mut ui, [-1, 100, 100]);
    ukNext(mut ui, 10, 10);
    if (ukButton(mut ui, "取り消し##dlg")) {
      ukCloseDialog(mut ui, "書き出し");
    }
    if (ukButtonPrimary(mut ui, "書き出す##dlg")) {
      ukCloseDialog(mut ui, "書き出し");
      ukToast(mut ui, "書き出しを始めました", 1);
    }
    ukEndBox(mut ui);
    ukEndDialog(mut ui);
  }
}

function demoFrame(ui: mut UkCtx, st: mut DemoState): void {
  const W = ui.W;
  const H = ui.H;
  const top = ui.theme.menuH + 4;
  const sb = ui.theme.rowH;
  const body = ukRect(0, top, W, H - top - sb);
  const sp = ukSplit(mut ui, "split-main", body, true, 0.24, 160, 400);
  const left = ukDockArea(mut ui, mut st.dock, 0, sp.a);
  demoPanel(mut ui, mut st, left.panel, left.content);
  const sp2 = ukSplit(mut ui, "split-right", sp.b, false, 0.66, 120, 100);
  demoGallery(mut ui, mut st, sp2.a);
  const bottom = ukDockArea(mut ui, mut st.dock, 1, sp2.b);
  demoPanel(mut ui, mut st, bottom.panel, bottom.content);
  // 状態の行
  const sr = ukRect(0, H - sb, W, sb);
  ukDrawRect(mut ui, sr, ui.theme.panelAlt);
  ukDrawTextIn(mut ui, ukRect(sr.x + ui.theme.pad, sr.y, sr.w - ui.theme.pad * 2, sr.h),
    `${ukFixed(st.lastMs, 2)} ms  部品 ${ui.statWidgets}  倍率 ${ukFixed(ui.theme.scale as f64, 2)}  ${W}x${H}`,
    ui.theme.fontSmall, ui.theme.textDim, 0);
  demoMenus(mut ui, mut st);
  demoDialog(mut ui, mut st);
}

// ---- 速さを測る画面（部品 300 個） ----

function benchFrame(ui: mut UkCtx, vals: mut f64[], flags: mut bool[], texts: mut string[]): void {
  const cols = 10;
  const rows = 30;
  const cw = (ui.W - 20) / cols;
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      const i = (r * cols + c) as usize;
      ukPushIdInt(mut ui, i as i32);
      const cell = ukRect(10 + c * cw, 10 + r * ((ui.H - 20) / rows), cw - 8, ui.theme.ctrlH);
      ukBeginColAt(mut ui, cell);
      const kind = (r + c) % 6;
      if (kind == 0) {
        ukButton(mut ui, `ボタン ${i}`);
      } else if (kind == 1) {
        flags[i] = ukCheck(mut ui, `チェック ${i}`, flags[i]);
      } else if (kind == 2) {
        vals[i] = ukSlider(mut ui, "s", vals[i], 0.0, 1.0, 0.01, 2);
      } else if (kind == 3) {
        flags[i] = ukToggle(mut ui, `トグル ${i}`, flags[i]);
      } else if (kind == 4) {
        vals[i] = ukNumber(mut ui, "n", vals[i], 0.0, 100.0, 1.0, 1);
      } else {
        const t = texts[i].clone();
        texts[i] = ukTextField(mut ui, "文字", t);
      }
      ukEndBox(mut ui);
      ukPopId(mut ui);
    }
  }
}

function runBench(ui: mut UkCtx, W: i32, H: i32): void {
  let px = new Buffer<u32>((W * H) as u32);
  let vals = new Array<f64>(300);
  let flags = new Array<bool>(300);
  let texts: string[] = [];
  for (let i = 0; i < 300; i++) {
    vals[i as usize] = ((i % 10) as f64) / 10.0;
    texts.push(`入力 ${i}`);
  }
  // 1 回目（文字の画像を作る分を含む）
  let t0 = clock();
  ukBegin(mut ui, W, H, 0.0);
  benchFrame(mut ui, mut vals, mut flags, mut texts);
  ukEnd(mut ui, mut px);
  const first = (clock() - t0) * 1000.0;
  const widgets = ui.statWidgets;
  // 全体を描き直す
  const N = 60;
  t0 = clock();
  for (let k = 0; k < N; k++) {
    ukInvalidate(mut ui);
    ukBegin(mut ui, W, H, 1.0);
    benchFrame(mut ui, mut vals, mut flags, mut texts);
    ukEnd(mut ui, mut px);
  }
  const full = (clock() - t0) * 1000.0 / (N as f64);
  const cmds = ui.statCmds;
  // 部品を作るだけ（描かない分）: 何も変わらないフレーム
  t0 = clock();
  for (let k = 0; k < N; k++) {
    ukBegin(mut ui, W, H, 1.0);
    benchFrame(mut ui, mut vals, mut flags, mut texts);
    ukEnd(mut ui, mut px);
  }
  const idle = (clock() - t0) * 1000.0 / (N as f64);
  // マウスを動かす（ホバーが変わった所だけ描き直す）
  let dirty: i64 = 0;
  t0 = clock();
  for (let k = 0; k < N; k++) {
    ukEventMouseMove(mut ui, 20 + (k * 23) % (W - 40), 15 + (k * 37) % (H - 30));
    ukBegin(mut ui, W, H, 1.0);
    benchFrame(mut ui, mut vals, mut flags, mut texts);
    dirty += ukEnd(mut ui, mut px) as i64;
  }
  const hover = (clock() - t0) * 1000.0 / (N as f64);
  print(`{"size":"${W}x${H}","widgets":${widgets},"cmds":${cmds},"firstMs":${ukFixed(first, 2)},"fullMs":${ukFixed(full, 2)},"idleMs":${ukFixed(idle, 2)},"hoverMs":${ukFixed(hover, 2)},"hoverDirtyPx":${dirty / (N as i64)}}`);
}

// ---- 試しの入力 ----

struct DemoEv {
  frame: i64;
  kind: i32;   // 1 move, 2 click, 3 rclick, 4 key, 5 text, 6 wheel, 7 down, 8 up
  x: i32;
  y: i32;
  key: i32;
  mods: i32;
  text: string;
}

function demoInt(s: string, a: usize, b: usize): i64 {
  let v: i64 = 0;
  let neg = false;
  for (let i = a; i < b; i++) {
    if (s[i] == 45) {
      neg = true;
    } else if (s[i] >= 48 && s[i] <= 57) {
      v = v * 10 + ((s[i] - 48) as i64);
    }
  }
  return neg ? -v : v;
}

function demoFind(s: string, b: u8): i64 {
  let at: i64 = -1;
  for (let i: usize = 0; i < s.length; i++) {
    if (s[i] == b) {
      at = i as i64;
    }
  }
  return at;
}

function demoSub(s: string, a: usize, b: usize): string {
  let out: u8[] = [];
  for (let i = a; i < Math.min(b, s.length); i++) {
    out.push(s[i]);
  }
  return stringFromBytes(out);
}

function demoKeyName(n0: string, mods: mut i32[]): i32 {
  let n = n0.clone();
  mods[0] = 0;
  while (true) {
    if (n.length > 6 && demoSub(n, 0, 6) == "shift+") {
      mods[0] = mods[0] | UK_MOD_SHIFT;
      n = demoSub(n, 6, n.length);
    } else if (n.length > 5 && demoSub(n, 0, 5) == "ctrl+") {
      mods[0] = mods[0] | UK_MOD_CTRL;
      n = demoSub(n, 5, n.length);
    } else {
      break;
    }
  }
  switch (n) {
    case "tab": return UK_KEY_TAB;
    case "enter": return UK_KEY_ENTER;
    case "esc": return UK_KEY_ESC;
    case "left": return UK_KEY_LEFT;
    case "right": return UK_KEY_RIGHT;
    case "up": return UK_KEY_UP;
    case "down": return UK_KEY_DOWN;
    case "home": return UK_KEY_HOME;
    case "end": return UK_KEY_END;
    case "pgup": return UK_KEY_PGUP;
    case "pgdn": return UK_KEY_PGDN;
    case "backspace": return UK_KEY_BACKSPACE;
    case "delete": return UK_KEY_DELETE;
    case "space": return UK_KEY_SPACE;
  }
  if (n.length >= 2 && n[0] == 102 && n[1] >= 48 && n[1] <= 57) {
    return UK_KEY_F + (demoInt(n, 1, n.length) as i32);
  }
  if (n.length == 1) {
    return UK_KEY_CHAR + (n[0] as i32);
  }
  return 0;
}

// "x,y@F" や "名前@F" を読む。
function demoParseEv(opt: string, val: string, out: mut DemoEv[]): bool {
  const at = demoFind(val, 64);
  if (at < 0) {
    return false;
  }
  const body = demoSub(val, 0, at as usize);
  const frame = demoInt(val, (at as usize) + 1, val.length);
  let ev: DemoEv = { frame, kind: 0, x: 0, y: 0, key: 0, mods: 0, text: "" };
  const comma = demoFind(body, 44);
  if (comma >= 0) {
    ev.x = demoInt(body, 0, comma as usize) as i32;
    ev.y = demoInt(body, (comma as usize) + 1, body.length) as i32;
  }
  if (opt == "--move") {
    ev.kind = 1;
  } else if (opt == "--click") {
    ev.kind = 2;
  } else if (opt == "--rclick") {
    ev.kind = 3;
  } else if (opt == "--key") {
    ev.kind = 4;
    let m: i32[] = [0];
    ev.key = demoKeyName(body, mut m);
    ev.mods = m[0];
  } else if (opt == "--type") {
    ev.kind = 5;
    ev.text = body;
  } else if (opt == "--wheel") {
    ev.kind = 6;
    ev.y = demoInt(body, 0, body.length) as i32;
  } else if (opt == "--down") {
    ev.kind = 7;
  } else if (opt == "--up") {
    ev.kind = 8;
  } else {
    return false;
  }
  out.push(ev);
  return true;
}

// t は入力の時刻（ukBegin に渡す now と同じ時計。ダブルクリックの判定に使う）。
function demoApplyEv(ui: mut UkCtx, e: DemoEv, t: f64): void {
  if (e.kind == 1) {
    ukEventMouseMove(mut ui, e.x, e.y);
  } else if (e.kind == 2) {
    ukEventMouseButtonAt(mut ui, e.x, e.y, 1, true, t);
    ukEventMouseButtonAt(mut ui, e.x, e.y, 1, false, t);
  } else if (e.kind == 3) {
    ukEventMouseButtonAt(mut ui, e.x, e.y, 3, true, t);
    ukEventMouseButtonAt(mut ui, e.x, e.y, 3, false, t);
  } else if (e.kind == 4) {
    ukEventKey(mut ui, e.key, e.mods);
  } else if (e.kind == 5) {
    for (const cp of decodeUtf8(e.text)) {
      ukEventText(mut ui, cp as u32);
    }
  } else if (e.kind == 6) {
    ukEventWheel(mut ui, 0, e.y);
  } else if (e.kind == 7) {
    ukEventMouseButtonAt(mut ui, e.x, e.y, 1, true, t);
  } else if (e.kind == 8) {
    ukEventMouseButtonAt(mut ui, e.x, e.y, 1, false, t);
  }
}

export function main(): i32 {
  const a = args();
  let W: i32 = 1440;
  let H: i32 = 900;
  let scale: f32 = 1.0;
  let maxFrames: i64 = -1;
  let shot = "";
  let tokens = "";
  let bench = false;
  let evs: DemoEv[] = [];
  let i: usize = 0;
  while (i < a.length) {
    const opt = a[i].clone();
    let val = "";
    if (i + 1 < a.length) {
      val = a[i + 1].clone();
    }
    if (opt == "--bench") {
      bench = true;
      i += 1;
      continue;
    }
    if (opt == "--size") {
      const x = demoFind(val, 120);
      if (x > 0) {
        W = demoInt(val, 0, x as usize) as i32;
        H = demoInt(val, (x as usize) + 1, val.length) as i32;
      }
    } else if (opt == "--scale") {
      scale = (demoInt(val, 0, val.length) as f32);
      const dot = demoFind(val, 46);
      if (dot >= 0) {
        const ip = demoInt(val, 0, dot as usize) as f32;
        const fp = demoSub(val, (dot as usize) + 1, val.length);
        let f = demoInt(fp, 0, fp.length) as f32;
        for (let k: usize = 0; k < fp.length; k++) {
          f = f / 10.0;
        }
        scale = ip + f;
      }
    } else if (opt == "--frames") {
      maxFrames = demoInt(val, 0, val.length);
    } else if (opt == "--shot") {
      shot = val;
    } else if (opt == "--tokens") {
      tokens = val;
    } else if (!demoParseEv(opt, val, mut evs)) {
      eprint(`warning: unknown option '${opt}'`);
    }
    i += 2;
  }
  let theme = ukThemeDefault(scale);
  if (tokens.length > 0) {
    const tj = readFile(tokens);
    if (tj != null) {
      const n = ukThemeFromTokens(mut theme, stringFromBytes(tj));
      eprint(`tokens: ${n} 個の値を読みました`);
    } else {
      eprint(`warning: cannot read '${tokens}'`);
    }
  }
  let ui = ukNew(theme, own uiFont());
  if (bench) {
    runBench(mut ui, W, H);
    return 0;
  }
  const opened = windowOpen("uikit の見本", W, H);
  if (opened == null) {
    eprint("error: could not open a window");
    return 1;
  }
  const win = opened;
  let px = new Buffer<u32>((W * H) as u32);
  let st = demoNew();
  let running = true;
  let frames: i64 = 0;
  const fixedTime = maxFrames >= 0;
  while (running) {
    let res = ukWinResNew();
    let first = true;
    while (true) {
      // 何も変わらなければ、次に描くべき時刻（カーソルの点滅・ツールチップ・通知）か入力が来るまで眠る
      let to: i32 = 0;
      if (first && !fixedTime) {
        to = ukNextFrameMs(ui);
      }
      first = false;
      const e = pollWindowEvent(to);
      if (e == null) {
        break;
      }
      ukFeedWindowEvent(mut ui, e, mut res);
    }
    let evT = clock();
    if (fixedTime) {
      evT = (frames as f64) / 60.0;
    }
    for (const ev of evs) {
      if (ev.frame == frames) {
        demoApplyEv(mut ui, ev, evT);
      }
    }
    if (res.quit) {
      running = false;
    }
    if (res.resized && (res.w != W || res.h != H)) {
      W = res.w;
      H = res.h;
      px = new Buffer<u32>((W * H) as u32);
    }
    let now = clock();
    if (fixedTime) {
      now = (frames as f64) / 60.0;
    }
    const t0 = clock();
    ukBegin(mut ui, W, H, now);
    demoFrame(mut ui, mut st);
    ukEnd(mut ui, mut px);
    ukWindowSync(mut ui, win);
    st.lastMs = (clock() - t0) * 1000.0;
    st.avgMs = st.avgMs * 0.9 + st.lastMs * 0.1;
    if (st.playing) {
      st.frame = st.frame + 1;
    }
    windowPresent(win, px, W, H);
    frames++;
    if (maxFrames >= 0 && frames >= maxFrames) {
      running = false;
    }
  }
  if (shot.length > 0) {
    if (!ukWriteBmp(shot, px, W, H)) {
      eprint(`error: cannot write '${shot}'`);
    }
  }
  windowClose(win);
  return 0;
}
