// @transition dissolve "前の映像と次の映像を滑らかに重ねて切り替える"

kernel function trDissolveKernel(i: u32, a: mut Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, p: f32): void {
  const ca = a[i];
  const cb = b[i];
  const q = 1.0 - p;
  a[i] = vec4(ca.x * q + cb.x * p, ca.y * q + cb.y * p, ca.z * q + cb.z * p, ca.w * q + cb.w * p);
}

export function tr_dissolve(
  a: mut Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, w: u32, h: u32,
  progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const n = w * h;
  if (n == 0) {
    return;
  }
  const p = Math.min(Math.max(progress, 0.0), 1.0);
  dispatch(trDissolveKernel, n, mut a, b, p);
}
