// @transition dipwhite "一度白に飛ばしてから次の映像を出す"

kernel function trDipWhiteKernel(i: u32, a: mut Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, p: f32): void {
  if (p < 0.5) {
    const t = p * 2.0;
    const ca = a[i];
    const q = 1.0 - t;
    a[i] = vec4(ca.x * q + t, ca.y * q + t, ca.z * q + t, Math.max(ca.w, t));
  } else {
    const t = (p - 0.5) * 2.0;
    const cb = b[i];
    const q = 1.0 - t;
    a[i] = vec4(q + cb.x * t, q + cb.y * t, q + cb.z * t, Math.max(cb.w, q));
  }
}

export function tr_dipwhite(
  a: mut Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, w: u32, h: u32,
  progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const n = w * h;
  if (n == 0) {
    return;
  }
  const p = Math.min(Math.max(progress, 0.0), 1.0);
  dispatch(trDipWhiteKernel, n, mut a, b, p);
}
