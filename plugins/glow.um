// @effect glow "明るい部分をふんわり発光させる（ブルーム）"
// @param amount 0.6 0..2 "発光の強さ（0 で何もしない）"
// @param radius 6 1..24 "光の広がりの半径（画素。小数は四捨五入）"
// @param cutoff 0.45 0..0.95 "発光が始まる明るさの境目"
// @alias bloom
// @reach radius 1 round

// 横方向: 境目より明るい部分を取り出してプリマルチプライで箱ぼかしする。
kernel function glowH(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, w: u32, r: i32, cut: f32): void {
  const x = (i % w) as i32;
  const row = i - (x as u32);
  const last = (w as i32) - 1;
  const span = Math.max(1.0 - cut, 0.01);
  const inv = 1.0 / ((2 * r + 1) as f32);
  let acc = vec4(0.0, 0.0, 0.0, 0.0);
  for (let k = -r; k <= r; k++) {
    const xx = Math.min(Math.max(x + k, 0), last);
    const c = src[row + (xx as u32)];
    const y = 0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z;
    const m = Math.max((y - cut) / span, 0.0) * c.w;
    acc = acc + vec4(c.x * m, c.y * m, c.z * m, m);
  }
  dst[i] = acc * inv;
}

// 縦方向: 横の結果を縦に平均し、元の層へ加算して重ねる（透明な周りにも光が漏れる）。
kernel function glowV(i: u32, layer: mut Buffer<vec4<f32>>, hbuf: Buffer<vec4<f32>>, w: u32, h: u32, r: i32, amt: f32): void {
  const x = i % w;
  const y = (i / w) as i32;
  const last = (h as i32) - 1;
  const inv = 1.0 / ((2 * r + 1) as f32);
  let acc = vec4(0.0, 0.0, 0.0, 0.0);
  for (let k = -r; k <= r; k++) {
    const yy = Math.min(Math.max(y + k, 0), last);
    acc = acc + hbuf[(yy as u32) * w + x];
  }
  const g = acc * (inv * amt);
  const c = layer[i];
  const baseR = c.x * c.w + g.x;
  const baseG = c.y * c.w + g.y;
  const baseB = c.z * c.w + g.z;
  const outA = Math.min(Math.max(c.w + g.w * (1.0 - c.w), 0.0), 1.0);
  if (outA <= 0.0) {
    layer[i] = vec4(0.0, 0.0, 0.0, 0.0);
    return;
  }
  layer[i] = vec4(
    Math.min(Math.max(baseR / outA, 0.0), 1.0),
    Math.min(Math.max(baseG / outA, 0.0), 1.0),
    Math.min(Math.max(baseB / outA, 0.0), 1.0),
    outA,
  );
}

export function fx_glow(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  if (p[0] <= 0.0) {
    return;
  }
  const r = Math.max(Math.floor(p[1] + 0.5) as i32, 1);
  dispatch(glowH, w * h, mut tmp, layer, w, r, p[2]);
  dispatch(glowV, w * h, mut layer, tmp, w, h, r, p[0]);
}
