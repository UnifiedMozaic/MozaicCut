// @effect gray "白黒にする（彩度を 1 - amount にする）"
// @param amount 1 0..1 "強さ（1 で完全な白黒、0 でそのまま）"
// @alias grey
//
// 輝度は BT.709。色の効果なので、アルファは変えない。結果は 0..1 に収める。

kernel function grayKernel(i: u32, layer: mut Buffer<vec4<f32>>, p: f32[8]): void {
  const c = layer[i];
  const s = 1.0 - p[0];
  const l = 0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z;
  layer[i] = vec4(
    Math.min(Math.max(l + (c.x - l) * s, 0.0), 1.0),
    Math.min(Math.max(l + (c.y - l) * s, 0.0), 1.0),
    Math.min(Math.max(l + (c.z - l) * s, 0.0), 1.0),
    c.w,
  );
}

export function fx_gray(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  dispatch(grayKernel, w * h, mut layer, p);
}
