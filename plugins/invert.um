// @effect invert "色を反転する"
// @param amount 1 0..1 "強さ（1 で 1 - 色、0.5 で一面の灰色、0 でそのまま）"
//
// 色の効果なので、アルファは変えない。結果は 0..1 に収める。

kernel function invertKernel(i: u32, layer: mut Buffer<vec4<f32>>, p: f32[8]): void {
  const c = layer[i];
  const a = p[0];
  layer[i] = vec4(
    Math.min(Math.max(c.x + (1.0 - 2.0 * c.x) * a, 0.0), 1.0),
    Math.min(Math.max(c.y + (1.0 - 2.0 * c.y) * a, 0.0), 1.0),
    Math.min(Math.max(c.z + (1.0 - 2.0 * c.z) * a, 0.0), 1.0),
    c.w,
  );
}

export function fx_invert(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  dispatch(invertKernel, w * h, mut layer, p);
}
