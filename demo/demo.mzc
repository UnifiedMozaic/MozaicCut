# MozaicCut のデモ。node tools/mozcut.mjs render demo/demo.mzc で demo/demo.mp4 を書き出す。
# id= を付けたクリップは、操作（node tools/mozcut.mjs op demo/demo.mzc move clip_b 5.5 など）と
# 参照（at=clip_b.start+1.5、at=after:clip_a）で名前で指せる。
project size=1280x720 fps=30 rate=48000 bg=101018 output=demo.mp4

# 0 番トラック: タイトルの背景 → クリップ A → クリップ B（1 秒のクロスフェード）
color 202040 id=intro dur=2 fadeout=0.5 vignette=0.7
video "media/clip_a.mp4" id=clip_a in=1 out=5 fadein=0.5
video "media/clip_b.mp4" id=clip_b in=0.5 out=4.5 xfade=1 sat=1.4 contrast=1.1 vignette=0.4 fadeout=1

# 効果の見本: 右下にモザイク＋セピアの小窓（ピクチャー・イン・ピクチャー）。効果は書いた順に掛かる
video "media/clip_a.mp4" id=pip track=3 at=clip_a.start+1 in=2 dur=3 w=320 h=180 x=-24 y=-24 pixelate=8 sepia=0.8 fade=0.3 mute

# ロゴ（透過 PNG）を左上に。クリップ A の始まりから最後まで
image "media/logo.png" id=logo at=clip_a.start dur=8.5 x=24 y=24 w=96 opacity=0.85 fade=0.5

# 文字（size は画素。フォントの em の大きさ）
text "MozaicCut" id=title at=0.2 dur=1.6 size=96 color=ffffff outline=303080 outlinew=5 shadow=00000099 fade=0.3
text "Written in UnifiedMozaic" id=subtitle at=0.6 dur=1.2 y=470 size=32 color=c0c0ff fade=0.3
text "Clip A: testsrc2\n小窓: pixelate + sepia" id=caption_a at=clip_a.start+0.5 dur=3 x=40 y=-40 size=26 bg=000000a0 pad=12 fade=0.25
text "Clip B: mandelbrot\nsat=1.4 vignette=0.4" id=caption_b at=clip_b.start+1.5 dur=3 x=40 y=-40 size=26 bg=000000a0 pad=12 fade=0.25

# BGM（全体に薄く、最後は 2 秒で下げる）
audio "media/bgm.wav" id=bgm at=0 dur=10.5 volume=0.25 fadein=1 fadeout=2
