# M6 テキストアニメーターの見本。node tools/mozcut.mjs preview demo/m6/textanim.mzc 0.8 -o shot.png
# text の行に anim=<プリセット> と anim.<引数>=<値> を書く（anim2〜anim4 で重ね、animout は終わりから数える）。
project size=1280x720 fps=30 bg=181020

text "Hello World" id=hello at=0 dur=4 y=120 size=96 anim=bounce animout=fadein animout.dur=0.3
text "こんにちは 世界" id=jp at=0 dur=4 y=280 size=72 anim=rise anim.by=word anim.stagger=0.25
text "SALE 50% OFF" id=sale at=0 dur=4 y=430 size=110 color=ffd040 outline=402000 outlinew=5 anim.mode=range anim.start="0@0 100@1.2:ease" anim.opacity=0 anim2=wave anim2.loop=1.5
text "colorwave" id=cw at=0 dur=4 y=580 size=80 anim=colorwave x="-500@0:easeout 400@1"
