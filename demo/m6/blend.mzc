# M6 描画モード・マスク・トラックマットの見本。node tools/mozcut.mjs preview demo/m6/blend.mzc 1 -o shot.png
project size=1280x720 fps=30 bg=101018 blend.space=linear

# 背景の映像
video "../media/clip_b.mp4" id=bg dur=4

# 左: 映像を楕円のマスクで抜き、ぼかした縁で重ねる（座標は 1280x720 の層の画素。ref= で層の大きさを書く）
video "../media/clip_a.mp4" id=pip track=1 at=0 dur=4 w=640 h=360 x=40 y=40
mask ellipse to=pip ref=640x360 x=40 y=20 w=560 h=320 feather=60
mask rect to=pip ref=640x360 x=260 y=140 w=120 h=80 round=20 mode=subtract feather=8

# 右上: 加算（スクリーン）で重ねる光
color ffb040 id=glow track=2 at=0 dur=4 w=400 h=400 x=820 y=20 blend=screen
mask ellipse to=glow units=norm x=0.1 y=0.1 w=0.8 h=0.8 feather=0.3

# 下: 文字の形に映像を抜く（トラックマット。文字は画面に描かない）
text "MATTE" id=word track=3 at=0 dur=4 size=220 y=440 color=ffffff
video "../media/clip_a.mp4" id=fill track=4 at=0 dur=4 matte=word

# 右下: 乗算の四角
color 4080ff id=mul track=5 at=0 dur=4 w=300 h=200 x=900 y=480 blend=multiply
