# M6 キーフレームの見本。node tools/mozcut.mjs preview demo/m6/anim.mzc 1.5 -o shot.png
# 値に「値@時刻[:印]」を空白で並べる（"..." で囲む）。時刻はクリップの始まりからの秒、45f はコマ、end は終わりから。
project size=1280x720 fps=30 bg=101018 vignette="0@0 0.8@6"

# 背景の映像: timeremap で、最初の 2 秒をゆっくり進めて 2〜4 秒は止め、最後は逆に戻す
video "../media/clip_a.mp4" id=bgclip dur=6 timeremap="0@0 2@2:ease 2@4 0@6" sat="1@0 0@3"

# 左の画面の外から入って止まる四角（x は左上からの画素。負は画面の外）
color ff8000 id=box track=1 at=0 dur=6 w=160 h=160 x="-200@0 180@1.5:ease 180@4 1300@6:easein" y=120 opacity="0@0 1@0.3 1@end-0.5 0@end"

# 経路で動くロゴ（pos は x,y。curve で前後のキーからなめらかに曲げる）
image "../media/logo.png" id=logo track=2 at=0 dur=6 w=128 pos="900,100@0 1000,400@2:curve 700,560@4:curve 400,300@6"

# 色と大きさのぼかしが動く文字
text "Keyframes" id=title track=3 at=0 dur=6 size=110 y=520 color="ffffff@0 ffd060@3 60c0ff@6" blur="12@0:easeout 0@1" outline=000000 outlinew=4
