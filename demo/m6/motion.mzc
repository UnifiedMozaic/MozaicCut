# M6 モーショントラッキングの見本。映像の中の点を追い、その動きを別のクリップの位置のキーフレームにする:
#   node tools/mozcut.mjs motion demo/m6/motion.mzc bg 760,420 --to tag
# （bg の始まりのコマで画面の (760,420) にある模様を追い、tag の pos= に 1 コマごとのキーを書く。書いたあとは
#   key の操作や .mzc の編集でキーを直せる）
project size=1280x720 fps=30 bg=000000

video "../media/clip_b.mp4" id=bg dur=3
color ff3080 id=tag track=1 at=0 dur=3 w=40 h=40 x=740 y=400 opacity=0.7
