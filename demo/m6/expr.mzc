# M6 エクスプレッション（式）の見本。node tools/mozcut.mjs preview demo/m6/expr.mzc 1.5 -o shot.png
# 値に x="expr(...)" と書くと、その値を式で決める。x.expr="..." はキーの値（value）に重ねる。clip('ID') でほかのクリップの値。
# 式の x / y はクリップの左上の画素（center や右端からの読み替えはしない）。
project size=1280x720 fps=30 bg=101018

# 左から入ってきて止まる箱（ease）と、上下に揺れる（wiggle は決まった結果の乱数）
color 3070e0 id=title track=1 at=0 dur=4 w=320 h=120 x="expr(ease(time, 0, 1.5, -400, 200))" y=200 y.expr="wiggle(3, 20)"

# title に付いて回る点（ほかのクリップの値を読む）
color e05030 id=dot track=2 at=0 dur=4 w=40 h=40 x="expr(clip('title').x + 360 + 80 * cos(time * 6))" y="expr(clip('title').y + 40 + 80 * sin(time * 6))"

# キーフレームに式を重ねる（ping-pong でくり返す点滅）
color 30c070 id=blink track=3 at=0 dur=4 w=80 h=80 x=900 y=480 opacity="0@0 1@0.5:ease" opacity.expr="loopOut('pingpong')"

# 効果の引数を式で
text "EXPRESSION" id=label track=4 at=0 dur=4 size=90 y=560 color=ffffff blur="expr(4 + 4 * sin(time * 4))"
