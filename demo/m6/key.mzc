# M6 キーイングの見本。node tools/mozcut.mjs preview demo/m6/key.mzc 1 -o shot.png
# chromakey はキーの色（chromakey.r / g / b）に近い色を透明にする。lumakey は暗い所（invert=1 なら明るい所）を透明にする。
project size=1280x720 fps=30 bg=000000

# 背景
video "../media/clip_b.mp4" id=bg dur=4

# カラーバーの緑の帯をキーにして抜く（下の映像が透けて見える）
video "../media/clip_a.mp4" id=bars track=1 at=0 dur=4 w=640 h=360 x=0 y=0 chromakey chromakey.r=0 chromakey.g=1 chromakey.b=0 chromakey.tolerance=0.4

# 確かめる用: 同じキーのアルファを市松模様の上に見せる
video "../media/clip_a.mp4" id=check track=2 at=0 dur=4 w=640 h=360 x=640 y=0 chromakey chromakey.r=0 chromakey.g=1 chromakey.b=0 chromakey.tolerance=0.4 matteview=2

# 下: 暗い所を抜く（lumakey）
video "../media/clip_a.mp4" id=luma track=3 at=0 dur=4 w=640 h=360 x=320 y=360 lumakey=0.3
