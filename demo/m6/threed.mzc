# M6 3D レイヤーとカメラの見本。node tools/mozcut.mjs preview demo/m6/threed.mzc 2 -o shot.png
# z / ox / oy / rx / ry を書いた行は 3D のレイヤーになる。回転は度、z は奥が正。カメラとライトは project の行。
project size=1280x720 fps=30 bg=101018 camera.z="-2600@0 -1800@4" light.type=point light.z=-800 light.y=-300

# 床のように倒した映像（rx で奥へ倒す）
video "../media/clip_b.mp4" id=floor at=0 dur=4 w=960 h=540 rx=70 oy=260 z=200

# 回る小窓（ry をキーフレームで。mblur でモーションブラー）
video "../media/clip_a.mp4" id=card track=1 at=0 dur=4 w=640 h=360 z=-100 ry="0@0 180@4" mblur

# 手前を横切る文字
text "3D LAYER" id=title track=2 at=0 dur=4 size=120 color=ffd040 z="-600@0 -200@4" ox="-300@0 300@4" rx=-15
