# M6 シェイプ（ベクターの図形）の見本。node tools/mozcut.mjs preview demo/m6/shape.mzc 2 -o shot.png
# 行の 2 番目が形の種類（rect / ellipse / polygon / star / path）。x / y はほかのクリップと同じく形の箱の左上、
# pos=x,y は anchor（既定は形の中心）を置く画面の点。
project size=1280x720 fps=30 bg=101828

# 回る星（グラデーションの塗りと線。rotation と scale をキーフレームで動かす）
shape star id=star points=5 r=160 inner=70 pos=320,360 fill="linear(#ffd040,#ff6020)" stroke=#202020 strokew=6 join=round rotation="0@0 144@4:ease" scale="0.6@0:easeout 1@1" at=0 dur=4

# 線を描いていく角丸の四角（drawon）と破線
shape rect id=frame w=480 h=270 radius=32 pos=900,220 fill=none stroke=white strokew=8 cap=round drawon=1.5 at=0 dur=4
shape ellipse id=ring w=300 h=300 pos=900,560 fill=none stroke=#60c0ff strokew=6 dash=24,14 cap=round trimend="0@0 1@3" at=0 dur=4

# リピーター: 小さな円を輪に並べる
shape ellipse id=dots w=24 h=24 anchor=0,-120 pos=320,360 repeat=12 repeatrot=30 repeatopend=0.2 fill="radial(white,#3060ff)" track=3 at=0 dur=4 opacity=0.9

# パス（SVG の d）を左から右へ動かす（x のキーフレームは左上からの画素）
shape path id=wave d="M 0 0 C 60 -80 120 80 180 0 S 300 -80 360 0" fill=none stroke=#80ff80 strokew=10 cap=round x="-400@0 900@4" y=620 at=0 dur=4 blur=1
