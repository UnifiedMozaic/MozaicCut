# M6 パーティクルの見本。node tools/mozcut.mjs preview demo/m6/particles.mzc 2 -o shot.png
# particles の行の x / y は発生源の中心（center か数。負の数は端から、画面の外は -200px のように px を付ける）。
project size=1280x720 fps=30 bg=080810

# 下から吹き上がる火花（加算）
particles id=sparks at=0 dur=5 emit=point x=320 y=680 rate=400 speed=420 dir=-90 spread=22 gravity=420 life=1.6 size=7 size.end=2 color=ffd27a color.end=ff3a1a opacity.out=0.4 draw=soft blend=add seed=7

# 円から外へ広がる輪（burst）
particles id=ring at=0 dur=5 emit=circle x=960 y=260 radius=60 burst=400 rate=0 speed=160 dir.mode=out life=3 size=5 color=80c0ff draw=ring blend=add seed=3

# 文字の形から出る塵（emit=layer）
text "PARTICLES" id=title track=1 at=0 dur=5 size=120 y=480 color=ffffff opacity=0.25
particles id=dust track=3 at=0 dur=5 emit=layer layer=title rate=3000 speed=30 turb=300 turb.scale=40 life=1.2 size=3 color=c0e0ff blend=add seed=11
