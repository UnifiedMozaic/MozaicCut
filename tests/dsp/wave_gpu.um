// 波形の縮約の kernel を CPU（cpu.dispatch）と GPU（gpu.dispatch）で実行して、結果がビットまで同じことを確かめる。
// UM_WGPU=1（wgpu-native）か UM_METAL=1 でビルドしたときだけ使う（tests/dsp/run.mjs が、見つかれば実行する）。
import { dspWaveBlockKernel, DSP_WAVE_BLOCK } from "./dsp/wave.um";

export function main(): i32 {
  const frames: u32 = 48000 * 10 + 77;
  let x = new Buffer<f32>((frames * 2) as usize);
  let s: u32 = 12345;
  for (let i: u32 = 0; i < frames * 2; i++) {
    s = s * 1664525 + 1013904223;
    x[i] = (((s >> 8) as f32) / 16777216.0 - 0.5) * 1.5;
  }
  const cnt = (frames + DSP_WAVE_BLOCK - 1) / DSP_WAVE_BLOCK;
  let a = new Buffer<vec4<f32>>((cnt * 2) as usize);
  let b = new Buffer<vec4<f32>>((cnt * 2) as usize);
  cpu.dispatch(dspWaveBlockKernel, cnt * 2, mut a, x, frames, DSP_WAVE_BLOCK);
  gpu.dispatch(dspWaveBlockKernel, cnt * 2, mut b, x, frames, DSP_WAVE_BLOCK);
  let diff: u32 = 0;
  for (let i: usize = 0; i < (cnt * 2) as usize; i++) {
    const p = a[i];
    const q = b[i];
    if (p.x != q.x || p.y != q.y || p.z != q.z || p.w != q.w) {
      diff += 1;
    }
  }
  print(`blocks ${cnt * 2}`);
  print(`diff ${diff}`);
  return 0;
}
