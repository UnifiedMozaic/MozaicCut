// src/engine/subtitle.um の試し用のプログラム（tests/subtitle/run.mjs が src/ の写しの隣に置いてビルドする）。
//
//   subtitle_test parse <字幕のファイル>                       読んだ字幕と診断の JSON
//   subtitle_test tomzc <字幕> <幅> <高さ> <前置き> <ずらす秒> [id,id,...|-] [marginY]   .mzc の text の行（1 行に 1 つ。
//                                                             診断があれば最後に "#diags <JSON>" の行）
//   subtitle_test write <字幕> <出力> <srt|vtt> <lf|crlf>     読んで書き直す（番号の振り直し。SRT → SRT 以外は画面に出す文字で）
//   subtitle_test mzc <project.mzc> <出力> <srt|vtt> [トラック]  .mzc の text のクリップから字幕を書く。診断は JSON で標準出力に
//   subtitle_test time <時刻> <srt|vtt>                        時刻の読み取り（秒。読めなければ NaN）と書き戻し
import { splitBy, parseNum } from "./engine/text.um";
import { Probe, Diag } from "./engine/project.um";
import { jsonStr, jsonNum, diagsJson } from "./engine/report.um";
import {
  SubtitleCue, SubtitleDoc, SubtitleStyle, subtitleParse, subtitlePlain, subtitleIsTop, subtitleToMzc,
  subtitleDefaultStyle, subtitleWriteSrt, subtitleWriteVtt, subtitleSrtFromMzc, subtitleVttFromMzc,
  subtitleParseTime, subtitleTimeText, subtitlePlainCues,
} from "./engine/subtitle.um";

function sttCuesJson(doc: SubtitleDoc): string {
  const vtt = doc.format == "vtt";
  let s = `{"format":${jsonStr(doc.format)},"cues":[`;
  let i = 0;
  for (const c of doc.cues) {
    if (i > 0) {
      s = s + ",";
    }
    i++;
    s = s + `{"index":${c.index},"ident":${jsonStr(c.ident)},"start":${jsonNum(c.start)},"end":${jsonNum(c.end)}`;
    s = s + `,"text":${jsonStr(c.text)},"plain":${jsonStr(subtitlePlain(c.text, vtt))},"line":${c.line}`;
    s = s + `,"settings":${jsonStr(c.settings)},"top":${subtitleIsTop(c)}}`;
  }
  return s + "]";
}

export function main(): i32 {
  const a = args();
  if (a.length < 1) {
    eprint("使い方: subtitle_test parse|tomzc|write|mzc|time ...");
    return 2;
  }
  const cmd = a[0].clone();
  if (cmd == "time") {
    const vtt = a[2] == "vtt";
    const t = subtitleParseTime(a[1], vtt);
    if (t != t) {
      print("NaN");
    } else {
      print(`${t} ${subtitleTimeText(t, vtt)}`);
    }
    return 0;
  }
  if (cmd == "mzc") {
    const bytes = readFile(a[1]);
    if (bytes == null) {
      eprint("読めません");
      return 1;
    }
    let track: i32 = -1;
    if (a.length > 4) {
      track = parseNum(a[4]) as i32;
    }
    let diags: Diag[] = [];
    let probes: Probe[] = [];
    let text = "";
    if (a[3] == "vtt") {
      text = subtitleVttFromMzc(bytes, probes, track, false, mut diags);
    } else {
      text = subtitleSrtFromMzc(bytes, probes, track, false, mut diags);
    }
    let out: u8[] = [];
    for (const b of text) {
      out.push(b);
    }
    writeFile(a[2], out);
    print(diagsJson(diags));
    return 0;
  }
  const bytes = readFile(a[1]);
  if (bytes == null) {
    eprint("読めません");
    return 1;
  }
  let diags: Diag[] = [];
  const doc = subtitleParse(bytes, a[1], mut diags);
  if (cmd == "parse") {
    print(sttCuesJson(doc) + `,"diagnostics":${diagsJson(diags)}}`);
    return 0;
  }
  if (cmd == "tomzc") {
    const w = parseNum(a[2]) as i32;
    const h = parseNum(a[3]) as i32;
    let style = subtitleDefaultStyle(w, h);
    let taken: string[] = [];
    if (a.length > 6 && a[6] != "-") {
      taken = splitBy(a[6], 44);
    }
    if (a.length > 7) {
      style.marginY = parseNum(a[7]) as i32;
    }
    let md: Diag[] = [];
    const lines = subtitleToMzc(doc, style, a[4], parseNum(a[5]), taken, mut md);
    for (const l of lines) {
      print(l);
    }
    if (md.length > 0) {
      print(`#diags ${diagsJson(md)}`);
    }
    return 0;
  }
  if (cmd == "write") {
    const crlf = a[4] == "crlf";
    // 書いてあったタグを残すのは SRT から SRT のときだけ。ほかは画面に出す文字にしてから書く
    let text = "";
    const srcVtt = doc.format == "vtt";
    if (a[3] == "vtt") {
      text = subtitleWriteVtt(subtitlePlainCues(doc.cues, srcVtt), crlf);
    } else if (srcVtt) {
      text = subtitleWriteSrt(subtitlePlainCues(doc.cues, true), crlf);
    } else {
      text = subtitleWriteSrt(doc.cues, crlf);
    }
    let out: u8[] = [];
    for (const b of text) {
      out.push(b);
    }
    writeFile(a[2], out);
    return 0;
  }
  eprint(`知らないコマンド: ${cmd}`);
  return 2;
}
