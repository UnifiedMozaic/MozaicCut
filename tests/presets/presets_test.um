// src/presets.um の試し用のプログラム（tests/presets/run.mjs が src/ の写しの隣に置いてビルドする）。
//
//   presets_test list                                   すべてのプリセットの JSON
//   presets_test text                                   人向けの 1 行の説明（1 行に 1 つ）
//   presets_test validate                               標準の表の検査（{"<id>":[診断...]}）
//   presets_test check <project.mzc> <probe.txt> <id>   プロジェクトとの食い違いの診断の JSON
//   presets_test plan <project.mzc> <probe.txt> <id>    書き出す値の JSON と ffmpeg の引数（1 行目が JSON、続く行が引数 1 つずつ）
//   presets_test suggest <project.mzc> <probe.txt>      勧めるプリセットの名前
import { Probe, Diag, readProbes, parseProject, Project } from "./project.um";
import { jsonStr, diagsJson } from "./report.um";
import {
  ExportPreset, exportPresetList, exportPresetFind, exportPresetValidate, exportPresetCheckById,
  exportPresetResolve, exportPresetFfmpegArgs, exportPresetText, exportPresetsJson, exportPlanJson, exportPresetSuggest,
} from "./presets.um";

function ptLoad(mzc: string, probe: string, diags: mut Diag[]): Project {
  const probes = readProbes(probe);
  const bytes = readFile(mzc);
  if (bytes == null) {
    eprint(`読めません: ${mzc}`);
    let empty: u8[] = [];
    return parseProject(empty, probes, mut diags);
  }
  return parseProject(bytes, probes, mut diags);
}

export function main(): i32 {
  const a = args();
  if (a.length < 1) {
    eprint("使い方: presets_test list|text|validate|check|plan|suggest ...");
    return 2;
  }
  const cmd = a[0].clone();
  if (cmd == "list") {
    print(exportPresetsJson());
    return 0;
  }
  if (cmd == "text") {
    const list = exportPresetList();
    for (const x of list) {
      print(exportPresetText(x));
    }
    return 0;
  }
  if (cmd == "validate") {
    const list = exportPresetList();
    let s = "{";
    let i = 0;
    for (const x of list) {
      if (i > 0) {
        s = s + ",";
      }
      i++;
      s = s + `${jsonStr(x.id)}:${diagsJson(exportPresetValidate(x))}`;
    }
    print(s + "}");
    return 0;
  }
  if (a.length < 3) {
    eprint("project.mzc と probe.txt が要ります");
    return 2;
  }
  let pd: Diag[] = [];
  const p = ptLoad(a[1], a[2], mut pd);
  if (pd.length > 0) {
    eprint(`プロジェクトの診断: ${diagsJson(pd)}`);
  }
  if (cmd == "suggest") {
    print(exportPresetSuggest(p));
    return 0;
  }
  if (a.length < 4) {
    eprint("プリセットの名前が要ります");
    return 2;
  }
  if (cmd == "check") {
    print(diagsJson(exportPresetCheckById(p, a[3])));
    return 0;
  }
  if (cmd == "plan") {
    const k = exportPresetFind(a[3]);
    if (k < 0) {
      eprint("知らないプリセット");
      return 1;
    }
    const list = exportPresetList();
    const ki = k as usize;
    print(exportPlanJson(exportPresetResolve(p, list[ki])));
    const fa = exportPresetFfmpegArgs(p, list[ki], "in.y4m", "in.pcm", "out." + list[ki].ext);
    for (const s of fa) {
      print(s);
    }
    return 0;
  }
  eprint(`知らないコマンド: ${cmd}`);
  return 2;
}
