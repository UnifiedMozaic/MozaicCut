# 描画の基準（tests/run.mjs の golden）。素材は run.mjs が決まった模様で作る（media/ は要らない）。
# 効果・不透明度・フェード・クロスフェード・小窓・画像・色の板・トラックの重なり・project の行の効果を一通り使う。
project size=96x54 fps=30 bg=101018 contrast=1.05

color 202040 id=intro dur=0.5 fadeout=0.25 vignette=0.7
video "media/a.mp4" id=a in=0.2 out=1.4 fadein=0.2
video "media/b.mp4" id=b in=0 out=1.2 xfade=0.4 sat=1.4 contrast=1.1 vignette=0.4 fadeout=0.3

video "media/a.mp4" id=pip track=3 at=a.start+0.2 in=0.5 dur=1.5 w=32 h=18 x=-4 y=-4 pixelate=4 sepia=0.8 fade=0.2
image "media/logo.png" id=logo at=0.3 dur=2 x=4 y=4 w=20 opacity=0.85 fade=0.3
color ff8000 id=box track=2 at=1 dur=1 w=20 h=10 x=50 y=30 opacity=0.5 blur=2
video "media/b.mp4" id=side track=4 at=1.6 dur=0.8 w=40 h=24 x=2 y=-2 fit=cover gray=0.7 invert=0.3 bright=0.1 sharpen=0.8
image "media/logo.png" id=logo2 track=5 at=2.2 dur=0.6 x=-2 y=2 opacity=0.6
