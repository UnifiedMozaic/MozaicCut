# 文字の描画の基準（tests/run.mjs の golden）。文字の形は OS のフォント（ttf.um の defaultFont）で決まるので、
# 基準を作ったときと同じフォントがあるときだけ比べる（text.expect.json の font）。
project size=128x72 fps=30 bg=203048
color 406080 id=bgc dur=2
text "MozaicCut" id=t1 at=0 dur=2 size=24 color=ffffff outline=303080 outlinew=2 shadow=00000099 fade=0.3
text "日本語と\n二行目" id=t2 at=0.5 dur=1.5 x=4 y=-4 size=14 bg=000000a0 pad=3 align=left
text "右" id=t3 track=3 at=1 dur=1 x=-4 y=4 size=18 color=ffd000 opacity=0.7
