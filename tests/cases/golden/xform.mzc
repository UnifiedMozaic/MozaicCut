# 2D の変形（rotation / scale / anchor）の描画の基準（tests/run.mjs の golden）。素材は run.mjs が決まった模様で作る。
# 回る映像（キーフレーム）、横だけ拡大した画像、基準点を角にした色の板、縮めてぼかした板、描画モードとマスクのある回転。
project size=96x54 fps=30 bg=101018

color 202040 id=bg dur=2
video "media/a.mp4" id=v track=1 in=0.2 dur=2 w=40 h=24 x=6 y=6 rotation="0@0 90@2" scale="1@0 0.6@2"
image "media/logo.png" id=logo track=2 at=0.2 dur=1.6 x=-8 y=6 rotation=-20 scale=1.5,1 fade=0.3
color ff8000 id=box track=3 dur=2 w=20 h=10 x=40 y=-6 rotation="0@0 180@2" anchor=-10,-5 opacity=0.8
color 00ff80 id=small track=4 dur=2 w=30 h=30 x=-4 y=-4 rotation=10 scale=0.3 blur=2
color ffffff id=mix track=5 at=0.5 dur=1.5 w=24 h=24 x=60 y=20 rotation=30 scale=-1,1 blend=overlay
mask ellipse to=mix units=norm x=0.1 y=0.1 w=0.8 h=0.5 feather=0.1
