# M6 の操作の画面の配線（src/edit2/wire_motion.um）の試し。demo/m6/ws_motion.mzc と同じクリップ。
project size=1280x720 fps=30 bg=101828

# 左から右へ動く四角（x のキーフレームはイーズ、不透明度は 1 秒で上がる）
color 3c78ff id=box at=0 dur=4 w=200 h=200 x="80@0 520@2:ease 900@4" y=420 opacity="0.3@0 1@1"

# 回って大きくなる星（anchor を pos= で置く。回転と大きさをキーフレームで）
shape star id=star points=5 r=120 inner=50 pos=960,250 fill="linear(#ffd040,#ff6020)" stroke=202020 strokew=4 rotation="0@0 90@2:ease 180@4" scale="0.6@0:easeout 1@2" track=1 at=0 dur=4

# 点を動かせるパス
shape path id=wave d="M 0 0 C 60 -90 140 90 200 0 L 320 -40" fill=none stroke=80ff80 strokew=8 cap=round pos=240,150 track=2 at=0 dur=4

# パスのマスクで抜いた札（マスクの点を動かせる）と、楕円のマスク
color ff8040 id=card track=3 at=0 dur=4 w=320 h=180 x=560 y=40
mask path to=card ref=320x180 d="M 20 20 L 300 40 L 270 160 L 40 150 Z" feather=4
color 40c080 id=disc track=4 at=0 dur=4 w=200 h=200 x=1040 y=470
mask ellipse to=disc ref=200x200 x=20 y=20 w=160 h=160
