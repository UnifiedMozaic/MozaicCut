# MozaicCut の「文字」の欄の外部プリセット（自由に足し引き・書き換えできます）。
#
# 1 行に 1 つのひな形を書きます（text / shape / particles の行）:
#   text "<文字>" name="<ひな形の名前>" note="<説明>" dur=<秒> <見た目のキー...>
#   shape <rect|ellipse|polygon|star|path> name="<ひな形の名前>" note="<説明>" dur=<秒> <形のキー...>
#   particles name="<ひな形の名前>" note="<説明>" dur=<秒> <パーティクルのキー...>
#
# 組み込みと同じ name="..." を書くと、そのひな形を上書きできます。

text "チャンネル登録よろしく！" name="チャンネル登録札" note="右下に赤い帯で案内" dur=4 x=-40 y=-48 size=34 color=ffffff bg=d91e1ee6 pad=14 fade=0.3
text "BREAKING NEWS" name="ニュース速報帯" note="下部に速報の帯と文字" dur=4 y=-44 size=42 color=ffffff bg=b81414e6 pad=12 anim=slide
shape polygon name="六角形バッジ" note="回転しながら現れる六角形の枠" dur=3 sides=6 r=130 fill=none stroke=#ffd040 strokew=8 drawon=0.6 fade=0.25
particles name="蛍の光" note="下からゆっくり漂い上がる淡い光" dur=5 emit=box x=center y=center emit.w=1600 emit.h=900 rate=35 speed=30 dir=-90 spread=70 turb=80 life=3.2 size=12 size.end=4 color=b8ff70 color.end=40ffaa opacity.in=0.35 opacity.out=0.45 draw=soft blend=add prewarm=2
