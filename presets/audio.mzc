# MozaicCut の「音」の欄の外部プリセット（自由に足し引き・書き換えできます）。
#
# 1 行に 1 つのプリセットを書きます:
#   track name="<名前>" group="<分類>" note="<説明>" eq=<フィルタ...>
#   track name="<名前>" group="<分類>" note="<説明>" comp=<しきい値>:<比>[:<アタック>:<リリース>:<ニー>:<メイクアップ>]
#   clip  name="<名前>" group="<分類>" note="<説明>" fadein=<秒> / fadeout=<秒>
#
# 組み込みと同じ name="..." を書くと、そのプリセットを上書きできます。

track name="ラジオボイス" group="カスタム（トラック）" note="低域と高域を絞り、中域を際立たせるラジオ風の声" eq=highpass:300,lowpass:4000,peak:1500:3.5:1.1
track name="シネマ低音ブースト" group="カスタム（トラック）" note="効果音やBGMの重低音（80 Hz 以下）を 5 dB 強調" eq=lowshelf:80:5
clip name="フェードイン 3 秒" group="フェード（クリップ）" note="長いイントロをゆっくり立ち上げる" fadein=3.0
