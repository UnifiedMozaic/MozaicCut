# MozaicCut の「効果」の欄の外部プリセット（自由に足し引き・書き換えできます）。
#
# 1 行に 1 つのプリセットを書きます（複数の効果プラグインや grade.* の色調整を組み合わせられます）:
#   fx name="<プリセット名>" note="<説明>" <効果や grade.* の key=value ...>
#
# 組み込みと同じ name="..." を書くと、そのプリセットを上書きできます。

fx name="クール・シネマ" note="青みがかった冷たい映画の空気感" tint=0.35 tint.r=0.2 tint.g=0.55 tint.b=1.0 contrast=1.18 vignette=0.4
fx name="ゴールデンアワー（夕暮れ）" note="夕日のような暖かい光とふんわりした発光" tint=0.35 tint.r=1.0 tint.g=0.65 tint.b=0.25 glow=0.55 glow.radius=10
fx name="モノクロ・ノワール" note="硬いコントラストと粒子、周辺減光の重厚な白黒" gray=1 contrast=1.45 vignette=0.55 grain=0.25
fx name="グリッチ・テレビ故障" note="デジタルノイズと走査線、色収差の激しい乱れ" glitch=20 chromatic=8 scanline=0.45
